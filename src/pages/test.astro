---
import Layout from '../layouts/Layout.astro';
import { supabase, supabaseUrl, supabaseAnonKey } from '../utils/supabase';

type ArticleRow = {
  id: number;
  title: string;
  content: string;
  author: string | null;
  published_at: string | null;
  created_at: string | null;
  updated_at: string | null;
};

type LikeCountRow = {
  article_id: number;
  like_count: number | null;
};

type ArticleWithLikes = ArticleRow & {
  like_count: number;
};

// Get Supabase config to pass to client
const supabaseConfig = {
  url: supabaseUrl,
  anonKey: supabaseAnonKey
};

// Fetch test articles
const { data: articles, error } = await supabase
  .from('test_articles')
  .select('*')
  .order('created_at', { ascending: false });

// Fetch like counts for all articles
const { data: likeCounts } = await supabase
  .from('article_like_counts')
  .select('*');

// Combine articles with like counts
const articleRows: ArticleRow[] = (articles ?? []) as ArticleRow[];
const likeCountRows: LikeCountRow[] = (likeCounts ?? []) as LikeCountRow[];

const articlesWithLikes: ArticleWithLikes[] = articleRows.map((article) => {
  const matchingLikeCount = likeCountRows.find((lc) => lc.article_id === article.id);
  return {
    ...article,
    like_count: matchingLikeCount?.like_count ?? 0,
  };
});

if (error) {
  console.error('Error fetching articles:', error);
}
---

<Layout title="Test Page - Supabase Data">
  <main class="min-h-screen bg-gray-50 py-12">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h1 class="text-4xl font-bold text-gray-900 mb-4">
          Test Page - Supabase Data
        </h1>
        <p class="text-lg text-gray-600">
          This page displays test data from our Supabase database with read-only access.
        </p>
      </div>

      {error && (
        <div class="bg-red-50 border border-red-200 rounded-lg p-4 mb-8">
          <div class="flex">
            <div class="flex-shrink-0">
              <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
              </svg>
            </div>
            <div class="ml-3">
              <h3 class="text-sm font-medium text-red-800">
                Error loading data
              </h3>
              <div class="mt-2 text-sm text-red-700">
                <p>{error.message}</p>
              </div>
            </div>
          </div>
        </div>
      )}

      {articlesWithLikes && articlesWithLikes.length > 0 ? (
        <div class="space-y-8">
          {articlesWithLikes.map((article) => (
            <article class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition-shadow duration-300">
              <div class="p-6">
                <div class="flex items-center justify-between mb-4">
                  <div class="flex items-center space-x-2">
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                      ID: {article.id}
                    </span>
                    <span class="text-sm text-gray-500">
                      by {article.author ?? 'Unknown Author'}
                    </span>
                  </div>
                  <time class="text-sm text-gray-500" datetime={article.published_at ?? undefined}>
                    {new Date(article.published_at || Date.now()).toLocaleDateString('en-US', {
                      year: 'numeric',
                      month: 'long',
                      day: 'numeric'
                    })}
                  </time>
                </div>
                
                <h2 class="text-2xl font-bold text-gray-900 mb-3">
                  {article.title}
                </h2>
                
                <p class="text-gray-700 leading-relaxed">
                  {article.content}
                </p>
                
                <div class="mt-6 pt-4 border-t border-gray-200">
                  <div class="flex items-center justify-between">
                    <div class="flex text-xs text-gray-500 space-x-4">
                      <span>Created: {new Date(article.created_at || Date.now()).toLocaleString()}</span>
                      <span>Updated: {new Date(article.updated_at || Date.now()).toLocaleString()}</span>
                    </div>
                    <div class="flex items-center space-x-2">
                      <button 
                        class="like-btn flex items-center space-x-1 px-3 py-1 rounded-full text-sm font-medium transition-colors duration-200 hover:bg-red-50 hover:text-red-600"
                        data-article-id={String(article.id)}
                      >
                        <svg class="w-4 h-4 heart-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                        </svg>
                        <span class="like-count">{article.like_count}</span>
                      </button>
                    </div>
                  </div>
                </div>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="text-center py-12">
          <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <h3 class="mt-2 text-sm font-medium text-gray-900">No articles found</h3>
          <p class="mt-1 text-sm text-gray-500">
            No test articles are available in the database.
          </p>
        </div>
      )}

      <div class="mt-12 bg-blue-50 rounded-lg p-6">
        <h3 class="text-lg font-semibold text-blue-900 mb-3">
          Database Information
        </h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
          <div>
            <span class="font-medium text-blue-800">Table:</span> 
            <span class="text-blue-700">test_articles</span>
          </div>
          <div>
            <span class="font-medium text-blue-800">Access:</span> 
            <span class="text-blue-700">Read-only (RLS enabled)</span>
          </div>
          <div>
            <span class="font-medium text-blue-800">Records:</span> 
            <span class="text-blue-700">{articlesWithLikes?.length || 0}</span>
          </div>
          <div>
            <span class="font-medium text-blue-800">Status:</span> 
            <span class="text-blue-700">{error ? 'Error' : 'Connected'}</span>
          </div>
        </div>
      </div>
    </div>
  </main>

  <script is:inline define:vars={{ supabaseConfig }}>
    // Get Supabase config passed from server-side
    const supabaseUrl = supabaseConfig.url;
    const supabaseAnonKey = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imttc3JvaWdldGlpcHVsbm9zb295Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NTU0NDk0MzcsImV4cCI6MjA3MTAyNTQzN30.yKGKsfDA4WOAwAOOX6znSNfcT6yL7Y0RWLBc2ylktCI';
    
    // Load Supabase from CDN since we can't import in inline script
    const script = document.createElement('script');
    script.src = 'https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.js';
    script.onload = initializeLikes;
    document.head.appendChild(script);
    
    function initializeLikes() {
      const supabase = window.supabase.createClient(supabaseUrl, supabaseAnonKey);
      
      let isSignedIn = false;
      let signingIn = false;
      
      // Check if user has voted before (stored in localStorage)
      const hasVotedBefore = localStorage.getItem('supabase_has_voted') === 'true';

      // Generate a simple browser fingerprint for anonymous users
      function getUserFingerprint() {
        const canvas = document.createElement('canvas');
        const ctx = canvas.getContext('2d');
        ctx.textBaseline = 'top';
        ctx.font = '14px Arial';
        ctx.fillText('Browser fingerprint', 2, 2);
        
        const fingerprint = [
          navigator.userAgent,
          navigator.language,
          screen.width + 'x' + screen.height,
          new Date().getTimezoneOffset(),
          canvas.toDataURL()
        ].join('|');
        
        // Simple hash function
        let hash = 0;
        for (let i = 0; i < fingerprint.length; i++) {
          const char = fingerprint.charCodeAt(i);
          hash = ((hash << 5) - hash) + char;
          hash = hash & hash; // Convert to 32bit integer
        }
        
        return 'anon_' + Math.abs(hash).toString(36);
      }

      const userFingerprint = getUserFingerprint();
      const likedArticles = new Set();

      // Check which articles are already liked by this user
      async function checkExistingLikes() {
        const { data } = await supabase
          .from('article_likes')
          .select('article_id')
          .eq('user_fingerprint', userFingerprint);
        
        if (data) {
          data.forEach(like => {
            likedArticles.add(like.article_id);
            const button = document.querySelector(`[data-article-id="${like.article_id}"]`);
            if (button) {
              button.classList.add('liked');
              const heartIcon = button.querySelector('.heart-icon');
              heartIcon.setAttribute('fill', 'currentColor');
              button.classList.add('text-red-600', 'bg-red-50');
            }
          });
        }
      }

      // Sign in anonymously only when needed
      async function ensureSignedIn() {
        if (isSignedIn) return true;
        if (signingIn) return false;
        
        signingIn = true;
        const { error: authError } = await supabase.auth.signInAnonymously();
        
        if (authError) {
          signingIn = false;
          return false;
        }
        
        // Wait a moment for the session to be fully established
        await new Promise(resolve => setTimeout(resolve, 100));
        
        isSignedIn = true;
        signingIn = false;
        
        // Load existing likes after signing in
        await checkExistingLikes();
        
        return true;
      }

      // Handle like button clicks
      async function handleLike(articleId) {
        const button = document.querySelector(`[data-article-id="${articleId}"]`);
        const likeCountSpan = button.querySelector('.like-count');
        const heartIcon = button.querySelector('.heart-icon');
        
        // Sign in only when user tries to like something
        const signedIn = await ensureSignedIn();
        
        if (!signedIn) {
          return;
        }
        
        // Re-check if article is liked after potential sign-in
        const isLiked = likedArticles.has(articleId);

        try {
          if (isLiked) {
            // Unlike
            const { error } = await supabase
              .from('article_likes')
              .delete()
              .eq('article_id', articleId)
              .eq('user_fingerprint', userFingerprint);

            if (!error) {
              likedArticles.delete(articleId);
              button.classList.remove('liked', 'text-red-600', 'bg-red-50');
              heartIcon.setAttribute('fill', 'none');
              likeCountSpan.textContent = parseInt(likeCountSpan.textContent) - 1;
            }
          } else {
            // Like
            const { error } = await supabase
              .from('article_likes')
              .insert({
                article_id: articleId,
                user_fingerprint: userFingerprint
              });

            if (!error) {
              likedArticles.add(articleId);
              button.classList.add('liked', 'text-red-600', 'bg-red-50');
              heartIcon.setAttribute('fill', 'currentColor');
              likeCountSpan.textContent = parseInt(likeCountSpan.textContent) + 1;
              
              // Mark that user has voted (for future auto-login)
              localStorage.setItem('supabase_has_voted', 'true');
            }
          }
        } catch (error) {
          // Silent error handling
        }
      }

      // Add event listeners when DOM is loaded
      function setupEventListeners() {
        const likeButtons = document.querySelectorAll('.like-btn');
        
        likeButtons.forEach((button) => {
          button.addEventListener('click', async (e) => {
            e.preventDefault();
            e.stopPropagation();
            const articleId = parseInt(button.dataset.articleId);
            await handleLike(articleId);
          });
        });
      }

      // Auto-authenticate if user has voted before
      async function autoAuthenticateIfNeeded() {
        if (hasVotedBefore && !isSignedIn) {
          await ensureSignedIn();
        }
      }

      // Setup event listeners when DOM is ready
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', async () => {
          await autoAuthenticateIfNeeded();
          setupEventListeners();
        });
      } else {
        autoAuthenticateIfNeeded().then(() => {
          setupEventListeners();
        });
      }
    }
  </script>
</Layout>
