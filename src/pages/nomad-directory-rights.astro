---
export const prerender = true;

import Layout, { type SEOProps } from '~/layouts/Layout.astro'
import MaterialSymbolsElectricBolt from '~icons/material-symbols/electric-bolt'

const seo: SEOProps = {
  title: 'Nomad Directory Rights & Perks - Exclusive Benefits for Listed Companies',
  description: 'Discover exclusive perks for Nomad Directory members: newsletter announcements, article opportunities, print edition inclusion, and more. Valid for H1 2026.',
  image: 'https://nomad-magazine.com/images/Nomad-directory.webp',
  keywords: 'nomad directory perks, digital nomad advertising, nomad magazine benefits, directory member rights, nomad business promotion',
  ogType: 'website',
  ldJSON: {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Nomad Directory Rights & Perks',
    description: 'Exclusive benefits and opportunities for companies listed in the Nomad Directory',
    url: 'https://nomad-magazine.com/nomad-directory-rights/',
    publisher: {
      '@type': 'Organization',
      name: 'Nomad Magazine',
      url: 'https://nomad-magazine.com/'
    }
  },
}
---

<Layout seo={seo}>
  <div class="bg-gray-50 text-gray-900 min-h-screen">
    <!-- Hero Section -->
    <section class="pt-20 pb-16 relative overflow-hidden">
      <!-- Background decoration -->
      <div class="absolute inset-0 overflow-hidden">
        <div class="absolute -top-40 -right-40 w-80 h-80 bg-yellow-400/20 rounded-full blur-3xl"></div>
        <div class="absolute -bottom-40 -left-40 w-80 h-80 bg-yellow-400/10 rounded-full blur-3xl"></div>
      </div>
      
      <div class="container mx-auto px-4 relative z-10">
        <div class="text-center max-w-4xl mx-auto">
          <div class="inline-flex items-center gap-2 bg-yellow-400/30 border border-yellow-500/40 px-4 py-2 rounded-full mb-6">
            <MaterialSymbolsElectricBolt width="16" height="16" class="text-yellow-600" />
            <span class="text-yellow-700 font-medium text-sm">Valid for H1 2026</span>
          </div>
          
          <h1 class="text-4xl md:text-6xl font-bold mb-6 text-gray-900">
            Your <span class="text-yellow-600">Nomad Directory</span> Rights
          </h1>
          
          <p class="text-xl text-gray-600 mb-8 leading-relaxed max-w-3xl mx-auto">
            As part of the Nomad Directory, you get exclusive perks designed with <em>you</em> in mind. 
            Because supporting projects that serve the global nomad audience isn't easy — and we're here to help.
          </p>
          
          <div class="bg-white shadow-lg border border-gray-200 rounded-2xl p-6 max-w-2xl mx-auto mb-12">
            <p class="text-gray-700 text-lg leading-relaxed">
              Nomad Magazine was created not only to share what's happening in the digital nomad community 
              but also to find a way to support projects and brands working for the global nomad audience. 
              <span class="text-yellow-600 font-semibold">That's how Nomad Directory was born.</span>
            </p>
          </div>
          
          <!-- Your Rights at a Glance - moved to hero -->
          <div class="bg-gradient-to-br from-yellow-100 to-orange-50 border border-yellow-300 rounded-2xl p-8 md:p-10 shadow-lg max-w-4xl mx-auto">
            <h2 class="text-2xl font-bold text-gray-900 mb-6 text-center">Your Rights at a Glance</h2>
            
            <div class="grid md:grid-cols-2 gap-6 mb-6 text-left">
              <div class="flex items-start gap-4">
                <div class="w-8 h-8 bg-yellow-500 rounded-lg flex items-center justify-center flex-shrink-0">
                  <span class="text-black font-bold">1</span>
                </div>
                <div>
                  <h4 class="text-gray-900 font-semibold mb-1">Print Directory Inclusion</h4>
                  <p class="text-gray-600 text-sm">50 companies with optional highlight options</p>
                </div>
              </div>
              
              <div class="flex items-start gap-4">
                <div class="w-8 h-8 bg-yellow-500 rounded-lg flex items-center justify-center flex-shrink-0">
                  <span class="text-black font-bold">2</span>
                </div>
                <div>
                  <h4 class="text-gray-900 font-semibold mb-1">Newsletter Announcements</h4>
                  <p class="text-gray-600 text-sm">Hiring, co-founders, investors, sales, updates</p>
                </div>
              </div>
              
              <div class="flex items-start gap-4">
                <div class="w-8 h-8 bg-yellow-500 rounded-lg flex items-center justify-center flex-shrink-0">
                  <span class="text-black font-bold">3</span>
                </div>
                <div>
                  <h4 class="text-gray-900 font-semibold mb-1">Website Articles</h4>
                  <p class="text-gray-600 text-sm">Backlinks and permanent online presence</p>
                </div>
              </div>
              
              <div class="flex items-start gap-4">
                <div class="w-8 h-8 bg-yellow-500 rounded-lg flex items-center justify-center flex-shrink-0">
                  <span class="text-black font-bold">4</span>
                </div>
                <div>
                  <h4 class="text-gray-900 font-semibold mb-1">Digital Edition Features</h4>
                  <p class="text-gray-600 text-sm">Professional editing and beautiful design</p>
                </div>
              </div>
            </div>
            
            <div class="text-center">
              <div class="inline-flex items-center gap-2 bg-white/80 px-4 py-2 rounded-full border border-yellow-300">
                <span class="text-yellow-700 font-semibold">📅 Valid:</span>
                <span class="text-gray-800">First half of 2026 (H1 2026)</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Print Edition Section -->
    <section class="py-16 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
          <div class="grid lg:grid-cols-2 gap-12 items-center">
            <div>
              <div class="flex items-center gap-3 mb-4">
                <div class="w-12 h-12 bg-yellow-100 rounded-xl flex items-center justify-center">
                  <span class="text-2xl">📖</span>
                </div>
                <h2 class="text-3xl font-bold text-gray-900">Print Edition Inclusion</h2>
              </div>
              
              <p class="text-gray-700 text-lg mb-6 leading-relaxed">
                The last <span class="text-yellow-600 font-bold">50 companies</span> included in the print Nomad Directory 
                can use optional highlight options (large or small format) to stand out even more.
              </p>
              
              <p class="text-gray-500 mb-6">
                We'll notify you when we start working on the next edition so you can choose your preferred highlighting option.
              </p>
              
              <a 
                href="/nomad-directory-highlight-options/"
                class="inline-flex items-center gap-2 bg-yellow-500 hover:bg-yellow-400 text-black px-6 py-3 rounded-lg font-bold transition-all duration-200"
              >
                <MaterialSymbolsElectricBolt width="18" height="18" />
                View Highlight Options
              </a>
            </div>
            
            <div class="bg-gray-100 border border-gray-200 rounded-2xl overflow-hidden shadow-lg">
              <img 
                src="/images/NGM-04_NomadDirectory_Proposal_Page_1.webp" 
                alt="Nomad Directory Print Edition Preview" 
                class="w-full h-auto"
                loading="lazy"
              />
              <div class="p-4 text-center bg-white">
                <p class="text-sm text-gray-500">Preview of the print Nomad Directory with highlighting options</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Newsletter Announcements Section -->
    <section class="py-16 bg-gray-100">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
          <div class="text-center mb-12">
            <div class="flex items-center justify-center gap-3 mb-4">
              <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center">
                <span class="text-2xl">📢</span>
              </div>
              <h2 class="text-3xl font-bold text-gray-900">Newsletter Announcements</h2>
            </div>
            <p class="text-gray-600 text-lg max-w-2xl mx-auto">
              Exclusive to Nomad Directory members — share your news with our engaged community of digital nomads.
            </p>
          </div>
          
          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
            <!-- Announcement Type Cards -->
            <div class="bg-white shadow-md border border-gray-200 rounded-xl p-6 hover:shadow-lg transition-all duration-300">
              <div class="w-10 h-10 bg-green-100 rounded-lg flex items-center justify-center mb-4">
                <span class="text-xl">💼</span>
              </div>
              <h3 class="text-lg font-bold text-gray-900 mb-2">Hiring & Interns</h3>
              <p class="text-gray-500 text-sm">Remote positions, project-based help, paid or unpaid internships</p>
            </div>
            
            <div class="bg-white shadow-md border border-gray-200 rounded-xl p-6 hover:shadow-lg transition-all duration-300">
              <div class="w-10 h-10 bg-purple-100 rounded-lg flex items-center justify-center mb-4">
                <span class="text-xl">🤝</span>
              </div>
              <h3 class="text-lg font-bold text-gray-900 mb-2">Co-Founders</h3>
              <p class="text-gray-500 text-sm">Looking for technical, sales, product, or marketing co-founders</p>
            </div>
            
            <div class="bg-white shadow-md border border-gray-200 rounded-xl p-6 hover:shadow-lg transition-all duration-300">
              <div class="w-10 h-10 bg-yellow-100 rounded-lg flex items-center justify-center mb-4">
                <span class="text-xl">💰</span>
              </div>
              <h3 class="text-lg font-bold text-gray-900 mb-2">Investors</h3>
              <p class="text-gray-500 text-sm">Seeking investment for your nomad-focused project</p>
            </div>
            
            <div class="bg-white shadow-md border border-gray-200 rounded-xl p-6 hover:shadow-lg transition-all duration-300">
              <div class="w-10 h-10 bg-red-100 rounded-lg flex items-center justify-center mb-4">
                <span class="text-xl">🏷️</span>
              </div>
              <h3 class="text-lg font-bold text-gray-900 mb-2">Project Sales</h3>
              <p class="text-gray-500 text-sm">Looking to sell your project or find a buyer</p>
            </div>
            
            <div class="bg-white shadow-md border border-gray-200 rounded-xl p-6 hover:shadow-lg transition-all duration-300">
              <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center mb-4">
                <span class="text-xl">📰</span>
              </div>
              <h3 class="text-lg font-bold text-gray-900 mb-2">Company Updates</h3>
              <p class="text-gray-500 text-sm">Acquisitions, team changes, organizational news</p>
            </div>
            
            <div class="bg-white shadow-md border border-gray-200 rounded-xl p-6 hover:shadow-lg transition-all duration-300">
              <div class="w-10 h-10 bg-cyan-100 rounded-lg flex items-center justify-center mb-4">
                <span class="text-xl">✨</span>
              </div>
              <h3 class="text-lg font-bold text-gray-900 mb-2">And More...</h3>
              <p class="text-gray-500 text-sm">Any relevant announcement for the nomad community</p>
            </div>
          </div>
          
          <!-- Templates -->
          <div class="bg-white shadow-lg border border-gray-200 rounded-2xl p-8">
            <h3 class="text-xl font-bold text-gray-900 mb-6 flex items-center gap-2">
              <span class="text-yellow-500">📝</span> Announcement Templates
            </h3>
            
            <div class="space-y-6">
              <!-- Hiring Template -->
              <div class="bg-green-50 rounded-xl p-6 border-l-4 border-green-500">
                <h4 class="text-lg font-semibold text-green-700 mb-3">Hiring or Intern Announcement</h4>
                <p class="text-gray-700 font-mono text-sm leading-relaxed">
                  <span class="text-gray-900 font-semibold">[Name]</span> from <span class="text-gray-900 font-semibold">[Company]</span> is building <span class="text-gray-900 font-semibold">[what]</span>. 
                  They are hiring <span class="text-gray-900 font-semibold">[who]</span> and <span class="text-gray-900 font-semibold">[why]</span>. 
                  Reach out: <span class="text-gray-900 font-semibold">[email or link]</span>.
                </p>
                <p class="text-gray-500 text-xs mt-3 italic">*Location is obviously 'Remote' 🌍</p>
              </div>
              
              <!-- Co-Founder Template -->
              <div class="bg-purple-50 rounded-xl p-6 border-l-4 border-purple-500">
                <h4 class="text-lg font-semibold text-purple-700 mb-3">Co-Founder Search</h4>
                <p class="text-gray-700 font-mono text-sm leading-relaxed">
                  <span class="text-gray-900 font-semibold">[Name]</span> is a <span class="text-gray-900 font-semibold">[brief background]</span> who has worked on <span class="text-gray-900 font-semibold">[notable experience]</span>. 
                  They're now building <span class="text-gray-900 font-semibold">[company focus]</span> and looking for a co-founder with a strong background in <span class="text-gray-900 font-semibold">[technical/sales/product/marketing]</span>. 
                  Reach out: <span class="text-gray-900 font-semibold">[email or link]</span>.
                </p>
              </div>
            </div>
            
            <div class="mt-8 text-center">
              <a 
                href="/newsletter-community-announcements/"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="View newsletter example (opens in new tab)"
                class="inline-flex items-center gap-2 bg-blue-500 hover:bg-blue-600 text-white px-6 py-3 rounded-lg font-semibold transition-all duration-200"
              >
                <span>👀</span>
                View Newsletter Example
              </a>
            </div>
            
            <div class="mt-6 p-4 bg-yellow-50 border border-yellow-200 rounded-xl">
              <p class="text-gray-700 text-center">
                <span class="text-yellow-700 font-semibold">Ready to share something?</span> 
                Send your announcement anytime to <a href="mailto:lera@nomadgossip.com" class="text-yellow-600 hover:text-yellow-700 underline font-medium">lera@nomadgossip.com</a> and we'll include it in the next newsletter.
              </p>
            </div>
            
            <!-- Announcement Visibility Info -->
            <div class="mt-8 bg-gradient-to-br from-blue-50 to-indigo-50 border-2 border-blue-200 rounded-2xl p-8">
              <div class="text-center mb-6">
                <div class="inline-flex items-center gap-2 bg-blue-500 text-white px-4 py-2 rounded-full mb-4">
                  <span class="text-xl">✨</span>
                  <span class="font-bold">Your Announcements Get Triple Exposure</span>
                </div>
                <p class="text-gray-700 text-lg">
                  When you submit an announcement, it appears in <strong>three strategic locations</strong> to maximize your reach:
                </p>
              </div>
              
              <div class="grid md:grid-cols-3 gap-6">
                <!-- Newsletter -->
                <div class="bg-white rounded-xl p-6 border border-blue-200 hover:shadow-lg transition-all duration-300">
                  <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center mx-auto mb-4">
                    <span class="text-2xl">📧</span>
                  </div>
                  <h4 class="text-lg font-bold text-gray-900 mb-2 text-center">Newsletter</h4>
                  <p class="text-gray-600 text-sm text-center">
                    Featured in our weekly/bi-weekly newsletter sent to engaged nomad subscribers
                  </p>
                </div>
                
                <!-- Nomad Directory Sidebar -->
                <div class="bg-white rounded-xl p-6 border border-blue-200 hover:shadow-lg transition-all duration-300">
                  <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center mx-auto mb-4">
                    <span class="text-2xl">📁</span>
                  </div>
                  <h4 class="text-lg font-bold text-gray-900 mb-2 text-center">Directory Sidebar</h4>
                  <p class="text-gray-600 text-sm text-center">
                    Displayed in the announcements section on the <a href="/nomad_directory/" class="text-blue-600 hover:text-blue-700 underline font-medium">Nomad Directory page</a>
                  </p>
                </div>
                
                <!-- Homepage -->
                <div class="bg-white rounded-xl p-6 border border-blue-200 hover:shadow-lg transition-all duration-300">
                  <div class="w-12 h-12 bg-yellow-100 rounded-lg flex items-center justify-center mx-auto mb-4">
                    <span class="text-2xl">🏠</span>
                  </div>
                  <h4 class="text-lg font-bold text-gray-900 mb-2 text-center">Homepage Feature</h4>
                  <p class="text-gray-600 text-sm text-center">
                    Showcased in the <a href="/#announcements" class="text-blue-600 hover:text-blue-700 underline font-medium">Community Announcements section</a> on our homepage
                  </p>
                </div>
              </div>
              
              <div class="mt-6 p-4 bg-white rounded-xl border-l-4 border-blue-500">
                <div class="flex items-start gap-3">
                  <span class="text-2xl flex-shrink-0">💡</span>
                  <div>
                    <p class="text-gray-700 font-semibold mb-1">Pro Tip:</p>
                    <p class="text-gray-600 text-sm">
                      Your announcements stay visible on our website and directory for weeks/months, giving you long-term exposure beyond just the newsletter send. 
                      Plus, the homepage features interactive cards with full details accessible on click!
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>
          
          <!-- Event Templates -->
          <div class="bg-white shadow-lg border border-gray-200 rounded-2xl p-8 mt-8">
            <h3 class="text-xl font-bold text-gray-900 mb-6 flex items-center gap-2">
              <span class="text-yellow-500">🎪</span> Event Announcement Templates
            </h3>
            <p class="text-gray-600 mb-6">
              Want to feature your event in our newsletter? Events are published in one of these two formats. 
              Send us the information below and we'll include it in the next edition.
            </p>
            
            <div class="space-y-8">
              <!-- Format 1: Featured Event (Large) -->
              <div class="bg-blue-50 rounded-xl p-6 border-2 border-blue-200">
                <div class="flex items-center gap-2 mb-4">
                  <span class="bg-blue-500 text-white text-xs font-bold px-2 py-1 rounded">FORMAT 1</span>
                  <h4 class="text-lg font-semibold text-blue-700">Featured Event (Large Format)</h4>
                </div>
                
                <p class="text-gray-600 text-sm mb-4">Best for multi-day conferences, cruises, and flagship events. Includes map/image and detailed info.</p>
                
                <div class="bg-white rounded-lg p-5 border border-blue-100">
                  <h5 class="font-semibold text-gray-800 mb-3">Send us:</h5>
                  <ul class="space-y-2 text-gray-700 text-sm">
                    <li class="flex items-start gap-2">
                      <span class="text-blue-500 mt-0.5">•</span>
                      <span><strong>Event Name:</strong> e.g., "Nomad Cruise Asia"</span>
                    </li>
                    <li class="flex items-start gap-2">
                      <span class="text-blue-500 mt-0.5">•</span>
                      <span><strong>Dates:</strong> e.g., "February 14-25, 2026"</span>
                    </li>
                    <li class="flex items-start gap-2">
                      <span class="text-blue-500 mt-0.5">•</span>
                      <span><strong>Duration:</strong> e.g., "12 Days at Sea"</span>
                    </li>
                    <li class="flex items-start gap-2">
                      <span class="text-blue-500 mt-0.5">•</span>
                      <span><strong>Community Size:</strong> e.g., "300+ Digital Nomads"</span>
                    </li>
                    <li class="flex items-start gap-2">
                      <span class="text-blue-500 mt-0.5">•</span>
                      <span><strong>Travel Tip:</strong> e.g., "Fly to: Hong Kong (~€80+ from CM)"</span>
                    </li>
                    <li class="flex items-start gap-2">
                      <span class="text-blue-500 mt-0.5">•</span>
                      <span><strong>Description:</strong> 2-3 sentences about the event</span>
                    </li>
                    <li class="flex items-start gap-2">
                      <span class="text-blue-500 mt-0.5">•</span>
                      <span><strong>Discount Code (optional):</strong> e.g., "Use code GOSSIP for €100 off"</span>
                    </li>
                    <li class="flex items-start gap-2">
                      <span class="text-blue-500 mt-0.5">•</span>
                      <span><strong>Link:</strong> URL to event page or registration</span>
                    </li>
                    <li class="flex items-start gap-2">
                      <span class="text-blue-500 mt-0.5">•</span>
                      <span><strong>Map/Image:</strong> Route map or event image (optional but recommended)</span>
                    </li>
                  </ul>
                </div>
              </div>
              
              <!-- Format 2: Standard Event (Compact) -->
              <div class="bg-orange-50 rounded-xl p-6 border-2 border-orange-200">
                <div class="flex items-center gap-2 mb-4">
                  <span class="bg-orange-500 text-white text-xs font-bold px-2 py-1 rounded">FORMAT 2</span>
                  <h4 class="text-lg font-semibold text-orange-700">Standard Event (Compact Format)</h4>
                </div>
                
                <p class="text-gray-600 text-sm mb-4">Perfect for summits, meetups, and single-location events. Clean and concise listing.</p>
                
                <div class="bg-white rounded-lg p-5 border border-orange-100">
                  <h5 class="font-semibold text-gray-800 mb-3">Send us:</h5>
                  <ul class="space-y-2 text-gray-700 text-sm">
                    <li class="flex items-start gap-2">
                      <span class="text-orange-500 mt-0.5">•</span>
                      <span><strong>Event Name:</strong> e.g., "Alicante Nomad Summit"</span>
                    </li>
                    <li class="flex items-start gap-2">
                      <span class="text-orange-500 mt-0.5">•</span>
                      <span><strong>Dates:</strong> e.g., "April 20-26, 2026"</span>
                    </li>
                    <li class="flex items-start gap-2">
                      <span class="text-orange-500 mt-0.5">•</span>
                      <span><strong>Location:</strong> e.g., "Alicante, Spain"</span>
                    </li>
                    <li class="flex items-start gap-2">
                      <span class="text-orange-500 mt-0.5">•</span>
                      <span><strong>Description:</strong> 2-4 sentences about the event, what to expect, who it's for</span>
                    </li>
                    <li class="flex items-start gap-2">
                      <span class="text-orange-500 mt-0.5">•</span>
                      <span><strong>Discount Code (optional):</strong> e.g., "Use code GOSSIP for €100 off"</span>
                    </li>
                    <li class="flex items-start gap-2">
                      <span class="text-orange-500 mt-0.5">•</span>
                      <span><strong>Link:</strong> URL to event page or registration</span>
                    </li>
                  </ul>
                </div>
              </div>
            </div>
            
            <div class="mt-6 p-4 bg-green-50 border border-green-200 rounded-xl">
              <p class="text-gray-700 text-center">
                <span class="text-green-700 font-semibold">📅 Have an event to promote?</span> 
                Send the details to <a href="mailto:lera@nomadgossip.com?subject=Event for Newsletter" class="text-green-600 hover:text-green-700 underline font-medium">lera@nomadgossip.com</a> and we'll feature it in an upcoming newsletter.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Article Opportunities Section -->
    <section class="py-16 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
          <div class="text-center mb-12">
            <div class="flex items-center justify-center gap-3 mb-4">
              <div class="w-12 h-12 bg-orange-100 rounded-xl flex items-center justify-center">
                <span class="text-2xl">✍️</span>
              </div>
              <h2 class="text-3xl font-bold text-gray-900">Article Opportunities</h2>
            </div>
            <p class="text-gray-600 text-lg max-w-2xl mx-auto">
              Your pitches are among our priority. Share your story with the nomad community.
            </p>
          </div>
          
          <div class="grid lg:grid-cols-2 gap-8">
            <!-- Website Article -->
            <div class="bg-blue-50 border border-blue-200 rounded-2xl p-8 hover:shadow-lg transition-all duration-300">
              <div class="flex items-center gap-3 mb-4">
                <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center">
                  <span class="text-xl">🌐</span>
                </div>
                <h3 class="text-xl font-bold text-gray-900">Website Article</h3>
              </div>
              
              <ul class="space-y-3 mb-6">
                <li class="flex items-start gap-3 text-gray-700">
