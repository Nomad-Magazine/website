---
import Layout from '~/layouts/Layout.astro'

const seoProps = {
  title: '404 - Page Not Found | Nomad Magazine',
  description: 'Oops! The page you\'re looking for seems to have wandered off. Explore our magazine editions and nomad stories instead.',
}
---

<Layout seo={seoProps}>
  <main class="min-h-screen bg-gray-900 text-white relative">
    <!-- Background Pattern -->
    <div class="absolute inset-0 opacity-10 pointer-events-none">
      <div class="absolute inset-0 bg-gradient-to-br from-yellow-400/20 to-purple-600/20"></div>
      <div class="absolute top-0 left-1/4 h-96 w-96 rounded-full bg-yellow-400/10 blur-3xl"></div>
      <div class="absolute bottom-0 right-1/4 h-96 w-96 rounded-full bg-purple-600/10 blur-3xl"></div>
    </div>
    
    <!-- Hero Section -->
    <section class="relative overflow-hidden py-20">

      <div class="container mx-auto px-4">
        <div class="flex flex-col items-center gap-12 lg:flex-row lg:items-center lg:justify-between">
          
          <!-- Left Side - Error Message -->
          <div class="text-center lg:flex-1 lg:text-left">
            <div class="mb-8">
              <h1 style="font-size: clamp(4rem, 12vw, 18rem); line-height: 0.8;" class="font-justme font-bold text-yellow-400">404</h1>
              <div class="mt-4 space-y-2">
                <h2 class="text-3xl font-bold md:text-4xl lg:text-5xl">Page Not Found</h2>
                <p class="text-lg text-gray-300 md:text-xl">This page seems to have gone on its own nomadic adventure!</p>
              </div>
            </div>
            
            <div class="mb-8 space-y-4">
              <p class="text-base text-gray-400 md:text-lg">
                Don't worry, fellow nomad. Even the best explorers sometimes take a wrong turn. 
                While you're here, why not check out our latest magazine edition?
              </p>
              <div class="flex flex-col gap-4 sm:flex-row lg:justify-start">
                <a 
                  href="/" 
                  class="inline-block rounded-lg bg-yellow-400 px-8 py-3 font-bold text-black transition-all hover:bg-yellow-300 hover:scale-105"
                >
                  Return Home
                </a>
                <a 
                  href="/editions/third-edition" 
                  class="inline-block rounded-lg border border-white px-8 py-3 font-bold transition-all hover:bg-white hover:text-black hover:scale-105"
                >
                  Latest Edition
                </a>
              </div>
            </div>

            <!-- Quick Navigation -->
            <div class="space-y-4">
              <h3 class="text-lg font-semibold text-yellow-400">Popular Destinations:</h3>
              <div class="flex flex-wrap gap-2 text-sm">
                <a href="/blog" class="rounded-full bg-gray-800 px-4 py-2 text-gray-300 transition-colors hover:bg-gray-700 hover:text-white">Blog</a>
                <a href="/nomad_directory" class="rounded-full bg-gray-800 px-4 py-2 text-gray-300 transition-colors hover:bg-gray-700 hover:text-white">Nomad Directory</a>
                <a href="/our-story" class="rounded-full bg-gray-800 px-4 py-2 text-gray-300 transition-colors hover:bg-gray-700 hover:text-white">Our Story</a>
                <a href="/partnerships" class="rounded-full bg-gray-800 px-4 py-2 text-gray-300 transition-colors hover:bg-gray-700 hover:text-white">Partnerships</a>
                <a href="/distribution-list" class="rounded-full bg-gray-800 px-4 py-2 text-gray-300 transition-colors hover:bg-gray-700 hover:text-white">Find Magazines</a>
              </div>
            </div>
          </div>

          <!-- Right Side - Magazine Stack -->
          <div class="lg:flex-1 lg:max-w-lg">
            <div class="relative magazine-stack-container">
              <!-- Magazine Stack Effect -->
              <div class="relative transform transition-all duration-700">
                <!-- Third magazine (back) - First Edition -->
                <a href="/editions/first-edition" class="magazine-back absolute transition-all duration-500 ease-out cursor-pointer block overflow-hidden">
                  <img 
                    src="/images/first-edition-cover-hd.webp" 
                    alt="Nomad Magazine First Edition" 
                    class="h-auto w-64 rounded-lg shadow-2xl shadow-yellow-400/20 md:w-80 pointer-events-none"
                    loading="lazy"
                  />
                </a>
                
                <!-- Second magazine (middle) - Second Edition -->
                <a href="/editions/second-edition" class="magazine-middle absolute transition-all duration-500 ease-out cursor-pointer block overflow-hidden">
                  <img 
                    src="/images/edition-002-cover.webp" 
                    alt="Nomad Magazine Second Edition" 
                    class="h-auto w-64 rounded-lg shadow-2xl shadow-purple-400/20 md:w-80 pointer-events-none"
                    loading="lazy"
                  />
                </a>
                
                <!-- First magazine (front) - Third Edition -->
                <a href="/editions/third-edition" class="magazine-front relative cursor-pointer block transition-all duration-500 ease-out overflow-hidden">
                  <img 
                    src="/images/third-edition-cover-hd.webp" 
                    alt="Nomad Magazine Third Edition" 
                    class="h-auto w-64 rounded-lg shadow-2xl shadow-white/30 md:w-80 pointer-events-none"
                    loading="lazy"
                  />
                  <!-- Floating badge -->
                  <div class="absolute -right-4 -top-4 rounded-full bg-yellow-400 px-3 py-1 text-xs font-bold text-black pointer-events-none">
                    Latest!
                  </div>
                </a>
              </div>

              <!-- Decorative elements -->
              <div class="absolute -left-8 top-1/2 h-4 w-4 rounded-full bg-yellow-400/60 blur-sm"></div>
              <div class="absolute -right-4 top-1/4 h-6 w-6 rounded-full bg-purple-400/40 blur-sm"></div>
              <div class="absolute bottom-8 left-4 h-3 w-3 rounded-full bg-white/30 blur-sm"></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Featured Articles Section -->
    <section class="bg-gray-800/50 py-16">
      <div class="container mx-auto px-4">
        <div class="mb-12 text-center">
          <h2 class="text-2xl font-bold text-yellow-400 md:text-3xl">While You're Here...</h2>
          <p class="mt-2 text-gray-400">Discover what nomads around the world are reading</p>
        </div>
        
        <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
          <!-- Feature 1 -->
          <div class="group cursor-pointer rounded-lg bg-gray-800 p-6 transition-all hover:bg-gray-700 hover:scale-105">
            <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-yellow-400">
              <svg class="h-6 w-6 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
              </svg>
            </div>
            <h3 class="mb-2 text-lg font-bold">Latest Articles</h3>
            <p class="mb-4 text-sm text-gray-400">Fresh insights from nomads worldwide</p>
            <a href="/blog" class="text-yellow-400 hover:underline">Read Blog →</a>
          </div>

          <!-- Feature 2 -->
          <div class="group cursor-pointer rounded-lg bg-gray-800 p-6 transition-all hover:bg-gray-700 hover:scale-105">
            <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-purple-500">
              <svg class="h-6 w-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
            </div>
            <h3 class="mb-2 text-lg font-bold">Nomad Directory</h3>
            <p class="mb-4 text-sm text-gray-400">Connect with the global nomad community</p>
            <a href="/nomad_directory" class="text-yellow-400 hover:underline">Explore Directory →</a>
          </div>

          <!-- Feature 3 -->
          <div class="group cursor-pointer rounded-lg bg-gray-800 p-6 transition-all hover:bg-gray-700 hover:scale-105">
            <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-green-500">
              <svg class="h-6 w-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9.5a2.5 2.5 0 00-2.5-2.5H15"></path>
              </svg>
            </div>
            <h3 class="mb-2 text-lg font-bold">All Editions</h3>
            <p class="mb-4 text-sm text-gray-400">Browse our complete magazine collection</p>
            <a href="/editions" class="text-yellow-400 hover:underline">View Editions →</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Newsletter CTA -->
    <section class="py-16">
      <div class="container mx-auto px-4 text-center">
        <div class="mx-auto max-w-2xl">
          <h2 class="mb-4 text-2xl font-bold md:text-3xl">Don't Miss Out</h2>
          <p class="mb-8 text-gray-400">
            Join thousands of nomads getting exclusive content, tips, and stories delivered to their inbox.
          </p>
          <a 
            href="/#newsletter" 
            class="inline-block rounded-lg bg-gradient-to-r from-yellow-400 to-yellow-500 px-8 py-3 font-bold text-black transition-all hover:from-yellow-300 hover:to-yellow-400 hover:scale-105"
          >
            Join the Newsletter
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  /* Custom font for the 404 number */
  .font-justme {
    font-family: 'JustMeAgainDownHere', cursive;
  }
  
  /* Magazine stack default positions */
  .magazine-back {
    transform: translateX(0px) translateY(0px) rotate(-8deg);
    z-index: 1;
    width: 256px; /* w-64 equivalent */
    height: auto;
  }
  
  .magazine-middle {
    transform: translateX(40px) translateY(10px) rotate(-4deg);
    z-index: 2;
    width: 256px; /* w-64 equivalent */
    height: auto;
  }
  
  .magazine-front {
    transform: translateX(80px) translateY(20px) rotate(0deg);
    z-index: 3;
    width: 256px; /* w-64 equivalent */
    height: auto;
  }
  
  @media (min-width: 768px) {
    .magazine-back,
    .magazine-middle,
    .magazine-front {
      width: 320px; /* md:w-80 equivalent */
    }
  }
  
  /* Magazine stack hover effect - spread out to the right */
  .magazine-stack-container:hover .magazine-back {
    transform: translateX(0px) translateY(0px) rotate(-8deg);
  }
  
  .magazine-stack-container:hover .magazine-middle {
    transform: translateX(120px) translateY(10px) rotate(-4deg);
  }
  
  .magazine-stack-container:hover .magazine-front {
    transform: translateX(240px) translateY(20px) rotate(0deg);
  }
  
  /* Mobile: stack vertically on hover */
  @media (max-width: 768px) {
    .magazine-back {
      transform: translateX(0px) translateY(0px) rotate(-4deg);
    }
    
    .magazine-middle {
      transform: translateX(20px) translateY(5px) rotate(-2deg);
    }
    
    .magazine-front {
      transform: translateX(40px) translateY(10px) rotate(0deg);
    }
    
    .magazine-stack-container:hover .magazine-back {
      transform: translateX(0px) translateY(0px) rotate(-4deg);
    }
    
    .magazine-stack-container:hover .magazine-middle {
      transform: translateX(0px) translateY(100px) rotate(0deg);
    }
    
    .magazine-stack-container:hover .magazine-front {
      transform: translateX(0px) translateY(200px) rotate(0deg);
    }
  }
  
  /* Hover effects for individual magazines */
  .magazine-back:hover,
  .magazine-middle:hover,
  .magazine-front:hover {
    transform: scale(1.05) !important;
    z-index: 10 !important;
  }
</style>
</Layout>
