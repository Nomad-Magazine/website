---
export const prerender = true;

import Layout, { type SEOProps } from '~/layouts/Layout.astro'
import MagazineStack from '~/components/MagazineStack.astro'

const seoProps: SEOProps = {
  title: '404 - Page Not Found | Nomad Magazine',
  description: 'The page you were looking for could not be found. Explore our digital nomad magazine editions, articles about remote work, and inspiring nomad stories instead.',
  image: `${Astro.site}images/magazine-hold-against-chest.webp`,
  keywords: '404 error, page not found, nomad magazine, digital nomad, lost page',
  canonical: `${Astro.site}404/`,
  ldJSON: {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: '404 - Page Not Found | Nomad Magazine',
    description: 'The page you are looking for could not be found. Explore our digital nomad magazine content instead.',
    url: `${Astro.site}404/`,
    publisher: {
      '@type': 'Organization',
      name: 'Nomad Magazine',
      url: 'https://nomad-magazine.com/',
      logo: {
        '@type': 'ImageObject',
        url: `${Astro.site}logo.svg`,
        contentUrl: `${Astro.site}logo.svg`,
      },
    },
  },
}
---

<Layout seo={seoProps}>
  <main class="min-h-screen bg-gray-900 text-white relative">
    <!-- Background Pattern -->
    <div class="absolute inset-0 opacity-10 pointer-events-none">
      <div class="absolute inset-0 bg-gradient-to-br from-yellow-400/20 to-purple-600/20"></div>
      <div class="absolute top-0 left-1/4 h-96 w-96 rounded-full bg-yellow-400/10 blur-3xl"></div>
      <div class="absolute bottom-0 right-1/4 h-96 w-96 rounded-full bg-purple-600/10 blur-3xl"></div>
    </div>
    
    <!-- Hero Section -->
    <section class="relative overflow-hidden py-20">

      <div class="container mx-auto px-4">
        <div class="flex flex-col items-center gap-12 lg:flex-row lg:items-center lg:justify-between">
          
          <!-- Left Side - Error Message -->
          <div class="text-center lg:flex-1 lg:text-left">
            <div class="mb-8">
              <h1 style="font-size: clamp(4rem, 12vw, 18rem); line-height: 0.8;" class="font-justme font-bold text-yellow-400">
                <span aria-hidden="true">404</span>
                <span class="sr-only">404 Page Not Found</span>
              </h1>
              <div class="mt-4 space-y-2">
                <p class="text-3xl font-bold md:text-4xl lg:text-5xl">Page Not Found</p>
                <p class="text-lg text-gray-300 md:text-xl">This page seems to have gone on its own nomadic adventure!</p>
              </div>
            </div>
            
            <div class="mb-8 space-y-4">
              <p class="text-base text-gray-400 md:text-lg">
                Don't worry, fellow nomad. Even the best explorers sometimes take a wrong turn. 
                While you're here, why not check out our latest magazine edition?
              </p>
              <div class="flex flex-col gap-4 sm:flex-row lg:justify-start">
                <a
                  href="/"
                  class="inline-block rounded-lg bg-yellow-400 px-8 py-3 font-bold text-black transition-all hover:bg-yellow-300 hover:scale-105"
                  aria-label="Return to the homepage"
                >
                  Return Home
                </a>
                <a
                  href="/editions/third-edition/"
                  class="inline-block rounded-lg border border-white px-8 py-3 font-bold transition-all hover:bg-white hover:text-black hover:scale-105"
                  aria-label="View the latest magazine edition"
                >
                  Latest Edition
                </a>
              </div>
            </div>

            <!-- Quick Navigation -->
            <div class="space-y-4">
              <h3 class="text-lg font-semibold text-yellow-400">Popular Destinations:</h3>
              <div class="flex flex-wrap gap-2 text-sm">
                <a href="/blog/" class="rounded-full bg-gray-800 px-4 py-2 text-gray-300 transition-colors hover:bg-gray-700 hover:text-white">Blog</a>
                <a href="/nomad_directory/" class="rounded-full bg-gray-800 px-4 py-2 text-gray-300 transition-colors hover:bg-gray-700 hover:text-white">Nomad Directory</a>
                <a href="/our-story/" class="rounded-full bg-gray-800 px-4 py-2 text-gray-300 transition-colors hover:bg-gray-700 hover:text-white">Our Story</a>
                <a href="/partnerships/" class="rounded-full bg-gray-800 px-4 py-2 text-gray-300 transition-colors hover:bg-gray-700 hover:text-white">Partnerships</a>
                <a href="/distribution-list/" class="rounded-full bg-gray-800 px-4 py-2 text-gray-300 transition-colors hover:bg-gray-700 hover:text-white">Find Magazines</a>
              </div>
            </div>
          </div>

          <!-- Right Side - Magazine Stack -->
          <div class="lg:flex-1 lg:max-w-lg">
            <MagazineStack showLatestBadge={true} />
          </div>
        </div>
      </div>
    </section>

    <!-- Featured Articles Section -->
    <section class="bg-gray-800/50 py-16">
      <div class="container mx-auto px-4">
        <div class="mb-12 text-center">
          <h2 class="text-2xl font-bold text-yellow-400 md:text-3xl">While You're Here...</h2>
          <p class="mt-2 text-gray-400">Discover what nomads around the world are reading</p>
        </div>
        
        <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
          <!-- Feature 1 -->
          <div class="group cursor-pointer rounded-lg bg-gray-800 p-6 transition-all hover:bg-gray-700 hover:scale-105">
            <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-yellow-400">
              <svg class="h-6 w-6 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
              </svg>
            </div>
            <h3 class="mb-2 text-lg font-bold">Latest Articles</h3>
            <p class="mb-4 text-sm text-gray-400">Fresh insights from nomads worldwide</p>
            <a href="/blog/" class="text-yellow-400 hover:underline" aria-label="Read the blog for latest articles">Read Blog →</a>
          </div>

          <!-- Feature 2 -->
          <div class="group cursor-pointer rounded-lg bg-gray-800 p-6 transition-all hover:bg-gray-700 hover:scale-105">
            <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-purple-500">
              <svg class="h-6 w-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
            </div>
            <h3 class="mb-2 text-lg font-bold">Nomad Directory</h3>
            <p class="mb-4 text-sm text-gray-400">Connect with the global nomad community</p>
            <a href="/nomad_directory/" class="text-yellow-400 hover:underline" aria-label="Explore the Nomad Directory">Explore Directory →</a>
          </div>

          <!-- Feature 3 -->
          <div class="group cursor-pointer rounded-lg bg-gray-800 p-6 transition-all hover:bg-gray-700 hover:scale-105">
            <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-green-500">
              <svg class="h-6 w-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9.5a2.5 2.5 0 00-2.5-2.5H15"></path>
              </svg>
            </div>
            <h3 class="mb-2 text-lg font-bold">All Editions</h3>
            <p class="mb-4 text-sm text-gray-400">Browse our complete magazine collection</p>
            <a href="/editions/" class="text-yellow-400 hover:underline" aria-label="View all magazine editions">View Editions →</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Newsletter CTA -->
    <section class="py-16">
      <div class="container mx-auto px-4 text-center">
        <div class="mx-auto max-w-2xl">
          <h2 class="mb-4 text-2xl font-bold md:text-3xl">Don't Miss Out</h2>
          <p class="mb-8 text-gray-400">
            Join thousands of nomads getting exclusive content, tips, and stories delivered to their inbox.
          </p>
          <a
            href="/#newsletter/"
            class="inline-block rounded-lg bg-gradient-to-r from-yellow-400 to-yellow-500 px-8 py-3 font-bold text-black transition-all hover:from-yellow-300 hover:to-yellow-400 hover:scale-105"
            aria-label="Join the Nomad Newsletter"
          >
            Join the Newsletter
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  /* Custom font for the 404 number */
  .font-justme {
    font-family: 'JustMeAgainDownHere', cursive;
  }
</style>
