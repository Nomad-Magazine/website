  keywords: 'nomad magazine, digital nomad, 2025 recap, founder note, nomad community',
  ogType: 'article',
  ldJSON: {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: 'A Note From Founder, 2025 for Nomad Magazine + Gift',
    description: 'A recap of 2025 year, a few thoughts for 2026 year, a big thank you for being part of it, and a little gift at the end.',
