---
export const prerender = true;

import Layout, { type SEOProps } from '~/layouts/Layout.astro'
import CheckIcon from '~icons/ic/baseline-check'
import TurkeyMagazineStack from '~/components/TurkeyMagazineStack.astro'

const seo: SEOProps = {
  title: "Feature Turkey in Nomad Magazine | Premium Partnership",
  description: "Partner with Nomad Magazine to showcase Turkey to Europe's digital nomads. Professional storytelling and European distribution starting at €7K.",
  keywords: "Turkey destination marketing, digital nomad magazine, Istanbul tourism, premium sponsorship",
  image: `${Astro.site}images/nomad-magazine-cover.webp`,
  ogType: "website" as const,
  noIndex: true
}
---

<Layout seo={seo}>
  <!-- Hero Section -->
  <div class="bg-linear-to-br from-red-600 via-red-500 to-red-700 text-white py-32">
    <div class="mx-auto max-w-4xl px-4 text-center">
      <div class="text-7xl mb-8">🇹🇷</div>
      <h1 class="text-5xl font-bold mb-6 md:text-6xl">
        Put Turkey on Every Nomad's Radar
      </h1>
      <p class="text-xl mb-12 text-red-100 leading-relaxed max-w-3xl mx-auto">
        Europe's only print magazine for digital nomads reaches 10000+ remote work professionals 
        across 100+ distribution points in Europe. Get Turkey featured before your competitors do.
      </p>

      <!-- Cover Preview -->
      <div class="relative max-w-md mx-auto mb-12">
        <div class="bg-white rounded-2xl shadow-2xl p-6 transform rotate-3 hover:rotate-0 transition-transform duration-300">
          <img 
            src="/images/turkey-cover-preview.webp" 
            alt="Turkey Magazine Cover Preview" 
            class="w-full rounded-lg shadow-lg"
            loading="eager"
          />
          <div class="mt-4 text-center">
            <p class="text-sm font-semibold text-gray-900">Turkey Cover Design</p>
            <p class="text-xs text-gray-600">Professional Layout & Branding</p>
          </div>
        </div>
        <div class="absolute -bottom-6 -right-6 bg-orange-400 text-black px-4 py-2 rounded-full text-sm font-bold shadow-lg">
          Cover Preview
        </div>
      </div>

      <div class="flex justify-center">
        <a
          href="#packages"
          class="bg-white text-red-600 px-8 py-4 rounded-lg font-bold text-lg hover:bg-red-50 transition-colors"
        >
          View Partnership Options →
        </a>
      </div>
    </div>
  </div>

  <!-- The Opportunity -->
  <div class="bg-white py-20">
    <div class="mx-auto max-w-5xl px-4">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold text-gray-900 mb-6">Why Turkey, Why Now</h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          Turkey offers everything nomads want: vibrant cities, stunning coastlines, rich culture, 
          affordable living, and perfect positioning between Europe and Asia.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
        <div class="text-center">
          <div class="text-4xl mb-4">💰</div>
          <h3 class="text-xl font-bold text-gray-900 mb-2">50-60% Lower Costs</h3>
          <p class="text-gray-600">Quality apartment €400-800/month vs €1,500+ in Berlin</p>
        </div>
        <div class="text-center">
          <div class="text-4xl mb-4">🌐</div>
          <h3 class="text-xl font-bold text-gray-900 mb-2">Excellent Infrastructure</h3>
          <p class="text-gray-600">High-speed internet, modern coworking spaces in Istanbul, Antalya & more</p>
        </div>
        <div class="text-center">
          <div class="text-4xl mb-4">🕒</div>
          <h3 class="text-xl font-bold text-gray-900 mb-2">Strategic Time Zone</h3>
          <p class="text-gray-600">GMT+3 bridges European and Asian business hours perfectly</p>
        </div>
      </div>

      <div class="bg-orange-50 rounded-xl p-8 border border-orange-200 text-center">
        <h3 class="text-2xl font-bold text-orange-900 mb-4">Emerging Nomad Hotspot</h3>
        <p class="text-orange-800 text-lg">
          Portugal is overpriced. Bali is far. Turkey offers the perfect blend of culture, affordability, 
          and connectivity that smart nomads are discovering <strong>now</strong>.
        </p>
      </div>
    </div>
  </div>

  <!-- Partnership Packages -->
  <div class="bg-gray-50 py-20" id="packages">
    <div class="mx-auto max-w-6xl px-4">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold text-gray-900 mb-6">Partnership Options</h2>
        <p class="text-xl text-gray-600">Choose the approach that fits your marketing strategy</p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        
        <!-- Recommended Package -->
        <div class="relative bg-white rounded-2xl p-8 border-4 border-blue-500 shadow-xl flex flex-col">
          <div class="absolute -top-4 left-1/2 transform -translate-x-1/2">
            <div class="bg-blue-500 text-white px-6 py-2 rounded-full text-sm font-bold">
              RECOMMENDED
            </div>
          </div>
          
          <div class="text-center mb-8">
            <h3 class="text-3xl font-bold text-gray-900 mb-2">Cover Feature Package</h3>
            <div class="text-5xl font-bold text-blue-600 mb-4">€7,500</div>
            <p class="text-gray-600">Strategic introduction to European nomads</p>
          </div>
          
          <div class="space-y-4 mb-8">
            <div class="flex items-center">
              <CheckIcon class="mr-3 h-5 w-5 text-green-500" />
              <span>Turkey featured on magazine cover</span>
            </div>
            <div class="flex items-center">
              <CheckIcon class="mr-3 h-5 w-5 text-green-500" />
              <span>6-8 page editorial feature</span>
            </div>
            <div class="flex items-center">
              <CheckIcon class="mr-3 h-5 w-5 text-green-500" />
              <span>3 full-page ads for Turkey partners</span>
            </div>
            <div class="flex items-center">
              <CheckIcon class="mr-3 h-5 w-5 text-green-500" />
              <span>1,000 copies across Europe</span>
            </div>
            <div class="flex items-center">
              <CheckIcon class="mr-3 h-5 w-5 text-green-500" />
              <span>Mixed content approach (proven effective)</span>
            </div>
          </div>

          <div class="bg-blue-50 rounded-lg p-4 mb-6">
            <p class="text-blue-800 text-sm font-medium">
              ✨ <strong>Perfect balance:</strong> Turkey gets prominent coverage while benefiting from our editorial expertise and diverse readership
            </p>
          </div>

          <a
            href="mailto:lera@nomadgossip.com?subject=Turkey%20Cover%20Feature%20-%20€7.5K%20Package"
            class="w-full bg-blue-600 text-white py-3 px-6 rounded-lg font-bold text-center block hover:bg-blue-700 transition-colors mt-auto"
          >
            Get This Package →
          </a>
        </div>

        <!-- Premium Package -->
        <div class="bg-white rounded-2xl p-8 border border-gray-200 shadow-lg flex flex-col">
          <div class="text-center mb-8">
            <h3 class="text-3xl font-bold text-gray-900 mb-2">Exclusive Edition</h3>
            <div class="text-5xl font-bold text-red-600 mb-4">€17,000</div>
            <p class="text-gray-600">Comprehensive Turkey campaign</p>
          </div>
          
          <div class="space-y-4 mb-8">
            <div class="flex items-center">
              <CheckIcon class="mr-3 h-5 w-5 text-green-500" />
              <span>Entire magazine about Turkey</span>
            </div>
            <div class="flex items-center">
              <CheckIcon class="mr-3 h-5 w-5 text-green-500" />
              <span>80-100-page comprehensive destination guide</span>
            </div>
            <div class="flex items-center">
              <CheckIcon class="mr-3 h-5 w-5 text-green-500" />
              <span>Unlimited advertising ads for Turkey partners</span>
            </div>
            <div class="flex items-center">
              <CheckIcon class="mr-3 h-5 w-5 text-green-500" />
              <span>1,000 copies across Europe</span>
            </div>
            <div class="flex items-center">
              <CheckIcon class="mr-3 h-5 w-5 text-green-500" />
              <span>Complete regional breakdown for nomads</span>
            </div>
          </div>

          <div class="bg-red-50 rounded-lg p-4 mb-6">
            <p class="text-red-800 text-sm font-medium">
              👑 <strong>Ultimate destination guide:</strong> 100 pages covering every aspect of Turkey for nomads—cities, culture, business, lifestyle, and opportunities
            </p>
          </div>

          <div class="bg-amber-50 rounded-lg p-4 mb-6 border border-amber-200">
            <p class="text-amber-800 text-sm">
              <strong>Note:</strong> Nomad Magazine reserves the right to sell other advertisements if any, and highlighted spots in Nomad Directory.
            </p>
          </div>

          <a
            href="mailto:lera@nomadgossip.com?subject=Turkey%20Exclusive%20Edition%20-%20€17K%20Package"
            class="w-full bg-red-600 text-white py-3 px-6 rounded-lg font-bold text-center block hover:bg-red-700 transition-colors mt-auto"
          >
            Get This Package →
          </a>
        </div>
      </div>

      <!-- Simple Comparison -->
      <div class="mt-16 bg-white rounded-xl p-8 shadow-lg">
        <h3 class="text-2xl font-bold text-gray-900 mb-6 text-center">Quick Comparison</h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-center">
          <div>
            <h4 class="font-semibold text-gray-900 mb-2">Focus</h4>
            <p class="text-blue-600 font-medium">Cover Feature: Turkey highlighted</p>
            <p class="text-red-600 font-medium">Exclusive: Turkey only</p>
          </div>
          <div>
            <h4 class="font-semibold text-gray-900 mb-2">Content</h4>
            <p class="text-blue-600 font-medium">Cover Feature: 8-10 pages</p>
            <p class="text-red-600 font-medium">Exclusive: 100-page guide</p>
          </div>
          <div>
            <h4 class="font-semibold text-gray-900 mb-2">Best For</h4>
            <p class="text-blue-600 font-medium">Cover Feature: Strategic intro</p>
            <p class="text-red-600 font-medium">Exclusive: Major campaign</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Editorial Process -->
  <div class="bg-blue-50 py-20">
    <div class="mx-auto max-w-5xl px-4">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold text-gray-900 mb-6">Our Editorial Partnership Process</h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          We work collaboratively while maintaining our editorial standards and brand voice that nomads trust.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="bg-white rounded-xl p-8 border border-blue-200 shadow-lg">
          <div class="text-4xl mb-6 text-center">🤝</div>
          <h3 class="text-2xl font-bold text-gray-900 mb-4 text-center">Collaborative Content Creation</h3>
          <p class="text-gray-600 text-center">
            Nomad Magazine team works directly with Turkey partners to develop content that's genuinely valuable 
            for digital nomads, combining local insights with our editorial expertise.
          </p>
        </div>

        <div class="bg-white rounded-xl p-8 border border-blue-200 shadow-lg">
          <div class="text-4xl mb-6 text-center">✍️</div>
          <h3 class="text-2xl font-bold text-gray-900 mb-4 text-center">Brand-Aligned Editing</h3>
          <p class="text-gray-600 text-center">
            We maintain our established editing style and brand voice throughout the edition to ensure 
            consistency and credibility that our readers expect and trust.
          </p>
        </div>

        <div class="bg-white rounded-xl p-8 border border-blue-200 shadow-lg">
          <div class="text-4xl mb-6 text-center">🎯</div>
          <h3 class="text-2xl font-bold text-gray-900 mb-4 text-center">Editorial Standards</h3>
          <p class="text-gray-600 text-center">
            Nomad Magazine reserves the right to refine or decline content that doesn't align with our 
            editorial perspective or isn't relevant to our nomad audience.
          </p>
        </div>
      </div>

      <div class="mt-12 bg-white rounded-xl p-8 border border-blue-200">
        <h3 class="text-2xl font-bold text-gray-900 mb-4 text-center">Why This Matters</h3>
        <p class="text-gray-700 text-lg text-center max-w-4xl mx-auto">
          Our readers trust Nomad Magazine because we maintain consistent editorial quality. 
          This collaborative approach ensures Turkey is presented authentically while meeting 
          the high standards our nomad community expects.
        </p>
      </div>
    </div>
  </div>

  <!-- Production Timeline -->
  <div class="bg-white py-20">
    <div class="mx-auto max-w-5xl px-4">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold text-gray-900 mb-6">Production Timeline</h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          From concept to distribution in 5-6 months
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
        <div class="relative">
          <div class="bg-blue-100 rounded-xl p-6 text-center h-full">
            <div class="bg-blue-600 text-white rounded-full w-12 h-12 flex items-center justify-center font-bold text-lg mx-auto mb-4">1</div>
            <h3 class="text-xl font-bold text-gray-900 mb-2">Content Creation</h3>
            <p class="text-3xl font-bold text-blue-600 mb-2">2 months</p>
            <p class="text-gray-600 text-sm">Research, writing, and photography</p>
          </div>
        </div>

        <div class="relative">
          <div class="bg-purple-100 rounded-xl p-6 text-center h-full">
            <div class="bg-purple-600 text-white rounded-full w-12 h-12 flex items-center justify-center font-bold text-lg mx-auto mb-4">2</div>
            <h3 class="text-xl font-bold text-gray-900 mb-2">Design</h3>
            <p class="text-3xl font-bold text-purple-600 mb-2">2 months</p>
            <p class="text-gray-600 text-sm">Layout, graphics, and visual design</p>
          </div>
        </div>

        <div class="relative">
          <div class="bg-orange-100 rounded-xl p-6 text-center h-full">
            <div class="bg-orange-500 text-white rounded-full w-12 h-12 flex items-center justify-center font-bold text-lg mx-auto mb-4">3</div>
            <h3 class="text-xl font-bold text-gray-900 mb-2">Proofread & Finalize</h3>
            <p class="text-3xl font-bold text-orange-500 mb-2">1 month</p>
            <p class="text-gray-600 text-sm">Final review and finishing details</p>
          </div>
        </div>

        <div class="relative">
          <div class="bg-green-100 rounded-xl p-6 text-center h-full">
            <div class="bg-green-600 text-white rounded-full w-12 h-12 flex items-center justify-center font-bold text-lg mx-auto mb-4">4</div>
            <h3 class="text-xl font-bold text-gray-900 mb-2">Print & Distribute</h3>
            <p class="text-3xl font-bold text-green-600 mb-2">1 month</p>
            <p class="text-gray-600 text-sm">Printing and European distribution</p>
          </div>
        </div>
      </div>

      <div class="mt-12 bg-gray-50 rounded-xl p-6 text-center">
        <p class="text-gray-700 text-lg">
          <strong>Total timeline:</strong> 5-6 months from project kickoff to magazines in hands across Europe
        </p>
      </div>
    </div>
  </div>

  <!-- Who We Are -->
  <div class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4">
      <div class="text-center mb-16">
        <h2 class="text-2xl text-gray-600 mb-4">Who We Are?</h2>
        <h3 class="text-4xl font-bold text-gray-900 mb-6">Europe's Only Print Magazine for Digital Nomads</h3>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          Trusted by tourism boards worldwide, and the definitive voice in nomad destination marketing.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <!-- Track Record -->
        <div>
          <h3 class="text-3xl font-bold text-gray-900 mb-8">Our Track Record</h3>
          <div class="space-y-6">
            <div class="flex items-start">
              <div class="bg-orange-400 text-black rounded-full w-12 h-12 flex items-center justify-center font-bold text-lg mr-6 shrink-0">4</div>
              <div>
                <h4 class="text-xl font-semibold text-gray-900">Published Editions</h4>
                <p class="text-gray-600">Consistent quality and growing readership across Europe</p>
              </div>
            </div>
            <div class="flex items-start">
              <div class="bg-orange-400 text-black rounded-full w-12 h-12 flex items-center justify-center font-bold text-sm mr-6 shrink-0">4K</div>
              <div>
                <h4 class="text-xl font-semibold text-gray-900">Printed Copies</h4>
                <p class="text-gray-600">4,000 magazines printed and distributed across four editions</p>
              </div>
            </div>
            <div class="flex items-start">
              <div class="bg-orange-400 text-black rounded-full w-12 h-12 flex items-center justify-center font-bold text-sm mr-6 shrink-0">100+</div>
              <div>
                <h4 class="text-xl font-semibold text-gray-900">Distribution Points</h4>
                <p class="text-gray-600">Coworking spaces, colivings, and nomad events across Europe</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Magazine Covers Visual -->
        <div class="space-y-8">
          <div class="flex justify-center">
            <TurkeyMagazineStack className="max-w-full" />
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Simple CTA -->
  <div class="bg-red-600 py-20">
    <div class="mx-auto max-w-3xl px-4 text-center">
      <h2 class="text-4xl font-bold text-white mb-6">Ready to Position Turkey?</h2>
      <p class="text-xl text-red-100 mb-10">
        Join destination partners already seeing results. Limited to one destination per edition.
      </p>
      
      <div class="space-y-4">
        <a
          href="https://calendly.com/nomadmagazine"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block bg-white text-red-600 px-10 py-4 rounded-lg text-xl font-bold hover:bg-red-50 transition-colors mr-4"
        >
          Schedule Partnership Call
        </a>
        
        <p class="text-red-200 text-sm">
          <strong>lera@nomadgossip.com</strong> 
        </p>
      </div>
    </div>
  </div>
</Layout>

<style>
/* Smooth scrolling for anchor links */
html {
  scroll-behavior: smooth;
}
</style>
