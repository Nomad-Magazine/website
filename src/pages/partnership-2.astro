---
export const prerender = true;

import Layout, { type SEOProps } from '~/layouts/Layout.astro'
import CheckIcon from '~icons/ic/baseline-check'
import ArrowRightIcon from '~icons/ic/baseline-arrow-forward'

const seo: SEOProps = {
  title: 'Partner with Nomad Magazine - B2B Partnership Opportunities',
  description: 'Partner with Nomad Magazine to reach the global digital nomad community. Join our directory, become a distribution partner, or feature your brand in our print magazine.',
  image: `${Astro.site}images/edition-001-nomad-mag-brand-placement.webp`,
  keywords: 'nomad magazine partnerships, B2B collaboration, digital nomad marketing, coworking distribution, brand partnerships, nomad directory',
  ogType: 'website',
  ldJSON: {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Partner with Nomad Magazine',
    description: 'B2B partnership opportunities with Nomad Magazine',
    url: `${Astro.site}partnerships`,
    publisher: {
      '@type': 'Organization',
      name: 'Nomad Magazine',
      logo: {
        '@type': 'ImageObject',
        url: `${Astro.site}logo.svg`,
      },
    },
  },
}

const userJourneys = [
  {
    type: 'Coworking & Coliving',
    subtitle: 'Physical spaces for nomads',
    description: 'Perfect for coworking spaces, colivings, and hostels that want to offer magazines to their nomad community',
    icon: '🏢',
    color: 'from-orange-500/20 to-red-500/20',
    borderColor: 'border-orange-400',
    steps: [
      {
        level: 1,
        title: 'Free Directory',
        price: 'Free',
        description: 'Get listed in our nomad directory',
        features: ['Website listing', 'Instagram feature', 'Database inclusion'],
        cta: 'Join Directory',
        ctaUrl: 'https://form.smartsuite.com/s4tmc086/8sFlvrVlDC'
      },
      {
        level: 2,
        title: 'Magazine Distribution',
        price: '€25 shipping',
        description: 'Receive physical magazines for your space',
        features: ['Physical magazine copies', 'Distribution partner listing', 'Featured as partner'],
        cta: 'Get Magazines',
        ctaUrl: 'https://calendly.com/nomadgossip'
      }
    ]
  },
  {
    type: 'Small Business',
    subtitle: 'Growing nomad services',
    description: 'For nomad-focused services, apps, and small businesses ready to reach our community',
    icon: '🚀',
    color: 'from-blue-500/20 to-cyan-500/20',
    borderColor: 'border-blue-400',
    steps: [
      {
        level: 1,
        title: 'Nomad Directory',
        price: 'Free + Boosts €50-250',
        description: 'Start free, add digital boosts for visibility',
        features: ['Free directory listing', 'Optional homepage features', 'Social media spotlight boosts'],
        cta: 'Join & Boost',
        ctaUrl: '/nomad-directory-boost-options'
      },
      {
        level: 2,
        title: 'Print Advertising',
        price: '€150-500',
        description: 'Small print placements',
        features: ['Quarter/half page ads', 'Global print distribution', 'Professional design'],
        cta: 'Advertise',
        ctaUrl: '/brand-placement-next-edition-847291'
      }
    ]
  },
  {
    type: 'Established Brand',
    subtitle: 'Major companies & brands',
    description: 'For established companies seeking comprehensive nomad community partnerships',
    icon: '👑',
    color: 'from-purple-500/20 to-pink-500/20',
    borderColor: 'border-purple-400',
    steps: [
      {
        level: 1,
        title: 'Premium Print',
        price: '€600-1,200',
        description: 'Full page advertisements',
        features: ['Full page placement', 'Premium positioning', 'Custom design support'],
        cta: 'Go Premium',
        ctaUrl: '/brand-placement-next-edition-847291'
      },
      {
        level: 2,
        title: 'Strategic Partnership',
        price: 'Custom',
        description: 'Long-term collaboration',
        features: ['Multi-edition presence', 'Content partnerships', 'Community initiatives'],
        cta: 'Let\'s Partner',
        ctaUrl: 'https://calendly.com/nomadgossip'
      }
    ]
  }
]

const whyPartnerReasons = [
  {
    title: 'Growing Market',
    description: 'The digital nomad population continues to expand rapidly, with millions embracing location-independent lifestyles.',
    stat: '50M+ nomads worldwide'
  },
  {
    title: 'High Purchasing Power',
    description: 'Digital nomads typically have above-average income and actively seek services that support their lifestyle.',
    stat: 'Premium audience'
  },
  {
    title: 'Print + Digital Reach',
    description: 'Unique print-first approach combined with strong digital presence ensures maximum visibility.',
    stat: '100+ distribution points'
  },
  {
    title: 'Community Trust',
    description: 'Our authentic approach and community-first mindset builds genuine trust with our audience.',
    stat: 'High engagement rates'
  }
]
---

<Layout seo={seo}>
  <!-- Hero Section -->
  <div class="bg-hoverw text-white">
    <section class="py-20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2">
          <div class="space-y-8">
            <div class="space-y-6">
              <h1 class="text-5xl font-bold leading-tight md:text-7xl">
                Grow with the <span class="text-yellow-400">Nomad Community</span>
              </h1>
              <p class="text-xl text-gray-300 md:text-2xl">
                Choose your partnership journey based on where your business is today. From free directory listings to premium print partnerships - we'll grow together.
              </p>
            </div>
            
            <div class="space-y-4 text-lg text-gray-300">
              <p class="flex items-start">
                <CheckIcon class="mr-3 h-6 w-6 flex-shrink-0 text-yellow-400 mt-0.5" />
                <span>Join a growing ecosystem of nomad-focused brands and services</span>
              </p>
              <p class="flex items-start">
                <CheckIcon class="mr-3 h-6 w-6 flex-shrink-0 text-yellow-400 mt-0.5" />
                <span>Reach an engaged audience of location-independent professionals</span>
              </p>
              <p class="flex items-start">
                <CheckIcon class="mr-3 h-6 w-6 flex-shrink-0 text-yellow-400 mt-0.5" />
                <span>Benefit from our unique print-first approach with global distribution</span>
              </p>
            </div>

            <div class="flex flex-col gap-4 sm:flex-row">
              <a
                href="#partnership-options"
                class="inline-flex items-center justify-center gap-2 rounded-lg bg-yellow-400 px-8 py-4 text-lg font-bold text-black transition-all hover:bg-yellow-300 hover:scale-105"
              >
                Find Your Journey
                <ArrowRightIcon class="h-5 w-5" />
              </a>
              <a
                href="https://form.smartsuite.com/s4tmc086/8sFlvrVlDC"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-2 rounded-lg border-2 border-yellow-400 px-8 py-4 text-lg font-bold text-yellow-400 transition-all hover:bg-yellow-400 hover:text-black"
              >
                Start Free
              </a>
            </div>
          </div>
          
          <div class="flex justify-center lg:justify-end">
            <img 
              src="/images/edition-001-nomad-mag-brand-placement.webp" 
              alt="Nomad Magazine brand placement opportunities" 
              class="max-w-full rounded-2xl shadow-2xl" 
              loading="eager"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Why Partner Section -->
    <section class="border-b border-neutral-800 py-16">
      <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        <div class="mb-12 text-center">
          <h2 class="text-3xl font-bold text-white md:text-4xl">Why Partner with Us?</h2>
        </div>

        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4">
          {whyPartnerReasons.map((reason) => (
            <div class="bg-neutral-900/50 rounded-xl p-5 border border-neutral-800 text-center">
              <div class="mb-3">
                <div class="inline-block bg-yellow-400 text-black px-2 py-1 rounded-full text-xs font-bold">
                  {reason.stat}
                </div>
              </div>
              <h3 class="text-lg font-bold text-white mb-2">{reason.title}</h3>
              <p class="text-gray-300 text-sm">{reason.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Partnership Journey Section -->
    <section id="partnership-options" class="border-b border-neutral-800 py-20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mb-16 text-center">
          <h2 class="text-4xl font-bold text-white md:text-5xl">Choose Your Partnership Journey</h2>
          <p class="mt-4 text-xl text-gray-300 max-w-4xl mx-auto">
            Every business is unique. Find your path based on where you are now, and grow with us as your nomad community engagement evolves.
          </p>
        </div>

        <div class="space-y-16">
          {userJourneys.map((journey) => (
            <div class={`relative overflow-hidden rounded-3xl border-2 ${journey.borderColor} bg-gradient-to-r ${journey.color} p-8 backdrop-blur-sm`}>
              <!-- Journey Header -->
              <div class="mb-8 text-center lg:text-left lg:flex lg:items-center lg:justify-between">
                <div class="flex items-center justify-center lg:justify-start gap-4 mb-4 lg:mb-0">
                  <div class="text-4xl">{journey.icon}</div>
                  <div>
                    <h3 class="text-2xl font-bold text-white">{journey.type}</h3>
                    <p class="text-lg text-gray-300">{journey.subtitle}</p>
                  </div>
                </div>
                <div class="max-w-md">
                  <p class="text-gray-300">{journey.description}</p>
                </div>
              </div>

              <!-- Journey Steps -->
              <div class={`grid grid-cols-1 gap-6 ${journey.steps.length === 2 ? 'md:grid-cols-2' : 'md:grid-cols-3'}`}>
                {journey.steps.map((step, index) => (
                  <div class="relative">
                    <!-- Connection Line -->
                    {index < journey.steps.length - 1 && (
                      <div class="hidden md:block absolute top-1/2 -right-3 w-6 h-0.5 bg-gradient-to-r from-yellow-400 to-transparent z-10"></div>
                    )}
                    
                    <!-- Step Card -->
                    <div class="bg-black/30 border border-white/20 rounded-2xl p-6 h-full flex flex-col backdrop-blur-sm hover:bg-black/40 transition-all">
                      <div class="flex items-center justify-between mb-4">
                        <div class="bg-yellow-400 text-black w-8 h-8 rounded-full flex items-center justify-center font-bold text-sm">
                          {step.level}
                        </div>
                        <div class="text-2xl font-bold text-white">{step.price}</div>
                      </div>
                      
                      <h4 class="text-xl font-bold text-white mb-2">{step.title}</h4>
                      <p class="text-gray-300 mb-4 flex-grow">{step.description}</p>
                      
                      <ul class="space-y-2 mb-6">
                        {step.features.map((feature) => (
                          <li class="flex items-start text-sm">
                            <CheckIcon class="mr-2 h-4 w-4 flex-shrink-0 text-yellow-400 mt-0.5" />
                            <span class="text-gray-300">{feature}</span>
                          </li>
                        ))}
                      </ul>
                      
                      <a
                        href={step.ctaUrl}
                        target={step.ctaUrl.startsWith('http') ? '_blank' : '_self'}
                        rel={step.ctaUrl.startsWith('http') ? 'noopener noreferrer' : undefined}
                        class="block w-full rounded-lg bg-yellow-400 text-black py-3 text-center font-bold transition-all hover:bg-yellow-300 mt-auto"
                      >
                        {step.cta}
                      </a>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>

        <!-- Quick Start Section -->
        <div class="mt-16 text-center bg-gradient-to-r from-neutral-900/50 to-neutral-800/50 rounded-3xl p-8 border border-neutral-700">
          <h3 class="text-2xl font-bold text-white mb-4">Not Sure Which Path Fits You?</h3>
          <p class="text-gray-300 mb-6 max-w-2xl mx-auto">
            Start with our free directory listing to get a feel for our community, or schedule a call to discuss custom partnership opportunities.
          </p>
          <div class="flex flex-col gap-4 sm:flex-row sm:justify-center">
            <a
              href="https://form.smartsuite.com/s4tmc086/8sFlvrVlDC"
              class="inline-flex items-center justify-center gap-2 rounded-lg bg-yellow-400 px-8 py-4 text-lg font-bold text-black transition-all hover:bg-yellow-300 hover:scale-105"
            >
              Start Free Directory Listing
              <ArrowRightIcon class="h-5 w-5" />
            </a>
            <a
              href="https://calendly.com/nomadgossip"
              class="inline-flex items-center gap-2 rounded-lg border-2 border-yellow-400 px-8 py-4 text-lg font-bold text-yellow-400 transition-all hover:bg-yellow-400 hover:text-black"
            >
              Schedule Partnership Call
              <ArrowRightIcon class="h-5 w-5" />
            </a>
          </div>
        </div>
      </div>
    </section>



    <!-- About Our Mission Section -->
    <section class="border-b border-neutral-800 py-16">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-3xl font-bold text-white mb-6 md:text-4xl">Our Mission</h2>
        <div class="space-y-4 text-gray-300">
          <p>
            At Nomad Magazine, we share inspirational stories, knowledge, and resources to help international people live and work abroad—whether they call themselves digital nomads or simply happen to live freely.
          </p>
          <p>
            We support the growth of the digital nomad ecosystem and bridge the gap between nomads and local communities worldwide.
          </p>
          <p>
            As a self-funded project, we choose partnerships over traditional advertising to maintain our authentic voice while supporting the businesses that make the nomad lifestyle possible.
          </p>
        </div>
      </div>
    </section>

    <!-- Call to Action Section -->
    <section class="py-16">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-3xl font-bold text-white mb-4 md:text-4xl">Ready to Partner?</h2>
        
        <div class="flex flex-col gap-4 sm:flex-row sm:justify-center">
          <a
            href="https://form.smartsuite.com/s4tmc086/8sFlvrVlDC"
            class="inline-flex items-center justify-center gap-2 rounded-lg bg-yellow-400 px-8 py-4 text-lg font-bold text-black transition-all hover:bg-yellow-300 hover:scale-105"
          >
            Start with Directory Listing
            <ArrowRightIcon class="h-5 w-5" />
          </a>
        </div>
        
        <p class="mt-6 text-sm text-gray-400">
          Questions? Email us at <a href="mailto:partnerships@nomad-magazine.com" class="text-yellow-400 hover:text-yellow-300">partnerships@nomad-magazine.com</a>
        </p>
      </div>
    </section>
  </div>
</Layout>

<style>
.hover\:scale-105:hover {
  transform: scale(1.05);
}
</style>
