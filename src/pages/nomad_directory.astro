---
export const prerender = true;

import { fetchReportRecords } from '~/utils/smartsuite'
import Layout, { type SEOProps } from '~/layouts/Layout.astro'
import MaterialSymbolsElectricBolt from '~icons/material-symbols/electric-bolt'
const { records = [] } = await fetchReportRecords('6857167d82358a0f5e038c3f')

// Get Molly's exhibition article specifically

// YouTube videos data
const youtubeVideos = [
  {
    id: 'pgTpfH7zNVs',
    title: 'Why Digital Nomads Are Choosing Buenos Aires in 2025',
    description: 'Discover what makes Buenos Aires a top destination for digital nomads in 2025.',
    thumbnail: 'https://img.youtube.com/vi/pgTpfH7zNVs/hqdefault.jpg',
    duration: '18:45',
    views: '12.3K',
    publishedAt: '2025-01-20'
  },
  {
    id: 'NgG92Q8Uxgg',
    title: 'Why Digital Nomads Choosing Madeira in 2024: Madeira Friends Founders and Community',
    description: 'Meet the founders behind Madeira Friends and discover why digital nomads are flocking to this Portuguese island.',
    thumbnail: 'https://img.youtube.com/vi/NgG92Q8Uxgg/hqdefault.jpg',
    duration: '14:22',
    views: '8.7K',
    publishedAt: '2025-01-18'
  },
  {
    id: '_sBXTskL0gA',
    title: 'Why Digital Nomads Choose Chiang Mai?',
    description: 'Exploring what makes Chiang Mai, Thailand one of the top destinations for digital nomads worldwide.',
    thumbnail: 'https://img.youtube.com/vi/_sBXTskL0gA/hqdefault.jpg',
    duration: '16:33',
    views: '15.9K',
    publishedAt: '2025-01-15'
  }
]

// Get latest YouTube video
const latestVideo = youtubeVideos[0]

// Extract unique categories for filtering
const categories = [...new Set(records.filter((record: any) => record.sf4ad525dd && record.sb685ab800?.label).map((record: any) => record.sb685ab800.label))].sort()

// Get actual count of active companies
const activeCompaniesCount = records.filter((record: any) => record.sf4ad525dd).length

// Hardcoded Monthly Supporters list
const monthlySupporters = [
  'DataBench',
  'Max Browser',
  'DataBench (Max Browser)', // in case it's stored with the full name
  'Max',
  'NomadTax Bulgaria Ltd.',
  'Colive Fukuoka',
  // Add more supporter company names here as needed
]

// Hardcoded Featured Partners list (companies advertising in next edition)
const featuredPartners = [
  'Colive Fukuoka',
  'Falmouth University',
  'InterNations',
  'NomadTax Bulgaria Ltd.',
  'Max Browser'
]

// Helper function to check if a record is a supporter
const isSupporter = (record: any) => {
  return record.supporter ||
         record.monthly_supporter ||
         record.is_supporter ||
         record.supporter_status === 'Monthly Supporter' ||
         record.status === 'Monthly Supporter' ||
         monthlySupporters.includes(record.title)
}



const seo: SEOProps = {
  title: 'The Nomad Directory - The Living Database of the Nomad Economy',
  description:
    'The definitive intelligence hub tracking trends, opportunities, and innovations in the digital nomad ecosystem. Discover emerging tools and services while contributing to nomad economy intelligence.',
  image: 'https://nomad-magazine.com/images/Nomad-directory.webp',
  keywords: 'nomad directory, digital nomad economy, nomad business intelligence, remote work trends, nomad startup database, digital nomad market data, location independent business',
  ogType: 'website',
  ldJSON: {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'The Nomad Directory',
    description: 'The ultimate directory of tools, services, communities, and resources for digital nomads worldwide.',
    url: `${Astro.site}nomad_directory`,
    publisher: {
      '@type': 'Organization',
      name: 'Nomad Magazine',
      logo: {
        '@type': 'ImageObject',
        url: `${Astro.site}logo.svg`,
      },
    },
    about: {
      '@type': 'Thing',
      name: 'Digital Nomad Resources',
      description: 'Comprehensive directory of services and tools for digital nomads'
    }
  },
}
---

<Layout seo={seo}>
  <div class="bg-hoverw text-white">
        <!-- Hero Section -->
    <section class="pt-16 pb-8">
      <div class="container mx-auto px-4 text-center">
                <h1 class="mx-auto max-w-4xl text-4xl leading-tight font-bold md:text-6xl mb-4">
          The <span class="text-yellow-400">Nomad Directory</span>
        </h1>
        <h2 class="mx-auto max-w-4xl text-2xl leading-tight font-bold md:text-4xl mb-2">
          The Living Database of the Nomad Economy
        </h2>
        <p class="mx-auto max-w-3xl text-lg text-gray-400 mb-6 italic">
          Because Google Doesn't Get Our Lifestyle
        </p>
        
        <p class="mx-auto max-w-3xl text-base text-gray-300 md:text-lg mb-8">
          Discover emerging tools and services while contributing to the definitive intelligence hub tracking trends, opportunities, and innovations in the digital nomad ecosystem.
        </p>
        
                <div class="flex justify-center mb-8">
          <a
            target="_blank"
            href="https://form.smartsuite.com/s4tmc086/8sFlvrVlDC?redirect=https%3A//nomad-magazine.com/nomad-directory-boost-options"
            class="inline-flex items-center justify-center gap-2 bg-black hover:bg-gray-900 border-2 border-yellow-400 px-8 py-3 rounded-lg text-yellow-400 font-bold text-lg transition-all duration-200"
          >
            <MaterialSymbolsElectricBolt width="20" height="20" />
            Join the Database
          </a>
        </div>

            <!-- Search and Filter Section -->
        <div class="max-w-5xl mx-auto mb-8">
          <!-- Main Search and Filter Row -->
          <div class="flex flex-col lg:flex-row gap-4 items-center justify-center mb-6">
            <!-- Search Bar -->
            <div class="w-full max-w-lg">
              <div class="relative">
                <input
                  type="text"
                  id="search-input"
                  placeholder="Search platforms, services, tools..."
                  class="w-full px-4 py-3 pl-12 bg-white/10 border border-white/20 rounded-xl text-white placeholder-gray-400 focus:outline-none focus:border-yellow-400 focus:bg-white/15 transition-all duration-200"
                />
                <svg class="absolute left-4 top-1/2 transform -translate-y-1/2 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                </svg>
              </div>
            </div>
            
            <!-- Category Dropdown -->
            <div class="relative w-full max-w-xs">
              <select id="category-select" class="appearance-none w-full bg-white/10 border border-white/20 rounded-xl px-4 py-3 pr-10 text-white focus:outline-none focus:border-yellow-400 focus:bg-white/15 transition-all duration-200 cursor-pointer">
                <option value="all" class="bg-gray-800 text-white">All Categories</option>
                {categories.map((category) => (
                  <option value={category as string} class="bg-gray-800 text-white">{category}</option>
                ))}
              </select>
              <svg class="absolute right-3 top-1/2 transform -translate-y-1/2 w-5 h-5 text-gray-400 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </div>
            
            <!-- Clear Filters Button -->
            <button id="clear-filters" class="px-6 py-3 bg-white/10 hover:bg-white/20 border border-white/20 rounded-xl text-gray-300 hover:text-white transition-all duration-200 whitespace-nowrap hidden">
              Clear All
            </button>
          </div>
          
          <!-- Active Filters Display -->
          <div id="active-filters" class="flex flex-wrap justify-center gap-2 mb-4 hidden">
            <span class="text-sm text-gray-400">Active filters:</span>
          </div>
          
          <!-- Social Share Section -->
          <div class="flex justify-center items-center gap-4 mt-4 pt-4 border-t border-white/10">
            <span class="text-sm text-gray-400">Share this directory:</span>
            <div class="flex gap-2">
              <button onclick="shareOnTwitter()" class="p-2 bg-white/10 hover:bg-blue-400/20 rounded-lg transition-all duration-200 group">
                <svg class="w-4 h-4 text-gray-400 group-hover:text-blue-400" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>
                </svg>
              </button>
              <button onclick="shareOnLinkedIn()" class="p-2 bg-white/10 hover:bg-blue-600/20 rounded-lg transition-all duration-200 group">
                <svg class="w-4 h-4 text-gray-400 group-hover:text-blue-600" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                </svg>
              </button>
              <button id="instagram-share-btn" class="p-2 bg-white/10 hover:bg-pink-500/20 rounded-lg transition-all duration-200 group">
                <svg class="w-4 h-4 text-gray-400 group-hover:text-pink-500" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                </svg>
          </button>
              <button onclick="copyDirectoryUrl(this)" class="p-2 bg-white/10 hover:bg-green-500/20 rounded-lg transition-all duration-200 group">
                <svg class="w-4 h-4 text-gray-400 group-hover:text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                </svg>
              </button>
            </div>
          </div>
        </div>
    </div>
    </section>

    <!-- Company Stats -->
    <section class="py-12 bg-gray-900/50">
      <div class="container mx-auto px-4">
        <div class="max-w-md mx-auto text-center">
          <div class="bg-white/5 backdrop-blur-sm border border-white/10 rounded-xl p-8">
            <div class="text-4xl font-bold text-yellow-400 mb-3">{activeCompaniesCount}</div>
            <div class="text-gray-300 text-lg">Companies</div>
          </div>
        </div>
      </div>
    </section>

    <!-- Main Content with Sidebar -->
    <section class="pt-4 pb-16">
      <div class="container mx-auto px-4">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
          <!-- Main Content -->
          <div class="lg:col-span-2">
            <div id="directory-container" class="space-y-6">
      {
        records
          .filter((i: any) => i.sf4ad525dd)
          .sort((a: any, b: any) => {
            const aSupporter = isSupporter(a)
            const bSupporter = isSupporter(b)

            // Supporters go first
            if (aSupporter && !bSupporter) return -1
            if (!aSupporter && bSupporter) return 1

            // Keep original order for others
            return 0
          })
                  .map((record: any, index: number) => {
                    // Use same link resolution logic as NomadDirectoryCard
                    const link = record.link || record.sb788c266b?.[0]
                    
                    return (
                      <div class="directory-item bg-white/5 backdrop-blur-sm border border-white/10 rounded-2xl p-8 hover:bg-white/10 transition-all duration-300 group cursor-pointer relative" data-category={record.sb685ab800?.label || 'uncategorized'} onclick={link ? `window.open('${link}', '_blank')` : undefined}>
                        <div class="flex flex-col md:flex-row items-start gap-6">
                          <!-- Logo/Image -->
                          <div class="flex-shrink-0">
                            <div class={`w-32 h-32 rounded-xl flex items-center justify-center p-1 ${
                              ['Fresh Global', 'Falmouth University', 'SUMA', 'Scaglia y Asociados', 'goldenweeks'].includes(record.title) ? 'bg-gray-800' : 'bg-white'
                            }`}>
                              {record.image && record.image !== '/logo.svg' ? (
                                <img 
                                  src={record.image} 
                                  alt={record.title || 'Company'} 
                                  class="w-full h-full rounded-lg object-contain"
                                />
                              ) : (
                                <span class={`font-bold text-3xl ${
                                  ['Fresh Global', 'Falmouth University', 'SUMA', 'Scaglia y Asociados', 'goldenweeks'].includes(record.title) ? 'text-white' : 'text-black'
                                }`}>
                                  {(record.title || 'C').charAt(0).toUpperCase()}
                                </span>
                              )}
                            </div>
                          </div>
                          
                          <!-- Content -->
                          <div class="flex-1 min-w-0">
                            <div class="flex flex-col md:flex-row md:items-start md:justify-between mb-4">
                              <div class="mb-4 md:mb-0">
                                <div class="flex items-center gap-3 mb-2 flex-wrap">
                                  <h3 class="text-2xl font-bold text-white group-hover:text-yellow-400 transition-colors">
                                    {record.title || 'Company Name'}
                                  </h3>
                                  {/* Monthly Supporter Badge */}
                                  {(record.supporter || record.monthly_supporter || record.is_supporter || record.supporter_status === 'Monthly Supporter' || record.status === 'Monthly Supporter' || monthlySupporters.includes(record.title)) && (
                                    <a 
                                      href="/support-the-magazine" 
                                      class="inline-flex items-center gap-1 bg-gradient-to-r from-red-600 to-red-700 text-white px-3 py-1 rounded-full text-xs font-bold hover:from-red-700 hover:to-red-800 transition-all duration-200 shadow-lg"
                                      title="Monthly Supporter"
                                    >
                                      <svg width="12" height="12" fill="currentColor" viewBox="0 0 24 24">
                                        <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                                      </svg>
                                      Supporter
                                    </a>
                                  )}
                                  {/* Featured Partner Badge */}
                                  {featuredPartners.includes(record.title) && (
                                    <span 
                                      class="inline-flex items-center gap-1 bg-gradient-to-r from-purple-600 to-blue-600 text-white px-3 py-1 rounded-full text-xs font-bold shadow-lg"
                                      title="Featured Partner"
                                    >
                                      <svg width="12" height="12" fill="currentColor" viewBox="0 0 24 24">
                                        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                                      </svg>
                                      Featured Partner
                                    </span>
                                  )}
                                </div>
                                <p class="text-gray-300 text-base leading-relaxed line-clamp-3 max-w-2xl">
                                  {record.scea90e502 || 'Description not available'}
                                </p>

                                <!-- Special Offer -->
                                {record.s5576966ee && (
                                  <div class="mt-3 p-3 bg-yellow-400/10 border-l-4 border-yellow-400 rounded-r-lg">
                                    <div class="flex items-start gap-2">
                                      <span class="text-yellow-400 font-bold text-xs uppercase tracking-wide">Special Offer:</span>
                                    </div>
                                    <p class="text-gray-200 text-sm mt-1 whitespace-pre-line">
                                      {record.s5576966ee}
                                    </p>
                                  </div>
                                )}
                              </div>

                              <!-- Category Badge and Number -->
                              <div class="flex items-center gap-4">
                                {record.sb685ab800?.label && (
                                  <button 
                                    class="category-filter-btn bg-yellow-400/20 text-yellow-400 px-3 py-1 rounded-full text-sm font-medium border border-yellow-400/30 hover:bg-yellow-400/30 transition-colors cursor-pointer z-10 relative"
                                    data-category={record.sb685ab800.label}
                                  >
                                    {record.sb685ab800.label}
                                  </button>
                                )}
                                <span class="text-gray-500 text-sm font-mono">
                                  #{String(index + 1).padStart(3, '0')}
                                </span>
                              </div>
                            </div>
                            
                            <!-- Actions -->
                            <div class="flex items-center">
                              {link && (
                                <a 
                                  href={link} 
                                  target="_blank" 
                                  rel="noopener noreferrer"
                                  class="text-blue-300 hover:text-blue-200 underline transition-colors"
                                >
                                  Learn more &rarr;
                                </a>
                              )}
                            </div>
                          </div>
                        </div>
                      </div>
                    )
                  })
              }
            </div>
            
            <!-- Empty State -->
            <div id="empty-state" class="text-center py-20 hidden">
              <div class="max-w-md mx-auto">
                <div class="w-20 h-20 bg-white/10 rounded-full flex items-center justify-center mx-auto mb-6">
                  <MaterialSymbolsElectricBolt width="32" height="32" class="text-gray-400" />
                </div>
                <h3 class="text-2xl font-bold text-white mb-4">No projects found</h3>
                <p class="text-gray-400 text-lg">Try adjusting your search terms or filters, or check back later for new listings.</p>
              </div>
            </div>
          </div>

          <!-- Sidebar -->
          <div class="lg:col-span-1">
            <div class="sticky top-8 space-y-3">
              <!-- Boost Your Listing CTA -->
              <div class="bg-gradient-to-r from-yellow-400/20 to-yellow-600/20 border border-yellow-400/30 rounded-xl p-4">
                <h3 class="text-base font-bold text-white mb-2 flex items-center gap-1">
                  <MaterialSymbolsElectricBolt width="16" height="16" class="text-yellow-400" />
                  Already Listed?
                </h3>
                <p class="text-gray-300 text-sm mb-3 leading-relaxed">
                  Boost your visibility and reach more nomads with our upgrade options.
                </p>
                <a 
                  href="/nomad-directory-boost-options"
                  class="inline-flex items-center gap-1 bg-yellow-400 hover:bg-yellow-300 text-black px-3 py-2 rounded-lg text-sm font-bold transition-all duration-200 w-full justify-center"
                >
                  <MaterialSymbolsElectricBolt width="14" height="14" />
                  Boost Your Listing
                </a>
              </div>

              <!-- Next Print Announcement -->
              <div class="bg-white/5 backdrop-blur-sm border border-white/10 rounded-xl p-4">
                <h3 class="text-base font-bold text-white mb-2">
                  📖 Your Brand in the Next Print Edition
                </h3>
                <p class="text-gray-300 text-sm mb-3 leading-relaxed">
                  Magazine sponsorships allow deeper, more meaningful brand integration than digital ads, which are often fleeting and commoditized. Print offers narrative and emotional depth; digital extends reach. We see them as complementary rather than competing channels.
                </p>
                <a 
                  href="/brand-placement-next-edition-847291"
                  class="inline-flex items-center gap-1 bg-white/10 hover:bg-white/20 border border-white/20 text-white px-3 py-2 rounded-lg text-sm font-bold transition-all duration-200 w-full justify-center"
                >
                  Learn More
                </a>
              </div>
              
              <!-- Latest YouTube Episode -->
              <div class="bg-white/5 backdrop-blur-sm border border-white/10 rounded-xl p-3">
                <h3 class="text-base font-bold text-white mb-2 flex items-center gap-1">
                  <svg class="w-4 h-4 text-red-500" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                  </svg>
                  Latest Episode
                </h3>
                
                <div class="group relative overflow-hidden rounded-lg cursor-pointer mb-2">
                  <div class="relative aspect-[2/1]">
                    <img
                      src={latestVideo.thumbnail}
                      alt={latestVideo.title}
                      class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                      loading="lazy"
                    />
                    <div class="absolute inset-0 bg-black/40 group-hover:bg-black/20 transition-colors"></div>
                    <div class="absolute bottom-1 right-1 bg-black/80 px-1 py-0.5 rounded text-xs text-white">
                      {latestVideo.duration}
                    </div>
                    <div class="absolute inset-0 flex items-center justify-center">
                      <div class="bg-red-600 rounded-full p-1 group-hover:bg-red-700 group-hover:scale-110 transition-all">
                        <svg class="w-2.5 h-2.5 text-white" fill="currentColor" viewBox="0 0 24 24">
                          <path d="M8 5v14l11-7z"/>
                        </svg>
                      </div>
                    </div>
                  </div>
                  <a href={`https://www.youtube.com/watch?v=${latestVideo.id}`} target="_blank" class="absolute inset-0"></a>
                </div>
                
                <h4 class="font-medium text-white text-sm mb-1 line-clamp-2 leading-tight">
