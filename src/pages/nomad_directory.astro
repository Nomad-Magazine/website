<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @keyframes slideIn {
    from {
      transform: translateX(400px);
      opacity: 0;
    }
    to {
      transform: translateX(0);
      opacity: 1;
    }
  }

  @keyframes slideOut {
    from {
      transform: translateX(0);
      opacity: 1;
    }
    to {
      transform: translateX(400px);
      opacity: 0;
    }
  }
</style>

<script>
  // Search and Filter functionality
  const directoryItems = document.querySelectorAll('.directory-item')
  const emptyState = document.getElementById('empty-state')
  const searchInput = document.getElementById('search-input') as HTMLInputElement
  const categorySelect = document.getElementById('category-select') as HTMLSelectElement | null
  const clearFiltersBtn = document.getElementById('clear-filters')
  const activeFiltersDiv = document.getElementById('active-filters')
  const instagramBtn = document.getElementById('instagram-share-btn')
  
  let currentCategory = 'all'
  let currentSearch = ''

  function updateEmptyState() {
    const visibleItems = Array.from(directoryItems).filter(item => {
      const htmlItem = item as HTMLElement
      return htmlItem.style.display !== 'none'
    })
    
    if (emptyState) {
      emptyState.style.display = visibleItems.length === 0 ? 'block' : 'none'
    }
  }

  function updateActiveFilters() {
    if (!activeFiltersDiv || !clearFiltersBtn) return
    
    const hasActiveFilters = currentSearch !== '' || currentCategory !== 'all'
    
    if (hasActiveFilters) {
      activeFiltersDiv.classList.remove('hidden')
      clearFiltersBtn.classList.remove('hidden')
      
      // Clear previous filter tags
      const existingTags = activeFiltersDiv.querySelectorAll('.filter-tag')
      existingTags.forEach(tag => tag.remove())
      
      // Add search filter tag
      if (currentSearch !== '') {
        const searchTag = document.createElement('span')
        searchTag.className = 'filter-tag bg-yellow-400/20 text-yellow-400 px-3 py-1 rounded-full text-sm flex items-center gap-2'
        searchTag.innerHTML = `Search: "${currentSearch}" <button class="hover:text-yellow-200" onclick="clearSearch()">×</button>`
        activeFiltersDiv.appendChild(searchTag)
      }
      
      // Add category filter tag
      if (currentCategory !== 'all') {
        const categoryTag = document.createElement('span')
        categoryTag.className = 'filter-tag bg-blue-400/20 text-blue-400 px-3 py-1 rounded-full text-sm flex items-center gap-2'
        categoryTag.innerHTML = `Category: ${currentCategory} <button class="hover:text-blue-200" onclick="clearCategory()">×</button>`
        activeFiltersDiv.appendChild(categoryTag)
      }
        } else {
      activeFiltersDiv.classList.add('hidden')
      clearFiltersBtn.classList.add('hidden')
    }
        }

  function applyFilters() {
      directoryItems.forEach((item) => {
      const htmlItem = item as HTMLElement
        const itemCategory = item.getAttribute('data-category')
      
      // Get text content for search
      const titleElement = htmlItem.querySelector('h3')
      const descriptionElement = htmlItem.querySelector('p')
      const categoryElement = htmlItem.querySelector('.bg-yellow-400\\/20')
      
      const title = titleElement?.textContent?.toLowerCase() || ''
      const description = descriptionElement?.textContent?.toLowerCase() || ''
      const category = categoryElement?.textContent?.toLowerCase() || ''
      
      const searchText = `${title} ${description} ${category}`.toLowerCase()
      
      // Check category filter
      const categoryMatch = currentCategory === 'all' || itemCategory === currentCategory
      
      // Check search filter
      const searchMatch = currentSearch === '' || searchText.includes(currentSearch.toLowerCase())
      
      // Show/hide item based on both filters
      if (categoryMatch && searchMatch) {
          htmlItem.style.display = 'block'
        } else {
          htmlItem.style.display = 'none'
        }
      })
      
    updateActiveFilters()
      updateEmptyState()
  }

  // Search functionality
  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      currentSearch = (e.target as HTMLInputElement).value
      applyFilters()
    })
  }

  // Category dropdown functionality
  if (categorySelect) {
    categorySelect.addEventListener('change', (e) => {
      currentCategory = (e.target as HTMLSelectElement).value
      applyFilters()
    })
  }


  // Clear filters functionality
  if (clearFiltersBtn) {
    clearFiltersBtn.addEventListener('click', () => {
      currentSearch = ''
      currentCategory = 'all'
      
      if (searchInput) searchInput.value = ''
      if (categorySelect) categorySelect.value = 'all'
      
      applyFilters()
    })
  }

  // Instagram share functionality
  if (instagramBtn) {
    instagramBtn.addEventListener('click', () => {
      const text = `🌍 The Nomad Directory\nBecause Google Doesn't Get Our Lifestyle\n\n✨ The best new tools, services, and companies for digital nomads to help you discover what's new in the nomad ecosystem.\n\n🔗 nomad-magazine.com/nomad_directory\n\n#DigitalNomad #RemoteWork #NomadLife #NomadDirectory #LocationIndependent #TravelAndWork`
      
      // Try to use the modern clipboard API
      if (navigator.clipboard && window.isSecureContext) {
        navigator.clipboard.writeText(text).then(() => {
          // Show a better notification
          showNotification('📋 Caption copied! Open Instagram and paste it into your story or post.', 'success')
        }).catch((err) => {
          console.error('Failed to copy: ', err)
          showManualCopyPrompt(text)
        })
      } else {
        showManualCopyPrompt(text)
      }
    })
  }

  function showManualCopyPrompt(text: string) {
    const userConfirmed = window.prompt('Clipboard access is unavailable.\nCopy the text below to share on Instagram:', text)
    if (userConfirmed !== null) {
      showNotification('📋 Text ready! Copy it from the prompt and share on Instagram.', 'success')
    } else {
      showNotification('❌ Unable to copy automatically. Please copy the caption manually.', 'error')
    }
  }

  function showNotification(message: string, type: 'success' | 'error') {
    const notification = document.createElement('div')
    notification.textContent = message
    notification.style.cssText = `
      position: fixed;
      top: 20px;
      right: 20px;
      background: ${type === 'success' ? '#10b981' : '#ef4444'};
      color: white;
      padding: 16px 24px;
      border-radius: 12px;
      box-shadow: 0 4px 6px rgba(0,0,0,0.1);
      z-index: 9999;
      font-size: 14px;
      font-weight: 500;
      max-width: 400px;
      animation: slideIn 0.3s ease-out;
    `
    document.body.appendChild(notification)
    
    setTimeout(() => {
      notification.style.animation = 'slideOut 0.3s ease-out'
      setTimeout(() => {
        document.body.removeChild(notification)
      }, 300)
    }, 4000)
  }

  // Global functions for filter tag close buttons
  declare global {
    interface Window {
      clearSearch: () => void;
      clearCategory: () => void;
      shareOnTwitter: () => void;
      shareOnLinkedIn: () => void;
      copyDirectoryUrl: (button?: HTMLElement | null) => void;
    }
  }

  window.clearSearch = function() {
    currentSearch = ''
    if (searchInput) searchInput.value = ''
    applyFilters()
  }

  window.clearCategory = function() {
    currentCategory = 'all'
    if (categorySelect) categorySelect.value = 'all'
    applyFilters()
  }

  // Category filter button functionality
  const categoryFilterBtns = document.querySelectorAll('.category-filter-btn')
  categoryFilterBtns.forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation()
      e.preventDefault()
      const category = btn.getAttribute('data-category')
      if (categorySelect && category) {
        currentCategory = category
        categorySelect.value = category
        applyFilters()
        window.scrollTo({ top: 0, behavior: 'smooth' })
      }
    })
  })

  // Social sharing functions
  window.shareOnTwitter = function() {
    const url = 'https://nomad-magazine.com/nomad_directory'
    const text = "The Nomad Directory - Because Google Doesn't Get Our Lifestyle 🌍\n\nThe best new tools, services, and companies for digital nomads to help you discover what's new in the nomad ecosystem."
    const twitterUrl = `https://twitter.com/intent/tweet?text=${encodeURIComponent(text)}&url=${encodeURIComponent(url)}&via=NomadMagazine`
    window.open(twitterUrl, '_blank', 'width=550,height=420')
  }

  window.shareOnLinkedIn = function() {
    const url = 'https://nomad-magazine.com/nomad_directory'
    const linkedInUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`
    window.open(linkedInUrl, '_blank', 'width=550,height=550')
  }

  window.copyDirectoryUrl = function(button?: HTMLElement | null) {
    const url = 'https://nomad-magazine.com/nomad_directory'
    
    if (navigator.clipboard && window.isSecureContext) {
      navigator.clipboard.writeText(url).then(() => {
        showNotification('🔗 Link copied to clipboard!', 'success')
        // Also show visual feedback on button
        const originalContent = button?.innerHTML
        if (button) {
          button.innerHTML = '<svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>'
          setTimeout(() => {
            if (originalContent) button.innerHTML = originalContent
          }, 2000)
        }
      }).catch(() => {
        showManualCopyPrompt(url)
      })
    } else {
      showManualCopyPrompt(url)
    }
  }
  
  // Initial empty state check
  updateEmptyState()
</script>
