---
export const prerender = true;

import Layout, { type SEOProps } from '~/layouts/Layout.astro'
import MaterialSymbolsCheck from '~icons/material-symbols/check'
import MaterialSymbolsArrowOutward from '~icons/material-symbols/arrow-outward'

const seo: SEOProps = {
  title: 'Boost Your Listing - Nomad Directory Upgrades',
  description: 'Upgrade your Nomad Directory listing to reach our engaged community of digital nomads across multiple channels.',
  image: `${Astro.site}images/edition-003-cover_holded_front_face.webp`,
  keywords: 'nomad directory upgrade, digital nomad listing boost, nomad marketing',
  ogType: 'website',
}
---

<Layout seo={seo}>
  <!-- Upgrade Transition -->
  <div class="bg-hoverw text-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <h1 class="text-5xl font-bold text-white mb-6 leading-tight md:text-6xl lg:text-7xl">
          Boost Your <span class="text-yellow-400">Visibility</span>
        </h1>
        <p class="text-xl text-gray-300 max-w-3xl mx-auto mb-8">
          Reach our engaged community of digital nomads across multiple channels and grow your business with targeted exposure.
        </p>
      </div>
    </div>
  </div>

  <!-- Push Up Listing -->
  <div class="bg-gray-900 py-8 border-b border-gray-800">
    <div class="mx-auto max-w-4xl px-6">
      <div class="bg-gray-800/50 rounded-lg p-6 border border-gray-700/50">
        <div class="flex items-center justify-between gap-6 flex-wrap">
          <div class="flex-1 min-w-[250px]">
            <h3 class="text-lg font-semibold text-gray-200 mb-2">Push Up Your Listing</h3>
            <p class="text-sm text-gray-400">Republish your listing to appear as new again on top of the directory</p>
          </div>
          <div class="flex items-center gap-4">
            <div class="text-right">
              <div class="text-2xl font-bold text-gray-200">€10</div>
              <div class="text-xs text-gray-500">one-time</div>
            </div>
            <a
              href="https://pay.nomad-magazine.com/b/00w9AT9Up1bd0G219v8bS0B"
              target="_blank"
              class="inline-block bg-gray-700 text-gray-200 px-5 py-2.5 rounded-lg text-sm font-medium hover:bg-gray-600 transition-colors whitespace-nowrap"
            >
              Push Up
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Need More? -->
  <section class="py-20 bg-gray-950">
    <div class="mx-auto max-w-6xl px-6">
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-bold mb-8 text-white">Want to go further together?</h2>
        <p class="text-2xl text-gray-300">
          We have some amazing extra options if you'd like more visibility and support
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-8 mb-12">
        <!-- Support the Magazine -->
        <div class="bg-gradient-to-br from-yellow-500/20 to-orange-500/20 rounded-2xl p-8 border border-yellow-500/30 text-center h-full flex flex-col">
          <div class="text-4xl mb-4">🤝</div>
          <h3 class="text-2xl font-bold mb-4 text-white">Support the Magazine</h3>
          <div class="text-4xl font-bold text-yellow-400 mb-6">€10<span class="text-sm text-gray-300">/month</span></div>
          <p class="text-gray-300 mb-8">
            Get your listing featured on top of the directory page
          </p>
          
          <div class="space-y-3 mb-8 text-left flex-grow">
            <div class="flex items-center">
              <MaterialSymbolsCheck class="mr-3 h-5 w-5 flex-shrink-0 text-yellow-400" />
              <span class="text-gray-300">♥ Supporter badge on listing</span>
            </div>
            <div class="flex items-center">
              <MaterialSymbolsCheck class="mr-3 h-5 w-5 flex-shrink-0 text-yellow-400" />
              <span class="text-gray-300">Listing on top of the page</span>
            </div>
            <div class="flex items-center">
              <MaterialSymbolsCheck class="mr-3 h-5 w-5 flex-shrink-0 text-yellow-400" />
              <span class="text-gray-300">Listing on a Home page</span>
            </div>
            <div class="flex items-center">
              <MaterialSymbolsCheck class="mr-3 h-5 w-5 flex-shrink-0 text-yellow-400" />
              <span class="text-gray-300">Support indie media</span>
            </div>
            <div class="flex items-center">
              <MaterialSymbolsCheck class="mr-3 h-5 w-5 flex-shrink-0 text-yellow-400" />
              <span class="text-gray-300">Good karma ✨</span>
            </div>
          </div>
          
          <a
            href="https://pay.nomad-magazine.com/b/fZubJ17Mh7zBbkG9G18bS0c"
            target="_blank"
            class="w-full inline-block bg-yellow-500 text-black px-6 py-3 rounded-lg font-bold hover:bg-yellow-400 transition-all hover:scale-105 mt-auto"
          >
            Become Supporter
          </a>
        </div>

        <!-- Print + Digital -->
        <div class="bg-gradient-to-br from-indigo-500/20 to-purple-500/20 rounded-2xl p-8 border border-indigo-500/30 text-center relative h-full flex flex-col">
          <div class="absolute -top-3 -right-3 bg-yellow-400 text-black px-3 py-1 rounded-full text-sm font-bold">
            BEST VALUE
          </div>
          <div class="text-4xl mb-4">📰</div>
          <h3 class="text-2xl font-bold mb-4 text-white">Digital + Print</h3>
          <div class="text-4xl font-bold text-indigo-400 mb-6">€350+</div>
          <p class="text-gray-300 mb-8">
            Full digital package plus brand placement in our next magazine edition
          </p>
          
          <div class="space-y-3 mb-8 text-left flex-grow">
            <div class="flex items-center">
              <MaterialSymbolsCheck class="mr-3 h-5 w-5 flex-shrink-0 text-indigo-400" />
              <span class="text-gray-300">Brand placement in next magazine edition (print + digital)</span>
            </div>
            <div class="flex items-center">
              <MaterialSymbolsCheck class="mr-3 h-5 w-5 flex-shrink-0 text-indigo-400" />
              <span class="text-gray-300">Reach thousands of nomads globally</span>
            </div>
            <div class="flex items-center">
              <MaterialSymbolsCheck class="mr-3 h-5 w-5 flex-shrink-0 text-indigo-400" />
              <span class="text-gray-300">Print + digital distribution</span>
            </div>
          </div>
          
          <a
            href="/brand-placement-next-edition-847291"
            class="w-full inline-block bg-indigo-500 text-white px-6 py-3 rounded-lg font-bold hover:bg-indigo-400 transition-all hover:scale-105 mt-auto"
          >
            Get Digital + Print
          </a>
        </div>
      </div>

      <!-- Physical Places -->
      <div class="bg-gradient-to-br from-orange-500/20 to-red-500/20 rounded-2xl p-8 border border-orange-500/30 text-center">
        <div class="text-5xl mb-6">🏢</div>
        <h3 class="text-3xl font-bold mb-4 text-white">Physical Places</h3>
        <p class="text-xl text-gray-300 mb-8">
          Order magazines for your Airbnb, coliving, coworking, hostel etc. and we'll make sure to support you back in return! 🏠
        </p>
        <a
          href="/coworking-coliving-shipments"
          class="inline-flex items-center gap-2 bg-orange-500 text-white px-8 py-4 rounded-xl font-bold text-lg hover:bg-orange-400 transition-all"
        >
          Order Magazines
          <MaterialSymbolsArrowOutward class="h-5 w-5" />
        </a>
      </div>

      <!-- Trust Builder -->
      <div class="mt-16 text-center">
        <p class="text-gray-300 max-w-2xl mx-auto">
          While our community is growing, it's highly engaged and consists of quality digital nomads, remote workers, and location-independent entrepreneurs actively looking for tools and services.
        </p>
      </div>
    </div>
  </section>

  <!-- Back to Directory -->
  <div class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <div class="bg-gray-50 rounded-lg p-8 max-w-2xl mx-auto">
          <h3 class="text-2xl font-bold text-gray-900 mb-4">Questions about upgrades?</h3>
          <p class="text-gray-600 mb-6">Contact us and we'll help you choose the best option for your needs.</p>
          <a 
            href="mailto:lera@nomadgossip.com" 
            class="inline-flex items-center gap-2 bg-gray-200 hover:bg-gray-300 text-gray-900 font-bold px-6 py-3 rounded transition-colors duration-200"
          >
            Contact Us
            <MaterialSymbolsArrowOutward width="18" height="18" />
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout> 