  ldJSON: {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: 'Chapter 2: A Brief History of Digital Nomadism',
    description: 'Explore the complete history of digital nomadism from pre-internet pioneers to the pandemic revolution and the institutionalization of remote work.',
    url: `${Astro.site}digital-nomad-wiki/chapter-2/`,
    isPartOf: {
