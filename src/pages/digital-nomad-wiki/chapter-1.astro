    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: 'Chapter 1: What Is the Digital Nomad Lifestyle?',
    description: 'Learn what the digital nomad lifestyle really means — from economic autonomy and temporal flexibility to global citizenship and who it is for.',
    url: `${Astro.site}digital-nomad-wiki/chapter-1/`,
