const seo: SEOProps = {
  title: 'Edition 002 - Nomad Magazine | Digital Nomad Communities & Japan',
  description:
    'Edition 002 — digital nomad communities and Japan. Download the free PDF or read in the Zinio app.',
  image: `${Astro.site}images/edition-002-cover-background-purple.webp`,
      keywords: 'nomad magazine edition 002, digital nomad communities, japan nomad, nomad magazine, remote work magazine',
  ogType: 'website',
  ldJSON: {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: 'Nomad Magazine Edition 002',
    description: 'Edition 002 — free PDF and Zinio; digital nomad communities and Japan',
    url: `${Astro.site}editions/second-edition/`,
    image: `${Astro.site}images/edition-002-cover-background-purple.webp`,
    sku: 'NGM-002',
    brand: {
      '@type': 'Brand',
      name: 'Nomad Magazine',
    },
    offers: [
      {
        '@type': 'Offer',
        name: 'Edition 002 (Free PDF)',
        price: '0',
        priceCurrency: 'EUR',
        availability: 'https://schema.org/InStock',
        url: `${Astro.site}second-edition-giveaway/`,
        seller: {
          '@type': 'Organization',
          name: 'Nomad Magazine',
        },
      },
    ],
  },
}
---

<Layout seo={seo}>
  <EditionHero
    editionNumber="Edition 002"
    title="Your guide into digital nomad communities in 110-page masterpiece."
    subtitle="Download the full PDF free, or read in the Zinio app (mobile & web)."
    coverImage="/images/edition-002-cover-background-purple.webp"
    coverImageAlt="Nomad Magazine Edition 002 cover"
    freePdfUrl="/second-edition-giveaway/"
  />

  <section class="bg-linear-to-r from-purple-600 to-indigo-600 py-8" id="zinio-reading" aria-label="Read on Zinio">
    <div class="container mx-auto px-4">
      <div class="text-center text-white">
        <h3 class="mb-3 text-2xl font-bold md:text-3xl">📱 Read on ZINIO</h3>
        <p class="mb-6 text-lg opacity-90">Nomad Magazine in the Zinio app — web, iPhone, and Android</p>
        <div class="flex flex-wrap justify-center gap-4">
          <a
            href="https://www.zinio.com/publications/nomad-magazine/45331/issues/708503"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Read Nomad Magazine on ZINIO Web Reader"
            class="inline-flex items-center gap-2 rounded-lg bg-white px-6 py-3 font-semibold text-purple-600 transition hover:bg-gray-100"
          >
            🌐 Web Reader
          </a>
          <a
            href="https://apps.apple.com/us/app/zinio-magazine-newsstand/id364297166"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Download ZINIO app on iOS App Store"
            class="inline-flex items-center gap-2 rounded-lg bg-white px-6 py-3 font-semibold text-purple-600 transition hover:bg-gray-100"
          >
            🍎 iOS App
          </a>
          <a
            href="https://play.google.com/store/apps/details?id=com.zinio.mobile.android.reader&pli=1"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Download ZINIO app on Google Play Store"
            class="inline-flex items-center gap-2 rounded-lg bg-white px-6 py-3 font-semibold text-purple-600 transition hover:bg-gray-100"
          >
            🤖 Android App
          </a>
        </div>
      </div>
    </div>
  </section>

  <EditionStats
    stats={[
      { value: '110', label: 'Pages' },
      { value: '7', label: 'Communities Featured' },
      { value: '1', label: 'Country Deep Dive' },
    ]}
  />

  <Sponsors {sponsors} title="Edition 002 Sponsored By" />

  <EditionWelcome
    heading="Welcome to Edition 002, dear reader."
    bodyHtml={`<p><strong>We turned nomad life into a 110-page masterpiece.</strong></p><p><strong>In focus: Nomad Communities and Japan as a new destination.</strong></p><p>This edition of <strong>NGM</strong> takes you deeper into the heart of the digital nomad lifestyle, with a special focus on <em>the communities that shape it</em> and getting to know the digital nomad scene of <em>Japan</em>.</p><p>What's inside this community-focused issue:</p><ul role="list" class="list-disc pl-6"><li><strong>When Nomads Flock Together</strong> - The vibrant Nomad Cruise culture and values</li><li><strong>Eastern Promises</strong> - Japan as a unique, peaceful, and cultural haven for nomads</li><li><strong>The Truth Behind Japan's Digital Nomad Visa</strong> - Real insights from a local lawyer</li><li><strong>Friendships That Last a Lifetime</strong> - Deep connections through shared nomadic experiences</li><li><strong>Japanese Wisdom on Nomadic Life</strong> - Zen, wabi-sabi, and mindful living lessons</li><li><strong>Digital Nomad Family Chronicles</strong> - Combining parenthood with nomadism</li><li><strong>Growing Muscles, Sharing Knowledge</strong> - Madeira's thriving nomad scene</li><li><strong>Digital Nomad Events 2025</strong> - Your calendar for networking and growth</li><li><strong>Top 6 Accommodation Platforms</strong> - Best booking sites for nomads</li></ul><p>Plus insights on crypto, coworking spaces, and portable work gear!</p>`}
  />

  <section class="my-12 px-4 sm:px-8" aria-label="Edition Two preview">
    <div class="mx-auto max-w-4xl">
      <ProductCarousel {slides} firstSlideMaxWidth={false} />
    </div>
  </section>

  <WhatsComingCarousel
    heading="Article Previews"
    subtitle="Explore the community-focused stories and Japan insights from our second issue — from Nomad Cruise culture to digital nomad families and crypto wisdom."
    slides={articleSlides}
  />

  <AuthorsGrid {authors} />
  <MagazinePreview
    titleClass="mt-4"
    sectionClass="bg-gray-50"
    title="Previous Editions"
    subTitle="Magazine Preview"
    subTitleClass="font-justme text-black! text-2xl! font-medium!"
  />
  <Testimonials sectionClass="bg-hoverw [&_h2]:text-white" />
  <FAQ items={editionTwoFreePdfFaq} />
  <FAQContact />
</Layout>

<style>
@keyframes glow {
  0% { box-shadow: 0 0 0 0 #fde047; }
  50% { box-shadow: 0 0 16px 4px #fde047; }
  100% { box-shadow: 0 0 0 0 #fde047; }
}
.glow-animate {
  animation: glow 1.5s infinite;
}
</style>
