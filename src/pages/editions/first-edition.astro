const seo: SEOProps = {
  title: 'Edition 001 - Nomad Magazine | Digital Nomad Stories',
  description:
    'The first Edition of Nomad Magazine — 100 pages of unique content and the Yellow Pages directory. Download the full PDF free.',
  image: '/images/edition-001-cover.webp',
      keywords: 'nomad magazine edition 001, digital nomad magazine, nomad magazine, nomad stories, remote work magazine',
  ogType: 'website',
  ldJSON: {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: 'Nomad Magazine Edition 001',
    description: 'The first Edition of Nomad Magazine — free PDF download',
    url: `${Astro.site}editions/first-edition/`,
    image: '/images/edition-001-cover.webp',
    sku: 'NGM-001',
    brand: {
      '@type': 'Brand',
      name: 'Nomad Magazine',
    },
    offers: [
      {
        '@type': 'Offer',
        name: 'Edition 001 (Free PDF)',
        price: '0',
        priceCurrency: 'EUR',
        availability: 'https://schema.org/InStock',
        url: `${Astro.site}first-edition-giveaway/`,
        seller: {
          '@type': 'Organization',
          name: 'Nomad Magazine',
        },
      },
    ],
  },
}
---

<Layout seo={seo}>
  <EditionHero
    editionNumber="Edition 001"
    title="The first Edition of Nomad Magazine. 100 pages of unique content."
    subtitle="Download the full PDF free — one email unlocks your copy."
    coverImage="/images/edition-001-cover.webp"
    coverImageAlt="Nomad Magazine Edition 001 cover"
    freePdfUrl="/first-edition-giveaway/"
  />

  <EditionStats
    stats={[
      { value: '100', label: 'Pages' },
      { value: '1', label: 'Yellow Pages Directory' },
      { value: '1000+', label: 'Readers Worldwide' },
    ]}
  />

  <Sponsors {sponsors} title="Edition 001 Sponsored By" />

  <EditionWelcome
    heading="Welcome to Edition 001, dear reader."
    bodyHtml={`<p>Welcome to the first edition of Nomad Magazine. Inside, you'll discover the real stories behind nomadic life—from commitment issues and cultural dating guides to responsible travel and the future of AI in business.</p><p>What's inside this pioneering issue:</p><ul role="list" class="list-disc pl-6"><li><strong>The Real Reason Behind Commitment Issues</strong> - Exploring the "perfection-paradox" among nomads</li><li><strong>From the Rat Race to Freedom</strong> - Tarek's journey to meaningful nomadic impact</li><li><strong>Cultural Dating Guide</strong> - What NOT to do on first dates across 5 countries</li><li><strong>4 Inconvenient Truths About Nomad Insurance</strong> - Essential coverage insights</li><li><strong>Best Digital Nomad Retreats</strong> - Curated experiences that blend work and purpose</li><li><strong>Business and AI Innovation</strong> - How technology transforms nomad entrepreneurship</li><li><strong>Yellow Pages: Digital Nomad Directory</strong> - Your essential resource guide</li></ul><p><a href="/free-article-what-not-to-do-on-first-date/" class="font-medium underline">Download free sample article</a></p>`}
  />

  <section class="my-12 px-4 sm:px-8" aria-label="Edition One preview">
    <div class="mx-auto max-w-3xl">
      <ProductCarousel slides={slides} firstSlideMaxWidth={true} />
    </div>
  </section>

  <WhatsComingCarousel
    heading="Article Previews"
    subtitle="Discover the groundbreaking stories and insights from our inaugural issue — exploring commitment, freedom, culture, and the future of nomadic life."
    slides={articleSlides}
  />

  <AuthorsGrid {authors} />
  <MagazinePreview
    titleClass="mt-4"
    sectionClass="bg-gray-50"
    title="Previous Editions"
    subTitle="Magazine Preview"
    subTitleClass="font-justme text-black! text-2xl! font-medium!"
  />
  <FAQ items={editionOneFreePdfFaq} />
  <FAQContact />
  <Testimonials sectionClass="bg-hoverw [&_h2]:text-white" />
</Layout>

<style>
@keyframes glow {
  0% { box-shadow: 0 0 0 0 #fde047; }
  50% { box-shadow: 0 0 16px 4px #fde047; }
  100% { box-shadow: 0 0 0 0 #fde047; }
}
.glow-animate {
  animation: glow 1.5s infinite;
}
</style>
