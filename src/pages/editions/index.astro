---
export const prerender = true

import EditionsHero from '~/components/EditionsHero.astro'
import MagazineIssues from '~/components/MagazineIssues.astro'
import Layout, { type SEOProps } from '~/layouts/Layout.astro'
import MagazinePreview from '~/components/MagazinePreview.astro'

const seo: SEOProps = {
  title: 'Nomad Magazine Editions - Digital Nomad Publications',
  description:
    'Explore all editions of Nomad Magazine. Discover inspiring stories, tips, and insights from digital nomads around the world. Available in print and digital formats.',
  image: `${Astro.site}images/edition-003-cover_holded_front_face.webp`,
  keywords: 'nomad magazine editions, digital nomad publications, nomad magazine, nomad stories, remote work magazine',
  ogType: 'website',
  ldJSON: {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Nomad Magazine Editions',
    description: 'All editions of Nomad Magazine',
    url: `${Astro.site}editions/`,
    publisher: {
      '@type': 'Organization',
      name: 'Nomad Magazine',
      logo: {
        '@type': 'ImageObject',
        url: `${Astro.site}logo.svg`,
      },
    },
  },
}
---

<Layout seo={seo}>
  <main class="bg-hoverw text-white">
    <EditionsHero />
    
    <!-- Editions Overview -->
    <section class="bg-gradient-to-br from-yellow-50 to-orange-50 border-t-4 border-b-4 border-yellow-400 py-12 md:py-16 shadow-lg">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
            <!-- Left side - Images -->
            <div class="flex justify-center md:justify-start">
              <div class="relative">
                <div class="flex gap-3 items-end">
                  <img 
                    src="/images/first-edition-cover-hd.webp" 
                    alt="Edition 1" 
                    class="w-28 sm:w-32 rounded-lg shadow-2xl transform hover:scale-105 transition-transform border-2 border-white"
                  />
                  <img 
                    src="/images/edition-002-cover.webp" 
                    alt="Edition 2" 
                    class="w-28 sm:w-32 rounded-lg shadow-2xl transform hover:scale-105 transition-transform border-2 border-white"
                  />
                  <img 
                    src="/images/third-edition-cover-hd.webp" 
                    alt="Edition 3" 
                    class="w-28 sm:w-32 rounded-lg shadow-2xl transform hover:scale-105 transition-transform border-2 border-white"
                  />
                </div>
              </div>
            </div>
            
            <!-- Right side - Content -->
            <div class="text-center md:text-left">
              <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-900 mb-4 leading-tight">
                Nomad Magazine Editions
              </h2>
              <p class="text-lg text-gray-700 mb-6 leading-relaxed">
                Explore our collection of thoughtfully crafted magazines featuring stories, insights, and practical advice from digital nomads around the world.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>
    
    <MagazineIssues />
    <MagazinePreview />
  </main>
</Layout>
