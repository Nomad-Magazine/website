          <a href="https://play.google.com/store/apps/details?id=com.zinio.mobile.android.reader&pli=1" target="_blank" rel="noopener noreferrer" aria-label="Download ZINIO app on Google Play Store" class="inline-flex items-center gap-2 rounded-lg bg-white px-6 py-3 font-semibold text-purple-600 transition hover:bg-gray-100">
            🤖 Android App
          </a>
        </div>
      </div>
    </div>
  </section>
  <EditionStats
    stats={[
      { value: '112', label: 'Pages of Expert Content' },
      { value: '17', label: 'Industry Leaders Featured' },
      { value: 'Free', label: 'PDF + Zinio' },
    ]}
  />

