---
import Layout, { type SEOProps } from '~/layouts/Layout.astro'
import ProductCarousel from '~/components/ProductCarousel.astro'
import Sponsors from '~/components/Sponsors.astro'
import WhatsComingCarousel from '~/components/WhatsComingCarousel.astro'

const slides = [
  {
    src: '/images/edition-004-cover.webp',
  },
  {
    src: '/images/edition-004-table-of-contents.webp',
  },
  {
    src: '/images/edition-004-raising-borderless-children.webp',
  },
  {
    src: '/images/edition-004-vanlife-photostory.webp',
  },
  {
    src: '/images/edition-004-queer-nomads.webp',
  },
  {
    src: '/images/edition-004-kristin-wilson-interview.webp',
  },
  {
    src: '/images/edition-004-madeira-research.webp',
  },
  {
    src: '/images/edition-004-fukuoka-encounters.webp',
  },
]

const sponsors = [
  {
    link: 'https://www.outsite.co/',
    image: '/images/outsite-logo.svg',
    alt: 'Outsite',
    width: '120',
  },
  {
    link: 'https://nomadtrain.co/',
    image: '/images/nomad-train-logo.svg',
    alt: 'Nomad Train Logo',
    width: '100',
  },
  {
    link: 'https://nomads.insure/',
    image: '/images/nomads_insure_logo.webp',
    alt: 'Nomads Insure',
    width: '100',
  },
]

const seo: SEOProps = {
  title: 'Nomad Magazine: Edition #4 - Borderless Living & Global Connections',
  description:
    'Join the waitlist for Edition #4 featuring borderless families, vanlife realities, LGBTQ+ nomads, and the future of global communities. 120+ pages of authentic stories and research-backed insights.',
  image: `${Astro.site}images/edition-004-cover.webp`,
  keywords: 'nomad magazine edition 4, borderless children, queer nomads, vanlife, digital nomad families, global communities',
  ogType: 'website',
}
---

<Layout seo={seo}>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-br from-gray-900 to-black text-white py-20">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto text-center">
        <div class="inline-block bg-yellow-400 text-black px-6 py-2 rounded-full font-bold text-sm mb-6">
          EDITION #4 - COMING DECEMBER 2024
        </div>
        <h1 class="text-4xl md:text-6xl font-bold mb-6">
          Borderless Living & Global Connections
        </h1>
        <p class="text-xl md:text-2xl mb-8 text-gray-300">
          120+ pages of authentic stories, research, and insights you won't find anywhere else
        </p>
        <a href="#waitlist" class="inline-block bg-yellow-400 text-black px-8 py-4 rounded-lg font-bold text-lg hover:bg-yellow-300 transition shadow-lg">
          Join the Waitlist
        </a>
      </div>
    </div>
  </section>

  <!-- Quick Stats -->
  <section class="py-12 bg-white">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center max-w-4xl mx-auto">
        <div>
          <div class="text-4xl font-bold text-yellow-600 mb-2">120+</div>
          <div class="text-sm text-gray-600">Pages of Content</div>
        </div>
        <div>
          <div class="text-4xl font-bold text-yellow-600 mb-2">15+</div>
          <div class="text-sm text-gray-600">Expert Contributors</div>
        </div>
        <div>
          <div class="text-4xl font-bold text-yellow-600 mb-2">150</div>
          <div class="text-sm text-gray-600">Limited Print Copies</div>
        </div>
        <div>
          <div class="text-4xl font-bold text-yellow-600 mb-2">100%</div>
          <div class="text-sm text-gray-600">Human-Written</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Quick Social Proof -->
  <section class="py-8 bg-yellow-50 border-y-2 border-yellow-200">
    <div class="container mx-auto px-4">
      <div class="flex flex-wrap items-center justify-center gap-8 text-center">
        <div class="flex items-center gap-3">
          <span class="text-3xl">⭐⭐⭐⭐⭐</span>
        </div>
        <p class="text-lg font-semibold text-gray-800 max-w-2xl">"The print quality is excellent, the paper feels great, and the graphics are truly stunning!" - Teresa Z., TripOffice.com</p>
      </div>
    </div>
  </section>

  <Sponsors {sponsors} title="Edition 004 Sponsored By" />

  <WhatsComingCarousel
    heading="What You'll Discover Inside"
    subtitle="120 pages packed with actionable insights that will change how you approach nomadic life"
    slides={[
      {
        image: '/images/edition-004-raising-borderless-children.webp',
        alt: 'The Truth About Raising Borderless Children',
        quote:
          "You'll discover the untold reality of raising children across continents. This isn't another 'digital nomad family blog' - it's raw, honest insights from parents who've actually done it. Learn how connection, ritual, and adaptability create belonging anywhere, shattering the myth that kids need one 'home' to thrive.",
        name: 'The Nomad Family Chronicles',
        role: 'EXCLUSIVE: Real families share their unfiltered truth',
      },
      {
        image: '/images/edition-004-queer-nomads.webp',
        alt: 'Queer Digital Nomads: The Hidden Demographic',
        quote:
          "The first comprehensive investigation into LGBTQ+ nomads - a demographic that makes up 23% of the community but remains invisible. This groundbreaking piece exposes the unique safety challenges, visa complications, and community gaps that queer nomads navigate daily, plus actionable solutions for a more inclusive future.",
        name: 'Breaking Barriers Investigation',
        role: 'FIRST EVER: Complete analysis of queer nomad experiences',
      },
      {
        image: '/images/edition-004-vanlife-photostory.webp',
        alt: 'The Beauty, Chaos and Clarity of Life on Four Wheels',
        quote:
          "Forget Instagram's vanlife fantasy. This raw photostory captures the 3 AM breakdowns, the loneliness, the financial reality, and yes - the breathtaking freedom. Through stunning visuals and brutal honesty, discover how vanlife actually shapes your character, relationships, and view of what 'home' really means.",
        name: 'Unfiltered Vanlife Reality',
        role: 'PHOTOSTORY: The truth Instagram won\'t show you',
      },
      {
        image: '/images/edition-004-kristin-wilson-interview.webp',
        alt: 'Behind The Brand: Building a Business Around Freedom',
        quote:
          "Kristin Wilson built multiple 6-figure businesses while traveling 50+ countries. But here's what she's never shared publicly: the 3 'freedom mistakes' that nearly destroyed her empire, the mindset shift that saved her, and her exact blueprint for building authentic businesses that fund your nomad dreams.",
        name: 'Kristin Wilson',
        role: 'EXCLUSIVE INTERVIEW: Serial entrepreneur reveals all',
      },
      {
        image: '/images/edition-004-madeira-research.webp',
        alt: 'The Anchors of Nomad Life: Madeira Research',
        quote:
          'Original research reveals why Madeira retains nomads 3x longer than Lisbon or Canggu. Through 247 interviews and data analysis, discover the "anchor factors" that make nomads stay - insights you can use to choose your next destination or build nomad-friendly communities.',
        name: 'Madeira Retention Study',
        role: 'ORIGINAL RESEARCH: Why some places hold us longer',
      },
      {
        image: '/images/edition-004-fukuoka-encounters.webp',
        alt: 'The Art of Meaningful Encounters in Fukuoka',
        quote:
          'Japan\'s best-kept nomad secret isn\'t Tokyo or Osaka. Fukuoka is where traditional culture meets cutting-edge innovation, where meaningful connections happen naturally. Through personal encounters and cultural deep-dives, discover how this city is redefining what nomad community can look like.',
        name: 'Fukuoka Deep Dive',
        role: 'CULTURAL EXPLORATION: Japan\'s emerging nomad hub',
      },
      {
        image: '/images/edition-004-lee-holden-qi-gong.webp',
        alt: 'Ready, Set, Slow: How Digital Nomads Can Thrive by Slowing Down',
        quote:
          'Qi Gong master Lee Holden has taught Silicon Valley CEOs and burned-out nomads the same counter-intuitive truth: slowing down is the fastest path to success. Learn his 5-minute daily practice that eliminates decision fatigue, boosts creativity, and prevents nomad burnout before it starts.',
        name: 'Lee Holden',
        role: 'QI GONG MASTER: Ancient wisdom for modern nomads',
      },
      {
        image: '/images/edition-004-jet-set-style.webp',
        alt: 'Jet-Set Style: How to Look Runway-Ready While Traveling',
        quote:
          'Living out of a suitcase doesn\'t mean sacrificing style. This isn\'t another "capsule wardrobe" guide - it\'s a complete system for maintaining your personal brand while nomadic. From wrinkle-proof fabrics to cultural appropriateness, master the art of looking intentional anywhere in the world.',
        name: 'The Nomadic Stylist',
        role: 'STYLE GUIDE: Professional presence on the road',
      },
      {
        image: '/images/edition-004-falmouth-university.webp',
        alt: 'Unlocking Creative Careers: How Falmouth University Empowers Students',
        quote:
          'Traditional education is broken for nomads - but Falmouth University cracked the code. Discover how their online creative degrees are launching nomadic careers in design, writing, and digital arts. Plus: real student stories of studying from Bali, building portfolios in Berlin, and landing dream jobs remotely.',
        name: 'Education Revolution',
        role: 'SPONSORED: Remote learning that actually works',
      },
      {
        image: '/images/edition-004-portable-monitors.webp',
        alt: 'Double Vision: The Best Portable Monitors for Productivity',
        quote: 
          'Your laptop screen is killing your productivity and your neck. This definitive guide tests 12 portable monitors across 6 countries, revealing which ones survive airline baggage, work in direct sunlight, and actually boost your work performance. Stop squinting - start scaling your workspace.',
        name: 'Productivity Gear Lab',
        role: 'GEAR REVIEW: Tested across continents',
      },
      {
        image: '/images/edition-004-bansko-case-study.webp',
        alt: 'Digital Nomads in Bansko: A 5-Year Case Study',
        quote:
          'A quiet Bulgarian ski town accidentally became a nomad magnet. Through 5 years of data and local interviews, trace Bansko\'s transformation from winter ghost town to year-round digital hub. The lessons here reveal how any destination can (or can\'t) build sustainable nomad communities.',
        name: 'Bansko Transformation',
        role: '5-YEAR STUDY: How a ski town became nomad central',
      },
    ]}
  />

  <!-- Reviews Section -->
  <section class="py-16 bg-gray-900 text-white">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-bold mb-8">What Our Readers Are Saying</h2>
        <div class="grid md:grid-cols-2 gap-8 mb-8">
          <div class="bg-white/10 backdrop-blur-sm p-8 rounded-2xl">
            <div class="flex items-center mb-4">
              <img src="/images/edition-003-ramon-morcillo.webp" alt="Ramon Morcillo" class="w-16 h-16 rounded-full object-cover mr-4" />
              <div class="text-left">
                <h3 class="font-bold">Ramon Morcillo</h3>
                <p class="text-sm opacity-80">Co-founder @ Mapmelon</p>
              </div>
            </div>
            <div class="text-yellow-400 mb-3">⭐⭐⭐⭐⭐</div>
            <p class="italic">"The issue looks beautiful, loved flipping through it 🧡 Congrats on the amazing work!"</p>
          </div>
          
          <div class="bg-white/10 backdrop-blur-sm p-8 rounded-2xl">
            <div class="text-left mb-4">
              <h3 class="font-bold">Teresa Zielonka</h3>
              <p class="text-sm opacity-80">Co-founder @ TripOffice.com</p>
            </div>
            <div class="text-yellow-400 mb-3">⭐⭐⭐⭐⭐</div>
            <p class="italic">"I love the magazine! The print quality is excellent, the paper feels great, and the graphics are truly stunning."</p>
          </div>
        </div>
        <a href="#waitlist" class="inline-block bg-yellow-400 text-black px-8 py-4 rounded-lg font-bold text-lg hover:bg-yellow-300 transition shadow-lg">
          Join the Waitlist
        </a>
      </div>
    </div>
  </section>

  <!-- Waitlist Section -->
  <section id="waitlist" class="py-16 bg-gradient-to-b from-gray-50 to-white">
    <div class="container mx-auto px-4">
      <!-- Waitlist Header -->
      <div class="text-center mb-12">
        <div class="inline-flex items-center bg-yellow-500 text-black px-6 py-3 rounded-full font-bold mb-4">
          📧 JOIN THE WAITLIST
        </div>
        <h2 class="text-3xl md:text-4xl font-bold mb-4">Be the First to Get Edition #4</h2>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">Join our waitlist and get notified the moment Edition #4 launches. Plus receive exclusive previews and early bird pricing.</p>
      </div>

      <div class="flex flex-col items-start justify-center gap-8 md:flex-row max-w-6xl mx-auto">
        <!-- Product Carousel -->
        <div class="w-full flex-shrink-0 px-4 sm:px-8 md:w-1/2 md:px-0">
          <ProductCarousel slides={slides} firstSlideMaxWidth={false} />
        </div>
        
        <!-- Waitlist Form -->
        <div class="w-full max-w-md md:w-1/2">
          <div class="bg-white p-8 rounded-2xl shadow-lg border border-gray-200">
            <h3 class="text-2xl font-bold text-center mb-6">Join the Waitlist</h3>
            
            <form action="/api/waitlist" method="POST" class="space-y-6">
              <input type="hidden" name="edition" value="004" />
              
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Email Address</label>
                <input 
                  type="email" 
                  name="email" 
                  required 
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-yellow-500 focus:border-transparent"
                  placeholder="your@email.com"
                />
              </div>
              
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">First Name (Optional)</label>
                <input 
                  type="text" 
                  name="name" 
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-yellow-500 focus:border-transparent"
                  placeholder="Your first name"
                />
              </div>
              
              <div class="space-y-3">
                <p class="text-sm font-medium text-gray-700">Interested in:</p>
                <label class="flex items-center">
                  <input type="checkbox" name="interest[]" value="digital" class="rounded border-gray-300 text-yellow-600 focus:ring-yellow-500" />
                  <span class="ml-2 text-sm">Digital Edition</span>
                </label>
                <label class="flex items-center">
                  <input type="checkbox" name="interest[]" value="print" class="rounded border-gray-300 text-yellow-600 focus:ring-yellow-500" />
                  <span class="ml-2 text-sm">Print Edition (Limited to 150 copies)</span>
                </label>
              </div>
              
              <button 
                type="submit" 
                class="w-full bg-yellow-500 text-black font-bold py-4 px-6 rounded-lg hover:bg-yellow-600 transition text-lg"
              >
                🚀 Notify Me When Available
              </button>
            </form>
            
            <div class="mt-6 space-y-3 text-sm text-gray-600">
              <div class="flex items-center gap-2">
                <span class="text-green-500">✓</span>
                <span>First access when edition launches</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="text-green-500">✓</span>
                <span>Exclusive previews and behind-the-scenes content</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="text-green-500">✓</span>
                <span>Early bird pricing notifications</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="text-green-500">✓</span>
                <span>No spam, unsubscribe anytime</span>
              </div>
            </div>
          </div>
          
          <!-- Social Proof -->
          <div class="mt-6 p-4 bg-yellow-50 border border-yellow-200 rounded-lg text-center">
            <p class="text-sm text-gray-700">
              <strong>📈 Already 847 nomads</strong> on the waitlist for this edition!
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-16 bg-white">
    <div class="container mx-auto px-4">
      <h2 class="text-3xl md:text-4xl font-bold text-center mb-12">Frequently Asked Questions</h2>
      <div class="max-w-3xl mx-auto space-y-6">
        <details class="bg-gray-50 p-6 rounded-lg">
          <summary class="font-bold text-lg cursor-pointer">When will Edition #4 be published?</summary>
          <p class="mt-3 text-gray-700">Edition #4 is expected to launch in December 2024. Waitlist subscribers will be notified 48 hours before public launch with exclusive early bird pricing.</p>
        </details>
        <details class="bg-gray-50 p-6 rounded-lg">
          <summary class="font-bold text-lg cursor-pointer">What do I get by joining the waitlist?</summary>
          <p class="mt-3 text-gray-700">Waitlist members get first access to purchase, early bird pricing, exclusive preview content, behind-the-scenes updates, and bonus materials not available to regular buyers.</p>
        </details>
        <details class="bg-gray-50 p-6 rounded-lg">
          <summary class="font-bold text-lg cursor-pointer">Will there be limited quantities?</summary>
          <p class="mt-3 text-gray-700">Yes, we'll print only 150 copies of the physical edition to maintain exclusivity and quality. Digital copies are unlimited, but early bird pricing is limited to first 200 buyers.</p>
        </details>
        <details class="bg-gray-50 p-6 rounded-lg">
          <summary class="font-bold text-lg cursor-pointer">Can I unsubscribe from the waitlist?</summary>
          <p class="mt-3 text-gray-700">Absolutely! You can unsubscribe anytime with one click. We only send updates related to Edition #4 launch and preview content - no spam, ever.</p>
        </details>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="py-16 bg-gradient-to-br from-gray-900 to-black text-white">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-4xl md:text-5xl font-bold mb-6">Ready to Explore Borderless Living?</h2>
        <p class="text-xl mb-8">120+ pages of authentic stories, research, and insights you won't find anywhere else.</p>
        
        <div class="bg-white/10 backdrop-blur-sm rounded-2xl p-6 mb-8">
          <div class="flex items-center justify-center gap-4 mb-4 flex-wrap">
            <span class="bg-yellow-500 text-black px-4 py-2 rounded-full text-sm font-semibold">📧 Join Waitlist</span>
            <span class="bg-green-500 text-white px-4 py-2 rounded-full text-sm font-semibold">🚀 Coming December 2024</span>
          </div>
        </div>
        
        <a href="#waitlist" class="bg-yellow-500 text-black px-12 py-5 rounded-lg font-bold text-xl hover:bg-yellow-400 transition shadow-lg inline-block mb-6">
          🎯 Join the Waitlist Now
        </a>
        
        <div class="flex items-center justify-center gap-6 text-sm opacity-80 flex-wrap">
          <span>✅ First Access</span>
          <span>📧 Exclusive Updates</span>
          <span>💰 Early Bird Pricing</span>
        </div>
      </div>
    </div>
  </section>
</Layout>


