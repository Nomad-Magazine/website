    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .cover-image:hover {
    transform: scale(1.05);
    box-shadow: 0 25px 80px rgba(0, 0, 0, 0.6),
                0 0 60px rgba(78, 205, 196, 0.5);
  }

  @keyframes fadeInScale {
    from {
      opacity: 0;
      transform: scale(0.9);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  .hero-text {
    text-align: center;
    margin-bottom: 2rem;
    padding-top: 2rem;
  }

  .hero-text h1 {
    font-size: clamp(3rem, 8vw, 6rem);
    font-weight: 900;
    letter-spacing: -0.02em;
    margin: 0;
    background: linear-gradient(135deg, #ffffff 0%, #cccccc 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-text h2 {
    font-size: clamp(2rem, 5vw, 4rem);
    font-weight: 300;
    letter-spacing: 0.05em;
    margin: 1rem 0;
    color: #888;
  }

  .subtitle {
    text-align: center;
    margin-bottom: 4rem;
  }

  .subtitle p {
    font-size: clamp(1.2rem, 2.5vw, 2rem);
    font-weight: 500;
    margin: 0.5rem 0;
    color: #ddd;
  }

  .subtitle .pages {
    font-size: clamp(1rem, 2vw, 1.5rem);
    color: #999;
    font-weight: 300;
  }

  .partners-section {
    max-width: 1400px;
    margin: 0 auto 6rem auto;
    padding: 4rem 2rem;
    background: white;
    border-radius: 16px;
  }

  .partners-heading {
    text-align: center;
    font-size: clamp(1.2rem, 2.5vw, 1.8rem);
    font-weight: 400;
    color: #333;
    margin-bottom: 3rem;
    line-height: 1.4;
  }

  .partners-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.5rem 2rem;
    align-items: center;
    justify-items: center;
  }

  .partner-logo {
    width: 100%;
    max-width: 200px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    transition: transform 0.3s ease;
  }

  .partner-logo:hover {
    transform: scale(1.05);
  }

  .partner-logo img {
    width: 100%;
    height: auto;
    max-height: 70px;
    object-fit: contain;
  }

  /* Optimize individual logo sizes for visual balance */
  .logo-palermo img {
    max-height: 110px;
  }

  .logo-falmouth img {
    max-height: 65px;
  }

  .logo-nomads-insure img {
    max-height: 75px;
  }

  .logo-nomad-fest img {
    max-height: 80px;
  }

  .logo-nomadtax img {
    max-height: 55px;
  }

  .logo-ciao img {
    max-height: 60px;
  }

  .logo-nomad-train img {
    max-height: 70px;
  }

  .logo-roamless img {
    max-height: 65px;
  }

  .logo-max img {
    max-height: 95px;
  }

  .logo-swaphouse img {
    max-height: 75px;
    filter: grayscale(100%);
