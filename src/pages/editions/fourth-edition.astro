<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    const form = document.getElementById('newsletter-form')
    if (!form) return

    form.addEventListener('submit', async function (e) {
      e.preventDefault()

      const submitButton = form.querySelector('.newsletter-button')
      if (!submitButton) return

      const turnstileWidget = form.querySelector('.cf-turnstile')
      const turnstileResponse = window.turnstile?.getResponse(turnstileWidget);
      
      if (!turnstileResponse) {
        alert('Please complete the captcha verification.')
        return
      }

      submitButton.disabled = true
      const originalText = submitButton.textContent
      submitButton.textContent = 'Submitting...'

      const formData = new FormData(form)
      formData.append('cf-turnstile-response', turnstileResponse)

      try {
        const response = await fetch('/api/bento-event', {
          method: 'POST',
          body: formData,
        })

        const data = await response.json()

        if (response.ok && data.success) {
          alert("Successfully subscribed! We'll keep you updated on new editions and exclusive content.")
          form.reset()
          if (window.turnstile) {
            window.turnstile.reset(turnstileWidget)
          }
          submitButton.disabled = false
          submitButton.textContent = originalText || 'Subscribe'
        } else {
          alert(data.error || 'Failed to subscribe. Please try again.')
          submitButton.disabled = false
          submitButton.textContent = originalText || 'Subscribe'
        }
      } catch (error) {
        alert('An error occurred. Please try again.')
        submitButton.disabled = false
        submitButton.textContent = originalText || 'Subscribe'
      }
    })
  })
</script>


<script is:inline>
(function () {
  const track = document.getElementById('palermo-carousel-track');
  const idxEl = document.getElementById('palermo-slide-idx');
  const totalEl = document.getElementById('palermo-slide-total');
  const total = track ? track.children.length : 0;
  let current = 0;
  let timer;

  if (totalEl) totalEl.textContent = String(total);

  function go(idx) {
    current = (idx + total) % total;
    track.style.transform = `translateX(-${current * 100}%)`;
    if (idxEl) idxEl.textContent = String(current + 1);
  }

  function startAuto() {
    timer = setInterval(() => go(current + 1), 4000);
  }

  function stopAuto() {
    clearInterval(timer);
  }

  if (track && total > 1) {
    document.getElementById('palermo-prev')?.addEventListener('click', () => { stopAuto(); go(current - 1); startAuto(); });
    document.getElementById('palermo-next')?.addEventListener('click', () => { stopAuto(); go(current + 1); startAuto(); });

    let startX = 0;
    track.addEventListener('touchstart', (e) => { startX = e.touches[0].clientX; stopAuto(); }, { passive: true });
    track.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 40) go(dx < 0 ? current + 1 : current - 1);
      startAuto();
    });

    startAuto();
  }
})();
</script>

