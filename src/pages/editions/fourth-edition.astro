    }

    .partner-logo {
      max-width: 150px;
      padding: 0.5rem;
    }

    .partner-logo {
      padding: 1rem;
    }

    .partner-logo img {
      max-height: 55px;
    }

    /* Mobile optimized sizes */
    .logo-palermo img {
      max-height: 85px;
    }

    .logo-falmouth img {
      max-height: 50px;
    }

    .logo-nomads-insure img {
      max-height: 60px;
    }

    .logo-nomad-fest img {
      max-height: 65px;
    }

    .logo-nomadtax img {
      max-height: 45px;
    }

    .logo-ciao img {
      max-height: 50px;
    }

    .logo-max img {
      max-height: 75px;
    }

    .logo-swaphouse img {
      max-height: 60px;
    }

    .logo-better-neighbors img {
      max-height: 95px;
    }

    .logo-coliving-frilingue img {
      max-height: 60px;
    }

    .collage {
      gap: 0.5rem;
      padding: 1rem 1rem 2rem 1rem;
    }

    .word {
      padding: 0.3rem 0.6rem;
    }

    .subscribe-section {
      margin: 2rem auto;
      padding: 1.5rem 1rem;
    }

    .shipment-section {
      margin: 3rem auto 1rem auto;
      padding: 0 1rem;
    }

    .shipment-content {
      padding: 2rem 1.5rem;
    }

    .shipment-icon {
      font-size: 2.5rem;
      margin-bottom: 1rem;
    }
  }
</style>

<script is:inline>
  // Form submission handler for both subscribe forms
  document.addEventListener('DOMContentLoaded', function () {
    const forms = document.querySelectorAll('.subscribe-form')

    forms.forEach((form) => {
      form.addEventListener('submit', async function (e) {
        e.preventDefault()

        const submitButton = form.querySelector('.subscribe-button')
        if (!submitButton) return

        // Get Turnstile token
        const turnstileWidget = form.querySelector('.cf-turnstile')
        const turnstileResponse = window.turnstile?.getResponse(turnstileWidget);
        
        if (!turnstileResponse) {
          alert('Please complete the captcha verification.')
          return
        }

        // Disable submit button
        submitButton.disabled = true
        const originalText = submitButton.textContent
        submitButton.textContent = 'Submitting...'

        const formData = new FormData(form)
        formData.append('cf-turnstile-response', turnstileResponse)

        try {
          const response = await fetch('/api/bento-event', {
            method: 'POST',
            body: formData,
          })

          const data = await response.json()

          if (response.ok && data.success) {
            // Show success message
            alert("Successfully subscribed! We will notify you when Edition 4 is ready.")
            form.reset()
            // Reset Turnstile
            if (window.turnstile) {
              window.turnstile.reset(turnstileWidget)
            }
            submitButton.disabled = false
            submitButton.textContent = originalText || 'Subscribe'
          } else {
            alert(data.error || 'Failed to subscribe. Please try again.')
            submitButton.disabled = false
            submitButton.textContent = originalText || 'Subscribe'
          }
        } catch (error) {
          alert('An error occurred. Please try again.')
          submitButton.disabled = false
          submitButton.textContent = originalText || 'Subscribe'
        }
      })
    })
  })
</script>

<!-- Cloudflare Turnstile Script -->
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
