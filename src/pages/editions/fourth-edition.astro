---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';

const siteUrl = 'https://nomad-magazine.com';
const ogImageUrl = `${siteUrl}/images/nomad_magazine_lifestyle_no_text_landscape_nocut.webp`;
---

<Layout 
  title="Edition Four - Now Available"
  ogImage={ogImageUrl}
  seo={{
    title: "Nomad Magazine Edition Four - Now Available on Zinio",
    description: "The best edition so far! 128 pages of pure high-end content featuring Palermo, Bansko, Fukuoka, and more. Order print edition by Feb 28th and save €5 with code MINUS5.",
    image: ogImageUrl,
    canonical: `${siteUrl}/editions/fourth-edition/`,
    keywords: "nomad magazine, digital nomad, remote work, edition four, palermo, bansko, fukuoka, travel magazine, zinio",
  }}
>
  <div class="coming-soon-container">
    <!-- Cover Image Section -->
    <div class="cover-section">
      <img 
        src="/images/edition-004-cover.webp" 
        alt="Nomad Magazine Edition Four Cover" 
        class="cover-image"
      />
    </div>

    <div class="hero-text">
      <h1>Edition Four</h1>
      <h2>Now Available!</h2>
    </div>
    
    <div class="subtitle">
      <p>The best edition so far!</p>
      <p class="pages">128 pages of pure high-end content</p>
    </div>

    <!-- Print Edition Discount Banner -->
    <section class="print-discount-banner">
      <div class="discount-content">
        <div class="discount-badge">🔥 LIMITED TIME OFFER</div>
        <h3 class="discount-title">Order Print Edition & Save €5</h3>
        <p class="discount-subtitle">Use code <span class="discount-code">MINUS5</span> at checkout</p>
        <p class="discount-deadline">⏰ Offer ends February 28th, 2026</p>
        <a href="https://pay.nomad-magazine.com/b/fZu14nc2x1bdfAWf0l8bS0L" class="discount-button" target="_blank" rel="noopener noreferrer" aria-label="Order print edition with discount (opens in new tab)">
          📚 Order Print Edition Now
        </a>
      </div>
    </section>

    <!-- ZINIO Availability Banner -->
    <section class="zinio-banner">
      <div class="zinio-content">
        <h3 class="zinio-title">📱 Now Available on ZINIO</h3>
        <p class="zinio-subtitle">Read on your favorite device with the best digital magazine experience</p>
        <div class="zinio-buttons">
          <a href="https://www.zinio.com/publications/nomad-magazine/45331" target="_blank" rel="noopener noreferrer" aria-label="Read Nomad Magazine on ZINIO Web Reader (opens in new tab)" class="zinio-button">
            🌐 Web Reader
          </a>
          <a href="https://apps.apple.com/us/app/zinio-magazine-newsstand/id364297166" target="_blank" rel="noopener noreferrer" aria-label="Download ZINIO app on iOS App Store (opens in new tab)" class="zinio-button">
            🍎 iOS App
          </a>
          <a href="https://play.google.com/store/apps/details?id=com.zinio.mobile.android.reader&pli=1" target="_blank" rel="noopener noreferrer" aria-label="Download ZINIO app on Google Play Store (opens in new tab)" class="zinio-button">
            🤖 Android App
          </a>
        </div>
      </div>
    </section>

    <div class="collage">
      <span class="word word-1">Palermo</span>
      <span class="word word-2">Bansko</span>
      <span class="word word-3">Fukuoka</span>
      <span class="word word-4">Madeira Research</span>
      <span class="word word-5">Vanlife Photostory</span>
      <span class="word word-6">Kristin Wilson</span>
      <span class="word word-7">Online Education in creative</span>
      <span class="word word-8">Coworking Contest</span>
      <span class="word word-9">Nomad Directory</span>
      <span class="word word-10">Parenting on the move</span>
      <span class="word word-11">Queer Nomads</span>
      <span class="word word-12">Nomad Fashion</span>
    </div>


    <!-- Partners Section -->
    <div class="partners-section">
      <h2 class="partners-heading">This edition was brought to life with the support of our partners:</h2>
      
      <div class="partners-grid">
        <a href="https://www.comune.palermo.it/" target="_blank" rel="noopener noreferrer" class="partner-logo logo-palermo" aria-label="Visit Città di Palermo website (opens in new tab)">
          <img src="/images/logo-palermo-municipality.webp" alt="Città di Palermo" />
        </a>
        <a href="https://www.falmouth.ac.uk/study/online" target="_blank" rel="noopener noreferrer" class="partner-logo logo-falmouth" aria-label="Visit Falmouth University website (opens in new tab)">
          <img src="/images/logo-Falmouth-University-Black.webp" alt="Falmouth University" />
        </a>
        <a href="https://nomads.insure/" target="_blank" rel="noopener noreferrer" class="partner-logo logo-nomads-insure" aria-label="Visit Nomads Insure website (opens in new tab)">
          <img src="/images/logo-nomads-insure.webp" alt="Nomads Insure" />
        </a>
        <a href="https://nomad-fest.com/" target="_blank" rel="noopener noreferrer" class="partner-logo logo-nomad-fest" aria-label="Visit Nomad Fest website (opens in new tab)">
          <img src="/images/nomad-fest_black.webp" alt="Nomad Fest" />
        </a>
        <a href="https://www.nomadtax.bg/" target="_blank" rel="noopener noreferrer" class="partner-logo logo-nomadtax" aria-label="Visit Nomad Tax Bulgaria website (opens in new tab)">
          <img src="/images/NomadTax.webp" alt="Nomad Tax Bulgaria" />
        </a>
        <a href="https://meetciao.com/" target="_blank" rel="noopener noreferrer" class="partner-logo logo-ciao" aria-label="Visit U Ciao website (opens in new tab)">
          <img src="/images/Ciao-Logo-black.webp" alt="U Ciao" />
        </a>
        <a href="https://nomadtrain.co/" target="_blank" rel="noopener noreferrer" class="partner-logo logo-nomad-train" aria-label="Visit Nomad Train website (opens in new tab)">
          <img src="/images/logo-nomad-train.webp" alt="Nomad Train" />
        </a>
        <a href="https://roamless.com/" target="_blank" rel="noopener noreferrer" class="partner-logo logo-roamless" aria-label="Visit Roamless website (opens in new tab)">
          <img src="/images/logo-roamless_black.webp" alt="Roamless" />
        </a>
        <a href="https://maxbrowser.com.au/" target="_blank" rel="noopener noreferrer" class="partner-logo logo-max" aria-label="Visit Max Browser website (opens in new tab)">
          <img src="/images/logo-Max-Master-Logo-black.webp" alt="Max Browser" />
        </a>
        <a href="https://www.swaphouse.com/" target="_blank" rel="noopener noreferrer" class="partner-logo logo-swaphouse" aria-label="Visit Swaphouse website (opens in new tab)">
          <img src="/images/logo-swaphouse.webp" alt="Swaphouse" />
        </a>
        <a href="https://rentremote.com/" target="_blank" rel="noopener noreferrer" class="partner-logo logo-rent-remote" aria-label="Visit Rent Remote website (opens in new tab)">
          <img src="/images/rent-remote-logo.webp" alt="Rent Remote" />
        </a>
        <a href="https://thebetterneighbors.com/" target="_blank" rel="noopener noreferrer" class="partner-logo logo-better-neighbors" aria-label="Visit The Better Neighbors website (opens in new tab)">
          <img src="/images/Logo_BetterNeighbors.webp" alt="The Better Neighbors" />
        </a>
        <a href="https://coliving.frilingue.ch/" target="_blank" rel="noopener noreferrer" class="partner-logo logo-coliving-frilingue" aria-label="Visit Coliving Frilingue website (opens in new tab)">
          <img src="/images/logo-coliving-frilingue.webp" alt="Coliving Frilingue" />
        </a>
      </div>
    </div>

    <div class="shipment-section">
      <div class="shipment-content">
        <div class="shipment-icon">📦</div>
        <h3>Want print copies in your coworking, coliving, or Airbnb?</h3>
        <p>Join our free waiting list or order guaranteed delivery of 5 copies for your space.</p>
        <a href="/coworking-coliving-shipments/" class="shipment-button">
          📦 Get Magazine Shipments →
        </a>
      </div>
    </div>

    <!-- Newsletter Signup Section -->
    <div class="newsletter-section">
      <div class="newsletter-content">
        <h3 class="newsletter-title">Stay Updated</h3>
        <p class="newsletter-text">Subscribe to get notified about new editions, exclusive content, and nomad lifestyle insights</p>
        <form id="newsletter-form" class="newsletter-form" aria-label="Subscribe to newsletter">
          <input type="hidden" name="event_type" value="subscribe_edition-four-newsletter" />
          <div class="newsletter-input-group">
            <input
              required
              type="email"
              name="email"
              placeholder="Enter your email"
              aria-label="Email address"
              class="newsletter-input"
            />
            <div class="cf-turnstile" data-sitekey="0x4AAAAAACXWfgpGaqB_A50e" data-theme="light"></div>
            <button type="submit" class="newsletter-button">Subscribe</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</Layout>

<style>
  .coming-soon-container {
    padding: 2rem 2rem 4rem 2rem;
    background: linear-gradient(135deg, #1a1a1a 0%, #2d2d2d 100%);
    color: white;
  }

  .cover-section {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 3rem 0 2rem 0;
    animation: fadeInScale 1s ease-out;
  }

  .cover-image {
    max-width: 400px;
    width: 100%;
    height: auto;
    border-radius: 12px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5),
                0 0 40px rgba(78, 205, 196, 0.3);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .cover-image:hover {
    transform: scale(1.05);
    box-shadow: 0 25px 80px rgba(0, 0, 0, 0.6),
                0 0 60px rgba(78, 205, 196, 0.5);
  }

  @keyframes fadeInScale {
    from {
      opacity: 0;
      transform: scale(0.9);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  .hero-text {
    text-align: center;
    margin-bottom: 2rem;
    padding-top: 2rem;
  }

  .hero-text h1 {
    font-size: clamp(3rem, 8vw, 6rem);
    font-weight: 900;
    letter-spacing: -0.02em;
    margin: 0;
    background: linear-gradient(135deg, #ffffff 0%, #cccccc 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-text h2 {
    font-size: clamp(2rem, 5vw, 4rem);
    font-weight: 300;
    letter-spacing: 0.05em;
    margin: 1rem 0;
    color: #888;
  }

  .subtitle {
    text-align: center;
    margin-bottom: 4rem;
  }

  .subtitle p {
    font-size: clamp(1.2rem, 2.5vw, 2rem);
    font-weight: 500;
    margin: 0.5rem 0;
    color: #ddd;
  }

  .subtitle .pages {
    font-size: clamp(1rem, 2vw, 1.5rem);
    color: #999;
    font-weight: 300;
  }

  .print-discount-banner {
    max-width: 1400px;
    margin: 3rem auto;
    padding: 0 2rem;
  }

  .discount-content {
    background: linear-gradient(135deg, #ff6b6b 0%, #ff8c94 100%);
    padding: 3rem 2rem;
    border-radius: 16px;
    text-align: center;
    box-shadow: 0 20px 60px rgba(255, 107, 107, 0.3);
    border: 3px solid rgba(255, 255, 255, 0.2);
  }

  .discount-badge {
    display: inline-block;
    background: rgba(255, 255, 255, 0.95);
    color: #ff6b6b;
    padding: 0.5rem 1.5rem;
    border-radius: 20px;
    font-weight: 800;
    font-size: clamp(0.8rem, 1.5vw, 1rem);
    letter-spacing: 0.05em;
    margin-bottom: 1.5rem;
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.05);
    }
  }

  .discount-title {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 900;
    color: white;
    margin: 0 0 1rem 0;
    line-height: 1.2;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.2);
  }

  .discount-subtitle {
    font-size: clamp(1.2rem, 3vw, 2rem);
    color: white;
    margin: 0 0 0.5rem 0;
    line-height: 1.4;
  }

  .discount-code {
    display: inline-block;
    background: rgba(0, 0, 0, 0.3);
    padding: 0.3rem 1rem;
    border-radius: 8px;
    font-family: monospace;
    font-weight: 800;
    font-size: clamp(1.3rem, 3.2vw, 2.2rem);
    letter-spacing: 0.1em;
    color: #ffe66d;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
  }

  .discount-deadline {
    font-size: clamp(1rem, 2vw, 1.3rem);
    color: rgba(255, 255, 255, 0.95);
    margin: 1rem 0 2rem 0;
    font-weight: 600;
  }

  .discount-button {
    display: inline-block;
    background: white;
    color: #ff6b6b;
    padding: 1.2rem 3rem;
    border-radius: 12px;
    font-weight: 800;
    font-size: clamp(1rem, 2.2vw, 1.4rem);
    text-decoration: none;
    transition: all 0.3s ease;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.2);
  }

  .discount-button:hover {
    background: rgba(255, 255, 255, 0.95);
    transform: translateY(-3px);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.3);
  }

  .partners-section {
    max-width: 1400px;
    margin: 0 auto 6rem auto;
    padding: 4rem 2rem;
    background: white;
    border-radius: 16px;
  }

  .partners-heading {
    text-align: center;
    font-size: clamp(1.2rem, 2.5vw, 1.8rem);
    font-weight: 400;
    color: #333;
    margin-bottom: 3rem;
    line-height: 1.4;
  }

  .partners-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.5rem 2rem;
    align-items: center;
    justify-items: center;
  }

  .partner-logo {
    width: 100%;
    max-width: 200px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    transition: transform 0.3s ease;
  }

  .partner-logo:hover {
    transform: scale(1.05);
  }

  .partner-logo img {
    width: 100%;
    height: auto;
    max-height: 70px;
    object-fit: contain;
  }

  /* Optimize individual logo sizes for visual balance */
  .logo-palermo img {
    max-height: 110px;
  }

  .logo-falmouth img {
    max-height: 65px;
  }

  .logo-nomads-insure img {
    max-height: 75px;
  }

  .logo-nomad-fest img {
    max-height: 80px;
  }

  .logo-nomadtax img {
    max-height: 55px;
  }

  .logo-ciao img {
    max-height: 60px;
  }

  .logo-nomad-train img {
    max-height: 70px;
  }

  .logo-roamless img {
    max-height: 65px;
  }

  .logo-max img {
    max-height: 95px;
  }

  .logo-swaphouse img {
    max-height: 75px;
    filter: grayscale(100%);
  }

  .logo-rent-remote img {
    max-height: 70px;
    filter: brightness(0);
  }

  .logo-better-neighbors img {
    max-height: 120px;
  }

  .logo-coliving-frilingue img {
    max-height: 75px;
  }

  .collage {
    position: relative;
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    padding: 2rem 2rem 4rem 2rem;
  }

  .word {
    font-weight: 700;
    line-height: 1;
    padding: 0.5rem 1rem;
    transition: all 0.3s ease;
    cursor: default;
    white-space: nowrap;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .word:hover {
    transform: scale(1.1);
    filter: brightness(1.2);
  }

  .word-1 {
    font-size: clamp(2rem, 5vw, 4.5rem);
    color: #ff6b6b;
    transform: rotate(-3deg);
  }

  .word-2 {
    font-size: clamp(1.8rem, 4.5vw, 3.8rem);
    color: #4ecdc4;
    transform: rotate(2deg);
  }

  .word-3 {
    font-size: clamp(2.2rem, 5.5vw, 5rem);
    color: #ffe66d;
    transform: rotate(-5deg);
  }

  .word-4 {
    font-size: clamp(1.5rem, 3.5vw, 3rem);
    color: #95e1d3;
    transform: rotate(4deg);
  }

  .word-5 {
    font-size: clamp(1.8rem, 4vw, 3.5rem);
    color: #ff8c94;
    transform: rotate(-2deg);
  }

  .word-6 {
    font-size: clamp(2rem, 4.8vw, 4.2rem);
    color: #a8e6cf;
    transform: rotate(3deg);
  }

  .word-7 {
    font-size: clamp(1.4rem, 3.2vw, 2.8rem);
    color: #ffd3b6;
    transform: rotate(-4deg);
  }

  .word-8 {
    font-size: clamp(1.9rem, 4.3vw, 3.9rem);
    color: #ffaaa5;
    transform: rotate(1deg);
  }

  .word-9 {
    font-size: clamp(2.1rem, 5.2vw, 4.7rem);
    color: #a2d5f2;
    transform: rotate(-3deg);
  }

  .word-10 {
    font-size: clamp(1.6rem, 3.8vw, 3.3rem);
    color: #e0b0ff;
    transform: rotate(5deg);
  }

  .word-11 {
    font-size: clamp(1.9rem, 4.5vw, 4rem);
    color: #d4a5a5;
    transform: rotate(-2deg);
  }

  .word-12 {
    font-size: clamp(2rem, 4.7vw, 4.3rem);
    color: #9fd8df;
    transform: rotate(3deg);
  }

  .word-13 {
    font-size: clamp(2.2rem, 5.3vw, 4.8rem);
    color: #ffccf9;
    transform: rotate(-4deg);
  }

  .zinio-banner {
    max-width: 1400px;
    margin: 4rem auto;
    padding: 0 2rem;
  }

  .zinio-content {
    background: linear-gradient(135deg, #9333ea 0%, #6366f1 100%);
    padding: 3rem 2rem;
    border-radius: 16px;
    text-align: center;
  }

  .zinio-title {
    font-size: clamp(1.8rem, 4vw, 3rem);
    font-weight: 700;
    color: white;
    margin: 0 0 1rem 0;
    line-height: 1.2;
  }

  .zinio-subtitle {
    font-size: clamp(1rem, 2vw, 1.3rem);
    color: rgba(255, 255, 255, 0.9);
    margin: 0 0 2rem 0;
    line-height: 1.5;
  }

  .zinio-buttons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }

  .zinio-button {
    background: white;
    color: #9333ea;
    padding: 1rem 2rem;
    border-radius: 8px;
    font-weight: 600;
    font-size: clamp(0.9rem, 1.8vw, 1.1rem);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    transition: all 0.3s ease;
  }

  .zinio-button:hover {
    background: rgba(255, 255, 255, 0.9);
    transform: translateY(-2px);
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
  }

  .shipment-section {
    max-width: 800px;
    margin: 4rem auto 2rem auto;
    padding: 0 2rem;
  }

  .shipment-content {
    background: rgba(255, 255, 255, 0.05);
    border: 2px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    padding: 3rem 2rem;
    text-align: center;
    transition: all 0.3s ease;
  }

  .shipment-content:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.2);
    transform: translateY(-2px);
  }

  .shipment-icon {
    font-size: 3rem;
    margin-bottom: 1.5rem;
  }

  .shipment-content h3 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    margin: 0 0 1rem 0;
    color: #ffffff;
    line-height: 1.3;
  }

  .shipment-content p {
    font-size: clamp(1rem, 2vw, 1.2rem);
    color: #cccccc;
    margin: 0 0 2rem 0;
    line-height: 1.6;
  }

  .shipment-button {
    display: inline-block;
    background: linear-gradient(135deg, #4ecdc4 0%, #44b3aa 100%);
    color: #1a1a1a;
    font-weight: 700;
    font-size: clamp(1rem, 2vw, 1.1rem);
    padding: 1rem 2rem;
    border-radius: 8px;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .shipment-button:hover {
    background: linear-gradient(135deg, #5ed7ce 0%, #4ecdc4 100%);
    transform: translateY(-2px);
    box-shadow: 0 8px 16px rgba(78, 205, 196, 0.3);
  }

  .newsletter-section {
    max-width: 800px;
    margin: 4rem auto 2rem auto;
    padding: 0 2rem;
  }

  .newsletter-content {
    background: rgba(255, 255, 255, 0.05);
    border: 2px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    padding: 3rem 2rem;
    text-align: center;
  }

  .newsletter-title {
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    font-weight: 700;
    margin: 0 0 1rem 0;
    color: #ffffff;
    line-height: 1.3;
  }

  .newsletter-text {
    font-size: clamp(1rem, 2vw, 1.2rem);
    color: #ddd;
    margin: 0 0 2rem 0;
    line-height: 1.6;
  }

  .newsletter-form {
    max-width: 500px;
    margin: 0 auto;
  }

  .newsletter-input-group {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .newsletter-input {
    width: 100%;
    padding: 1rem;
    border: 2px solid rgba(255, 255, 255, 0.2);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.1);
    color: white;
    font-size: 1rem;
    transition: all 0.3s ease;
  }

  .newsletter-input:focus {
    outline: none;
    border-color: #4ecdc4;
    background: rgba(255, 255, 255, 0.15);
  }

  .newsletter-input::placeholder {
    color: rgba(255, 255, 255, 0.5);
  }

  .newsletter-button {
    width: 100%;
    padding: 1rem 2rem;
    background: linear-gradient(135deg, #4ecdc4 0%, #44b3aa 100%);
    color: #1a1a1a;
    font-weight: 700;
    font-size: 1rem;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.3s ease;
  }

