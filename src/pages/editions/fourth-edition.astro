  /* ── Distribution List ── */
  .distro-section {
    max-width: 1000px;
    margin: 0 auto 5rem auto;
    padding: 0 2rem;
    scroll-margin-top: 5.5rem;
  }

  .distro-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .distro-eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #4ecdc4;
    margin: 0 0 0.5rem 0;
  }

  .distro-heading {
    font-size: clamp(1.8rem, 3vw, 2.5rem);
    font-weight: 900;
    color: #ffffff;
    letter-spacing: -0.02em;
    margin: 0 0 0.75rem 0;
  }

  .distro-subheading {
    font-size: 1rem;
    color: rgba(255,255,255,0.5);
    margin: 0;
    line-height: 1.5;
  }

  .distro-layout {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 2rem;
    align-items: start;
  }

  /* Sidebar */
  .distro-sidebar {
    position: sticky;
    top: 2rem;
  }

  .distro-sidebar-label {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.35);
    margin: 0 0 0.75rem 0;
  }

  .distro-country-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .distro-country-btn {
    width: 100%;
    text-align: left;
    background: none;
    border: none;
    padding: 0.45rem 0.75rem;
    border-radius: 6px;
    font-size: 0.875rem;
    color: rgba(255,255,255,0.5);
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
  }

  .distro-country-btn:hover {
    background: rgba(255,255,255,0.05);
    color: #ffffff;
  }

  .distro-country-btn.is-active {
    background: rgba(78, 205, 196, 0.12);
    color: #4ecdc4;
    font-weight: 700;
  }

  .distro-count {
