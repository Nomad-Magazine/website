---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import SubscribeInput from '~/components/SubscribeInput.astro';
---

<Layout title="Edition Four - Coming Soon">
  <div class="coming-soon-container">
    <!-- Cover Image Section -->
    <div class="cover-section">
      <img 
        src="/images/edition-004-cover.webp" 
        alt="Nomad Magazine Edition Four Cover" 
        class="cover-image"
      />
    </div>

    <div class="hero-text">
      <h1>Edition Four</h1>
      <h2>Coming Soon</h2>
    </div>
    
    <div class="subtitle">
      <p>It will be the best edition so far!</p>
      <p class="pages">128 pages of pure high-end content</p>
    </div>

    <div class="collage">
      <span class="word word-1">Palermo</span>
      <span class="word word-2">Bansko</span>
      <span class="word word-3">Fukuoka</span>
      <span class="word word-4">Madeira Research</span>
      <span class="word word-5">Vanlife Photostory</span>
      <span class="word word-6">Kristin Wilson</span>
      <span class="word word-7">Online Education in creative</span>
      <span class="word word-8">Coworking Contest</span>
      <span class="word word-9">Nomad Directory</span>
      <span class="word word-10">Parenting on the move</span>
      <span class="word word-11">Queer Nomads</span>
      <span class="word word-12">Nomad Fashion</span>
      <span class="word word-13">Lee Holden</span>
    </div>

    <div class="subscribe-section">
      <p class="subscribe-text">Subscribe to be notified when it's ready (if you haven't already)</p>
      <SubscribeInput tag="edition-four" />
      
      <div class="preorder-notice">
        <p>Or <a href="https://pay.nomad-magazine.com/b/fZu14nc2x1bdfAWf0l8bS0L" class="preorder-link">preorder the print edition now</a> and save €5 with code <span class="code">MINUS5</span></p>
      </div>
    </div>

    <!-- Partners Section -->
    <div class="partners-section">
      <h2 class="partners-heading">This edition was brought to life with the support of our partners:</h2>
      
      <div class="partners-grid">
        <div class="partner-logo">
          <img src="/images/logo-palermo-municipality.webp" alt="Città di Palermo" />
        </div>
        <div class="partner-logo">
          <img src="/images/logo-Falmouth-University-Black.webp" alt="Falmouth University" />
        </div>
        <div class="partner-logo">
          <img src="/images/logo-nomads-insure.webp" alt="Nomads Insure" />
        </div>
        <div class="partner-logo">
          <img src="/images/nomad-cruise-logo.webp" alt="Nomad Fest" />
        </div>
        <div class="partner-logo">
          <img src="/images/betahaus-logo.webp" alt="Nomad Tax Bulgaria" />
        </div>
        <div class="partner-logo">
          <img src="/images/Ciao-Logo-black.webp" alt="U Ciao" />
        </div>
        <div class="partner-logo">
          <img src="/images/logo-nomad-train.webp" alt="Nomad Train" />
        </div>
        <div class="partner-logo">
          <img src="/images/betahaus-logo.webp" alt="Beet Community" />
        </div>
        <div class="partner-logo">
          <img src="/images/logo-roamless_black.webp" alt="Roamless" />
        </div>
        <div class="partner-logo">
          <img src="/images/logo-Max-Master-Logo-black.webp" alt="Max Browser" />
        </div>
        <div class="partner-logo">
          <img src="/images/betahaus-logo.webp" alt="Colive Fukuoka" />
        </div>
        <div class="partner-logo">
          <img src="/images/betahaus-logo.webp" alt="Swaphouse" />
        </div>
        <div class="partner-logo">
          <img src="/images/rent-remote-logo.webp" alt="Rent Remote" />
        </div>
        <div class="partner-logo">
          <img src="/images/Logo_BetterNeighbors.webp" alt="The Better Neighbors" />
        </div>
        <div class="partner-logo">
          <img src="/images/betahaus-logo.webp" alt="SUMA" />
        </div>
        <div class="partner-logo">
          <img src="/images/betahaus-logo.webp" alt="Swaphouse" />
        </div>
      </div>
    </div>

    <div class="shipment-section">
      <div class="shipment-content">
        <div class="shipment-icon">📦</div>
        <h3>Want print copies in your coworking, coliving, or Airbnb?</h3>
        <p>Join our free waiting list or order guaranteed delivery of 5 copies for your space.</p>
        <a href="/coworking-coliving-shipments/" class="shipment-button">
          📦 Get Magazine Shipments →
        </a>
      </div>
    </div>
  </div>
</Layout>

<style>
  .coming-soon-container {
    padding: 2rem 2rem 4rem 2rem;
    background: linear-gradient(135deg, #1a1a1a 0%, #2d2d2d 100%);
    color: white;
  }

  .cover-section {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 3rem 0 2rem 0;
    animation: fadeInScale 1s ease-out;
  }

  .cover-image {
    max-width: 400px;
    width: 100%;
    height: auto;
    border-radius: 12px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5),
                0 0 40px rgba(78, 205, 196, 0.3);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .cover-image:hover {
    transform: scale(1.05);
    box-shadow: 0 25px 80px rgba(0, 0, 0, 0.6),
                0 0 60px rgba(78, 205, 196, 0.5);
  }

  @keyframes fadeInScale {
    from {
      opacity: 0;
      transform: scale(0.9);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  .hero-text {
    text-align: center;
    margin-bottom: 2rem;
    padding-top: 2rem;
  }

  .hero-text h1 {
    font-size: clamp(3rem, 8vw, 6rem);
    font-weight: 900;
    letter-spacing: -0.02em;
    margin: 0;
    background: linear-gradient(135deg, #ffffff 0%, #cccccc 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-text h2 {
    font-size: clamp(2rem, 5vw, 4rem);
    font-weight: 300;
    letter-spacing: 0.05em;
    margin: 1rem 0;
    color: #888;
  }

  .subtitle {
    text-align: center;
    margin-bottom: 4rem;
  }

  .subtitle p {
    font-size: clamp(1.2rem, 2.5vw, 2rem);
    font-weight: 500;
    margin: 0.5rem 0;
    color: #ddd;
  }

  .subtitle .pages {
    font-size: clamp(1rem, 2vw, 1.5rem);
    color: #999;
    font-weight: 300;
  }

  .partners-section {
    max-width: 1200px;
    margin: 0 auto 6rem auto;
    padding: 0 2rem;
  }

  .partners-heading {
    text-align: center;
    font-size: clamp(1.2rem, 2.5vw, 1.8rem);
    font-weight: 400;
    color: #ddd;
    margin-bottom: 3rem;
    line-height: 1.4;
  }

  .partners-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 3rem 2rem;
    align-items: center;
    justify-items: center;
  }

  .partner-logo {
    width: 100%;
    max-width: 200px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  .partner-logo:hover {
    transform: scale(1.05);
    opacity: 0.8;
  }

  .partner-logo img {
    width: 100%;
    height: auto;
    max-height: 80px;
    object-fit: contain;
    filter: brightness(0) invert(1);
  }

  .collage {
    position: relative;
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    padding: 2rem 2rem 4rem 2rem;
  }

  .word {
    font-weight: 700;
    line-height: 1;
    padding: 0.5rem 1rem;
    transition: all 0.3s ease;
    cursor: default;
    white-space: nowrap;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .word:hover {
    transform: scale(1.1);
    filter: brightness(1.2);
  }

  .word-1 {
    font-size: clamp(2rem, 5vw, 4.5rem);
    color: #ff6b6b;
    transform: rotate(-3deg);
  }

  .word-2 {
    font-size: clamp(1.8rem, 4.5vw, 3.8rem);
    color: #4ecdc4;
    transform: rotate(2deg);
  }

  .word-3 {
    font-size: clamp(2.2rem, 5.5vw, 5rem);
    color: #ffe66d;
    transform: rotate(-5deg);
  }

  .word-4 {
    font-size: clamp(1.5rem, 3.5vw, 3rem);
    color: #95e1d3;
    transform: rotate(4deg);
  }

  .word-5 {
    font-size: clamp(1.8rem, 4vw, 3.5rem);
    color: #ff8c94;
    transform: rotate(-2deg);
  }

  .word-6 {
    font-size: clamp(2rem, 4.8vw, 4.2rem);
    color: #a8e6cf;
    transform: rotate(3deg);
  }

  .word-7 {
    font-size: clamp(1.4rem, 3.2vw, 2.8rem);
    color: #ffd3b6;
    transform: rotate(-4deg);
  }

  .word-8 {
    font-size: clamp(1.9rem, 4.3vw, 3.9rem);
    color: #ffaaa5;
    transform: rotate(1deg);
  }

  .word-9 {
    font-size: clamp(2.1rem, 5.2vw, 4.7rem);
    color: #a2d5f2;
    transform: rotate(-3deg);
  }

  .word-10 {
    font-size: clamp(1.6rem, 3.8vw, 3.3rem);
    color: #e0b0ff;
    transform: rotate(5deg);
  }

  .word-11 {
    font-size: clamp(1.9rem, 4.5vw, 4rem);
    color: #d4a5a5;
    transform: rotate(-2deg);
  }

  .word-12 {
    font-size: clamp(2rem, 4.7vw, 4.3rem);
    color: #9fd8df;
    transform: rotate(3deg);
  }

  .word-13 {
    font-size: clamp(2.2rem, 5.3vw, 4.8rem);
    color: #ffccf9;
    transform: rotate(-4deg);
  }

  .subscribe-section {
    max-width: 600px;
    margin: 3rem auto;
    padding: 2rem;
    text-align: center;
  }

  .subscribe-text {
    font-size: clamp(1rem, 2vw, 1.3rem);
    color: #ddd;
    margin-bottom: 2rem;
    font-weight: 400;
    line-height: 1.6;
  }

  .preorder-notice {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .preorder-notice p {
    font-size: clamp(0.9rem, 1.8vw, 1.1rem);
    color: #aaa;
    margin: 0;
    line-height: 1.6;
  }

  .preorder-link {
    color: #4ecdc4;
    text-decoration: none;
    font-weight: 500;
    transition: color 0.3s ease;
  }

  .preorder-link:hover {
    color: #5ed7ce;
    text-decoration: underline;
  }

  .code {
    font-family: monospace;
    background: rgba(255, 255, 255, 0.1);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    color: #ffe66d;
    font-weight: 600;
  }

  .shipment-section {
    max-width: 800px;
    margin: 4rem auto 2rem auto;
    padding: 0 2rem;
  }

  .shipment-content {
    background: rgba(255, 255, 255, 0.05);
    border: 2px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    padding: 3rem 2rem;
    text-align: center;
    transition: all 0.3s ease;
  }

  .shipment-content:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.2);
    transform: translateY(-2px);
  }

  .shipment-icon {
    font-size: 3rem;
    margin-bottom: 1.5rem;
  }

  .shipment-content h3 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    margin: 0 0 1rem 0;
    color: #ffffff;
    line-height: 1.3;
  }

  .shipment-content p {
    font-size: clamp(1rem, 2vw, 1.2rem);
    color: #cccccc;
    margin: 0 0 2rem 0;
    line-height: 1.6;
  }

  .shipment-button {
    display: inline-block;
    background: linear-gradient(135deg, #4ecdc4 0%, #44b3aa 100%);
    color: #1a1a1a;
    font-weight: 700;
    font-size: clamp(1rem, 2vw, 1.1rem);
    padding: 1rem 2rem;
    border-radius: 8px;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .shipment-button:hover {
    background: linear-gradient(135deg, #5ed7ce 0%, #4ecdc4 100%);
    transform: translateY(-2px);
    box-shadow: 0 8px 16px rgba(78, 205, 196, 0.3);
  }

  @media (max-width: 768px) {
    .coming-soon-container {
      padding: 1rem;
    }

    .cover-section {
      padding: 2rem 0 1rem 0;
    }

    .cover-image {
      max-width: 280px;
    }

    .hero-text {
      padding-top: 1rem;
      margin-bottom: 1.5rem;
    }

    .subtitle {
      margin-bottom: 2rem;
    }

    .partners-section {
      margin-bottom: 4rem;
      padding: 0 1rem;
    }

    .partners-heading {
      font-size: clamp(1rem, 2vw, 1.3rem);
      margin-bottom: 2rem;
    }

    .partners-grid {
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
      gap: 2rem 1.5rem;
    }

    .partner-logo {
      max-width: 150px;
      padding: 0.5rem;
    }

    .partner-logo img {
      max-height: 60px;
    }

    .collage {
      gap: 0.5rem;
      padding: 1rem 1rem 2rem 1rem;
    }

    .word {
      padding: 0.3rem 0.6rem;
    }

    .subscribe-section {
      margin: 2rem auto;
      padding: 1.5rem 1rem;
    }

    .shipment-section {
      margin: 3rem auto 1rem auto;
      padding: 0 1rem;
    }

    .shipment-content {
      padding: 2rem 1.5rem;
    }

    .shipment-icon {
      font-size: 2.5rem;
      margin-bottom: 1rem;
    }
  }
</style>

