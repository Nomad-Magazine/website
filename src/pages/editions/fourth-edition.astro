  .collage {
    position: relative;
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    padding: 2rem 2rem 4rem 2rem;
  }

  .word {
    font-weight: 700;
    line-height: 1;
    padding: 0.5rem 1rem;
    transition: all 0.3s ease;
    cursor: default;
    white-space: nowrap;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .word:hover {
    transform: scale(1.1);
    filter: brightness(1.2);
  }

  .word-1 {
    font-size: clamp(2rem, 5vw, 4.5rem);
    color: #ff6b6b;
    transform: rotate(-3deg);
  }

  .word-2 {
    font-size: clamp(1.8rem, 4.5vw, 3.8rem);
    color: #4ecdc4;
    transform: rotate(2deg);
  }

  .word-3 {
    font-size: clamp(2.2rem, 5.5vw, 5rem);
    color: #ffe66d;
    transform: rotate(-5deg);
  }

  .word-4 {
    font-size: clamp(1.5rem, 3.5vw, 3rem);
    color: #95e1d3;
    transform: rotate(4deg);
  }

  .word-5 {
    font-size: clamp(1.8rem, 4vw, 3.5rem);
    color: #ff8c94;
    transform: rotate(-2deg);
  }

  .word-6 {
    font-size: clamp(2rem, 4.8vw, 4.2rem);
    color: #a8e6cf;
    transform: rotate(3deg);
  }

  .word-7 {
    font-size: clamp(1.4rem, 3.2vw, 2.8rem);
    color: #ffd3b6;
    transform: rotate(-4deg);
  }

  .word-8 {
    font-size: clamp(1.9rem, 4.3vw, 3.9rem);
    color: #ffaaa5;
    transform: rotate(1deg);
  }

  .word-9 {
    font-size: clamp(2.1rem, 5.2vw, 4.7rem);
    color: #a2d5f2;
    transform: rotate(-3deg);
  }

  .word-10 {
    font-size: clamp(1.6rem, 3.8vw, 3.3rem);
    color: #e0b0ff;
    transform: rotate(5deg);
  }

  .word-11 {
    font-size: clamp(1.9rem, 4.5vw, 4rem);
    color: #d4a5a5;
    transform: rotate(-2deg);
  }

  .word-12 {
    font-size: clamp(2rem, 4.7vw, 4.3rem);
    color: #9fd8df;
    transform: rotate(3deg);
  }

  .word-13 {
    font-size: clamp(2.2rem, 5.3vw, 4.8rem);
    color: #ffccf9;
    transform: rotate(-4deg);
  }

  .digital-section {
