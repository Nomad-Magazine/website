  /* ── Palermo Spotlight ── */
  .palermo-section {
    max-width: 1400px;
    margin: 5rem auto;
    padding: 0 2rem;
  }

  .palermo-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: center;
  }

  .palermo-image-col {
    position: relative;
  }

  .palermo-carousel {
    position: relative;
    width: 100%;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
  }

  .palermo-carousel-track {
    display: flex;
    align-items: flex-start;
    transition: transform 0.45s ease;
    will-change: transform;
  }

  .palermo-carousel-slide {
    flex: 0 0 100%;
    width: 100%;
    min-width: 0;
    box-sizing: border-box;
  }

  .palermo-carousel-img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: contain;
    object-position: center top;
  }

  .palermo-carousel-counter {
    position: absolute;
    bottom: 0.75rem;
    left: 50%;
    transform: translateX(-50%);
    margin: 0;
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.95);
    background: rgba(0, 0, 0, 0.5);
    z-index: 2;
    pointer-events: none;
  }

  .palermo-carousel-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(0, 0, 0, 0.45);
    border: none;
    color: #fff;
    font-size: 1.25rem;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease;
    z-index: 2;
    line-height: 1;
  }

  .palermo-carousel-btn:hover {
    background: rgba(0, 0, 0, 0.7);
  }

  .palermo-carousel-prev { left: 0.75rem; }
  .palermo-carousel-next { right: 0.75rem; }

  .palermo-copy-col {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .palermo-eyebrow {
    margin: 0;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #ff6b6b;
  }

  .palermo-heading {
    margin: 0;
    font-size: clamp(1.8rem, 3.2vw, 2.8rem);
    font-weight: 900;
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: #ffffff;
  }

  .palermo-body {
    margin: 0;
    font-size: clamp(1rem, 1.6vw, 1.1rem);
    color: rgba(255, 255, 255, 0.65);
    line-height: 1.7;
  }

  .palermo-cta {
    display: inline-block;
    align-self: flex-start;
    border: 2px solid rgba(255, 255, 255, 0.35);
    color: #ffffff;
    padding: 0.9rem 2.2rem;
    border-radius: 8px;
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    letter-spacing: 0.02em;
    transition: border-color 0.25s ease, background 0.25s ease, transform 0.25s ease;
  }

  .palermo-cta:hover {
    border-color: #ffffff;
    background: rgba(255, 255, 255, 0.08);
    transform: translateY(-2px);
  }

  /* ── Visual Preview Strip ── */
  .preview-section {
    margin: 5rem 0;
    overflow: hidden;
  }

  .preview-header {
    max-width: 1400px;
    margin: 0 auto 2.5rem auto;
    padding: 0 2rem;
  }

  .preview-eyebrow {
    margin: 0 0 0.4rem 0;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #4ecdc4;
  }

  .preview-heading {
    margin: 0;
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    font-weight: 900;
    letter-spacing: -0.02em;
    color: #ffffff;
  }

  .preview-track {
    display: flex;
    gap: 1.25rem;
    padding: 0 2rem 1.5rem 2rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    scrollbar-color: rgba(255,255,255,0.15) transparent;
  }

  .preview-track::-webkit-scrollbar {
    height: 4px;
  }

  .preview-track::-webkit-scrollbar-track {
    background: transparent;
  }

  .preview-track::-webkit-scrollbar-thumb {
    background: rgba(255,255,255,0.15);
    border-radius: 2px;
  }

  .preview-card {
    flex: 0 0 340px;
    scroll-snap-align: start;
    margin: 0;
    border-radius: 12px;
    overflow: hidden;
    background: #111;
    display: flex;
    flex-direction: column;
  }

  .preview-img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .preview-card:hover .preview-img {
    transform: scale(1.04);
  }

  .preview-caption {
    padding: 1rem 1.2rem 1.2rem 1.2rem;
    font-size: 0.85rem;
    font-weight: 400;
    color: rgba(255,255,255,0.5);
    line-height: 1.5;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .preview-topic {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #4ecdc4;
  }

  /* ── Why This Issue ── */
  .why-issue-section {
    max-width: 800px;
    margin: 6rem auto;
    padding: 0 2rem;
    text-align: center;
  }

  .why-issue-heading {
    font-size: clamp(2rem, 4vw, 2.8rem);
    font-weight: 900;
    letter-spacing: -0.02em;
    color: #ffffff;
    margin: 0 0 2rem 0;
  }

  .why-issue-text {
    font-size: clamp(1.1rem, 2vw, 1.3rem);
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.8);
    margin: 0 0 1.5rem 0;
  }

  .why-issue-text strong {
    color: #ffffff;
    font-weight: 700;
  }

  .partners-section {
    max-width: 1400px;
    margin: 0 auto 6rem auto;
    padding: 4rem 2rem;
    background: white;
    border-radius: 16px;
  }

  .partners-heading {
    text-align: center;
    font-size: clamp(1.2rem, 2.5vw, 1.8rem);
    font-weight: 400;
    color: #333;
    margin-bottom: 3rem;
    line-height: 1.4;
  }

  .partners-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.5rem 2rem;
    align-items: center;
    justify-items: center;
