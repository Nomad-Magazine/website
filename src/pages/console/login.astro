---
import '~/styles/global.css'
import { createSupabaseServerClient } from '~/utils/supabase-server'

const supabase = createSupabaseServerClient(Astro.request, Astro.cookies)
const { data: { user } } = await supabase.auth.getUser()
if (user) {
  return Astro.redirect('/console/')
}

const url = new URL(Astro.request.url)
const modeParam = url.searchParams.get('mode') ?? 'signin'

let error = url.searchParams.get('error') ?? ''
let successMessage = ''
let activeMode = modeParam === 'signup' ? 'signup' : 'signin'

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData()
  const email = String(form.get('email') ?? '')
  const password = String(form.get('password') ?? '')
  const mode = String(form.get('mode') ?? 'signin')
  activeMode = mode === 'signup' ? 'signup' : 'signin'

  if (mode === 'signup') {
    const confirmPassword = String(form.get('confirm_password') ?? '')
    if (password !== confirmPassword) {
      error = 'Passwords do not match.'
    } else if (password.length < 8) {
      error = 'Password must be at least 8 characters.'
    } else {
      const redirectTo = `${url.origin}/auth/callback/`
      const { error: authError } = await supabase.auth.signUp({ email, password, options: { emailRedirectTo: redirectTo } })
      if (authError) {
        error = authError.message
      } else {
        successMessage = 'Account created! Check your email to confirm your address, then sign in.'
        activeMode = 'signin'
      }
    }
  } else {
    const { error: authError } = await supabase.auth.signInWithPassword({ email, password })
    if (authError) {
      error = authError.message
    } else {
      return Astro.redirect('/console/')
    }
  }
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{activeMode === 'signup' ? 'Create Account' : 'Sign In'} — Nomad Magazine Console</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.ico" />
  </head>
  <body class="bg-gray-950 text-gray-100 min-h-screen font-inter antialiased flex items-center justify-center p-4">
    <div class="w-full max-w-md">
      <!-- Logo -->
      <div class="text-center mb-8">
        <div class="inline-flex items-center justify-center w-12 h-12 bg-yellow-400 rounded-xl mb-4">
          <svg class="w-7 h-7 text-black" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
            <path d="M9 4.804A7.968 7.968 0 005.5 4c-1.255 0-2.443.29-3.5.804v10A7.969 7.969 0 015.5 14c1.669 0 3.218.51 4.5 1.385A7.962 7.962 0 0114.5 14c1.255 0 2.443.29 3.5.804v-10A7.968 7.968 0 0014.5 4c-1.255 0-2.443.29-3.5.804V12a1 1 0 11-2 0V4.804z"/>
          </svg>
        </div>
        <h1 class="text-2xl font-bold text-white">Member Console</h1>
        <p class="text-gray-400 mt-1">
          {activeMode === 'signup' ? 'Create your account to get started' : 'Sign in to manage your listing'}
        </p>
      </div>

      <!-- Tab switcher -->
      <div class="flex bg-gray-900 border border-gray-800 rounded-xl p-1 mb-4">
        <a
          href="/console/login/"
          class={`flex-1 text-center py-2 px-4 rounded-lg text-sm font-medium transition-colors ${activeMode === 'signin' ? 'bg-gray-800 text-white' : 'text-gray-400 hover:text-white'}`}
        >
          Sign in
        </a>
        <a
          href="/console/login/?mode=signup"
          class={`flex-1 text-center py-2 px-4 rounded-lg text-sm font-medium transition-colors ${activeMode === 'signup' ? 'bg-gray-800 text-white' : 'text-gray-400 hover:text-white'}`}
        >
          Create account
        </a>
      </div>

      <!-- Card -->
      <div class="bg-gray-900 border border-gray-800 rounded-2xl p-8">
        {error && (
          <div class="mb-6 p-4 bg-red-500/10 border border-red-500/20 rounded-lg text-red-400 text-sm" role="alert">
            {error}
          </div>
        )}
        {successMessage && (
          <div class="mb-6 p-4 bg-green-500/10 border border-green-500/20 rounded-lg text-green-400 text-sm" role="status">
            {successMessage}
          </div>
        )}

        {activeMode === 'signin' ? (
          <form method="POST" aria-label="Sign in form" class="space-y-5">
            <input type="hidden" name="mode" value="signin" />
            <div>
              <label for="email" class="block text-sm font-medium text-gray-300 mb-2">Email address</label>
              <input
                id="email"
                name="email"
                type="email"
                required
                autocomplete="email"
                placeholder="you@company.com"
                class="w-full px-4 py-3 bg-gray-800 border border-gray-700 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-yellow-400/50 focus:border-yellow-400 transition-colors"
              />
            </div>
            <div>
              <label for="password" class="block text-sm font-medium text-gray-300 mb-2">Password</label>
              <input
                id="password"
                name="password"
                type="password"
                required
                autocomplete="current-password"
                placeholder="••••••••"
                class="w-full px-4 py-3 bg-gray-800 border border-gray-700 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-yellow-400/50 focus:border-yellow-400 transition-colors"
              />
            </div>
            <button
              type="submit"
              class="w-full py-3 px-4 bg-yellow-400 hover:bg-yellow-300 text-black font-semibold rounded-lg transition-colors focus-visible:ring-2 focus-visible:ring-yellow-400 focus-visible:ring-offset-2 focus-visible:ring-offset-gray-900"
            >
              Sign in
            </button>
          </form>
        ) : (
          <form method="POST" aria-label="Create account form" class="space-y-5">
            <input type="hidden" name="mode" value="signup" />
            <div>
              <label for="signup-email" class="block text-sm font-medium text-gray-300 mb-2">Email address</label>
              <input
                id="signup-email"
                name="email"
                type="email"
                required
                autocomplete="email"
                placeholder="you@company.com"
                class="w-full px-4 py-3 bg-gray-800 border border-gray-700 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-yellow-400/50 focus:border-yellow-400 transition-colors"
              />
            </div>
            <div>
              <label for="signup-password" class="block text-sm font-medium text-gray-300 mb-2">Password</label>
              <input
                id="signup-password"
                name="password"
                type="password"
                required
                autocomplete="new-password"
                placeholder="Min. 8 characters"
                class="w-full px-4 py-3 bg-gray-800 border border-gray-700 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-yellow-400/50 focus:border-yellow-400 transition-colors"
              />
            </div>
            <div>
              <label for="confirm-password" class="block text-sm font-medium text-gray-300 mb-2">Confirm password</label>
              <input
                id="confirm-password"
                name="confirm_password"
                type="password"
                required
                autocomplete="new-password"
                placeholder="••••••••"
                class="w-full px-4 py-3 bg-gray-800 border border-gray-700 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-yellow-400/50 focus:border-yellow-400 transition-colors"
              />
            </div>
            <button
              type="submit"
              class="w-full py-3 px-4 bg-yellow-400 hover:bg-yellow-300 text-black font-semibold rounded-lg transition-colors focus-visible:ring-2 focus-visible:ring-yellow-400 focus-visible:ring-offset-2 focus-visible:ring-offset-gray-900"
            >
              Create account
            </button>
            <p class="text-xs text-gray-500 text-center">
              By creating an account you agree to our terms of service.
            </p>
          </form>
        )}
      </div>

      <p class="text-center text-xs text-gray-600 mt-6">
        <a href="/" class="hover:text-gray-400 transition-colors">← Back to Nomad Magazine</a>
      </p>
    </div>
  </body>
</html>
