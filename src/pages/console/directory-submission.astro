---
import { directoryImageUrl } from '~/utils/directory-public'
import ConsoleLayout from '~/layouts/console/ConsoleLayout.astro'
import { createSupabaseServerClient } from '~/utils/supabase-server'
import { DIRECTORY_CATEGORIES } from '~/utils/smartsuite-directory'
import { loadWorkspace, emptyListing, textField, uploadListingLogo, workspaceError, type ListingPayload, type WorkspaceListing } from '~/utils/directory-workspace'
const client = createSupabaseServerClient(Astro.request, Astro.cookies)
const {
  data: { user },
} = await client.auth.getUser()
const requested = Astro.url.searchParams.get('id')
let listing: WorkspaceListing | undefined,
  error = '',
  values: ListingPayload = { ...emptyListing }
try {
  const workspace = await loadWorkspace(client)
  listing = requested ? workspace.listings.find((item) => item.id === requested) : undefined
  if (requested && !listing) {
    Astro.response.status = 404
    error = 'Listing not found or not owned by this account.'
  }
  if (listing) values = listing.draft
} catch (err) {
  error = workspaceError(err)
}
if (Astro.request.method === 'POST' && !error) {
  const form = await Astro.request.formData()
  values = Object.fromEntries(Object.keys(emptyListing).map((key) => [key, textField(form, key)])) as ListingPayload
  try {
    const uploaded = await uploadListingLogo(client, user.id, form.get('logo'))
    values.image = uploaded || values.image
    const { data, error: saveError } = await client.rpc('directory_save_listing', {
      p_id: listing?.id || null,
      p_payload: values,
      p_submit: form.get('intent') === 'submit',
      p_version: Number(form.get('version') || 0),
    })
    if (saveError) throw saveError
    return Astro.redirect(`/console/directory-submission/?id=${data}&saved=1`, 303)
  } catch (err) {
    error = workspaceError(err)
  }
}
---

<ConsoleLayout title={listing ? 'Edit listing' : 'Add a listing'} currentPage="directory">
  <p class="eyebrow">Your business, your story</p><h2>{listing ? 'Keep your listing up to date.' : 'Introduce your business to nomads.'}</h2><p class="muted">
    Save a draft or send it for review. Your current published listing stays visible while changes are reviewed.
  </p>
  {
    error && (
      <p class="notice error actions" role="alert">
        {error}
      </p>
    )
  }
  {
    Astro.url.searchParams.has('saved') && (
      <p class="notice actions" role="status">
        {listing?.status === 'pending' ? 'Submitted for review. We’ll review your changes before publishing.' : 'Draft saved. You can continue editing or submit it for review.'}
      </p>
    )
  }
  {
    Astro.url.searchParams.has('claimed') && (
      <p class="notice actions" role="status">
        Ownership verified. You can now manage this listing.
      </p>
    )
  }
  {listing?.review_notes && <p class="notice actions">Reviewer: {listing.review_notes}</p>}
  {
    (!requested || listing) && (
      <form method="POST" enctype="multipart/form-data" aria-label="Manage directory listing" class="actions" style="display:block">
        <>
          <input type="hidden" name="version" value={listing?.version || 0} />
          <input type="hidden" name="image" value={values.image} />
        </>
        <>
          <section class="panel">
            <div class="row">
              <h3>Listing details</h3>
              {listing && <span class={`tag ${listing.status}`}>{listing.status}</span>}
            </div>
            <div class="grid">
              <>
                <div class="field">
                  <>
                    <label for="title">Business name</label>
                    <input id="title" name="title" required minlength="2" maxlength="120" value={values.title} />
                  </>
                </div>
                <div class="field">
                  <>
                    <label for="category">Category</label>
                    <select id="category" name="category" required>
                      <option value="">Choose a category</option>
                      {DIRECTORY_CATEGORIES.map((category) => (
                        <option value={category.label} selected={values.category === category.label}>
                          {category.label}
                        </option>
                      ))}
                    </select>
                  </>
                </div>
              </>
            </div>
            <div class="grid">
              <>
                <div class="field">
                  <>
                    <label for="website">Website (HTTPS)</label>
                    <input id="website" name="website" type="url" required value={values.website} />
                  </>
                </div>
                <div class="field">
                  <>
                    <label for="location">Location</label>
                    <input id="location" name="location" maxlength="300" value={values.location} />
                  </>
                </div>
              </>
            </div>
            <div class="field">
              <>
                <label for="description">Description</label>
                <textarea id="description" name="description" minlength="20" maxlength="4000" rows="5" required>
                  {values.description}
                </textarea>
              </>
            </div>
            <div class="field">
              <>
                <label for="special-offer">Member offer (optional)</label>
                <textarea id="special-offer" name="special_offer" maxlength="4000" rows="3">
                  {values.special_offer}
                </textarea>
              </>
            </div>
            <div class="field">
              <label for="logo">Business logo (optional)</label>
              <input id="logo" name="logo" type="file" accept="image/webp" aria-describedby="logo-help" />
              <p class="muted" id="logo-help">
                WebP, up to 2 MB. Your existing logo stays in place unless you upload a replacement.
              </p>
              {values.image && <img src={directoryImageUrl(values.image)} alt="Current business logo" width="80" height="80" class="mt-4" />}
            </div>
          </section>
          <div class="actions">
            <>
              <button class="button" type="submit" name="intent" value="submit">
                Submit for review
              </button>
              <button class="button secondary" type="submit" name="intent" value="draft">
                Save draft
              </button>
              <a href="/console/" class="link">
                Back to my listings
              </a>
            </>
          </div>
        </>
      </form>
    )
  }
</ConsoleLayout>
