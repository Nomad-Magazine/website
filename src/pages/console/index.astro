---
import { directoryImageUrl } from '~/utils/directory-public'
import ConsoleLayout from '~/layouts/console/ConsoleLayout.astro'
import { createSupabaseServerClient } from '~/utils/supabase-server'
import { loadWorkspace, workspaceError, type WorkspaceListing, type WorkspacePost } from '~/utils/directory-workspace'
import { getDirectoryEntries } from '~/utils/directory'
const supabase = createSupabaseServerClient(Astro.request, Astro.cookies)
let listings: WorkspaceListing[] = [],
  posts: WorkspacePost[] = [],
  error = ''
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData()
  const result = await supabase.rpc('directory_claim_listing', { p_legacy_id: String(form.get('legacy_id') || '') })
  if (result.error) error = workspaceError(result.error)
  else return Astro.redirect(`/console/directory-submission/?id=${result.data}&claimed=1`, 303)
}
try {
  ;({ listings, posts } = await loadWorkspace(supabase))
} catch (err) {
  error = workspaceError(err)
}
const directory = await getDirectoryEntries()
---

<ConsoleLayout title="My listings" currentPage="dashboard">
  <div class="row">
    <div>
      <p class="eyebrow">Your space in the nomad community</p><h2>Make your next connection.</h2><p class="muted">
        Manage your listings, share what’s new and bring your offers to nomads.
      </p>
    </div><a href="/console/directory-submission/?new=1" class="button">Add a listing ↗</a>
  </div>
  {
    error && (
      <p role="alert" class="notice error">
        {error}
      </p>
    )
  }
  <div class="stats">
    <div class="panel"><strong>{listings.length}</strong><span class="muted">Your listings</span></div><div class="panel">
      <strong>{listings.filter((l) => l.published).length}</strong><span class="muted">Published</span>
    </div><div class="panel">
      <strong>{listings.filter((l) => l.status === 'pending').length + posts.filter((p) => p.status === 'pending').length}</strong><span class="muted">Awaiting review</span>
    </div>
  </div>
  {
    listings.length === 0 && !error && (
      <section class="panel">
        <>
          <h3>Let’s get your business listed.</h3>
          <p class="muted">Create a listing or claim one below using its original contact email.</p>
          <a href="/console/directory-submission/?new=1" class="button actions">
            Create your first listing
          </a>
        </>
      </section>
    )
  }
  {
    listings.map((listing) => (
      <section class="panel">
        <div class="row">
          <span class={`tag ${listing.status}`}>{listing.published ? 'Live listing' : 'Not published'} · {listing.status === 'pending' ? 'Changes in review' : listing.status}</span>
          <a href={`/console/directory-submission/?id=${listing.id}`} class="link">Edit listing ↗</a>
        </div>
        <div class="listing-preview">
          {listing.draft.image && <img src={directoryImageUrl(listing.draft.image)} alt={`${listing.draft.title} logo`} width="64" height="64" />}
          <div>
            <>
              <h3>{listing.draft.title}</h3>
              <p class="muted">
                {listing.draft.category} {listing.draft.location && `· ${listing.draft.location}`}
              </p>
              <p class="muted">{listing.draft.description.slice(0, 200)}</p>
            </>
          </div>
        </div>
        {listing.review_notes && <p class="notice">Reviewer: {listing.review_notes}</p>}
        <div class="actions">
          <a href={`/console/updates/?listing=${listing.id}`} class="button">Post an update</a>
          <a href={`/console/affiliates/?listing=${listing.id}`} class="button secondary">
            Share an affiliate programme
          </a>
          {listing.published && (
            <a class="link" href={`/nomad_directory/#listing-${listing.legacy_id || listing.id}`}>
              View published listing ↗
            </a>
          )}
        </div>
      </section>
    ))
  }
  <section class="panel">
    <h3>Already in the directory?</h3><p class="muted">Claim your existing listing using its original contact email. We verify ownership before giving access.</p><form
      method="POST"
      aria-label="Claim an existing listing"
    >
      <div class="field actions">
        <label for="legacy-id">Your business</label><select id="legacy-id" name="legacy_id" required
          ><option value="">Choose your business</option>{directory.map((entry) => <option value={entry.id}>{entry.title}</option>)}</select>
      </div><button type="submit" class="button secondary">Verify and claim listing</button>
    </form><p class="muted actions">Different contact email? <a href="mailto:hey@nomadgossip.com" class="link">Contact us to verify ownership</a>.</p>
  </section>
</ConsoleLayout>
