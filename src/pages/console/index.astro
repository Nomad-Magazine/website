---
import { directoryImageUrl } from '~/utils/directory-public'
import BusinessPicker from '~/components/console/BusinessPicker.astro'
import ConsoleLayout from '~/layouts/console/ConsoleLayout.astro'
import { createSupabaseServerClient } from '~/utils/supabase-server'
import { loadWorkspace, workspaceError, type WorkspaceListing, type WorkspacePost } from '~/utils/directory-workspace'
import { getDirectoryEntries } from '~/utils/directory'
const supabase = createSupabaseServerClient(Astro.request, Astro.cookies)
let listings: WorkspaceListing[] = [],
  posts: WorkspacePost[] = [],
  autoLinked: { listing_id: string; title: string }[] = [],
  error = ''
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData()
  const result = await supabase.rpc('directory_claim_listing', { p_legacy_id: String(form.get('legacy_id') || '') })
  if (result.error) error = workspaceError(result.error)
  else return Astro.redirect(`/console/directory-submission/?id=${result.data}&claimed=1`, 303)
} else {
  const {
    data: { user },
  } = await supabase.auth.getUser()
  if (user?.email_confirmed_at) {
    const auto = await supabase.rpc('directory_auto_claim_listings')
    if (auto.error) error = error || workspaceError(auto.error)
    else if (auto.data?.length) autoLinked = auto.data as typeof autoLinked
  }
}
try {
  ;({ listings, posts } = await loadWorkspace(supabase))
} catch (err) {
  error = workspaceError(err)
}
const directory = await getDirectoryEntries()
const { data: isAdmin } = await supabase.rpc('directory_is_admin')

function listingStatusChip(listing: WorkspaceListing) {
  if (listing.status === 'rejected' || (listing.status === 'pending' && listing.review_notes?.trim())) {
    return { label: 'Changes requested', tone: 'changes' }
  }
  if (listing.status === 'pending' && listing.published) {
    return { label: 'Live · Update in review', tone: 'pending' }
  }
  if (listing.status === 'pending') return { label: 'In review', tone: 'pending' }
  if (listing.published && listing.status === 'approved') return { label: 'Live', tone: 'live' }
  return { label: 'Draft', tone: 'draft' }
}

const publishedCount = listings.filter((l) => l.published).length
const awaitingReview = listings.filter((l) => l.status === 'pending').length + posts.filter((p) => p.status === 'pending').length
const showStats = !(listings.length === 1 && publishedCount === 1 && awaitingReview === 0)
const hasListings = listings.length > 0
---

<ConsoleLayout title="My listings" currentPage="dashboard">
  <div class="row">
    <div>
      <p class="eyebrow">Your space in the nomad community</p><h2>Make your next connection.</h2><p class="muted">
        Manage your listings, share what’s new and bring your offers to nomads.
      </p>
    </div>{
      hasListings ? (
        <a href="/console/directory-submission/?new=1" class="button secondary">
          Add a listing
        </a>
      ) : (
        <a href="/console/directory-submission/?new=1" class="button">
          Add a listing
        </a>
      )
    }
  </div>
  {
    error && (
      <p role="alert" class="notice error">
        {error}
      </p>
    )
  }
  {
    autoLinked.map((row) => (
      <p role="status" class="notice">
        We found your listing: {row.title}
      </p>
    ))
  }
  {
    showStats && (
      <div class="stats">
        <div class="panel">
          <strong>{listings.length}</strong><span class="muted">Your listings</span>
        </div>
        <div class="panel">
          <strong>{publishedCount}</strong><span class="muted">Published</span>
        </div>
        <div class="panel">
          <strong>{awaitingReview}</strong><span class="muted">Awaiting review</span>
        </div>
      </div>
    )
  }
  {
    listings.length === 0 && !error && (
      <section class="panel">
        <>
          <h3>Let’s get your business listed.</h3>
          <p class="muted">Create a listing or claim one below using its original contact email.</p>
          <a href="/console/directory-submission/?new=1" class="button actions">
            Create your first listing
          </a>
        </>
      </section>
    )
  }
  {
    listings.map((listing) => {
      const chip = listingStatusChip(listing)
      const publicId = listing.legacy_id || listing.id
      return (
        <section class="panel listing-card">
          <div class="row">
            <span class={`tag tag-${chip.tone}`}>{chip.label}</span>
          </div>
          <div class="listing-preview">
            {listing.draft.image && <img src={directoryImageUrl(listing.draft.image)} alt={`${listing.draft.title} logo`} width="64" height="64" />}
            <div>
              <>
                <h3>{listing.draft.title}</h3>
                <p class="muted">
                  {listing.draft.category} {listing.draft.location && `· ${listing.draft.location}`}
                </p>
                <p class="muted">{listing.draft.description.slice(0, 200)}</p>
              </>
            </div>
          </div>
          {listing.review_notes && <p class="notice">Reviewer: {listing.review_notes}</p>}
          <div class="listing-actions actions">
            <a href={`/console/directory-submission/?id=${listing.id}`} class="button">
              Edit listing
            </a>
            {listing.published && (
              <a class="link" href={`/nomad_directory/#listing-${publicId}`}>
                View listing
              </a>
            )}
            {
              isAdmin ? (
                <div class="console-more" data-console-more>
                  <button
                    type="button"
                    class="console-more-trigger"
                    aria-expanded="false"
                    aria-haspopup="menu"
                    aria-controls={`more-menu-${listing.id}`}
                    id={`more-trigger-${listing.id}`}
                  >
                    More
                  </button>
                  <div
                    class="console-more-menu"
                    id={`more-menu-${listing.id}`}
                    role="menu"
                    aria-labelledby={`more-trigger-${listing.id}`}
                    hidden
                  >
                    <a role="menuitem" href={`/console/updates/?listing=${listing.id}`}>
                      Post an update
                    </a>
                    <a role="menuitem" href={`/console/affiliates/?listing=${listing.id}`}>
                      Share an affiliate programme
                    </a>
                  </div>
                </div>
              ) : (
                <a class="link" href={`/console/affiliates/?listing=${listing.id}`}>
                  Share an affiliate programme
                </a>
              )
            }
          </div>
        </section>
      )
    })
  }
  {
    hasListings ? (
      <details class="claim-disclosure">
        <summary class="muted">Already listed? Claim your business</summary>
        <form method="POST" aria-label="Claim an existing listing" class="claim-disclosure-body">
          <BusinessPicker entries={directory} name="legacy_id" />
          <button type="submit" class="button secondary">
            Verify and claim listing
          </button>
          <p class="muted">
            Different contact email? <a href="mailto:hey@nomadgossip.com" class="link">Contact us to verify ownership</a>.
          </p>
        </form>
      </details>
    ) : (
      <section class="panel claim-panel">
        <h3 class="claim-title-sm">Already in the directory?</h3>
        <p class="muted">Claim your existing listing using its original contact email. We verify ownership before giving access.</p>
        <form method="POST" aria-label="Claim an existing listing">
          <BusinessPicker entries={directory} name="legacy_id" />
          <button type="submit" class="button secondary">
            Verify and claim listing
          </button>
        </form>
        <p class="muted actions">
          Different contact email? <a href="mailto:hey@nomadgossip.com" class="link">Contact us to verify ownership</a>.
        </p>
      </section>
    )
  }
</ConsoleLayout>

<script>
  const closeMenu = (root: HTMLElement) => {
    const trigger = root.querySelector<HTMLButtonElement>('.console-more-trigger')!
    const menu = root.querySelector<HTMLElement>('.console-more-menu')!
    menu.hidden = true
    trigger.setAttribute('aria-expanded', 'false')
  }

  document.querySelectorAll<HTMLElement>('[data-console-more]').forEach((root) => {
    const trigger = root.querySelector<HTMLButtonElement>('.console-more-trigger')!
    const menu = root.querySelector<HTMLElement>('.console-more-menu')!

    trigger.addEventListener('click', (event) => {
      event.stopPropagation()
      const open = menu.hidden
      document.querySelectorAll<HTMLElement>('[data-console-more]').forEach((other) => {
        if (other !== root) closeMenu(other)
      })
      menu.hidden = !open
      trigger.setAttribute('aria-expanded', String(open))
    })

    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => closeMenu(root))
    })

    trigger.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        closeMenu(root)
        trigger.focus()
      } else if (event.key === 'ArrowDown' && menu.hidden) {
        event.preventDefault()
        menu.hidden = false
        trigger.setAttribute('aria-expanded', 'true')
        menu.querySelector<HTMLAnchorElement>('[role="menuitem"]')?.focus()
      }
    })

    menu.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        closeMenu(root)
        trigger.focus()
      }
    })
  })

  document.addEventListener('click', (event) => {
    if ((event.target as Element).closest('[data-console-more]')) return
    document.querySelectorAll<HTMLElement>('[data-console-more]').forEach(closeMenu)
  })

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return
    document.querySelectorAll<HTMLElement>('[data-console-more]').forEach(closeMenu)
  })
</script>