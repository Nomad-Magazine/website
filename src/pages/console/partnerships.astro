---
import ConsoleLayout from '~/layouts/console/ConsoleLayout.astro'
import { createSupabaseServerClient } from '~/utils/supabase-server'
import { loadWorkspace, workspaceError, type PartnershipRequestRow } from '~/utils/directory-workspace'

const client = createSupabaseServerClient(Astro.request, Astro.cookies)
const listingFilter = Astro.url.searchParams.get('listing')
let requests: PartnershipRequestRow[] = []
let error = ''
let saved = false

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData()
  const action = String(form.get('action') || '')
  const requestId = String(form.get('request_id') || '')
  const listingId = String(form.get('listing_id') || '')
  const reply = String(form.get('reply') || '').trim()
  const { error: respondError } = await client.rpc('directory_respond_partnership_request', {
    p_request_id: requestId,
    p_listing_id: listingId,
    p_status: action,
    p_reply: reply,
  })
  if (respondError) error = workspaceError(respondError)
  else return Astro.redirect(`${Astro.url.pathname}?listing=${listingId}&saved=1`, 303)
}

try {
  const { data, error: loadError } = await client.rpc('directory_owner_partnership_requests', {
    p_listing_id: listingFilter || null,
  })
  if (loadError) throw loadError
  requests = (data || []) as PartnershipRequestRow[]
} catch (err) {
  error = workspaceError(err)
}
saved = Astro.url.searchParams.has('saved')

let listings: { id: string; title: string }[] = []
try {
  const workspace = await loadWorkspace(client)
  listings = workspace.listings.map((l) => ({ id: l.id, title: l.draft.title }))
} catch {
  // signed-out handled elsewhere
}
---

<ConsoleLayout title="Partnership requests" currentPage="partnerships">
  <p class="eyebrow">Inbox</p>
  <h2>Partnership requests</h2>
  <p class="muted">Requests from your listing pages arrive here. Accept or decline with a short reply.</p>
  {error && <p class="notice error" role="alert">{error}</p>}
  {saved && <p class="notice" role="status">Saved.</p>}
  {
    listings.length > 0 && (
      <form method="GET" class="actions" aria-label="Filter by listing">
        <label for="listing-filter" class="sr-only">Listing</label>
        <select id="listing-filter" name="listing" onchange="this.form.submit()">
          <option value="">All listings</option>
          {listings.map((listing) => (
            <option value={listing.id} selected={listingFilter === listing.id}>
              {listing.title}
            </option>
          ))}
        </select>
      </form>
    )
  }
  {
    requests.length === 0 ? (
      <section class="panel"><p class="muted">No partnership requests yet.</p></section>
    ) : (
      requests.map((request) => (
        <section class={`panel ${request.status === 'new' ? 'listing-card' : ''}`}>
          <div class="row">
            <h3>{request.requester_name}</h3>
            <span class={`tag ${request.status === 'new' ? 'pending' : request.status}`}>{request.status}</span>
          </div>
          <p class="muted">
            {request.listing_title} · <time datetime={request.created_at}>{new Date(request.created_at).toLocaleString('en-GB', { dateStyle: 'medium', timeStyle: 'short' })}</time>
          </p>
          <p>
            <a href={`mailto:${request.requester_email}`} class="link">{request.requester_email}</a>
            {request.requester_company && ` · ${request.requester_company}`}
          </p>
          <p class="mt-3 whitespace-pre-line">{request.message}</p>
          {request.owner_reply && <p class="notice mt-3">Your reply: {request.owner_reply}</p>}
          {
            request.status === 'new' && (
              <form method="POST" class="actions mt-4" aria-label={`Respond to ${request.requester_name}`}>
                <input type="hidden" name="request_id" value={request.id} />
                <input type="hidden" name="listing_id" value={request.listing_id} />
                <button class="button secondary" type="submit" name="action" value="read">
                  Mark read
                </button>
              </form>
            )
          }
          {
            request.status !== 'accepted' && request.status !== 'declined' && (
              <form method="POST" class="actions mt-4" aria-label={`Reply to ${request.requester_name}`}>
                <input type="hidden" name="request_id" value={request.id} />
                <input type="hidden" name="listing_id" value={request.listing_id} />
                <div class="field">
                  <label for={`reply-${request.id}`}>Reply to requester</label>
                  <textarea id={`reply-${request.id}`} name="reply" required minlength="2" maxlength="2000" rows="3" />
                </div>
                <button class="button" type="submit" name="action" value="accepted">
                  Accept partnership
                </button>
                <button class="button secondary" type="submit" name="action" value="declined">
                  Decline
                </button>
              </form>
            )
          }
        </section>
      ))
    )
  }
</ConsoleLayout>