import { getCollection } from 'astro:content'
import Layout, { type SEOProps } from '~/layouts/Layout.astro'
import { Image } from 'astro:assets'

// Get all blog posts and filter for SeoBot articles only (AI-generated)
const allPosts = await getCollection('blog')
const posts = allPosts
  .filter((post) => {
    // Filter for published posts
    if (post.data.published === false) return false
    
    // Custom articles have heroImage in frontmatter - exclude them
    // Check the original data before schema transformation
    const hasHeroImage = post.data.heroImage && !post.data.heroImage.includes('seobotai.com')
    if (hasHeroImage) return false
    
    // SeoBot articles have: author === 'Martin Donadieu' AND author_url === 'https://github.com/riderx'
    const isSeoBot = post.data.author === 'Martin Donadieu' && 
                     post.data.authorUrl === 'https://github.com/riderx'
    
    return isSeoBot
  })
  .sort((a, b) => {
    const dateA = a.data.pubDate || new Date(0)
    const dateB = b.data.pubDate || new Date(0)
    return dateB.valueOf() - dateA.valueOf()
  })

// Use the most recent article as the featured post
const featuredPost = posts[0]

// Get posts with video content for YouTube section
const videoPosts = posts.filter(post => 
  post.body.includes('youtube.com/embed') || 
  post.body.includes('iframe') || 
  post.data.tag?.includes('Video') ||
  post.data.title.toLowerCase().includes('video')
).slice(0, 3)

// Get all posts in chronological order (excluding featured post and video posts)
const regularPosts = posts.filter(post => 
  post.slug !== featuredPost?.slug && 
  !videoPosts.includes(post)
)

// YouTube channel videos
const youtubeVideos = [
  {
    id: 'pgTpfH7zNVs',
    title: 'Why Digital Nomads Are Choosing Buenos Aires in 2025',
    description: 'Discover what makes Buenos Aires a top destination for digital nomads in 2025.',
    thumbnail: 'https://img.youtube.com/vi/pgTpfH7zNVs/hqdefault.jpg',
    duration: '18:45',
    views: '12.3K',
    publishedAt: '2025-01-20'
  },
  {
    id: 'NgG92Q8Uxgg',
    title: 'Why Digital Nomads Choosing Madeira in 2024: Madeira Friends Founders and Community',
    description: 'Meet the founders behind Madeira Friends and discover why digital nomads are flocking to this Portuguese island.',
    thumbnail: 'https://img.youtube.com/vi/NgG92Q8Uxgg/hqdefault.jpg',
    duration: '14:22',
    views: '8.7K',
    publishedAt: '2025-01-18'
  },
  {
    id: '_sBXTskL0gA',
    title: 'Why Digital Nomads Choose Chiang Mai?',
    description: 'Exploring what makes Chiang Mai, Thailand one of the top destinations for digital nomads worldwide.',
    thumbnail: 'https://img.youtube.com/vi/_sBXTskL0gA/hqdefault.jpg',
    duration: '16:33',
    views: '15.9K',
    publishedAt: '2025-01-15'
  }
]

const seo: SEOProps = {
  title: 'Nomad Blog - Digital Nomad Articles & Tips',
  description: 'In-depth articles and useful tips on how to improve your nomadic journey. Expert insights on remote work, travel, and the digital nomad lifestyle.',
  image: `${Astro.site}images/edition-003-cover_holded_front_face.webp`,
  keywords: 'digital nomad blog, remote work tips, nomad lifestyle, travel guides, coworking, nomad community',
  ogType: 'website',
  ldJSON: {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: 'Nomad Blog',
    description: 'In-depth articles and useful tips on how to improve your nomadic journey',
    url: `${Astro.site}blog`,
    publisher: {
      '@type': 'Organization',
      name: 'Nomad Magazine',
      logo: {
        '@type': 'ImageObject',
        url: `${Astro.site}logo.svg`,
      },
    },
    blogPost: posts.slice(0, 10).map((post) => ({
      '@type': 'BlogPosting',
      headline: post.data.title,
      description: post.data.description,
      author: {
        '@type': 'Person',
        name: post.data.author || 'Martin Donadieu',
      },
      datePublished: post.data.pubDate?.toISOString(),
      url: `${Astro.site}blog/${post.slug}`,
    })),
  },
}
---

<Layout seo={seo}>
  <div class="bg-hoverw min-h-screen">
    <!-- Main Content Layout -->
    <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
        
        <!-- Left Main Content - TODAY'S PICKS -->
        <div class="lg:col-span-3">
          <!-- Today's Picks Header -->
          <div class="mb-8">
            <div class="inline-block bg-white text-black px-4 py-2 text-sm font-bold uppercase tracking-wider mb-6">
              Today's Picks
            </div>

            <!-- Row 1: Large center article -->
            {featuredPost && (
              <article class="mb-8">
                <div class="relative">
                  <Image
                    src={featuredPost.data.heroImage || "/images/edition-003-cover_holded_front_face.webp"}
                    alt={featuredPost.data.heroImageAlt || featuredPost.data.title}
                    width={800}
                    height={400}
                    class="w-full aspect-[2/1] object-cover rounded-2xl"
                  />
                </div>
                <div class="mt-4 space-y-3">
                  <div class="text-xs uppercase tracking-wider text-neutral-400 font-bold">
                    Digital Nomads
                  </div>
                  <h1 class="text-3xl lg:text-4xl font-bold leading-tight text-white">
                    <a href={`/blog/${featuredPost.slug}`} class="hover:text-neutral-300 transition-colors">
                      {featuredPost.data.title}
                    </a>
                  </h1>
                  <p class="text-neutral-300 leading-relaxed max-w-3xl">
                    {featuredPost.data.description}
                  </p>
                  <div class="text-xs text-neutral-500 font-bold uppercase">
                    {featuredPost.data.pubDate?.toLocaleDateString('en-US', {
                      month: 'short',
                      day: 'numeric',
                    })}
                  </div>
                </div>
              </article>
            )}

            <!-- Row 2: Three articles side by side -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
              {regularPosts[0] && (
                <article class="space-y-3">
                  <div class="relative">
                    <Image
                      src={regularPosts[0].data.heroImage || "/images/edition-003-cover_holded_front_face.webp"}
                      alt={regularPosts[0].data.heroImageAlt || regularPosts[0].data.title}
                      width={400}
                      height={250}
                      class="w-full aspect-[8/5] object-cover rounded-2xl"
                    />
                  </div>
                  <div class="space-y-2">
                    <div class="text-xs uppercase tracking-wider text-neutral-400 font-bold">
                      Remote Work
                    </div>
                    <h2 class="text-lg font-bold leading-tight text-white">
                      <a href={`/blog/${regularPosts[0].slug}`} class="hover:text-neutral-300 transition-colors">
                        {regularPosts[0].data.title}
                      </a>
                    </h2>
                    <div class="text-xs text-neutral-500 font-bold uppercase">
                      {regularPosts[0].data.pubDate?.toLocaleDateString('en-US', {
                        month: 'short',
                        day: 'numeric',
                      })}
                    </div>
                  </div>
                </article>
              )}

              {regularPosts[1] && (
                <article class="space-y-3">
                  <div class="space-y-2">
                    <div class="text-xs uppercase tracking-wider text-neutral-400 font-bold">
                      Travel Tips
                    </div>
                    <h2 class="text-lg font-bold leading-tight text-white">
                      <a href={`/blog/${regularPosts[1].slug}`} class="hover:text-neutral-300 transition-colors">
                        {regularPosts[1].data.title}
                      </a>
                    </h2>
                    <div class="text-xs text-neutral-500 font-bold uppercase">
                      {regularPosts[1].data.pubDate?.toLocaleDateString('en-US', {
                        month: 'short',
                        day: 'numeric',
                      })}
                    </div>
                  </div>
                </article>
              )}

              {regularPosts[2] && (
                <article class="space-y-3">
                  <div class="space-y-2">
                    <div class="text-xs uppercase tracking-wider text-neutral-400 font-bold">
                      Nomad Life
                    </div>
                    <h2 class="text-lg font-bold leading-tight text-white">
                      <a href={`/blog/${regularPosts[2].slug}`} class="hover:text-neutral-300 transition-colors">
                        {regularPosts[2].data.title}
                      </a>
                    </h2>
                    <div class="text-xs text-neutral-500 font-bold uppercase">
                      {regularPosts[2].data.pubDate?.toLocaleDateString('en-US', {
                        month: 'short',
                        day: 'numeric',
                      })}
                    </div>
                  </div>
                </article>
              )}
            </div>

            <!-- Row 3: Three articles side by side -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
              {regularPosts[3] && (
                <article class="space-y-3">
                  <div class="space-y-2">
                    <div class="text-xs uppercase tracking-wider text-neutral-400 font-bold">
                      Community
                    </div>
                    <h2 class="text-lg font-bold leading-tight text-white">
                      <a href={`/blog/${regularPosts[3].slug}`} class="hover:text-neutral-300 transition-colors">
                        {regularPosts[3].data.title}
                      </a>
                    </h2>
                    <p class="text-neutral-300 text-sm leading-relaxed line-clamp-2">
                      {regularPosts[3].data.description}
                    </p>
                    <div class="text-xs text-neutral-500 font-bold uppercase">
                      {regularPosts[3].data.pubDate?.toLocaleDateString('en-US', {
                        month: 'short',
                        day: 'numeric',
                      })}
                    </div>
                  </div>
                </article>
              )}

              {regularPosts[4] && (
                <article class="space-y-3">
                  <div class="relative">
                    <Image
                      src={regularPosts[4].data.heroImage || "/images/edition-003-cover_holded_front_face.webp"}
                      alt={regularPosts[4].data.heroImageAlt || regularPosts[4].data.title}
                      width={300}
                      height={200}
                      class="w-full aspect-[3/2] object-cover rounded-2xl"
                    />
                  </div>
                  <div class="space-y-2">
                    <div class="text-xs uppercase tracking-wider text-neutral-400 font-bold">
                      Digital Life
                    </div>
                    <h2 class="text-lg font-bold leading-tight text-white">
                      <a href={`/blog/${regularPosts[4].slug}`} class="hover:text-neutral-300 transition-colors">
                        {regularPosts[4].data.title}
                      </a>
                    </h2>
                    <div class="text-xs text-neutral-500 font-bold uppercase">
                      {regularPosts[4].data.pubDate?.toLocaleDateString('en-US', {
                        month: 'short',
                        day: 'numeric',
                      })}
                    </div>
                  </div>
                </article>
              )}

              {regularPosts[5] && (
                <article class="space-y-3">
                  <div class="relative">
                    <Image
                      src={regularPosts[5].data.heroImage || "/images/edition-003-cover_holded_front_face.webp"}
                      alt={regularPosts[5].data.heroImageAlt || regularPosts[5].data.title}
                      width={300}
                      height={200}
                      class="w-full aspect-[3/2] object-cover rounded-2xl"
                    />
                  </div>
                  <div class="space-y-2">
                    <div class="text-xs uppercase tracking-wider text-neutral-400 font-bold">
                      Lifestyle
                    </div>
                    <h2 class="text-lg font-bold leading-tight text-white">
                      <a href={`/blog/${regularPosts[5].slug}`} class="hover:text-neutral-300 transition-colors">
                        {regularPosts[5].data.title}
                      </a>
                    </h2>
                    <div class="text-xs text-neutral-500 font-bold uppercase">
                      {regularPosts[5].data.pubDate?.toLocaleDateString('en-US', {
                        month: 'short',
                        day: 'numeric',
                      })}
                    </div>
                  </div>
                </article>
              )}
            </div>
          </div>
        </div>

        <!-- Right Sidebar - MOST RECENT -->
        <div class="lg:col-span-1">
          <div class="sticky top-8">
            <!-- Giveaway Block -->
            <a 
              href="https://nomad-magazine.com/magazines-giveaway"
              class="block mb-8 bg-gradient-to-br from-red-500 to-orange-500 text-white rounded-xl overflow-hidden group hover:from-red-600 hover:to-orange-600 transition-all transform hover:scale-105 shadow-xl"
            >
              <div class="p-6 space-y-3">
                <div class="flex items-center gap-2">
                  <span class="text-2xl">🎁</span>
                  <span class="text-xs uppercase tracking-wider font-bold">Limited Time</span>
                </div>
                <div class="text-xl font-bold leading-tight">
                  Get 3 Free<br/>Digital Magazines
                </div>
                <p class="text-sm opacity-90 leading-relaxed">
                  300+ pages of nomad stories & insights. Download instantly!
                </p>
                <div class="flex items-center gap-2 text-sm font-medium">
                  <span>Claim Now</span>
                  <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                  </svg>
                </div>
                <div class="text-xs opacity-75">
                  Expires Dec 10, 2025
                </div>
              </div>
            </a>

            <div class="inline-block bg-white text-black px-4 py-2 text-sm font-bold uppercase tracking-wider mb-6">
              Most Recent
            </div>
            
            <div class="space-y-6">
              {regularPosts.slice(6, 11).map((post) => (
                <article class="flex gap-4">
                  <div class="flex-shrink-0">
                    <Image
                      src={post.data.heroImage || "/images/edition-003-cover_holded_front_face.webp"}
                      alt={post.data.heroImageAlt || post.data.title}
                      width={120}
                      height={80}
                      class="w-20 h-16 object-cover rounded"
                    />
                  </div>
                  <div class="space-y-1 flex-1">
                    <h3 class="text-sm font-bold leading-tight text-white">
                      <a href={`/blog/${post.slug}`} class="hover:text-neutral-300 transition-colors">
                        {post.data.title}
                      </a>
                    </h3>
                    <div class="text-xs text-neutral-400">
                      {post.data.pubDate?.toLocaleDateString('en-US', {
                        month: 'short',
                        day: 'numeric',
                      })}
                    </div>
                  </div>
                </article>
              ))}
            </div>

            <!-- Featured Box -->
            <div class="mt-12 bg-neutral-800 border border-neutral-700 text-white p-6 space-y-4 rounded-lg">
              <div class="text-xs uppercase tracking-wider font-bold text-yellow-400">
                Featured
              </div>
              <div class="space-y-4">
                <div class="flex items-center gap-3">
                  <div class="flex-shrink-0 w-8 h-8 bg-yellow-400 rounded flex items-center justify-center">
                    <svg class="w-4 h-4 text-black" fill="currentColor" viewBox="0 0 20 20">
                      <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                    </svg>
                  </div>
                  <div class="text-sm font-bold">
                    Discover Nomad Directory
                  </div>
                </div>
                <p class="text-sm leading-relaxed text-neutral-300">
                  Find your perfect nomad destination, coworking spaces, and connect with the global digital nomad community. Browse our comprehensive directory of nomad-friendly locations worldwide.
                </p>
                <a 
                  href="/nomad-directory/" 
                  class="inline-flex items-center gap-2 text-yellow-400 hover:text-yellow-300 transition-colors text-sm font-medium"
                >
                  Explore Directory
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                  </svg>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- YouTube Section -->
    <section class="border-b border-neutral-800 bg-neutral-900/30 px-4 py-16 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="mb-12 flex items-center justify-between">
          <div>
            <h2 class="text-3xl font-bold text-white">Latest Videos</h2>
            <p class="mt-2 text-lg text-neutral-400">Watch our latest content on YouTube</p>
          </div>
          <a 
            href="https://www.youtube.com/@Nomad-Magazine" 
            target="_blank"
            class="inline-flex items-center gap-2 rounded-lg bg-red-600 px-4 py-2 text-sm font-bold text-white transition-all hover:bg-red-700"
          >
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
            </svg>
            Subscribe
          </a>
        </div>
        
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
          {youtubeVideos.map((video) => (
            <div class="group relative overflow-hidden rounded-2xl bg-neutral-900/50 transition-all hover:bg-neutral-900/80 hover:scale-105">
              <div class="relative">
                <img
                  src={video.thumbnail}
                  alt={video.title}
                  class="aspect-video w-full object-cover"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
                <div class="absolute bottom-2 right-2 rounded bg-black/80 px-2 py-1 text-xs text-white">
                  {video.duration}
                </div>
                <div class="absolute inset-0 flex items-center justify-center">
                  <div class="rounded-full bg-red-600 p-4 transition-all group-hover:bg-red-700 group-hover:scale-110">
                    <svg class="h-8 w-8 text-white" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M8 5v14l11-7z"/>
                    </svg>
                  </div>
                </div>
              </div>
              <div class="p-6">
                <h3 class="mb-2 text-lg font-bold text-white group-hover:text-yellow-400 transition-colors">
                  <a href={`https://www.youtube.com/watch?v=${video.id}`} target="_blank" class="after:absolute after:inset-0">
                    {video.title}
                  </a>
                </h3>
                <p class="text-sm text-neutral-300 line-clamp-2">
                  {video.description}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>



    <!-- Featured Stories Section -->
    <section class="border-b border-neutral-800 bg-neutral-900/20 px-4 py-16 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="mb-12 text-center">
          <h2 class="text-3xl font-bold text-white">Featured Stories</h2>
          <p class="mt-2 text-lg text-neutral-400">Essential reads for digital nomads</p>
        </div>
        
        <!-- Featured Layout: One Big Article -->
        <div class="mb-8">
          {regularPosts[0] && (
            <article class="group relative overflow-hidden rounded-2xl border border-neutral-700/50 bg-neutral-900/30 transition-all hover:border-neutral-600 hover:bg-neutral-900/60">
              <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                <div class="relative">
                  {regularPosts[0] && (
                    <div class="aspect-[16/10] overflow-hidden rounded-l-2xl">
                      <Image
                        src={regularPosts[0].data.heroImage || "/images/edition-003-cover_holded_front_face.webp"}
                        alt={regularPosts[0].data.heroImageAlt || regularPosts[0].data.title}
                        width={600}
                        height={375}
                        class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                      />
                    </div>
                  )}
                  <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent rounded-l-2xl"></div>
                </div>
                
                <div class="p-8 flex flex-col justify-center">
                  <div class="mb-4 flex items-center gap-2 text-sm text-neutral-400">
                    {regularPosts[0].data.pubDate && (
                      <time datetime={regularPosts[0].data.pubDate.toISOString()}>
                        {regularPosts[0].data.pubDate.toLocaleDateString('en-US', {
                          month: 'short',
                          day: 'numeric',
                          year: 'numeric',
                        })}
                      </time>
                    )}
                    <span>•</span>
                    <span>{Math.ceil(regularPosts[0].body.length / 1000)} min read</span>
                  </div>
                  
                  <h3 class="mb-4 text-3xl font-bold leading-tight text-white group-hover:text-yellow-400 transition-colors">
                    <a href={`/blog/${regularPosts[0].slug}`} class="after:absolute after:inset-0">
                      {regularPosts[0].data.title}
                    </a>
                  </h3>
                  
                  <p class="mb-6 text-lg text-neutral-300 line-clamp-3">
                    {regularPosts[0].data.description}
                  </p>
                  
                  <div class="flex items-center justify-between">
                    <span class="text-sm text-neutral-400 font-medium group-hover:text-yellow-400 transition-colors">
                      Read More
                    </span>
                    <svg class="h-4 w-4 text-neutral-400 group-hover:text-yellow-400 transition-all group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                    </svg>
                  </div>
                </div>
              </div>
            </article>
          )}
        </div>

        <!-- Three Smaller Articles in a Row -->
        <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
          {regularPosts.slice(1, 4).map((post) => (
            <article class="group relative overflow-hidden rounded-2xl border border-neutral-700/50 bg-neutral-900/30 transition-all hover:border-neutral-600 hover:bg-neutral-900/60">
              <div class="relative">
                {post.data.heroImage && (
                  <div class="aspect-video overflow-hidden">
                    <Image
                      src={post.data.heroImage}
                      alt={post.data.heroImageAlt || post.data.title}
                      width={400}
                      height={225}
                      class="w-full object-cover transition-transform duration-300 group-hover:scale-105"
                    />
                  </div>
                )}
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
              </div>
              
              <div class="p-6">
                <div class="mb-3 flex items-center gap-2 text-sm text-neutral-400">
                  {post.data.pubDate && (
                    <time datetime={post.data.pubDate.toISOString()}>
                      {post.data.pubDate.toLocaleDateString('en-US', {
                        month: 'short',
                        day: 'numeric',
                      })}
                    </time>
                  )}
                  <span>•</span>
                  <span>{Math.ceil(post.body.length / 1000)} min</span>
                </div>
                
                <h3 class="mb-3 text-xl font-bold leading-tight text-white group-hover:text-yellow-400 transition-colors">
                  <a href={`/blog/${post.slug}`} class="after:absolute after:inset-0">
                    {post.data.title}
                  </a>
                </h3>
                
                <p class="mb-4 text-base text-neutral-300 line-clamp-2">
                  {post.data.description}
                </p>
                
                <div class="flex items-center justify-between">
                  <span class="text-sm text-neutral-400 font-medium group-hover:text-yellow-400 transition-colors">
                    Read More
                  </span>
                  <svg class="h-4 w-4 text-neutral-400 group-hover:text-yellow-400 transition-all group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                  </svg>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Archive Section -->
    {regularPosts.length > 11 && (
      <section class="bg-hoverw px-4 py-16 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-7xl">
          <div class="mb-12 text-center">
            <h2 class="text-3xl font-bold text-white mb-4">From the Archive</h2>
            <p class="text-lg text-neutral-400">Discover more stories from our community</p>
          </div>
          
          <div id="archive-grid" class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
            {regularPosts.slice(6).map((post, index) => (
              <article 
                class={`archive-post group relative overflow-hidden rounded-xl border border-neutral-800/50 bg-neutral-900/20 transition-all hover:border-neutral-700 hover:bg-neutral-900/40 ${index >= 8 ? 'hidden' : ''}`}
                data-index={index}
              >
                <div class="relative">
                  {post.data.heroImage && (
                    <div class="aspect-video overflow-hidden">
                      <Image
                        src={post.data.heroImage}
                        alt={post.data.heroImageAlt || post.data.title}
                        width={300}
                        height={169}
                        class="w-full object-cover transition-transform duration-300 group-hover:scale-105"
                      />
                    </div>
                  )}
                  <div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent"></div>
                </div>
                
                <div class="p-5">
                  <div class="mb-2 flex items-center gap-2 text-xs text-neutral-500">
                    {post.data.pubDate && (
                      <time datetime={post.data.pubDate.toISOString()}>
                        {post.data.pubDate.toLocaleDateString('en-US', {
                          month: 'short',
                          year: 'numeric',
                        })}
                      </time>
                    )}
                    <span>•</span>
                    <span>{Math.ceil(post.body.length / 1000)} min</span>
                  </div>
                  
                  <h3 class="mb-2 text-base font-semibold leading-tight text-white group-hover:text-yellow-400 transition-colors">
                    <a href={`/blog/${post.slug}`} class="after:absolute after:inset-0">
                      {post.data.title}
                    </a>
                  </h3>
                  
                  <p class="text-sm text-neutral-400 line-clamp-2">
                    {post.data.description}
                  </p>
                </div>
              </article>
            ))}
          </div>
          
          {regularPosts.slice(6).length > 8 && (
            <div class="mt-12 text-center">
              <button 
                id="load-more-btn"
                class="inline-flex items-center gap-2 rounded-lg bg-neutral-700 px-6 py-3 text-sm font-medium text-white transition-all hover:bg-neutral-600 focus:outline-none focus:ring-2 focus:ring-yellow-400/20"
              >
                Load More Articles
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
            </div>
          )}
          
          <div id="end-message" class="mt-12 text-center hidden">
            <div class="inline-flex items-center gap-2 text-sm text-neutral-400">
              <div class="h-px w-8 bg-gradient-to-r from-transparent to-neutral-600"></div>
              <span>End of articles</span>
              <div class="h-px w-8 bg-gradient-to-l from-transparent to-neutral-600"></div>
            </div>
          </div>
        </div>
      </section>
    )}



    <!-- Newsletter CTA -->
    <section class="border-t border-neutral-800 bg-neutral-900/50 px-4 py-16 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-4xl text-center">
        <h2 class="text-3xl font-bold text-white">Stay in the Loop</h2>
        <p class="mt-4 text-lg text-neutral-400">
          Get the latest nomad insights delivered to your inbox weekly
        </p>
        <div class="mt-8 flex max-w-md mx-auto gap-4">
          <input 
            type="email" 
            placeholder="Enter your email"
            class="flex-1 rounded-lg border border-neutral-700 bg-neutral-800 px-4 py-3 text-white placeholder-neutral-400 focus:border-yellow-400 focus:outline-none focus:ring-2 focus:ring-yellow-400/20"
          />
          <button class="rounded-lg bg-yellow-400 px-6 py-3 font-bold text-black transition-all hover:bg-yellow-300">
            Subscribe
          </button>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const loadMoreBtn = document.getElementById('load-more-btn');
    const endMessage = document.getElementById('end-message');
    const archivePosts = document.querySelectorAll('.archive-post');
    
    let currentlyVisible = 8;
    const loadIncrement = 8;
    
    if (loadMoreBtn) {
      loadMoreBtn.addEventListener('click', function() {
        // Show next batch of posts
        for (let i = currentlyVisible; i < Math.min(currentlyVisible + loadIncrement, archivePosts.length); i++) {
          if (archivePosts[i]) {
            archivePosts[i].classList.remove('hidden');
          }
        }
        
        currentlyVisible += loadIncrement;
        
        // Hide button and show end message if all posts are visible
        if (currentlyVisible >= archivePosts.length) {
          loadMoreBtn.style.display = 'none';
          if (endMessage) {
            endMessage.classList.remove('hidden');
          }
        }
      });
    }
  });
</script>


