---
import { getCollection } from 'astro:content'
import BlogPostPage from '~/components/BlogPostPage.astro'
import { normalizeContentEntries } from '~/utils/content'

const slug = Astro.params.slug
const allPosts = normalizeContentEntries(await getCollection('blog'))
const post = allPosts.find((entry) => entry.slug === slug)

if (!post) {
  throw new Error(`Blog post not found for slug: ${slug}`)
}
---

<BlogPostPage post={post} allPosts={allPosts} />
