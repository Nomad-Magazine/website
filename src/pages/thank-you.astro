---
export const prerender = true;

import Layout, { type SEOProps } from '~/layouts/Layout.astro'

const seo: SEOProps = {
  title: 'Thank You - Check Your Email | Nomad Magazine',
  description: 'Thank you for downloading our free magazines. Check your email for the download link and password.',
}
---

<Layout seo={seo}>
  <div class="min-h-screen bg-gradient-to-b from-white to-gray-50 flex items-center justify-center px-4 py-12">
    <div class="max-w-2xl w-full">
      <div class="bg-white rounded-2xl shadow-xl p-8 sm:p-12 border border-gray-200">
        <div class="text-center">
          <div class="inline-block bg-yellow-400 rounded-full p-6 mb-6">
            <svg class="w-12 h-12 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
            </svg>
          </div>
          
          <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4">
            Check Your Email! 📧
          </h1>
          
          <p class="text-xl text-gray-700 mb-4">
            We've sent you the download link and password.
          </p>
          
          <p class="text-gray-600 mb-8">
            If you don't see it in a few minutes, check your spam folder. The email is coming from hey@nomad-magazine.com
          </p>

          <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-6 mb-8">
            <p class="text-sm font-semibold text-gray-900 mb-2">
              💡 While you wait...
            </p>
            <p class="text-sm text-gray-700">
              <a href="https://www.instagram.com/nomadmagazinecom?igsh=M3MyNWk4cmdjZWx5&utm_source=qr" target="_blank" rel="noopener noreferrer" class="text-gray-900 font-semibold hover:text-yellow-600 underline">Follow us on social media</a> to stay connected with the nomad community and get updates on new editions!
            </p>
          </div>

          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a
              href="/"
              class="inline-block rounded-lg bg-yellow-400 px-6 py-3 text-base font-bold text-black transition-all hover:bg-yellow-500 hover:scale-105"
            >
              Back to Home
            </a>
            <a
              href="/editions"
              class="inline-block rounded-lg border-2 border-gray-300 px-6 py-3 text-base font-bold text-gray-900 transition-all hover:border-gray-400 hover:bg-gray-50"
            >
              View All Editions
            </a>
          </div>
        </div>
      </div>

      <!-- Additional Info -->
      <div class="mt-12 text-center text-gray-600">
        <p class="mb-4">🎉 Welcome to the Nomad community!</p>
        <p class="text-sm">
          Want to support our work? <a href="/support-the-magazine" class="text-gray-900 font-semibold hover:text-yellow-600 underline">Become a supporter</a>
        </p>
      </div>
    </div>
  </div>
</Layout>

