---
import Layout, { type SEOProps } from '~/layouts/Layout.astro'
import { supabaseUrl, supabaseAnonKey } from '../utils/supabase'

// Topic categories for writers to choose from
const topicCategories = [
  {
    id: 'career',
    title: 'Career',
    description: 'Remote work opportunities, skill development, and professional growth for nomads',
    icon: '💼'
  },
  {
    id: 'finance',
    title: 'Finance',
    description: 'Tax planning, budgeting, investing, and financial strategies for nomads',
    icon: '💰'
  },
  {
    id: 'travel',
    title: 'Travel',
    description: 'Destinations, cultural insights, travel tips, and nomad-friendly locations',
    icon: '✈️'
  },
  {
    id: 'lifestyle',
    title: 'Lifestyle',
    description: 'Daily routines, personal development, relationships, and nomad life balance',
    icon: '🌟'
  },
  {
    id: 'business',
    title: 'Business',
    description: 'Entrepreneurship, team management, and building remote businesses',
    icon: '🚀'
  },
  {
    id: 'technology',
    title: 'Technology',
    description: 'Digital tools, productivity apps, and tech solutions for nomads',
    icon: '💻'
  },
  {
    id: 'health',
    title: 'Health',
    description: 'Physical and mental wellness, healthcare abroad, and staying healthy on the road',
    icon: '🏥'
  },
  {
    id: 'adventure',
    title: 'Adventure',
    description: 'Extreme sports, outdoor activities, and adventure travel experiences',
    icon: '🏔️'
  },
  {
    id: 'photography',
    title: 'Photography',
    description: 'Travel photography, visual storytelling, and creative documentation',
    icon: '📸'
  },
  {
    id: 'legal',
    title: 'Legal',
    description: 'Visa requirements, legal considerations, and compliance for digital nomads',
    icon: '⚖️'
  },
  {
    id: 'environment',
    title: 'Environment',
    description: 'Sustainable travel, eco-friendly nomadism, and environmental awareness',
    icon: '🌱'
  }
]

const supabaseConfig = {
  url: supabaseUrl,
  anonKey: supabaseAnonKey
}

const seo: SEOProps = {
  title: 'Write For Us - Nomad Magazine',
  description: 'Join Nomad Magazine as a writer. We pay €40 per article. Share your nomad expertise and stories with thousands of digital nomads worldwide.',
  image: `${Astro.site}images/edition-003-cover.webp`,
  keywords: 'nomad magazine writers, digital nomad articles, freelance writing, travel writing, remote work writing'
}
---

<Layout seo={seo}>
  <div class="bg-gradient-to-br from-gray-50 to-white">
    <!-- Hero Section -->
    <section class="relative overflow-hidden px-4 py-16 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-4xl text-center">
        <div class="mb-8">
          <span class="inline-block rounded-full bg-yellow-400 px-4 py-2 text-sm font-bold text-black uppercase tracking-wide">
            For Writers
          </span>
        </div>
        <h1 class="mb-6 text-4xl font-bold text-gray-900 sm:text-5xl lg:text-6xl">
          Write <span class="text-yellow-600">For Us</span>
        </h1>
        <p class="mx-auto mb-8 max-w-2xl text-xl text-gray-600">
          Share your nomad expertise and stories with thousands of digital nomads worldwide.
        </p>
      </div>
    </section>

    <!-- How It Works -->
    <section class="px-4 py-16 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-4xl">
        <div class="mb-12 text-center">
          <h2 class="mb-4 text-3xl font-bold text-gray-900">How It Works</h2>
          <p class="text-lg text-gray-600">Simple process from submission to publication</p>
        </div>

        <div class="space-y-8">
          <!-- Step 1 -->
          <div class="flex items-start gap-6">
            <div class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-yellow-400 text-black font-bold text-lg">
              1
                </div>
                <div>
              <h3 class="text-xl font-bold text-gray-900 mb-2">Submit Your Pitch</h3>
              <p class="text-gray-600">
                Send your pitch or article draft to <a href="mailto:editorial@nomadgossip.com" class="text-yellow-600 hover:text-yellow-700 font-medium">editorial@nomadgossip.com</a>. Don't worry if it's not perfect—we'll help you edit and polish it before publishing. Include photos if you have them!
              </p>
            </div>
          </div>

          <!-- Step 2 -->
          <div class="flex items-start gap-6">
            <div class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-yellow-400 text-black font-bold text-lg">
              2
            </div>
            <div>
              <h3 class="text-xl font-bold text-gray-900 mb-2">We Review & Edit</h3>
              <p class="text-gray-600">
                Our editorial team reviews your submission. If it's a good fit, we'll work with you to refine and polish it. We may approve or reject based on quality and relevance to our nomad community.
              </p>
            </div>
          </div>

          <!-- Step 3 -->
          <div class="flex items-start gap-6">
            <div class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-yellow-400 text-black font-bold text-lg">
              3
            </div>
            <div>
              <h3 class="text-xl font-bold text-gray-900 mb-2">Get Published & Paid</h3>
              <p class="text-gray-600">
                Once approved, we publish your article on our website with full attribution and your work reaches thousands of nomads worldwide.
              </p>
            </div>
          </div>
        </div>

        <!-- Important Notes -->
        <div class="mt-12 space-y-6">
          <div class="rounded-lg bg-blue-50 border border-blue-200 p-6">
            <h4 class="font-bold text-blue-900 mb-2">💡 For New Writers</h4>
            <p class="text-blue-800">
              We start with a website article to get familiar with your writing style. If you're a great writer with valuable expertise, we'll likely invite you to contribute to our print edition too!
            </p>
          </div>

          <div class="rounded-lg bg-amber-50 border border-amber-200 p-6">
            <h4 class="font-bold text-amber-900 mb-2">⚠️ No Direct Advertising</h4>
            <p class="text-amber-800">
              Articles can't include direct brand promotion. If you represent a brand and want visibility, submit to our <a href="/directory" class="underline hover:text-amber-900">Nomad Directory</a> or contact <a href="mailto:lera@nomadgossip.com" class="underline hover:text-amber-900">lera@nomadgossip.com</a> for brand placement options.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Topic Categories Section -->
    <section class="bg-gray-900 text-white px-4 py-16 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-6xl">
        <div class="mb-12 text-center">
          <h2 class="mb-4 text-3xl font-bold">Choose Your Topic Category</h2>
          <p class="text-lg text-gray-300">
            Select the category that best fits your article idea. Each category offers diverse opportunities for compelling nomad content.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="categories-grid">
          <!-- Categories will be populated by JavaScript -->
        </div>

        <div class="mt-12 text-center space-y-6">
          <p class="text-sm text-gray-400">
            Choose a category that matches your expertise and passion for creating compelling nomad content.
          </p>
          
          <!-- Action Buttons -->
          <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
            <button
              id="submit-article-btn"
              class="inline-flex items-center gap-2 rounded-lg bg-yellow-400 px-6 py-3 text-sm font-bold text-black transition-all hover:bg-yellow-300 hover:scale-105"
            >
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              Submit Your Article
            </button>
            
            <button
              id="suggest-topic-btn"
              class="inline-flex items-center gap-2 rounded-lg border-2 border-yellow-400 bg-transparent px-6 py-3 text-sm font-bold text-yellow-400 transition-all hover:bg-yellow-400 hover:text-black"
            >
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
              </svg>
              Suggest New Category
            </button>
          </div>
        </div>
      </div>
    </section>

    <!-- Proposed Topics Section -->
    <section class="px-4 py-16 sm:px-6 lg:px-8 bg-white">
      <div class="mx-auto max-w-6xl">
        <div class="mb-12 text-center">
          <h2 class="mb-4 text-3xl font-bold text-gray-900">Popular Topic Ideas</h2>
          <p class="text-lg text-gray-600">
            Need inspiration? Here are some trending topics our nomad community wants to read about
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
          <!-- Remote Work Topics -->
          <div class="rounded-lg bg-gradient-to-br from-blue-50 to-blue-100 border border-blue-200 p-8">
            <div class="flex items-center mb-6">
              <div class="h-12 w-12 rounded-full bg-blue-500 flex items-center justify-center mr-4">
                <svg class="h-6 w-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2-2v2m8 0H8m8 0v2a2 2 0 002 2h4a2 2 0 002-2V8a2 2 0 00-2-2h-4zm-8 0H8a2 2 0 00-2 2v2a2 2 0 002 2h4a2 2 0 002-2V8a2 2 0 00-2-2z"/>
                </svg>
              </div>
              <h3 class="text-2xl font-bold text-blue-900">Remote Work Topics</h3>
            </div>
            
            <ul class="space-y-3 text-blue-800">
              <li class="flex items-start">
                <span class="text-blue-500 mr-2">•</span>
                <span>How to negotiate remote work with traditional employers</span>
              </li>
              <li class="flex items-start">
                <span class="text-blue-500 mr-2">•</span>
                <span>Building a home office in different countries</span>
              </li>
              <li class="flex items-start">
                <span class="text-blue-500 mr-2">•</span>
                <span>Managing remote team dynamics across time zones</span>
              </li>
              <li class="flex items-start">
                <span class="text-blue-500 mr-2">•</span>
                <span>Finding reliable internet for remote work worldwide</span>
              </li>
              <li class="flex items-start">
                <span class="text-blue-500 mr-2">•</span>
                <span>Remote work productivity hacks from the road</span>
              </li>
              <li class="flex items-start">
                <span class="text-blue-500 mr-2">•</span>
                <span>Dealing with client communication while traveling</span>
              </li>
              <li class="flex items-start">
                <span class="text-blue-500 mr-2">•</span>
                <span>Best co-working spaces in specific cities/countries</span>
              </li>
              <li class="flex items-start">
                <span class="text-blue-500 mr-2">•</span>
                <span>Remote work tools that actually work for nomads</span>
              </li>
            </ul>
          </div>

          <!-- Online Business Topics -->
          <div class="rounded-lg bg-gradient-to-br from-purple-50 to-purple-100 border border-purple-200 p-8">
            <div class="flex items-center mb-6">
              <div class="h-12 w-12 rounded-full bg-purple-500 flex items-center justify-center mr-4">
                <svg class="h-6 w-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
                </svg>
              </div>
              <h3 class="text-2xl font-bold text-purple-900">Online Business Topics</h3>
            </div>
            
            <ul class="space-y-3 text-purple-800">
              <li class="flex items-start">
                <span class="text-purple-500 mr-2">•</span>
                <span>Starting a digital agency as a nomad</span>
              </li>
              <li class="flex items-start">
                <span class="text-purple-500 mr-2">•</span>
                <span>Scaling an online business while traveling</span>
              </li>
              <li class="flex items-start">
                <span class="text-purple-500 mr-2">•</span>
                <span>Legal considerations for international online businesses</span>
              </li>
              <li class="flex items-start">
                <span class="text-purple-500 mr-2">•</span>
                <span>E-commerce strategies for location-independent entrepreneurs</span>
              </li>
              <li class="flex items-start">
                <span class="text-purple-500 mr-2">•</span>
                <span>Building passive income streams on the road</span>
              </li>
              <li class="flex items-start">
                <span class="text-purple-500 mr-2">•</span>
                <span>Freelancing vs. starting your own online business</span>
              </li>
              <li class="flex items-start">
                <span class="text-purple-500 mr-2">•</span>
                <span>Hiring remote teams for your nomad business</span>
              </li>
              <li class="flex items-start">
                <span class="text-purple-500 mr-2">•</span>
                <span>From side hustle to full-time nomad income</span>
              </li>
            </ul>
          </div>
        </div>

        <div class="mt-8 text-center">
          <p class="text-gray-600 mb-6">
            Have experience with any of these topics? We'd love to hear your story and insights.
          </p>
          <a
            href="mailto:editorial@nomadgossip.com?subject=Article Pitch - Remote Work/Online Business&body=Hi! I'd like to pitch an article about remote work or online business.%0A%0AProposed topic:%0A%0AArticle summary/ideas:%0A%0AMy experience with this topic:%0A%0AAbout me:"
            class="inline-flex items-center gap-2 rounded-lg bg-gradient-to-r from-blue-500 to-purple-500 px-6 py-3 text-sm font-bold text-white transition-all hover:from-blue-600 hover:to-purple-600 hover:scale-105"
          >
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
            </svg>
            Pitch Your Article Idea
          </a>
        </div>
      </div>
    </section>

    <!-- Submission Guidelines -->
    <section class="px-4 py-16 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-4xl">
        <div class="mb-12 text-center">
          <h2 class="mb-4 text-3xl font-bold text-gray-900">What We're Looking For</h2>
          <p class="text-lg text-gray-600">Create compelling content that resonates with digital nomads</p>
        </div>

        <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
          <div class="rounded-lg bg-white p-6 shadow-md border border-gray-200">
            <div class="flex items-center mb-4">
              <div class="h-10 w-10 rounded-full bg-yellow-400 flex items-center justify-center mr-3">
                <span class="text-xl">📝</span>
              </div>
              <h3 class="text-lg font-bold text-gray-900">Personal Experience</h3>
            </div>
            <p class="text-gray-600">Share authentic stories from your nomad journey—real challenges, wins, and lessons learned</p>
          </div>

          <div class="rounded-lg bg-white p-6 shadow-md border border-gray-200">
            <div class="flex items-center mb-4">
              <div class="h-10 w-10 rounded-full bg-yellow-400 flex items-center justify-center mr-3">
                <span class="text-xl">🎓</span>
              </div>
              <h3 class="text-lg font-bold text-gray-900">Deep Expertise</h3>
            </div>
            <p class="text-gray-600">Bring specialized knowledge in your field—career, finance, travel, tech, or any nomad-relevant topic</p>
          </div>

          <div class="rounded-lg bg-white p-6 shadow-md border border-gray-200">
            <div class="flex items-center mb-4">
              <div class="h-10 w-10 rounded-full bg-yellow-400 flex items-center justify-center mr-3">
                <span class="text-xl">✍️</span>
              </div>
              <h3 class="text-lg font-bold text-gray-900">Original Writing</h3>
            </div>
            <p class="text-gray-600">We want your authentic voice, not AI-generated content. Real human insight makes all the difference</p>
          </div>

          <div class="rounded-lg bg-white p-6 shadow-md border border-gray-200">
            <div class="flex items-center mb-4">
              <div class="h-10 w-10 rounded-full bg-yellow-400 flex items-center justify-center mr-3">
                <span class="text-xl">✨</span>
              </div>
              <h3 class="text-lg font-bold text-gray-900">Engaging & Valuable</h3>
            </div>
            <p class="text-gray-600">Create stories that inspire, educate, and guide—whether it's practical tips, destination insights, or life-changing advice</p>
          </div>
        </div>

        <!-- Article Specs -->
        <div class="mt-12 rounded-lg bg-gray-50 border border-gray-200 p-8">
          <h3 class="text-xl font-bold text-gray-900 mb-6 text-center">Article Guidelines</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-center">
            <div>
              <div class="text-3xl font-bold text-yellow-600 mb-2">850-1,600</div>
              <div class="text-sm text-gray-600">Words (flexible)</div>
            </div>
            <div>
              <div class="text-3xl font-bold text-yellow-600 mb-2">Photos</div>
              <div class="text-sm text-gray-600">Include if you have them</div>
            </div>
          </div>
        </div>

        <!-- Call to Action -->
        <div class="mt-12 text-center">
          <div class="rounded-lg bg-gradient-to-r from-yellow-400 to-yellow-500 p-8 shadow-xl">
            <h3 class="mb-4 text-2xl font-bold text-black">Ready to Share Your Story?</h3>
            <p class="mb-6 text-black/80">
              Submit your pitch or article draft and join our community of nomad writers.
            </p>
            <a
              href="mailto:editorial@nomadgossip.com?subject=Article Submission&body=Hi! I'd like to submit a pitch or article for Nomad Magazine.%0A%0AProposed topic:%0A%0AArticle summary/ideas:%0A%0AAbout me:"
              class="inline-block rounded-lg bg-black px-8 py-4 text-lg font-bold text-yellow-400 transition-all hover:bg-gray-800 hover:scale-105"
            >
              Submit Your Article
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Why Write for Us -->
    <section class="bg-gray-50 px-4 py-16 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-6xl">
        <div class="mb-12 text-center">
          <h2 class="mb-4 text-3xl font-bold text-gray-900">Why Write for Nomad Magazine?</h2>
        </div>

        <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
          <div class="text-center">
            <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-yellow-400">
              <svg class="h-8 w-8 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
              </svg>
            </div>
            <h3 class="mb-2 text-xl font-bold text-gray-900">Global Reach</h3>
            <p class="text-gray-600">Your content reaches thousands of nomads across 50+ countries</p>
          </div>

          <div class="text-center">
            <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-yellow-400">
              <svg class="h-8 w-8 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
              </svg>
            </div>
            <h3 class="mb-2 text-xl font-bold text-gray-900">Premium Platform</h3>
            <p class="text-gray-600">High-quality print magazine with professional design and global distribution</p>
          </div>

          <div class="text-center">
            <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-yellow-400">
              <svg class="h-8 w-8 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>
              </svg>
            </div>
            <h3 class="mb-2 text-xl font-bold text-gray-900">Recognition & Exposure</h3>
            <p class="text-gray-600">Build your portfolio with premium publication and reach thousands of engaged nomads worldwide</p>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>

<script is:inline define:vars={{ supabaseConfig, topicCategories }}>
  
  function initializeApp() {
    renderCategories();
    setupEventListeners();
  }

  function renderCategories() {
    const grid = document.getElementById('categories-grid');
    if (!grid) return;

      const categoryColors = {
      'career': 'from-blue-500/20 to-blue-600/20 border-blue-500/30',
      'finance': 'from-green-500/20 to-green-600/20 border-green-500/30',
      'travel': 'from-orange-500/20 to-orange-600/20 border-orange-500/30',
      'lifestyle': 'from-pink-500/20 to-pink-600/20 border-pink-500/30',
      'business': 'from-purple-500/20 to-purple-600/20 border-purple-500/30',
      'technology': 'from-cyan-500/20 to-cyan-600/20 border-cyan-500/30',
      'health': 'from-red-500/20 to-red-600/20 border-red-500/30',
      'adventure': 'from-indigo-500/20 to-indigo-600/20 border-indigo-500/30',
      'photography': 'from-violet-500/20 to-violet-600/20 border-violet-500/30',
      'legal': 'from-teal-500/20 to-teal-600/20 border-teal-500/30',
      'environment': 'from-emerald-500/20 to-emerald-600/20 border-emerald-500/30'
    };

    grid.innerHTML = topicCategories.map(category => {
      const colorClass = categoryColors[category.id] || 'from-gray-500/20 to-gray-600/20 border-gray-500/30';

      return `
        <div class="group relative overflow-hidden rounded-xl bg-gradient-to-br ${colorClass} border p-6 transition-all hover:scale-105 hover:shadow-lg cursor-pointer"
             data-category-id="${category.id}"
             data-category-title="${category.title}">
          <div class="flex flex-col items-center text-center">
            <div class="text-4xl mb-4 group-hover:scale-110 transition-transform">
              ${category.icon}
            </div>
            <h3 class="text-xl font-bold text-white mb-3 group-hover:text-yellow-400 transition-colors">
              ${category.title}
            </h3>
            <p class="text-sm text-neutral-300 mb-4 leading-relaxed">
              ${category.description}
            </p>
            <button class="write-category-btn inline-flex items-center gap-2 rounded-lg bg-yellow-400 px-4 py-2 text-sm font-bold text-black transition-all hover:bg-yellow-300"
                    data-category-id="${category.id}"
                    data-category-title="${category.title}">
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/>
              </svg>
              Write Article
            </button>
          </div>
        </div>
      `;
    }).join('');
  }

  function setupEventListeners() {
    // Category selection and writing
    document.addEventListener('click', (e) => {
      if (e.target.closest('.write-category-btn')) {
        e.preventDefault();
        const button = e.target.closest('.write-category-btn');
        const categoryId = button.dataset.categoryId;
        const categoryTitle = button.dataset.categoryTitle;
        handleCategoryWrite(categoryId, categoryTitle);
      }
    });

    // Submit article button (general)
    document.getElementById('submit-article-btn')?.addEventListener('click', () => {
      const emailBody = `Hi! I'd like to submit a pitch or article for Nomad Magazine.%0A%0AProposed topic:%0A%0AArticle summary/ideas:%0A%0AAbout me:`;
      
      window.location.href = `mailto:editorial@nomadgossip.com?subject=Article Submission&body=${emailBody}`;
    });

    // Suggest new category button
    document.getElementById('suggest-topic-btn')?.addEventListener('click', () => {
      const emailBody = `Hi! I'd like to suggest a new category for writers.%0A%0AProposed category title:%0A%0ACategory description:%0A%0AWhy this category is important:%0A%0AExample article ideas:%0A%0AAbout me:`;
      
      window.location.href = `mailto:editorial@nomadgossip.com?subject=New Category Suggestion&body=${emailBody}`;
    });
  }

  function handleCategoryWrite(categoryId, categoryTitle) {
    const emailBody = `Hi! I'd like to submit a pitch or article for the "${categoryTitle}" category.%0A%0ACategory: ${categoryTitle}%0A%0AProposed article title:%0A%0AArticle summary/ideas:%0A%0AAbout me:`;
    
    window.location.href = `mailto:editorial@nomadgossip.com?subject=Article Submission - ${categoryTitle}&body=${emailBody}`;
  }

  // Initialize when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeApp);
  } else {
    initializeApp();
  }
</script>
</Layout>
