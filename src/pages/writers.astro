---
import Layout, { type SEOProps } from '~/layouts/Layout.astro'
import { supabaseUrl, supabaseAnonKey } from '../utils/supabase'

// Topic categories for writers to choose from
const topicCategories = [
  {
    id: 'career',
    title: 'Career',
    description: 'Remote work opportunities, skill development, and professional growth for nomads',
    icon: '💼'
  },
  {
    id: 'finance',
    title: 'Finance',
    description: 'Tax planning, budgeting, investing, and financial strategies for nomads',
    icon: '💰'
  },
  {
    id: 'travel',
    title: 'Travel',
    description: 'Destinations, cultural insights, travel tips, and nomad-friendly locations',
    icon: '✈️'
  },
  {
    id: 'lifestyle',
    title: 'Lifestyle',
    description: 'Daily routines, personal development, relationships, and nomad life balance',
    icon: '🌟'
  },
  {
    id: 'business',
    title: 'Business',
    description: 'Entrepreneurship, team management, and building remote businesses',
    icon: '🚀'
  },
  {
    id: 'technology',
    title: 'Technology',
    description: 'Digital tools, productivity apps, and tech solutions for nomads',
    icon: '💻'
  },
  {
    id: 'health',
    title: 'Health',
    description: 'Physical and mental wellness, healthcare abroad, and staying healthy on the road',
    icon: '🏥'
  },
  {
    id: 'adventure',
    title: 'Adventure',
    description: 'Extreme sports, outdoor activities, and adventure travel experiences',
    icon: '🏔️'
  },
  {
    id: 'photography',
    title: 'Photography',
    description: 'Travel photography, visual storytelling, and creative documentation',
    icon: '📸'
  },
  {
    id: 'legal',
    title: 'Legal',
    description: 'Visa requirements, legal considerations, and compliance for digital nomads',
    icon: '⚖️'
  },
  {
    id: 'environment',
    title: 'Environment',
    description: 'Sustainable travel, eco-friendly nomadism, and environmental awareness',
    icon: '🌱'
  }
]

const supabaseConfig = {
  url: supabaseUrl,
  anonKey: supabaseAnonKey
}

const seo: SEOProps = {
  title: 'Writers Collaboration - Nomad Magazine',
  description: 'Join Nomad Magazine as a writer. Learn about our collaboration process, from test articles to print publication.',
  image: `${Astro.site}images/edition-003-cover.webp`,
  keywords: 'nomad magazine writers, digital nomad articles, freelance writing, travel writing, remote work writing'
}
---

<Layout seo={seo}>
  <div class="bg-gradient-to-br from-gray-50 to-white">
    <!-- Hero Section -->
    <section class="relative overflow-hidden px-4 py-16 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-4xl text-center">
        <div class="mb-8">
          <span class="inline-block rounded-full bg-yellow-400 px-4 py-2 text-sm font-bold text-black uppercase tracking-wide">
            For Writers
          </span>
        </div>
        <h1 class="mb-6 text-4xl font-bold text-gray-900 sm:text-5xl lg:text-6xl">
          Write for the World's First <span class="text-yellow-600">Global Digital Nomad Magazine</span>
        </h1>
        <p class="mx-auto mb-8 max-w-2xl text-xl text-gray-600">
          Start with fast online publication, then get selected for our prestigious print edition. Build your reputation step by step.
        </p>
      </div>
    </section>

    <!-- Collaboration Flow -->
    <section class="px-4 py-16 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-6xl">
        <div class="mb-12 text-center">
          <h2 class="mb-4 text-3xl font-bold text-gray-900">Your Writer Journey</h2>
          <p class="text-lg text-gray-600">From fast online publication to prestigious print selection</p>
        </div>

        <!-- Flow Steps -->
        <div class="relative">
          <!-- Connection Line -->
          <div class="absolute left-1/2 top-0 hidden h-full w-0.5 -translate-x-0.5 transform bg-gradient-to-b from-yellow-400 to-yellow-600 lg:block"></div>
          
          <div class="space-y-12">
            <!-- Step 1: Test Article -->
            <div class="relative lg:flex lg:items-center">
              <div class="lg:w-1/2 lg:pr-12">
                <div class="flex items-center mb-4">
                  <div class="flex h-12 w-12 items-center justify-center rounded-full bg-yellow-400 text-black font-bold text-lg mr-4 lg:mr-0 lg:absolute lg:left-1/2 lg:-translate-x-1/2 lg:z-10">
                    1
                  </div>
                  <h3 class="text-2xl font-bold text-gray-900 lg:hidden">Website Publication First</h3>
                </div>
                <div class="lg:text-right">
                  <h3 class="hidden lg:block text-2xl font-bold text-gray-900 mb-4">Website Publication First</h3>
                  <p class="text-gray-600 mb-4">
                    Get published online faster. Build your presence and get discovered by AI tools like ChatGPT.
                  </p>
                  <ul class="space-y-2 text-sm text-gray-500">
                    <li>• Published in weeks not months.</li>
                    <li>• Full author attribution</li>
                    <li>• AI & search engine indexed</li>
                  </ul>
                </div>
              </div>
              <div class="mt-6 lg:mt-0 lg:w-1/2 lg:pl-12">
                <div class="rounded-lg bg-white p-6 shadow-lg border border-gray-200">
                  <div class="flex items-center mb-4">
                    <div class="h-3 w-3 rounded-full bg-green-500 mr-2"></div>
                    <span class="text-sm font-medium text-gray-600">FAST & VISIBLE</span>
                  </div>
                  <p class="text-gray-700">
                    <strong>Quick wins:</strong> Fast online visibility, Instagram promotion to 3,500+ followers, AI-searchable content.
                  </p>
                </div>
              </div>
            </div>

            <!-- Step 2: Selection Process -->
            <div class="relative lg:flex lg:items-center lg:flex-row-reverse">
              <div class="lg:w-1/2 lg:pl-12">
                <div class="flex items-center mb-4">
                  <div class="flex h-12 w-12 items-center justify-center rounded-full bg-yellow-400 text-black font-bold text-lg mr-4 lg:mr-0 lg:absolute lg:left-1/2 lg:-translate-x-1/2 lg:z-10">
                    2
                  </div>
                  <h3 class="text-2xl font-bold text-gray-900 lg:hidden">Print Selection Process</h3>
                </div>
                <div>
                  <h3 class="hidden lg:block text-2xl font-bold text-gray-900 mb-4">Print Selection Process</h3>
                  <p class="text-gray-600 mb-4">
                    Top website writers get invited for print. Expand your article or write something new.
                  </p>
                  <div class="bg-amber-50 border border-amber-200 rounded-lg p-4">
                    <p class="text-sm text-amber-800">
                      <strong>Exclusive:</strong> Only 12-15 articles per edition. Slower (2-3 months) but maximum prestige.
                    </p>
                  </div>
                </div>
              </div>
              <div class="mt-6 lg:mt-0 lg:w-1/2 lg:pr-12">
                <div class="rounded-lg bg-white p-6 shadow-lg border border-gray-200">
                  <div class="flex items-center mb-4">
                    <div class="h-3 w-3 rounded-full bg-purple-500 mr-2"></div>
                    <span class="text-sm font-medium text-gray-600">INVITATION ONLY</span>
                  </div>
                  <p class="text-gray-700">
                    <strong>Invitation only:</strong> High printing costs mean we only select articles that deliver exceptional value nomads will pay for.
                  </p>
                </div>
              </div>
            </div>

            <!-- Step 3: Print Publication -->
            <div class="relative lg:flex lg:items-center">
              <div class="lg:w-1/2 lg:pr-12">
                <div class="flex items-center mb-4">
                  <div class="flex h-12 w-12 items-center justify-center rounded-full bg-yellow-400 text-black font-bold text-lg mr-4 lg:mr-0 lg:absolute lg:left-1/2 lg:-translate-x-1/2 lg:z-10">
                    3
                  </div>
                  <h3 class="text-2xl font-bold text-gray-900 lg:hidden">Premium Print Status</h3>
                </div>
                <div class="lg:text-right">
                  <h3 class="hidden lg:block text-2xl font-bold text-gray-900 mb-4">Premium Print Status</h3>
                  <p class="text-gray-600 mb-4">
                    Maximum prestige. Your work becomes part of nomad history.
                  </p>
                  <ul class="space-y-2 text-sm text-gray-500">
                    <li>• Elite industry recognition</li>
                    <li>• Global distribution</li>
                    <li>• Permanent legacy</li>
                  </ul>
                </div>
              </div>
              <div class="mt-6 lg:mt-0 lg:w-1/2 lg:pl-12">
                <div class="rounded-lg bg-gradient-to-br from-yellow-50 to-yellow-100 p-6 shadow-lg border border-yellow-200">
                  <div class="flex items-center mb-4">
                    <div class="h-3 w-3 rounded-full bg-yellow-500 mr-2"></div>
                    <span class="text-sm font-medium text-yellow-700">MAXIMUM PRESTIGE</span>
                  </div>
                  <p class="text-yellow-800 font-medium">
                    <strong>Ultimate recognition:</strong> Elite circle of print writers. Maximum credibility and lasting impact.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Website vs Print Comparison -->
    <section class="bg-gradient-to-r from-gray-50 to-white px-4 py-16 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-6xl">
        <div class="mb-12 text-center">
          <h2 class="mb-4 text-3xl font-bold text-gray-900">Website vs Print: Choose Your Path</h2>
          <p class="text-lg text-gray-600">Two different benefits for different goals</p>
        </div>

        <div class="grid grid-cols-1 gap-8 lg:grid-cols-2">
          <!-- Website Publication -->
          <div class="rounded-2xl bg-white p-8 shadow-lg border-2 border-green-200">
            <div class="mb-6 text-center">
              <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-green-500">
                <svg class="h-8 w-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                </svg>
              </div>
              <h3 class="text-2xl font-bold text-gray-900">Website Publication</h3>
              <p class="text-green-600 font-medium">Fast & Discoverable</p>
            </div>
            
            <div class="space-y-4">
              <div class="flex items-center">
                <div class="h-2 w-2 rounded-full bg-green-500 mr-3"></div>
                <span class="text-gray-700"><strong>Speed:</strong> Published in weeks not months.</span>
              </div>
              <div class="flex items-center">
                <div class="h-2 w-2 rounded-full bg-green-500 mr-3"></div>
                <span class="text-gray-700"><strong>AI Discovery:</strong> Indexed by ChatGPT & search engines</span>
              </div>
              <div class="flex items-center">
                <div class="h-2 w-2 rounded-full bg-green-500 mr-3"></div>
                <span class="text-gray-700"><strong>Reach:</strong> Immediate global online audience</span>
              </div>
              <div class="flex items-center">
                <div class="h-2 w-2 rounded-full bg-green-500 mr-3"></div>
                <span class="text-gray-700"><strong>Social:</strong> Instagram promotion to 3,500+ followers</span>
              </div>
              <div class="flex items-center">
                <div class="h-2 w-2 rounded-full bg-green-500 mr-3"></div>
                <span class="text-gray-700"><strong>Portfolio:</strong> Build online writing presence</span>
              </div>
            </div>
          </div>

          <!-- Print Publication -->
          <div class="rounded-2xl bg-gradient-to-br from-yellow-50 to-yellow-100 p-8 shadow-lg border-2 border-yellow-300">
            <div class="mb-6 text-center">
              <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-yellow-500">
                <svg class="h-8 w-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>
                </svg>
              </div>
              <h3 class="text-2xl font-bold text-gray-900">Print Publication</h3>
              <p class="text-yellow-700 font-medium">Prestigious & Exclusive</p>
            </div>
            
            <div class="space-y-4">
              <div class="flex items-center">
                <div class="h-2 w-2 rounded-full bg-yellow-500 mr-3"></div>
                <span class="text-gray-700"><strong>Timeline:</strong> Each 6 months (invitation only)</span>
              </div>
              <div class="flex items-center">
                <div class="h-2 w-2 rounded-full bg-yellow-500 mr-3"></div>
                <span class="text-gray-700"><strong>Exclusivity:</strong> Only 12-15 articles per edition</span>
              </div>
              <div class="flex items-center">
                <div class="h-2 w-2 rounded-full bg-yellow-500 mr-3"></div>
                <span class="text-gray-700"><strong>Status:</strong> Elite industry recognition</span>
              </div>
              <div class="flex items-center">
                <div class="h-2 w-2 rounded-full bg-yellow-500 mr-3"></div>
                <span class="text-gray-700"><strong>Distribution:</strong> Global nomad hubs & communities</span>
              </div>
              <div class="flex items-center">
                <div class="h-2 w-2 rounded-full bg-yellow-500 mr-3"></div>
                <span class="text-gray-700"><strong>Legacy:</strong> Permanent archive & collector's item</span>
              </div>
            </div>
          </div>
        </div>

        <div class="mt-12 text-center">
          <div class="rounded-lg bg-blue-50 border border-blue-200 p-6">
            <p class="text-blue-800">
              <strong>Pro Tip:</strong> Start with website publication to build your reputation, then get invited for print based on your article performance and engagement.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Topic Categories Section -->
    <section class="bg-gray-900 text-white px-4 py-16 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-6xl">
        <div class="mb-12 text-center">
          <h2 class="mb-4 text-3xl font-bold">Choose Your Topic Category</h2>
          <p class="text-lg text-gray-300">
            Select the category that best fits your article idea. Each category offers diverse opportunities for compelling nomad content.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="categories-grid">
          <!-- Categories will be populated by JavaScript -->
        </div>

        <div class="mt-12 text-center space-y-6">
          <p class="text-sm text-gray-400">
            Choose a category that matches your expertise and passion for creating compelling nomad content.
          </p>
          
          <!-- Action Buttons -->
          <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
            <button
              id="submit-article-btn"
              class="inline-flex items-center gap-2 rounded-lg bg-yellow-400 px-6 py-3 text-sm font-bold text-black transition-all hover:bg-yellow-300 hover:scale-105"
            >
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              Submit Your Article
            </button>
            
            <button
              id="suggest-topic-btn"
              class="inline-flex items-center gap-2 rounded-lg border-2 border-yellow-400 bg-transparent px-6 py-3 text-sm font-bold text-yellow-400 transition-all hover:bg-yellow-400 hover:text-black"
            >
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
              </svg>
              Suggest New Category
            </button>
          </div>
        </div>
      </div>
    </section>

    <!-- Submission Guidelines -->
    <section class="px-4 py-16 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-4xl">
        <div class="mb-12 text-center">
          <h2 class="mb-4 text-3xl font-bold text-gray-900">Submission Guidelines</h2>
          <p class="text-lg text-gray-600">Everything you need to know before submitting</p>
        </div>

        <div class="grid grid-cols-1 gap-8 lg:grid-cols-2">
          <!-- What We're Looking For -->
          <div class="rounded-lg bg-white p-8 shadow-lg border border-gray-200">
            <h3 class="mb-6 text-xl font-bold text-gray-900">What We're Looking For</h3>
            <ul class="space-y-3 text-gray-600">
              <li class="flex items-start">
                <span class="mr-3 mt-1 h-2 w-2 rounded-full bg-yellow-400"></span>
                <span><strong>Personal experiences</strong> - Real stories from your nomad journey</span>
              </li>
              <li class="flex items-start">
                <span class="mr-3 mt-1 h-2 w-2 rounded-full bg-yellow-400"></span>
                <span><strong>Practical advice</strong> - Actionable tips and insights</span>
              </li>
              <li class="flex items-start">
                <span class="mr-3 mt-1 h-2 w-2 rounded-full bg-yellow-400"></span>
                <span><strong>Unique perspectives</strong> - Fresh takes on nomad challenges</span>
              </li>
              <li class="flex items-start">
                <span class="mr-3 mt-1 h-2 w-2 rounded-full bg-yellow-400"></span>
                <span><strong>Well-researched content</strong> - Backed by facts and data</span>
              </li>
              <li class="flex items-start">
                <span class="mr-3 mt-1 h-2 w-2 rounded-full bg-yellow-400"></span>
                <span><strong>Engaging storytelling</strong> - Captivating narrative style</span>
              </li>
            </ul>
          </div>

          <!-- Technical Requirements -->
          <div class="rounded-lg bg-white p-8 shadow-lg border border-gray-200">
            <h3 class="mb-6 text-xl font-bold text-gray-900">Technical Requirements</h3>
            <ul class="space-y-3 text-gray-600">
              <li class="flex items-start">
                <span class="mr-3 mt-1 h-2 w-2 rounded-full bg-blue-400"></span>
                <span><strong>Word count:</strong> 800-1,200 words for test articles</span>
              </li>
              <li class="flex items-start">
                <span class="mr-3 mt-1 h-2 w-2 rounded-full bg-blue-400"></span>
                <span><strong>Format:</strong> Google Docs preferred</span>
              </li>
              <li class="flex items-start">
                <span class="mr-3 mt-1 h-2 w-2 rounded-full bg-blue-400"></span>
                <span><strong>Images:</strong> High-resolution (min. 1200px wide)</span>
              </li>
              <li class="flex items-start">
                <span class="mr-3 mt-1 h-2 w-2 rounded-full bg-blue-400"></span>
                <span><strong>Bio:</strong> 50-100 word author bio with photo</span>
              </li>
              <li class="flex items-start">
                <span class="mr-3 mt-1 h-2 w-2 rounded-full bg-blue-400"></span>
                <span><strong>Rights:</strong> First publication rights only</span>
              </li>
            </ul>
          </div>
        </div>

        <!-- Call to Action -->
        <div class="mt-12 text-center">
          <div class="rounded-lg bg-gradient-to-r from-yellow-400 to-yellow-500 p-8 shadow-xl">
            <h3 class="mb-4 text-2xl font-bold text-black">Ready to Submit Your Test Article?</h3>
            <p class="mb-6 text-black/80">
              Send us your best work and join our growing community of nomad writers.
            </p>
            <a
              href="mailto:editorial@nomadgossip.com?subject=Article Submission&body=Hi! I'd like to submit an article for Nomad Magazine.%0A%0AProposed topic:%0A%0AArticle summary:%0A%0AAbout me:"
              class="inline-block rounded-lg bg-black px-8 py-4 text-lg font-bold text-yellow-400 transition-all hover:bg-gray-800 hover:scale-105"
            >
              Submit Your Article
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Why Write for Us -->
    <section class="bg-gray-50 px-4 py-16 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-6xl">
        <div class="mb-12 text-center">
          <h2 class="mb-4 text-3xl font-bold text-gray-900">Why Write for Nomad Magazine?</h2>
        </div>

        <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
          <div class="text-center">
            <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-yellow-400">
              <svg class="h-8 w-8 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
              </svg>
            </div>
            <h3 class="mb-2 text-xl font-bold text-gray-900">Global Reach</h3>
            <p class="text-gray-600">Your content reaches thousands of nomads across 50+ countries</p>
          </div>

          <div class="text-center">
            <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-yellow-400">
              <svg class="h-8 w-8 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
              </svg>
            </div>
            <h3 class="mb-2 text-xl font-bold text-gray-900">Premium Platform</h3>
            <p class="text-gray-600">High-quality print magazine with professional design and global distribution</p>
          </div>

          <div class="text-center">
            <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-yellow-400">
              <svg class="h-8 w-8 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>
              </svg>
            </div>
            <h3 class="mb-2 text-xl font-bold text-gray-900">Recognition & Exposure</h3>
            <p class="text-gray-600">Build your portfolio with premium publication and reach thousands of engaged nomads worldwide</p>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>

<script is:inline define:vars={{ supabaseConfig, topicCategories }}>
  
  function initializeApp() {
    renderCategories();
    setupEventListeners();
  }

  function renderCategories() {
    const grid = document.getElementById('categories-grid');
    if (!grid) return;

      const categoryColors = {
      'career': 'from-blue-500/20 to-blue-600/20 border-blue-500/30',
      'finance': 'from-green-500/20 to-green-600/20 border-green-500/30',
      'travel': 'from-orange-500/20 to-orange-600/20 border-orange-500/30',
      'lifestyle': 'from-pink-500/20 to-pink-600/20 border-pink-500/30',
      'business': 'from-purple-500/20 to-purple-600/20 border-purple-500/30',
      'technology': 'from-cyan-500/20 to-cyan-600/20 border-cyan-500/30',
      'health': 'from-red-500/20 to-red-600/20 border-red-500/30',
      'adventure': 'from-indigo-500/20 to-indigo-600/20 border-indigo-500/30',
      'photography': 'from-violet-500/20 to-violet-600/20 border-violet-500/30',
      'legal': 'from-teal-500/20 to-teal-600/20 border-teal-500/30',
      'environment': 'from-emerald-500/20 to-emerald-600/20 border-emerald-500/30'
    };

    grid.innerHTML = topicCategories.map(category => {
      const colorClass = categoryColors[category.id] || 'from-gray-500/20 to-gray-600/20 border-gray-500/30';

      return `
        <div class="group relative overflow-hidden rounded-xl bg-gradient-to-br ${colorClass} border p-6 transition-all hover:scale-105 hover:shadow-lg cursor-pointer"
             data-category-id="${category.id}"
             data-category-title="${category.title}">
          <div class="flex flex-col items-center text-center">
            <div class="text-4xl mb-4 group-hover:scale-110 transition-transform">
              ${category.icon}
            </div>
            <h3 class="text-xl font-bold text-white mb-3 group-hover:text-yellow-400 transition-colors">
              ${category.title}
            </h3>
            <p class="text-sm text-neutral-300 mb-4 leading-relaxed">
              ${category.description}
            </p>
            <button class="write-category-btn inline-flex items-center gap-2 rounded-lg bg-yellow-400 px-4 py-2 text-sm font-bold text-black transition-all hover:bg-yellow-300"
                    data-category-id="${category.id}"
                    data-category-title="${category.title}">
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/>
              </svg>
              Write Article
            </button>
          </div>
        </div>
      `;
    }).join('');
  }

  function setupEventListeners() {
    // Category selection and writing
    document.addEventListener('click', (e) => {
      if (e.target.closest('.write-category-btn')) {
        e.preventDefault();
        const button = e.target.closest('.write-category-btn');
        const categoryId = button.dataset.categoryId;
        const categoryTitle = button.dataset.categoryTitle;
        handleCategoryWrite(categoryId, categoryTitle);
      }
    });

    // Submit article button (general)
    document.getElementById('submit-article-btn')?.addEventListener('click', () => {
      const categoriesList = topicCategories
        .map(category => `• ${category.title} - ${category.description}`)
        .join('%0A');
      
      const emailBody = `Hi! I'd like to submit an article for Nomad Magazine.%0A%0AAvailable categories:%0A${categoriesList}%0A%0ASelected category:%0A%0AProposed article title:%0A%0AArticle summary:%0A%0AAbout me:%0A%0AEstimated delivery date:`;
      
      window.location.href = `mailto:editorial@nomadgossip.com?subject=Article Submission&body=${emailBody}`;
    });

    // Suggest new category button
    document.getElementById('suggest-topic-btn')?.addEventListener('click', () => {
      const emailBody = `Hi! I'd like to suggest a new category for writers.%0A%0AProposed category title:%0A%0ACategory description:%0A%0AWhy this category is important:%0A%0AExample article ideas:%0A%0AAbout me:`;
      
      window.location.href = `mailto:editorial@nomadgossip.com?subject=New Category Suggestion&body=${emailBody}`;
    });
  }

  function handleCategoryWrite(categoryId, categoryTitle) {
    console.log(`Category write: User wants to write about "${categoryTitle}" (ID: ${categoryId})`);
    
    const emailBody = `Hi! I'd like to write an article for the "${categoryTitle}" category.%0A%0ACategory: ${categoryTitle}%0A%0AProposed article title:%0A%0AArticle summary:%0A%0AMy approach/angle:%0A%0AAbout me:%0A%0AEstimated delivery date:%0A%0APortfolio/writing samples:`;
    
    window.location.href = `mailto:editorial@nomadgossip.com?subject=Article Submission: ${categoryTitle}&body=${emailBody}`;
  }

  // Initialize when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeApp);
  } else {
    initializeApp();
  }
</script>
</Layout>
