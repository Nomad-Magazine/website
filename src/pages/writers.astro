<script is:inline define:vars={{ supabaseConfig, topicSuggestions }}>
  let supabase;
  let userFingerprint;
  let userVotes = new Set();
  let isSignedIn = false;
  let signingIn = false;

  // Generate browser fingerprint
  function generateFingerprint() {
    const canvas = document.createElement('canvas');
    const ctx = canvas.getContext('2d');
    ctx.textBaseline = 'top';
    ctx.font = '14px Arial';
    ctx.fillText('Fingerprint', 2, 2);
    
    const fingerprint = [
      navigator.userAgent,
      navigator.language,
      screen.width + 'x' + screen.height,
      new Date().getTimezoneOffset(),
      canvas.toDataURL()
    ].join('|');
    
    return btoa(fingerprint).slice(0, 32);
  }

  // Initialize Supabase client
  function initializeSupabase() {
    const script = document.createElement('script');
    script.src = 'https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.js';
    script.onload = initializeApp;
    document.head.appendChild(script);
  }

  async function initializeApp() {
    supabase = window.supabase.createClient(supabaseConfig.url, supabaseConfig.anonKey);
    userFingerprint = generateFingerprint();
    
    await loadTopicVotes();
    renderTopics();
    setupEventListeners();
  }

  async function loadTopicVotes() {
    try {
      // Load vote counts for all topics
      const { data: voteCounts, error: voteError } = await supabase
        .from('topic_vote_counts')
        .select('*');

      if (voteError && voteError.code !== 'PGRST116') {
        console.warn('Vote counts error:', voteError);
      }

      // Load user votes
      const { data: userVoteData, error: userVoteError } = await supabase
        .from('topic_votes')
        .select('topic_id')
        .eq('user_fingerprint', userFingerprint);

      if (!userVoteError && userVoteData) {
        userVotes = new Set(userVoteData.map(vote => vote.topic_id));
      }

      // Add vote counts to topics
      topicSuggestions.forEach(topic => {
        topic.vote_count = voteCounts?.find(vc => vc.topic_id === topic.id)?.vote_count || 0;
      });

    } catch (error) {
      console.warn('Error loading topic votes:', error);
    }
  }

  function renderTopics() {
    const grid = document.getElementById('topics-grid');
    if (!grid) return;

    // Sort topics by vote count (highest first)
    const sortedTopics = [...topicSuggestions].sort((a, b) => (b.vote_count || 0) - (a.vote_count || 0));

    grid.innerHTML = sortedTopics.map(topic => {
      const isVoted = userVotes.has(topic.id);
      const categoryColors = {
        'Wellness': 'bg-green-500/20 text-green-300',
        'Legal': 'bg-blue-500/20 text-blue-300',
        'Environment': 'bg-emerald-500/20 text-emerald-300',
        'Finance': 'bg-yellow-500/20 text-yellow-300',
        'Business': 'bg-purple-500/20 text-purple-300',
        'Health': 'bg-red-500/20 text-red-300',
        'Travel': 'bg-orange-500/20 text-orange-300',
        'Lifestyle': 'bg-pink-500/20 text-pink-300',
        'Technology': 'bg-cyan-500/20 text-cyan-300',
        'Photography': 'bg-indigo-500/20 text-indigo-300',
        'Career': 'bg-violet-500/20 text-violet-300'
      };

      return `
        <div class="group relative overflow-hidden rounded-xl bg-neutral-800/50 p-6 transition-all hover:bg-neutral-800/80 flex items-center justify-between">
          <div class="flex items-center gap-6 flex-1">
            <div class="flex items-center gap-3">
              <span class="inline-block rounded-full px-3 py-1 text-xs font-bold ${categoryColors[topic.category] || 'bg-gray-500/20 text-gray-300'}">
                ${topic.category}
              </span>
              <h3 class="text-lg font-bold text-white group-hover:text-yellow-400 transition-colors">
                ${topic.title}
              </h3>
            </div>
            <p class="text-sm text-neutral-300 flex-1 max-w-md">
              ${topic.description}
            </p>
          </div>
          
          <div class="flex items-center gap-3 flex-shrink-0">
            <button 
              class="claim-btn flex items-center gap-2 rounded-full px-3 py-1.5 text-xs font-medium bg-neutral-700 text-neutral-300 hover:bg-green-500 hover:text-white transition-all"
              data-topic-id="${topic.id}"
              data-topic-title="${topic.title}"
              title="Write about this topic"
            >
              <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/>
              </svg>
              Write
            </button>
            
            <button 
              class="vote-btn flex items-center gap-2 rounded-full px-4 py-2 text-sm font-medium transition-all ${
                isVoted 
                  ? 'bg-yellow-400 text-black' 
                  : 'bg-neutral-700 text-neutral-300 hover:bg-yellow-400 hover:text-black'
              }"
              data-topic-id="${topic.id}"
            >
              <svg class="h-4 w-4 ${isVoted ? 'fill-current' : ''}" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
              </svg>
              <span class="vote-count">${topic.vote_count || 0}</span>
            </button>
          </div>
        </div>
      `;
    }).join('');
  }

  function setupEventListeners() {
    // Topic voting and claiming
    document.addEventListener('click', async (e) => {
      if (e.target.closest('.vote-btn')) {
        e.preventDefault();
        const button = e.target.closest('.vote-btn');
        const topicId = button.dataset.topicId;
        await handleTopicVote(topicId, button);
      }
      
      if (e.target.closest('.claim-btn')) {
        e.preventDefault();
        const button = e.target.closest('.claim-btn');
        const topicId = button.dataset.topicId;
        const topicTitle = button.dataset.topicTitle;
        handleTopicClaim(topicId, topicTitle);
      }
    });

    // Claim topic button (general)
    document.getElementById('claim-topic-btn')?.addEventListener('click', () => {
      const topTopics = [...topicSuggestions]
        .sort((a, b) => (b.vote_count || 0) - (a.vote_count || 0))
        .slice(0, 5)
        .map(topic => `• ${topic.title} (${topic.vote_count || 0} votes)`)
        .join('%0A');
      
      const emailBody = `Hi! I'd like to claim one of the popular topics for my test article submission.%0A%0ATop voted topics:%0A${topTopics}%0A%0AI want to write about:%0A%0AProposed angle/approach:%0A%0AAbout me:%0A%0AEstimated delivery date:`;
      
      window.location.href = `mailto:hey@nomadgossip.com?subject=Article Submission&body=${emailBody}`;
    });

    // Suggest new topic button
    document.getElementById('suggest-topic-btn')?.addEventListener('click', () => {
      const emailBody = `Hi! I'd like to suggest a new topic for the community to vote on.%0A%0AProposed topic title:%0A%0ATopic description:%0A%0ACategory (Wellness, Legal, Finance, etc.):%0A%0AWhy this topic is important:%0A%0AAbout me:`;
      
      window.location.href = `mailto:hey@nomadgossip.com?subject=New Topic Suggestion&body=${emailBody}`;
    });
  }

  function handleTopicClaim(topicId, topicTitle) {
    console.log(`Topic claim: User wants to claim "${topicTitle}" (ID: ${topicId})`);
    
    const emailBody = `Hi! I'd like to claim the topic "${topicTitle}" for my test article submission.%0A%0ATopic: ${topicTitle}%0A%0AMy proposed angle/approach:%0A%0AAbout me:%0A%0AEstimated delivery date:%0A%0APortfolio/writing samples:`;
    
    window.location.href = `mailto:hey@nomadgossip.com?subject=Article Submission: ${topicTitle}&body=${emailBody}`;
  }

  async function ensureSignedIn() {
    if (isSignedIn) return true;
    if (signingIn) return false;
    
    signingIn = true;
    
    try {
      const { data: { user } } = await supabase.auth.getUser();
      if (user) {
        isSignedIn = true;
        signingIn = false;
        return true;
      }
      
      const { error: authError } = await supabase.auth.signInAnonymously();
      
      if (authError) {
        console.warn('Auth error:', authError);
        signingIn = false;
        return false;
      }
      
      isSignedIn = true;
      signingIn = false;
      return true;
    } catch (error) {
      console.warn('Error signing in:', error);
      signingIn = false;
      return false;
    }
  }

  async function handleTopicVote(topicId, button) {
    if (!await ensureSignedIn()) {
      console.log('Failed to sign in for voting');
      return;
    }

    try {
      const topic = topicSuggestions.find(t => t.id === topicId);
      const isVoted = userVotes.has(topicId);
      const voteCountSpan = button.querySelector('.vote-count');
      const heartIcon = button.querySelector('svg');
      
      console.log(`Topic vote action: ${isVoted ? 'removing' : 'adding'} vote for topic "${topic?.title}" (ID: ${topicId})`);
      
      if (isVoted) {
        // Remove vote
        console.log('Removing vote from database...');
        const { error } = await supabase
          .from('topic_votes')
          .delete()
          .eq('topic_id', topicId)
          .eq('user_fingerprint', userFingerprint);

        if (!error) {
          console.log('Vote removed successfully');
          userVotes.delete(topicId);
          button.classList.remove('bg-yellow-400', 'text-black');
          button.classList.add('bg-neutral-700', 'text-neutral-300', 'hover:bg-yellow-400', 'hover:text-black');
          heartIcon.classList.remove('fill-current');
          
          const currentCount = parseInt(voteCountSpan.textContent);
          voteCountSpan.textContent = Math.max(0, currentCount - 1);
          
          if (topic) topic.vote_count = Math.max(0, topic.vote_count - 1);
          
          // Re-render to update order
          setTimeout(() => renderTopics(), 300);
        } else {
          console.error('Error removing vote:', error);
        }
      } else {
        // Add vote
        console.log('Adding vote to database...');
        const { error } = await supabase
          .from('topic_votes')
          .insert({
            topic_id: topicId,
            user_fingerprint: userFingerprint
          });

        if (!error) {
          console.log('Vote added successfully');
          userVotes.add(topicId);
          button.classList.remove('bg-neutral-700', 'text-neutral-300', 'hover:bg-yellow-400', 'hover:text-black');
          button.classList.add('bg-yellow-400', 'text-black');
          heartIcon.classList.add('fill-current');
          
          const currentCount = parseInt(voteCountSpan.textContent);
          voteCountSpan.textContent = currentCount + 1;
          
          if (topic) topic.vote_count = (topic.vote_count || 0) + 1;
          
          // Re-render to update order
          setTimeout(() => renderTopics(), 300);
        } else {
          console.error('Error adding vote:', error);
        }
      }
    } catch (error) {
      console.error('Error handling topic vote:', error);
    }
  }

  // Initialize when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeSupabase);
  } else {
    initializeSupabase();
  }
</script>
</Layout>
