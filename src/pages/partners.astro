---
import Layout, { type SEOProps } from '~/layouts/Layout.astro'
import CheckIcon from '~icons/ic/baseline-check'
import ArrowRightIcon from '~icons/ic/baseline-arrow-forward'

const seo: SEOProps = {
  title: 'Join the Nomad Ecosystem - Automatic Partnership with Nomad Magazine',
  description: 'Welcome to the nomad ecosystem! If you\'re a digital nomad or part of the nomad community, you\'re automatically our partner. Access free features, Office Hours, and premium support options.',
  image: `${Astro.site}images/edition-001-nomad-mag-brand-placement.webp`,
  keywords: 'nomad ecosystem, digital nomad community, automatic partnership, nomad directory, office hours, nomad magazine',
  ogType: 'website',
  ldJSON: {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Join the Nomad Ecosystem',
    description: 'Automatic partnership opportunities with Nomad Magazine for the digital nomad community',
    url: `${Astro.site}partnerships-new`,
    publisher: {
      '@type': 'Organization',
      name: 'Nomad Magazine',
      logo: {
        '@type': 'ImageObject',
        url: `${Astro.site}logo.svg`,
      },
    },
  },
}

---

<Layout seo={seo}>
  <div class="bg-black text-white min-h-screen">
    <!-- Hero Section -->
    <section class="relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-br from-yellow-500/10 via-transparent to-purple-500/10"></div>
      <div class="relative mx-auto max-w-6xl px-6 py-24">
        <div class="text-center space-y-8">
          <div class="inline-block bg-yellow-400 text-black px-6 py-3 rounded-full font-bold text-lg">
            🤝 Partner with us
          </div>
          
          <h1 class="text-6xl md:text-8xl font-black leading-tight">
            You're already
            <br />
            <span class="text-yellow-400">our partner</span>
          </h1>
          
          <p class="text-2xl md:text-3xl text-gray-300 max-w-4xl mx-auto leading-relaxed">
            If you're a digital nomad or your project is part of the digital nomad ecosystem, you automatically become our partner. No need to reach out and say "let's partner".
          </p>

          <div class="pt-8">
            <a
              href="#how-it-works"
              class="inline-flex items-center gap-3 bg-yellow-400 text-black px-10 py-5 rounded-full text-xl font-bold hover:bg-yellow-300 transition-all hover:scale-105"
            >
              See how it works
              <ArrowRightIcon class="h-6 w-6" />
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- The Challenge -->
    <section class="py-20 bg-gray-950">
      <div class="mx-auto max-w-4xl px-6 text-center">
        <h2 class="text-4xl md:text-5xl font-bold mb-8">Here's the thing</h2>
        <div class="text-2xl text-gray-300 space-y-6 leading-relaxed">
          <p>
            We'd love to have individual conversations with everyone, but as a small team, our <strong class="text-white">time and capacity</strong> are naturally limited.
          </p>
          <p>
            So we've created something even better - a streamlined way to support everyone fairly.
          </p>
        </div>
      </div>
    </section>

    <!-- Partnership Options -->
    <section class="py-20 bg-gray-950">
      <div class="mx-auto max-w-6xl px-6">
        <div class="text-center mb-16">
          <h2 class="text-4xl md:text-5xl font-bold mb-8">How we can work together</h2>
          <p class="text-2xl text-gray-300">
            Choose the option that fits your goals
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-8 mb-12">
          <!-- Nomad Directory -->
          <div class="bg-gradient-to-br from-green-500/20 to-emerald-500/20 rounded-2xl p-8 border border-green-500/30 text-center h-full flex flex-col">
            <div class="text-4xl mb-4">📍</div>
            <h3 class="text-2xl font-bold mb-4">Nomad Directory</h3>
            <div class="text-4xl font-bold text-green-400 mb-6">FREE</div>
            <p class="text-gray-300 mb-8">
              Submit your project for free with or without exclusive offers
            </p>
            
            <div class="space-y-3 mb-8 text-left flex-grow">
              <div class="flex items-center">
                <CheckIcon class="mr-3 h-5 w-5 flex-shrink-0 text-green-400" />
                <span class="text-gray-300">Featured on Instagram & newsletter</span>
              </div>
              <div class="flex items-center">
                <CheckIcon class="mr-3 h-5 w-5 flex-shrink-0 text-green-400" />
                <span class="text-gray-300">Share announcements: hiring, acquisitions, co-founder search</span>
              </div>
              <div class="flex items-center">
                <CheckIcon class="mr-3 h-5 w-5 flex-shrink-0 text-green-400" />
                <span class="text-gray-300">No barter agreements</span>
              </div>
            </div>
            
            <a
              href="https://form.smartsuite.com/s4tmc086/8sFlvrVlDC"
              target="_blank"
              rel="noopener noreferrer"
              class="w-full inline-block bg-green-500 text-white px-6 py-3 rounded-lg font-bold hover:bg-green-400 transition-all hover:scale-105 mt-auto"
            >
              Submit to Directory
            </a>
          </div>
          <!-- Support the Magazine -->
          <div class="bg-gradient-to-br from-yellow-500/20 to-orange-500/20 rounded-2xl p-8 border border-yellow-500/30 text-center h-full flex flex-col">
            <div class="text-4xl mb-4">🤝</div>
            <h3 class="text-2xl font-bold mb-4">Support the Magazine</h3>
            <div class="text-4xl font-bold text-yellow-400 mb-6">€10<span class="text-sm text-gray-300">/month</span></div>
            <p class="text-gray-300 mb-8">
              Get your listing featured on top of the directory page
            </p>
            
            <div class="space-y-3 mb-8 text-left flex-grow">
              <div class="flex items-center">
                <CheckIcon class="mr-3 h-5 w-5 flex-shrink-0 text-yellow-400" />
                <span class="text-gray-300">♥ Supporter badge on listing</span>
              </div>
              <div class="flex items-center">
                <CheckIcon class="mr-3 h-5 w-5 flex-shrink-0 text-yellow-400" />
                <span class="text-gray-300">Listing on top of the page</span>
              </div>
              <div class="flex items-center">
                <CheckIcon class="mr-3 h-5 w-5 flex-shrink-0 text-yellow-400" />
                <span class="text-gray-300">Listing on a Home page</span>
              </div>
              <div class="flex items-center">
                <CheckIcon class="mr-3 h-5 w-5 flex-shrink-0 text-yellow-400" />
                <span class="text-gray-300">Support indie media</span>
              </div>
              <div class="flex items-center">
                <CheckIcon class="mr-3 h-5 w-5 flex-shrink-0 text-yellow-400" />
                <span class="text-gray-300">Good karma ✨</span>
              </div>
            </div>
            
            <a
              href="https://pay.nomad-magazine.com/b/fZubJ17Mh7zBbkG9G18bS0c"
              target="_blank"
              class="w-full inline-block bg-yellow-500 text-black px-6 py-3 rounded-lg font-bold hover:bg-yellow-400 transition-all hover:scale-105 mt-auto"
            >
              Become Supporter
            </a>
          </div>

          <!-- Print + Digital -->
          <div class="bg-gradient-to-br from-indigo-500/20 to-purple-500/20 rounded-2xl p-8 border border-indigo-500/30 text-center relative h-full flex flex-col">
            <div class="absolute -top-3 -right-3 bg-yellow-400 text-black px-3 py-1 rounded-full text-sm font-bold">
              BEST VALUE
            </div>
            <div class="text-4xl mb-4">📰</div>
            <h3 class="text-2xl font-bold mb-4">Digital + Print</h3>
            <div class="text-4xl font-bold text-indigo-400 mb-6">€350+</div>
            <p class="text-gray-300 mb-8">
              Brand placement in our next magazine edition
            </p>
            
            <div class="space-y-3 mb-8 text-left flex-grow">
              
              <div class="flex items-center">
                <CheckIcon class="mr-3 h-5 w-5 flex-shrink-0 text-indigo-400" />
                <span class="text-gray-300">Brand placement in next magazine edition (print + digital)</span>
              </div>
              <div class="flex items-center">
                <CheckIcon class="mr-3 h-5 w-5 flex-shrink-0 text-indigo-400" />
                <span class="text-gray-300">Reach thousands of nomads globally</span>
              </div>
              <div class="flex items-center">
                <CheckIcon class="mr-3 h-5 w-5 flex-shrink-0 text-indigo-400" />
                <span class="text-gray-300">Print + digital distribution</span>
              </div>
            </div>
            
            <a
              href="/brand-placement-next-edition-847291"
              class="w-full inline-block bg-indigo-500 text-white px-6 py-3 rounded-lg font-bold hover:bg-indigo-400 transition-all hover:scale-105 mt-auto"
            >
              Get Digital + Print
            </a>
          </div>
        </div>

        <!-- Physical Places -->
        <div class="bg-gradient-to-br from-orange-500/20 to-red-500/20 rounded-2xl p-8 border border-orange-500/30 text-center">
          <div class="text-5xl mb-6">🏢</div>
          <h3 class="text-3xl font-bold mb-4">Physical Places</h3>
          <p class="text-xl text-gray-300 mb-8">
            Order magazines for your Airbnb, coliving, coworking, hostel etc. and we'll make sure to support you back in return! 🏠
          </p>
          <a
            href="/coworking-coliving-shipments"
            class="inline-flex items-center gap-2 bg-orange-500 text-white px-8 py-4 rounded-xl font-bold text-lg hover:bg-orange-400 transition-all"
          >
            Order Magazines
            <ArrowRightIcon class="h-5 w-5" />
          </a>
        </div>
      </div>
    </section>

    <!-- Our Mission -->
    <section class="py-20">
      <div class="mx-auto max-w-4xl px-6 text-center">
        <h2 class="text-4xl md:text-5xl font-bold mb-8">Here's our heart</h2>
        <div class="text-2xl text-gray-300 space-y-6 leading-relaxed">
          <p>
            We genuinely love the brands and projects within our ecosystem. We want to support and help grow the industry that makes the nomad lifestyle possible.
          </p>
          <p>
            We're a <strong class="text-yellow-400">self-funded passion project</strong> without external investors, which means we depend on our community.
          </p>
          <p class="text-3xl font-bold text-white">
            When you help us, we can help you even more 💛
          </p>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-20 bg-gradient-to-br from-yellow-500/10 to-purple-500/10">
      <div class="mx-auto max-w-4xl px-6 text-center">
        <h2 class="text-4xl font-bold mb-12">Ready to join our community?</h2>
        
        <div class="flex flex-col sm:flex-row gap-6 justify-center">
          <a
            href="https://form.smartsuite.com/s4tmc086/8sFlvrVlDC"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-3 bg-yellow-400 text-black px-10 py-5 rounded-full text-xl font-bold hover:bg-yellow-300 transition-all hover:scale-105"
          >
            Submit to Directory (Free)
            <ArrowRightIcon class="h-6 w-6" />
          </a>
        </div>
        
        <p class="mt-8 text-gray-400">
          Questions? Email us at <a href="mailto:lera@nomadgossip.com" class="text-yellow-400 hover:text-yellow-300">lera@nomadgossip.com</a>
        </p>
      </div>
    </section>
  </div>
</Layout>

<style>
.hover\:scale-105:hover {
  transform: scale(1.05);
}
</style>
