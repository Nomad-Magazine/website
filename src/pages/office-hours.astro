---
import Layout, { type SEOProps } from '~/layouts/Layout.astro'
import CheckIcon from '~icons/ic/baseline-check'
import ArrowRightIcon from '~icons/ic/baseline-arrow-forward'
import CalendarIcon from '~icons/ic/baseline-event'
import PeopleIcon from '~icons/ic/baseline-people'

const seo: SEOProps = {
  title: 'Office Hours - Connect with the Nomad Community | Nomad Magazine',
  description: 'Join our weekly Office Hours calls to share updates, announcements, and connect with the digital nomad community. Free and open for everyone.',
  image: `${Astro.site}images/edition-001-nomad-mag-brand-placement.webp`,
  keywords: 'nomad office hours, digital nomad community, nomad networking, announcements, updates, community calls',
  ogType: 'website',
  ldJSON: {
    '@context': 'https://schema.org',
    '@type': 'Event',
    name: 'Nomad Magazine Office Hours',
    description: 'Weekly 30 min calls for digital nomads to share updates and connect',
    url: `${Astro.site}office-hours`,
    organizer: {
      '@type': 'Organization',
      name: 'Nomad Magazine',
      logo: {
        '@type': 'ImageObject',
        url: `${Astro.site}logo.svg`,
      },
    },
  },
}

const benefits = [
  {
    icon: '📢',
    title: 'Share Your Updates',
    description: 'Announce new products, services, launches, or important updates to the community'
  },
  {
    icon: '📸',
    title: 'Get Featured on Instagram',
    description: 'Your announcements will be featured on our Instagram'
  },
  {
    icon: '❓',
    title: 'Ask Questions',
    description: 'Get advice about nomad life, business, or anything else from the community'
  }
]

const howItWorks = [
  {
    step: '1',
    title: 'Join the Call',
    description: 'Click the link and join our weekly 30 min video call'
  },
  {
    step: '2',
    title: 'Share or Listen',
    description: 'Share your updates, ask questions, or just listen and connect'
  },
  {
    step: '3',
    title: 'Get Featured',
    description: 'Your announcements get featured on our Instagram and reach the community'
  },
  {
    step: '4',
    title: 'Leave When Ready',
    description: 'Stay for 5 minutes or the full hour - totally flexible'
  }
]
---

<Layout seo={seo}>
  <div class="bg-white text-gray-900 min-h-screen">
    <!-- Hero Section -->
    <section class="py-20 bg-gradient-to-br from-yellow-50 to-orange-50">
      <div class="mx-auto max-w-6xl px-6">
        <div class="text-center space-y-8">
          <div class="flex items-center justify-center gap-3 mb-4">
            <div class="inline-block bg-yellow-400 text-black px-6 py-3 rounded-full font-bold text-lg">
              💬 Office Hours
            </div>
            <div class="inline-block bg-blue-500 text-white px-4 py-2 rounded-full font-bold text-sm">
              BETA
            </div>
          </div>
          
          <h1 class="text-6xl md:text-8xl font-black leading-tight text-gray-900">
            Connect with
            <br />
            <span class="text-yellow-400">Nomad Magazine</span>
          </h1>
          
          <p class="text-2xl md:text-3xl text-gray-600 max-w-4xl mx-auto leading-relaxed">
            Weekly pre-scheduled calls where you can share updates with our team and connect with our engaged audience. Free and open for everyone.
          </p>

          <div class="py-8">
            <p class="text-2xl md:text-3xl font-bold text-gray-900 mb-2">
              Join → Share your Updates → We record and post on IG
            </p>
            <p class="text-xl text-yellow-500 font-bold">
              Everyone wins ✨
            </p>
          </div>

          <div class="flex flex-col sm:flex-row gap-4 justify-center pt-4">
            <a
              href="https://calendly.com/nomadgossip"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-3 bg-yellow-400 text-black px-10 py-5 rounded-full text-xl font-bold hover:bg-yellow-300 transition-all hover:scale-105"
            >
              <CalendarIcon class="h-6 w-6" />
              Join Next Call
            </a>
            <a
              href="#how-it-works"
              class="inline-flex items-center gap-3 border-2 border-yellow-400 text-yellow-600 px-10 py-5 rounded-full text-xl font-bold hover:bg-yellow-400 hover:text-black transition-all"
            >
              How It Works
              <ArrowRightIcon class="h-6 w-6" />
            </a>
          </div>
        </div>
      </div>
    </section>


    <!-- What You Can Do -->
    <section class="py-20">
      <div class="mx-auto max-w-7xl px-6">
        <div class="text-center mb-16">
          <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-8">What You Can Do</h2>
          <p class="text-2xl text-gray-600 max-w-3xl mx-auto">
            Office Hours is your platform to connect with our team and reach our engaged nomad audience
          </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          {benefits.map((benefit) => (
            <div class="bg-white rounded-2xl p-8 border border-gray-200 shadow-sm hover:shadow-md transition-all">
              <div class="text-5xl mb-6">{benefit.icon}</div>
              <h3 class="text-2xl font-bold text-gray-900 mb-4">{benefit.title}</h3>
              <p class="text-gray-600 text-lg">{benefit.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- How It Works -->
    <section id="how-it-works" class="py-20 bg-gray-50">
      <div class="mx-auto max-w-6xl px-6">
        <div class="text-center mb-16">
          <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-8">How It Works</h2>
          <p class="text-2xl text-gray-600 max-w-3xl mx-auto">
            Simple, flexible, and designed around your schedule
          </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
          {howItWorks.map((step) => (
            <div class="text-center">
              <div class="w-16 h-16 bg-yellow-400 text-black rounded-full flex items-center justify-center text-2xl font-bold mx-auto mb-6">
                {step.step}
              </div>
              <h3 class="text-xl font-bold text-gray-900 mb-4">{step.title}</h3>
              <p class="text-gray-600">{step.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Call Schedule -->
    <section class="py-20">
      <div class="mx-auto max-w-6xl px-6">
        <div class="text-center mb-12">
          <div class="text-6xl mb-6">🗓️</div>
          <div class="flex items-center justify-center gap-3 mb-4">
            <h2 class="text-4xl font-bold text-gray-900">Upcoming Office Hours</h2>
            <span class="bg-blue-100 text-blue-800 px-3 py-1 rounded-full text-sm font-bold">Beta Testing</span>
          </div>
          <p class="text-xl text-gray-600">Weekly 30 min calls alternating between Asia-friendly and US-friendly times</p>
        </div>

        <div class="grid md:grid-cols-2 gap-8 mb-12">
          <!-- Next 4 calls schedule -->
          <div class="bg-gray-900 text-white rounded-2xl p-8">
            <div class="flex items-center gap-3 mb-6">
              <CalendarIcon class="h-6 w-6 text-yellow-400" />
              <h3 class="text-2xl font-bold">Thursday, Oct 17</h3>
            </div>
            <div class="space-y-3 mb-6">
              <p class="text-xl font-bold text-yellow-400">11:00 AM - 11:30 AM UK Time</p>
              <p class="text-sm text-gray-300">Perfect for Asia & Europe</p>
              <div class="text-sm text-gray-400 space-y-1">
                <p>🇸🇬 Singapore: 7:00 PM - 7:30 PM</p>
                <p>🇯🇵 Tokyo: 8:00 PM - 8:30 PM</p>
                <p>🇩🇪 Berlin: 12:00 PM - 12:30 PM</p>
                <p>🇺🇸 NYC: 6:00 AM - 6:30 AM</p>
              </div>
            </div>
            <a
              href="https://us06web.zoom.us/meeting/register/zEVENRuvSRqmi3VLM9Ga2w"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 bg-yellow-400 text-black px-6 py-3 rounded-lg font-bold hover:bg-yellow-300 transition-all"
            >
              <CalendarIcon class="h-5 w-5" />
              Register for Call
            </a>
          </div>

          <div class="bg-gray-900 text-white rounded-2xl p-8">
            <div class="flex items-center gap-3 mb-6">
              <CalendarIcon class="h-6 w-6 text-yellow-400" />
              <h3 class="text-2xl font-bold">Wednesday, Oct 23</h3>
            </div>
            <div class="space-y-3 mb-6">
              <p class="text-xl font-bold text-yellow-400">5:30 PM - 6:00 PM UK Time</p>
              <p class="text-sm text-gray-300">Perfect for US & Europe</p>
              <div class="text-sm text-gray-400 space-y-1">
                <p>🇺🇸 NYC: 12:30 PM - 1:00 PM</p>
                <p>🇺🇸 LA: 9:30 AM - 10:00 AM</p>
                <p>🇩🇪 Berlin: 6:30 PM - 7:00 PM</p>
                <p>🇸🇬 Singapore: 1:30 AM - 2:00 AM</p>
              </div>
            </div>
            <a
              href="https://us06web.zoom.us/meeting/register/m3inIp39SwmZqkpXYtm7aA"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 bg-yellow-400 text-black px-6 py-3 rounded-lg font-bold hover:bg-yellow-300 transition-all"
            >
              <CalendarIcon class="h-5 w-5" />
              Register for Call
            </a>
          </div>

          <div class="bg-gray-100 text-gray-900 rounded-2xl p-8 border-2 border-gray-200">
            <div class="flex items-center gap-3 mb-6">
              <CalendarIcon class="h-6 w-6 text-gray-500" />
              <h3 class="text-2xl font-bold">Thursday, Oct 31</h3>
            </div>
            <div class="space-y-3 mb-6">
              <p class="text-xl font-bold text-gray-600">11:00 AM - 11:30 AM UK Time</p>
              <p class="text-sm text-gray-500">Perfect for Asia & Europe</p>
            </div>
            <a
              href="https://us06web.zoom.us/meeting/register/zEVENRuvSRqmi3VLM9Ga2w"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 bg-gray-300 text-gray-700 px-6 py-3 rounded-lg font-bold hover:bg-gray-200 transition-all"
            >
              <CalendarIcon class="h-5 w-5" />
              Register for Call
            </a>
          </div>

          <div class="bg-gray-100 text-gray-900 rounded-2xl p-8 border-2 border-gray-200">
            <div class="flex items-center gap-3 mb-6">
              <CalendarIcon class="h-6 w-6 text-gray-500" />
              <h3 class="text-2xl font-bold">Wednesday, Nov 6</h3>
            </div>
            <div class="space-y-3 mb-6">
              <p class="text-xl font-bold text-gray-600">5:30 PM - 6:00 PM UK Time</p>
              <p class="text-sm text-gray-500">Perfect for US & Europe</p>
            </div>
            <a
              href="https://us06web.zoom.us/meeting/register/m3inIp39SwmZqkpXYtm7aA"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 bg-gray-300 text-gray-700 px-6 py-3 rounded-lg font-bold hover:bg-gray-200 transition-all"
            >
              <CalendarIcon class="h-5 w-5" />
              Register for Call
            </a>
          </div>
        </div>

        <!-- Flexible Participation Info -->
        <div class="bg-yellow-50 rounded-2xl p-8 text-center mb-8">
          <div class="flex items-center justify-center gap-3 mb-4">
            <span class="text-4xl">⏰</span>
            <h3 class="text-2xl font-bold text-gray-900">Flexible Participation</h3>
          </div>
          <p class="text-lg text-gray-700 mb-4">
            Jump in for 5 minutes or stay for the full 30 minutes - completely up to you
          </p>
          <div class="flex items-center justify-center gap-6 text-sm text-gray-600">
            <div class="flex items-center gap-2">
              <PeopleIcon class="h-5 w-5" />
              <span>Open to everyone</span>
            </div>
            <div class="flex items-center gap-2">
              <CalendarIcon class="h-5 w-5" />
              <span>30 minutes duration</span>
            </div>
          </div>
        </div>

        <div class="text-center">
          <a
            href="https://calendly.com/nomadgossip"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-3 bg-yellow-400 text-black px-10 py-5 rounded-full text-xl font-bold hover:bg-yellow-300 transition-all hover:scale-105"
          >
            <CalendarIcon class="h-6 w-6" />
            View All Available Times
          </a>
        </div>
      </div>
    </section>

    <!-- What to Expect -->
    <section class="py-20 bg-gray-50">
      <div class="mx-auto max-w-4xl px-6 text-center">
        <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-8">What to Expect</h2>
        
        <div class="space-y-8 text-left max-w-3xl mx-auto">
          <div class="flex items-start gap-4">
            <CheckIcon class="h-6 w-6 text-yellow-500 mt-1 flex-shrink-0" />
            <div>
              <h3 class="text-xl font-bold text-gray-900 mb-2">Welcoming Environment</h3>
              <p class="text-gray-600">Friendly, supportive community where everyone is welcome regardless of experience level</p>
            </div>
          </div>
          
          <div class="flex items-start gap-4">
            <CheckIcon class="h-6 w-6 text-yellow-500 mt-1 flex-shrink-0" />
            <div>
              <h3 class="text-xl font-bold text-gray-900 mb-2">No Pressure</h3>
              <p class="text-gray-600">Share if you want, listen if you prefer - there's no obligation to participate actively</p>
            </div>
          </div>
          
          <div class="flex items-start gap-4">
            <CheckIcon class="h-6 w-6 text-yellow-500 mt-1 flex-shrink-0" />
            <div>
              <h3 class="text-xl font-bold text-gray-900 mb-2">Real Value</h3>
              <p class="text-gray-600">Get genuine feedback, make real connections, and have your announcements reach nomad magazine audience.</p>
            </div>
          </div>
          
          <div class="flex items-start gap-4">
            <CheckIcon class="h-6 w-6 text-yellow-500 mt-1 flex-shrink-0" />
            <div>
              <h3 class="text-xl font-bold text-gray-900 mb-2">Privacy Respected</h3>
              <p class="text-gray-600">Personal questions and private discussions stay private - only announcements get shared publicly</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-20">
      <div class="mx-auto max-w-4xl px-6">
        <h2 class="text-4xl font-bold text-gray-900 text-center mb-12">Common Questions</h2>
        
        <div class="space-y-8">
          <div class="bg-white border border-gray-200 rounded-2xl p-8">
            <h3 class="text-xl font-bold text-gray-900 mb-4">Do I need to prepare anything?</h3>
            <p class="text-gray-600">Not at all! Just bring yourself and whatever you'd like to share. It's completely informal.</p>
          </div>
          
          <div class="bg-white border border-gray-200 rounded-2xl p-8">
            <h3 class="text-xl font-bold text-gray-900 mb-4">What if I'm shy or new to nomad life?</h3>
            <p class="text-gray-600">Perfect! Many of our community members started exactly where you are. You can just listen and learn - no pressure to speak.</p>
          </div>
          
          <div class="bg-white border border-gray-200 rounded-2xl p-8">
            <h3 class="text-xl font-bold text-gray-900 mb-4">Will my personal questions be shared publicly?</h3>
            <p class="text-gray-600">No, never. We only share business announcements and updates on Instagram. Personal questions and discussions stay completely private.</p>
          </div>
          
          <div class="bg-white border border-gray-200 rounded-2xl p-8">
            <h3 class="text-xl font-bold text-gray-900 mb-4">What kind of announcements work best?</h3>
            <p class="text-gray-600">Product launches, service announcements, events, job opportunities, collaborations - anything that would benefit the nomad community.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Final CTA -->
    <section class="py-20 bg-gradient-to-br from-gray-900 to-gray-800 text-white">
      <div class="mx-auto max-w-4xl px-6 text-center">
        <div class="flex items-center justify-center gap-3 mb-6">
          <h2 class="text-4xl font-bold">Ready to Join Our Beta?</h2>
          <span class="bg-yellow-400 text-black px-3 py-1 rounded-full text-sm font-bold">New!</span>
        </div>
        <p class="text-xl mb-4 opacity-90">
          Be among the first to experience Office Hours and help us shape this new community feature
        </p>
        <p class="text-sm mb-8 opacity-75">
          As a beta tester, your feedback will help us improve the experience for everyone
        </p>
        
        <a
          href="https://calendly.com/nomadgossip"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-3 bg-white text-blue-500 px-10 py-5 rounded-full text-xl font-bold hover:bg-gray-100 transition-all hover:scale-105"
        >
          <CalendarIcon class="h-6 w-6" />
          Join Office Hours
        </a>
        
        <p class="mt-8 text-sm opacity-75">
          Questions? Email us at <a href="mailto:lera@nomadgossip.com" class="text-white hover:text-gray-200 underline">lera@nomadgossip.com</a>
        </p>
      </div>
    </section>
  </div>
</Layout>

<style>
.hover\:scale-105:hover {
  transform: scale(1.05);
}
</style>
