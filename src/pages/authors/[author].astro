---
export const prerender = true;

import Layout, { type SEOProps } from '~/layouts/Layout.astro'
import { Image } from 'astro:assets'
import { AUTHOR_PAGE_BIOS } from '~/const/authorPageBios'
import { AUTHOR_PROFILES } from '~/const/authorProfiles'
import { authorSlugFromName, getAuthorPosts } from '~/utils/content'

function pickAuthorBio(p: { data: Record<string, unknown> }): string | undefined {
  const d = p.data
  const b = d.authorBio ?? d.author_bio
  if (b == null) return undefined
  const s = String(b).trim()
  return s === '' ? undefined : s
}

export async function getStaticPaths() {
  const allPosts = await getAuthorPosts()
  const authors = new Map<string, string>()

  for (const post of allPosts) {
    if (post.data.author && post.data.published !== false) {
      authors.set(authorSlugFromName(post.data.author), post.data.author)
    }
  }

  return Array.from(authors.entries()).map(([slug, name]) => ({
    params: { author: slug },
    props: { authorName: name },
  }))
}

const { authorName } = Astro.props

const posts = (await getAuthorPosts())
  .filter(
    (post) =>
      post.data.published !== false &&
      post.data.author === authorName,
  )
  .sort((a, b) => {
    const dateA = a.data.pubDate || new Date(0)
    const dateB = b.data.pubDate || new Date(0)
    return dateB.valueOf() - dateA.valueOf()
  })

const authorPageSlug = Astro.params.author ?? ''
const profileFallback = AUTHOR_PROFILES[authorPageSlug]

const authorUrl = posts.find((p) => p.data.authorUrl)?.data.authorUrl ?? profileFallback?.website
const authorImageUrl = posts.find((p) => p.data.authorImageUrl)?.data.authorImageUrl ?? profileFallback?.image
const authorInstagramUrl = posts.find((p) => p.data.authorInstagramUrl)?.data.authorInstagramUrl ?? profileFallback?.instagram

const authorInstagramLabel = authorInstagramUrl
  ? (() => {
      try {
        const handle = new URL(authorInstagramUrl).pathname.replace(/\//g, '').split('?')[0]
        return handle ? `@${handle} on Instagram` : 'Instagram'
      } catch {
        return 'Instagram'
      }
    })()
  : null

const authorBio = (() => {
  for (const p of posts) {
    const b = pickAuthorBio(p)
    if (b) return b
  }
  return profileFallback?.bio ?? AUTHOR_PAGE_BIOS[authorPageSlug] ?? undefined
})()

const authorUrlLabel = authorUrl
  ? (() => {
      try {
        return new URL(authorUrl).hostname
      } catch {
        return authorUrl
      }
    })()
  : null

const authorBioPlain = authorBio
  ? String(authorBio)
      .replace(/<[^>]*>/g, ' ')
      .replace(/\s+/g, ' ')
      .trim()
  : null

const seo: SEOProps = {
  title: `${authorName} – Articles on Nomad Magazine`,
  description: authorBioPlain
    ? `${authorName} — ${authorBioPlain}`
    : `Read all articles written by ${authorName} on Nomad Magazine. Hand-written stories, essays, and insights from an invited author.`,
  ogType: 'website',
  ldJSON: {
    '@context': 'https://schema.org',
    '@type': 'ProfilePage',
    name: `${authorName} – Nomad Magazine`,
    description: authorBioPlain ?? `Articles by ${authorName}`,
    url: `${Astro.site}authors/${Astro.params.author}/`,
  },
}
---

<Layout seo={seo}>
  <div class="bg-hoverw min-h-screen">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">

      <!-- Author header -->
      <header class="mb-12">
        <p class="text-xs uppercase tracking-widest text-neutral-500 mb-2">Author</p>
        <div class="flex flex-col gap-6 sm:flex-row sm:items-start">
          {authorImageUrl && (
            <div class="shrink-0">
              <img
                src={authorImageUrl}
                alt={authorName}
                width="160"
                height="160"
                class="h-32 w-32 rounded-full object-cover border-2 border-neutral-700 sm:h-40 sm:w-40"
                loading="eager"
                decoding="async"
              />
            </div>
          )}
          <div class="min-w-0 flex-1">
            <h1 class="text-4xl font-bold text-white mb-3">{authorName}</h1>
            {authorUrl && (
              <p class="mb-2">
                <a
                  href={authorUrl}
                  class="text-sm text-amber-400/90 hover:text-amber-300 transition-colors"
                  rel="noopener noreferrer"
                >
                  {authorUrlLabel}
                </a>
              </p>
            )}
            {authorInstagramUrl && (
              <p class="mb-2">
                <a
                  href={authorInstagramUrl}
                  class="text-sm text-amber-400/90 hover:text-amber-300 transition-colors"
                  rel="noopener noreferrer"
                  target="_blank"
                  aria-label={`Follow ${authorName} on Instagram (opens in new tab)`}
                >
                  {authorInstagramLabel}
                </a>
              </p>
            )}
            <p class="text-neutral-400 text-sm">
              {posts.length} article{posts.length !== 1 ? 's' : ''} published on Nomad Magazine
            </p>
          </div>
        </div>

        {authorBio && (
          <section class="mt-10 max-w-3xl" aria-labelledby="author-about-heading">
            <h2
              id="author-about-heading"
              class="text-sm font-semibold tracking-wide text-white"
            >
              About the author:
            </h2>
            <div
              class="mt-2 text-base leading-relaxed text-neutral-300 [&_a]:text-amber-400/90 [&_a]:underline [&_a:hover]:text-amber-300"
              set:html={authorBio}
            />
          </section>
        )}

        <div class="mt-8 h-px bg-neutral-800 w-full" />
      </header>

      <!-- Articles grid -->
      {posts.length === 0 ? (
        <p class="text-neutral-400">No published articles found for this author.</p>
      ) : (
        <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => (
            <article class="group relative overflow-hidden rounded-2xl border border-neutral-800 bg-neutral-900/30 transition-all hover:border-neutral-700 hover:bg-neutral-900/60">
              {post.data.heroImage && (
                <div class="aspect-video overflow-hidden">
                  <Image
                    src={post.data.heroImage}
                    alt={post.data.heroImageAlt || post.data.title}
                    width={600}
                    height={338}
                    class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                    loading="lazy"
                  />
                </div>
              )}
              <div class="p-6 space-y-3">
                <div class="text-xs text-neutral-500 font-medium uppercase tracking-wider">
                  {post.data.pubDate?.toLocaleDateString('en-US', {
                    month: 'short',
                    day: 'numeric',
                    year: 'numeric',
                  })}
                  {post.body && (
                    <span> · {Math.ceil(post.body.length / 1000)} min read</span>
                  )}
                </div>
                <h2 class="text-lg font-bold leading-tight text-white group-hover:text-yellow-400 transition-colors">
                  <a href={post.href} class="after:absolute after:inset-0">
                    {post.data.title}
                  </a>
                </h2>
                <p class="text-sm text-neutral-400 line-clamp-3">
                  {post.data.description}
                </p>
              </div>
            </article>
          ))}
        </div>
      )}

      <div class="mt-16 text-center">
        <a
          href="/articles/"
          class="inline-flex items-center gap-2 text-sm text-neutral-400 hover:text-white transition-colors"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
          Back to all articles
        </a>
      </div>
    </div>
  </div>
</Layout>

<style>
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
