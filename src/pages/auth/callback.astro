---
import { createSupabaseServerClient } from '~/utils/supabase-server'
import type { EmailOtpType } from '@supabase/supabase-js'
import {
  consumeDirectoryReturn,
  directoryVoteCrossDeviceNoticeUrl,
  isDirectoryVoteEmailReturn,
  isVoteEmailPkceError,
} from '~/utils/directory-auth'
import {
  consumeVoteNewEmailConfirm,
  directoryVoteMergedNoticeUrl,
  tryMergeAnonymousVotes,
} from '~/utils/directory-vote-merge'

const supabase = createSupabaseServerClient(Astro.request, Astro.cookies)

const url = new URL(Astro.request.url)
const next = consumeDirectoryReturn(Astro.cookies, url)
const loginUrl = (message = '') => `/nomad-directory-edit/?${new URLSearchParams({ ...(next !== '/console/' ? { next } : {}), ...(message ? { error: message } : {}) })}`
Astro.response.headers.set('Cache-Control', 'private, no-store')
const code = url.searchParams.get('code')
const tokenHash = url.searchParams.get('token_hash')
const type = url.searchParams.get('type') as EmailOtpType | null
const error = url.searchParams.get('error')

function authFailureRedirect(message: string) {
  if (isDirectoryVoteEmailReturn(next) && isVoteEmailPkceError(message)) {
    return Astro.redirect(directoryVoteCrossDeviceNoticeUrl(next, url.origin))
  }
  return Astro.redirect(loginUrl(message))
}

async function finishAuthRedirect() {
  const { data: { user } } = await supabase.auth.getUser()
  if (user?.email && user.email_confirmed_at && isDirectoryVoteEmailReturn(next)) {
    try {
      const mergeResult = await tryMergeAnonymousVotes(Astro.request, Astro.cookies, user.id, user.email)
      if (typeof mergeResult === 'number') {
        return Astro.redirect(directoryVoteMergedNoticeUrl(next, url.origin, mergeResult))
      }
      if (mergeResult === 'no_cookie' && !consumeVoteNewEmailConfirm(Astro.cookies)) {
        return Astro.redirect(directoryVoteCrossDeviceNoticeUrl(next, url.origin))
      }
    } catch {
      /* Merge is best-effort; never block sign-in. */
    }
  }
  return Astro.redirect(next)
}

if (error) {
  return Astro.redirect(loginUrl(url.searchParams.get('error_description') ?? error))
}

if (code) {
  const { error: exchangeError } = await supabase.auth.exchangeCodeForSession(code)
  if (exchangeError) {
    return authFailureRedirect(exchangeError.message)
  }
  return finishAuthRedirect()
}

if (tokenHash && type) {
  const { error: otpError } = await supabase.auth.verifyOtp({ type, token_hash: tokenHash })
  if (otpError) {
    return authFailureRedirect(otpError.message)
  }
  return finishAuthRedirect()
}

return Astro.redirect(loginUrl())
---