---
import { createSupabaseServerClient } from '~/utils/supabase-server'
import type { EmailOtpType } from '@supabase/supabase-js'
import { consumeDirectoryReturn } from '~/utils/directory-auth'

const supabase = createSupabaseServerClient(Astro.request, Astro.cookies)

const url = new URL(Astro.request.url)
const next = consumeDirectoryReturn(Astro.cookies, url)
const loginUrl = (message = '') => `/nomad-directory-edit/?${new URLSearchParams({ ...(next !== '/console/' ? { next } : {}), ...(message ? { error: message } : {}) })}`
Astro.response.headers.set('Cache-Control', 'private, no-store')
const code = url.searchParams.get('code')
const tokenHash = url.searchParams.get('token_hash')
const type = url.searchParams.get('type') as EmailOtpType | null
const error = url.searchParams.get('error')

if (error) {
  return Astro.redirect(loginUrl(url.searchParams.get('error_description') ?? error))
}

if (code) {
  const { error: exchangeError } = await supabase.auth.exchangeCodeForSession(code)
  if (exchangeError) {
    return Astro.redirect(loginUrl(exchangeError.message))
  }
  return Astro.redirect(next)
}

if (tokenHash && type) {
  const { error: otpError } = await supabase.auth.verifyOtp({ type, token_hash: tokenHash })
  if (otpError) {
    return Astro.redirect(loginUrl(otpError.message))
  }
  return Astro.redirect(next)
}

return Astro.redirect(loginUrl())
---
