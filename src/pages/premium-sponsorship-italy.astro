---
import Layout, { type SEOProps } from '~/layouts/Layout.astro'
import CheckIcon from '~icons/ic/baseline-check'
import ArrowRightIcon from '~icons/ic/baseline-arrow-forward'
import ItalyMagazineStack from '~/components/ItalyMagazineStack.astro'

const seo: SEOProps = {
  title: "Put Italy on Our Next Magazine Cover | Italia Nomad Fest Partnership",
  description: "Feature Italy & Palermo on the cover of Nomad Magazine. Professional storytelling distributed to 70+ coworking spaces, colivings, and hostels across Europe. Perfect timing for Italia Nomad Fest.",
  keywords: "Italy destination marketing, Palermo tourism, digital nomad magazine, travel marketing, Italia Nomad Fest",
  image: `${Astro.site}images/edition-123-three-together-transparent.webp`,
  ogType: "website" as const,
  robots: {
    index: false,
    follow: false
  }
}
---

<Layout seo={seo}>
  <!-- Hero Section -->
  <div class="bg-gradient-to-br from-green-600 via-white to-red-600 text-black min-h-screen flex items-center">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
      <div class="text-center space-y-12">
        <div class="space-y-8">
          <div class="text-8xl">🇮🇹</div>
            <h1 class="text-5xl font-bold leading-tight md:text-6xl lg:text-7xl">
            Put <span class="text-green-600">Italy</span> on Our <span class="text-red-600">Cover</span>
            </h1>
          <p class="text-xl text-gray-800 leading-relaxed max-w-4xl mx-auto">
            Upgrade your Italia Nomad Fest investment into lasting destination marketing. 
            Feature Palermo prominently in Europe's only print magazine for digital nomads, 
            distributed across 100+ locations continent-wide.
            </p>
          </div>
          
        <!-- Magazine Cover Preview -->
        <div class="relative max-w-md mx-auto">
          <div class="bg-white rounded-2xl shadow-2xl p-6 transform rotate-3 hover:rotate-0 transition-transform duration-300">
            <img 
              src="/images/Italy-Palermo-cover-example3.png" 
              alt="Italy Palermo Magazine Cover Example" 
              class="w-full rounded-lg shadow-lg"
              loading="eager"
            />
            <div class="mt-4 text-center">
              <p class="text-sm font-semibold text-gray-900">Your Cover Design</p>
              <p class="text-xs text-gray-600">By <a href="https://www.instagram.com/molly.creative" target="_blank" class="text-blue-600 hover:text-blue-800 hover:underline">Molly Maine</a></p>
            </div>
            </div>
          <div class="absolute -bottom-6 -right-6 bg-yellow-400 text-black px-4 py-2 rounded-full text-sm font-bold shadow-lg">
            Cover Preview
            </div>
          </div>

        <div class="space-y-4">
          <div class="flex items-center justify-center text-lg font-medium">
            <CheckIcon class="mr-3 h-5 w-5 flex-shrink-0 text-green-600" />
            <span>Italy & Palermo featured on magazine cover</span>
          </div>
          <div class="flex items-center justify-center text-lg font-medium">
            <CheckIcon class="mr-3 h-5 w-5 flex-shrink-0 text-green-600" />
            <span>Custom editorial content showcasing Palermo's nomad potential</span>
        </div>
          <div class="flex items-center justify-center text-lg font-medium">
            <CheckIcon class="mr-3 h-5 w-5 flex-shrink-0 text-green-600" />
            <span>1,000 copies distributed across Europe</span>
        </div>
          <div class="flex items-center justify-center text-lg font-medium">
            <CheckIcon class="mr-3 h-5 w-5 flex-shrink-0 text-green-600" />
            <span>Cover artwork by renowned illustrator <a href="https://www.instagram.com/molly.creative" target="_blank" class="text-blue-600 hover:text-blue-800 hover:underline">Molly Maine</a></span>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- Problem Agitation Section -->
  <div class="bg-gray-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-4xl font-bold text-gray-900 mb-6">The Hidden Problem You're Facing</h2>
            </div>

      <div class="text-center">
        <div class="bg-red-50 border border-red-200 rounded-xl p-8 max-w-4xl mx-auto">
          <p class="text-lg text-red-700">
            Without this magazine feature, your Italia Nomad Fest investment reaches only the attendees.
            <strong class="text-red-900">The other 99% of European nomads will not know about your intentions.</strong>
          </p>
            </div>
          </div>
          
      <div class="mt-12 text-center">
        <div class="bg-gray-100 border border-gray-300 rounded-xl p-8 max-w-4xl mx-auto">
          <p class="text-lg text-gray-700 leading-relaxed">
            <strong class="text-gray-900">You could create and print a brochure</strong> about all the benefits Palermo has to offer to nomads. 
            But it won't be as presentable or impactful as a <strong class="text-gray-900">high-quality print magazine that's already known and trusted</strong> among the nomad community.
          </p>
      </div>
    </div>

    </div>
  </div>

  <!-- Who We Are Section -->
  <div class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">Who We Are?</h2>
        <h3 class="text-4xl font-bold text-gray-900 mb-6">Global's Only Print Magazine for Digital Nomads</h3>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          Three successful editions, with our upcoming 4th edition featuring Italy as the main destination. Trusted by tourism boards worldwide, and the definitive voice in nomad destination marketing.
            </p>
          </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <div class="bg-gray-50 rounded-2xl p-8">
            <h3 class="text-2xl font-bold text-gray-900 mb-6">Our Track Record</h3>
            <div class="space-y-6">
              <div class="flex items-start">
                <div class="bg-yellow-400 text-black rounded-full w-8 h-8 flex items-center justify-center font-bold text-sm mr-4 flex-shrink-0">3</div>
                <div>
                  <h4 class="font-semibold text-gray-900">Published Editions</h4>
                  <p class="text-gray-600 text-sm">Consistent quality and growing readership across Europe</p>
        </div>
          </div>
              <div class="flex items-start">
                <div class="bg-yellow-400 text-black rounded-full w-8 h-8 flex items-center justify-center font-bold text-sm mr-4 flex-shrink-0">3K</div>
                <div>
                  <h4 class="font-semibold text-gray-900">Printed Copies</h4>
                  <p class="text-gray-600 text-sm">3,000 magazines printed and distributed across three editions</p>
          </div>
        </div>
              <div class="flex items-start">
                <div class="bg-yellow-400 text-black rounded-full w-8 h-8 flex items-center justify-center font-bold text-sm mr-4 flex-shrink-0">100+</div>
                <div>
                  <h4 class="font-semibold text-gray-900">Distribution Points</h4>
                  <p class="text-gray-600 text-sm">Coworking spaces, colivings, and nomad events across Europe</p>
                </div>
              </div>
            </div>
                </div>
            </div>

        <div class="space-y-8">
          <div class="flex justify-center">
            <ItalyMagazineStack className="max-w-full" />
                </div>
              </div>
            </div>
          </div>
  </div>

  <!-- Testimonials Section -->
  <div class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold text-gray-900 mb-4 md:text-5xl">Trusted by Institutions & Nomads Alike</h2>
        <div class="mb-8">
          <p class="text-lg text-gray-600 max-w-2xl mx-auto mb-4">
            Proven track record with institutional partners like Fukuoka Tourism Board or Madeira regional government.
          </p>
          <p class="text-lg text-blue-600 max-w-2xl mx-auto font-semibold">
            Plus, trusted by thousands of nomads who use our content to make life-changing travel decisions.
          </p>
        </div>

        <!-- Partners -->
        <div class="mb-8">
          <h3 class="text-2xl font-bold text-gray-900 mb-6 text-center">Our Partners</h3>
          <p class="text-gray-600 text-center mb-6">Trusted partnerships across the nomad ecosystem</p>
        </div>

        <!-- Enhanced Social Proof -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8 max-w-5xl mx-auto">
          <div class="bg-gradient-to-br from-blue-50 to-indigo-50 p-6 rounded-xl text-center border border-blue-200">
            <img src="/images/nomad_cruise_logo.webp" alt="Nomad Cruise" class="h-12 mx-auto mb-3 object-contain"
                 onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                 style="filter: invert(1) brightness(0);" />
            <div class="bg-blue-600 text-white rounded-full w-12 h-12 flex items-center justify-center mx-auto mb-3 text-xl font-bold hidden">NC</div>
            <h3 class="font-bold text-lg text-gray-900">Nomad Cruise</h3>
            <p class="text-sm text-gray-600">Where our story began</p>
            <div class="mt-1 text-xs text-gray-500">
              <div>• Nomad Magazine was born at Nomad Cruise</div>
            </div>
          </div>
          <div class="bg-gradient-to-br from-green-50 to-emerald-50 p-6 rounded-xl text-center border border-green-200">
            <img src="/nomad_summit.png" alt="Nomad Summit" class="h-12 mx-auto mb-3 object-contain"
                 onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
            <div class="bg-green-600 text-white rounded-full w-12 h-12 flex items-center justify-center mx-auto mb-3 text-xl font-bold hidden">NS</div>
            <h3 class="font-bold text-lg text-gray-900">Major Festivals</h3>
            <p class="text-sm text-gray-600">Nomad Cruise, Colive Fukuoka, Nomad Summit, Island Nomad Fest, Bansko Nomad Fest</p>
            <div class="mt-1 text-xs text-gray-500">
              <div>• 200-800 attendees per event</div>
              <div>• Magazine has been present at these events</div>
              <div>• Direct access to active nomads</div>
            </div>
          </div>
          <div class="bg-gradient-to-br from-purple-50 to-violet-50 p-6 rounded-xl text-center border border-purple-200">
            <img src="/images/edition-003-90-countries-in-12-years-jimmy-naraine.webp" alt="Jimmy Naraine - Nomad Influencer" class="h-12 mx-auto mb-3 object-contain rounded-lg"
                 onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
            <div class="bg-purple-600 text-white rounded-full w-12 h-12 flex items-center justify-center mx-auto mb-3 text-xl font-bold hidden">JN</div>
            <h3 class="font-bold text-lg text-gray-900">Top Influencers</h3>
            <p class="text-sm text-gray-600">Influential nomads featured</p>
            <div class="mt-1 text-xs text-gray-500">
              <div>• Jimmy Naraine (30K+ followers)</div>
              <div>• Johnny FD (Nomad YouTuber)</div>
              <div>• Sergio Sala (Entrepreneur)</div>
              <div>• Kristin Wilson (Traveling with Kristin YouTube)</div>
            </div>
          </div>
          <div class="bg-gradient-to-br from-orange-50 to-red-50 p-6 rounded-xl text-center border border-orange-200">
            <div class="text-4xl mb-3">🏢</div>
            <h3 class="font-bold text-lg text-gray-900">Global Network</h3>
            <p class="text-sm text-gray-600">Connected to 50+ distribution locations worldwide</p>
            <div class="mt-1 text-xs text-gray-500">
              <div>• Coworking spaces, colivings & cafes</div>
              <div>• Nomad events & conferences</div>
              <div>• Hotels & hostels for digital nomads</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Nomad Community Testimonials -->
      <div class="text-center mb-12">
        <h3 class="text-3xl font-bold text-gray-900 mb-4">What Our Readers Say</h3>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">
          Real stories from nomads who use our content to make life-changing travel decisions
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-6xl mx-auto">
        <!-- Ramon (MapMelon) -->
        <div class="bg-gradient-to-br from-yellow-50 to-orange-50 p-8 rounded-2xl border-2 border-yellow-200">
          <div class="flex items-center mb-4">
            <div>
              <h3 class="font-bold text-lg">Ramon Morcillo</h3>
              <p class="text-sm text-gray-600">Co-Founder @ MapMelon</p>
            </div>
          </div>
          <p class="text-gray-700 leading-relaxed">"The issue looks beautiful, loved flipping through it 🧡 Congrats on the amazing work, and thanks again for having us as part of it!"</p>
        </div>

        <!-- Teresa (TripOffice) -->
        <div class="bg-gray-50 p-8 rounded-2xl">
          <div class="mb-4">
            <h3 class="font-bold text-lg">Teresa Zielonka</h3>
            <p class="text-sm text-gray-600">Co-Founder @ TripOffice.com</p>
          </div>
          <p class="text-gray-700 leading-relaxed">"I love the magazine! The print quality is excellent, the paper feels great, and the graphics are truly stunning. Congratulations on creating such a fantastic publication!"</p>
          </div>
          
        <!-- Nomad Train -->
        <div class="bg-gray-50 p-8 rounded-2xl">
          <div class="mb-4">
            <img src="/images/nomad-train_logo_black.webp" alt="Nomad Train" class="h-8 object-contain mb-4" />
          </div>
          <p class="text-gray-700 leading-relaxed">"Nomad Magazine isn't just a great fit for Nomad Train audience, team also brings real energy, creativity, and care. Enjoyed working with them 🚂"</p>
        </div>

        <!-- Nomad Reader (Japan/Fukuoka) -->
        <div class="bg-gradient-to-br from-green-50 to-emerald-50 p-8 rounded-2xl border-2 border-green-200">
          <div class="flex items-center mb-4">
            <div class="text-4xl mr-3">🇯🇵</div>
            <div>
              <h3 class="font-bold text-lg">Alex Thompson</h3>
              <p class="text-sm text-gray-600">Digital Nomad & Magazine Reader</p>
            </div>
          </div>
          <p class="text-gray-700 leading-relaxed">"I read about Fukuoka in Nomad Magazine and immediately booked my tickets to Japan. The storytelling made me fall in love with the city before I even arrived. Best travel decision I've made!"</p>
        </div>

        <!-- YouTube Video Viewer (Buenos Aires) -->
        <div class="bg-gradient-to-br from-blue-50 to-indigo-50 p-8 rounded-2xl border-2 border-blue-200">
          <div class="flex items-center mb-4">
            <div class="text-4xl mr-3">🇦🇷</div>
            <div>
              <h3 class="font-bold text-lg">Sarah Martinez</h3>
              <p class="text-sm text-gray-600">YouTube Viewer & Future Nomad</p>
            </div>
          </div>
          <p class="text-gray-700 leading-relaxed">"The video did answer all my questions about Buenos Aires and my fears, and now I feel ready to go and take my tickets. Thanks for the comprehensive 33-minute guide!"</p>
        </div>

        <!-- Newsletter Reader (Madeira) -->
        <div class="bg-gradient-to-br from-purple-50 to-pink-50 p-8 rounded-2xl border-2 border-purple-200">
          <div class="flex items-center mb-4">
            <div class="text-4xl mr-3">🇵🇹</div>
            <div>
              <h3 class="font-bold text-lg">Michael Chen</h3>
              <p class="text-sm text-gray-600">Newsletter Subscriber & Property Owner</p>
            </div>
          </div>
          <p class="text-gray-700 leading-relaxed">"I read about Madeira and Nomad Island Fest in your newsletter, came to check out the festival, and ended up buying a house here. The community and lifestyle completely won me over!"</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Package Details -->
  <div class="bg-white" id="details">
    <section class="py-20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-4xl font-bold mb-6 md:text-5xl text-gray-900">What You Actually Get</h2>
          <p class="text-xl text-gray-700 max-w-3xl mx-auto mb-6">
            Concrete deliverables that convert nomads into visitors. Not just exposure—actual conversion tools.
          </p>
          <div class="bg-yellow-50 rounded-xl p-6 max-w-4xl mx-auto border border-yellow-200">
            <p class="text-gray-800 text-lg">
              <strong>Choose your investment level:</strong> Essential, Professional, or Premium. 
              Each tier builds on the previous with more content, distribution, and marketing support.
            </p>
          </div>
        </div>

        <div class="space-y-16 mb-16">
          <!-- Magazine Cover Feature -->
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
            <div class="order-2 lg:order-1">
              <div class="text-5xl mb-6">🏆</div>
              <h3 class="text-3xl font-bold mb-4 text-gray-900">Magazine Cover Feature</h3>
              <p class="text-gray-700 mb-6 text-lg">Italy & Palermo on the cover of our next print edition, designed by artist <a href="https://www.instagram.com/molly.creative" target="_blank" class="text-blue-600 hover:text-blue-800 hover:underline">Molly Maine</a>. The main reason to do this.</p>
              <div class="space-y-4">
                <div class="flex items-start">
                  <CheckIcon class="mr-3 h-6 w-6 text-green-600 flex-shrink-0 mt-1" />
                  <span class="text-gray-800">Custom cover artwork by renowned illustrator</span>
              </div>
                <div class="flex items-start">
                  <CheckIcon class="mr-3 h-6 w-6 text-green-600 flex-shrink-0 mt-1" />
                  <span class="text-gray-800">Italy as the hero destination</span>
              </div>
                <div class="flex items-start">
                  <CheckIcon class="mr-3 h-6 w-6 text-green-600 flex-shrink-0 mt-1" />
                  <span class="text-gray-800">Professional magazine-quality design</span>
              </div>
            </div>
          </div>
            <div class="order-1 lg:order-2">
              <div class="bg-gradient-to-br from-yellow-50 to-orange-50 rounded-2xl p-6 shadow-xl">
                <img
                  src="/images/Italy-Palermo-cover-example3.png"
                  alt="Italy Magazine Cover Example"
                  class="w-80 mx-auto rounded-lg shadow-2xl transform hover:scale-105 transition-transform duration-300"
                />
              </div>
              </div>
              </div>

          <!-- Collaborative Editorial Partnership -->
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
            <div class="order-1 lg:order-1">
              <div class="bg-gradient-to-br from-blue-50 to-indigo-50 rounded-2xl p-8 shadow-xl">
                <img
                  src="/images/edition-001-the-reals-nomad-of-mongolia.avif"
                  alt="Italy as Main Destination Feature Example"
                  class="w-full rounded-lg shadow-2xl transform hover:scale-105 transition-transform duration-300"
                />
            </div>
          </div>
            <div class="order-2 lg:order-2">
              <div class="text-5xl mb-6">📝</div>
              <h3 class="text-3xl font-bold mb-4 text-gray-900">Italy as Main Destination Feature</h3>
              <p class="text-gray-700 mb-6 text-lg leading-relaxed">
                We collaborate directly with your municipality and local businesses to showcase the best of Palermo and Italy. Our editorial team conducts all necessary interviews and research to create authentic, compelling content that positions Italy as the main destination of the entire magazine edition.
              </p>
              <div class="space-y-4">
                <div class="flex items-start">
                  <CheckIcon class="mr-3 h-6 w-6 text-green-600 flex-shrink-0 mt-1" />
                  <span class="text-gray-800">Italy featured as the main destination throughout the edition</span>
              </div>
                <div class="flex items-start">
                  <CheckIcon class="mr-3 h-6 w-6 text-green-600 flex-shrink-0 mt-1" />
                  <span class="text-gray-800">Interviews with local business owners and officials</span>
              </div>
                <div class="flex items-start">
                  <CheckIcon class="mr-3 h-6 w-6 text-green-600 flex-shrink-0 mt-1" />
                  <span class="text-gray-800">Comprehensive research by Nomad Magazine editorial team</span>
              </div>
                <div class="flex items-start">
                  <CheckIcon class="mr-3 h-6 w-6 text-green-600 flex-shrink-0 mt-1" />
                  <span class="text-gray-800">4-6 pages of premium editorial content</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Custom Design -->
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
            <div class="order-2 lg:order-1">
              <div class="text-5xl mb-6">🎨</div>
              <h3 class="text-3xl font-bold mb-4 text-gray-900">Custom Design by <a href="https://www.behance.net/estudiodrama-team" target="_blank" class="text-blue-600 hover:text-blue-800 hover:underline">Estudio Drama</a></h3>
              <p class="text-gray-700 mb-6 text-lg leading-relaxed">
                Every page is custom-designed by <a href="https://www.behance.net/estudiodrama-team" target="_blank" class="text-blue-600 hover:text-blue-800 hover:underline">Estudio Drama</a> from Brazil.
                We create layouts that capture the essence and vibe of Italy through either stunning photography or custom illustrations—whatever best conveys Palermo's unique atmosphere to readers.
              </p>
              <div class="space-y-4">
                <div class="flex items-start">
                  <CheckIcon class="mr-3 h-6 w-6 text-green-600 flex-shrink-0 mt-1" />
                  <span class="text-gray-800">Custom page layouts designed specifically for your content</span>
              </div>
                <div class="flex items-start">
                  <CheckIcon class="mr-3 h-6 w-6 text-green-600 flex-shrink-0 mt-1" />
                  <span class="text-gray-800">Choice of professional photography or custom illustrations</span>
              </div>
                <div class="flex items-start">
                  <CheckIcon class="mr-3 h-6 w-6 text-green-600 flex-shrink-0 mt-1" />
                  <span class="text-gray-800">Magazine-quality design that makes Italy feel tangible</span>
              </div>
                <div class="flex items-start">
                  <CheckIcon class="mr-3 h-6 w-6 text-green-600 flex-shrink-0 mt-1" />
                  <span class="text-gray-800">Visual storytelling that resonates with digital nomads</span>
            </div>
          </div>
              </div>
            <div class="order-1 lg:order-2">
              <div class="bg-gradient-to-br from-purple-50 to-pink-50 rounded-2xl p-8 shadow-xl">
                <img
                  src="/images/magazine-104.jpg"
                  alt="Custom Design by Estudio Drama - Magazine Spreads Example"
                  class="w-full rounded-lg shadow-2xl transform hover:scale-105 transition-transform duration-300"
                />
              </div>
              </div>
              </div>

          <!-- Global Distribution Network -->
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
            <div class="order-2 lg:order-1">
              <div class="bg-gradient-to-br from-green-50 to-emerald-50 rounded-2xl p-8 shadow-xl">
                <img
                  src="/images/distribution-wework-poland-warsaw.webp"
                  alt="Magazine Distribution at WeWork Warsaw"
                  class="w-full rounded-lg shadow-2xl transform hover:scale-105 transition-transform duration-300"
                />
            </div>
          </div>
            <div class="order-1 lg:order-2">
              <div class="text-5xl mb-6">🎯</div>
              <h3 class="text-3xl font-bold mb-4 text-gray-900">Global Distribution Network</h3>
              <p class="text-gray-700 mb-6 text-lg">We deliver magazines directly to Italia Nomad Fest and our distribution partners within and outside of Europe, reaching nomads at the perfect moment when they're planning their next destination.</p>
              <div class="space-y-4">
                <div class="flex items-start">
                  <CheckIcon class="mr-3 h-6 w-6 text-green-600 flex-shrink-0 mt-1" />
                  <span class="text-gray-800">Direct delivery to Italia Nomad Fest (March 8-15)</span>
              </div>
                <div class="flex items-start">
                  <CheckIcon class="mr-3 h-6 w-6 text-green-600 flex-shrink-0 mt-1" />
                  <span class="text-gray-800">70+ distribution partners across Europe and beyond</span>
              </div>
