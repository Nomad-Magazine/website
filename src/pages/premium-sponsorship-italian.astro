---
export const prerender = true;

import Layout, { type SEOProps } from '~/layouts/Layout.astro'
import CheckIcon from '~icons/ic/baseline-check'
import ItalyMagazineStack from '~/components/ItalyMagazineStack.astro'

const seo: SEOProps = {
  title: "Metti l'Italia sulla nostra prossima copertina | Partnership Italia Nomad Fest",
  description: "Metti in evidenza l'Italia e Palermo sulla copertina di Nomad Magazine. Storytelling professionale distribuito in 70+ coworking, coliving e ostelli in tutta Europa. Tempismo perfetto per Italia Nomad Fest.",
  keywords: "marketing di destinazione Italia, turismo Palermo, rivista nomadi digitali, marketing di viaggio, Italia Nomad Fest",
  image: `${Astro.site}images/edition-123-three-together-transparent.webp`,
  ogType: "website" as const
}
---

<Layout seo={seo}>
  <!-- Hero Section -->
  <div class="bg-gradient-to-br from-green-600 via-white to-red-600 text-black min-h-screen flex items-center">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
      <!-- Two Column Layout -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        
        <!-- Left Column: Text Content -->
        <div class="space-y-8">
          <div class="text-7xl">🇮🇹</div>
          <h1 class="text-5xl font-bold leading-tight md:text-6xl lg:text-7xl">
            Metti <span class="text-green-600">l'Italia</span> sulla nostra <span class="text-red-600">Copertina</span>
          </h1>
          <p class="text-xl text-gray-800 leading-relaxed">
            Trasforma il tuo investimento in Italia Nomad Fest in marketing di destinazione duraturo.
            Metti Palermo in primo piano nell'unica rivista cartacea d'Europa per nomadi digitali,
            distribuita in oltre 100 location in tutto il continente.
          </p>
          
          <!-- Key Benefits List -->
          <div class="space-y-4 pt-4">
            <div class="flex items-start">
              <CheckIcon class="mr-3 h-6 w-6 flex-shrink-0 text-green-600 mt-1" />
              <span class="text-lg font-medium">Italia e Palermo sulla copertina della rivista</span>
            </div>
            <div class="flex items-start">
              <CheckIcon class="mr-3 h-6 w-6 flex-shrink-0 text-green-600 mt-1" />
              <span class="text-lg font-medium">Contenuti editoriali su misura che mostrano il potenziale nomade di Palermo</span>
            </div>
            <div class="flex items-start">
              <CheckIcon class="mr-3 h-6 w-6 flex-shrink-0 text-green-600 mt-1" />
              <span class="text-lg font-medium">1.000 copie distribuite in tutta Europa</span>
            </div>
            <div class="flex items-start">
              <CheckIcon class="mr-3 h-6 w-6 flex-shrink-0 text-green-600 mt-1" />
              <span class="text-lg font-medium">Copertina illustrata dalla rinomata illustratrice <a href="https://www.instagram.com/molly.creative" target="_blank" class="text-blue-600 hover:text-blue-800 hover:underline">Molly Maine</a></span>
            </div>
          </div>

        </div>

        <!-- Right Column: Magazine Cover Image -->
        <div class="relative flex justify-center lg:justify-end">
          <div class="relative">
            <div class="bg-white rounded-2xl shadow-2xl p-6 transform hover:rotate-2 transition-transform duration-300">
              <img
                src="/images/Italy-Palermo-cover-example3.webp"
                alt="Esempio copertina Italia Palermo"
                class="w-full max-w-sm lg:max-w-md rounded-lg shadow-lg"
                loading="eager"
              />
              <div class="mt-4 text-center">
                <p class="text-sm font-semibold text-gray-900">La tua copertina</p>
                <p class="text-xs text-gray-600">Di <a href="https://www.instagram.com/molly.creative" target="_blank" class="text-blue-600 hover:text-blue-800 hover:underline">Molly Maine</a></p>
              </div>
            </div>
            <div class="absolute -bottom-4 -right-4 bg-yellow-400 text-black px-6 py-3 rounded-full text-sm font-bold shadow-lg animate-pulse">
              Anteprima copertina
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- Problem Agitation Section -->
  <div class="bg-gray-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-4xl font-bold text-gray-900 mb-6">Il problema nascosto che stai affrontando</h2>
            </div>

      <div class="text-center">
        <div class="bg-red-50 border border-red-200 rounded-xl p-8 max-w-4xl mx-auto">
          <p class="text-lg text-red-700">
            Senza questa presenza in rivista, il tuo investimento in Italia Nomad Fest raggiunge solo i partecipanti.
            <strong class="text-red-900">Il restante 99% dei nomadi europei non saprà delle tue intenzioni.</strong>
          </p>
            </div>
          </div>
          
      <div class="mt-12 text-center">
        <div class="bg-gray-100 border border-gray-300 rounded-xl p-8 max-w-4xl mx-auto">
          <p class="text-lg text-gray-700 leading-relaxed">
            <strong class="text-gray-900">Potresti creare e stampare una brochure</strong> con tutti i vantaggi che Palermo offre ai nomadi.
            Ma non sarà presentabile o d'impatto come una <strong class="text-gray-900">rivista cartacea di alta qualità, già conosciuta e fidata</strong> dalla comunità dei nomadi.
          </p>
      </div>
    </div>

    </div>
  </div>

  <!-- Who We Are Section -->
  <div class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">Chi siamo?</h2>
        <h3 class="text-4xl font-bold text-gray-900 mb-6">L'unica rivista cartacea al mondo per nomadi digitali</h3>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          Tre edizioni di successo; la 4ª in arrivo con l'Italia come destinazione principale. Scelti da enti del turismo in tutto il mondo, siamo la voce di riferimento nel marketing di destinazione per nomadi.
            </p>
          </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <div class="bg-gray-50 rounded-2xl p-8">
            <h3 class="text-2xl font-bold text-gray-900 mb-6">Il nostro percorso</h3>
            <div class="space-y-6">
              <div class="flex items-start">
                <div class="bg-yellow-400 text-black rounded-full w-8 h-8 flex items-center justify-center font-bold text-sm mr-4 flex-shrink-0">3</div>
                <div>
                  <h4 class="font-semibold text-gray-900">Edizioni pubblicate</h4>
                  <p class="text-gray-600 text-sm">Qualità costante e pubblico in crescita in tutta Europa</p>
        </div>
          </div>
              <div class="flex items-start">
                <div class="bg-yellow-400 text-black rounded-full w-8 h-8 flex items-center justify-center font-bold text-sm mr-4 flex-shrink-0">3K</div>
                <div>
                  <h4 class="font-semibold text-gray-900">Copie stampate</h4>
                  <p class="text-gray-600 text-sm">3.000 riviste stampate e distribuite in tre edizioni</p>
          </div>
        </div>
              <div class="flex items-start">
                <div class="bg-yellow-400 text-black rounded-full w-8 h-8 flex items-center justify-center font-bold text-sm mr-4 flex-shrink-0">100+</div>
                <div>
                  <h4 class="font-semibold text-gray-900">Punti di distribuzione</h4>
                  <p class="text-gray-600 text-sm">Coworking, coliving ed eventi per nomadi in tutta Europa</p>
                </div>
              </div>
            </div>
                </div>
            </div>

        <div class="space-y-8">
          <div class="flex justify-center">
            <ItalyMagazineStack className="max-w-full" />
                </div>
              </div>
            </div>
          </div>
  </div>

  <!-- Testimonials Section -->
  <div class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold text-gray-900 mb-4 md:text-5xl">Scelti da istituzioni e nomadi</h2>
        <div class="mb-8">
          <p class="text-lg text-gray-600 max-w-2xl mx-auto mb-4">
            Esperienza comprovata con partner istituzionali come l'ente del turismo di Fukuoka e il governo regionale di Madeira.
          </p>
          <p class="text-lg text-blue-600 max-w-2xl mx-auto font-semibold">
            E fiducia da migliaia di nomadi che usano i nostri contenuti per decisioni di viaggio importanti.
          </p>
        </div>

        <!-- Partners -->
        <div class="mb-8">
          <h3 class="text-2xl font-bold text-gray-900 mb-6 text-center">I nostri partner</h3>
          <p class="text-gray-600 text-center mb-6">Partnership di fiducia in tutto l'ecosistema nomade</p>
        </div>

        <!-- Enhanced Social Proof -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8 max-w-5xl mx-auto">
          <div class="bg-gradient-to-br from-blue-50 to-indigo-50 p-6 rounded-xl text-center border border-blue-200">
            <img src="/images/nomad_cruise_logo.webp" alt="Nomad Cruise" class="h-12 mx-auto mb-3 object-contain"
                 onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                 style="filter: invert(1) brightness(0);" />
            <div class="bg-blue-600 text-white rounded-full w-12 h-12 flex items-center justify-center mx-auto mb-3 text-xl font-bold hidden">NC</div>
          <h3 class="font-bold text-lg text-gray-900">Nomad Cruise</h3>
          <p class="text-sm text-gray-600">Dove è iniziata la nostra storia</p>
            <div class="mt-1 text-xs text-gray-500">
              <div>• Nomad Magazine è nata a Nomad Cruise</div>
            </div>
          </div>
          <div class="bg-gradient-to-br from-green-50 to-emerald-50 p-6 rounded-xl text-center border border-green-200">
            <img src="/nomad_summit.png" alt="Nomad Summit" class="h-12 mx-auto mb-3 object-contain"
                 onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
            <div class="bg-green-600 text-white rounded-full w-12 h-12 flex items-center justify-center mx-auto mb-3 text-xl font-bold hidden">NS</div>
          <h3 class="font-bold text-lg text-gray-900">Festival principali</h3>
          <p class="text-sm text-gray-600">Nomad Cruise, Colive Fukuoka, Nomad Summit, Island Nomad Fest, Bansko Nomad Fest</p>
            <div class="mt-1 text-xs text-gray-500">
              <div>• 200–800 partecipanti per evento</div>
              <div>• La rivista è stata presente a questi eventi</div>
              <div>• Accesso diretto ai nomadi attivi</div>
            </div>
          </div>
          <div class="bg-gradient-to-br from-purple-50 to-violet-50 p-6 rounded-xl text-center border border-purple-200">
            <img src="/images/edition-003-90-countries-in-12-years-jimmy-naraine.webp" alt="Jimmy Naraine - Nomad Influencer" class="h-12 mx-auto mb-3 object-contain rounded-lg"
                 onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
            <div class="bg-purple-600 text-white rounded-full w-12 h-12 flex items-center justify-center mx-auto mb-3 text-xl font-bold hidden">JN</div>
          <h3 class="font-bold text-lg text-gray-900">Influencer principali</h3>
          <p class="text-sm text-gray-600">Nomadi influenti presenti</p>
            <div class="mt-1 text-xs text-gray-500">
              <div>• Jimmy Naraine (30K+ followers)</div>
              <div>• Johnny FD (Nomad YouTuber)</div>
              <div>• Sergio Sala (Entrepreneur)</div>
              <div>• Kristin Wilson (Traveling with Kristin YouTube)</div>
            </div>
          </div>
          <div class="bg-gradient-to-br from-orange-50 to-red-50 p-6 rounded-xl text-center border border-orange-200">
            <div class="text-4xl mb-3">🏢</div>
          <h3 class="font-bold text-lg text-gray-900">Rete globale</h3>
          <p class="text-sm text-gray-600">Collegati a 50+ punti di distribuzione nel mondo</p>
            <div class="mt-1 text-xs text-gray-500">
              <div>• Spazi di coworking, coliving e caffè</div>
              <div>• Eventi e conferenze per nomadi</div>
              <div>• Hotel e ostelli per nomadi digitali</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Nomad Community Testimonials -->
      <div class="text-center mb-12">
        <h3 class="text-3xl font-bold text-gray-900 mb-4">Cosa dicono i nostri lettori</h3>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">
          Storie reali di nomadi che usano i nostri contenuti per decisioni di viaggio importanti
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-6xl mx-auto">
        <!-- Ramon (MapMelon) -->
        <div class="bg-gradient-to-br from-yellow-50 to-orange-50 p-8 rounded-2xl border-2 border-yellow-200">
          <div class="flex items-center mb-4">
            <div>
              <h3 class="font-bold text-lg">Ramon Morcillo</h3>
              <p class="text-sm text-gray-600">Co-Founder @ MapMelon</p>
            </div>
          </div>
          <p class="text-gray-700 leading-relaxed">"Il numero è bellissimo, ho adorato sfogliarlo 🧡 Complimenti per l'ottimo lavoro e grazie ancora per averci inclusi!"</p>
        </div>

        <!-- Teresa (TripOffice) -->
        <div class="bg-gray-50 p-8 rounded-2xl">
          <div class="mb-4">
            <h3 class="font-bold text-lg">Teresa Zielonka</h3>
            <p class="text-sm text-gray-600">Co-Founder @ TripOffice.com</p>
          </div>
          <p class="text-gray-700 leading-relaxed">"Adoro la rivista! La qualità di stampa è eccellente, la carta è piacevole e la grafica è davvero straordinaria. Complimenti per una pubblicazione così fantastica!"</p>
          </div>
          
        <!-- Nomad Train -->
        <div class="bg-gray-50 p-8 rounded-2xl">
          <div class="mb-4">
            <img src="/images/nomad-train_logo_black.webp" alt="Nomad Train" class="h-8 object-contain mb-4" />
          </div>
          <p class="text-gray-700 leading-relaxed">"Nomad Magazine non è solo perfetta per il pubblico di Nomad Train, il team porta anche energia, creatività e cura. È stato un piacere collaborare 🚂"</p>
        </div>

        <!-- Nomad Reader (Japan/Fukuoka) -->
        <div class="bg-gradient-to-br from-green-50 to-emerald-50 p-8 rounded-2xl border-2 border-green-200">
          <div class="flex items-center mb-4">
            <div class="text-4xl mr-3">🇯🇵</div>
            <div>
              <h3 class="font-bold text-lg">Alex Thompson</h3>
              <p class="text-sm text-gray-600">Digital Nomad & Magazine Reader</p>
            </div>
          </div>
          <p class="text-gray-700 leading-relaxed">"Ho letto di Fukuoka su Nomad Magazine e ho prenotato subito i biglietti per il Giappone. Il racconto mi ha fatto innamorare della città prima ancora di arrivare. La miglior decisione di viaggio che abbia preso!"</p>
        </div>

        <!-- YouTube Video Viewer (Buenos Aires) -->
        <div class="bg-gradient-to-br from-blue-50 to-indigo-50 p-8 rounded-2xl border-2 border-blue-200">
          <div class="flex items-center mb-4">
            <div class="text-4xl mr-3">🇦🇷</div>
            <div>
              <h3 class="font-bold text-lg">Sarah Martinez</h3>
              <p class="text-sm text-gray-600">YouTube Viewer & Future Nomad</p>
            </div>
          </div>
          <p class="text-gray-700 leading-relaxed">"Il video ha risposto a tutte le mie domande e ai miei timori su Buenos Aires, ora mi sento pronta ad andare e a prendere i biglietti. Grazie per la guida completa di 33 minuti!"</p>
        </div>

        <!-- Newsletter Reader (Madeira) -->
        <div class="bg-gradient-to-br from-purple-50 to-pink-50 p-8 rounded-2xl border-2 border-purple-200">
          <div class="flex items-center mb-4">
            <div class="text-4xl mr-3">🇵🇹</div>
            <div>
              <h3 class="font-bold text-lg">Michael Chen</h3>
              <p class="text-sm text-gray-600">Newsletter Subscriber & Property Owner</p>
            </div>
          </div>
          <p class="text-gray-700 leading-relaxed">"Ho letto di Madeira e del Nomad Island Fest nella vostra newsletter, sono venuto a vedere il festival e alla fine ho comprato casa qui. La comunità e lo stile di vita mi hanno completamente conquistato!"</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Package Details -->
  <div class="bg-white" id="details">
    <section class="py-20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-4xl font-bold mb-6 md:text-5xl text-gray-900">Cosa ottieni davvero</h2>
          <p class="text-xl text-gray-700 max-w-3xl mx-auto mb-6">
            Risultati concreti che trasformano i nomadi in visitatori. Non solo visibilità—ma strumenti di conversione reali.
          </p>
          <div class="bg-yellow-50 rounded-xl p-6 max-w-4xl mx-auto border border-yellow-200">
            <p class="text-gray-800 text-lg">
              <strong>Scegli il livello di investimento:</strong> Silver, Gold o Platinum.
              Ogni livello si basa sul precedente con più contenuti, distribuzione e supporto marketing.
            </p>
          </div>
        </div>

        <div class="space-y-16 mb-16">
          <!-- Magazine Cover Feature -->
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
            <div class="order-2 lg:order-1">
              <div class="text-5xl mb-6">🏆</div>
              <h3 class="text-3xl font-bold mb-4 text-gray-900">Copertina della rivista</h3>
              <p class="text-gray-700 mb-6 text-lg">Italia e Palermo sulla copertina della nostra prossima edizione, illustrata da <a href="https://www.instagram.com/molly.creative" target="_blank" class="text-blue-600 hover:text-blue-800 hover:underline">Molly Maine</a>. Il motivo principale per farlo.</p>
              <div class="space-y-4">
                <div class="flex items-start">
                  <CheckIcon class="mr-3 h-6 w-6 text-green-600 flex-shrink-0 mt-1" />
                  <span class="text-gray-800">Copertina su misura di illustratrice rinomata</span>
              </div>
                <div class="flex items-start">
                  <CheckIcon class="mr-3 h-6 w-6 text-green-600 flex-shrink-0 mt-1" />
                  <span class="text-gray-800">Italia come destinazione protagonista</span>
              </div>
                <div class="flex items-start">
                  <CheckIcon class="mr-3 h-6 w-6 text-green-600 flex-shrink-0 mt-1" />
                  <span class="text-gray-800">Design professionale di qualità editoriale</span>
              </div>
            </div>
          </div>
            <div class="order-1 lg:order-2">
              <div class="bg-gradient-to-br from-yellow-50 to-orange-50 rounded-2xl p-6 shadow-xl">
                <img
                  src="/images/Italy-Palermo-cover-example3.webp"
                  alt="Esempio copertina Italia"
                  class="w-80 mx-auto rounded-lg shadow-2xl transform hover:scale-105 transition-transform duration-300"
                />
              </div>
              </div>
              </div>

          <!-- Collaborative Editorial Partnership -->
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
            <div class="order-1 lg:order-1">
              <div class="bg-gradient-to-br from-blue-50 to-indigo-50 rounded-2xl p-8 shadow-xl">
                <img
                  src="/images/edition-001-the-reals-nomad-of-mongolia.webp"
                  alt="Italy as Main Destination Feature Example"
                  class="w-full rounded-lg shadow-2xl transform hover:scale-105 transition-transform duration-300"
                />
            </div>
          </div>
            <div class="order-2 lg:order-2">
              <div class="text-5xl mb-6">📝</div>
              <h3 class="text-3xl font-bold mb-4 text-gray-900">Italia come destinazione principale</h3>
              <p class="text-gray-700 mb-6 text-lg leading-relaxed">
                Collaboriamo direttamente con il tuo Comune e le realtà locali per raccontare il meglio di Palermo e dell'Italia. Il nostro team editoriale cura interviste e ricerca per creare contenuti autentici e coinvolgenti, posizionando l'Italia come destinazione principale dell'intera edizione.
              </p>
              <div class="space-y-4">
                <div class="flex items-start">
                  <CheckIcon class="mr-3 h-6 w-6 text-green-600 flex-shrink-0 mt-1" />
                  <span class="text-gray-800">Italia protagonista in tutta l'edizione</span>
              </div>
                <div class="flex items-start">
                  <CheckIcon class="mr-3 h-6 w-6 text-green-600 flex-shrink-0 mt-1" />
                  <span class="text-gray-800">Interviste con imprenditori locali e istituzioni</span>
              </div>
                <div class="flex items-start">
                  <CheckIcon class="mr-3 h-6 w-6 text-green-600 flex-shrink-0 mt-1" />
                  <span class="text-gray-800">Ricerca approfondita a cura della redazione</span>
              </div>
                <div class="flex items-start">
                  <CheckIcon class="mr-3 h-6 w-6 text-green-600 flex-shrink-0 mt-1" />
                  <span class="text-gray-800">4-6 pagine di contenuti editoriali premium</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Custom Design -->
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
            <div class="order-2 lg:order-1">
              <div class="text-5xl mb-6">🎨</div>
              <h3 class="text-3xl font-bold mb-4 text-gray-900">Design su misura a cura di <a href="https://www.behance.net/estudiodrama-team" target="_blank" class="text-blue-600 hover:text-blue-800 hover:underline">Estudio Drama</a></h3>
              <p class="text-gray-700 mb-6 text-lg leading-relaxed">
                Ogni pagina è progettata su misura da <a href="https://www.behance.net/estudiodrama-team" target="_blank" class="text-blue-600 hover:text-blue-800 hover:underline">Estudio Drama</a> (Brasile).
                Creiamo impaginazioni che catturano l'essenza dell'Italia tramite fotografia d'autore o illustrazioni personalizzate—qualsiasi formato renda al meglio l'atmosfera unica di Palermo per i lettori.
              </p>
              <div class="space-y-4">
                <div class="flex items-start">
                  <CheckIcon class="mr-3 h-6 w-6 text-green-600 flex-shrink-0 mt-1" />
                  <span class="text-gray-800">Impaginazioni personalizzate specifiche per i tuoi contenuti</span>
              </div>
                <div class="flex items-start">
                  <CheckIcon class="mr-3 h-6 w-6 text-green-600 flex-shrink-0 mt-1" />
                  <span class="text-gray-800">Fotografia professionale o illustrazioni su misura</span>
              </div>
                <div class="flex items-start">
                  <CheckIcon class="mr-3 h-6 w-6 text-green-600 flex-shrink-0 mt-1" />
                  <span class="text-gray-800">Design di qualità editoriale che rende l'Italia tangibile</span>
              </div>
                <div class="flex items-start">
                  <CheckIcon class="mr-3 h-6 w-6 text-green-600 flex-shrink-0 mt-1" />
                  <span class="text-gray-800">Visual storytelling che risuona con i nomadi digitali</span>
            </div>
          </div>
