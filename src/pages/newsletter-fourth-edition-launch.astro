  { name: 'MeetCiao', url: 'https://meetciao.com/', logo: '/images/Ciao-Logo-black.webp', alt: 'U Ciao', category: 'COMMUNITY', description: 'Rent homes at local rates in a private community of travellers.' },
  { name: 'Nomad Tax Bulgaria', url: 'https://www.nomadtax.bg/', logo: '/images/NomadTax.webp', alt: 'Nomad Tax Bulgaria', category: 'LEGAL & TAXES', description: 'Company Registration, Residency, Accounting, Relocation.' },
  { name: 'Roamless', url: 'https://roamless.com/', logo: '/images/logo-roamless_black.webp', alt: 'Roamless', category: 'TRAVELTECH', description: 'eSIM and connectivity for travellers and digital nomads.' },
  { name: 'Swaphouse', url: 'https://swaphouse.io/', logo: '/images/logo-swaphouse.webp', alt: 'Swaphouse', category: 'COMMUNITY PLATFORM', description: 'Free home swapping platform for remote workers and digital nomads, making it easy to live and work in remote-friendly homes around the world without paying for accommodation.' },
