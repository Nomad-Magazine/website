  { name: 'SSBM Consulting', url: 'https://www.ssbmconsulting.com/', logo: 'https://cdn.files.smartsuite.com/security=p:eyJjYWxsIjogWyJyZWFkIiwgImNvbnZlcnQiXSwgImV4cGlyeSI6IDI0MDE4MDE0MDIuMzE2NDk1LCAiaGFuZGxlIjogImJIRU5MRFZDUnRla0wwZW15WHh2In0=,s:8180e7ab27aa47810be6e6526dde92d4df39081a3323a0bc6a6e22b98e43f5ca/bHENLDVCRtekL0emyXxv', alt: 'SSBM Consulting LLC' },
