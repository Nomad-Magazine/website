  const mobileMenuButton = document.getElementById('mobile-menu-button');
  const mobileSidebar = document.getElementById('mobile-sidebar');
  const mobileSidebarPanel = document.getElementById('mobile-sidebar-panel');
  const mobileSidebarClose = document.getElementById('mobile-sidebar-close');
  const mobileSidebarBackdrop = document.getElementById('mobile-sidebar-backdrop');

  function openMobileMenu() {
    mobileSidebar?.classList.remove('hidden');
    setTimeout(() => {
      mobileSidebarPanel?.classList.remove('-translate-x-full');
    }, 10);
  }

  function closeMobileMenu() {
    mobileSidebarPanel?.classList.add('-translate-x-full');
    setTimeout(() => {
      mobileSidebar?.classList.add('hidden');
    }, 300);
  }

  mobileMenuButton?.addEventListener('click', openMobileMenu);
  mobileSidebarClose?.addEventListener('click', closeMobileMenu);
  mobileSidebarBackdrop?.addEventListener('click', closeMobileMenu);

  // Close mobile menu when clicking nav links
  document.querySelectorAll('.mobile-nav-link').forEach(link => {
    link.addEventListener('click', closeMobileMenu);
  });

  // Smooth scrolling for anchor links
  document.querySelectorAll('a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', function (e) {
      e.preventDefault();
      const target = document.querySelector(this.getAttribute('href') || '');
      if (target) {
        target.scrollIntoView({
          behavior: 'smooth',
          block: 'start'
        });
      }
    });
  });

  // Floating propose change button functionality
  const floatingProposeBtn = document.getElementById('floating-propose-btn');
  
  floatingProposeBtn?.addEventListener('click', function() {
    const subject = encodeURIComponent('Digital Nomad Wiki - Propose Change');
    const body = encodeURIComponent(`Hi there,

I have a suggestion for the Digital Nomad Wiki:

Section/Chapter: [Please specify which section you're referring to]
Current URL: ${window.location.href}
Proposed Change: [Describe your suggested change]
Reason: [Why should this change be made?]

Thanks!`);
    
    window.location.href = `mailto:hello@nomad-magazine.com?subject=${subject}&body=${body}`;
  });

  // Hide floating button when the main propose changes section is visible
  const proposeChangesSection = document.querySelector('.bg-gray-50.border.border-gray-200.rounded-lg');
  
  if (proposeChangesSection && floatingProposeBtn) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            floatingProposeBtn.style.opacity = '0';
            floatingProposeBtn.style.pointerEvents = 'none';
          } else {
            floatingProposeBtn.style.opacity = '1';
            floatingProposeBtn.style.pointerEvents = 'auto';
          }
        });
      },
      { threshold: 0.1 }
    );
    
    observer.observe(proposeChangesSection);
  }
</script>
