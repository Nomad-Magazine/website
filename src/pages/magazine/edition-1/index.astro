---
export const prerender = true;

import Layout, { type SEOProps } from '~/layouts/Layout.astro'

// Articles with hasPage: true are linked, others show as "Coming Soon"
const articles = [
  {
    id: 'local-communities',
    title: "You're Screwing Over Local Communities",
    author: 'Stella Airoldi',
    authorRole: 'Founder of 22STARS & Social Impact Nomads',
    excerpt: "Critiques how digital nomads unintentionally harm local communities through gentrification and inflated prices, providing practical suggestions for more conscious and responsible travel.",
    coverImage: '/images/edition-001-local-communities-stella-airoldi.webp',
    readTime: '11 min read',
    category: 'Social Impact',
    hasPage: true
  },
  {
    id: 'dating-guide',
    title: 'What NOT to Do on a First Date in These 5 Countries',
    author: 'Marina Iakovleva',
    authorRole: 'Creator of Dating Beyond Borders',
    excerpt: "A cultural guide on dating etiquette across different countries, helping nomads navigate romantic connections while respecting local customs and avoiding embarrassing cultural mistakes.",
    coverImage: '/images/edition-001-dating-guide-marina-iakovleva.webp',
    readTime: '10 min read',
    category: 'Culture',
    hasPage: true
  },
  {
    id: 'insurance-truths',
    title: '4 Inconvenient Truths About Nomad Insurance',
    author: 'Christoph Huebner',
    authorRole: 'Founder of NOMADS.insure',
    excerpt: "Exposes common pitfalls and limitations of insurance options for nomads, revealing what insurance companies don't tell you and how to protect yourself while traveling long-term.",
    coverImage: '/images/edition-001-insurance-truths-christoph-huebner.webp',
    readTime: '15 min read',
    category: 'Finance',
    hasPage: true
  },
  {
    id: 'business-ai',
    title: 'Business and AI: A Match Made in Innovation?',
    author: 'Santiago Sosa',
    authorRole: 'Marketing Automation Expert',
    excerpt: "How AI is transforming the way nomads run lean and efficient businesses, exploring tools, strategies, and the future of automated entrepreneurship for location-independent professionals.",
    coverImage: '/images/edition-001-business-ai-santiago-sosa.webp',
    readTime: '12 min read',
    category: 'Business',
    hasPage: true
  },
  {
    id: 'wifi-less',
    title: 'The Good, the Bad, and the WiFi-less',
    author: 'Amy White',
    authorRole: 'Editor-in-Chief of Nomad Magazine',
    excerpt: "A witty, tongue-in-cheek essay on the perils of unreliable WiFi while living the digital nomad dream. Amy dramatizes the chaos of being cut off from the internet like a tragic romance.",
    coverImage: '/images/edition-001-wifi-less-amy-white.webp',
    readTime: '6 min read',
    category: 'Humor',
    hasPage: true
  },
  {
    id: 'mongolia-nomads',
    title: 'Real Nomads of Mongolia',
    author: 'Tijmen Hobbel',
    authorRole: 'Photographer & Videographer',
    excerpt: "This visual spread captures the authentic, grounded lifestyle of traditional Mongolian nomads—a stark contrast to WiFi-chasing digital workers. Horses roam freely, yurts rise on empty plains.",
    coverImage: '/images/edition-001-mongolia-nomads-tijmen-hobbel.webp',
    readTime: '5 min read',
    category: 'Photography',
    hasPage: true
  },
  {
    id: 'commitment-issues',
    title: 'The Real Reason Behind Commitment Issues',
    author: 'Bori Vigh',
    authorRole: 'Nomad Cruise Host & Podcast Creator',
    excerpt: "Explores the 'perfection-paradox' among nomads—fear of imperfection leads to difficulty in committing to locations, people, or projects. This deep dive reveals why nomads struggle with decisions and how to overcome the endless search for something better.",
    coverImage: '/images/edition-001-commitment-issues-bori-vigh.webp',
    readTime: '8 min read',
    category: 'Psychology',
    hasPage: false
  },
  {
    id: 'rat-race-to-freedom',
    title: 'From the Rat Race to Freedom',
    author: 'Tarek Kholoussy',
    authorRole: 'Founder of Nomads Giving Back',
    excerpt: "Tarek shares his transformative journey from corporate life to starting Nomads Giving Back, showing how to build a meaningful nomadic life focused on impact rather than just location independence.",
    coverImage: '/images/edition-001-rat-race-freedom-tarek-kholoussy.webp',
    readTime: '12 min read',
    category: 'Lifestyle',
    hasPage: false
  }
]

const seo: SEOProps = {
  title: 'Digital Magazine - Edition 1 | Nomad Magazine',
  description: 'Read the digital edition of Nomad Magazine Issue 1. Explore stories about commitment issues, freedom from corporate life, and more nomad insights.',
  image: '/images/edition-001-cover.avif',
  keywords: 'digital magazine, nomad magazine edition 1, digital nomad stories, online magazine',
  ogType: 'website',
  ldJSON: {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Digital Magazine - Edition 1 | Nomad Magazine',
    description: 'Read the digital edition of Nomad Magazine Issue 1. Explore stories about commitment issues, freedom from corporate life, and more nomad insights.',
    url: `${Astro.site}magazine/edition-1/`,
    mainEntity: {
      '@type': 'Product',
      name: 'Nomad Magazine Edition 001',
      description: 'The first Edition of Nomad Magazine with 100 pages of unique content about digital nomad lifestyle',
      image: `${Astro.site}images/edition-001-cover.avif`,
      brand: {
        '@type': 'Brand',
        name: 'Nomad Magazine',
      },
      offers: {
        '@type': 'Offer',
        price: '14.00',
        priceCurrency: 'EUR',
        availability: 'https://schema.org/InStock',
        url: `${Astro.site}editions/first-edition/`,
      },
    },
    publisher: {
      '@type': 'Organization',
      name: 'Nomad Magazine',
      logo: {
        '@type': 'ImageObject',
        url: `${Astro.site}logo.svg`,
      },
    },
  },
}
---

<Layout seo={seo}>
  <main class="min-h-screen bg-gradient-to-b from-gray-900 to-black text-white">
    <!-- Hero Section -->
    <section class="relative overflow-hidden py-20">
      <div class="container mx-auto px-4">
        <div class="flex flex-col items-center text-center">
          <div class="mb-8">
            <img 
              src="/images/edition-001-cover.avif" 
              alt="Nomad Magazine Edition 1 Cover"
              class="h-80 w-auto rounded-lg shadow-2xl shadow-yellow-400/20"
            />
          </div>
          <h1 class="mb-4 text-5xl font-bold text-yellow-400 md:text-6xl">
            Edition 1
          </h1>
          <p class="mb-8 max-w-2xl text-xl text-gray-300">
            Digital Nomadism - The first edition of Nomad Magazine with authentic stories from the road
          </p>
          <div class="flex items-center gap-4 text-sm text-gray-400">
            <span>100 Pages</span>
            <span>•</span>
            <span>{articles.length} Featured Articles</span>
            <span>•</span>
            <span>Digital Edition</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Magazine Layout -->
    <section class="py-16">
      <div class="container mx-auto px-4">
        <!-- Magazine Header -->
        <div class="mb-16 text-center">
          <div class="mb-4 flex items-center justify-center gap-4">
            <div class="h-px w-16 bg-yellow-400"></div>
            <span class="text-sm font-medium uppercase tracking-widest text-yellow-400">Table of Contents</span>
            <div class="h-px w-16 bg-yellow-400"></div>
          </div>
          <h2 class="text-4xl font-bold text-white md:text-5xl">Inside This Issue</h2>
        </div>
        
        <!-- Featured Article (Hero) -->
        <div class="mb-16">
          <a href={`/magazine/edition-1/${articles[0].id}`} class="group block">
            <article class="relative overflow-hidden rounded-2xl bg-gradient-to-r from-gray-900 to-gray-800">
              <div class="grid lg:grid-cols-2 lg:gap-0">
                <!-- Image -->
                <div class="relative aspect-[4/3] lg:aspect-auto overflow-hidden">
                  <img 
                    src={articles[0].coverImage} 
                    alt={articles[0].title}
                    class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent lg:bg-gradient-to-r"></div>
                </div>
                
                <!-- Content -->
                <div class="relative p-8 lg:p-12 flex flex-col justify-center">
                  <div class="mb-4 flex items-center gap-4">
                    <span class="rounded-full bg-yellow-400 px-4 py-2 text-xs font-bold text-black uppercase tracking-wide">
                      Featured
                    </span>
                    <span class="text-sm text-gray-400">{articles[0].readTime}</span>
                  </div>
                  
                  <h3 class="mb-4 text-3xl font-bold leading-tight text-white group-hover:text-yellow-400 transition-colors lg:text-4xl">
                    {articles[0].title}
                  </h3>
                  
                  <p class="mb-6 text-gray-300 leading-relaxed lg:text-lg">
                    {articles[0].excerpt}
                  </p>
                  
                  <div class="flex items-center gap-4">
                    <div class="flex-1">
                      <p class="font-semibold text-white">{articles[0].author}</p>
                      <p class="text-sm text-gray-400">{articles[0].authorRole}</p>
                    </div>
                    <div class="flex items-center gap-2 text-yellow-400 group-hover:gap-4 transition-all">
                      <span class="text-sm font-medium">Read Article</span>
                      <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                      </svg>
                    </div>
                  </div>
                </div>
              </div>
            </article>
          </a>
        </div>

        <!-- Magazine Grid Layout -->
        <div class="grid gap-8 lg:grid-cols-3 lg:gap-12">
          <!-- Left Column - Large Articles -->
          <div class="lg:col-span-2 space-y-8">
            {articles.slice(1, 5).map((article, index) => (
              <a href={`/magazine/edition-1/${article.id}`} class="group block">
                <article class="grid md:grid-cols-5 gap-6 items-center p-6 rounded-xl bg-gray-900/50 backdrop-blur-sm border border-gray-800 hover:border-yellow-400/30 transition-all duration-300">
                  <!-- Article Number -->
                  <div class="hidden md:block text-center">
                    <div class="text-4xl font-bold text-yellow-400/30 group-hover:text-yellow-400 transition-colors">
                      {String(index + 2).padStart(2, '0')}
                    </div>
                  </div>
                  
                  <!-- Image -->
                  <div class="md:col-span-2">
                    <div class="aspect-[16/10] overflow-hidden rounded-lg">
                      <img 
                        src={article.coverImage} 
                        alt={article.title}
                        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                      />
                    </div>
                  </div>
                  
                  <!-- Content -->
                  <div class="md:col-span-2 space-y-3">
                    <div class="flex items-center gap-3">
                      <span class="rounded-full bg-gray-700 px-3 py-1 text-xs font-medium text-gray-300 uppercase tracking-wide">
                        {article.category}
                      </span>
                      <span class="text-xs text-gray-500">{article.readTime}</span>
                    </div>
                    
                    <h3 class="text-xl font-bold text-white group-hover:text-yellow-400 transition-colors leading-tight">
                      {article.title}
                    </h3>
                    
                    <p class="text-sm text-gray-400 leading-relaxed line-clamp-3">
                      {article.excerpt}
                    </p>
                    
                    <div class="pt-2">
                      <p class="text-sm font-medium text-white">{article.author}</p>
                      <p class="text-xs text-gray-500">{article.authorRole}</p>
                    </div>
                  </div>
                </article>
              </a>
            ))}
          </div>

          <!-- Right Sidebar -->
          <div class="space-y-8">
            <!-- Quick Reads Section -->
            <div class="rounded-xl bg-gradient-to-b from-gray-900 to-gray-800 p-6 border border-gray-700">
              <h3 class="mb-6 text-xl font-bold text-white flex items-center gap-2">
                <svg class="h-5 w-5 text-yellow-400" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                </svg>
                Quick Reads
              </h3>
              
              <div class="space-y-4">
                {articles.slice(5).map((article) => (
                  article.hasPage ? (
                    <a href={`/magazine/edition-1/${article.id}`} class="group block">
                      <article class="flex gap-4 p-4 rounded-lg bg-gray-800/50 hover:bg-gray-800 transition-colors">
                        <div class="flex-shrink-0">
                          <img 
                            src={article.coverImage} 
                            alt={article.title}
                            class="h-16 w-16 rounded-lg object-cover"
                          />
                        </div>
                        <div class="flex-1 min-w-0">
                          <div class="mb-1 flex items-center gap-2">
                            <span class="text-xs text-yellow-400 font-medium">{article.category}</span>
                            <span class="text-xs text-gray-500">•</span>
                            <span class="text-xs text-gray-500">{article.readTime}</span>
                          </div>
                          <h4 class="font-semibold text-white group-hover:text-yellow-400 transition-colors text-sm leading-tight mb-2">
                            {article.title}
                          </h4>
                          <p class="text-xs text-gray-400">{article.author}</p>
                        </div>
                      </article>
                    </a>
                  ) : (
                    <div class="block opacity-75">
                      <article class="flex gap-4 p-4 rounded-lg bg-gray-800/50">
                        <div class="flex-shrink-0 relative">
                          <img 
                            src={article.coverImage} 
                            alt={article.title}
                            class="h-16 w-16 rounded-lg object-cover grayscale"
                          />
                        </div>
                        <div class="flex-1 min-w-0">
                          <div class="mb-1 flex items-center gap-2">
                            <span class="text-xs text-gray-500 font-medium">{article.category}</span>
                            <span class="text-xs text-gray-500">•</span>
                            <span class="text-xs bg-gray-700 text-gray-300 px-2 py-0.5 rounded-full">Coming Soon</span>
                          </div>
                          <h4 class="font-semibold text-gray-400 text-sm leading-tight mb-2">
                            {article.title}
                          </h4>
                          <p class="text-xs text-gray-500">{article.author}</p>
                        </div>
                      </article>
                    </div>
                  )
                ))}
              </div>
            </div>

            <!-- Magazine Info -->
            <div class="rounded-xl bg-gradient-to-b from-yellow-400/10 to-orange-500/10 p-6 border border-yellow-400/20">
              <h3 class="mb-4 text-lg font-bold text-white">About This Issue</h3>
              <div class="space-y-3 text-sm text-gray-300">
                <div class="flex justify-between">
                  <span>Pages:</span>
                  <span class="font-medium text-white">100</span>
                </div>
                <div class="flex justify-between">
                  <span>Articles:</span>
                  <span class="font-medium text-white">{articles.length}</span>
                </div>
                <div class="flex justify-between">
                  <span>Published:</span>
                  <span class="font-medium text-white">2024</span>
                </div>
                <div class="flex justify-between">
                  <span>Edition:</span>
                  <span class="font-medium text-yellow-400">First Issue</span>
                </div>
              </div>
              
              <div class="mt-6 pt-4 border-t border-yellow-400/20">
                <a 
                  href="/editions/first-edition/"
                  class="block w-full rounded-lg bg-yellow-400 px-4 py-3 text-center font-semibold text-black transition-all hover:bg-yellow-300"
                >
                  Get Full Magazine
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Coming Soon Section -->
    <section class="py-16 bg-gray-900/50">
      <div class="container mx-auto px-4 text-center">
        <h3 class="mb-4 text-2xl font-bold text-white">More Articles Coming Soon</h3>
        <p class="text-gray-400 max-w-2xl mx-auto">
          We're working on bringing you more articles from this edition. 
          Check back soon for stories about nomad insurance, dating guides, AI in business, and more.
        </p>
      </div>
    </section>

    <!-- Back to Editions -->
    <section class="py-12 border-t border-gray-800">
      <div class="container mx-auto px-4 text-center">
        <a
          href="/editions/"
          aria-label="Navigate back to all magazine editions"
          class="inline-flex items-center gap-2 text-yellow-400 hover:text-yellow-300 transition-colors"
        >
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
          </svg>
          Back to All Editions
        </a>
      </div>
    </section>
  </main>
</Layout>

<style>
  /* Add smooth scrolling and enhanced hover effects */
  html {
    scroll-behavior: smooth;
  }
  
  /* Magazine-style typography */
  .magazine-number {
    font-family: 'Inter', sans-serif;
    font-feature-settings: 'tnum' on, 'lnum' on;
  }
  
  /* Line clamp utility */
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  /* Enhanced shadows for magazine feel */
  .magazine-card {
    box-shadow: 
      0 4px 20px rgba(0, 0, 0, 0.3),
      inset 0 1px 0 rgba(255, 255, 255, 0.05);
  }
  
  .magazine-card:hover {
    box-shadow: 
      0 8px 30px rgba(251, 191, 36, 0.15),
      0 4px 20px rgba(0, 0, 0, 0.4),
      inset 0 1px 0 rgba(255, 255, 255, 0.1);
  }
  
  /* Magazine grid animations */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  .magazine-card {
    animation: fadeInUp 0.6s ease-out;
  }
  
  .magazine-card:nth-child(2) { animation-delay: 0.1s; }
  .magazine-card:nth-child(3) { animation-delay: 0.2s; }
  .magazine-card:nth-child(4) { animation-delay: 0.3s; }
  .magazine-card:nth-child(5) { animation-delay: 0.4s; }
  
  /* Typography improvements */
  .magazine-title {
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.025em;
  }
  
  .magazine-excerpt {
    line-height: 1.6;
    font-weight: 400;
  }
  
  /* Decorative elements */
  .table-of-contents::before,
  .table-of-contents::after {
    content: '';
    height: 1px;
    background: linear-gradient(90deg, transparent, #fbbf24, transparent);
  }
</style>
