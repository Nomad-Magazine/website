---
export const prerender = true;

import Layout, { type SEOProps } from '~/layouts/Layout.astro'
import ComingSoonArticle from '~/components/ComingSoonArticle.astro'

const seo: SEOProps = {
  title: '4 Inconvenient Truths About Nomad Insurance | Nomad Magazine',
  description: "Exposes common pitfalls and limitations of insurance options for nomads, revealing what insurance companies don't tell you.",
  image: '/images/edition-001-insurance-truths-christoph-huebner.webp',
  keywords: 'nomad insurance, travel insurance, digital nomad insurance, nomad health coverage',
  ogType: 'article'
}
---

<Layout seo={seo}>
