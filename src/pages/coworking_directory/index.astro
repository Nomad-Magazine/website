---
export const prerender = true;

import { fetchReportRecords } from '~/utils/smartsuite'
import Layout, { type SEOProps } from '~/layouts/Layout.astro'
import MaterialSymbolsElectricBolt from '~icons/material-symbols/electric-bolt'
import ImageModal from '~/components/ImageModal.astro'

const COUNTRY_TO_CONTINENT: Record<string, string> = {
  Portugal: 'Europe', Spain: 'Europe', Italy: 'Europe', France: 'Europe',
  Germany: 'Europe', 'United Kingdom': 'Europe', Netherlands: 'Europe',
  Greece: 'Europe', Bulgaria: 'Europe', Hungary: 'Europe', Ireland: 'Europe',
  Slovenia: 'Europe', Croatia: 'Europe', Slovakia: 'Europe', Austria: 'Europe',
  Poland: 'Europe', Malta: 'Europe', Belgium: 'Europe', Switzerland: 'Europe',
  Japan: 'Asia', Thailand: 'Asia', Vietnam: 'Asia', Indonesia: 'Asia',
  India: 'Asia', Philippines: 'Asia', 'South Korea': 'Asia', Taiwan: 'Asia',
  Argentina: 'South America', Colombia: 'South America', Brazil: 'South America',
  'Costa Rica': 'Central America', Mexico: 'North America',
  USA: 'North America', Canada: 'North America',
  Morocco: 'Africa', 'South Africa': 'Africa',
}
const COUNTRY_ALIASES: Record<string, string> = {
  NL: 'Netherlands', 'The Netherlands': 'Netherlands',
  Slovenija: 'Slovenia', UK: 'United Kingdom', Bali: 'Indonesia',
}
function normalizeCountry(raw: string): string { return COUNTRY_ALIASES[raw] || raw }
function extractCountry(location: string): string {
  if (!location) return ''
  const parts = location.split(',')
  if (parts.length >= 2) return normalizeCountry(parts[parts.length - 1].trim())
  const words = location.trim().split(/\s+/)
  const last = normalizeCountry(words[words.length - 1])
  if (COUNTRY_TO_CONTINENT[last]) return last
  return normalizeCountry(location.trim())
}
function slugify(str: string): string {
  return str.toLowerCase().replace(/&/g, 'and').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')
}

const { records = [] } = await fetchReportRecords('68614a111208586bd05d3c3a')

const coworkingLocations = records
  .filter((r: any) => {
    if (!r.s43a4b2808 || !r.title) return false
    const cat = (r.sb685ab800?.label || '').toLowerCase()
    return cat.includes('cowork') || cat === 'space' || cat === 'hub'
  })
  .map((r: any) => {
    const websiteDesc = r.scea90e502 || ''
    const fullDesc = r.description_markdown || ''
    const description = websiteDesc && fullDesc
      ? websiteDesc + '\n\n' + fullDesc
      : websiteDesc || fullDesc || ''
    const rawImages = [r.image, r.images, r.sf4ad525dd, r.s4ad525dd]
      .filter(Boolean).flat().filter(Boolean)
    const images = [...new Set(rawImages)] as string[]
    const loc = r.sed1a49986 || ''
    const country = extractCountry(loc)
    return {
      id: r.id,
      name: r.title,
      description,
      city: loc.includes(',') ? loc.split(',')[0].trim() : '',
      country,
      continent: COUNTRY_TO_CONTINENT[country] || '',
      website_url: r.sb788c266b?.[0] || null,
      google_maps_url: r.s2d652f699 || null,
      images,
      category: r.sb685ab800?.label || '',
      discount_code: r.s9c0ff01ed || null,
      created_at: r.first_created?.on || new Date().toISOString(),
    }
  })
  .sort((a: any, b: any) => new Date(b.created_at).getTime() - new Date(a.created_at).getTime())

// Build location nav for sub-pages
const countryCounts: Record<string, number> = {}
const continentCounts: Record<string, number> = {}
coworkingLocations.forEach((s: any) => {
  if (s.country) countryCounts[s.country] = (countryCounts[s.country] || 0) + 1
  if (s.continent) continentCounts[s.continent] = (continentCounts[s.continent] || 0) + 1
})
const continentLinks = Object.entries(continentCounts).sort((a, b) => b[1] - a[1])
const countryLinks = Object.entries(countryCounts).sort((a, b) => b[1] - a[1])

const seo: SEOProps = {
  title: 'Coworking Directory - Nomad-Friendly Spaces Worldwide',
  description:
    'Find the best coworking spaces worldwide trusted by digital nomads. Browse nomad-friendly workspaces with fast WiFi, community events, and flexible memberships.',
  image: `${Astro.site}images/distribution-list-sowo-office-reference.webp`,
  keywords: 'coworking spaces, nomad coworking, digital nomad workspace, coworking directory, remote work spaces, coworking worldwide',
  ogType: 'website',
  ldJSON: {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Coworking Directory',
    description: 'Directory of coworking spaces trusted by digital nomads worldwide.',
    url: `${Astro.site}coworking_directory/`,
    publisher: {
      '@type': 'Organization',
      name: 'Nomad Magazine',
      logo: { '@type': 'ImageObject', url: `${Astro.site}logo.svg` },
    },
  },
}
---

<Layout seo={seo}>
  <div class="bg-hoverw text-white min-h-screen">
    <!-- Hero -->
    <section class="pt-16 pb-8">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto text-center mb-10">
          <h1 class="text-4xl leading-tight font-bold md:text-6xl mb-4">
            Coworking <span class="text-yellow-400">Directory</span>
          </h1>
          <p class="text-lg text-gray-300 mb-2">
            Nomad-trusted coworking spaces from our physical magazine distribution network
          </p>
          <p class="text-sm text-gray-400">
            Every space listed here hosts Nomad Magazine — a signal they care about the remote work community
          </p>
        </div>

        <!-- Search -->
        <div class="max-w-2xl mx-auto">
          <div class="relative mb-4">
            <input type="text" id="search-input"
              placeholder="Search by name, city, or country..."
              aria-label="Search coworking spaces"
              class="w-full px-4 py-3 pl-12 bg-white/10 border border-white/20 rounded-xl text-white placeholder-gray-400 focus:outline-none focus:border-yellow-400 focus:bg-white/15 transition-all duration-200" />
            <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
          </div>
          <!-- Stats -->
          <div class="flex items-center justify-center gap-6 text-sm text-gray-400 mb-6">
            <div class="flex items-center gap-2">
              <span class="text-2xl font-bold text-yellow-400" id="stat-spaces">0</span>
              <span>Spaces</span>
            </div>
            <span class="text-gray-600">·</span>
            <div class="flex items-center gap-2">
              <span class="text-2xl font-bold text-yellow-400" id="stat-cities">0</span>
              <span>Cities</span>
            </div>
            <span class="text-gray-600">·</span>
            <div class="flex items-center gap-2">
              <span class="text-2xl font-bold text-yellow-400" id="stat-countries">0</span>
              <span>Countries</span>
            </div>
          </div>
        </div>

        <!-- Browse by Location (links to static SEO sub-pages) -->
        {continentLinks.length > 0 && (
          <div class="max-w-4xl mx-auto mb-4">
            <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider text-center mb-3">Browse by Continent</p>
            <div class="flex flex-wrap justify-center gap-2">
              {continentLinks.map(([continent, count]) => (
                <a href={`/coworking_directory/${slugify(continent)}/`}
                  class="inline-flex items-center gap-1.5 px-4 py-2 bg-white/10 hover:bg-yellow-400 hover:text-black border border-white/20 hover:border-yellow-400 rounded-full text-sm font-medium text-white transition-all duration-200">
                  {continent}
                  <span class="px-1.5 py-0.5 bg-white/20 rounded-full text-xs">{count}</span>
                </a>
              ))}
            </div>
          </div>
        )}
        {countryLinks.length > 0 && (
          <div class="max-w-4xl mx-auto mb-6">
            <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider text-center mb-3">Browse by Country</p>
            <div class="flex flex-wrap justify-center gap-2">
              {countryLinks.map(([country, count]) => (
                <a href={`/coworking_directory/${slugify(country)}/`}
                  class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white/10 hover:bg-yellow-400 hover:text-black border border-white/20 hover:border-yellow-400 rounded-full text-sm font-medium text-white transition-all duration-200">
                  {country}
                  <span class="px-1.5 py-0.5 bg-white/20 rounded-full text-xs">{count}</span>
                </a>
              ))}
            </div>
          </div>
        )}

        <!-- City Pills (in-page filter) -->
        <div class="max-w-4xl mx-auto">
          <div id="city-pills" class="flex flex-wrap justify-center gap-2 mb-2"></div>
          <div class="text-center">
            <button id="toggle-cities" class="text-sm text-yellow-400 hover:text-yellow-300 transition-colors hidden">
              Show All Cities →
            </button>
          </div>
        </div>
      </div>
    </section>

    <!-- Grid -->
    <section class="px-4 py-8 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-5xl">
        <div id="loading-spinner" class="text-center py-12">
          <div class="inline-block animate-spin rounded-full h-8 w-8 border-b-2 border-yellow-400"></div>
          <p class="mt-2 text-neutral-400 text-sm">Loading spaces...</p>
        </div>

        <div id="spaces-grid" class="hidden grid-cols-1 lg:grid-cols-2 gap-3"></div>

        <div id="no-results" class="text-center py-12 hidden">
          <p class="text-xl text-neutral-400">No coworking spaces found matching your search.</p>
        </div>

        <div id="load-more-container" class="text-center mt-8 hidden">
          <button id="load-more-btn"
            class="px-8 py-3 bg-white/10 hover:bg-white/20 border border-white/20 rounded-xl text-white font-medium transition-all duration-200">
            Load More
          </button>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="pb-20">
      <div class="container mx-auto px-4 max-w-5xl">
        <div class="bg-yellow-400/10 border border-yellow-400/20 rounded-2xl p-10 text-center">
          <h2 class="text-2xl font-bold text-white mb-3">
            Get Your Coworking Space Listed — Free
          </h2>
          <p class="text-gray-300 mb-6 max-w-xl mx-auto">
            Host Nomad Magazine and get featured in our directory. We ship 5 free copies to coworking spaces, colivings, and nomad-friendly cafes.
          </p>
          <a href="/coworking-coliving-shipments/"
            class="inline-flex items-center gap-2 bg-black hover:bg-gray-900 border-2 border-yellow-400 px-8 py-3 rounded-lg text-yellow-400 font-bold text-lg transition-all duration-200">
            <MaterialSymbolsElectricBolt width="20" height="20" />
            Get Free Magazines
          </a>
        </div>
      </div>
    </section>

    <ImageModal />

    <!-- Data passed from server to client -->
    <div id="coworking-data" hidden data-items={JSON.stringify(coworkingLocations)}></div>
  </div>
</Layout>

<script is:inline>
  const ITEMS_PER_PAGE = 20;
  const INITIAL_CITIES = 12;

  const _dataEl = document.getElementById('coworking-data');
  let allSpaces = _dataEl ? JSON.parse(_dataEl.getAttribute('data-items')) : [];
  let filteredSpaces = [];
  let displayedCount = ITEMS_PER_PAGE;
  let currentSearch = '';
  let showingAllCities = false;

  function esc(str) {
    return String(str || '')
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }

  function renderCard(loc) {
    const desc = loc.description || '';
    const shouldTruncate = desc.length > 160;
    const shortDesc = shouldTruncate ? desc.slice(0, 160) : desc;
    const descId = 'dloc-' + loc.id;
    const thumbUrl = loc.images && loc.images.length > 0 ? loc.images[0] : null;
    const locText = [loc.city, loc.country].filter(Boolean).join(', ');

    const thumbHtml = thumbUrl
      ? '<div class="shrink-0 w-24 h-20 rounded-lg overflow-hidden bg-neutral-800"><img src="' + esc(thumbUrl) + '" alt="' + esc(loc.name) + '" class="w-full h-full object-cover cursor-pointer" data-img="' + esc(thumbUrl) + '" data-loc="' + esc(loc.name) + '" loading="lazy" /></div>'
      : '<div class="shrink-0 w-24 h-20 rounded-lg bg-neutral-800 flex items-center justify-center"><svg class="w-7 h-7 text-neutral-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-2 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg></div>';

    return '<div class="group flex items-start gap-4 p-4 bg-white/5 border border-white/10 rounded-xl hover:bg-white/8 transition-all duration-200">' +
      thumbHtml +
      '<div class="flex-1 min-w-0">' +
        '<div class="flex items-start justify-between gap-2 mb-1">' +
          '<h3 class="font-bold text-white text-sm leading-tight group-hover:text-yellow-400 transition-colors">' + esc(loc.name) + '</h3>' +
          (loc.category ? '<span class="shrink-0 bg-blue-600/20 text-blue-400 px-2 py-0.5 rounded-full text-xs font-medium border border-blue-600/30">' + esc(loc.category) + '</span>' : '') +
        '</div>' +
        (locText ? '<p class="text-xs text-gray-400 mb-1">\u{1f4cd} ' + esc(locText) + '</p>' : '') +
        '<p id="' + descId + '" class="text-xs text-gray-300 leading-relaxed">' + esc(shortDesc) + (shouldTruncate ? '\u2026' : '') + '</p>' +
        (shouldTruncate ? '<button class="read-more-btn text-xs text-yellow-400 hover:text-yellow-300 transition-colors mt-0.5" data-id="' + descId + '" data-full="' + esc(desc) + '" data-short="' + esc(shortDesc) + '">Read more \u2192</button>' : '') +
        (loc.discount_code ? '<p class="mt-1 text-xs text-yellow-400 font-medium">Code: <span class="font-mono font-bold">' + esc(loc.discount_code) + '</span></p>' : '') +
        '<div class="flex items-center gap-3 mt-2">' +
          (loc.google_maps_url ? '<a href="' + esc(loc.google_maps_url) + '" target="_blank" rel="noopener noreferrer" aria-label="Directions to ' + esc(loc.name) + ' (opens in new tab)" class="text-xs text-yellow-400 hover:text-yellow-300 font-medium transition-colors">Directions \u2192</a>' : '') +
          (loc.website_url ? '<a href="' + esc(loc.website_url) + '" target="_blank" rel="noopener noreferrer" aria-label="' + esc(loc.name) + ' website (opens in new tab)" class="text-xs text-gray-400 hover:text-gray-300 transition-colors truncate max-w-36">\u{1f310} ' + esc(loc.website_url.replace(/^https?:\/\/(www\.)?/, '').split('/')[0]) + '</a>' : '') +
        '</div>' +
      '</div></div>';
  }

  function renderGrid() {
    const grid = document.getElementById('spaces-grid');
    const spinner = document.getElementById('loading-spinner');
    const noResults = document.getElementById('no-results');
    const loadMoreContainer = document.getElementById('load-more-container');
    const loadMoreBtn = document.getElementById('load-more-btn');

    if (spinner) spinner.classList.add('hidden');
    const toShow = filteredSpaces.slice(0, displayedCount);

    if (filteredSpaces.length === 0) {
      if (grid) { grid.classList.add('hidden'); grid.style.display = ''; }
      if (noResults) noResults.classList.remove('hidden');
      if (loadMoreContainer) loadMoreContainer.classList.add('hidden');
      return;
    }

    if (noResults) noResults.classList.add('hidden');
    if (grid) { grid.classList.remove('hidden'); grid.style.display = 'grid'; }
    if (grid) grid.innerHTML = toShow.map(renderCard).join('');

    const remaining = filteredSpaces.length - displayedCount;
    if (loadMoreContainer) loadMoreContainer.classList.toggle('hidden', remaining <= 0);
    if (loadMoreBtn && remaining > 0) loadMoreBtn.textContent = 'Load More (' + remaining + ' more)';

    setupInteractions();
  }

  function setupInteractions() {
    document.querySelectorAll('.read-more-btn').forEach(btn => {
      btn.addEventListener('click', e => {
        e.stopPropagation();
        const el = document.getElementById(btn.dataset.id);
        if (!el) return;
        if (btn.textContent.includes('Read more')) {
          el.textContent = btn.dataset.full;
          btn.textContent = 'Show less';
        } else {
          el.textContent = btn.dataset.short + '\u2026';
          btn.textContent = 'Read more \u2192';
        }
      });
    });
    document.querySelectorAll('img[data-img]').forEach(img => {
      img.addEventListener('click', e => {
        e.stopPropagation();
        if (window.openImageModal) window.openImageModal(img.dataset.loc, [img.dataset.img], 0);
      });
    });
  }

  function applyFilters() {
    filteredSpaces = allSpaces.filter(loc => {
      if (!currentSearch) return true;
      const text = (loc.name + ' ' + loc.description + ' ' + loc.city + ' ' + loc.country).toLowerCase();
      return text.includes(currentSearch);
    });
    displayedCount = ITEMS_PER_PAGE;
    renderGrid();
  }

  function updateStats() {
    const cities = new Set(allSpaces.map(l => l.city).filter(Boolean)).size;
    const countries = new Set(allSpaces.map(l => l.country).filter(Boolean)).size;
    const statSpaces = document.getElementById('stat-spaces');
    const statCities = document.getElementById('stat-cities');
    const statCountries = document.getElementById('stat-countries');
    if (statSpaces) statSpaces.textContent = allSpaces.length;
    if (statCities) statCities.textContent = cities;
    if (statCountries) statCountries.textContent = countries;
  }

  function buildCityPills() {
    const cityCounts = {};
    allSpaces.forEach(loc => {
      if (!loc.city) return;
      const key = loc.city + ', ' + loc.country;
      cityCounts[key] = (cityCounts[key] || 0) + 1;
    });
    const sorted = Object.entries(cityCounts).sort((a, b) => b[1] - a[1]);
    const container = document.getElementById('city-pills');
    const toggleBtn = document.getElementById('toggle-cities');
    if (!container) return;

    function renderPills(limit) {
      const toShow = limit ? sorted.slice(0, limit) : sorted;
      container.innerHTML = toShow.map(([cityCountry, count]) => {
        const city = cityCountry.split(', ')[0];
        return '<button class="city-pill px-3 py-1.5 bg-white/10 hover:bg-yellow-400 hover:text-black border border-white/20 hover:border-yellow-400 rounded-full text-sm font-medium text-white transition-all duration-200 flex items-center gap-1.5" data-city="' + esc(city) + '">' +
          '<svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/></svg>' +
          '<span>' + esc(city) + '</span>' +
          '<span class="px-1.5 py-0.5 bg-white/20 rounded-full text-xs">' + count + '</span>' +
          '</button>';
      }).join('');
      container.querySelectorAll('.city-pill').forEach(pill => {
        pill.addEventListener('click', () => {
          const si = document.getElementById('search-input');
          if (si) si.value = pill.dataset.city;
          currentSearch = pill.dataset.city.toLowerCase();
          applyFilters();
          document.getElementById('spaces-grid')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      });
    }

    renderPills(INITIAL_CITIES);

    if (sorted.length > INITIAL_CITIES && toggleBtn) {
      toggleBtn.classList.remove('hidden');
      toggleBtn.addEventListener('click', () => {
        showingAllCities = !showingAllCities;
        renderPills(showingAllCities ? null : INITIAL_CITIES);
        toggleBtn.textContent = showingAllCities ? 'Show Less \u2190' : 'Show All Cities \u2192';
      });
    }
  }

  function init() {
    updateStats();
    buildCityPills();
    applyFilters();

    const si = document.getElementById('search-input');
    if (si) si.addEventListener('input', e => {
      currentSearch = e.target.value.toLowerCase().trim();
      applyFilters();
    });

    const lmb = document.getElementById('load-more-btn');
    if (lmb) lmb.addEventListener('click', () => {
      displayedCount += ITEMS_PER_PAGE;
      renderGrid();
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>
