---
import { fetchReportRecords } from '~/utils/smartsuite'

// Fetch nomad directory records
const { records = [] } = await fetchReportRecords('6857167d82358a0f5e038c3f')

// Get latest 13 directory listings with proper filtering
const latestListings = records
  .filter((record: any) => record.image && record.title && record.scea90e502)
  .slice(0, 13)

// Get tomorrow's date for the newsletter
const tomorrow = new Date()
tomorrow.setDate(tomorrow.getDate() + 1)
const newsletterDate = tomorrow.toLocaleDateString('en-US', { 
  weekday: 'long', 
  year: 'numeric', 
  month: 'long', 
  day: 'numeric' 
})
---

