<script is:inline src="https://cdn.jsdelivr.net/npm/html-to-image@1.11.11/dist/html-to-image.js"></script>

<script>
  const select = document.getElementById('listing-filter') as HTMLSelectElement | null
  const sections = document.querySelectorAll<HTMLElement>('.listing-section')

  select?.addEventListener('change', () => {
    const val = select.value
    sections.forEach((section) => {
      if (val === 'all') {
        section.style.display = ''
        return
      }
      if (val === 'batch') {
        section.style.display = section.dataset.slug === 'batch' ? '' : 'none'
        return
      }
      section.style.display = section.dataset.slug === val ? '' : 'none'
    })
    if (val === 'batch') {
      document.getElementById('listing-batch')?.scrollIntoView({ behavior: 'smooth', block: 'start' })
    } else if (val !== 'all') {
      document.getElementById(`listing-${CSS.escape(val)}`)?.scrollIntoView({ behavior: 'smooth', block: 'start' })
    }
  })

  document.addEventListener('click', async (e: MouseEvent) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.copy-text-btn')
    if (btn) {
      const block = btn.closest<HTMLElement>('.copy-block')
      const textarea = block?.querySelector<HTMLTextAreaElement>('.copy-textarea')
      if (!textarea) return
      try {
        await navigator.clipboard.writeText(textarea.value)
        const orig = btn.textContent
        btn.textContent = '✓ Copied!'
        setTimeout(() => { btn.textContent = orig }, 2000)
      } catch {
        textarea.select()
        document.execCommand('copy')
      }
      return
    }

    const dlBtn = (e.target as HTMLElement).closest<HTMLButtonElement>('.download-btn')
    if (!dlBtn) return

    const wrapper = dlBtn.closest<HTMLElement>('.card-wrapper')
    const card = wrapper?.querySelector<HTMLElement>('.card-capture')
    if (!card) return

    const filename = dlBtn.dataset.filename ?? 'social-card.png'
    const targetWidth = parseInt(dlBtn.dataset.width ?? '1080', 10)
    const pixelRatio = targetWidth / card.offsetWidth
    const originalText = dlBtn.textContent ?? '↓ PNG'

    dlBtn.textContent = '⏳ Rendering…'
    dlBtn.disabled = true

    try {
      // @ts-ignore
      const dataUrl: string = await window.htmlToImage.toPng(card, {
        pixelRatio,
        cacheBust: true,
        onclone: (_doc: Document, el: HTMLElement) => {
          el.querySelectorAll('img').forEach((img: HTMLImageElement) => {
            img.crossOrigin = 'anonymous'
          })
        },
      })
      const link = document.createElement('a')
      link.download = filename
      link.href = dataUrl
      link.click()
    } catch (err) {
      console.error('Card capture failed:', err)
      alert('Download failed.')
    } finally {
      dlBtn.textContent = originalText
      dlBtn.disabled = false
    }
  })
</script>

