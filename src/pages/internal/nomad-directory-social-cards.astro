---
export const prerender = true

import { fetchReportRecords } from '~/utils/smartsuite'
import Layout, { type SEOProps } from '~/layouts/Layout.astro'
import { directoryLogoBoxClass, directoryLogoImageClassFor, directoryLogoInitialClass, directoryLogoIntroBorderClass, directoryLogoUrlFor, needsDarkLogoBackground } from '~/const/nomadDirectoryWhiteLogos'
import { newDirectoryListingTitles, nomadDirectoryUrl, directoryListingOfferOverrides } from '~/const/newDirectoryListings'
import {
  computeBatchSocialPack,
  computeListingSocialPack,
  displayLink,
  formatOfferForCard,
  normalizeLink,
  resolveHeroImage,
  resolvePlaceImage,
  slugify,
  type BatchIgSlide,
  type DirectoryListingInput,
  type IgSlide,
} from '~/utils/directorySocialCards'

const { records = [] } = await fetchReportRecords('6857167d82358a0f5e038c3f')

const allListings: DirectoryListingInput[] = records
  .filter((r: any) => r.sf4ad525dd && r.title)
  .map((r: any) => ({
    id: String(r.id),
    title: r.title,
    category: r.sb685ab800?.label || '',
    description: r.scea90e502 || '',
    specialOffer: r.s5576966ee || '',
    link: normalizeLink(r.link || r.sb788c266b?.[0] || ''),
    logo: directoryLogoUrlFor(r.title, r.image && r.image !== '/logo.svg' ? r.image : ''),
    isDarkLogo: needsDarkLogoBackground(r.title),
    slug: slugify(r.title),
  }))

const listingPacks = await Promise.all(
  newDirectoryListingTitles
    .map((title) => allListings.find((l) => l.title === title))
    .filter(Boolean)
    .map(async (listing) => {
      const heroImage = await resolveHeroImage(listing!)
      const placeImage = await resolvePlaceImage(listing!, heroImage)
      return { listing: listing!, pack: computeListingSocialPack(listing!, heroImage, placeImage) }
    }),
)

const batchPack = computeBatchSocialPack(
  listingPacks.map(({ listing, pack }) => ({
    ...listing,
    heroImage: pack.heroImage,
    placeImage: pack.placeImage,
  })),
)

const seo: SEOProps = {
  title: 'Nomad Directory Social Cards - Internal Tool',
  description: 'Internal use only - Social media cards for new Nomad Directory listings',
  noIndex: true,
  ldJSON: {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Nomad Directory Social Cards',
    description: 'Internal use only',
    url: `${Astro.site}internal/nomad-directory-social-cards/`,
  },
}

function slideLabel(slide: IgSlide): string {
  if (slide.kind === 'cover') return 'Cover'
  if (slide.kind === 'about') return slide.parts > 1 ? `About (${slide.part}/${slide.parts})` : 'About'
  if (slide.kind === 'place') return 'The space'
  if (slide.kind === 'offer') return 'Special offer'
  if (slide.kind === 'hero-quote') return 'Highlight'
  return 'CTA'
}

function slideFilename(slug: string, slide: IgSlide): string {
  const n = String(slide.index).padStart(2, '0')
  return `ig-${n}-${slide.kind}-${slug}.png`
}

function batchSlideLabel(slide: BatchIgSlide, listingTitle?: string): string {
  if (slide.kind === 'batch-intro') return 'New listings intro'
  if (slide.kind === 'batch-cta') return 'Directory CTA'
  if (slide.focus === 'place') return `${listingTitle ?? 'Listing'} · The space`
  if (slide.focus === 'offer') return `${listingTitle ?? 'Listing'} · Offer`
  return `${listingTitle ?? 'Listing'} · About${slide.part ? ` ${slide.part}` : ''}`
}

function batchSlideFilename(slide: BatchIgSlide): string {
  const n = String(slide.index).padStart(2, '0')
  if (slide.kind === 'batch-intro') return `ig-batch-${n}-new-listings.png`
  if (slide.kind === 'batch-cta') return `ig-batch-${n}-cta.png`
  return `ig-batch-${n}-${slide.listingSlug}-${slide.focus}.png`
}
---

<Layout seo={seo}>
  <div class="bg-gray-950 min-h-screen">

    <div class="bg-gray-900 border-b border-gray-800 sticky top-0 z-50">
      <div class="max-w-screen-2xl mx-auto px-6 py-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
        <div>
          <h1 class="text-white font-bold text-lg">Nomad Directory Social Cards</h1>
          <p class="text-gray-500 text-xs mt-0.5">{listingPacks.length} new listings · Internal use only · noindex</p>
        </div>
        <div class="flex items-center gap-3">
          <label for="listing-filter" class="text-gray-400 text-sm shrink-0">Jump to:</label>
          <select
            id="listing-filter"
            class="bg-gray-800 text-white border border-gray-700 rounded-lg px-3 py-2 text-sm focus-visible:ring-2 focus-visible:ring-yellow-400 outline-none max-w-xs"
          >
            <option value="all">All listings</option>
            <option value="batch">Batch carousel (4 listings)</option>
            {listingPacks.map(({ listing }) => (
              <option value={listing.slug}>{listing.title}</option>
            ))}
          </select>
        </div>
      </div>
    </div>

    <div class="max-w-screen-2xl mx-auto px-6 pt-6 pb-2">
      <div class="flex flex-wrap gap-3 text-xs">
        <span class="bg-pink-950/60 text-pink-300 border border-pink-800/50 px-3 py-1.5 rounded-full font-medium">Instagram · dynamic slides · 4:5 portrait (1080×1350)</span>
        <span class="bg-blue-950/60 text-blue-300 border border-blue-800/50 px-3 py-1.5 rounded-full font-medium">LinkedIn · 1 image · 1.91:1 landscape</span>
        <span class="bg-sky-950/60 text-sky-300 border border-sky-800/50 px-3 py-1.5 rounded-full font-medium">Twitter / X · 1 image · 16:9</span>
        <span class="ml-auto text-gray-600 py-1.5">Long text splits across slides · Hero photos from listing websites</span>
      </div>
    </div>

    <div class="max-w-screen-2xl mx-auto px-6 py-6 space-y-20" id="listings-container">

      <!-- Batch carousel: all 4 new listings -->
      <section class="listing-section batch-section" data-slug="batch" id="listing-batch">
        <div class="flex items-start justify-between mb-6 pb-4 border-b border-gray-800">
          <div class="min-w-0 flex-1 mr-4">
            <div class="flex flex-wrap items-center gap-2 mb-2">
              <span class="bg-purple-400 text-black text-xs font-bold px-2.5 py-0.5 rounded-full">Batch series</span>
              <span class="text-emerald-400 text-xs font-semibold uppercase tracking-wider">4 new listings</span>
              <span class="text-gray-600 text-xs">{batchPack.slideCount} IG slides</span>
            </div>
            <h2 class="text-white text-xl font-bold leading-snug">New Listings Carousel</h2>
            <p class="text-gray-500 text-sm mt-1">One intro card with all logos, then 1–2 detail cards per listing</p>
          </div>
          <a href={nomadDirectoryUrl} target="_blank" rel="noopener noreferrer" aria-label="Open Nomad Directory (opens in new tab)" class="text-yellow-400 hover:text-yellow-300 text-sm font-medium shrink-0 transition-colors">Directory →</a>
        </div>

        <div class="mb-10">
          <div class="flex items-center gap-2 mb-4">
            <div class="w-2 h-2 rounded-full bg-pink-400" aria-hidden="true"></div>
            <h3 class="text-pink-300 text-xs font-bold uppercase tracking-widest">Instagram Batch Carousel · 1080×1350px · {batchPack.slideCount} slides</h3>
          </div>

          <div class="flex gap-4 overflow-x-auto snap-x snap-mandatory relative" style="padding-bottom:44px;" role="list">
            {batchPack.slides.map((slide) => {
              const listing = slide.kind === 'batch-detail'
                ? batchPack.listings.find((l) => l.slug === slide.listingSlug)
                : undefined
              const listingNumber = listing
                ? batchPack.listings.findIndex((l) => l.slug === listing.slug) + 1
                : 0
              const logoInitial = listing ? (listing.title || 'C').charAt(0).toUpperCase() : ''

              return (
                <div class="card-wrapper relative group shrink-0 snap-start z-0" style="width:340px;aspect-ratio:4/5;" role="listitem" aria-label={`Batch slide ${slide.index} of ${batchPack.slideCount}: ${batchSlideLabel(slide, listing?.title)}`}>

                  {slide.kind === 'batch-intro' && (
                    <div class="card-capture relative w-full h-full rounded-none overflow-hidden bg-[#0a0a0a] shadow-2xl shadow-black/50">
                      <div class="absolute top-0 left-0 right-0 h-1 bg-yellow-400" aria-hidden="true"></div>
                      <div class="absolute inset-0 bg-[radial-gradient(ellipse_120%_80%_at_50%_-20%,rgba(250,204,21,0.14),transparent_60%)]" aria-hidden="true"></div>

                      <div class="p-7 relative flex flex-col h-full">
                        <div class="flex items-center gap-2">
                          <img src="/logo.svg" alt="" aria-hidden="true" class="w-7 h-7 opacity-90" crossorigin="anonymous" />
                          <span class="text-white/55 text-[10px] font-bold uppercase tracking-[0.2em]">Nomad Magazine</span>
                        </div>

                        <div class="flex-1 flex flex-col items-center justify-center text-center">
                          <span class="inline-flex items-center gap-1.5 bg-yellow-400 text-black text-[10px] font-bold uppercase tracking-widest px-3.5 py-1.5 rounded-full mb-6">
                            <span class="w-1.5 h-1.5 rounded-full bg-black/40" aria-hidden="true"></span>
                            4 new listings
                          </span>

                          <h3 class="text-white font-bold text-[1.85rem] leading-[1.08] tracking-tight mb-2">
                            New at<br /><span class="text-yellow-400">Nomad Directory</span>
                          </h3>
                          <p class="text-white/40 text-xs leading-relaxed mb-8 max-w-[240px]">4 companies for digital nomads</p>

                          <div class="grid grid-cols-2 gap-x-8 gap-y-6 w-full max-w-[260px]">
                            {batchPack.listings.map((item) => (
                              <div class="h-[76px] flex items-center justify-center">
                                {item.title === 'Madeira Remote' && item.logo ? (
                                  <div class="w-[76px] h-[76px] rounded-xl overflow-hidden bg-black flex items-center justify-center ring-1 ring-white/10">
                                    <img src={directoryLogoUrlFor(item.title, item.logo)} alt={item.title} class="max-w-[92%] max-h-[92%] object-contain" crossorigin="anonymous" />
                                  </div>
                                ) : item.logo ? (
                                  <img src={item.logo} alt={item.title} class={`max-h-[76px] max-w-[108px] w-auto h-auto object-contain rounded-xl ${directoryLogoIntroBorderClass(item.title)}`} crossorigin="anonymous" />
                                ) : (
                                  <span class={directoryLogoInitialClass}>{(item.title || 'C').charAt(0).toUpperCase()}</span>
                                )}
                              </div>
                            ))}
                          </div>
                        </div>

                        <div class="text-center space-y-1.5 pt-4">
                          <p class="text-yellow-400/55 text-[10px] font-mono tracking-wide whitespace-nowrap">nomad-magazine.com/nomad_directory/</p>
                          <p class="text-white/25 text-[10px] tracking-wide">Swipe for details →</p>
                        </div>
                      </div>
                      <div class="absolute bottom-2 right-3 text-white/20 text-[10px] font-mono">{slide.index}/{batchPack.slideCount}</div>
                    </div>
                  )}

                  {slide.kind === 'batch-detail' && listing && slide.focus === 'about' && (
                    <div class="card-capture relative w-full h-full rounded-none overflow-hidden shadow-2xl shadow-black/50">
                      <img src={slide.heroImage} alt={listing.title} class="absolute inset-0 w-full h-full object-cover" loading="lazy" crossorigin="anonymous" />
                      <div class="absolute inset-0 bg-linear-to-t from-black/95 via-black/70 to-black/35"></div>
                      <div class="p-6 relative flex flex-col h-full">
                        <div class="flex items-center justify-between mb-4">
                          <span class="text-yellow-400 text-[11px] font-bold uppercase tracking-widest">
                            New listing · {listingNumber}/{batchPack.listings.length}
                          </span>
                          <img src="/logo.svg" alt="" aria-hidden="true" class="w-5 h-5 opacity-50" crossorigin="anonymous" />
                        </div>
                        <div class="flex-1 flex flex-col justify-end">
                          <div class="flex items-center gap-3 mb-4">
                            <div class={directoryLogoBoxClass}>
                              {listing.logo ? (
                                <img src={listing.logo} alt={listing.title} class={directoryLogoImageClassFor(listing.title)} crossorigin="anonymous" />
                              ) : (
                                <span class={directoryLogoInitialClass}>{logoInitial}</span>
                              )}
                            </div>
                            <div class="min-w-0">
                              <h3 class="text-white font-bold text-lg leading-tight drop-shadow-lg">{listing.title}</h3>
                              {listing.category && (
                                <span class="text-yellow-400 text-[10px] font-medium">{listing.category}</span>
                              )}
                            </div>
                          </div>
                          <p class={`text-gray-200 leading-relaxed drop-shadow-md ${slide.text.length > 140 ? 'text-xs' : 'text-sm'}`}>{slide.text}</p>
                          {listing.link && (
                            <p class="text-blue-300 text-[11px] mt-3 underline">{displayLink(listing.link)} →</p>
                          )}
                        </div>
                      </div>
                      <div class="absolute bottom-2 right-3 text-white/25 text-[10px] font-mono">{slide.index}/{batchPack.slideCount}</div>
                    </div>
                  )}

                  {slide.kind === 'batch-detail' && listing && slide.focus === 'offer' && (
                    <div class="card-capture relative w-full h-full rounded-none overflow-hidden shadow-2xl shadow-black/50">
                      {directoryListingOfferOverrides[listing.title] && (
                        <>
                          <img src={directoryListingOfferOverrides[listing.title]} alt="" aria-hidden="true" class="absolute inset-0 w-full h-full object-cover" loading="lazy" crossorigin="anonymous" />
                          <div class="absolute inset-0 bg-linear-to-t from-black/95 via-black/80 to-black/55"></div>
                        </>
                      )}
                      {!directoryListingOfferOverrides[listing.title] && (
                        <div class="absolute inset-0 bg-[#121111]"></div>
                      )}
                      <div class="p-6 relative flex flex-col h-full">
                        <div class="flex items-center gap-3 mb-6">
                          <div class={directoryLogoBoxClass}>
                            {listing.logo ? (
                              <img src={listing.logo} alt={listing.title} class={directoryLogoImageClassFor(listing.title)} crossorigin="anonymous" />
                            ) : (
                              <span class={directoryLogoInitialClass}>{logoInitial}</span>
                            )}
                          </div>
                          <div class="min-w-0">
                            <h3 class="text-white font-bold text-base leading-tight">{listing.title}</h3>
                            {listing.category && <span class="text-yellow-400/80 text-[10px]">{listing.category}</span>}
                          </div>
                        </div>
                        <div class="flex-1 flex flex-col justify-center">
                          <p class="text-yellow-400 text-[11px] font-bold uppercase tracking-widest mb-3">Special offer</p>
                          <p class={`text-white leading-relaxed ${formatOfferForCard(slide.text).length > 100 ? 'text-sm' : 'text-base'}`}>
                            {formatOfferForCard(slide.text)}
                          </p>
                        </div>
                        {listing.link && (
                          <p class="text-yellow-400/70 text-xs mt-6">{displayLink(listing.link)} →</p>
                        )}
                      </div>
                      <div class="absolute bottom-2 right-3 text-white/20 text-[10px] font-mono">{slide.index}/{batchPack.slideCount}</div>
                    </div>
                  )}

                  {slide.kind === 'batch-detail' && listing && slide.focus === 'place' && (slide.placeImage || listing.placeImage) && (
                    <div class="card-capture relative w-full h-full rounded-none overflow-hidden shadow-2xl shadow-black/50">
                      <img src={slide.placeImage || listing.placeImage} alt={`${listing.title} coliving space`} class="absolute inset-0 w-full h-full object-cover" loading="lazy" crossorigin="anonymous" />
                      <div class="absolute inset-0 bg-linear-to-t from-black/75 via-transparent to-transparent"></div>
                      {listing.link && (
                        <p class="absolute bottom-6 left-6 text-yellow-400 text-xs font-medium drop-shadow-md">{displayLink(listing.link)} →</p>
                      )}
                      <div class="absolute bottom-2 right-3 text-white/25 text-[10px] font-mono">{slide.index}/{batchPack.slideCount}</div>
                    </div>
                  )}

                  {slide.kind === 'batch-cta' && (
                    <div class="card-capture relative w-full h-full rounded-none overflow-hidden bg-[#121111] shadow-2xl shadow-black/50">
                      <div class="absolute inset-0 bg-linear-to-br from-yellow-400/15 via-[#121111] to-black"></div>
                      <div class="absolute inset-0 flex flex-col items-center justify-center p-8 text-center">
                        <img src="/logo.svg" alt="" aria-hidden="true" class="w-10 h-10 mb-4" crossorigin="anonymous" />
                        <p class="text-yellow-400 text-[11px] font-bold uppercase tracking-widest mb-3">Explore the Nomad Directory</p>
                        <h3 class="text-white font-bold text-lg leading-snug mb-2">150+ vetted companies for nomads</h3>
                        <p class="text-gray-400 text-xs leading-relaxed mb-5">Colivings, coworkings, apps, insurance, legal — because Google doesn't get our lifestyle.</p>
                        <div class="bg-yellow-400 text-black text-[10px] font-bold px-5 py-2.5 rounded-full whitespace-nowrap">nomad-magazine.com/nomad_directory/</div>
                        <p class="text-white/40 text-xs mt-4">🔗 Link in bio</p>
                      </div>
                      <div class="absolute bottom-2 right-3 text-white/20 text-[10px] font-mono">{slide.index}/{batchPack.slideCount}</div>
                    </div>
                  )}

                  <button class="download-btn" data-filename={batchSlideFilename(slide)} data-width="1080" aria-label={`Download batch slide ${slide.index}`}>↓ PNG</button>
                </div>
              )
            })}
          </div>
        </div>

        <div class="mb-10">
          <div class="flex items-center gap-2 mb-4">
            <div class="w-2 h-2 rounded-full bg-blue-400" aria-hidden="true"></div>
            <h3 class="text-blue-300 text-xs font-bold uppercase tracking-widest">LinkedIn · Batch · 1200×627px</h3>
          </div>
          <div class="card-wrapper relative group" style="max-width:600px;padding-bottom:36px;">
            <div class="card-capture relative rounded-none overflow-hidden shadow-2xl shadow-black/50 bg-[#121111]" style="aspect-ratio:1.91/1;">
              <div class="absolute inset-0 bg-linear-to-r from-yellow-400/10 via-transparent to-transparent"></div>
              <div class="absolute inset-0 flex flex-col justify-between p-7">
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-2">
                    <img src="/logo.svg" alt="" aria-hidden="true" class="w-7 h-7" crossorigin="anonymous" />
                    <span class="text-white/70 text-xs font-bold uppercase tracking-widest">Nomad Directory</span>
                  </div>
                  <span class="bg-yellow-400 text-black text-xs font-bold px-3 py-1 rounded-full">4 new listings</span>
                </div>
                <div>
                  <h3 class="text-white font-bold text-2xl leading-tight mb-3">New at Nomad Directory</h3>
                  <div class="flex flex-wrap gap-2 mb-3">
                    {batchPack.listings.map((item) => (
                      <span class="bg-white/10 border border-white/15 text-white text-xs font-medium px-2.5 py-1 rounded-full">{item.title}</span>
                    ))}
                  </div>
                  <p class="text-yellow-400/70 text-xs font-mono">nomad-magazine.com/nomad_directory/</p>
                </div>
              </div>
            </div>
            <button class="download-btn" data-filename="linkedin-batch-new-listings.png" data-width="1200" aria-label="Download batch LinkedIn image">↓ PNG</button>
          </div>
          <div class="copy-block mt-4" style="max-width:600px;">
            <div class="flex items-center justify-between mb-2">
              <span class="text-gray-500 text-[11px] font-bold uppercase tracking-widest">Proposed LinkedIn post copy</span>
              <button class="copy-text-btn text-[11px] font-semibold text-blue-300 hover:text-white border border-blue-800/50 hover:border-blue-400 bg-blue-950/40 hover:bg-blue-900/50 px-3 py-1 rounded-lg transition-colors" aria-label="Copy batch LinkedIn post text">Copy text</button>
            </div>
            <textarea class="copy-textarea w-full bg-gray-900 border border-gray-800 text-gray-300 text-xs leading-relaxed rounded-xl p-4 resize-none font-mono focus-visible:ring-2 focus-visible:ring-blue-500 outline-none" rows="10" readonly>{batchPack.linkedInCopy}</textarea>
          </div>
        </div>

        <div class="mb-4">
          <div class="flex items-center gap-2 mb-4">
            <div class="w-2 h-2 rounded-full bg-sky-400" aria-hidden="true"></div>
            <h3 class="text-sky-300 text-xs font-bold uppercase tracking-widest">Twitter / X · Batch · 1600×900px</h3>
          </div>
          <div class="card-wrapper relative group" style="max-width:600px;padding-bottom:36px;">
            <div class="card-capture relative rounded-none overflow-hidden shadow-2xl shadow-black/50 bg-[#121111]" style="aspect-ratio:16/9;">
              <div class="absolute top-0 left-0 right-0 h-1 bg-yellow-400" aria-hidden="true"></div>
              <div class="absolute inset-0 flex flex-col justify-between p-6">
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-2">
                    <img src="/logo.svg" alt="" aria-hidden="true" class="w-6 h-6" crossorigin="anonymous" />
                    <span class="text-white/60 text-xs font-bold uppercase tracking-wider">Nomad Directory</span>
                  </div>
                  <span class="bg-yellow-400 text-black text-xs font-bold px-2.5 py-0.5 rounded-full">4 new</span>
                </div>
                <div>
                  <h3 class="text-white font-bold text-xl leading-tight mb-2">4 new listings for nomads</h3>
                  <p class="text-gray-300 text-sm">{batchPack.listings.map((l) => l.title).join(' · ')}</p>
                </div>
              </div>
            </div>
            <button class="download-btn" data-filename="twitter-batch-new-listings.png" data-width="1600" aria-label="Download batch Twitter image">↓ PNG</button>
          </div>
          <div class="copy-block mt-4" style="max-width:600px;">
            <div class="flex items-center justify-between mb-2">
              <span class="text-gray-500 text-[11px] font-bold uppercase tracking-widest">Proposed Twitter / X post copy</span>
              <div class="flex items-center gap-2">
                <span class="text-[11px] text-gray-600 font-mono">{batchPack.twitterCopy.length}/280</span>
                <button class="copy-text-btn text-[11px] font-semibold text-sky-300 hover:text-white border border-sky-800/50 hover:border-sky-400 bg-sky-950/40 hover:bg-sky-900/50 px-3 py-1 rounded-lg transition-colors" aria-label="Copy batch Twitter post text">Copy text</button>
              </div>
            </div>
            <textarea class="copy-textarea w-full bg-gray-900 border border-gray-800 text-gray-300 text-xs leading-relaxed rounded-xl p-4 resize-none font-mono focus-visible:ring-2 focus-visible:ring-sky-500 outline-none" rows="4" readonly>{batchPack.twitterCopy}</textarea>
          </div>
        </div>
      </section>

      {listingPacks.map(({ listing, pack }) => {
        const logoInitial = (listing.title || 'C').charAt(0).toUpperCase()

        return (
          <section class="listing-section" data-slug={listing.slug} id={`listing-${listing.slug}`}>

            <div class="flex items-start justify-between mb-6 pb-4 border-b border-gray-800">
              <div class="min-w-0 flex-1 mr-4">
                <div class="flex flex-wrap items-center gap-2 mb-2">
                  {listing.category && (
                    <span class="bg-yellow-400 text-black text-xs font-bold px-2.5 py-0.5 rounded-full">{listing.category}</span>
                  )}
                  <span class="text-emerald-400 text-xs font-semibold uppercase tracking-wider">New listing</span>
                  <span class="text-gray-600 text-xs">{pack.instagramSlideCount} IG slides</span>
                </div>
                <h2 class="text-white text-xl font-bold leading-snug">{listing.title}</h2>
                {listing.link && <p class="text-gray-500 text-sm mt-1">{displayLink(listing.link)}</p>}
              </div>
              <a href={nomadDirectoryUrl} target="_blank" rel="noopener noreferrer" aria-label="Open Nomad Directory (opens in new tab)" class="text-yellow-400 hover:text-yellow-300 text-sm font-medium shrink-0 transition-colors">Directory →</a>
            </div>

            <div class="mb-10">
              <div class="flex items-center gap-2 mb-4">
                <div class="w-2 h-2 rounded-full bg-pink-400" aria-hidden="true"></div>
