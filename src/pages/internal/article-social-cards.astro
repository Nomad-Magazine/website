<!-- html-to-image: handles modern CSS (Tailwind v4 oklch, color-mix, gradients) correctly -->
<script is:inline src="https://cdn.jsdelivr.net/npm/html-to-image@1.11.11/dist/html-to-image.js"></script>

<script>
  // Article filter
  const select = document.getElementById('article-filter') as HTMLSelectElement | null
  const sections = document.querySelectorAll<HTMLElement>('.article-section')

  select?.addEventListener('change', () => {
    const val = select.value
    sections.forEach(section => {
      section.style.display = (val === 'all' || section.dataset.slug === val) ? '' : 'none'
    })
    if (val !== 'all') {
      const target = document.getElementById(`article-${CSS.escape(val)}`)
      target?.scrollIntoView({ behavior: 'smooth', block: 'start' })
    }
  })

  // Copy-text handler
  document.addEventListener('click', async (e: MouseEvent) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.copy-text-btn')
    if (!btn) return
    const block = btn.closest<HTMLElement>('.copy-block')
    const textarea = block?.querySelector<HTMLTextAreaElement>('.copy-textarea')
    if (!textarea) return
    try {
      await navigator.clipboard.writeText(textarea.value)
      const orig = btn.textContent
      btn.textContent = '✓ Copied!'
      setTimeout(() => { btn.textContent = orig }, 2000)
    } catch {
      textarea.select()
      document.execCommand('copy')
    }
  })

  // Download handler — uses html-to-image (handles Tailwind v4 modern CSS correctly)
  document.addEventListener('click', async (e: MouseEvent) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.download-btn')
    if (!btn) return

    const wrapper = btn.closest<HTMLElement>('.card-wrapper')
    const card = wrapper?.querySelector<HTMLElement>('.card-capture')
    if (!card) return

    const filename = btn.dataset.filename ?? 'social-card.png'
    const targetWidth = parseInt(btn.dataset.width ?? '1080', 10)
    const pixelRatio = targetWidth / card.offsetWidth

    const originalText = btn.textContent ?? '↓ PNG'
    btn.textContent = '⏳ Rendering…'
    btn.disabled = true

    try {
      // html-to-image uses SVG foreignObject — renders modern CSS including oklch, color-mix, gradients
      // @ts-ignore — loaded via CDN
      const dataUrl: string = await window.htmlToImage.toPng(card, {
        pixelRatio,
        cacheBust: true,
        skipAutoScale: false,
        // Ensure font and image loading finishes before capture
        onclone: (_doc: Document, el: HTMLElement) => {
          // Force all images to load before capture
          el.querySelectorAll('img').forEach((img: HTMLImageElement) => {
            img.crossOrigin = 'anonymous'
          })
        },
      })

      const link = document.createElement('a')
      link.download = filename
      link.href = dataUrl
      link.click()
    } catch (err) {
      console.error('Card capture failed:', err)
      alert('Download failed. In Chrome: right-click the card → Inspect → right-click the highlighted element → "Capture node screenshot".')
    } finally {
      btn.textContent = originalText
      btn.disabled = false
    }
  })
</script>

<style>
  /* Download button — sits below the card (outside overflow-hidden, never captured) */
  .download-btn {
    position: absolute;
    bottom: -30px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 20;
    background: #1f2937;
    color: #facc15;
    font-size: 11px;
    font-weight: 700;
    padding: 5px 14px;
    border-radius: 20px;
    border: 1px solid #374151;
    cursor: pointer;
    line-height: 1;
    white-space: nowrap;
    transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }

  /* For LinkedIn/Twitter wrappers where card-wrapper has max-width: align left */
  .card-wrapper[style*="max-width"] .download-btn {
    left: 0;
    transform: none;
  }

  .download-btn:hover {
    background: #facc15;
    color: #000;
    border-color: #facc15;
  }

  .download-btn:disabled {
    cursor: wait;
