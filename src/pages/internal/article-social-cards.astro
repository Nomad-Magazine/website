---
export const prerender = true

import { getCollection, type CollectionEntry } from 'astro:content'
import Layout, { type SEOProps } from '~/layouts/Layout.astro'

const rawArticles = await getCollection('article', ({ data }) => data.published !== false)
const articles = rawArticles.sort((a, b) => {
  const dateA = new Date(a.data.pubDate || 0).getTime()
  const dateB = new Date(b.data.pubDate || 0).getTime()
  return dateB - dateA
})

// Score a sentence for "Instagram-worthiness":
// higher = more compelling as a standalone quote
function scoreQuote(s: string): number {
  let sc = 0
  const lower = s.toLowerCase()
  // Sweet spot length: 80–200 chars
  if (s.length >= 80 && s.length <= 200) sc += 4
  else if (s.length >= 50 && s.length <= 240) sc += 2
  else sc -= 2
  // Contrast / tension words that create intrigue
  for (const w of ['yet', 'still', 'despite', 'instead', 'paradox', 'alone', 'actually',
                    'never', 'always', 'why', 'reality', 'truth', 'irony', 'but ', 'however',
                    'surprising', 'unexpected', 'hidden', 'beneath', 'beyond', 'secret']) {
    if (lower.includes(w)) sc += 2
  }
  // Emotional / human resonance
  for (const w of ['feel', 'freedom', 'community', 'dream', 'discover', 'change',
                    'struggle', 'love', 'fear', 'hope', 'belong', 'connect', 'lonely',
                    'together', 'people', 'life', 'world', 'home', 'journey']) {
    if (lower.includes(w)) sc += 1
  }
  // Starts strong (not "The ", "A ", "In ", "It " etc.)
  if (/^(What|Why|How|When|Where|No |Not |Most |For |Every|Some|While|Although|Despite|This is|There |We |You |They )/.test(s)) sc += 2
  // Avoid dry, listy, or link-heavy text
  if (s.includes('http') || s.includes('www.') || s.includes('://')) sc -= 5
  if (/^\d+\./.test(s)) sc -= 3
  return sc
}

// Extract all candidate quotes from <mark> tags + body sentences, ranked by score
function extractHighlights(body: string): string[] {
  const candidates: Array<{ text: string; score: number; fromMark: boolean }> = []

  // 1. <mark> highlights (author-chosen — get a base bonus)
  const markRegex = /<mark[^>]*>(.*?)<\/mark>/gs
  let match
  while ((match = markRegex.exec(body)) !== null) {
    const text = match[1].replace(/<[^>]+>/g, '').replace(/\[([^\]]+)\]\([^)]+\)/g, '$1').trim()
    if (text.length > 30) candidates.push({ text, score: scoreQuote(text) + 3, fromMark: true })
  }

  // 2. Standalone sentences from body paragraphs
  const cleanLine = (l: string) =>
    l.replace(/<[^>]+>/g, '').replace(/\[([^\]]+)\]\([^)]+\)/g, '$1').trim()

  for (const line of body.split('\n')) {
    const cl = cleanLine(line)
    if (!cl || cl.startsWith('#') || cl.startsWith('|') || cl.startsWith('-') || cl.startsWith('!')) continue
    for (const sentence of cl.match(/[^.!?]+[.!?]+/g) ?? []) {
      const s = sentence.trim()
      if (s.length < 50 || s.length > 280) continue
      if (s.includes('http') || s.includes('www.')) continue
      candidates.push({ text: s, score: scoreQuote(s), fromMark: false })
    }
  }

  // Deduplicate, sort by score, return top texts
  const seen = new Set<string>()
  return candidates
    .sort((a, b) => b.score - a.score)
    .filter(c => { const k = c.text.slice(0, 60); if (seen.has(k)) return false; seen.add(k); return true })
    .slice(0, 6)
    .map(c => c.text)
}

type BodyImage = { url: string; alt: string }
type StorySection = { heading: string; snippet: string; image?: BodyImage }

function cleanRichText(text: string): string {
  return text
    .replace(/<[^>]+>/g, ' ')
    .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
    .replace(/\s+/g, ' ')
    .trim()
}

function splitIntoSentences(text: string): string[] {
  return (
    cleanRichText(text)
      .match(/[^.!?]+[.!?]+|[^.!?]+$/g)
      ?.map((s) => s.trim())
      .filter(Boolean) ?? []
  )
}

function closeUnbalancedQuotes(text: string): string {
  const quoteCount = (text.match(/"/g) ?? []).length
  if (quoteCount % 2 === 0) return text

  const trailingPunctuation = text.match(/[.,;:!?)]*$/)?.[0] ?? ''
  const core = trailingPunctuation ? text.slice(0, -trailingPunctuation.length) : text
  return `${core}"${trailingPunctuation}`
}

function scoreStorySentence(sentence: string): number {
  let sc = scoreQuote(sentence)
  const lower = sentence.toLowerCase()

  for (const w of [
    'status quo', 'intentional', 'community', 'bubble', 'comfort zone', 'apartheid',
    'authentic', 'authenticity', 'immersion', 'colonial', 'gentrification', 'africa',
    'african', 'heartbeat', 'amapiano', 'history', 'local', 'travel', 'nomad',
    'nexus', 'deep connection', 'mirror reality', 'responsible', 'privilege',
    'understanding', 'contribute', 'revolutionary', 'thriving', 'progressing',
  ]) {
    if (lower.includes(w)) sc += 3
  }

  for (const w of [
    'as 20', 'i didn\'t initially', 'i had to', 'afterwards', 'later that night',
    'the next day', 'one of the highlights', 'to my delight', 'before i left',
    'it\'s almost', 'during the welcome', 'i went inside and saw', 'i walked back',
    'i got closer', 'the actor playing', 'black panther', 'john kani', 'king t\'chaka',
    'agenda', 'work call', 'hotel lobby',
  ]) {
    if (lower.includes(w)) sc -= 4
  }

  if (/^(As|During|After|Before|Later|The next day|One of the highlights)\b/.test(sentence)) sc -= 3
  if (/^I (went|walked|saw|got|had|slept|thought|met|arrived|arrive|started)\b/.test(sentence)) sc -= 5
  if (/^The actor playing\b/.test(sentence)) sc -= 8
  if (sentence.length > 220) sc -= 2

  return sc
}

function pickBestStorySentence(text: string): string {
  const sentences = splitIntoSentences(text)
    .filter((s) => s.length >= 55 && s.length <= 260)
    .sort((a, b) => scoreStorySentence(b) - scoreStorySentence(a))
  return closeUnbalancedQuotes(sentences[0] ?? cleanRichText(text).slice(0, 200).trim())
}

function extractStorySections(body: string): StorySection[] {
  const sections = body.split(/^## /m).slice(1)

  return sections
    .map((section) => {
      const lines = section.split('\n')
      const heading = lines[0].trim()
      const rawBody = lines.slice(1).join('\n')
      const image = extractImagesFromBody(rawBody)[0]
      const paragraphText = lines
        .slice(1)
        .filter((line) => {
          const t = line.trim()
          return Boolean(
            t &&
            !t.startsWith('<img') &&
            !t.startsWith('<div') &&
            !t.startsWith('### ') &&
            !t.startsWith('- ') &&
            !t.startsWith('*Essay by')
          )
        })
        .join(' ')
      return {
        heading,
        snippet: pickBestStorySentence(paragraphText),
        image,
      }
    })
    .filter((section) =>
      Boolean(section.heading) &&
      Boolean(section.snippet) &&
      !/^(About the author|Colophon|Tipsheets)$/i.test(section.heading)
    )
}

function extractH2s(body: string): string[] {
  const h2Regex = /^## (.+)$/gm
  const headings: string[] = []
  let match
  while ((match = h2Regex.exec(body)) !== null) {
    headings.push(match[1].trim())
  }
  return headings
}

// Returns [{heading, snippet}] — first plain-text sentence after each H2, trimmed at a sentence end
function extractH2Snippets(body: string): { heading: string; snippet: string }[] {
  const sections = body.split(/^## /m).slice(1)
  return sections.slice(0, 4).map(section => {
    const lines = section.split('\n')
    const heading = lines[0].trim()
    // Collect the first substantive paragraph (may span multiple lines)
    const rawLines = lines
      .slice(1)
      .map(l => l.replace(/<[^>]+>/g, '').replace(/\[([^\]]+)\]\([^)]+\)/g, '$1').trim())
      .filter(l => l.length > 0 && !l.startsWith('#') && !l.startsWith('-') && !l.startsWith('|'))
    const paragraph = rawLines.slice(0, 3).join(' ')
    // Trim to the last full sentence that fits within ~160 chars
    const maxLen = 160
    let trimmed = paragraph
    if (trimmed.length > maxLen) {
      // Try to cut at a sentence boundary (., !, ?)
      const cut = trimmed.slice(0, maxLen)
      const sentenceEnd = Math.max(cut.lastIndexOf('. '), cut.lastIndexOf('! '), cut.lastIndexOf('? '))
      trimmed = sentenceEnd > 60 ? trimmed.slice(0, sentenceEnd + 1) : cut.replace(/\s\S+$/, '') + '…'
    }
    return { heading, snippet: trimmed }
  })
}

function formatDate(date: Date | undefined): string {
  if (!date) return ''
  return new Date(date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
}

function getTags(tag: string | undefined): string[] {
  if (!tag) return []
  return tag.split(',').map(t => t.trim()).filter(Boolean).slice(0, 3)
}

/** H2 headings that are not story beats for the carousel deck */
function storyH2s(h2s: string[]): string[] {
  return h2s.filter(h => !/^(About the author|Colophon|Tipsheets)$/i.test(h.trim()))
}

function buildStoryOutline(headings: string[]): string[] {
  if (headings.length <= 6) return headings
  return [...headings.slice(0, 2), ...headings.slice(-4)]
}

function extractImagesFromBody(body: string): BodyImage[] {
  const found: BodyImage[] = []

  const mdImg = /!\[([^\]]*)\]\(\s*([^)]+?)\s*\)/g
  let m: RegExpExecArray | null
  while ((m = mdImg.exec(body)) !== null) {
    const url = m[2].trim()
    if (url.startsWith('/') || url.startsWith('http')) {
      found.push({ url, alt: (m[1] || '').trim() })
    }
  }

  const htmlImgTag = /<img\b[^>]*>/gi
  while ((m = htmlImgTag.exec(body)) !== null) {
    const tag = m[0]
    const srcMatch = /\bsrc\s*=\s*["']([^"']+)["']/i.exec(tag)
    if (!srcMatch) continue
    const url = srcMatch[1].trim()
    if (!url.startsWith('/') && !url.startsWith('http')) continue
    const altMatch = /\balt\s*=\s*["']([^"']*)["']/i.exec(tag)
    found.push({ url, alt: (altMatch?.[1] || '').trim() })
  }

  return found
}

function dedupeBodyImages(images: BodyImage[]): BodyImage[] {
  const seen = new Set<string>()
  const out: BodyImage[] = []
  for (const im of images) {
    if (!im.url || seen.has(im.url)) continue
    seen.add(im.url)
    out.push(im)
  }
  return out
}

/** Images from markdown/HTML in article order; hero last as fallback so middle slides prefer in-article art */
function buildEditorialImageDeck(heroUrl: string, heroAlt: string | undefined, body: string): BodyImage[] {
  const fromBody = dedupeBodyImages(extractImagesFromBody(body))
  const withoutHero = fromBody.filter((im) => im.url !== heroUrl)
  if (withoutHero.length > 0) return withoutHero
  if (heroUrl) return [{ url: heroUrl, alt: heroAlt || '' }]
  return []
}

function toHashtag(t: string): string {
  return '#' + t.replace(/\s+/g, '').replace(/[^a-zA-Z0-9]/g, '')
}

function truncateCopy(text: string, maxLen: number): string {
  const clean = cleanRichText(text)
  if (clean.length <= maxLen) return clean
  return clean.slice(0, maxLen).replace(/\s+\S*$/, '').trim() + '...'
}

function generateLinkedInCopy(
  title: string,
  description: string,
  storySections: StorySection[],
  tags: string[],
  articleUrl: string,
  author?: string,
  takeaway?: string
): string {
  const hashtags = [...tags.map(toHashtag), '#DigitalNomad', '#RemoteWork', '#NomadMagazine'].join(' ')
  const opening = truncateCopy(storySections[0]?.snippet || description, 220)
  const middleSections = storySections.slice(1, 4)
  const lines: string[] = []

  lines.push(title, '')
  lines.push(opening, '')

  if (middleSections.length > 0) {
    lines.push('Inside the story:')
    for (const section of middleSections) {
      lines.push(`- ${section.heading}: ${truncateCopy(section.snippet, 150)}`)
    }
    lines.push('')
  }

  if (takeaway) {
    lines.push(`Takeaway: ${truncateCopy(takeaway, 220)}`, '')
  }

  lines.push('Full article 👇', `https://${articleUrl}`, '')
  lines.push(hashtags)

  if (author) {
    lines.push('', `By ${author} for Nomad Magazine`)
  }

  return lines.join('\n')
}

function generateTwitterCopy(
  title: string,
  description: string,
  tags: string[],
  highlights: string[],
  articleUrl: string
): string {
  const hashtags = [...tags.slice(0, 2).map(toHashtag), '#NomadMagazine'].join(' ')
  // Use first highlight or first ~180 chars of description as the insight line
  const insight = highlights[0] ?? description
  const maxLen = 180
  const truncated = insight.length > maxLen ? insight.slice(0, maxLen - 1) + '…' : insight

  return [truncated, '', `https://${articleUrl}`, '', hashtags].join('\n')
}

type ArticleEntry = CollectionEntry<'article'>

function computeArticleSocialPack(article: ArticleEntry) {
  const data = article.data
  const igAuthorCredit = data.author
    ? data.bylineType
      ? `${data.bylineType} by ${data.author}`
      : `by ${data.author}`
    : ''
  const body = article.body ?? ''
  const highlights = extractHighlights(body)
  const h2s = extractH2s(body)
  const storySections = extractStorySections(body)
  const tags = getTags(data.tag)
  const heroImage = data.heroImage ?? ''
  const heroImageAlt = data.heroImageAlt ?? data.title
  const slug =
    (data as { slug?: string }).slug ||
    article.id.replace(/^article\//, '').replace(/\.md$/, '')
  const articleUrl = `nomad-magazine.com/articles/${slug}/`
  const pubDateStr = formatDate(data.pubDate)
  const h2Snippets = extractH2Snippets(body)
  const citySlides = storySections
    .slice(1)
    .slice(0, 2)
  const showIgSecondCitySlide = Boolean(citySlides[1])
  const igCitySlideCount = (citySlides[0] ? 1 : 0) + (showIgSecondCitySlide ? 1 : 0)
  const instagramSlideCount = 6 + igCitySlideCount

  const editorialDeck = buildEditorialImageDeck(heroImage, heroImageAlt, body)
  let igSecondSectionPhoto: BodyImage = citySlides[1]?.image ?? editorialDeck[1] ?? editorialDeck[0]

  const usedStoryHeadings = new Set([
    storySections[0]?.heading,
    citySlides[0]?.heading,
    citySlides[1]?.heading,
  ].filter(Boolean))
  const slide5Section =
    storySections.findLast((section) => !usedStoryHeadings.has(section.heading)) ??
    storySections[storySections.length - 1] ??
    storySections[0]

  let igImageQuotePhoto: BodyImage = slide5Section?.image ?? editorialDeck[2] ?? editorialDeck[0]
  if (
    igImageQuotePhoto.url === igSecondSectionPhoto.url &&
    heroImage &&
    heroImage !== igSecondSectionPhoto.url
  ) {
    igImageQuotePhoto = { url: heroImage, alt: heroImageAlt || data.title }
  }

  const slide2Quote = storySections[0]?.snippet ?? highlights[0] ?? data.description
  const slide3Quote =
    citySlides[0]?.snippet ?? highlights[1] ?? highlights[0] ?? data.description
  const slide4Quote = citySlides[1]?.snippet ?? highlights[2] ?? highlights[1] ?? data.description
  const slide3Kicker = citySlides[0]?.heading ?? 'Story beat'
  const slide4Kicker = citySlides[1]?.heading ?? 'Story beat'
  const slide5Kicker = slide5Section?.heading ?? 'Key insight'

  const usedInEarlierSlides = new Set<string>([
    slide2Quote,
    slide3Quote,
    ...(showIgSecondCitySlide ? [slide4Quote] : []),
  ])

  let slide5Quote = slide5Section?.snippet ?? data.description
  if (slide5Quote === data.description) {
    for (const s of h2Snippets) {
      if (s.snippet && !usedInEarlierSlides.has(s.snippet)) {
        slide5Quote = s.snippet
        break
      }
    }
  }

  const usedThroughSlide5 = new Set([...usedInEarlierSlides, slide5Quote])

  const takeawayBullets = body
    .split('\n')
    .map((line) => line.trim())
    .filter((line) => line.startsWith('- '))
    .map((line) => cleanRichText(line.slice(2)))
    .filter((line) => line.length >= 50)

  let closingInsight = ''
  for (const bullet of takeawayBullets) {
    if (!usedThroughSlide5.has(bullet)) {
      closingInsight = bullet
      break
    }
  }
  for (const h of highlights) {
    if (!closingInsight && !usedThroughSlide5.has(h) && h.length >= 40) {
      closingInsight = h
      break
    }
  }
  if (!closingInsight) {
    const descSents = data.description.match(/[^.!?]+[.!?]+/g) ?? []
    closingInsight = descSents[descSents.length - 1]?.trim() || data.description
  }
  if (closingInsight.length > 220) {
    closingInsight = closingInsight.slice(0, 217).trim() + '…'
  }

  const closingSlideKicker =
    takeawayBullets.length > 0
      ? 'Takeaway'
      : h2s.length > 0
        ? h2s[h2s.length - 1].length > 44
          ? h2s[h2s.length - 1].slice(0, 41) + '…'
          : h2s[h2s.length - 1]
        : tags[0] || 'From this story'

  const h2sDeck = storyH2s(h2s)
  const keyPoints = h2sDeck.length > 0 ? buildStoryOutline(h2sDeck) : tags.slice(0, 6)

  const linkedInCopy = generateLinkedInCopy(
    data.title,
    data.description,
    storySections,
    tags,
    articleUrl,
    data.author,
    takeawayBullets[0],
  )
  const twitterCopy = generateTwitterCopy(data.title, data.description, tags, highlights, articleUrl)

  return {
    igAuthorCredit,
    tags,
    heroImage,
    heroImageAlt,
    slug,
    articleUrl,
    pubDateStr,
    citySlides,
    showIgSecondCitySlide,
    igCitySlideCount,
    instagramSlideCount,
    igSecondSectionPhoto,
    igImageQuotePhoto,
    slide2Quote,
    slide3Quote,
    slide4Quote,
    slide3Kicker,
    slide4Kicker,
    slide5Quote,
    slide5Kicker,
    closingInsight,
    closingSlideKicker,
    keyPoints,
    linkedInCopy,
    twitterCopy,
  }
}

const seo: SEOProps = {
  title: 'Article Social Cards - Internal Tool',
  description: 'Internal use only - Social media image templates for articles',
  noIndex: true,
  ldJSON: {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Article Social Cards',
    description: 'Internal use only',
    url: `${Astro.site}internal/article-social-cards/`,
  },
}
---

<Layout seo={seo}>
  <div class="bg-gray-950 min-h-screen">

    <!-- Sticky Header -->
    <div class="bg-gray-900 border-b border-gray-800 sticky top-0 z-50">
      <div class="max-w-screen-2xl mx-auto px-6 py-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
        <div>
          <h1 class="text-white font-bold text-lg">Article Social Media Cards</h1>
          <p class="text-gray-500 text-xs mt-0.5">{articles.length} articles · Internal use only · noindex</p>
        </div>
        <div class="flex items-center gap-3">
          <label for="article-filter" class="text-gray-400 text-sm shrink-0">Jump to:</label>
          <select
            id="article-filter"
            class="bg-gray-800 text-white border border-gray-700 rounded-lg px-3 py-2 text-sm focus-visible:ring-2 focus-visible:ring-yellow-400 outline-none max-w-xs"
          >
            <option value="all">All articles</option>
            {articles.map(article => (
              <option value={article.id}>{article.data.title}</option>
            ))}
          </select>
        </div>
      </div>
    </div>

    <!-- Format Legend -->
    <div class="max-w-screen-2xl mx-auto px-6 pt-6 pb-2">
      <div class="flex flex-wrap gap-3 text-xs">
        <span class="bg-pink-950/60 text-pink-300 border border-pink-800/50 px-3 py-1.5 rounded-full font-medium">Instagram · 5–7 slides · 3:4 portrait (1080×1440)</span>
        <span class="bg-blue-950/60 text-blue-300 border border-blue-800/50 px-3 py-1.5 rounded-full font-medium">LinkedIn · 1 image · 1.91:1 landscape</span>
        <span class="bg-sky-950/60 text-sky-300 border border-sky-800/50 px-3 py-1.5 rounded-full font-medium">Twitter / X · 1 image · 16:9</span>
        <span class="ml-auto text-gray-600 py-1.5">Click ↓ PNG below any card to download with text</span>
      </div>
    </div>

    <!-- Articles -->
    <div class="max-w-screen-2xl mx-auto px-6 py-6 space-y-20" id="articles-container">
      {articles.map((article) => {
        const p = computeArticleSocialPack(article)
        const data = article.data
        return (
          <section class="article-section" data-slug={article.id} id={`article-${article.id}`}>

            <!-- Section Header -->
            <div class="flex items-start justify-between mb-6 pb-4 border-b border-gray-800">
              <div class="min-w-0 flex-1 mr-4">
                <div class="flex flex-wrap items-center gap-2 mb-2">
                  {p.tags.map(tag => (
                    <span class="bg-yellow-400 text-black text-xs font-bold px-2.5 py-0.5 rounded-full">{tag}</span>
                  ))}
                  <span class="text-gray-600 text-xs">{p.pubDateStr}</span>
                </div>
                <h2 class="text-white text-xl font-bold leading-snug">{data.title}</h2>
                {p.igAuthorCredit && <p class="text-gray-500 text-sm mt-1">{p.igAuthorCredit}</p>}
              </div>
              <a
                href={`/articles/${p.slug}/`}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Open article: ${data.title} (opens in new tab)`}
                class="text-yellow-400 hover:text-yellow-300 text-sm font-medium shrink-0 transition-colors"
              >
                View →
              </a>
            </div>

            <!-- ═══════════════════════════════════════
                 INSTAGRAM CAROUSEL (1:1 square slides)
                 ═══════════════════════════════════════ -->
            <div class="mb-10">
              <div class="flex items-center gap-2 mb-4">
                <div class="w-2 h-2 rounded-full bg-pink-400" aria-hidden="true"></div>
                <h3 class="text-pink-300 text-xs font-bold uppercase tracking-widest">Instagram Carousel · 1080×1440px (3:4) · {p.instagramSlideCount} slides</h3>
              </div>

              <div class="flex gap-4 overflow-x-auto snap-x snap-mandatory relative" style="padding-bottom:44px;" role="list" aria-label="Instagram carousel slides">

                <!-- Slide 1: Cover -->
                <div class="card-wrapper relative group shrink-0 snap-start z-0" style="width:270px;aspect-ratio:3/4;" role="listitem" aria-label={`Slide 1 of ${p.instagramSlideCount}: Cover`}>
                  <div class="card-capture relative w-full h-full rounded-none overflow-hidden shadow-2xl shadow-black/50">
                    {p.heroImage
                      ? <img src={p.heroImage} alt={p.heroImageAlt} class="absolute inset-0 w-full h-full object-cover" loading="lazy" crossorigin="anonymous" />
                      : <div class="absolute inset-0 bg-gradient-to-br from-gray-800 to-gray-900"></div>
                    }
                    <div class="absolute inset-0 bg-linear-to-t from-black/90 via-black/40 to-black/10"></div>
                    <div class="absolute inset-0 flex flex-col justify-between p-6">
                      <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                          <img src="/logo.svg" alt="" aria-hidden="true" class="w-7 h-7" crossorigin="anonymous" />
                          <span class="text-white/70 text-[11px] font-bold uppercase tracking-widest">Nomad Magazine</span>
                        </div>
                        <div class="flex gap-1" aria-hidden="true">
                          {Array.from({ length: p.instagramSlideCount }).map((_, i) => (
                            <div class={`rounded-full ${i === 0 ? 'bg-yellow-400 w-4 h-1.5' : 'bg-white/25 w-1.5 h-1.5'}`}></div>
                          ))}
                        </div>
                      </div>
                      <div>
