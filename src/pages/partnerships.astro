---
import Layout, { type SEOProps } from '~/layouts/Layout.astro'
import CheckIcon from '~icons/ic/baseline-check'
import ArrowRightIcon from '~icons/ic/baseline-arrow-forward'

const seo: SEOProps = {
  title: 'Partner with Nomad Magazine - B2B Partnership Opportunities',
  description: 'Partner with Nomad Magazine to reach the global digital nomad community. Join our directory, become a distribution partner, or feature your brand in our print magazine.',
  image: `${Astro.site}images/edition-001-nomad-mag-brand-placement.webp`,
  keywords: 'nomad magazine partnerships, B2B collaboration, digital nomad marketing, coworking distribution, brand partnerships, nomad directory',
  ogType: 'website',
  ldJSON: {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Partner with Nomad Magazine',
    description: 'B2B partnership opportunities with Nomad Magazine',
    url: `${Astro.site}partnerships`,
    publisher: {
      '@type': 'Organization',
      name: 'Nomad Magazine',
      logo: {
        '@type': 'ImageObject',
        url: `${Astro.site}logo.svg`,
      },
    },
  },
}

const partnershipTiers = [
  {
    id: 'directory',
    tier: 'Step 1',
    title: 'Nomad Directory',
    subtitle: 'Free Listing',
    description: 'Get listed on our website and Instagram, and be added to our database for future collaborations.',
    price: 'Free',
    features: [
      'Website listing with company link',
      'Instagram feature as new listing',
      'Newsletter note contribution opportunity'
    ],
    cta: 'Join Directory',
    ctaUrl: 'https://form.smartsuite.com/s4tmc086/8sFlvrVlDC',
    popular: false,
    bgColor: 'bg-gradient-to-br from-gray-900/50 to-gray-800/50',
    borderColor: 'border-gray-700'
  },
  {
    id: 'distribution',
    tier: 'Step 2',
    title: 'Distribution Partner',
    subtitle: 'Physical Magazine Distribution',
    description: 'Receive copies of Nomad Magazine for your coworking space, coliving, or hostel.',
    price: '€25 shipment cost only',
    features: [
      'Receive physical magazine copies',
      'Website listing as distribution partner',
      'Listing as distribution partner in print edition'
    ],
    cta: 'Apply for Distribution',
    ctaUrl: 'https://calendly.com/nomadgossip',
    popular: false,
    bgColor: 'bg-gradient-to-br from-yellow-500/20 to-orange-500/20',
    borderColor: 'border-yellow-400'
  },
  {
    id: 'brand-boost',
    tier: 'Step 3A',
    title: 'Digital Brand Boost',
    subtitle: 'Enhanced Online Visibility',
    description: 'Amplify your directory listing with homepage features, social media, and content packages.',
    price: '€50-250',
    features: [
      'Homepage feature placement',
      'Social media spotlight',
      'Newsletter inclusion'
    ],
    cta: 'View Boost Options',
    ctaUrl: '/nomad-directory-boost-options',
    popular: true,
    bgColor: 'bg-gradient-to-br from-blue-600/20 to-cyan-600/20',
    borderColor: 'border-blue-400'
  },
  {
    id: 'brand-placement',
    tier: 'Step 3B',
    title: 'Print Brand Placement',
    subtitle: 'Premium Magazine Features',
    description: 'Feature your brand in our beautifully designed print magazine with global distribution.',
    price: '€75-1,100+',
    features: [
      'Flexible placement options',
      'Status to your brand',
      'Global print distribution'
    ],
    cta: 'View Print Options',
    ctaUrl: '/brand-placement-next-edition-847291',
    popular: false,
    bgColor: 'bg-gradient-to-br from-purple-600/20 to-pink-600/20',
    borderColor: 'border-purple-400'
  }
]

const distributionBenefits = [
  {
    icon: '🌍',
    title: 'Global Reach',
    description: 'Access to digital nomads in major hubs worldwide through our curated distribution network.'
  },
  {
    icon: '📈',
    title: 'Growing Community',
    description: 'Connect with an active, engaged community of location-independent professionals and entrepreneurs.'
  },
  {
    icon: '🎯',
    title: 'Targeted Audience',
    description: 'Reach people who value freedom, independence, remote work, and innovative lifestyle choices.'
  },
  {
    icon: '🤝',
    title: 'Partnership Ecosystem',
    description: 'Join a network of forward-thinking brands and services supporting the nomad ecosystem.'
  }
]

const whyPartnerReasons = [
  {
    title: 'Growing Market',
    description: 'The digital nomad population continues to expand rapidly, with millions embracing location-independent lifestyles.',
    stat: '50M+ nomads worldwide'
  },
  {
    title: 'High Purchasing Power',
    description: 'Digital nomads typically have above-average income and actively seek services that support their lifestyle.',
    stat: 'Premium audience'
  },
  {
    title: 'Print + Digital Reach',
    description: 'Unique print-first approach combined with strong digital presence ensures maximum visibility.',
    stat: '100+ distribution points'
  },
  {
    title: 'Community Trust',
    description: 'Our authentic approach and community-first mindset builds genuine trust with our audience.',
    stat: 'High engagement rates'
  }
]
---

<Layout seo={seo}>
  <!-- Hero Section -->
  <div class="bg-hoverw text-white">
    <section class="py-20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2">
          <div class="space-y-8">
            <div class="space-y-6">
              <h1 class="text-5xl font-bold leading-tight md:text-7xl">
                Partner with <span class="text-yellow-400">Nomad Magazine</span>
              </h1>
              <p class="text-xl text-gray-300 md:text-2xl">
                Connect with the global digital nomad community through strategic partnerships that drive meaningful engagement and business growth.
              </p>
            </div>
            
            <div class="space-y-4 text-lg text-gray-300">
              <p class="flex items-start">
                <CheckIcon class="mr-3 h-6 w-6 flex-shrink-0 text-yellow-400 mt-0.5" />
                <span>Join a growing ecosystem of nomad-focused brands and services</span>
              </p>
              <p class="flex items-start">
                <CheckIcon class="mr-3 h-6 w-6 flex-shrink-0 text-yellow-400 mt-0.5" />
                <span>Reach an engaged audience of location-independent professionals</span>
              </p>
              <p class="flex items-start">
                <CheckIcon class="mr-3 h-6 w-6 flex-shrink-0 text-yellow-400 mt-0.5" />
                <span>Benefit from our unique print-first approach with global distribution</span>
              </p>
            </div>

            <div class="flex flex-col gap-4 sm:flex-row">
              <a
                href="#partnership-options"
                class="inline-flex items-center justify-center gap-2 rounded-lg bg-yellow-400 px-8 py-4 text-lg font-bold text-black transition-all hover:bg-yellow-300 hover:scale-105"
              >
                View Partnerships
                <ArrowRightIcon class="h-5 w-5" />
              </a>
              <a
                href="/nomad-directory-boost-options"
                class="inline-flex items-center justify-center gap-2 rounded-lg border-2 border-yellow-400 px-8 py-4 text-lg font-bold text-yellow-400 transition-all hover:bg-yellow-400 hover:text-black"
              >
                Directory Boosts
              </a>
            </div>
          </div>
          
          <div class="flex justify-center lg:justify-end">
            <img 
              src="/images/edition-001-nomad-mag-brand-placement.webp" 
              alt="Nomad Magazine brand placement opportunities" 
              class="max-w-full rounded-2xl shadow-2xl" 
              loading="eager"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Why Partner Section -->
    <section class="border-b border-neutral-800 py-16">
      <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        <div class="mb-12 text-center">
          <h2 class="text-3xl font-bold text-white md:text-4xl">Why Partner with Us?</h2>
        </div>

        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4">
          {whyPartnerReasons.map((reason) => (
            <div class="bg-neutral-900/50 rounded-xl p-5 border border-neutral-800 text-center">
              <div class="mb-3">
                <div class="inline-block bg-yellow-400 text-black px-2 py-1 rounded-full text-xs font-bold">
                  {reason.stat}
                </div>
              </div>
              <h3 class="text-lg font-bold text-white mb-2">{reason.title}</h3>
              <p class="text-gray-300 text-sm">{reason.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Partnership Tiers Section -->
    <section id="partnership-options" class="border-b border-neutral-800 py-20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mb-16 text-center">
          <h2 class="text-4xl font-bold text-white md:text-5xl">Partnership Opportunities</h2>
          <p class="mt-4 text-xl text-gray-300 max-w-3xl mx-auto">
            Start with our free directory listing, then choose your growth path: boost your digital presence or feature in our premium print magazine.
          </p>
        </div>

        <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-4 items-stretch">
          {partnershipTiers.map((tier) => (
            <div class={`relative overflow-hidden rounded-3xl border-2 ${tier.borderColor} ${tier.bgColor} p-8 backdrop-blur-sm transition-all hover:scale-105 flex flex-col h-full ${tier.popular ? 'ring-4 ring-yellow-400' : ''}`}>
              {tier.popular && (
                <div class="absolute top-0 right-0 bg-yellow-400 text-black px-4 py-2 text-sm font-bold rounded-bl-lg">
                  Most Popular
                </div>
              )}
              
              <div class="mb-6">
                <div class="mb-2 text-sm font-semibold text-yellow-400 uppercase tracking-wide">
                  {tier.tier}
                </div>
                <h3 class="text-2xl font-bold text-white">{tier.title}</h3>
                <p class="text-lg text-gray-300">{tier.subtitle}</p>
              </div>

              <div class="mb-6">
                <div class="text-3xl font-bold text-white">{tier.price}</div>
              </div>

              <div class="flex-grow">
                <p class="text-gray-300 mb-6">{tier.description}</p>
                
                <ul class="space-y-3 mb-8">
                  {tier.features.map((feature) => (
                    <li class="flex items-start">
                      <CheckIcon class="mr-3 h-5 w-5 flex-shrink-0 text-yellow-400 mt-0.5" />
                      <span class="text-gray-300">{feature}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <a
                href={tier.ctaUrl}
                target={tier.ctaUrl.startsWith('http') ? '_blank' : '_self'}
                rel={tier.ctaUrl.startsWith('http') ? 'noopener noreferrer' : undefined}
                class={`block w-full rounded-lg py-4 text-center font-bold transition-all mt-auto ${
                  tier.popular 
                    ? 'bg-yellow-400 text-black hover:bg-yellow-300' 
                    : 'border-2 border-yellow-400 text-yellow-400 hover:bg-yellow-400 hover:text-black'
                }`}
              >
                {tier.cta}
              </a>
            </div>
          ))}
        </div>

        <div class="mt-12 text-center">
          <div class="flex flex-col gap-4 sm:flex-row sm:justify-center">
            <a
              href="https://calendly.com/nomadgossip"
              class="inline-flex items-center gap-2 rounded-lg bg-neutral-800 border border-neutral-700 px-6 py-3 text-white transition-all hover:bg-neutral-700"
            >
              Schedule Partnership Call
              <ArrowRightIcon class="h-4 w-4" />
            </a>
            <a
              href="/nomad-directory-boost-options"
              class="inline-flex items-center gap-2 rounded-lg border border-yellow-400 px-6 py-3 text-yellow-400 transition-all hover:bg-yellow-400 hover:text-black"
            >
              Directory Boosts
              <ArrowRightIcon class="h-4 w-4" />
            </a>
          </div>
        </div>
      </div>
    </section>



    <!-- About Our Mission Section -->
    <section class="border-b border-neutral-800 py-16">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-3xl font-bold text-white mb-6 md:text-4xl">Our Mission</h2>
        <div class="space-y-4 text-gray-300">
          <p>
            We support the growth of the digital nomad ecosystem and bridge the gap between nomads and local communities worldwide.
          </p>
          <p>
            As a self-funded project, we choose partnerships over traditional advertising to maintain our authentic voice while supporting the businesses that make the nomad lifestyle possible.
          </p>
        </div>
      </div>
    </section>

    <!-- Call to Action Section -->
    <section class="py-16">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-3xl font-bold text-white mb-4 md:text-4xl">Ready to Partner?</h2>
        
        <div class="flex flex-col gap-4 sm:flex-row sm:justify-center">
          <a
            href="https://form.smartsuite.com/s4tmc086/8sFlvrVlDC"
            class="inline-flex items-center justify-center gap-2 rounded-lg bg-yellow-400 px-8 py-4 text-lg font-bold text-black transition-all hover:bg-yellow-300 hover:scale-105"
          >
            Start with Directory Listing
            <ArrowRightIcon class="h-5 w-5" />
          </a>
        </div>
        
        <p class="mt-6 text-sm text-gray-400">
          Questions? Email us at <a href="mailto:partnerships@nomad-magazine.com" class="text-yellow-400 hover:text-yellow-300">partnerships@nomad-magazine.com</a>
        </p>
      </div>
    </section>
  </div>
</Layout>

<style>
.hover\:scale-105:hover {
  transform: scale(1.05);
}
</style>
