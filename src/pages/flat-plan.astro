---
export const prerender = true;

import Layout, { type SEOProps } from '~/layouts/Layout.astro'

const seo: SEOProps = {
  title: 'Magazine Flat Plan - Nomad Magazine Design Layout',
  description: 'Explore the complete flat plan layout for Nomad Magazine featuring 50 pages of inspiring digital nomad content, stories, and visuals.',
  image: `${Astro.site}images/edition-003-cover_holded_front_face.webp`,
  keywords: 'flat plan, magazine layout, design, nomad magazine, editorial design, page layout, magazine structure',
  ogType: 'website',
}

// Sample magazine pages data - using existing images
const magazinePages = [
  // Cover & Opening
  { id: 1, title: "Front Cover", type: "cover", image: "/images/edition-003-cover_holded_front_face.webp", description: "Stunning cover featuring nomadic adventures and wanderlust" },
  { id: 2, title: "Table of Contents", type: "toc", image: "/images/edition-003-table-of-contents.webp", description: "Elegant contents page with article previews and page numbers" },
  { id: 3, title: "Editor's Letter", type: "editorial", image: "/images/edition-001-first-edition-comments.webp", description: "Personal welcome from our editorial team" },
  { id: 4, title: "Contributors", type: "credits", image: "/images/example-link-contributors.webp", description: "Meet the talented writers and photographers" },
  
