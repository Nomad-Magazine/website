  { id: 21, title: "Bansko Nomad Fest", type: "events", image: "/images/edition-001-bansko-nomad-fest.webp", description: "Highlights from Europe's biggest nomad gathering" },
  { id: 22, title: "Chiang Mai Summit", type: "events", image: "/images/edition-001-chiang-mai-thailand-nomad-summit.webp", description: "Networking and learning in Thailand's digital hub" },
  { id: 23, title: "Coliving Fukuoka", type: "community", image: "/images/edition-002-japan-colive-fukuoka-interview.webp", description: "Inside Japan's innovative coliving spaces" },
  { id: 24, title: "Building Connections", type: "community", image: "/images/edition-003-how-to-break-the-ice-loretta-browning.webp", description: "Making meaningful friendships while nomadic" },
  
  // Personal Stories
  { id: 25, title: "90 Countries Journey", type: "personal", image: "/images/edition-003-90-countries-in-12-years-jimmy-naraine.webp", description: "One nomad's incredible decade-long adventure" },
  { id: 26, title: "Love Story: 30 Years Together", type: "personal", image: "/images/edition-002-caroullou-michel-30-years-nomads-love-story.webp", description: "How one couple maintained love across continents" },
  { id: 27, title: "Family Nomad Chronicles", type: "personal", image: "/images/edition-002-nomad-family-lulu-lundt.webp", description: "Raising children while living a nomadic lifestyle" },
  { id: 28, title: "Five Years Anniversary", type: "personal", image: "/images/edition-001-victoria-puzach-five-years-nomad-anniversary.webp", description: "Reflections on half a decade of wandering" },
  
  // Wellness & Growth
  { id: 29, title: "Astrocartography Guide", type: "wellness", image: "/images/edition-003-alina-crown-astrocartography.webp", description: "Using cosmic maps to guide your travels" },
  { id: 30, title: "Mindvalley Book Club", type: "growth", image: "/images/edition-002-kristina-mänd-lakhiani_minvalley_bookclub_nomad_magazine.webp", description: "Expanding minds through shared reading" },
  { id: 31, title: "Social Wealth Strategies", type: "growth", image: "/images/edition-003-strategies-to-gain-social-wealth-shelley-doyle.webp", description: "Building meaningful networks and relationships" },
  { id: 32, title: "From Police to Pet Sitter", type: "growth", image: "/images/from-police-to-pet-sitter-jessica-holmes.webp", description: "Career transformation stories that inspire" },
  
  // Food & Travel
  { id: 33, title: "Eating Your Way Through Japan", type: "food", image: "/images/edition-002-eating-your-way-to-japan_double-page.webp", description: "Culinary adventures in the Land of Rising Sun" },
  { id: 34, title: "Guatemala Coliving", type: "travel", image: "/images/edition-003-guatemala-coliving-bianca-bonilla.webp", description: "Central America's emerging nomad destination" },
  { id: 35, title: "Eastern European Promises", type: "travel", image: "/images/edition-002-eastern-promises-tomas-mrva.webp", description: "Discovering hidden gems in Eastern Europe" },
  { id: 36, title: "Travel Fashion Trends", type: "lifestyle", image: "/images/capsbold-thumpnail-hand-with-phone.webp", description: "Staying stylish while living out of a suitcase" },
  
  // Technology & Innovation
  { id: 37, title: "AI and Future of Work", type: "tech", image: "/images/edition-001-santiago-sosa-ai.webp", description: "How artificial intelligence is reshaping careers" },
  { id: 38, title: "Digital Nomad Tools 2025", type: "tech", image: "/images/capsbold-thumpnail-purple.webp", description: "Essential apps and services for modern nomads" },
  { id: 39, title: "Coworking Space Design", type: "tech", image: "/images/coworking-contest-instagam-share-vote.png", description: "The future of collaborative workspaces" },
  { id: 40, title: "Remote Team Management", type: "tech", image: "/images/distribution_sowo_coworking_barcelona.webp", description: "Leading distributed teams effectively" },
  
  // Advertising & Partnerships
  { id: 41, title: "Nomad Cruise Partnership", type: "ad", image: "/images/edition-001-nomad-cruise-double-page-advertising.webp", description: "Premium advertising space for travel partners" },
  { id: 42, title: "Tulsa Remote Program", type: "ad", image: "/images/edition-002-double-page-advertising-tulsa-remote.webp", description: "Sponsored content featuring relocation programs" },
  { id: 43, title: "Global Pass Advertisement", type: "ad", image: "/images/edition-002-ad-nomad-global-pass.webp", description: "Travel services and nomad-friendly products" },
  { id: 44, title: "No Solo Travel", type: "ad", image: "/images/edition-003-dvertisement-No-Solo-half-page.webp", description: "Community-focused travel solutions" },
  
  // Back Matter
  { id: 45, title: "Nomad Directory", type: "directory", image: "/images/edition-003-nomad-directory.webp", description: "Comprehensive resource guide for nomads" },
  { id: 46, title: "Top Coliving Spaces", type: "directory", image: "/images/edition-003-top-coliving-mapmelon.webp", description: "Curated selection of the world's best coliving" },
  { id: 47, title: "Reader Submissions", type: "community", image: "/images/all_readers.webp", description: "Stories and photos from our global community" },
  { id: 48, title: "Next Issue Preview", type: "preview", image: "/images/edition-123-three-together-transparent.webp", description: "Sneak peek at upcoming content and features" },
  { id: 49, title: "Subscription Info", type: "info", image: "/images/free_article.webp", description: "How to stay connected with Nomad Magazine" },
  { id: 50, title: "Back Cover", type: "cover", image: "/images/hot-air-balloon.webp", description: "Inspiring closing image for the journey ahead" },
]

const pageTypes = {
  cover: { color: "from-purple-600 to-pink-600", icon: "📖" },
  toc: { color: "from-blue-600 to-indigo-600", icon: "📋" },
  editorial: { color: "from-green-600 to-emerald-600", icon: "✍️" },
  credits: { color: "from-gray-600 to-slate-600", icon: "👥" },
  feature: { color: "from-orange-600 to-red-600", icon: "⭐" },
  spread: { color: "from-purple-600 to-violet-600", icon: "🖼️" },
  lifestyle: { color: "from-pink-600 to-rose-600", icon: "🌸" },
  culture: { color: "from-teal-600 to-cyan-600", icon: "🌍" },
  destination: { color: "from-yellow-600 to-amber-600", icon: "🏝️" },
  finance: { color: "from-emerald-600 to-green-600", icon: "💰" },
  business: { color: "from-indigo-600 to-blue-600", icon: "💼" },
  events: { color: "from-red-600 to-pink-600", icon: "🎉" },
  community: { color: "from-cyan-600 to-blue-600", icon: "🤝" },
  personal: { color: "from-violet-600 to-purple-600", icon: "💫" },
  wellness: { color: "from-green-600 to-teal-600", icon: "🧘" },
  growth: { color: "from-amber-600 to-orange-600", icon: "🌱" },
  food: { color: "from-red-600 to-orange-600", icon: "🍜" },
  travel: { color: "from-blue-600 to-cyan-600", icon: "✈️" },
  tech: { color: "from-slate-600 to-gray-600", icon: "💻" },
  ad: { color: "from-yellow-500 to-amber-500", icon: "🎯" },
  directory: { color: "from-indigo-500 to-purple-500", icon: "📚" },
  preview: { color: "from-pink-500 to-rose-500", icon: "👀" },
  info: { color: "from-gray-500 to-slate-500", icon: "ℹ️" },
}
---

<Layout seo={seo}>
  <div class="bg-hoverw text-white min-h-screen">
    <!-- Hero Section -->
    <section class="relative overflow-hidden">
      <!-- Background Pattern -->
      <div class="absolute inset-0 opacity-5">
        <div class="absolute inset-0" style="background-image: radial-gradient(circle at 25% 25%, #fbbf24 1px, transparent 1px), radial-gradient(circle at 75% 75%, #fbbf24 1px, transparent 1px); background-size: 50px 50px;"></div>
      </div>
      
      <div class="relative px-4 py-20 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-7xl text-center">
          <div class="mb-6">
            <span class="inline-block bg-gradient-to-r from-yellow-400 to-amber-500 bg-clip-text text-transparent text-sm font-bold uppercase tracking-wider">
              Editorial Design
            </span>
          </div>
          <h1 class="text-5xl font-bold sm:text-7xl lg:text-8xl mb-8">
            Magazine
            <span class="block bg-gradient-to-r from-yellow-400 via-amber-500 to-orange-500 bg-clip-text text-transparent">
              Flat Plan
            </span>
          </h1>
          <p class="text-xl text-neutral-300 mb-12 max-w-3xl mx-auto leading-relaxed">
            Explore the complete editorial architecture of our 50-page digital magazine. 
            Each page meticulously crafted to tell compelling stories of nomadic life, 
            adventure, and the pursuit of freedom.
          </p>
          
          <!-- Stats -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-2xl mx-auto">
            <div class="text-center">
              <div class="text-3xl font-bold text-yellow-400 mb-2">50</div>
              <div class="text-sm text-neutral-400 uppercase tracking-wider">Pages</div>
            </div>
            <div class="text-center">
              <div class="text-3xl font-bold text-yellow-400 mb-2">12</div>
              <div class="text-sm text-neutral-400 uppercase tracking-wider">Content Types</div>
            </div>
            <div class="text-center">
              <div class="text-3xl font-bold text-yellow-400 mb-2">∞</div>
              <div class="text-sm text-neutral-400 uppercase tracking-wider">Inspiration</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Filter Section -->
    <section class="px-4 py-8 sm:px-6 lg:px-8 border-b border-gray-800">
      <div class="mx-auto max-w-7xl">
        <div class="flex flex-wrap justify-center gap-3">
          <button class="filter-btn active px-4 py-2 rounded-full text-sm font-medium transition-all duration-300 bg-yellow-400 text-black" data-filter="all">
            All Pages
          </button>
          <button class="filter-btn px-4 py-2 rounded-full text-sm font-medium transition-all duration-300 bg-gray-800 text-gray-300 hover:bg-gray-700" data-filter="feature">
            Features
          </button>
          <button class="filter-btn px-4 py-2 rounded-full text-sm font-medium transition-all duration-300 bg-gray-800 text-gray-300 hover:bg-gray-700" data-filter="destination">
            Destinations
          </button>
          <button class="filter-btn px-4 py-2 rounded-full text-sm font-medium transition-all duration-300 bg-gray-800 text-gray-300 hover:bg-gray-700" data-filter="lifestyle">
            Lifestyle
          </button>
          <button class="filter-btn px-4 py-2 rounded-full text-sm font-medium transition-all duration-300 bg-gray-800 text-gray-300 hover:bg-gray-700" data-filter="business">
            Business
          </button>
          <button class="filter-btn px-4 py-2 rounded-full text-sm font-medium transition-all duration-300 bg-gray-800 text-gray-300 hover:bg-gray-700" data-filter="personal">
            Stories
          </button>
        </div>
      </div>
    </section>

    <!-- Flat Plan Grid -->
    <section class="px-4 py-16 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 2xl:grid-cols-5 gap-6" id="flat-plan-grid">
          {magazinePages.map((page) => {
            const typeConfig = pageTypes[page.type as keyof typeof pageTypes] || pageTypes.feature;
            return (
              <div class={`page-card group relative overflow-hidden rounded-2xl bg-gradient-to-br ${typeConfig.color} p-1 transition-all duration-500 hover:scale-105 hover:shadow-2xl hover:shadow-yellow-400/20`} data-type={page.type}>
                <div class="relative h-full rounded-xl bg-gray-900/90 backdrop-blur-sm p-6 flex flex-col">
                  <!-- Page Number & Type -->
                  <div class="flex items-center justify-between mb-4">
                    <div class="flex items-center gap-2">
                      <span class="text-2xl">{typeConfig.icon}</span>
                      <span class="text-xs font-bold text-yellow-400 uppercase tracking-wider">
                        {page.type}
                      </span>
                    </div>
                    <div class="text-right">
                      <div class="text-2xl font-bold text-white">
                        {String(page.id).padStart(2, '0')}
                      </div>
                      <div class="text-xs text-gray-400">PAGE</div>
                    </div>
                  </div>

                  <!-- Image Preview -->
                  <div class="relative mb-4 flex-1 cursor-pointer image-preview" data-page-index={page.id - 1}>
                    <div class="aspect-[3/4] overflow-hidden rounded-lg bg-gray-800">
                      <img 
                        src={page.image} 
                        alt={page.title}
                        class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-110"
                        loading="lazy"
                      />
                      <!-- Overlay -->
                      <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                    </div>
                    
                    <!-- Hover Preview -->
                    <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all duration-300">
                      <div class="bg-black/80 backdrop-blur-sm rounded-lg px-4 py-2 flex items-center gap-2">
                        <svg class="w-4 h-4 text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"/>
                        </svg>
                        <span class="text-xs text-white font-medium">View & Zoom</span>
                      </div>
                    </div>
                  </div>

                  <!-- Content -->
                  <div class="space-y-3">
                    <h3 class="font-bold text-white text-lg leading-tight line-clamp-2 group-hover:text-yellow-400 transition-colors duration-300">
                      {page.title}
                    </h3>
                    <p class="text-sm text-gray-300 leading-relaxed line-clamp-3">
                      {page.description}
                    </p>
                  </div>

                  <!-- Decorative Elements -->
                  <div class="absolute top-0 right-0 w-20 h-20 bg-gradient-to-br from-white/5 to-transparent rounded-bl-full opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                  <div class="absolute bottom-0 left-0 w-16 h-16 bg-gradient-to-tr from-yellow-400/10 to-transparent rounded-tr-full opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- Magazine Stats -->
    <section class="px-4 py-16 sm:px-6 lg:px-8 border-t border-gray-800">
      <div class="mx-auto max-w-4xl text-center">
        <h2 class="text-3xl font-bold mb-8">Editorial Breakdown</h2>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
          <div class="bg-gray-900/50 rounded-xl p-6 backdrop-blur-sm border border-gray-800">
            <div class="text-2xl mb-2">📖</div>
            <div class="text-2xl font-bold text-yellow-400 mb-1">8</div>
            <div class="text-sm text-gray-400">Feature Stories</div>
          </div>
          <div class="bg-gray-900/50 rounded-xl p-6 backdrop-blur-sm border border-gray-800">
            <div class="text-2xl mb-2">🏝️</div>
            <div class="text-2xl font-bold text-yellow-400 mb-1">6</div>
            <div class="text-sm text-gray-400">Destinations</div>
          </div>
          <div class="bg-gray-900/50 rounded-xl p-6 backdrop-blur-sm border border-gray-800">
            <div class="text-2xl mb-2">💫</div>
            <div class="text-2xl font-bold text-yellow-400 mb-1">4</div>
            <div class="text-sm text-gray-400">Personal Stories</div>
          </div>
          <div class="bg-gray-900/50 rounded-xl p-6 backdrop-blur-sm border border-gray-800">
            <div class="text-2xl mb-2">🎯</div>
            <div class="text-2xl font-bold text-yellow-400 mb-1">4</div>
            <div class="text-sm text-gray-400">Partner Content</div>
          </div>
        </div>
      </div>
    </section>
  </div>

  <!-- Image Modal -->
  <div id="imageModal" class="fixed inset-0 bg-black/95 backdrop-blur-sm z-50 hidden">
    <div class="flex items-center justify-center h-full p-4">
      <!-- Close Button -->
      <button id="closeModal" class="absolute top-6 right-6 text-white hover:text-yellow-400 transition-colors z-60">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>

      <!-- Navigation Arrows -->
      <button id="prevImage" class="absolute left-6 top-1/2 transform -translate-y-1/2 text-white hover:text-yellow-400 transition-colors z-60 bg-black/50 rounded-full p-3 hover:bg-black/70">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
      </button>
      
      <button id="nextImage" class="absolute right-6 top-1/2 transform -translate-y-1/2 text-white hover:text-yellow-400 transition-colors z-60 bg-black/50 rounded-full p-3 hover:bg-black/70">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
      </button>

      <!-- Image Container -->
      <div class="relative max-w-6xl max-h-full flex items-center justify-center">
        <div id="imageContainer" class="relative overflow-hidden rounded-lg">
          <img id="modalImage" class="max-w-full max-h-[80vh] object-contain transition-transform duration-300 cursor-grab active:cursor-grabbing" />
        </div>
      </div>

      <!-- Zoom Controls -->
      <div class="absolute bottom-6 left-1/2 transform -translate-x-1/2 flex items-center gap-4 bg-black/70 rounded-full px-6 py-3">
        <button id="zoomOut" class="text-white hover:text-yellow-400 transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM13 10H7"/>
          </svg>
        </button>
        <span id="zoomLevel" class="text-white text-sm font-medium min-w-[3rem] text-center">100%</span>
        <button id="zoomIn" class="text-white hover:text-yellow-400 transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"/>
          </svg>
        </button>
        <button id="resetZoom" class="text-white hover:text-yellow-400 transition-colors text-sm">Reset</button>
      </div>

      <!-- Page Info -->
      <div class="absolute top-6 left-6 bg-black/70 rounded-lg px-4 py-3 max-w-md">
        <div class="flex items-center gap-3 mb-2">
          <span id="modalPageNumber" class="text-2xl font-bold text-yellow-400">01</span>
          <span id="modalPageType" class="text-xs font-bold text-yellow-400 uppercase tracking-wider bg-yellow-400/20 px-2 py-1 rounded">Feature</span>
        </div>
        <h3 id="modalPageTitle" class="text-white font-bold text-lg mb-2">Page Title</h3>
        <p id="modalPageDescription" class="text-gray-300 text-sm leading-relaxed">Page description goes here.</p>
      </div>

      <!-- Progress Indicator -->
      <div class="absolute bottom-20 left-1/2 transform -translate-x-1/2 text-white text-sm">
        <span id="currentPageNum">1</span> of <span id="totalPages">50</span>
      </div>
    </div>
  </div>

