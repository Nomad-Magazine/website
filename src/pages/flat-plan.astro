  { id: 11, title: "Local Communities Impact", type: "culture", image: "/images/edition-001-local-communities-stella-airoldi.webp", description: "How nomads can positively impact local economies" },
  { id: 12, title: "Cultural Immersion", type: "culture", image: "/images/edition-002-japanese-wisdom-jessica-holmes.webp", description: "Learning from ancient wisdom in modern times" },
  
  // Destinations
  { id: 13, title: "Buenos Aires Guide", type: "destination", image: "/images/edition-003-buenos-aires-a-city-that-moves-with.webp", description: "The ultimate digital nomad hub in South America" },
  { id: 14, title: "Cape Town Adventures", type: "destination", image: "/images/edition-003-cape-town-simon-watson.webp", description: "Discovering the Mother City's nomad scene" },
  { id: 15, title: "Madeira Island Life", type: "destination", image: "/images/edition-002-madeira-scene-lera-pitiakova.webp", description: "Portugal's hidden gem for remote workers" },
  { id: 16, title: "Japan Experience", type: "destination", image: "/images/edition-002-fukuoka-prefecture-photos.webp", description: "Traditional meets modern in the Land of Rising Sun" },
  
  // Business & Finance
  { id: 17, title: "Crypto for Nomads", type: "finance", image: "/images/edition-002-crypto-francesco-silicani.webp", description: "Navigating digital currencies while traveling" },
  { id: 18, title: "Insurance Truths", type: "finance", image: "/images/edition-001-insurance-truths-christoph-huebner.webp", description: "What every nomad needs to know about coverage" },
  { id: 19, title: "Building Online Business", type: "business", image: "/images/edition-003-how-to-start-a-online-business-in-2025-martin-donadieu.webp", description: "From idea to income: a comprehensive guide" },
  { id: 20, title: "Escaping the Rat Race", type: "business", image: "/images/edition-001-rat-race-freedom-tarek-kholoussy.webp", description: "Breaking free from traditional employment" },
  
