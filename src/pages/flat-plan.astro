      { id: 38, title: "Digital Nomad Tools 2025", type: "tech", image: "/images/capsbold-thumpnail-purple.webp", description: "Essential apps and services for modern nomads" },
      { id: 39, title: "Coworking Space Design", type: "tech", image: "/images/coworking-contest-instagam-share-vote.png", description: "The future of collaborative workspaces" },
      { id: 40, title: "Remote Team Management", type: "tech", image: "/images/distribution_sowo_coworking_barcelona.webp", description: "Leading distributed teams effectively" },
      { id: 41, title: "Nomad Cruise Partnership", type: "ad", image: "/images/edition-001-nomad-cruise-double-page-advertising.webp", description: "Premium advertising space for travel partners" },
      { id: 42, title: "Tulsa Remote Program", type: "ad", image: "/images/edition-002-double-page-advertising-tulsa-remote.webp", description: "Sponsored content featuring relocation programs" },
      { id: 43, title: "Global Pass Advertisement", type: "ad", image: "/images/edition-002-ad-nomad-global-pass.webp", description: "Travel services and nomad-friendly products" },
      { id: 44, title: "No Solo Travel", type: "ad", image: "/images/edition-003-dvertisement-No-Solo-half-page.webp", description: "Community-focused travel solutions" },
      { id: 45, title: "Nomad Directory", type: "directory", image: "/images/edition-003-nomad-directory.webp", description: "Comprehensive resource guide for nomads" },
      { id: 46, title: "Top Coliving Spaces", type: "directory", image: "/images/edition-003-top-coliving-mapmelon.webp", description: "Curated selection of the world's best coliving" },
      { id: 47, title: "Reader Submissions", type: "community", image: "/images/all_readers.webp", description: "Stories and photos from our global community" },
      { id: 48, title: "Next Issue Preview", type: "preview", image: "/images/edition-123-three-together-transparent.webp", description: "Sneak peek at upcoming content and features" },
      { id: 49, title: "Subscription Info", type: "info", image: "/images/free_article.webp", description: "How to stay connected with Nomad Magazine" },
      { id: 50, title: "Back Cover", type: "cover", image: "/images/hot-air-balloon.webp", description: "Inspiring closing image for the journey ahead" }
    ];

    let currentImageIndex = 0;
    let zoomLevel = 1;
    let isDragging = false;
    let startX = 0;
    let startY = 0;
    let translateX = 0;
    let translateY = 0;

    // Modal functions
    function openModal(index: number) {
      currentImageIndex = index;
      const modal = document.getElementById('imageModal');
      modal?.classList.remove('hidden');
      (document.body as HTMLElement).style.overflow = 'hidden';
      updateModalContent();
    }

    function closeModal() {
      const modal = document.getElementById('imageModal');
      modal?.classList.add('hidden');
      (document.body as HTMLElement).style.overflow = 'auto';
      resetZoomLevel();
    }

    function updateModalContent() {
      const page = magazinePages[currentImageIndex];
      const modalImage = document.getElementById('modalImage') as HTMLImageElement;
      const modalPageNumber = document.getElementById('modalPageNumber');
      const modalPageType = document.getElementById('modalPageType');
      const modalPageTitle = document.getElementById('modalPageTitle');
      const modalPageDescription = document.getElementById('modalPageDescription');
      const currentPageNum = document.getElementById('currentPageNum');
      const totalPages = document.getElementById('totalPages');

      if (modalImage) {
        modalImage.src = page.image;
        modalImage.alt = page.title;
      }
      if (modalPageNumber) modalPageNumber.textContent = String(page.id).padStart(2, '0');
      if (modalPageType) modalPageType.textContent = page.type;
      if (modalPageTitle) modalPageTitle.textContent = page.title;
      if (modalPageDescription) modalPageDescription.textContent = page.description;
      if (currentPageNum) currentPageNum.textContent = String(currentImageIndex + 1);
      if (totalPages) totalPages.textContent = String(magazinePages.length);
    }

    function nextImage() {
      currentImageIndex = (currentImageIndex + 1) % magazinePages.length;
      updateModalContent();
      resetZoomLevel();
    }

    function prevImage() {
      currentImageIndex = (currentImageIndex - 1 + magazinePages.length) % magazinePages.length;
      updateModalContent();
      resetZoomLevel();
    }

    function zoomIn() {
      zoomLevel = Math.min(zoomLevel * 1.2, 3);
      updateImageTransform();
    }

    function zoomOut() {
      zoomLevel = Math.max(zoomLevel / 1.2, 0.5);
      updateImageTransform();
    }

    function resetZoomLevel() {
      zoomLevel = 1;
      translateX = 0;
      translateY = 0;
      updateImageTransform();
    }

    function updateImageTransform() {
      const modalImage = document.getElementById('modalImage') as HTMLElement;
      const zoomLevelSpan = document.getElementById('zoomLevel');
      if (modalImage) {
        modalImage.style.transform = `scale(${zoomLevel}) translate(${translateX}px, ${translateY}px)`;
      }
      if (zoomLevelSpan) {
        zoomLevelSpan.textContent = Math.round(zoomLevel * 100) + '%';
      }
    }

    // Filter functionality
    document.addEventListener('DOMContentLoaded', function() {
      const filterButtons = document.querySelectorAll('.filter-btn');
      const pageCards = document.querySelectorAll('.page-card');

      filterButtons.forEach(button => {
        button.addEventListener('click', function(this: HTMLElement) {
          const filter = this.getAttribute('data-filter');
          
          // Update active button
          filterButtons.forEach(btn => {
            btn.classList.remove('active');
            btn.classList.add('bg-gray-800', 'text-gray-300');
            btn.classList.remove('bg-yellow-400', 'text-black');
          });
          
          this.classList.add('active');
          this.classList.remove('bg-gray-800', 'text-gray-300');
          this.classList.add('bg-yellow-400', 'text-black');
          
          // Filter pages
          pageCards.forEach(card => {
            if (filter === 'all' || card.getAttribute('data-type') === filter) {
              card.classList.remove('hidden');
              (card as HTMLElement).style.animation = 'fadeInUp 0.6s ease-out';
            } else {
              card.classList.add('hidden');
            }
          });
        });
      });

      // Smooth scroll on load
      window.addEventListener('load', function() {
        (document.body as HTMLElement).style.scrollBehavior = 'smooth';
      });

      // Add intersection observer for animations
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            (entry.target as HTMLElement).style.animationDelay = '0s';
            (entry.target as HTMLElement).style.animation = 'fadeInUp 0.6s ease-out';
          }
        });
      }, { threshold: 0.1 });

      pageCards.forEach(card => {
        observer.observe(card);
      });

      // Modal event listeners
      const modal = document.getElementById('imageModal');
      const modalImage = document.getElementById('modalImage');
      const closeModalBtn = document.getElementById('closeModal');
      const prevBtn = document.getElementById('prevImage');
      const nextBtn = document.getElementById('nextImage');
      const zoomInBtn = document.getElementById('zoomIn');
      const zoomOutBtn = document.getElementById('zoomOut');
      const resetZoomBtn = document.getElementById('resetZoom');

      // Add click listeners to image previews
      const imagePreviews = document.querySelectorAll('.image-preview');
      imagePreviews.forEach(preview => {
        preview.addEventListener('click', () => {
          const pageIndex = parseInt(preview.getAttribute('data-page-index') || '0');
          openModal(pageIndex);
        });
      });

      // Close modal
      closeModalBtn?.addEventListener('click', closeModal);
      modal?.addEventListener('click', (e) => {
        if (e.target === modal) closeModal();
      });

      // Navigation
      prevBtn?.addEventListener('click', prevImage);
      nextBtn?.addEventListener('click', nextImage);

      // Zoom controls
      zoomInBtn?.addEventListener('click', zoomIn);
      zoomOutBtn?.addEventListener('click', zoomOut);
      resetZoomBtn?.addEventListener('click', resetZoomLevel);

      // Keyboard navigation
      document.addEventListener('keydown', (e) => {
        if (!modal?.classList.contains('hidden')) {
          switch(e.key) {
            case 'Escape':
              closeModal();
              break;
            case 'ArrowLeft':
              prevImage();
              break;
            case 'ArrowRight':
              nextImage();
              break;
            case '+':
            case '=':
              zoomIn();
              break;
            case '-':
              zoomOut();
              break;
            case '0':
              resetZoomLevel();
              break;
          }
        }
      });

      // Mouse drag functionality for panning
      modalImage?.addEventListener('mousedown', (e) => {
        if (zoomLevel > 1) {
          isDragging = true;
          startX = e.clientX - translateX;
          startY = e.clientY - translateY;
          if (modalImage) {
            modalImage.style.cursor = 'grabbing';
          }
          e.preventDefault();
        }
      });

      document.addEventListener('mousemove', (e) => {
        if (isDragging && zoomLevel > 1) {
          translateX = e.clientX - startX;
          translateY = e.clientY - startY;
          updateImageTransform();
        }
      });

      document.addEventListener('mouseup', () => {
        if (isDragging) {
          isDragging = false;
          if (modalImage) {
            modalImage.style.cursor = zoomLevel > 1 ? 'grab' : 'default';
          }
        }
      });

      // Mouse wheel zoom
      modalImage?.addEventListener('wheel', (e) => {
        e.preventDefault();
        if (e.deltaY < 0) {
          zoomIn();
        } else {
          zoomOut();
        }
      });
    });
  </script>
