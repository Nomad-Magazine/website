---
export const prerender = true;

import { fetchReportRecords } from '~/utils/smartsuite'
import Layout, { type SEOProps } from '~/layouts/Layout.astro'
import MaterialSymbolsElectricBolt from '~icons/material-symbols/electric-bolt'

const { records = [] } = await fetchReportRecords('6857167d82358a0f5e038c3f')

const monthlySupporters = [
  'DataBench', 'Max Browser', 'DataBench (Max Browser)', 'Max',
  'NomadTax Bulgaria Ltd.', 'Colive Fukuoka',
  'The Center for Competitiveness and Innovation (Colombia)', 'SSBM Consulting LLC',
]
const featuredPartners = ['Colive Fukuoka', 'Falmouth University', 'InterNations', 'NomadTax Bulgaria Ltd.', 'Max Browser', 'Coconut-Office']
const pinnedItems = ['SSBM Consulting LLC', 'Coconut-Office']
const featuredItems = ['SSBM Consulting LLC', 'DataBench']
const darkLogoCompanies = ['Fresh Global', 'Falmouth University', 'SUMA', 'Scaglia y Asociados', 'goldenweeks']

const isSupporter = (r: any) =>
  r.supporter || r.monthly_supporter || r.is_supporter ||
  r.supporter_status === 'Monthly Supporter' || r.status === 'Monthly Supporter' ||
  monthlySupporters.includes(r.title)

const isFeatured = (r: any) => featuredItems.includes(r.title)

const activeRecords = records
  .filter((r: any) => r.sf4ad525dd)
  .sort((a: any, b: any) => {
    const ap = pinnedItems.includes(a.title), bp = pinnedItems.includes(b.title)
    const af = isFeatured(a), bf = isFeatured(b)
    if (ap && !bp) return -1; if (!ap && bp) return 1
    if (af && !bf) return -1; if (!af && bf) return 1
    const as_ = isSupporter(a), bs = isSupporter(b)
    if (as_ && !bs) return -1; if (!as_ && bs) return 1
    return 0
  })
  .map((r: any, i: number) => ({
    id: String(r.id || i),
    index: i + 1,
    title: r.title || '',
    category: r.sb685ab800?.label || '',
    description: r.scea90e502 || '',
    specialOffer: r.s5576966ee || '',
    link: r.link || r.sb788c266b?.[0] || '',
    image: (r.image && r.image !== '/logo.svg') ? r.image : '',
    isSupporter: isSupporter(r),
    isFeatured: isFeatured(r),
    isFeaturedPartner: featuredPartners.includes(r.title),
    isDark: darkLogoCompanies.includes(r.title),
  }))

const total = activeRecords.length

const categoryCounts: Record<string, number> = {}
activeRecords.forEach((r: any) => {
  if (r.category) categoryCounts[r.category] = (categoryCounts[r.category] || 0) + 1
})
const categories = Object.entries(categoryCounts).sort((a, b) => b[1] - a[1])

const COUNTRY_TO_CONTINENT: Record<string, string> = {
  Portugal: 'Europe', Spain: 'Europe', Italy: 'Europe', France: 'Europe',
  Germany: 'Europe', 'United Kingdom': 'Europe', Netherlands: 'Europe',
  Greece: 'Europe', Bulgaria: 'Europe', Hungary: 'Europe', Ireland: 'Europe',
  Slovenia: 'Europe', Croatia: 'Europe', Slovakia: 'Europe', Austria: 'Europe',
  Poland: 'Europe', Malta: 'Europe', Belgium: 'Europe', Switzerland: 'Europe',
  Japan: 'Asia', Thailand: 'Asia', Vietnam: 'Asia', Indonesia: 'Asia',
  Argentina: 'South America', Colombia: 'South America', Brazil: 'South America',
  'Costa Rica': 'Central America', Mexico: 'North America',
}
const COUNTRY_ALIASES: Record<string, string> = {
  NL: 'Netherlands', 'The Netherlands': 'Netherlands',
  Slovenija: 'Slovenia', UK: 'United Kingdom', Bali: 'Indonesia',
}
function extractCountry(loc: string): string {
  if (!loc) return ''
  const parts = loc.split(',')
  if (parts.length >= 2) {
    const raw = parts[parts.length - 1].trim()
    return COUNTRY_ALIASES[raw] || raw
  }
  return ''
}
function slugifyLoc(str: string): string {
  return str.toLowerCase().replace(/&/g, 'and').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')
}
const locCountryCounts: Record<string, number> = {}
const locContinentCounts: Record<string, number> = {}
records.filter((r: any) => r.sf4ad525dd).forEach((r: any) => {
  const country = extractCountry(r.sed1a49986 || '')
  if (!country || !COUNTRY_TO_CONTINENT[country]) return
  locCountryCounts[country] = (locCountryCounts[country] || 0) + 1
  const continent = COUNTRY_TO_CONTINENT[country]
  locContinentCounts[continent] = (locContinentCounts[continent] || 0) + 1
})
const locCountryLinks = Object.entries(locCountryCounts).sort((a, b) => b[1] - a[1])
const locContinentLinks = Object.entries(locContinentCounts).sort((a, b) => b[1] - a[1])

const seo: SEOProps = {
  title: 'The Nomad Directory - The Living Database of the Nomad Economy',
  description: 'The definitive intelligence hub tracking trends, opportunities, and innovations in the digital nomad ecosystem. Discover emerging tools and services while contributing to nomad economy intelligence.',
  image: 'https://nomad-magazine.com/images/Nomad-directory.webp',
  keywords: 'nomad directory, digital nomad economy, nomad business intelligence, remote work trends, nomad startup database, digital nomad market data, location independent business',
  ogType: 'website',
  ldJSON: {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'The Nomad Directory',
    description: 'The ultimate directory of tools, services, communities, and resources for digital nomads worldwide.',
    url: `${Astro.site}nomad_directory/`,
    publisher: { '@type': 'Organization', name: 'Nomad Magazine', logo: { '@type': 'ImageObject', url: `${Astro.site}logo.svg` } },
    about: { '@type': 'Thing', name: 'Digital Nomad Resources', description: 'Comprehensive directory of services and tools for digital nomads' },
  },
}
---

<Layout seo={seo}>
  <div class="bg-hoverw text-white min-h-screen">

    <!-- Hero -->
    <section class="pt-16 pb-10">
      <div class="container mx-auto px-4 text-center">
