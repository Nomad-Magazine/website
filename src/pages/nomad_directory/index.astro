---
export const prerender = true
import Layout, { type SEOProps } from '~/layouts/Layout.astro'
import DirectoryEntryCard from '~/components/DirectoryEntryCard.astro'
import { getDirectoryEntries, getDirectoryCategories, directoryCategoryUrl } from '~/utils/directory'
import '~/styles/directory.css'

const entries = await getDirectoryEntries()
const categories = getDirectoryCategories(entries)
const canonical = `${Astro.site}nomad_directory/`
const description = 'Explore digital nomad tools, coliving, coworking spaces and communities. Search the Nomad Directory for services, member offers and resources for remote work.'
const seo: SEOProps = {
  title: 'Digital Nomad Directory: Tools, Spaces & Communities',
  description,
  canonical,
  image: `${Astro.site}images/Nomad-directory.webp`,
  keywords: 'digital nomad directory, remote work tools, coliving, coworking spaces, nomad communities, eSIM, nomad services',
  ldJSON: {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Digital Nomad Directory',
    description,
    url: canonical,
    publisher: { '@type': 'Organization', name: 'Nomad Magazine', url: `${Astro.site}` },
    breadcrumb: {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${Astro.site}` },
        { '@type': 'ListItem', position: 2, name: 'Nomad Directory', item: canonical },
      ],
    },
    mainEntity: {
      '@type': 'ItemList',
      name: 'Published Nomad Directory listings',
      numberOfItems: entries.length,
      itemListElement: entries.map((entry, index) => ({ '@type': 'ListItem', position: index + 1, name: entry.title, url: `${canonical}#listing-${entry.id}` })),
    },
  },
}
---

<Layout seo={seo}>
  <div class="directory-theme">
    <section class="directory-wrap directory-hero">
      <nav aria-label="Breadcrumb" class="breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">Nomad Directory</span></nav>
      <div class="directory-intro">
        <div>
          <p class="directory-eyebrow">Your shortcut to nomad life</p><h1>The Nomad <span>Directory.</span></h1><p class="intro-description">
            Find your next space, your people, and the tools to make it all work. A directory for digital nomads, built around real life.
          </p>
        </div><div class="directory-actions">
          <a href="/nomad-directory-submit/" class="directory-button">Add your listing ↗</a><a href="/nomad-directory-edit/" class="directory-text-link">Manage your listing</a>
        </div>
      </div>
      <div class="directory-facts">
        <span><strong>{entries.length}</strong> published listings</span><span><strong>{categories.length}</strong> categories</span><span>By <strong>Nomad Magazine</strong></span>
      </div>
    </section>
    <section class="directory-wrap browse-section" aria-labelledby="browse-heading">
      <div class="browse-layout">
        <aside aria-label="Directory navigation">
          <div class="filter-panel" id="directory-controls" hidden>
            <label for="category-select" class="filter-heading">Browse by category</label>
            <select id="category-select" class="directory-field"
              ><option value="">All categories ({entries.length})</option>{
                categories.map(([category, count]) => (
                  <option value={category}>
                    {category} ({count})
                  </option>
                ))
              }</select
            >
            <div class="category-shortcuts" role="group" aria-label="Popular categories">
              <button type="button" data-category-filter="" aria-pressed="true">All categories <span>{entries.length}</span></button>
              {
                categories.slice(0, 8).map(([category, count]) => (
                  <button type="button" data-category-filter={category} aria-pressed="false">
                    {category}
                    <span>{count}</span>
                  </button>
                ))
              }
            </div>
          </div>
          <div class="owner-note">
            <p class="directory-eyebrow">Is your business here?</p><h2>Keep your listing fresh.</h2><p>Sign in with the email on your listing to submit changes for review.</p><a
              href="/nomad-directory-edit/"
              class="directory-text-link">Sign in / create account ↗</a
            >
          </div>
          <nav aria-label="More nomad resources" class="resource-links">
            <a href="/coliving_directory/">Explore coliving spaces ↗</a><a href="/where-to-work/">Find places to work ↗</a><a href="/digital-nomad-wiki/">Digital nomad guides ↗</a>
          </nav>
        </aside>
        <div>
          <h2 id="browse-heading" class="sr-only">Explore digital nomad businesses and services</h2>
          <form id="directory-search" role="search" aria-label="Search directory listings" hidden>
            <label for="search-input" class="sr-only">Search directory listings</label><input
              id="search-input"
              type="search"
              name="q"
              placeholder="Search names, tools, spaces or communities…"
              class="directory-field"
            /><button class="directory-button" type="submit">Search</button>
          </form>
          <noscript><p class="directory-muted">All listings are shown below. Use your browser’s find feature to search this directory.</p></noscript>
          <div class="results-toolbar">
            <p id="result-count" role="status" aria-live="polite" aria-atomic="true">{entries.length} listings to explore</p><div id="sort-controls" hidden>
              <label for="sort-select">Sort by</label><select id="sort-select" class="directory-field"
                ><option value="default">Directory order</option><option value="az">Name: A–Z</option><option value="za">Name: Z–A</option></select
              >
            </div>
          </div>
          <div id="listing-grid" class="directory-grid">{entries.map((entry) => <DirectoryEntryCard entry={entry} />)}</div>
          <div id="no-results" hidden class="empty-state"><h3>No listings found</h3><p>Try a broader search or choose another category.</p></div>
          <button id="clear-filters" type="button" class="directory-button secondary" hidden>Clear search and filters</button>
          <nav id="pagination" aria-label="Directory results pages" hidden>
            <button id="previous-page" type="button">← Previous</button><span id="page-number"></span><button id="next-page" type="button">Next →</button>
          </nav>
        </div>
      </div>
    </section>
    <section class="directory-section" aria-labelledby="category-guides-heading">
      <div class="directory-wrap">
        <p class="directory-eyebrow">Explore a little deeper</p>
        <h2 id="category-guides-heading">Find digital nomad resources by category.</h2>
        <nav aria-label="Directory category pages" class="category-pages">
          {categories.map(([category, count]) => <a href={directoryCategoryUrl(category)}>{category} <span>({count})</span></a>)}
        </nav>
      </div>
    </section>
    <section class="directory-section">
      <div class="directory-wrap about-directory">
        <div>
          <p class="directory-eyebrow">A place to start</p><h2>Resources for your version of nomad life.</h2><p>
            Compare coliving spaces and coworking communities, discover remote work apps, or find services for travel, connectivity and life abroad. Each listing includes a
            description and a link to the business so you can check the details directly.
          </p><p>
            Looking for a place to settle in? Explore our <a href="/coliving_directory/" class="directory-text-link">coliving directory</a> or <a
              href="/where-to-work/"
              class="directory-text-link">where to work guides</a
            >.
          </p>
        </div><div class="directory-faq">
          <h2>Directory questions</h2><details>
            <summary>How do I add my business?</summary><p>
              <a href="/nomad-directory-submit/" class="directory-text-link">Submit your listing</a> with your business details, website and logo. Submissions are reviewed before publication.
            </p>
          </details><details>
            <summary>Can I manage an existing listing?</summary><p>
              Yes. <a href="/nomad-directory-edit/" class="directory-text-link">Create an account or sign in</a> with the email attached to your listing. Submit changes to your description,
              website or offer. Approved changes appear after the next site sync.
            </p>
          </details><details>
            <summary>How do I use a member offer?</summary><p>
              Check the offer on the listing and visit the business’s website for current availability and terms. Offers are supplied by the listed businesses.
            </p>
          </details>
        </div>
      </div>
    </section>
  </div>
</Layout>
<script>
  const grid = document.querySelector<HTMLElement>('#listing-grid')!
  const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-entry]'))
  const search = document.querySelector<HTMLInputElement>('#search-input')!
  function getSelect(id: string): HTMLSelectElement {
    const element = document.getElementById(id)
    if (element instanceof HTMLSelectElement) return element
    throw new Error(`Missing directory select: ${id}`)
  }
  const category = getSelect('category-select')
  const sort = getSelect('sort-select')
  const count = document.querySelector<HTMLElement>('#result-count')!
  const clear = document.querySelector<HTMLButtonElement>('#clear-filters')!
  const pagination = document.querySelector<HTMLElement>('#pagination')!
  const previous = document.querySelector<HTMLButtonElement>('#previous-page')!
  const next = document.querySelector<HTMLButtonElement>('#next-page')!
  const shortcuts = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-category-filter]'))
  const pageSize = 24
  let page = 1
  const params = new URLSearchParams(location.search)
  search.value = params.get('q') || ''
  category.value = params.get('category') || ''
  if (category.selectedIndex < 0) category.value = ''

  function render(moveFocus = false) {
    const query = search.value.trim().toLowerCase()
    const matches = cards.filter((card) => (!category.value || card.dataset.category === category.value) && (!query || card.dataset.search!.includes(query)))
    if (sort.value !== 'default') matches.sort((a, b) => (a.dataset.title || '').localeCompare(b.dataset.title || '') * (sort.value === 'za' ? -1 : 1))
    const pages = Math.max(1, Math.ceil(matches.length / pageSize))
    page = Math.min(page, pages)
    cards.forEach((card) => {
      card.hidden = true
    })
    const visible = matches.slice((page - 1) * pageSize, page * pageSize)
    visible.forEach((card) => {
      card.hidden = false
      grid.appendChild(card)
    })
    count.textContent = matches.length ? `${matches.length} listings · showing ${(page - 1) * pageSize + 1}–${Math.min(page * pageSize, matches.length)}` : '0 listings'
    document.getElementById('no-results')!.hidden = matches.length > 0
    clear.hidden = !query && !category.value
    pagination.hidden = pages < 2
    previous.disabled = page === 1
    next.disabled = page === pages
    document.getElementById('page-number')!.textContent = `Page ${page} of ${pages}`
    shortcuts.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.categoryFilter === category.value)))
    if (moveFocus) {
      document.getElementById('browse-heading')!.focus()
      grid.scrollIntoView({ block: 'start' })
    }
  }
  function filter() {
    page = 1
    render()
  }
  document.getElementById('browse-heading')!.setAttribute('tabindex', '-1')
  document.getElementById('directory-controls')!.hidden = false
  document.getElementById('directory-search')!.hidden = false
  document.getElementById('sort-controls')!.hidden = false
  search.addEventListener('input', filter)
  category.addEventListener('change', filter)
  sort.addEventListener('change', filter)
  document.getElementById('directory-search')!.addEventListener('submit', (event) => {
    event.preventDefault()
    filter()
  })
  shortcuts.forEach((button) =>
    button.addEventListener('click', () => {
      category.value = button.dataset.categoryFilter || ''
      filter()
    }),
  )
  clear.addEventListener('click', () => {
    search.value = ''
    category.value = ''
    filter()
    search.focus()
  })
  previous.addEventListener('click', () => {
    page--
    render(true)
  })
  next.addEventListener('click', () => {
    page++
    render(true)
  })
  function revealLinkedListing() {
    const index = cards.findIndex((card) => `#${card.id}` === location.hash)
    if (index < 0) return
    search.value = ''
    category.value = ''
    sort.value = 'default'
    page = Math.floor(index / pageSize) + 1
    render()
    document.getElementById(cards[index].id)?.scrollIntoView({ block: 'start' })
  }
  render()
  revealLinkedListing()
  window.addEventListener('hashchange', revealLinkedListing)
</script>
<style>
  .category-pages { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .category-pages a { padding: 10px 14px; border: 1px solid #535d4a; border-radius: 8px; }
  .category-pages a:hover { border-color: #facc15; color: #facc15; }
  .category-pages span { color: #bdc6b7; }
  .directory-hero {
    padding-top: 28px;
    padding-bottom: 36px;
  }
  .breadcrumb {
    display: flex;
    gap: 12px;
    color: #aeb2ac;
    font-size: 13px;
    margin-bottom: 32px;
  }
  .directory-intro {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 40px;
  }
  h1 {
    font-size: clamp(38px, 4.5vw, 62px);
    font-weight: 650;
    letter-spacing: -0.045em;
    line-height: 1.12;
    margin: 14px 0 18px;
  }
  h1 span {
    color: #facc15;
  }
  .intro-description {
    max-width: 640px;
    color: #b9beb5;
    font-size: 18px;
  }
  .directory-intro .directory-actions {
    flex-direction: column;
    flex-shrink: 0;
    align-items: stretch;
    text-align: center;
  }
  .directory-facts {
    display: flex;
    gap: 28px;
    margin-top: 28px;
    color: #aeb2ac;
    font-size: 13px;
  }
  .directory-facts strong {
    color: #f5f7f1;
  }
  .browse-section {
    padding-bottom: 64px;
  }
  .browse-layout {
    border-top: 1px solid #353c30;
    padding-top: 32px;
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    gap: 32px;
  }
  .filter-heading {
    display: block;
    font-size: 14px;
    font-weight: 700;
    margin-bottom: 16px;
  }
  .directory-field {
    background: #22271f;
    border: 1px solid #535d4a;
    border-radius: 8px;
    padding: 12px;
    color: #f8faf5;
    min-width: 0;
    font-size: 16px;
  }
  input::placeholder {
    color: #b3bcac;
  }
  #category-select {
    width: 100%;
    font-size: 14px;
  }
  .category-shortcuts {
    margin-top: 12px;
  }
  .category-shortcuts button {
    display: flex;
    width: 100%;
    justify-content: space-between;
    text-align: left;
    padding: 11px 12px;
    color: #c4cabb;
    border-radius: 6px;
    font-size: 14px;
    cursor: pointer;
  }
  .category-shortcuts button[aria-pressed='true'] {
    background: #facc15;
    color: #131513;
    font-weight: 650;
  }
  .owner-note {
    padding: 22px;
    margin-top: 24px;
    background: #242c1e;
    border: 1px solid #46513a;
    border-radius: 10px;
  }
  .owner-note h2 {
    font-size: 21px;
    margin: 12px 0;
    font-weight: 600;
    line-height: 1.25;
  }
  .owner-note p:not(.directory-eyebrow) {
    color: #bbc5b2;
    font-size: 14px;
    margin-bottom: 16px;
  }
  .owner-note a {
    font-size: 14px;
  }
  .resource-links {
    display: grid;
    gap: 16px;
    font-size: 14px;
    color: #c4cabb;
    margin-top: 24px;
  }
  #directory-search:not([hidden]) {
    display: flex;
    gap: 12px;
  }
  #search-input {
    flex: 1;
  }
  .results-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin: 20px 0;
    color: #b9c2b1;
    font-size: 13px;
  }
  #sort-controls:not([hidden]) {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  #sort-select {
    font-size: 13px;
    padding: 8px;
  }
  .browse-layout .directory-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
  }
  #pagination:not([hidden]) {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 24px;
    margin-top: 32px;
  }
  #pagination button {
    padding: 12px;
    border: 1px solid #535d4a;
    border-radius: 8px;
    cursor: pointer;
  }
  #pagination button:disabled {
    opacity: 0.45;
    cursor: default;
  }
  #clear-filters {
    margin-top: 24px;
  }
  #clear-filters[hidden] {
    display: none;
  }
  .empty-state {
    padding: 48px 0;
  }
  .empty-state h3 {
    font-size: 24px;
    font-weight: 600;
  }
  .about-directory {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
  }
  .about-directory p {
    margin: 20px 0;
    color: #bdc6b7;
  }
  .directory-faq h2 {
    font-size: 26px;
    margin-bottom: 24px;
  }
  details {
    padding: 18px 0;
    border-bottom: 1px solid #414a3a;
  }
  summary {
    cursor: pointer;
    font-weight: 600;
  }
  @media (max-width: 800px) {
    .directory-intro {
      align-items: start;
      flex-direction: column;
      gap: 24px;
    }
    .directory-intro .directory-actions {
      flex-direction: row;
      align-items: center;
      flex-wrap: wrap;
    }
    .browse-layout {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .category-shortcuts,
    .owner-note,
    .resource-links {
      display: none;
    }
    .directory-facts {
      flex-wrap: wrap;
      gap: 12px 24px;
    }
    .about-directory {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
  @media (max-width: 550px) {
    .browse-layout .directory-grid {
      grid-template-columns: 1fr;
    }
    .results-toolbar {
      flex-wrap: wrap;
    }
    #directory-search .directory-button {
      padding: 12px;
    }
  }
</style>
