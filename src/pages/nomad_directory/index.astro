            <!-- Load more -->
            <div id="load-more-container" class="hidden text-center mt-8">
              <button id="load-more-btn"
                class="px-10 py-3 bg-white/10 hover:bg-white/20 border border-white/20 rounded-xl text-white font-medium transition-all duration-200">
                Load More
              </button>
            </div>

            <!-- Bottom CTA -->
            <div class="mt-16 bg-yellow-400/10 border border-yellow-400/20 rounded-2xl p-10 text-center">
              <h2 class="text-2xl font-bold text-white mb-4">Building for nomads?</h2>
              <p class="text-gray-300 mb-6 max-w-xl mx-auto">
                Join our living database and become part of the definitive intelligence source on the nomad economy.
              </p>
              <a target="_blank" rel="noopener noreferrer"
                href="https://form.smartsuite.com/s4tmc086/8sFlvrVlDC?redirect=https%3A//nomad-magazine.com/nomad-directory-boost-options"
                class="inline-flex items-center gap-2 bg-black hover:bg-gray-900 border-2 border-yellow-400 px-8 py-3 rounded-lg text-yellow-400 font-bold text-lg transition-all duration-200">
                <MaterialSymbolsElectricBolt width="20" height="20" />
                Join the Database
              </a>
            </div>
          </main>

        </div>
      </div>
    </section>
  </div>

  <div id="directory-data" hidden data-items={JSON.stringify(activeRecords)}></div>
</Layout>

<style>
  @keyframes slideIn {
    from { transform: translateX(400px); opacity: 0; }
    to { transform: translateX(0); opacity: 1; }
  }
  @keyframes slideOut {
    from { transform: translateX(0); opacity: 1; }
    to { transform: translateX(400px); opacity: 0; }
