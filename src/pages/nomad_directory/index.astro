            </div>
          </aside>

          <!-- RIGHT: Listings -->
          <main class="flex-1 min-w-0" id="main-content">

            <!-- Active filters bar -->
            <div id="active-filters" class="hidden flex-wrap gap-2 mb-4 items-center">
              <span class="text-xs text-gray-500">Filters:</span>
