---
export const prerender = true;

import { fetchReportRecords } from '~/utils/smartsuite'
import Layout, { type SEOProps } from '~/layouts/Layout.astro'
import MaterialSymbolsElectricBolt from '~icons/material-symbols/electric-bolt'

const COUNTRY_TO_CONTINENT: Record<string, string> = {
  Portugal: 'Europe', Spain: 'Europe', Italy: 'Europe', France: 'Europe',
  Germany: 'Europe', 'United Kingdom': 'Europe', Netherlands: 'Europe',
  Greece: 'Europe', Bulgaria: 'Europe', Hungary: 'Europe', Ireland: 'Europe',
  Slovenia: 'Europe', Croatia: 'Europe', Slovakia: 'Europe', Austria: 'Europe',
  Poland: 'Europe', Malta: 'Europe', Belgium: 'Europe', Switzerland: 'Europe',
  Japan: 'Asia', Thailand: 'Asia', Vietnam: 'Asia', Indonesia: 'Asia',
  India: 'Asia', Philippines: 'Asia', 'South Korea': 'Asia', Taiwan: 'Asia',
  Argentina: 'South America', Colombia: 'South America', Brazil: 'South America',
  'Costa Rica': 'Central America', Mexico: 'North America',
  USA: 'North America', Canada: 'North America',
  Morocco: 'Africa', 'South Africa': 'Africa',
}

const COUNTRY_ALIASES: Record<string, string> = {
  NL: 'Netherlands', 'The Netherlands': 'Netherlands',
  Slovenija: 'Slovenia', UK: 'United Kingdom', Bali: 'Indonesia',
}

function slugify(str: string): string {
  return str.toLowerCase().replace(/&/g, 'and').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')
}

function normalizeCountry(raw: string): string { return COUNTRY_ALIASES[raw] || raw }

function extractCountry(location: string): string {
  if (!location) return ''
  const parts = location.split(',')
  if (parts.length >= 2) return normalizeCountry(parts[parts.length - 1].trim())
  const words = location.trim().split(/\s+/)
  const last = normalizeCountry(words[words.length - 1])
  if (COUNTRY_TO_CONTINENT[last]) return last
  const whole = normalizeCountry(location.trim())
  if (COUNTRY_TO_CONTINENT[whole]) return whole
  return ''
}

export async function getStaticPaths() {
  const COUNTRY_TO_CONTINENT: Record<string, string> = {
    Portugal: 'Europe', Spain: 'Europe', Italy: 'Europe', France: 'Europe',
    Germany: 'Europe', 'United Kingdom': 'Europe', Netherlands: 'Europe',
    Greece: 'Europe', Bulgaria: 'Europe', Hungary: 'Europe', Ireland: 'Europe',
    Slovenia: 'Europe', Croatia: 'Europe', Slovakia: 'Europe', Austria: 'Europe',
    Poland: 'Europe', Malta: 'Europe', Belgium: 'Europe', Switzerland: 'Europe',
    Japan: 'Asia', Thailand: 'Asia', Vietnam: 'Asia', Indonesia: 'Asia',
    India: 'Asia', Philippines: 'Asia', 'South Korea': 'Asia', Taiwan: 'Asia',
    Argentina: 'South America', Colombia: 'South America', Brazil: 'South America',
    'Costa Rica': 'Central America', Mexico: 'North America',
    USA: 'North America', Canada: 'North America',
    Morocco: 'Africa', 'South Africa': 'Africa',
  }
  const COUNTRY_ALIASES: Record<string, string> = {
    NL: 'Netherlands', 'The Netherlands': 'Netherlands',
    Slovenija: 'Slovenia', UK: 'United Kingdom', Bali: 'Indonesia',
  }
  function normalizeCountry(raw: string): string { return COUNTRY_ALIASES[raw] || raw }
  function extractCountry(location: string): string {
    if (!location) return ''
    const parts = location.split(',')
    if (parts.length >= 2) return normalizeCountry(parts[parts.length - 1].trim())
    const words = location.trim().split(/\s+/)
    const last = normalizeCountry(words[words.length - 1])
    if (COUNTRY_TO_CONTINENT[last]) return last
    const whole = normalizeCountry(location.trim())
    if (COUNTRY_TO_CONTINENT[whole]) return whole
    return ''
  }
  function slugify(str: string): string {
    return str.toLowerCase().replace(/&/g, 'and').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')
  }

  const { records = [] } = await fetchReportRecords('6857167d82358a0f5e038c3f')
  const active = records.filter((r: any) => r.sf4ad525dd && r.sb685ab800?.label)

  // Build category counts
  const categoryCounts: Record<string, number> = {}
  active.forEach((r: any) => {
    const cat = r.sb685ab800.label as string
    categoryCounts[cat] = (categoryCounts[cat] || 0) + 1
  })
  const navCategories = Object.entries(categoryCounts).sort((a, b) => b[1] - a[1])

  // Build location counts from active records that have a valid country
  const countryCounts: Record<string, number> = {}
  const continentCounts: Record<string, number> = {}
  for (const r of active) {
    const country = extractCountry(r.sed1a49986 || '')
    if (!country) continue
    const continent = COUNTRY_TO_CONTINENT[country]
    if (!continent) continue
    countryCounts[country] = (countryCounts[country] || 0) + 1
    continentCounts[continent] = (continentCounts[continent] || 0) + 1
  }
  const paths: any[] = []

  // Category pages
  Object.keys(categoryCounts).forEach(cat => {
    paths.push({
      params: { slug: slugify(cat) },
      props: { type: 'category', filterValue: cat, records, navCategories },
    })
  })

  // Country pages
  Object.keys(countryCounts).forEach(country => {
    paths.push({
      params: { slug: slugify(country) },
      props: { type: 'country', filterValue: country, records, navCategories },
    })
  })

  // Continent pages
  Object.keys(continentCounts).forEach(continent => {
    paths.push({
      params: { slug: slugify(continent) },
      props: { type: 'continent', filterValue: continent, records, navCategories },
    })
  })

  return paths
}

const { type, filterValue, records, navCategories } = Astro.props

const darkLogoCompanies = [
  'Fresh Global',
  'Falmouth University',
  'SUMA',
  'Scaglia y Asociados',
  'goldenweeks',
  'Anytime Mailbox',
  'WESPA Spaces',
]

const allActive = records.filter((r: any) => r.sf4ad525dd)

const totalAll = allActive.length

// Filter records for this page
const pageRecords = allActive.filter((r: any) => {
  if (type === 'category') return r.sb685ab800?.label === filterValue
  const country = extractCountry(r.sed1a49986 || '')
  if (type === 'country') return country === filterValue
  if (type === 'continent') return COUNTRY_TO_CONTINENT[country] === filterValue
  return false
})
const count = pageRecords.length
const isLocation = type === 'country' || type === 'continent'

// SEO copy
const categoryDescriptions: Record<string, string> = {
  'Events': `digital nomad events, festivals, workations and conferences`,
  'Coliving': `coliving spaces and community-driven accommodation`,
  'Platform': `platforms and tools built for the nomad economy`,
  'App': `apps designed for digital nomads and remote workers`,
  'Legal & Taxes': `legal and tax services for location-independent professionals`,
  'Services': `professional services tailored for digital nomads`,
  'Community Platform': `online community platforms for digital nomads`,
  'Insurance': `health and travel insurance for digital nomads`,
  'Community': `nomad communities and groups worldwide`,
  'Blog': `blogs and publications about the digital nomad lifestyle`,
  'Coworking': `coworking spaces trusted by digital nomads`,
  'TravelTech': `travel tech tools for location-independent workers`,
  'eSim': `eSIM providers for international data and connectivity`,
  'Software': `software tools built for remote work and nomad life`,
  'Retreats': `retreats and workation programs for digital nomads`,
  'Accommodation': `accommodation options for digital nomads and remote workers`,
  'Education': `education and learning resources for nomads`,
  'Coaching': `coaching and mentoring for location-independent entrepreneurs`,
  'Job Platform': `job platforms and remote work opportunities`,
  'Independent Magazine Club': `independent magazines and media for the nomad community`,
  'Investment': `investment and finance resources for nomads`,
  'Conference': `conferences and summits for digital nomads`,
  'Other': `nomad economy resources and tools`,
  'Game': `games and interactive tools for the nomad community`,
  'Creative': `creative services and studios in the nomad ecosystem`,
  'Health': `health and wellness services for digital nomads`,
  'Country Travel Department': `country travel departments and destination resources`,
}

let h1: string, h2: string, metaTitle: string, metaDescription: string, breadcrumbLabel: string

if (type === 'category') {
  const catDesc = categoryDescriptions[filterValue] || `${filterValue.toLowerCase()} resources for digital nomads`
  h1 = `${filterValue} for Digital Nomads`
  h2 = `${count} ${catDesc} in the Nomad Directory`
  metaTitle = `${filterValue} Directory - ${count} Resources for Digital Nomads | Nomad Magazine`
  metaDescription = `Browse ${count} ${catDesc}. Part of the Nomad Directory — the living database of the digital nomad economy, built by Nomad Magazine.`
  breadcrumbLabel = filterValue
} else {
  const qualifier = type === 'continent' ? 'across' : 'in'
  h1 = `Digital Nomad Resources in ${filterValue}`
  h2 = `${count} resource${count !== 1 ? 's' : ''} ${qualifier} ${filterValue} in the Nomad Directory`
  metaTitle = `Digital Nomad Resources in ${filterValue} – ${count} Listing${count !== 1 ? 's' : ''} | Nomad Magazine`
  metaDescription = `Discover ${count} digital nomad resource${count !== 1 ? 's' : ''} ${qualifier} ${filterValue} — colivings, events, services and more. Part of the Nomad Directory by Nomad Magazine.`
  breadcrumbLabel = filterValue
}

const pageSlug = slugify(filterValue)
const canonicalUrl = `${Astro.site}nomad_directory/${pageSlug}/`

const seo: SEOProps = {
  title: metaTitle,
  description: metaDescription,
  image: 'https://nomad-magazine.com/images/Nomad-directory.webp',
  keywords: isLocation
    ? `digital nomad ${filterValue.toLowerCase()}, nomad directory ${filterValue.toLowerCase()}, remote work ${filterValue.toLowerCase()}`
    : `nomad ${filterValue.toLowerCase()}, digital nomad ${filterValue.toLowerCase()}, remote work ${filterValue.toLowerCase()}, nomad directory ${filterValue.toLowerCase()}`,
  ogType: 'website',
  ldJSON: {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: h1,
    description: metaDescription,
    url: canonicalUrl,
    publisher: {
      '@type': 'Organization',
      name: 'Nomad Magazine',
      logo: { '@type': 'ImageObject', url: `${Astro.site}logo.svg` },
    },
    breadcrumb: {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${Astro.site}` },
        { '@type': 'ListItem', position: 2, name: 'Nomad Directory', item: `${Astro.site}nomad_directory/` },
        { '@type': 'ListItem', position: 3, name: breadcrumbLabel, item: canonicalUrl },
      ],
    },
  },
}
---

<Layout seo={seo}>
  <div class="bg-hoverw text-white min-h-screen">

    <!-- Hero -->
    <section class="pt-16 pb-10">
      <div class="container mx-auto px-4 text-center">
        <nav aria-label="Breadcrumb" class="flex items-center justify-center gap-2 text-sm text-gray-500 mb-6">
          <a href="/" class="hover:text-gray-300 transition-colors">Home</a>
          <span>/</span>
          <a href="/nomad_directory/" class="hover:text-gray-300 transition-colors">Nomad Directory</a>
          <span>/</span>
          <span class="text-gray-300">{breadcrumbLabel}</span>
        </nav>

        <h1 class="mx-auto max-w-4xl text-4xl leading-tight font-bold md:text-6xl mb-3">
          {isLocation ? (
            <>Digital Nomad Resources in <span class="text-yellow-400">{filterValue}</span></>
          ) : (
            <><span class="text-yellow-400">{filterValue}</span> for Digital Nomads</>
          )}
        </h1>
        <h2 class="mx-auto max-w-4xl text-xl font-bold md:text-2xl mb-3 text-gray-300">{h2}</h2>
        <p class="mx-auto max-w-3xl text-sm text-gray-400 mb-6">
          Part of the <a href="/nomad_directory/" class="text-yellow-400 hover:text-yellow-300 underline transition-colors">Nomad Directory</a> — the living database of the digital nomad economy, built by Nomad Magazine.
        </p>
        <div class="flex justify-center mb-4">
          <a target="_blank" rel="noopener noreferrer"
            href="https://form.smartsuite.com/s4tmc086/8sFlvrVlDC?redirect=https%3A//nomad-magazine.com/nomad-directory-boost-options"
            class="inline-flex items-center gap-2 bg-black hover:bg-gray-900 border-2 border-yellow-400 px-6 py-2.5 rounded-lg text-yellow-400 font-bold transition-all duration-200">
            <MaterialSymbolsElectricBolt width="18" height="18" />
            {isLocation ? `Add Your Listing in ${filterValue}` : `Add Your ${filterValue}`}
          </a>
        </div>
      </div>
    </section>

    <!-- Main layout -->
    <section class="pb-20">
      <div class="container mx-auto px-4 max-w-7xl">
        <div class="flex flex-col lg:flex-row gap-8 items-start">

          <!-- LEFT SIDEBAR -->
          <aside class="w-full lg:w-72 shrink-0 lg:sticky lg:top-6 lg:max-h-[calc(100vh-3rem)] lg:overflow-y-auto" style="scrollbar-width:thin;scrollbar-color:rgba(255,255,255,0.15) transparent;" aria-label="Directory filters">
            <div class="bg-white/5 border border-white/10 rounded-2xl p-5 space-y-6">

              <a href="/nomad_directory/"
                class="flex items-center gap-2 text-sm text-gray-400 hover:text-yellow-400 transition-colors group">
                <svg class="w-4 h-4 group-hover:-translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                </svg>
                View all {totalAll} listings
              </a>

              <!-- Search -->
              <div>
                <label for="search-input" class="block text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2">
                  Search in {filterValue}
                </label>
                <div class="relative">
                  <input type="text" id="search-input"
                    placeholder="Name, description..."
                    aria-label={`Search within ${filterValue}`}
                    class="w-full px-4 py-2.5 pl-10 bg-white/10 border border-white/20 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-yellow-400 transition-all text-sm" />
                  <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                  </svg>
                </div>
                <p class="text-xs text-gray-600 mt-1" id="search-count">{count} results</p>
              </div>

              <!-- Categories -->
              <div>
                <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3">Browse Categories</p>
                <div class="space-y-1 max-h-64 overflow-y-auto pr-1" style="scrollbar-width:thin;scrollbar-color:rgba(255,255,255,0.2) transparent;">
                  <a href="/nomad_directory/"
                    class="w-full flex items-center justify-between px-3 py-2 rounded-lg text-sm text-gray-400 hover:text-white hover:bg-white/10 transition-all">
                    <span>All Categories</span>
                    <span class="text-xs text-gray-600">{totalAll}</span>
                  </a>
                  {(navCategories as [string, number][]).map(([cat, cnt]) => (
                    <a href={`/nomad_directory/${slugify(cat)}/`}
                      class={`w-full flex items-center justify-between px-3 py-2 rounded-lg text-sm transition-all ${cat === filterValue ? 'bg-yellow-400 text-black font-semibold' : 'text-gray-300 hover:text-white hover:bg-white/10'}`}
                      aria-current={cat === filterValue ? 'page' : undefined}>
                      <span>{cat}</span>
                      <span class={`text-xs ${cat === filterValue ? 'opacity-70' : 'text-gray-500'}`}>{cnt}</span>
                    </a>
                  ))}
                </div>
              </div>

              <!-- Share -->
              <div class="pt-2 border-t border-white/10">
                <p class="text-xs text-gray-500 mb-2">Share this directory</p>
                <div class="flex gap-2">
                  <button onclick="shareOnTwitter()" aria-label="Share on Twitter" class="p-2 bg-white/10 hover:bg-blue-400/20 rounded-lg transition-all group">
                    <svg class="w-4 h-4 text-gray-400 group-hover:text-blue-400" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/></svg>
                  </button>
                  <button onclick="shareOnLinkedIn()" aria-label="Share on LinkedIn" class="p-2 bg-white/10 hover:bg-blue-600/20 rounded-lg transition-all group">
                    <svg class="w-4 h-4 text-gray-400 group-hover:text-blue-600" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                  </button>
                  <button onclick="copyDirectoryUrl(this)" aria-label="Copy URL" class="p-2 bg-white/10 hover:bg-green-500/20 rounded-lg transition-all group">
                    <svg class="w-4 h-4 text-gray-400 group-hover:text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                  </button>
                </div>
              </div>

              <!-- Explore More -->
              <div class="pt-2 border-t border-white/10">
                <p class="text-xs text-gray-500 uppercase tracking-wider mb-2">Explore more</p>
                <div class="space-y-1">
                  <a href="/articles/" class="flex items-center gap-2 px-2 py-1.5 text-sm text-gray-400 hover:text-yellow-400 transition-colors rounded-lg hover:bg-white/5">
                    <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                    Articles
                  </a>
                  <a href="/digital-nomad-wiki/" class="flex items-center gap-2 px-2 py-1.5 text-sm text-gray-400 hover:text-yellow-400 transition-colors rounded-lg hover:bg-white/5">
                    <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
                    Nomad Wiki
                  </a>
                  <a href="/editions/" class="flex items-center gap-2 px-2 py-1.5 text-sm text-gray-400 hover:text-yellow-400 transition-colors rounded-lg hover:bg-white/5">
                    <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/></svg>
                    Magazine
                  </a>
                  <a href="/newsletter/" class="flex items-center gap-2 px-2 py-1.5 text-sm text-gray-400 hover:text-yellow-400 transition-colors rounded-lg hover:bg-white/5">
                    <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                    Newsletter
                  </a>
                </div>
              </div>

              <!-- Country Filter -->
              <div id="country-filter-section">
                <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3">Filter by Country</p>
                <div id="country-list" class="space-y-1 max-h-64 overflow-y-auto pr-1" style="scrollbar-width:thin;scrollbar-color:rgba(255,255,255,0.2) transparent;">
                  <!-- populated by JS -->
                </div>
              </div>

            </div>
          </aside>

          <!-- RIGHT: Listings -->
          <main class="flex-1 min-w-0" id="main-content">

            <div id="directory-container" class="space-y-4">
              {pageRecords.map((record: any) => {
                const link = record.link || record.sb788c266b?.[0]
                const isDark = darkLogoCompanies.includes(record.title)
                const catLabel = record.sb685ab800?.label || ''
                const locText = (() => {
                  const loc = record.sed1a49986 || ''
                  const parts = loc.split(',')
                  return parts.length >= 2 ? loc : ''
                })()
                return (
                  <div
                    class="directory-card bg-white/5 border border-white/10 rounded-2xl p-5 hover:bg-white/10 transition-all duration-300 group"
                    style={link ? 'cursor:pointer' : ''}
                    data-link={link || undefined}
                    data-title={(record.title || '').toLowerCase()}
                    data-desc={(record.scea90e502 || '').toLowerCase()}
                    data-country={extractCountry(record.sed1a49986 || '')}
                  >
                    <div class="flex items-start gap-4">
                      <div class="shrink-0">
                        <div class={`w-16 h-16 rounded-xl flex items-center justify-center p-1 ${isDark ? 'bg-gray-800' : 'bg-white'}`}>
                          {record.image && record.image !== '/logo.svg' ? (
                            <img src={record.image} alt={record.title} class="w-full h-full rounded-xl object-contain" loading="lazy" />
                          ) : (
                            <span class={`font-bold text-2xl ${isDark ? 'text-white' : 'text-black'}`}>
                              {(record.title || 'C').charAt(0).toUpperCase()}
                            </span>
                          )}
                        </div>
                      </div>
                      <div class="flex-1 min-w-0">
                        <div class="flex flex-wrap items-start justify-between gap-2 mb-1.5">
                          <div class="flex items-center gap-2 flex-wrap">
                            <h3 class="text-base font-bold text-white group-hover:text-yellow-400 transition-colors leading-tight">{record.title}</h3>
                          </div>
                          <div class="flex items-center gap-1.5 shrink-0">
                            {catLabel && (
                              <span class="bg-yellow-400/20 text-yellow-400 px-2.5 py-0.5 rounded-full text-xs font-medium border border-yellow-400/30">{catLabel}</span>
                            )}
                            {locText && (
                              <span class="bg-blue-600/20 text-blue-400 px-2.5 py-0.5 rounded-full text-xs font-medium border border-blue-600/30">{locText.split(',').slice(-1)[0].trim()}</span>
                            )}
                          </div>
                        </div>
                        <p class="text-gray-300 text-sm leading-relaxed line-clamp-2">{record.scea90e502 || 'Description not available'}</p>
                        {record.s5576966ee && (
                          <div class="mt-3 p-3 bg-yellow-400/10 border-l-4 border-yellow-400 rounded-r-lg">
                            <p class="text-yellow-400 font-bold text-xs uppercase mb-1">Special Offer:</p>
                            <p class="text-gray-200 text-sm whitespace-pre-line">{record.s5576966ee}</p>
                          </div>
                        )}
                        {link && (
                          <div class="mt-3">
                            <a href={link} target="_blank" rel="noopener noreferrer"
                              class="text-blue-300 hover:text-blue-200 underline text-sm transition-colors">
                              Learn more &rarr;
                            </a>
                          </div>
                        )}
                      </div>
                    </div>
                  </div>
                )
              })}
            </div>

            <div id="empty-state" class="hidden text-center py-16">
              <p class="text-gray-400">No results found. <button onclick="clearSearch()" class="text-yellow-400 underline">Clear search</button></p>
            </div>

            <!-- CTA -->
            <div class="mt-16 bg-yellow-400/10 border border-yellow-400/20 rounded-2xl p-10 text-center">
              <h2 class="text-2xl font-bold text-white mb-3">
                {isLocation ? `List Your Resource in ${filterValue}` : `List Your ${filterValue}`}
              </h2>
              <p class="text-gray-300 mb-6 max-w-xl mx-auto">
                Join the Nomad Directory and reach thousands of digital nomads looking for exactly what you offer.
              </p>
              <a target="_blank" rel="noopener noreferrer"
                href="https://form.smartsuite.com/s4tmc086/8sFlvrVlDC?redirect=https%3A//nomad-magazine.com/nomad-directory-boost-options"
                class="inline-flex items-center gap-2 bg-black hover:bg-gray-900 border-2 border-yellow-400 px-8 py-3 rounded-lg text-yellow-400 font-bold text-lg transition-all duration-200">
                <MaterialSymbolsElectricBolt width="20" height="20" />
                Join the Database
              </a>
            </div>
          </main>

        </div>
      </div>
    </section>
  </div>
</Layout>

<script is:inline>
  window.shareOnTwitter = function() {
    window.open('https://twitter.com/intent/tweet?url=' + encodeURIComponent(location.href) + '&text=' + encodeURIComponent(document.title), '_blank');
  };
  window.shareOnLinkedIn = function() {
    window.open('https://www.linkedin.com/sharing/share-offsite/?url=' + encodeURIComponent(location.href), '_blank');
  };
  window.copyDirectoryUrl = function(btn) {
    navigator.clipboard.writeText(location.href).then(() => {
      const svg = btn.querySelector('svg');
      if (svg) { svg.style.color = '#22c55e'; setTimeout(() => { svg.style.color = ''; }, 1500); }
    });
  };

  const cards = Array.from(document.querySelectorAll('.directory-card'));
  const countEl = document.getElementById('search-count');
  const emptyEl = document.getElementById('empty-state');

  cards.forEach((card) => {
    const cardLink = card.getAttribute('data-link');
    const detailLink = card.querySelector('a[href]');

    if (cardLink) {
      card.addEventListener('click', () => {
        window.open(cardLink, '_blank');
      });
    }

    if (detailLink) {
      detailLink.addEventListener('click', (event) => {
        event.stopPropagation();
      });
    }
  });
  let activeCountry = '';

  window.clearSearch = function() {
    const si = document.getElementById('search-input');
    if (si) { si.value = ''; applyFilters('', activeCountry); }
  };

  function applyFilters(query, country) {
    let visible = 0;
    cards.forEach(card => {
      const title = card.getAttribute('data-title') || '';
      const desc = card.getAttribute('data-desc') || '';
      const cardCountry = card.getAttribute('data-country') || '';
      const matchQuery = !query || title.includes(query) || desc.includes(query);
      const matchCountry = !country || cardCountry === country;
      const match = matchQuery && matchCountry;
      card.style.display = match ? '' : 'none';
      if (match) visible++;
    });
    if (countEl) countEl.textContent = visible + ' result' + (visible !== 1 ? 's' : '');
    if (emptyEl) emptyEl.classList.toggle('hidden', visible > 0);
  }

  // Build country filter list from cards
  (function buildCountryFilter() {
    const countryCounts = {};
    cards.forEach(card => {
      const c = card.getAttribute('data-country');
      if (c) countryCounts[c] = (countryCounts[c] || 0) + 1;
    });
    const sorted = Object.entries(countryCounts).sort((a, b) => b[1] - a[1]);
    const list = document.getElementById('country-list');
    const section = document.getElementById('country-filter-section');
    if (!list || sorted.length === 0) { if (section) section.style.display = 'none'; return; }

    function renderList() {
      list.innerHTML = '';
      // All countries button
      const allBtn = document.createElement('button');
      allBtn.className = 'w-full flex items-center justify-between px-3 py-2 rounded-lg text-sm transition-all ' +
        (!activeCountry ? 'bg-blue-500 text-white font-semibold' : 'text-gray-300 hover:text-white hover:bg-white/10');
      allBtn.innerHTML = '<span>All Countries</span><span class="text-xs opacity-60">' + cards.length + '</span>';
      allBtn.addEventListener('click', () => { activeCountry = ''; renderList(); applyFilters(currentQuery(), ''); });
      list.appendChild(allBtn);

      sorted.forEach(([country, cnt]) => {
        const btn = document.createElement('button');
        btn.className = 'w-full flex items-center justify-between px-3 py-2 rounded-lg text-sm transition-all ' +
          (activeCountry === country ? 'bg-blue-500 text-white font-semibold' : 'text-gray-300 hover:text-white hover:bg-white/10');
        btn.innerHTML = '<span>' + country + '</span><span class="text-xs opacity-60">' + cnt + '</span>';
        btn.addEventListener('click', () => { activeCountry = country; renderList(); applyFilters(currentQuery(), country); });
        list.appendChild(btn);
      });
    }
    renderList();
  })();

  function currentQuery() {
    const si = document.getElementById('search-input');
    return si ? si.value.toLowerCase().trim() : '';
  }

  const si = document.getElementById('search-input');
  if (si) si.addEventListener('input', e => applyFilters(e.target.value.toLowerCase().trim(), activeCountry));
</script>
