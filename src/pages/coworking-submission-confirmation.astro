---
import Layout, { type SEOProps } from '~/layouts/Layout.astro'

const seo: SEOProps = {
  title: 'Submission Confirmed - Best Coworking Spaces Contest',
  description: 'Thank you for submitting your coworking space to our design contest! Your entry will be reviewed and added to the voting soon.',
  image: `${Astro.site}images/coworking-spaces-hero.webp`,
  keywords: 'coworking spaces contest, submission confirmed, nomad magazine, workspace design',
}
---

<Layout seo={seo}>
  <div class="bg-hoverw text-white min-h-screen">
    <!-- Hero Section -->
    <section class="px-4 py-16 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-4xl">
        <div class="text-center">
          <!-- Success Icon -->
          <div class="mx-auto w-24 h-24 mb-8 flex items-center justify-center rounded-full bg-green-500/20">
            <svg class="w-12 h-12 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>
          </div>

          <h1 class="text-4xl font-bold sm:text-6xl lg:text-7xl mb-6">
            <span class="text-green-400">Submission</span> Confirmed!
          </h1>
          
          <p class="text-xl text-neutral-300 mb-8 max-w-3xl mx-auto">
            Thank you for submitting your coworking space to our Best Coworking Spaces Design Contest! Your entry has been received and will be reviewed by our team.
          </p>

          <!-- What Happens Next Section -->
          <div class="bg-neutral-900/50 rounded-2xl p-8 mb-8 text-left max-w-2xl mx-auto">
            <h2 class="text-2xl font-bold text-yellow-400 mb-6 text-center">What Happens Next?</h2>
            
            <div class="space-y-4">
              <div class="flex items-start gap-4">
                <div class="flex-shrink-0 w-8 h-8 rounded-full bg-yellow-400 text-black font-bold flex items-center justify-center text-sm">1</div>
                <div>
                  <h3 class="font-semibold text-white mb-1">Review Process</h3>
                  <p class="text-neutral-300 text-sm">Our team will review your submission to ensure it meets contest guidelines and quality standards.</p>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div class="flex-shrink-0 w-8 h-8 rounded-full bg-yellow-400 text-black font-bold flex items-center justify-center text-sm">2</div>
                <div>
                  <h3 class="font-semibold text-white mb-1">Added to Contest</h3>
                  <p class="text-neutral-300 text-sm">Once approved, your coworking space will be added to the contest page where people can vote for it.</p>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div class="flex-shrink-0 w-8 h-8 rounded-full bg-yellow-400 text-black font-bold flex items-center justify-center text-sm">3</div>
                <div>
                  <h3 class="font-semibold text-white mb-1">Public Voting</h3>
                  <p class="text-neutral-300 text-sm">The community will vote for their favorite designs until the end of October 2025.</p>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div class="flex-shrink-0 w-8 h-8 rounded-full bg-yellow-400 text-black font-bold flex items-center justify-center text-sm">4</div>
                <div>
                  <h3 class="font-semibold text-white mb-1">Winner Selection</h3>
                  <p class="text-neutral-300 text-sm">Winners will be chosen by public votes and our expert jury for feature in the next Nomad Magazine edition.</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Timeline Reminder -->
          <div class="bg-yellow-400/10 border border-yellow-400/30 rounded-lg p-4 mb-8 max-w-2xl mx-auto">
            <div class="text-yellow-400 font-bold text-lg mb-2">Contest Timeline</div>
            <div class="text-sm text-neutral-300">
              <p class="mb-1">📍 <strong>Submissions:</strong> Until end of September 2025</p>
              <p>🗳️ <strong>Voting:</strong> Ends October 2025</p>
            </div>
          </div>

          <!-- Action Buttons -->
          <div class="flex flex-col sm:flex-row justify-center gap-4">
            <a
              href="/coworking-spaces"
              class="inline-flex items-center gap-2 rounded-lg bg-yellow-400 px-6 py-3 text-lg font-bold text-black transition-all hover:bg-yellow-300"
            >
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
              </svg>
              View Contest
            </a>
            
            <a
              href="/"
              class="inline-flex items-center gap-2 rounded-lg border-2 border-yellow-400 px-6 py-3 text-lg font-bold text-yellow-400 transition-all hover:bg-yellow-400 hover:text-black"
            >
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
              </svg>
              Back to Home
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Additional Information Section -->
    <section class="px-4 py-16 sm:px-6 lg:px-8 border-t border-neutral-800">
      <div class="mx-auto max-w-4xl">
        <div class="grid md:grid-cols-2 gap-8">
          <!-- Share Section -->
          <div class="bg-neutral-900/50 rounded-2xl p-6">
            <h3 class="text-xl font-bold text-white mb-4">Spread the Word</h3>
            <p class="text-neutral-300 mb-4">
              Help your coworking space get more votes by sharing the contest with your community!
            </p>
            <button
              id="share-btn"
              class="inline-flex items-center gap-2 rounded-lg bg-blue-600 px-4 py-2 text-sm font-medium text-white transition-all hover:bg-blue-700"
            >
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.367 2.684 3 3 0 00-5.367-2.684z"/>
              </svg>
              Share Contest
            </button>
          </div>

          <!-- Contact Section -->
          <div class="bg-neutral-900/50 rounded-2xl p-6">
            <h3 class="text-xl font-bold text-white mb-4">Questions?</h3>
            <p class="text-neutral-300 mb-4">
              Have questions about the contest or your submission? We're here to help!
            </p>
            <a
              href="mailto:hello@nomad-magazine.com"
              class="inline-flex items-center gap-2 rounded-lg bg-neutral-800 px-4 py-2 text-sm font-medium text-white transition-all hover:bg-neutral-700"
            >
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
              Contact Us
            </a>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>

<script>
  // Share functionality
  document.getElementById('share-btn').addEventListener('click', async () => {
    const shareData = {
      title: 'Best Coworking Spaces Design Contest',
      text: 'Vote for the most beautifully designed coworking spaces worldwide! Help select the best spaces for the next Nomad Magazine edition.',
      url: `${window.location.origin}/coworking-spaces`
    };

    try {
      if (navigator.share) {
        await navigator.share(shareData);
      } else {
        // Fallback: copy to clipboard
        await navigator.clipboard.writeText(shareData.url);
        
        // Show feedback
        const btn = document.getElementById('share-btn');
        const originalText = btn.innerHTML;
        btn.innerHTML = `
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
          </svg>
          Link Copied!
        `;
        
        setTimeout(() => {
          btn.innerHTML = originalText;
        }, 2000);
      }
    } catch (error) {
      console.error('Error sharing:', error);
    }
  });
</script>
</Layout>
