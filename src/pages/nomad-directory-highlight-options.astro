---
export const prerender = true;

import Layout, { type SEOProps } from '~/layouts/Layout.astro'
import MaterialSymbolsElectricBolt from '~icons/material-symbols/electric-bolt'

const seo: SEOProps = {
  title: 'Nomad Directory Highlighting Options - Stand Out in the Nomad Economy',
  description: 'Boost your visibility in the Nomad Directory with our highlighting options. Choose from Small or Large format options to reach more digital nomads and showcase your services effectively.',
  image: 'https://nomad-magazine.com/images/Nomad-directory.webp',
  keywords: 'nomad directory highlight, digital nomad advertising, directory listing boost, nomad marketing options, directory visibility enhancement',
  ogType: 'website',
  ldJSON: {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Nomad Directory Highlighting Options',
    description: 'Premium listing options for the Nomad Directory to increase visibility and reach',
    provider: {
      '@type': 'Organization',
      name: 'Nomad Magazine',
      url: 'https://nomad-magazine.com'
    }
  },
}
---

<Layout seo={seo}>
  <div class="bg-gray-50 text-gray-900">
    <!-- Hero Section -->
    <section class="pt-20 pb-12">
      <div class="container mx-auto px-4">
        <div class="text-center mb-12">
          <h1 class="text-4xl md:text-5xl font-bold mb-4">
            <span class="text-yellow-600">Nomad Directory</span> Highlighting Options
          </h1>
          <p class="text-xl text-gray-600 max-w-3xl mx-auto">
            Stand out in our print magazine and digital directory with premium highlighting options
          </p>
        </div>

        <!-- Directory Preview -->
        <div class="max-w-5xl mx-auto mb-16">
          <div class="bg-white rounded-2xl shadow-lg overflow-hidden">
            <img 
              src="/images/NGM-04_NomadDirectory_Proposal_Page_1.webp" 
              alt="Nomad Directory Double Page Spread" 
              class="w-full h-auto"
              loading="lazy"
            />
            <div class="p-6 text-center">
              <h3 class="text-lg font-semibold text-gray-800 mb-2">Real Directory Layout from Print Magazine</h3>
              <p class="text-gray-600 mb-2">See how your business will appear alongside other nomad-focused companies with different highlighting options</p>
              <p class="text-sm font-medium text-gray-700">The Nomad Directory spans 4-6 pages, featuring 80-90 companies serving the digital nomad community</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Options Comparison -->
    <section class="pb-16">
      <div class="container mx-auto px-4">
        <div class="max-w-6xl mx-auto">
          <h2 class="text-3xl font-bold text-center mb-12 text-gray-800">Choose Your Highlight Option</h2>
          
          <div class="grid lg:grid-cols-2 gap-8">
            <!-- Small Format Option -->
            <div class="bg-white rounded-2xl shadow-lg overflow-hidden flex flex-col">
              <div class="p-6 border-b border-gray-100 flex-shrink-0">
                <div class="flex items-center justify-between mb-4">
                  <h3 class="text-2xl font-bold text-gray-800">Small Format</h3>
                  <div class="text-right">
                    <div class="text-3xl font-bold text-blue-600 mb-1">€75</div>
                    <div class="text-xs text-gray-500">one-time fee</div>
                  </div>
                </div>
                <p class="text-gray-600 mb-2">Perfect for essential business information and visibility boost</p>
                <p class="text-sm font-semibold text-blue-700">Only 4 spots available • First booked, first choice</p>
              </div>
              
              <div class="p-6 flex-grow flex flex-col">
                <div class="grid md:grid-cols-2 gap-6 flex-grow">
                  <div class="flex flex-col">
                    <div class="space-y-4 flex-grow">
                      <h4 class="font-semibold text-gray-800 flex items-center gap-2">
                        <MaterialSymbolsElectricBolt width="16" height="16" class="text-yellow-600" />
                        What's Included:
                      </h4>
                      <ul class="space-y-2 text-sm text-gray-600">
                        <li class="flex items-center gap-2">
                          <div class="w-1.5 h-1.5 bg-yellow-600 rounded-full"></div>
                          <span>Highlight frame</span>
                        </li>
                        <li class="flex items-center gap-2">
                          <div class="w-1.5 h-1.5 bg-yellow-600 rounded-full"></div>
                          <span>Small logo display</span>
                        </li>
                        <li class="flex items-center gap-2">
                          <div class="w-1.5 h-1.5 bg-yellow-600 rounded-full"></div>
                          <span>45 word description</span>
                        </li>
                        <li class="flex items-center gap-2">
                          <div class="w-1.5 h-1.5 bg-yellow-600 rounded-full"></div>
                          <span>Website & social links</span>
                        </li>
                      </ul>
                      
                      <div class="mt-4 p-3 bg-blue-50 rounded-lg">
                        <h5 class="font-semibold text-blue-800 text-sm mb-2">Size Specifications</h5>
                        <p class="text-xs text-blue-700">88mm × 52mm</p>
      
                   </div>
                    </div>
                    
                    <a
                      href="mailto:lera@nomadgossip.com?subject=Small Format Highlight - Nomad Directory&body=Hi Lera,%0D%0A%0D%0AI would like to book a Small Format highlight option (€75) in the Nomad Directory.%0D%0A%0D%0ACompany Name:%0D%0AWebsite:%0D%0AContact Person:%0D%0A%0D%0AThank you!"
                      class="inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white px-6 py-2 rounded-lg font-medium transition-all duration-200 text-sm mt-4"
                    >
                      Choose Small Format
                    </a>
                  </div>
                  
                  <div>
                    <img 
                      src="/images/small-nomad-directory-highlight.webp" 
                      alt="Small Format Example" 
                      class="w-full h-auto rounded-lg shadow-md"
                      loading="lazy"
                    />
                    <p class="text-xs text-gray-500 mt-2 text-center">Small format examples</p>
                  </div>
                </div>
              </div>
            </div>

            <!-- Large Format Option -->
            <div class="bg-white rounded-2xl shadow-lg overflow-hidden border-2 border-yellow-200 flex flex-col">
              <div class="bg-gradient-to-r from-yellow-50 to-orange-50 p-6 border-b border-yellow-100 relative flex-shrink-0">
                <div class="absolute top-2 left-4">
                  <span class="bg-yellow-500 text-white px-2 py-1 rounded-full text-xs font-bold">RECOMMENDED</span>
                </div>
                <div class="flex items-center justify-between mb-4 mt-2">
                  <h3 class="text-2xl font-bold text-gray-800">Large Format</h3>
                  <div class="text-right">
                    <div class="text-3xl font-bold text-yellow-600 mb-1">€100</div>
                    <div class="text-xs text-gray-500">one-time fee</div>
                  </div>
                </div>
                <p class="text-gray-600 mb-2">Premium visibility with comprehensive business storytelling</p>
                <p class="text-sm font-semibold text-yellow-700">Only 5 spots available • First booked, first choice</p>
              </div>
              
              <div class="p-6 flex-grow flex flex-col">
                <div class="grid md:grid-cols-2 gap-6 flex-grow">
                  <div class="flex flex-col">
                    <div class="space-y-4 flex-grow">
                      <h4 class="font-semibold text-gray-800 flex items-center gap-2">
                        <MaterialSymbolsElectricBolt width="16" height="16" class="text-yellow-600" />
                        What's Included:
                      </h4>
                      <ul class="space-y-2 text-sm text-gray-600">
                        <li class="flex items-center gap-2">
                          <div class="w-1.5 h-1.5 bg-yellow-600 rounded-full"></div>
                          <span>Larger highlight frame</span>
                        </li>
                        <li class="flex items-center gap-2">
                          <div class="w-1.5 h-1.5 bg-yellow-600 rounded-full"></div>
                          <span>Larger logo/illustration space</span>
                        </li>
                        <li class="flex items-center gap-2">
                          <div class="w-1.5 h-1.5 bg-yellow-600 rounded-full"></div>
                          <span>Up to 80 word description</span>
                        </li>
                        <li class="flex items-center gap-2">
                          <div class="w-1.5 h-1.5 bg-yellow-600 rounded-full"></div>
                          <span>Website & social links</span>
                        </li>
                        <li class="flex items-center gap-2">
                          <div class="w-1.5 h-1.5 bg-yellow-600 rounded-full"></div>
                          <span>Premium positioning</span>
                        </li>
                      </ul>
                      
                      <div class="mt-4 p-3 bg-yellow-50 rounded-lg">
                        <h5 class="font-semibold text-yellow-800 text-sm mb-2">Size Specifications</h5>
                        <p class="text-xs text-yellow-700">116mm × 108mm</p>
                        <p class="text-xs text-yellow-700">(illustration area up to 45x80mm)</p>
                      </div>
                    </div>
                    
                    <a
                      href="mailto:lera@nomadgossip.com?subject=Large Format Highlight - Nomad Directory&body=Hi Lera,%0D%0A%0D%0AI would like to book a Large Format highlight option (€100) in the Nomad Directory.%0D%0A%0D%0ACompany Name:%0D%0AWebsite:%0D%0AContact Person:%0D%0A%0D%0AThank you!"
                      class="inline-flex items-center gap-2 bg-yellow-500 hover:bg-yellow-600 text-white px-6 py-2 rounded-lg font-medium transition-all duration-200 text-sm mt-4"
                    >
                      <MaterialSymbolsElectricBolt width="16" height="16" />
                      Choose Large Format
                    </a>
                  </div>
                  
                  <div>
                    <img 
                      src="/images/large-nomad-directory-highlight.webp" 
                      alt="Large Format Example" 
                      class="w-full h-auto rounded-lg shadow-md"
                      loading="lazy"
                    />
                    <p class="text-xs text-gray-500 mt-2 text-center">Large format examples</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
          
          <!-- Size Note -->
          <div class="mt-8 text-center">
            <p class="text-sm text-gray-600 italic">
              *Sizes may vary slightly to best accommodate the layout, but keeping visual hierarchy and visibility that was bought.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- What We Need From You Section -->
    <section class="py-12 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-2xl font-bold text-center mb-8 text-gray-800">What We Need From You</h2>
          
          <div class="grid md:grid-cols-2 gap-8">
            <!-- Small Format Requirements -->
            <div class="bg-blue-50 rounded-xl p-6">
              <h3 class="text-xl font-bold text-blue-800 mb-4 text-center">Small Format Requirements</h3>
              <ul class="space-y-3 text-sm text-gray-700">
                <li class="flex items-start gap-3">
                  <div class="w-1.5 h-1.5 bg-blue-600 rounded-full mt-2 flex-shrink-0"></div>
                  <span><strong>Company Logo:</strong> High-resolution file (PNG/SVG preferred, minimum 300 DPI)</span>
                </li>
                <li class="flex items-start gap-3">
                  <div class="w-1.5 h-1.5 bg-blue-600 rounded-full mt-2 flex-shrink-0"></div>
                  <span><strong>Description:</strong> Up to 45 words describing your service/product</span>
                </li>
                <li class="flex items-start gap-3">
                  <div class="w-1.5 h-1.5 bg-blue-600 rounded-full mt-2 flex-shrink-0"></div>
                  <span><strong>Two links:</strong> For exampple, website URL, and social media link</span>
                </li>
                <li class="flex items-start gap-3">
                  <div class="w-1.5 h-1.5 bg-blue-600 rounded-full mt-2 flex-shrink-0"></div>
                  <span><strong>Brand Colors:</strong> Hex codes for your brand colors (optional)</span>
                </li>
              </ul>
            </div>

            <!-- Large Format Requirements -->
            <div class="bg-yellow-50 rounded-xl p-6 border-2 border-yellow-200">
              <h3 class="text-xl font-bold text-yellow-800 mb-4 text-center">Large Format Requirements</h3>
              <ul class="space-y-3 text-sm text-gray-700">
                <li class="flex items-start gap-3">
                  <div class="w-1.5 h-1.5 bg-yellow-600 rounded-full mt-2 flex-shrink-0"></div>
                  <span><strong>Logo/Illustration:</strong> High-resolution file or custom illustration</span>
                </li>
                <li class="flex items-start gap-3">
                  <div class="w-1.5 h-1.5 bg-yellow-600 rounded-full mt-2 flex-shrink-0"></div>
                  <span><strong>Description:</strong> Up to 80 words describing your service/product in detail</span>
                </li>
                <li class="flex items-start gap-3">
                  <div class="w-1.5 h-1.5 bg-blue-600 rounded-full mt-2 flex-shrink-0"></div>
                  <span><strong>Two links:</strong> For exampple, website URL, and social media link</span>
                </li>
                <li class="flex items-start gap-3">
                  <div class="w-1.5 h-1.5 bg-yellow-600 rounded-full mt-2 flex-shrink-0"></div>
                  <span><strong>Brand Assets:</strong> Brand colors (hex codes), fonts, and any specific design preferences</span>
                </li>
               
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- File Requirements Section -->
    <section class="py-12 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-2xl font-bold text-center mb-8 text-gray-800">File Requirements</h2>
          
          <div class="bg-gray-50 rounded-xl p-6">
            <div class="grid md:grid-cols-3 gap-6 text-center">
              <div>
                <div class="w-12 h-12 bg-yellow-100 rounded-xl flex items-center justify-center mx-auto mb-3">
                  <svg class="w-6 h-6 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                  </svg>
                </div>
                <h4 class="font-semibold text-gray-800 mb-2">Format</h4>
                <p class="text-sm text-gray-600">Layered PDF preferred<br/>PNG, SVG, AI, PSD accepted</p>
              </div>
              
              <div>
                <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center mx-auto mb-3">
                  <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4a1 1 0 011-1h4m0 12v4a1 1 0 01-1 1H4m16-4v4a1 1 0 01-1 1h-4m0-12V4a1 1 0 011-1h4"/>
                  </svg>
                </div>
                <h4 class="font-semibold text-gray-800 mb-2">Size</h4>
                <p class="text-sm text-gray-600">2500px wide minimum<br/>300 DPI for print quality</p>
              </div>
              
              <div>
                <div class="w-12 h-12 bg-green-100 rounded-xl flex items-center justify-center mx-auto mb-3">
                  <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                </div>
                <h4 class="font-semibold text-gray-800 mb-2">Support</h4>
                <p class="text-sm text-gray-600">Our design team can help<br/>with file optimization</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Second Directory Page Preview -->
    <section class="py-12 bg-gray-50">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
          <div class="bg-white rounded-2xl shadow-lg overflow-hidden">
            <img 
              src="/images/NGM-04_NomadDirectory_Proposal_Page_2 2.webp" 
              alt="Nomad Directory Double Page Spread - Page 2" 
              class="w-full h-auto"
              loading="lazy"
            />
            <div class="p-6 text-center">
              <p class="text-sm text-gray-600">More examples from the Nomad Directory showcasing various listing formats</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-16 bg-gradient-to-r from-yellow-50 to-orange-50">
      <div class="container mx-auto px-4">
        <div class="max-w-3xl mx-auto text-center">
          <div class="inline-block bg-red-500 text-white px-4 py-2 rounded-full font-bold text-sm mb-4">
            Deadline: December 15, 2025
          </div>
          <h2 class="text-3xl font-bold text-gray-800 mb-6">Ready to Stand Out?</h2>
          <p class="text-lg text-gray-600 mb-8">
            Join companies already reaching thousands of digital nomads through our directory. 
            One-time setup, lasting visibility.
          </p>
          
          <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
            <a
              href="mailto:lera@nomadgossip.com?subject=Nomad Directory Highlight Option Inquiry"
              class="inline-flex items-center gap-2 bg-yellow-500 hover:bg-yellow-600 text-white px-8 py-3 rounded-lg font-bold text-lg transition-all duration-200"
            >
              <MaterialSymbolsElectricBolt width="20" height="20" />
              Book Your Highlight Option
            </a>
            
            <p class="text-sm text-gray-500">
              No recurring fees • Print & Digital • Fast setup
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Historical Inspiration -->
    <section class="py-16 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-2xl font-bold text-center mb-8 text-gray-800">A Format Inspired by History</h2>
          
          <div class="grid md:grid-cols-2 gap-8 items-start">
            <div>
              <img 
                src="/images/1903-newspaper-reference.webp" 
                alt="1903 London Newspaper Advertisement Page" 
                class="w-full h-auto rounded-lg shadow-lg"
                loading="lazy"
              />
              <p class="text-sm text-gray-500 mt-3 text-center">Original 1903 London newspaper advertisement page</p>
            </div>
            
            <div class="space-y-4">
              <p class="text-lg text-gray-700 leading-relaxed">
                Our directory format was inspired by a remarkable piece of history - a 1903 London newspaper 
                that I was lucky to hold in my hands. 
              </p>
              <p class="text-gray-600 leading-relaxed">
                The way businesses showcased themselves over a century ago - with different sizes, 
                creative layouts, and varying levels of prominence - perfectly captured the essence 
                of what we wanted to create for the modern nomad economy.
              </p>
              <p class="text-gray-600 leading-relaxed">
                Just as merchants in 1903 London chose different advertisement sizes to match their 
                budgets and ambitions, today's nomad-focused businesses can select the highlighting 
                option that best represents their brand in our directory.
              </p>
              <p class="text-sm text-gray-500 italic">
                Some ideas are timeless - they just need the right moment to be rediscovered.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
