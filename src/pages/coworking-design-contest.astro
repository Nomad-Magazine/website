  function setupCarousels() {
    // Setup unified modal clicks on the image area containers
    document.querySelectorAll('.image-container').forEach(container => {
      container.addEventListener('click', (e) => {
        // Don't trigger if clicking on navigation buttons or dots
        if (e.target.classList.contains('carousel-prev') || 
            e.target.classList.contains('carousel-next') || 
            e.target.classList.contains('carousel-dot') ||
            e.target.closest('.carousel-prev') ||
            e.target.closest('.carousel-next') ||
            e.target.closest('.carousel-dot')) {
          return;
        }
        
        // Find the visible image and get space data
        const visibleImage = container.querySelector('.carousel-image:not(.hidden)');
        if (visibleImage) {
          e.stopPropagation();
          const images = JSON.parse(visibleImage.dataset.images);
          const currentIndex = parseInt(visibleImage.dataset.index);
          const spaceName = visibleImage.dataset.spaceName;
          
          // Find the full space data
          const space = coworkingSpaces.find(s => s.name === spaceName);
          if (space && window.openUnifiedModal) {
            window.openUnifiedModal(space, images, currentIndex);
          }
        }
      });
    });

    // Setup carousel navigation
    document.querySelectorAll('.carousel-prev').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const spaceId = btn.dataset.spaceId;
        navigateCarousel(spaceId, -1);
      });
    });

    document.querySelectorAll('.carousel-next').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const spaceId = btn.dataset.spaceId;
        navigateCarousel(spaceId, 1);
      });
    });

    document.querySelectorAll('.carousel-dot').forEach(dot => {
      dot.addEventListener('click', (e) => {
        e.stopPropagation();
        const spaceId = dot.dataset.spaceId;
        const index = parseInt(dot.dataset.index);
        setCarouselImage(spaceId, index);
      });
    });
  }

  function navigateCarousel(spaceId, direction) {
    const container = document.querySelector(`[data-space-id="${spaceId}"]`);
    const images = container.querySelectorAll('.carousel-image');
    const dots = document.querySelectorAll(`[data-space-id="${spaceId}"].carousel-dot`);
    
    let currentIndex = 0;
    images.forEach((img, index) => {
      if (!img.classList.contains('hidden')) {
        currentIndex = index;
      }
    });

    let newIndex = currentIndex + direction;
    if (newIndex >= images.length) newIndex = 0;
    if (newIndex < 0) newIndex = images.length - 1;

    setCarouselImage(spaceId, newIndex);
  }

  function setCarouselImage(spaceId, index) {
    const container = document.querySelector(`[data-space-id="${spaceId}"]`);
    const images = container.querySelectorAll('.carousel-image');
    const dots = document.querySelectorAll(`[data-space-id="${spaceId}"].carousel-dot`);

    images.forEach((img, i) => {
      img.classList.toggle('hidden', i !== index);
    });

    dots.forEach((dot, i) => {
      dot.classList.toggle('bg-white', i === index);
      dot.classList.toggle('bg-white/50', i !== index);
    });
  }

  function setupVoteButtons() {
    document.querySelectorAll('.vote-btn').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        e.preventDefault();
        e.stopPropagation();
        const spaceId = btn.dataset.spaceId; // Don't parseInt for string IDs
        console.log('Vote button clicked, space ID from dataset:', spaceId);
        await handleVote(spaceId, btn);
      });
    });
  }

  function setupDescriptionClicks() {
    document.querySelectorAll('.description-text').forEach(desc => {
      desc.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const spaceName = desc.dataset.spaceName;
        
        // Find the full space data
        const space = coworkingSpaces.find(s => s.name === spaceName);
        if (space && window.openUnifiedModal) {
          // Open unified modal with images starting at index 0
          window.openUnifiedModal(space, space.images || [], 0);
        }
      });
    });
  }

  async function handleVote(spaceId, button) {
    try {
      console.log('Voting for space ID:', spaceId);
      
      if (!spaceId || spaceId === 'undefined' || spaceId === 'null') {
        console.error('Invalid space ID:', spaceId);
        return;
      }

      const space = coworkingSpaces.find(s => s.id === spaceId);
      const isVoted = userVotes.has(spaceId);
      
      // Handle both card vote buttons and unified vote buttons
      const voteCountSpan = button.querySelector('.vote-count') || button.querySelector('.unified-vote-count');
      const heartIcon = button.querySelector('svg');
      const isUnifiedButton = button.classList.contains('unified-vote-btn');
      
      if (isVoted) {
        // Remove vote
        const { error } = await supabase
          .from('coworking_votes')
          .delete()
          .eq('space_id', spaceId)
          .eq('user_fingerprint', userFingerprint);

        if (!error) {
          userVotes.delete(spaceId);
          
          if (isUnifiedButton) {
            button.classList.remove('bg-red-600', 'text-white');
            button.classList.add('bg-neutral-700', 'text-gray-300', 'hover:bg-red-600', 'hover:text-white');
          } else {
            button.classList.remove('bg-red-600', 'text-white');
            button.classList.add('bg-neutral-800', 'text-neutral-400', 'hover:bg-red-600', 'hover:text-white');
          }
          
          if (heartIcon) heartIcon.classList.remove('fill-current');
          if (voteCountSpan) voteCountSpan.textContent = parseInt(voteCountSpan.textContent) - 1;
          
          // Update local data
          if (space) space.vote_count = Math.max(0, space.vote_count - 1);
          updateStats();
          // Re-apply current filters and sorting
          applyFilters();
        } else {
          console.error('Error removing vote:', error);
        }
      } else {
        // Add vote
        console.log('Inserting vote with space_id:', spaceId, 'user_fingerprint:', userFingerprint);
        
        const { error } = await supabase
          .from('coworking_votes')
          .insert({
            space_id: spaceId,
            user_fingerprint: userFingerprint
          });

        if (!error) {
          userVotes.add(spaceId);
          
          if (isUnifiedButton) {
            button.classList.remove('bg-neutral-700', 'text-gray-300', 'hover:bg-red-600', 'hover:text-white');
            button.classList.add('bg-red-600', 'text-white');
          } else {
            button.classList.remove('bg-neutral-800', 'text-neutral-400', 'hover:bg-red-600', 'hover:text-white');
            button.classList.add('bg-red-600', 'text-white');
          }
          
          if (heartIcon) heartIcon.classList.add('fill-current');
          if (voteCountSpan) voteCountSpan.textContent = parseInt(voteCountSpan.textContent) + 1;
          
          // Update local data
          if (space) space.vote_count += 1;
          updateStats();
          // Re-apply current filters and sorting
          applyFilters();
        } else {
          console.error('Error adding vote:', error);
        }
      }
    } catch (error) {
      console.error('Error handling vote:', error);
    }
  }

