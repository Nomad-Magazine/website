  function setupUnifiedCarousel(images, startIndex = 0) {
    let currentUnifiedIndex = startIndex;
    
    // Previous button
    const prevBtn = document.querySelector('.unified-carousel-prev');
    if (prevBtn) {
      prevBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        currentUnifiedIndex = currentUnifiedIndex > 0 ? currentUnifiedIndex - 1 : images.length - 1;
        updateUnifiedCarousel(currentUnifiedIndex);
      });
    }
    
    // Next button  
    const nextBtn = document.querySelector('.unified-carousel-next');
    if (nextBtn) {
      nextBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        currentUnifiedIndex = currentUnifiedIndex < images.length - 1 ? currentUnifiedIndex + 1 : 0;
        updateUnifiedCarousel(currentUnifiedIndex);
      });
    }
    
    // Dots
    document.querySelectorAll('.unified-carousel-dot').forEach(dot => {
      dot.addEventListener('click', (e) => {
        e.stopPropagation();
        currentUnifiedIndex = parseInt(dot.dataset.index);
        updateUnifiedCarousel(currentUnifiedIndex);
      });
    });
  }
  
  function updateUnifiedCarousel(index) {
    // Update images using opacity instead of hidden
    document.querySelectorAll('.unified-carousel-image').forEach((img, i) => {
      if (i === index) {
        img.classList.remove('opacity-0');
        img.classList.add('opacity-100');
      } else {
        img.classList.remove('opacity-100');
        img.classList.add('opacity-0');
      }
    });
    
    // Update dots
    document.querySelectorAll('.unified-carousel-dot').forEach((dot, i) => {
      if (i === index) {
        dot.classList.remove('bg-white/50');
        dot.classList.add('bg-white', 'scale-125');
      } else {
        dot.classList.remove('bg-white', 'scale-125');
        dot.classList.add('bg-white/50');
      }
    });
  }
  
  function setupUnifiedVoteButton() {
    const voteBtn = document.querySelector('.unified-vote-btn');
    if (voteBtn) {
      voteBtn.addEventListener('click', async (e) => {
        e.preventDefault();
        e.stopPropagation();
        const spaceId = voteBtn.dataset.spaceId;
        console.log('Unified vote button clicked, space ID:', spaceId);
        await handleVote(spaceId, voteBtn);
        
        // Update the corresponding card vote button if visible
        const cardVoteBtn = document.querySelector(`[data-space-id="${spaceId}"] .vote-btn`);
        if (cardVoteBtn) {
          const cardVoteCount = cardVoteBtn.querySelector('.vote-count');
          const unifiedVoteCount = voteBtn.querySelector('.unified-vote-count');
          if (cardVoteCount && unifiedVoteCount) {
            cardVoteCount.textContent = unifiedVoteCount.textContent;
          }
          
          // Sync button states
          const isVoted = userVotes.has(spaceId);
          const heartIcon = cardVoteBtn.querySelector('svg');
          if (isVoted) {
            cardVoteBtn.classList.remove('bg-neutral-800', 'text-neutral-400', 'hover:bg-red-600', 'hover:text-white');
            cardVoteBtn.classList.add('bg-red-600', 'text-white');
            if (heartIcon) heartIcon.classList.add('fill-current');
          } else {
            cardVoteBtn.classList.remove('bg-red-600', 'text-white');
            cardVoteBtn.classList.add('bg-neutral-800', 'text-neutral-400', 'hover:bg-red-600', 'hover:text-white');
            if (heartIcon) heartIcon.classList.remove('fill-current');
          }
        }
      });
    }
  }
  
  // Simple markdown to HTML converter (copied from DescriptionModal)
  function convertMarkdownToHtml(markdown) {
    if (!markdown) return '';
    
    // First, convert escaped newlines to actual newlines
    markdown = markdown.replace(/\\n/g, '\n');
    
    let html = markdown
      // Headers first
      .replace(/^### (.*$)/gim, '<h3 class="text-lg font-bold text-white mt-6 mb-3">$1</h3>')
      .replace(/^## (.*$)/gim, '<h2 class="text-xl font-bold text-white mt-6 mb-4">$1</h2>')
      .replace(/^# (.*$)/gim, '<h1 class="text-2xl font-bold text-white mt-6 mb-4">$1</h1>')
      
      // Bold and Italic
      .replace(/\*\*(.*?)\*\*/g, '<strong class="font-bold text-white">$1</strong>')
      .replace(/\*(.*?)\*/g, '<em class="italic text-neutral-100">$1</em>')
      
      // Links
      .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank" rel="noopener noreferrer" class="text-yellow-400 hover:text-yellow-300 underline">$1</a>');
    
    // Handle paragraph breaks
    if (html.includes('\n\n')) {
      html = html.split(/\n\s*\n/).map(para => {
        if (!para.trim()) return '';
        if (para.trim().startsWith('<h')) return para.trim();
        return `<p class="text-gray-100 mb-4 leading-relaxed text-base">${para.trim().replace(/\n/g, '<br>')}</p>`;
      }).filter(p => p).join('');
    } else if (html.includes('\n')) {
      const sentences = html.split(/(?<=[.!?])\s*\n/);
      if (sentences.length > 1) {
        html = sentences.map(sentence => {
          if (!sentence.trim()) return '';
          if (sentence.trim().startsWith('<h')) return sentence.trim();
          return `<p class="text-gray-100 mb-4 leading-relaxed text-base">${sentence.trim()}</p>`;
        }).filter(p => p).join('');
      } else {
        html = html.replace(/([.!?])\s+([A-Z])/g, '$1</p><p class="text-gray-100 mb-4 leading-relaxed text-base">$2');
        if (!html.startsWith('<h') && !html.startsWith('<p')) {
          html = `<p class="text-gray-100 mb-4 leading-relaxed text-base">${html}</p>`;
        }
      }
    } else {
      if (!html.startsWith('<h') && !html.startsWith('<p')) {
        html = `<p class="text-gray-100 mb-4 leading-relaxed text-base">${html}</p>`;
      }
    }
    
    return html;
  }

  // Make the unified modal function globally available
  window.openUnifiedModal = openUnifiedModal;

  function setupEventListeners() {
    // Filter toggle
    document.getElementById('filter-btn').addEventListener('click', () => {
      const filtersSection = document.getElementById('filters-section');
      filtersSection.classList.toggle('hidden');
    });

    // Submit buttons - open SmartSuite forms in new tab
    document.getElementById('submit-owner-btn').addEventListener('click', () => {
      window.open('https://app.smartsuite.com/form/s4tmc086/4aXsS71xFf', '_blank');
    });

    document.getElementById('submit-nominate-btn').addEventListener('click', () => {
      window.open('https://app.smartsuite.com/form/s4tmc086/miWoDO3Ff2', '_blank');
    });

    // Bottom submit buttons - same functionality
    document.getElementById('submit-owner-btn-bottom').addEventListener('click', () => {
      window.open('https://app.smartsuite.com/form/s4tmc086/4aXsS71xFf', '_blank');
    });

    document.getElementById('submit-nominate-btn-bottom').addEventListener('click', () => {
      window.open('https://app.smartsuite.com/form/s4tmc086/miWoDO3Ff2', '_blank');
    });



    // Filter changes
    ['country-filter', 'city-filter', 'price-filter', 'sort-filter'].forEach(id => {
      document.getElementById(id).addEventListener('change', applyFilters);
    });



    // Image modal controls are handled by the ImageModal component
  }

  function applyFilters() {
    const country = document.getElementById('country-filter').value;
    const city = document.getElementById('city-filter').value;
    const price = document.getElementById('price-filter').value;
    const sort = document.getElementById('sort-filter').value;

    let filtered = [...coworkingSpaces];

    // Apply filters
    if (country) filtered = filtered.filter(space => space.country === country);
    if (city) filtered = filtered.filter(space => space.city === city);
    if (price) {
      filtered = filtered.filter(space => {
        if (!space.price_range) return false;
        const priceNum = parseInt(space.price_range.replace(/[^0-9]/g, ''));
        if (price === 'budget') return priceNum <= 20;
        if (price === 'mid') return priceNum > 20 && priceNum <= 40;
        if (price === 'premium') return priceNum > 40;
        return true;
      });
    }

    // Apply sorting
    if (sort === 'votes') {
      filtered.sort((a, b) => b.vote_count - a.vote_count);
    } else if (sort === 'newest') {
      filtered.sort((a, b) => new Date(b.created_at) - new Date(a.created_at));
    } else if (sort === 'name') {
      filtered.sort((a, b) => a.name.localeCompare(b.name));
    }

    renderSpaces(filtered);
  }



  // Initialize when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', loadSupabase);
  } else {
    loadSupabase();
  }
</script>

