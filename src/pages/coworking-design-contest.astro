---
export const prerender = true;

import Layout, { type SEOProps } from '~/layouts/Layout.astro'
import ImageModal from '~/components/ImageModal.astro'
import DescriptionModal from '~/components/DescriptionModal.astro'
import { supabaseUrl, supabaseAnonKey } from '~/utils/supabase'
import { fetchReportRecords } from '~/utils/smartsuite'

// Get Supabase config to pass to client
const supabaseConfig = {
  url: supabaseUrl,
  anonKey: supabaseAnonKey
}

// Fetch distribution list coworking spaces at BUILD TIME (same as distribution list)
const { records: distributionRecords = [] } = await fetchReportRecords('68614a111208586bd05d3c3a')

console.log('DEBUG: Total records fetched:', distributionRecords.length)
console.log('DEBUG: Sample record structure:', distributionRecords[0] ? Object.keys(distributionRecords[0]) : 'No records')
console.log('DEBUG: Sample record image fields:', distributionRecords[0] ? {
  image: distributionRecords[0].image,
  images: distributionRecords[0].images,
  sf4ad525dd: distributionRecords[0].sf4ad525dd,
  s4ad525dd: distributionRecords[0].s4ad525dd
} : 'No records')

// Filter and transform distribution coworking spaces
const allCoworkingRecords = distributionRecords.filter((record: any) => record.sb685ab800?.label === 'Coworking')
console.log('DEBUG: Records with Coworking category:', allCoworkingRecords.length)

const distributionCoworkingSpaces = distributionRecords
  .filter((record: any) => 
    record.sb685ab800?.label === 'Coworking' && 
    record.s43a4b2808 && 
    record.title
  )
  .map((record: any) => ({
    id: record.s9744d6c51 ? `coming_${record.id}` : `dist_${record.id}`,
    name: record.title,
    description: record.scea90e502 || (record.s9744d6c51 ? 'Coming soon to this location.' : 'A great coworking space for digital nomads.'),
    description_markdown: record.description_markdown || null,
    location: record.sed1a49986 || 'Location not specified',
    city: record.sed1a49986?.split(',')[0]?.trim() || 'Unknown',
    country: record.sed1a49986?.split(',').slice(-1)[0]?.trim() || 'Unknown',
    website_url: record.sb788c266b?.[0] || null,
    images: (() => {
      // Try multiple possible image fields
      const imageFields = [
        record.image,
        record.images,
        record.sf4ad525dd,
        record.s4ad525dd
      ].filter(Boolean);
      
      if (imageFields.length === 0) return [];
      
      // Flatten all image fields and remove duplicates
      const allImages = imageFields.flat().filter(Boolean);
      return [...new Set(allImages)];
    })(),
    amenities: [],
    price_range: null,
    wifi_speed: null,
    is_verified: true,
    discount_code: record.s9c0ff01ed || null,
    created_at: record.first_created?.on || new Date().toISOString(),
    isComingSoon: !!record.s9744d6c51
  }))

console.log('DEBUG: Final coworking spaces count:', distributionCoworkingSpaces.length)
console.log('DEBUG: Sample coworking space:', distributionCoworkingSpaces[0] ? distributionCoworkingSpaces[0].name : 'No spaces')

// Pass distribution spaces to client
const distributionSpacesConfig = {
  spaces: distributionCoworkingSpaces
}

const seo: SEOProps = {
  title: 'Best Coworking Spaces Contest - Vote for Your Favorite Design',
  description: 'Vote for the best designed coworking spaces worldwide! Top selections by public votes and Nomad Magazine jury will be featured in our next edition.',
  image: `${Astro.site}images/coworking-spaces-hero.webp`,
  keywords: 'coworking spaces contest, best design, digital nomads, vote, nomad magazine, workspace design, coworking competition',
}
---

<Layout seo={seo}>
  <div class="bg-hoverw text-white min-h-screen">
    <!-- Hero Section -->
    <section class="px-4 py-16 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="text-center">
          <h1 class="text-4xl font-bold sm:text-6xl lg:text-7xl mb-6">
            Best <span class="text-yellow-400">Coworking Spaces</span> 
            <br>Design Contest
          </h1>
          <p class="text-xl text-neutral-300 mb-8 max-w-3xl mx-auto">
            Vote for the most beautifully designed coworking spaces worldwide! Help us select the best spaces that will be featured in the next Nomad Magazine edition. Winners chosen by public votes and our expert jury.
          </p>
          <div class="bg-yellow-400/10 border border-yellow-400/30 rounded-lg p-4 mb-8 max-w-2xl mx-auto">
            <div class="text-yellow-400 font-bold text-lg mb-2">We're celebrating design and beauty first</div>
            <div class="text-sm text-neutral-300 mb-4">
              <p class="mb-2">Think: ✨ stunning interiors, 🌅 dreamy views, 🪑 ergonomic brilliance, and spaces that make you want to stay late 🌙</p>
              <div class="border-t border-yellow-400/30 pt-3 mt-3">
                <p class="mb-1">📍 <strong>Submissions:</strong> Places can be added until end of September 2025</p>
                <p>🗳️ <strong>Voting:</strong> Voting stops October 20, 2025</p>
              </div>
            </div>
          </div>
          <div class="flex flex-col sm:flex-row justify-center gap-4 mb-6">
            <button 
              id="submit-owner-btn"
              class="inline-flex items-center gap-2 rounded-lg bg-yellow-400 px-6 py-3 text-lg font-bold text-black transition-all hover:bg-yellow-300"
            >
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
              </svg>
              Submit Your Space
            </button>
            <button 
              id="submit-nominate-btn"
              class="inline-flex items-center gap-2 rounded-lg border-2 border-yellow-400 px-6 py-3 text-lg font-bold text-yellow-400 transition-all hover:bg-yellow-400 hover:text-black"
            >
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>
              </svg>
              Nominate a Space
            </button>
          </div>
          <div class="flex justify-center">
            <button 
              id="filter-btn"
              class="inline-flex items-center gap-1 text-sm text-neutral-400 hover:text-yellow-400 transition-colors"
            >
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"/>
              </svg>
              Filter & Sort
            </button>
          </div>
        </div>
      </div>
    </section>

    <!-- Filters Section (Initially Hidden) -->
    <section id="filters-section" class="px-4 py-8 sm:px-6 lg:px-8 border-b border-neutral-800 hidden">
      <div class="mx-auto max-w-7xl">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
          <select id="country-filter" class="rounded-lg bg-neutral-800 border border-neutral-700 text-white px-4 py-2">
            <option value="">All Countries</option>
          </select>
          <select id="city-filter" class="rounded-lg bg-neutral-800 border border-neutral-700 text-white px-4 py-2">
            <option value="">All Cities</option>
          </select>
          <select id="price-filter" class="rounded-lg bg-neutral-800 border border-neutral-700 text-white px-4 py-2">
            <option value="">All Prices</option>
            <option value="budget">Budget ($0-20/day)</option>
            <option value="mid">Mid-range ($21-40/day)</option>
            <option value="premium">Premium ($41+/day)</option>
          </select>
          <select id="sort-filter" class="rounded-lg bg-neutral-800 border border-neutral-700 text-white px-4 py-2">
            <option value="votes">Most Votes</option>
            <option value="newest">Newest</option>
            <option value="name">Alphabetical</option>
          </select>
        </div>
      </div>
    </section>

    <!-- Stats Section -->
    <section class="px-4 py-8 sm:px-6 lg:px-8 border-b border-neutral-800">
      <div class="mx-auto max-w-7xl">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
          <div>
            <div class="text-3xl font-bold text-yellow-400" id="total-spaces">0</div>
            <div class="text-sm text-neutral-400">Contest Entries</div>
          </div>
          <div>
            <div class="text-3xl font-bold text-yellow-400" id="total-votes">0</div>
            <div class="text-sm text-neutral-400">Public Votes</div>
          </div>
          <div>
            <div class="text-3xl font-bold text-yellow-400" id="total-countries">0</div>
            <div class="text-sm text-neutral-400">Countries</div>
          </div>
          <div>
            <div class="text-3xl font-bold text-yellow-400" id="total-cities">0</div>
            <div class="text-sm text-neutral-400">Cities</div>
          </div>
        </div>
      </div>
    </section>

    <!-- Coworking Spaces Grid -->
    <section class="px-4 py-16 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <div id="loading-spinner" class="text-center py-12">
          <div class="inline-block animate-spin rounded-full h-8 w-8 border-b-2 border-yellow-400"></div>
          <p class="mt-2 text-neutral-400">Loading contest entries...</p>
        </div>
        
        <div id="spaces-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 hidden">
          <!-- Spaces will be dynamically inserted here -->
        </div>

        <div id="no-spaces" class="text-center py-12 hidden">
          <p class="text-xl text-neutral-400">No contest entries found matching your criteria.</p>
        </div>
      </div>
    </section>

    <!-- Bottom Call to Action -->
    <section class="px-4 py-16 sm:px-6 lg:px-8 border-t border-neutral-800">
      <div class="mx-auto max-w-4xl text-center">
        <h2 class="text-3xl font-bold sm:text-4xl mb-4">
          Ready to Join the <span class="text-yellow-400">Contest</span>?
        </h2>
        <p class="text-xl text-neutral-300 mb-8">
          Help us discover the world's most beautifully designed coworking spaces. Submit your space or nominate your favorites!
        </p>
        <div class="flex flex-col sm:flex-row justify-center gap-4">
          <button 
            id="submit-owner-btn-bottom"
            class="inline-flex items-center gap-2 rounded-lg bg-yellow-400 px-6 py-3 text-lg font-bold text-black transition-all hover:bg-yellow-300"
          >
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
            </svg>
            Submit Your Space
          </button>
          <button 
            id="submit-nominate-btn-bottom"
            class="inline-flex items-center gap-2 rounded-lg border-2 border-yellow-400 px-6 py-3 text-lg font-bold text-yellow-400 transition-all hover:bg-yellow-400 hover:text-black"
          >
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>
            </svg>
            Nominate a Space
          </button>
        </div>
      </div>
    </section>

    <!-- Image Modal Component -->
    <ImageModal />
    
    <!-- Description Modal Component -->
    <DescriptionModal />


  </div>
</Layout>

<script is:inline define:vars={{ supabaseConfig, distributionSpacesConfig }}>
  // Get config passed from server-side
  const supabaseUrl = supabaseConfig.url;
  const supabaseAnonKey = supabaseConfig.anonKey;
  const distributionSpaces = distributionSpacesConfig.spaces;
  
  let supabase = null;
  let currentUser = null;
  let userFingerprint = null;
  let coworkingSpaces = [];
  let userVotes = new Set();
  let currentImageModal = { images: [], currentIndex: 0 };

  // Generate user fingerprint for anonymous voting
  function generateFingerprint() {
    const canvas = document.createElement('canvas');
    const ctx = canvas.getContext('2d');
    ctx.textBaseline = 'top';
    ctx.font = '14px Arial';
    ctx.fillText('Nomad Magazine Fingerprint', 2, 2);
    
    const fingerprint = [
      navigator.userAgent,
      navigator.language,
      screen.width + 'x' + screen.height,
      new Date().getTimezoneOffset(),
      canvas.toDataURL()
    ].join('|');
    
    // Simple hash function
    let hash = 0;
    for (let i = 0; i < fingerprint.length; i++) {
      const char = fingerprint.charCodeAt(i);
      hash = ((hash << 5) - hash) + char;
      hash = hash & hash; // Convert to 32-bit integer
    }
    return 'fp_' + Math.abs(hash).toString(36);
  }

  // Load Supabase and initialize
  function loadSupabase() {
    const script = document.createElement('script');
    script.src = 'https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.js';
    script.onload = initializeApp;
    script.onerror = () => {
      console.error('Failed to load Supabase script');
      loadCoworkingSpacesWithoutSupabase();
      setupEventListeners();
    };
    
    // Timeout for script loading
    setTimeout(() => {
      if (!window.supabase) {
        console.error('Supabase script loading timeout');
        loadCoworkingSpacesWithoutSupabase();
        setupEventListeners();
      }
    }, 10000);
    
    document.head.appendChild(script);
  }

  async function initializeApp() {
    try {
    supabase = window.supabase.createClient(supabaseUrl, supabaseAnonKey);
    userFingerprint = generateFingerprint();
    
      // Try to get existing user or sign in anonymously with timeout
      const authTimeout = new Promise((_, reject) => 
        setTimeout(() => reject(new Error('Auth timeout')), 10000)
      );
      
      try {
        const { data: { user } } = await Promise.race([
          supabase.auth.getUser(),
          authTimeout
        ]);
        
    if (!user) {
          const { data: authData } = await Promise.race([
            supabase.auth.signInAnonymously(),
            authTimeout
          ]);
      currentUser = authData?.user;
    } else {
      currentUser = user;
        }
      } catch (authError) {
        console.warn('Auth failed, continuing without authentication:', authError);
        currentUser = null;
    }

    await loadCoworkingSpaces();
    setupEventListeners();
    } catch (error) {
      console.error('Failed to initialize app:', error);
      // Fallback: load spaces without Supabase
      loadCoworkingSpacesWithoutSupabase();
    setupEventListeners();
    }
  }

  async function loadCoworkingSpaces() {
    try {
      console.log('CLIENT DEBUG: Starting to load coworking spaces');
      console.log('CLIENT DEBUG: distributionSpaces from server:', distributionSpaces.length);
      
      if (!supabase) {
        throw new Error('Supabase not initialized');
      }
      
      // Add timeout for database queries
      const queryTimeout = new Promise((_, reject) => 
        setTimeout(() => reject(new Error('Database query timeout')), 15000)
      );
      
      let voteCounts = null;
      let userVoteData = null;
      
      try {
        // Load vote counts for all spaces with timeout
        const { data: voteData, error: voteError } = await Promise.race([
          supabase.from('coworking_vote_counts').select('*'),
          queryTimeout
        ]);

      if (voteError) {
        console.warn('Vote counts error:', voteError);
        } else {
          voteCounts = voteData;
        }
      } catch (voteError) {
        console.warn('Failed to load vote counts:', voteError);
      }

      try {
        // Load user votes with timeout
        if (userFingerprint) {
          const { data: userData, error: userVoteError } = await Promise.race([
            supabase.from('coworking_votes').select('space_id').eq('user_fingerprint', userFingerprint),
            queryTimeout
          ]);
          
          if (!userVoteError && userData) {
            userVotes = new Set(userData.map(vote => vote.space_id));
          }
        }
      } catch (userVoteError) {
        console.warn('Failed to load user votes:', userVoteError);
      }

      // Use distribution spaces with vote counts (fallback to 0 if no data)
      coworkingSpaces = distributionSpaces.map(space => ({
        ...space,
        vote_count: voteCounts?.find(vc => vc.space_id === space.id)?.vote_count || 0
      }));

      console.log('CLIENT DEBUG: Final coworking spaces loaded:', coworkingSpaces.length);

      updateStats();
      populateFilters();
      applyFilters();

    } catch (error) {
      console.error('CLIENT DEBUG: Error loading coworking spaces:', error);
      // Fallback to loading without Supabase
      loadCoworkingSpacesWithoutSupabase();
    }
  }

  function loadCoworkingSpacesWithoutSupabase() {
    console.log('Loading coworking spaces without Supabase...');
    
    // Use distribution spaces with default vote counts
    coworkingSpaces = distributionSpaces.map(space => ({
      ...space,
      vote_count: 0
    }));

    console.log('Loaded', coworkingSpaces.length, 'spaces without database');

    updateStats();
    populateFilters();
    applyFilters();
  }

  function updateStats() {
    const totalSpaces = coworkingSpaces.length;
    const totalVotes = coworkingSpaces.reduce((sum, space) => sum + space.vote_count, 0);
    const countries = new Set(coworkingSpaces.map(space => space.country)).size;
    const cities = new Set(coworkingSpaces.map(space => space.city)).size;

    document.getElementById('total-spaces').textContent = totalSpaces;
    document.getElementById('total-votes').textContent = totalVotes;
    document.getElementById('total-countries').textContent = countries;
    document.getElementById('total-cities').textContent = cities;
  }

  function populateFilters() {
    const countries = [...new Set(coworkingSpaces.map(space => space.country))].sort();
    const cities = [...new Set(coworkingSpaces.map(space => space.city))].sort();

    const countrySelect = document.getElementById('country-filter');
    const citySelect = document.getElementById('city-filter');

    countries.forEach(country => {
      const option = document.createElement('option');
      option.value = country;
      option.textContent = country;
      countrySelect.appendChild(option);
    });

    cities.forEach(city => {
      const option = document.createElement('option');
      option.value = city;
      option.textContent = city;
      citySelect.appendChild(option);
    });
  }

  function renderSpaces(filteredSpaces = coworkingSpaces) {
    const grid = document.getElementById('spaces-grid');
    const loading = document.getElementById('loading-spinner');
    const noSpaces = document.getElementById('no-spaces');

    loading.classList.add('hidden');

    if (filteredSpaces.length === 0) {
      grid.classList.add('hidden');
      noSpaces.classList.remove('hidden');
      return;
    }

    noSpaces.classList.add('hidden');
    grid.classList.remove('hidden');

    grid.innerHTML = filteredSpaces.map(space => `
      <div class="group relative overflow-hidden rounded-2xl bg-neutral-900/50 transition-all duration-300 hover:bg-neutral-900/80 hover:scale-105 hover:shadow-2xl flex flex-col h-full">
        
        <!-- Image Carousel -->
        <div class="image-container relative aspect-[4/3] overflow-hidden cursor-pointer">
          <div class="carousel-container" data-space-id="${space.id}">
            ${space.images && space.images.length > 0 ? 
              space.images.map((image, index) => `
                <img src="${image}" alt="${space.name}" 
                     class="carousel-image absolute inset-0 w-full h-full object-cover transition-transform duration-300 group-hover:scale-110 ${index === 0 ? '' : 'hidden'} cursor-pointer"
                     style="object-fit: cover; object-position: center center;"
                     data-images='${JSON.stringify(space.images)}'
                     data-index="${index}"
                     data-space-name="${space.name}"
                     loading="lazy">
              `).join('') : 
              '<div class="w-full h-full bg-neutral-800 flex items-center justify-center"><span class="text-neutral-400">No images</span></div>'
            }
          </div>
          
          ${space.images && space.images.length > 1 ? `
            <div class="absolute inset-0 flex items-center justify-between px-2 opacity-0 group-hover:opacity-100 transition-opacity">
              <button class="carousel-prev bg-black/50 text-white rounded-full p-2 hover:bg-black/70 transition-all duration-200" data-space-id="${space.id}">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                </svg>
              </button>
              <button class="carousel-next bg-black/50 text-white rounded-full p-2 hover:bg-black/70 transition-all duration-200" data-space-id="${space.id}">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              </button>
            </div>
            <div class="absolute bottom-2 left-1/2 transform -translate-x-1/2 flex space-x-1">
              ${space.images.map((_, index) => `
                <div class="carousel-dot w-2 h-2 rounded-full bg-white/50 ${index === 0 ? 'bg-white' : ''}" data-space-id="${space.id}" data-index="${index}"></div>
              `).join('')}
            </div>
          ` : ''}
          

        </div>

        <!-- Content -->
        <div class="p-6 flex flex-col flex-1">
          <div class="flex items-start justify-between mb-3">
            <div class="flex-1">
              <h3 class="text-xl font-bold text-white group-hover:text-yellow-400 transition-colors">
                ${space.name}
              </h3>
              <p class="text-sm text-neutral-400 flex items-center mt-1">
                <svg class="h-4 w-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
                ${space.city}, ${space.country}
              </p>
            </div>
            <button class="vote-btn flex items-center gap-1 px-3 py-1 rounded-full transition-all ${userVotes.has(space.id) ? 'bg-red-600 text-white' : 'bg-neutral-800 text-neutral-400 hover:bg-red-600 hover:text-white'}" data-space-id="${space.id}">
              <svg class="h-4 w-4 ${userVotes.has(space.id) ? 'fill-current' : ''}" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
