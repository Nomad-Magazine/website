}

.carousel-image {
  transition: transform 0.3s ease-in-out, opacity 0.3s ease-in-out;
}

.carousel-dot {
  transition: all 0.3s ease-in-out;
  cursor: pointer;
}

.carousel-dot:hover {
  background-color: rgba(255, 255, 255, 0.8);
}

/* Enhanced hover effects for coworking space cards */
.group:hover .carousel-image {
  transform: scale(1.1);
}

/* Smooth transitions for all interactive elements */
.group {
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.group:hover {
  transform: scale(1.05) translateY(-4px);
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
}

/* Prevent text selection on interactive elements */
.carousel-prev, .carousel-next, .carousel-dot {
  user-select: none;
}

/* Description text hover effects */
.description-text {
  position: relative;
}

.description-text:hover::after {
  content: "Click to read full description";
  position: absolute;
