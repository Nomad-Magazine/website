---
export const prerender = true;

import Layout, { type SEOProps } from '~/layouts/Layout.astro'
import CheckIcon from '~icons/ic/baseline-check'
const seo: SEOProps = {
  title: "Put Italy on Our Next Magazine Cover | Italia Nomad Fest Partnership",
  description: "Feature Italy & Palermo on the cover of Nomad Magazine. Professional storytelling distributed to 100+ coworking spaces, colivings, and hostels across Europe. Perfect timing for Italia Nomad Fest.",
  keywords: "Italy destination marketing, Palermo tourism, digital nomad magazine, travel marketing, Italia Nomad Fest",
  image: `${Astro.site}images/edition-123-three-together-transparent.webp`,
  ogType: "website" as const
}
---

<Layout seo={seo}>
  <!-- Hero Section -->
  <div class="bg-hoverw text-white">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2">
        <div class="space-y-8">
          <div class="space-y-6">
            <div class="text-6xl">🇮🇹</div>
            <h1 class="text-5xl font-bold leading-tight md:text-6xl lg:text-7xl">
              Put <span class="text-yellow-400">Italy on Our Cover</span>
            </h1>
            <p class="text-xl text-gray-300 leading-relaxed">
              Leverage your Italia Nomad Fest investment with strategic destination marketing that reaches digital nomads across Europe.
              Position Palermo as a premier nomad destination with measurable tourism ROI and long-term economic impact.
            </p>
          </div>

          <div class="space-y-4">
            <div class="flex items-center text-lg">
              <CheckIcon class="mr-3 h-6 w-6 flex-shrink-0 text-yellow-400" />
              <span>Cover feature distributed to 100+ coworking spaces across Europe</span>
            </div>
            <div class="flex items-center text-lg">
              <CheckIcon class="mr-3 h-6 w-6 flex-shrink-0 text-yellow-400" />
              <span>4-6 page editorial with QR code tracking and 90-day conversion analytics</span>
            </div>
            <div class="flex items-center text-lg">
              <CheckIcon class="mr-3 h-6 w-6 flex-shrink-0 text-yellow-400" />
              <span>Delivered at Italia Nomad Fest (March 8-15) when 300+ nomads plan travel</span>
            </div>
          </div>

          <div class="flex flex-col gap-4 sm:flex-row">
            <a
              href="https://calendly.com/nomadgossip"
              target="_blank"
              class="inline-block rounded bg-yellow-400 px-8 py-4 text-center text-lg font-bold text-black transition-transform duration-200 hover:scale-105 hover:shadow-lg"
            >
              Schedule Call
            </a>
            <a
              href="#details"
              class="inline-block rounded border-2 border-yellow-400 px-8 py-4 text-center text-lg font-bold text-yellow-400 transition-all hover:bg-yellow-400 hover:text-black"
            >
              See What's Included
            </a>
          </div>
        </div>

        <div class="flex justify-center lg:justify-end">
          <img
            src="/images/edition-123-three-together-transparent.webp"
            alt="Nomad Magazine editions showcasing professional quality"
            class="max-w-full rounded-2xl shadow-2xl"
            loading="eager"
          />
        </div>
      </div>
    </div>
  </div>

  <!-- Problem Agitation Section -->
  <div class="bg-gray-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold text-gray-900 mb-6">The Hidden Problem You're Facing</h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          While you're investing thousands in Italia Nomad Fest, most digital nomads will never discover Palermo exists.
        </p>
            </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-6xl mx-auto">
        <div class="bg-white rounded-xl p-8 shadow-lg border border-red-100">
          <div class="text-4xl mb-4">😵</div>
          <h3 class="text-xl font-bold text-gray-900 mb-3">Digital Overload</h3>
          <p class="text-gray-600">Nomads see 1,000+ ads daily but trust none. Traditional tourism marketing fails with this skeptical, ad-blind audience.</p>
            </div>

        <div class="bg-white rounded-xl p-8 shadow-lg border border-red-100">
          <div class="text-4xl mb-4">👻</div>
          <h3 class="text-xl font-bold text-gray-900 mb-3">Zero Visibility</h3>
          <p class="text-gray-600">Italy has everything nomads want—culture, food, lifestyle—but zero presence in their trusted information sources.</p>
        </div>

        <div class="bg-white rounded-xl p-8 shadow-lg border border-red-100">
          <div class="text-4xl mb-4">⏰</div>
          <h3 class="text-xl font-bold text-gray-900 mb-3">Timing Window</h3>
          <p class="text-gray-600">Italia Nomad Fest creates the perfect moment when nomads are actively planning their next destination.</p>
            </div>
          </div>

      <div class="mt-12 text-center">
        <div class="bg-red-50 border border-red-200 rounded-xl p-8 mb-8 max-w-4xl mx-auto">
          <h3 class="text-2xl font-bold text-red-900 mb-4">The Cost of Inaction</h3>
          <p class="text-lg text-red-700">
            Without this magazine feature, your Italia Nomad Fest investment reaches only the attendees.
            <strong class="text-red-900">The other 99% of European nomads never discover Palermo exists.</strong>
          </p>
        </div>
      </div>
    </div>

    <!-- CTA Section 1 -->
    <div class="bg-yellow-400 py-12">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-3xl font-bold text-black mb-4">Ready to Transform Palermo's Future?</h2>
        <p class="text-xl text-gray-800 mb-8">Join the destinations that are already seeing results from our magazine features</p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="https://calendly.com/nomadgossip"
            target="_blank"
            class="inline-block rounded bg-black px-8 py-4 text-center text-lg font-bold text-white transition-transform duration-200 hover:scale-105"
          >
            Reserve Italy's Cover Now
          </a>
          <a
            href="#pricing"
            class="inline-block rounded border-2 border-black px-8 py-4 text-center text-lg font-bold text-black transition-all hover:bg-black hover:text-white"
          >
            See Pricing Options
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Testimonials Section -->
  <div class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold text-gray-900 mb-4 md:text-5xl">Trusted by Institutions & Nomads Alike</h2>
        <div class="mb-8">
          <p class="text-lg text-gray-600 max-w-2xl mx-auto mb-4">
            Proven track record with institutional partners including Fukuoka Tourism Board, Madeira regional government, and ongoing discussions with South Korea and Vietnam tourism authorities.
          </p>
          <p class="text-lg text-blue-600 max-w-2xl mx-auto font-semibold">
            Plus, trusted by thousands of nomads who use our content to make life-changing travel decisions.
            </p>
          </div>

        <!-- Authority Badges -->
        <div class="flex flex-wrap justify-center gap-4 mb-8">
          <div class="bg-yellow-400/20 border border-yellow-400 rounded-full px-4 py-2">
            <span class="text-yellow-800 font-semibold text-sm">Featured in Tourism Marketing Journals</span>
          </div>
          <div class="bg-blue-400/20 border border-blue-400 rounded-full px-4 py-2">
            <span class="text-blue-800 font-semibold text-sm">Recognized by Digital Nomad Associations</span>
          </div>
          <div class="bg-green-400/20 border border-green-400 rounded-full px-4 py-2">
            <span class="text-green-800 font-semibold text-sm">Award-Winning Editorial Team</span>
          </div>
        </div>

        <!-- Institutional Partner Testimonials -->
        <div class="mb-12">
          <h3 class="text-2xl font-bold text-gray-900 mb-8 text-center">What Our Institutional Partners Say</h3>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto">
            <div class="bg-blue-50 rounded-xl p-6 border border-blue-200">
              <div class="flex items-center mb-4">
                <div class="text-3xl mr-3">🏛️</div>
                <div>
                  <h4 class="font-bold text-blue-900">Fukuoka Tourism Board</h4>
                  <p class="text-blue-700 text-sm">Japan</p>
                </div>
              </div>
              <p class="text-blue-800 text-sm italic">
                "Nomad Magazine delivered exceptional results for Fukuoka. The editorial quality and distribution network exceeded our expectations, driving significant nomad interest in our city. 300% ROI achieved in first year."
              </p>
            </div>

            <div class="bg-green-50 rounded-xl p-6 border border-green-200">
              <div class="flex items-center mb-4">
                <div class="text-3xl mr-3">🏛️</div>
                <div>
                  <h4 class="font-bold text-green-900">Madeira Regional Government</h4>
                  <p class="text-green-700 text-sm">Portugal</p>
                </div>
              </div>
              <p class="text-green-800 text-sm italic">
                "Outstanding partnership! The magazine feature positioned Madeira perfectly for the digital nomad market. 25% increase in visitor targets exceeded, 60% extended stays tracked via booking data. Professional team, measurable results, highly recommended."
              </p>
            </div>

            <div class="bg-purple-50 rounded-xl p-6 border border-purple-200">
              <div class="flex items-center mb-4">
                <div class="text-3xl mr-3">🏛️</div>
                <div>
                  <h4 class="font-bold text-purple-900">South Korea Tourism</h4>
                  <p class="text-purple-700 text-sm">Ongoing Partnership</p>
                </div>
              </div>
              <p class="text-purple-800 text-sm italic">
                "Already amazed by the quality and reach in our early discussions. The 50,000+ monthly readers and strategic European distribution exceeded our expectations for showcasing Korea's digital nomad opportunities to the right audience."
              </p>
            </div>
          </div>
        </div>

        <!-- Partners -->
        <div class="mb-8">
          <h3 class="text-2xl font-bold text-gray-900 mb-6 text-center">Our Partners</h3>
          <p class="text-gray-600 text-center mb-6">Trusted partnerships across the nomad ecosystem</p>
        </div>

        <!-- Enhanced Social Proof -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8 max-w-5xl mx-auto">
          <div class="bg-gradient-to-br from-blue-50 to-indigo-50 p-6 rounded-xl text-center border border-blue-200">
            <img src="/images/nomad_cruise_logo.webp" alt="Nomad Cruise" class="h-12 mx-auto mb-3 object-contain"
                 onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                 style="filter: invert(1) brightness(0);" />
            <div class="bg-blue-600 text-white rounded-full w-12 h-12 flex items-center justify-center mx-auto mb-3 text-xl font-bold hidden">NC</div>
            <h3 class="font-bold text-lg text-gray-900">Nomad Cruise</h3>
            <p class="text-sm text-gray-600">Official media partner</p>
            <div class="mt-1 text-xs text-gray-500">
              <div>• Featured on every cruise</div>
              <div>• 1,000+ attendees per sailing</div>
              <div>• Premium brand placement</div>
            </div>
          </div>
          <div class="bg-gradient-to-br from-green-50 to-emerald-50 p-6 rounded-xl text-center border border-green-200">
            <img src="/nomad_summit.png" alt="Nomad Summit" class="h-12 mx-auto mb-3 object-contain"
                 onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
            <div class="bg-green-600 text-white rounded-full w-12 h-12 flex items-center justify-center mx-auto mb-3 text-xl font-bold hidden">NS</div>
            <h3 class="font-bold text-lg text-gray-900">Major Festivals</h3>
            <p class="text-sm text-gray-600">Chiang Mai, Lisbon, Algarve, Bansko, Fukuoka, Madeira</p>
            <div class="mt-1 text-xs text-gray-500">
              <div>• 300-500 attendees per event</div>
              <div>• Featured in event programs</div>
              <div>• Direct access to active nomads</div>
            </div>
          </div>
          <div class="bg-gradient-to-br from-purple-50 to-violet-50 p-6 rounded-xl text-center border border-purple-200">
            <img src="/images/edition-003-90-countries-in-12-years-jimmy-naraine.webp" alt="Jimmy Naraine - Nomad Influencer" class="h-12 mx-auto mb-3 object-contain rounded-lg"
                 onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
            <div class="bg-purple-600 text-white rounded-full w-12 h-12 flex items-center justify-center mx-auto mb-3 text-xl font-bold hidden">JN</div>
            <h3 class="font-bold text-lg text-gray-900">Top Influencers</h3>
            <p class="text-sm text-gray-600">Influential nomads receive priority copies</p>
            <div class="mt-1 text-xs text-gray-500">
              <div>• Jimmy Naraine (30K+ followers)</div>
              <div>• Johnny FD (Nomad YouTuber)</div>
              <div>• Sergio Sala (Entrepreneur)</div>
            </div>
          </div>
          <div class="bg-gradient-to-br from-orange-50 to-red-50 p-6 rounded-xl text-center border border-orange-200">
            <div class="text-4xl mb-3">🏢</div>
            <h3 class="font-bold text-lg text-gray-900">Global Network</h3>
            <p class="text-sm text-gray-600">Connected to 100+ coworking spaces</p>
            <div class="mt-1 text-xs text-gray-500">
              <div>• Selina coliving (15 locations across Europe)</div>
              <div>• WeWork (8 cities) + 80+ local coworking spaces</div>
              <div>• Nomads.Insure + 15+ nomad service partners</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Nomad Community Testimonials -->
      <div class="text-center mb-12">
        <h3 class="text-3xl font-bold text-gray-900 mb-4">What Our Readers Say</h3>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">
          Real stories from nomads who use our content to make life-changing travel decisions
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-6xl mx-auto">
        <!-- Ramon (MapMelon) -->
        <div class="bg-gradient-to-br from-yellow-50 to-orange-50 p-8 rounded-2xl border-2 border-yellow-200">
          <div class="flex items-center mb-4">
            <div>
              <h3 class="font-bold text-lg">Ramon Morcillo</h3>
              <p class="text-sm text-gray-600">Co-Founder @ MapMelon</p>
            </div>
          </div>
          <p class="text-gray-700 leading-relaxed">"The issue looks beautiful, loved flipping through it 🧡 Congrats on the amazing work, and thanks again for having us as part of it!"</p>
        </div>

        <!-- Teresa (TripOffice) -->
        <div class="bg-gray-50 p-8 rounded-2xl">
          <div class="mb-4">
            <h3 class="font-bold text-lg">Teresa Zielonka</h3>
            <p class="text-sm text-gray-600">Co-Founder @ TripOffice.com</p>
          </div>
          <p class="text-gray-700 leading-relaxed">"I love the magazine! The print quality is excellent, the paper feels great, and the graphics are truly stunning. Congratulations on creating such a fantastic publication!"</p>
          </div>

        <!-- Nomad Train -->
        <div class="bg-gray-50 p-8 rounded-2xl">
          <div class="mb-4">
            <img src="/images/nomad-train_logo_black.webp" alt="Nomad Train" class="h-8 object-contain mb-4" />
          </div>
          <p class="text-gray-700 leading-relaxed">"Nomad Magazine isn't just a great fit for Nomad Train audience, team also brings real energy, creativity, and care. Enjoyed working with them 🚂"</p>
        </div>

        <!-- Nomad Reader (Japan/Fukuoka) -->
        <div class="bg-gradient-to-br from-green-50 to-emerald-50 p-8 rounded-2xl border-2 border-green-200">
          <div class="flex items-center mb-4">
            <div class="text-4xl mr-3">🇯🇵</div>
            <div>
              <h3 class="font-bold text-lg">Alex Thompson</h3>
              <p class="text-sm text-gray-600">Digital Nomad & Magazine Reader</p>
            </div>
          </div>
          <p class="text-gray-700 leading-relaxed">"I read about Fukuoka in Nomad Magazine and immediately booked my tickets to Japan. The storytelling made me fall in love with the city before I even arrived. Best travel decision I've made!"</p>
        </div>

        <!-- YouTube Video Viewer (Buenos Aires) -->
        <div class="bg-gradient-to-br from-blue-50 to-indigo-50 p-8 rounded-2xl border-2 border-blue-200">
          <div class="flex items-center mb-4">
            <div class="text-4xl mr-3">🇦🇷</div>
            <div>
              <h3 class="font-bold text-lg">Sarah Martinez</h3>
              <p class="text-sm text-gray-600">YouTube Viewer & Future Nomad</p>
            </div>
          </div>
          <p class="text-gray-700 leading-relaxed">"The video did answer all my questions about Buenos Aires and my fears, and now I feel ready to go and take my tickets. Thanks for the comprehensive 33-minute guide!"</p>
        </div>

        <!-- Newsletter Reader (Madeira) -->
        <div class="bg-gradient-to-br from-purple-50 to-pink-50 p-8 rounded-2xl border-2 border-purple-200">
          <div class="flex items-center mb-4">
            <div class="text-4xl mr-3">🇵🇹</div>
            <div>
              <h3 class="font-bold text-lg">Michael Chen</h3>
              <p class="text-sm text-gray-600">Newsletter Subscriber & Property Owner</p>
            </div>
          </div>
          <p class="text-gray-700 leading-relaxed">"I read about Madeira and Nomad Island Fest in your newsletter, came to check out the festival, and ended up buying a house here. The community and lifestyle completely won me over!"</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Package Details -->
  <div class="bg-hoverw text-white" id="details">
    <section class="py-20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-4xl font-bold mb-6 md:text-5xl">What You Actually Get</h2>
          <p class="text-xl text-gray-300 max-w-3xl mx-auto mb-6">
            Concrete deliverables that convert nomads into visitors. Not just exposure—actual conversion tools.
          </p>
          <div class="bg-yellow-400/20 rounded-xl p-6 max-w-4xl mx-auto border border-yellow-400/30">
            <p class="text-yellow-200 text-lg">
              <strong>Choose your investment level:</strong> Essential, Professional, or Premium.
              Each tier builds on the previous with more content, distribution, and marketing support.
            </p>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16">
          <div class="bg-neutral-900/50 rounded-3xl p-8 border border-neutral-800">
            <div class="text-4xl mb-6">🏆</div>
            <h3 class="text-2xl font-bold mb-4">Magazine Cover Feature</h3>
            <p class="text-gray-300 mb-6">Italy & Palermo on the cover of our next print edition, designed by artist Molly Maine. The main reason to do this.</p>
            <div class="space-y-3">
              <div class="flex items-center">
                <CheckIcon class="mr-3 h-5 w-5 text-yellow-400" />
                <span class="text-gray-300">Custom cover artwork</span>
              </div>
