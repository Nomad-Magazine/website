<script>
  document.addEventListener('DOMContentLoaded', () => {
    const quizOptions = document.querySelectorAll('.quiz-option');
    const resultDiv = document.getElementById('quiz-result');
    
    quizOptions.forEach(option => {
      option.addEventListener('click', function(this: HTMLElement) {
        const answer = this.getAttribute('data-answer');
        
        // Disable all options
        quizOptions.forEach(opt => {
          const htmlOpt = opt as HTMLElement;
          htmlOpt.classList.remove('cursor-pointer', 'hover:bg-gray-50');
          htmlOpt.style.pointerEvents = 'none';
        });
        
        if (answer === 'correct') {
          this.classList.add('bg-green-100', 'border-green-500');
          this.classList.remove('border-gray-300');
          if (resultDiv) {
            resultDiv.classList.remove('hidden');
            resultDiv.classList.add('bg-green-100', 'border-2', 'border-green-500');
            resultDiv.innerHTML = '<p class="text-green-800 font-bold text-lg mb-2">✅ Correct!</p><p class="text-gray-700">The term was coined in 1997 by Tsugio Makimoto and David Manners in their book "Digital Nomad."</p>';
          }
        } else {
          this.classList.add('bg-red-100', 'border-red-500');
          this.classList.remove('border-gray-300');
          // Highlight correct answer
          quizOptions.forEach(opt => {
            if (opt.getAttribute('data-answer') === 'correct') {
              opt.classList.add('bg-green-100', 'border-green-500');
              opt.classList.remove('border-gray-300');
            }
          });
          if (resultDiv) {
            resultDiv.classList.remove('hidden');
            resultDiv.classList.add('bg-red-100', 'border-2', 'border-red-500');
            resultDiv.innerHTML = '<p class="text-red-800 font-bold text-lg mb-2">❌ Not quite!</p><p class="text-gray-700">The correct answer is B. The term was coined in 1997 by Tsugio Makimoto and David Manners.</p>';
          }
        }
      });
    });
  });
</script>
