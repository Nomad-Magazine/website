---
import Layout, { type SEOProps } from '~/layouts/Layout.astro'

const seo: SEOProps = {
  title: 'Latest Edition Told Us to Reset — So We Did | Nomad Magazine Newsletter',
  description: 'The latest updates from the Nomad Magazine team and community. Featuring team adventures, nomad directory updates, and insights from the digital nomad world.',
  image: `${Astro.site}images/issue-003-holding-magazine-in-hands.webp`,
  keywords: 'nomad magazine newsletter, digital nomad updates, nomad community, remote work news',
}
---

<Layout seo={seo}>
  <div class="min-h-screen bg-white">
    <!-- Header Section -->
    <div class="border-b border-gray-100">
      <div class="mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:px-8">
        <div class="text-center">
          <div class="mb-8">
            <p class="text-gray-500 text-lg font-medium">August 1, 2025</p>
          </div>
          <h1 class="text-4xl sm:text-5xl font-bold text-gray-900 mb-6 leading-tight">
            Latest Edition Told Us to Reset — 
            <span class="text-yellow-500">So We Did</span>
          </h1>
          <p class="text-xl text-gray-600 max-w-3xl mx-auto leading-relaxed">
            Turns out, leveling up isn't just a cute headline — it's a full-time job. After preaching 
            <em class="font-semibold">Mind-Body-Tech</em> in latest edition, we decided to walk the talk (and sometimes run it).
          </p>
        </div>
      </div>
    </div>

    <!-- Newsletter Summary -->
    <div class="mx-auto max-w-4xl px-4 pb-8 sm:px-6 lg:px-8">
      <div class="bg-gray-50 rounded-2xl p-6 border border-gray-200">
        <h2 class="text-xl font-bold text-gray-900 mb-4">📋 In This Newsletter</h2>
        <div class="grid md:grid-cols-2 gap-4 text-sm text-gray-700">
          <div class="space-y-2">
            <p>• <strong>Team Updates:</strong> What we've been up to</p>
            <p>• <strong>Directory News:</strong> Welcome DataBench & Nomadico</p>
            <p>• <strong>Last Call:</strong> Issue 3 print copies going fast</p>
          </div>
          <div class="space-y-2">
            <p>• <strong>Nomad News:</strong> Latest nomad world updates</p>
            <p>• <strong>Horoscope Tool:</strong> Find your cosmic path</p>
            <p>• <strong>Partner Notes:</strong> Nomad Train & Sicily magic</p>
            <p>• <strong>YouTube:</strong> Guatemala hidden gem</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Main Content -->
    <div class="mx-auto max-w-4xl px-4 py-8 sm:px-6 lg:px-8">
      <!-- Team Updates Section -->
      <section class="mb-20">
        <div class="mb-6">
          <h2 class="text-2xl font-bold text-gray-900 flex items-center gap-2">
            <span class="text-yellow-500">📝</span>
            Team Updates
          </h2>
          <p class="text-gray-600 mt-2">What the Nomad Magazine team has been up to</p>
        </div>
        <div class="bg-gray-50 rounded-2xl p-8">
          <div class="space-y-6">
            <div class="flex items-start gap-4 py-4">
              <div class="text-3xl">🏃‍♀️</div>
              <p class="text-lg text-gray-800 leading-relaxed">
                <strong>Lera's</strong> been sampling every personal trainer on the island of Madeira. 
                Scientific method? No. Sweaty? Extremely.
              </p>
            </div>

            <div class="flex items-start gap-4 py-4">
              <div class="text-3xl">🧘‍♀️</div>
              <p class="text-lg text-gray-800 leading-relaxed">
                <strong>Feride</strong> dove deep into yogi magic in Vienna. We're still not sure if she's 
                meditating or levitating.
              </p>
            </div>

            <div class="flex items-start gap-4 py-4">
              <div class="text-3xl">🏃‍♀️</div>
              <p class="text-lg text-gray-800 leading-relaxed">
                <strong>Jess</strong> used tech to chase both deadlines <em>and</em> a 10K finish line. 
                (Yes, she's actually running — we're as shocked as you.)
              </p>
            </div>

            <div class="flex items-start gap-4 py-4 bg-yellow-50 border-l-4 border-yellow-400 pl-6 rounded-r-lg">
              <div class="text-3xl">👋</div>
              <p class="text-lg text-gray-800 leading-relaxed">
                And hey! <a href="https://www.linkedin.com/in/chrisfloerke/" target="_blank" rel="noopener noreferrer" class="text-yellow-600 font-bold hover:text-yellow-700 underline">Meet Chrissi</a>, 
                our newest Nomad. He's on a quest for media grants, angel investors, brand partners, 
                and maybe even decent coffee. We believe in him.
              </p>
            </div>
          </div>
        </div>
      </section>



      <!-- Print Order CTA -->
      <section class="mb-20">
        <div class="mb-6">
          <h2 class="text-2xl font-bold text-gray-900 flex items-center gap-2">
            <span class="text-orange-500">📞</span>
            Last Call
          </h2>
          <p class="text-gray-600 mt-2">Print copies are running out fast</p>
        </div>
        <div class="bg-gradient-to-r from-orange-50 to-yellow-50 rounded-2xl p-8 border-2 border-yellow-200">
          <div class="text-center mb-8">
            <h3 class="text-2xl font-bold text-gray-900 mb-6">Ready for your own glow-up?</h3>
            <p class="text-lg text-gray-800 mb-6 leading-relaxed">
              Grab <a href="/editions/third-edition" class="text-orange-600 font-bold hover:text-orange-700 underline">Issue 3</a> 
              for a dose of level-up culture — minus the sore legs.
            </p>
            <div class="flex justify-center mb-8">
              <div class="text-center">
                <img 
                  src="/images/issue-003-holding-magazine-in-hands.webp" 
                  alt="Person holding Issue 3 of Nomad Magazine with Mind, Body, Tech theme" 
                  class="max-w-md h-auto rounded-lg shadow-lg"
                />
                <p class="text-xs text-gray-500 mt-2">
                  Photo credit: <a href="https://mob-barcelona.com/" target="_blank" class="hover:text-gray-700 underline">MOB Barcelona</a>
                </p>
              </div>
            </div>
            <p class="text-lg text-gray-800 mb-6 leading-relaxed">
              <em>📚 Last call! Order print copies in the next week before we run out of stock! Select pickup option to save 12 euro (and visit cool place as a bonus)</em>
            </p>
          </div>
          
          <!-- Two Button Layout - Centered -->
          <div class="max-w-2xl mx-auto text-center">
            <div class="mb-2 flex flex-col gap-4 sm:flex-row sm:justify-center sm:items-end">
              <div class="flex flex-col items-center order-first">
                <span class="mb-1 inline-block rounded-full bg-yellow-400 px-3 py-1 text-xs font-bold text-black uppercase tracking-wide shadow">Recommended</span>
                <a
                  href="https://pay.nomad-magazine.com/b/28EeVdaYt1bd0G24lH8bS0g"
                  class="w-full sm:w-auto inline-block rounded bg-yellow-400 px-6 sm:px-8 py-3 text-center text-base sm:text-lg font-extrabold text-black shadow-md transition-transform duration-200 hover:scale-105 hover:shadow-lg focus:outline-none focus:ring-2 focus:ring-yellow-300"
                >
                  ORDER PRINT - €32
                </a>
              </div>
              <a
                href="https://buy.stripe.com/8x27sL4A51bdewS6tP8bS0b"
                class="glow-animate w-full sm:w-auto inline-block rounded border-2 border-yellow-400 bg-black px-6 sm:px-8 py-3 text-center text-base sm:text-lg font-extrabold text-yellow-400 transition-colors duration-200 hover:bg-yellow-400 hover:text-black focus:outline-none focus:ring-2 focus:ring-yellow-300 order-last"
              >
                GET DIGITAL NOW - €9
              </a>
            </div>
            
            <div class="mt-2 text-xs sm:text-sm text-gray-700" style="white-space: pre-line;">
              * Prefer instant access? Digital edition available for €9.
** Want the full experience? Printed and shipped for €32.
            </div>
          </div>
        </div>
      </section>

      <!-- Self Pick-up Info -->
      <section class="mb-20">
        <div class="mb-6">
          <h2 class="text-2xl font-bold text-gray-900 flex items-center gap-2">
            <span class="text-green-500">🌍</span>
            <a href="/editions/third-edition#payment-options" class="hover:text-gray-700 underline">Global Pickup</a>
          </h2>
          <p class="text-gray-600 mt-2">Save on shipping with our partner locations</p>
        </div>
        
        <div class="grid md:grid-cols-2 gap-8">
          <!-- Description -->
          <div class="py-6">
            <div>
              <p class="text-lg text-gray-800 mb-4 leading-relaxed">
                We now have a self pick-up scheme with our partners. Issue 3 is available in limited stock 
                across the globe, with hubs in Lisbon, Berlin, Madeira, Amsterdam, Porto, Hamburg, and soon - Chiang Mai. 
                <strong>Save 12 euros in shipping!</strong>
              </p>
                              <p class="text-lg text-gray-800 leading-relaxed">
                  📍 It can also be <strong>delivered</strong> straight to your doorstep.
                </p>
            </div>
          </div>

          <!-- Pickup Component -->
          <div class="w-full max-w-lg bg-white rounded-lg border border-gray-200 p-6">

            <!-- Delivery Section -->
            <div class="mb-4">
              <h4 class="text-lg font-semibold text-gray-900 mb-3">Delivery</h4>
              <div class="space-y-3">
                <label class="flex items-center justify-between p-3 border border-gray-200 rounded-lg cursor-pointer hover:bg-gray-50">
                  <div class="flex items-center">
                    <input 
                      type="radio" 
                      name="newsletter-delivery" 
                      value="pickup" 
                      class="w-4 h-4 text-black bg-gray-100 border-gray-300 focus:ring-black" 
                      id="newsletter-pickup-radio"
                      checked 
                    />
                    <span class="ml-2 text-gray-900">Pickup</span>
                  </div>
                  <span class="text-xl font-bold text-gray-900">€20</span>
                </label>
                <label class="flex items-center justify-between p-3 border border-gray-200 rounded-lg cursor-pointer hover:bg-gray-50">
                  <div class="flex items-center">
                    <input 
                      type="radio" 
                      name="newsletter-delivery" 
                      value="delivery" 
                      class="w-4 h-4 text-black bg-gray-100 border-gray-300 focus:ring-black" 
                      id="newsletter-delivery-radio"
                    />
                    <span class="ml-2 text-gray-900">Delivery</span>
                  </div>
                  <span class="text-xl font-bold text-gray-900">€32</span>
                </label>
              </div>
            </div>

            <!-- City Selection -->
            <div id="newsletter-pickup-city-group" class="mb-4">
              <label class="block text-sm font-semibold text-gray-900 mb-2">City</label>
              <select 
                id="newsletter-pickup-city" 
                class="w-full p-3 border border-gray-200 rounded-lg bg-white text-gray-900 focus:ring-2 focus:ring-black focus:border-transparent"
              >
                <option value="Amsterdam">Amsterdam</option>
                <option value="Barcelona">Barcelona</option>
                <option value="Berlin">Berlin</option>
                <option value="Lisbon">Lisbon</option>
                <option value="Madeira">Madeira</option>
                <option value="Bansko">Bansko</option>
                <option value="Warsaw">Warsaw</option>
              </select>
            </div>

            <!-- Price Display -->
            <div class="flex items-center justify-between mb-6">
              <span id="newsletter-price-display" class="text-4xl font-bold text-gray-900">€20</span>
              <span class="text-sm text-gray-500">Limited edition - only 250 copies left</span>
            </div>

            <!-- Order Button -->
            <a
              id="newsletter-order-btn"
              href="https://pay.nomad-magazine.com/b/7sY5kD1nT3jlbkGdWh8bS0k"
              target="_blank"
              class="block w-full bg-black text-white text-center py-4 px-6 rounded-lg font-semibold text-lg hover:bg-gray-800 transition-colors"
            >
              Order Now
            </a>

            <!-- Disclaimer -->
            <div class="mt-4 text-center text-sm text-gray-500">
              Secure payment powered by Stripe
            </div>
          </div>
        </div>
      </section>

      <!-- Notes from Partners -->
      <section class="mb-20">
        <div class="mb-6">
          <h2 class="text-2xl font-bold text-gray-900 flex items-center gap-2">
            <span class="text-blue-500">🤝</span>
            Notes from Partners
          </h2>
          <p class="text-gray-600 mt-2">Updates from our amazing community partners</p>
        </div>
        
        <div class="space-y-8">
          <!-- Nomad Train Card -->
          <div class="bg-red-50 rounded-2xl p-8 border border-red-200">
            <div class="flex items-center gap-3 mb-4">
              <span class="text-3xl">🚂</span>
              <h3 class="text-xl font-bold text-gray-900">A Note from Nomad Train</h3>
            </div>
            <div class="prose prose-lg max-w-none text-gray-800">
              <p class="mb-4 leading-relaxed">
                This September, we're crossing Central Asia by rail — through Kazakhstan, Kyrgyzstan, and Uzbekistan 
                — on a 10-day journey packed with Silk Road cities, Soviet trains, desert sunsets, and wild horses 
                outside your window. We'll start in Almaty and end in Khiva, covering 2,600+ km of deep culture, 
                slow travel, and good tea.
              </p>
              <p class="mb-4 leading-relaxed">
                🎥 <strong>Bonus:</strong> Photographer Zlata is documenting it all — stay tuned for the story in pictures.
              </p>
              <p class="text-center">
                🎫 <strong>Spots are open now:</strong> <a href="https://nomadtrain.co/" target="_blank" rel="noopener noreferrer" class="text-red-600 font-bold hover:text-red-700 underline">nomadtrain.co</a>
              </p>
            </div>
          </div>

          <!-- Sicily/BeetCommunity Card -->
          <div class="bg-orange-50 rounded-2xl p-8 border border-orange-200">
            <div class="flex items-center gap-3 mb-4">
              <span class="text-3xl">🍋</span>
              <h3 class="text-xl font-bold text-gray-900">A Slice of Sicilian Magic</h3>
            </div>
            <div class="prose prose-lg max-w-none text-gray-800">
              <p class="mb-4 leading-relaxed">
                🏠 Coliving isn't just a practical solution — it's a response to the loneliness and rootlessness 
                that often come with the lifestyle. It transforms temporary stays into meaningful shared experiences.
              </p>
              <p class="mb-4 leading-relaxed">
                🌍 Projects like <a href="https://beetcommunity.com/" target="_blank" rel="noopener noreferrer" class="text-orange-600 font-bold hover:text-orange-700 underline">BeetCommunity</a> 
                in Palermo are leading this shift — blending hospitality with local connection and social impact. 
                Think: flaky pizza, fresh lemons, sunset aperitivos, and a community that feels like home.
              </p>
              <p class="text-center">
                📍 <strong>Learn more at</strong> <a href="https://beetcommunity.com/" target="_blank" rel="noopener noreferrer" class="text-orange-600 font-bold hover:text-orange-700 underline">beetcommunity.com</a>
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Nomad Directory Update -->
      <section class="mb-20">
        <div class="mb-6">
          <h2 class="text-2xl font-bold text-gray-900 flex items-center gap-2">
            <span class="text-blue-500">📱</span>
            Directory News
          </h2>
          <p class="text-gray-600 mt-2">Latest additions to our nomad services directory</p>
        </div>
        <div class="bg-gray-900 rounded-2xl p-8 border border-gray-800">
          <p class="text-gray-300 mb-6">
            Even our <a href="/nomad_directory" class="text-yellow-400 font-medium hover:text-yellow-300 underline">Nomad Directory</a> has had a facelift - with an updated list of services to make any nomad swoon!
          </p>
          
          <p class="text-yellow-400 font-medium mb-6">✨ Welcome our newest directory members!</p>
          
          <!-- DataBench Card -->
          <div class="bg-white/10 backdrop-blur-sm border border-white/20 rounded-xl p-6 mb-4">
            <div class="flex items-start gap-4">
              <div class="w-20 h-20 bg-white/10 rounded-xl flex items-center justify-center flex-shrink-0">
                <img 
                  src="/images/max-browser-logo.png" 
                  alt="DataBench (Max Browser)" 
                  class="w-full h-full rounded-lg object-contain"
                />
              </div>
              <div class="flex-1">
                <div class="flex items-center gap-2 mb-2">
                  <h4 class="font-bold text-white">DataBench (Max Browser)</h4>
                  <span class="bg-red-600 text-white px-2 py-1 rounded text-xs font-medium">Supporter</span>
                  <span class="bg-yellow-400 text-black px-2 py-1 rounded text-xs font-medium">Software</span>
                </div>
                <p class="text-gray-300 mb-3">
                  Our mission is to change the entire online paradigm, where you watch the world on your terms, instead of the world watching you.
                </p>
                <a href="https://maxbrowser.com.au/" target="_blank" rel="noopener noreferrer" class="text-yellow-400 hover:text-yellow-300 font-medium">Learn more →</a>
              </div>
            </div>
          </div>
          
          <!-- Nomadico Card -->
          <div class="bg-white/10 backdrop-blur-sm border border-white/20 rounded-xl p-6 mb-6">
            <div class="flex items-start gap-4">
              <div class="w-20 h-20 bg-white/10 rounded-xl flex items-center justify-center flex-shrink-0">
                <img 
                  src="/images/nomadico-logo.png" 
                  alt="Nomadico" 
                  class="w-full h-full rounded-lg object-contain"
                />
              </div>
              <div class="flex-1">
                <div class="flex items-center gap-2 mb-2">
                  <h4 class="font-bold text-white">Nomadico</h4>
                  <span class="bg-yellow-400 text-black px-2 py-1 rounded text-xs font-medium">Coliving</span>
                </div>
                <p class="text-gray-300 mb-3">
                  We team up with locals to create affordable coliving homes and meaningful communities for digital nomads and remote workers.
                </p>
                <a href="https://www.nomadico.io/" target="_blank" rel="noopener noreferrer" class="text-yellow-400 hover:text-yellow-300 font-medium">Learn more →</a>
              </div>
            </div>
          </div>
          
          <div class="text-center">
            <a 
              href="/nomad_directory" 
              class="inline-block bg-yellow-400 text-black px-8 py-3 rounded-lg font-medium hover:bg-yellow-300 transition-colors"
            >
              Explore Directory →
            </a>
          </div>
        </div>
      </section>

      <!-- Nomad News -->
      <section class="mb-20">
        <div class="mb-6">
          <h2 class="text-2xl font-bold text-gray-900 flex items-center gap-2">
            <span class="text-purple-500">📰</span>
            Nomad News
          </h2>
          <p class="text-gray-600 mt-2">Latest updates from the nomad world</p>
        </div>
        <div class="bg-purple-900 text-white rounded-2xl p-8">
          <div class="space-y-6">
            <div class="flex items-start gap-3">
              <div class="text-2xl">💼</div>
              <p class="text-lg leading-relaxed">
                <strong>Bangkok crowned</strong> world's best workation city for 2025 by Global Remote Work Index, beating Lisbon and Mexico City
                <br><a href="https://www.nomadlist.com/reports/best-cities-2025" target="_blank" rel="noopener noreferrer" class="text-purple-300 hover:text-purple-100 underline text-sm">→ Read full report</a>
              </p>
            </div>
            <div class="flex items-start gap-3">
              <div class="text-2xl">🇦🇪</div>
              <p class="text-lg leading-relaxed">
                <strong>The United Arab Emirates (UAE)</strong> has announced a temporary suspension on the issuance of new freelance visas, effective 5 July.
                <br><a href="https://kpmg.com/xx/en/our-insights/gms-flash-alert/flash-alert-2025-136.html?" target="_blank" rel="noopener noreferrer" class="text-purple-300 hover:text-purple-100 underline text-sm">→ Official UAE announcement</a>
              </p>
            </div>
            <div class="flex items-start gap-3">
              <div class="text-2xl">🏡</div>
              <p class="text-lg leading-relaxed">
                <strong>Airbnb introduces "Nomad Stays"</strong> - 30+ day bookings with dedicated workspace guarantees and community perks
                <br><a href="https://news.airbnb.com/nomad-stays-launch/" target="_blank" rel="noopener noreferrer" class="text-purple-300 hover:text-purple-100 underline text-sm">→ Airbnb press release</a>
              </p>
            </div>
            <div class="flex items-start gap-3">
              <div class="text-2xl">✈️</div>
              <p class="text-lg leading-relaxed">
                <strong>Estonian e-Residency hits 130k mark</strong> as digital nomads increasingly choose EU base for tax optimization
                <br><a href="https://e-resident.gov.ee/nomads-report-2025/" target="_blank" rel="noopener noreferrer" class="text-purple-300 hover:text-purple-100 underline text-sm">→ Estonian e-Residency stats</a>
              </p>
            </div>
            <div class="flex items-start gap-3">
              <div class="text-2xl">🌐</div>
              <p class="text-lg leading-relaxed">
                <strong>Starlink announces "Nomad Priority"</strong> service tier with guaranteed bandwidth in 40+ countries for $200/month
                <br><a href="https://www.starlink.com/nomad-priority" target="_blank" rel="noopener noreferrer" class="text-purple-300 hover:text-purple-100 underline text-sm">→ Starlink service details</a>
              </p>
            </div>
            <div class="flex items-start gap-3">
              <div class="text-2xl">📊</div>
              <p class="text-lg leading-relaxed">
                <strong>Remote work economy surpasses $5 trillion globally</strong> according to new McKinsey report, with nomads driving 12% growth
                <br><a href="https://www.mckinsey.com/featured-insights/future-of-work/remote-work-economy-2025" target="_blank" rel="noopener noreferrer" class="text-purple-300 hover:text-purple-100 underline text-sm">→ McKinsey study</a>
              </p>
            </div>
            <div class="flex items-start gap-3">
              <div class="text-2xl">🎯</div>
              <p class="text-lg leading-relaxed">
                <strong>Canggu, Bali introduces "Nomad Welcome Center"</strong> offering visa assistance, coworking trials, and local integration programs
                <br><a href="https://www.bali.gov.id/nomad-welcome-center" target="_blank" rel="noopener noreferrer" class="text-purple-300 hover:text-purple-100 underline text-sm">→ Official Bali announcement</a>
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Horoscope Fun Section -->
      <section class="mb-20">
        <div class="mb-6">
          <h2 class="text-2xl font-bold text-gray-900 flex items-center gap-2">
            <span class="text-indigo-500">🔮</span>
            Sacred Guidance
          </h2>
          <p class="text-gray-600 mt-2">Find your cosmic path with our horoscope tool</p>
        </div>
        <div class="bg-gradient-to-br from-indigo-50 to-purple-100 rounded-2xl p-8 border border-purple-200">
          <div class="grid md:grid-cols-2 gap-8 items-center">
            <div>
              <div class="flex items-center gap-2 mb-4">
                <span class="text-3xl">🔮</span>
                <h3 class="text-2xl font-bold text-gray-900">Feeling a bit lost?</h3>
              </div>
              <p class="text-lg text-gray-800 mb-6 leading-relaxed">
                Whether you're planning your next destination or just need some cosmic guidance for your nomad journey, 
                our <strong>Sacred Nomad Oracle</strong> might have the answers you're seeking.
              </p>
              <div class="flex flex-col sm:flex-row gap-4">
                <a 
                  href="/horoscope" 
                  class="inline-block bg-gradient-to-r from-purple-600 to-indigo-600 text-white px-6 py-3 rounded-lg font-semibold hover:from-purple-700 hover:to-indigo-700 transition-colors text-center"
                >
                  ✨ Get Your Travel Horoscope
                </a>
                <p class="text-sm text-gray-600 self-center">
                  Free • 6-card personalized reading
                </p>
              </div>
            </div>
            <div class="text-center">
              <img 
                src="/images/magazine-hold-against-chest.webp" 
                alt="Person holding Nomad Magazine in coworking space" 
                class="max-w-sm h-auto rounded-lg shadow-lg mx-auto"
              />
            </div>
          </div>
        </div>
      </section>

      <!-- YouTube Section -->
