    { citySlug: 'lisbon',       countrySlug: 'portugal',    type: 'city', label: 'Lisbon',       country: 'Portugal'    },
    { citySlug: 'berlin',       countrySlug: 'germany',     type: 'city', label: 'Berlin',       country: 'Germany'     },
    { citySlug: 'porto',        countrySlug: 'portugal',    type: 'city', label: 'Porto',        country: 'Portugal'    },
    { citySlug: 'sofia',        countrySlug: 'bulgaria',    type: 'city', label: 'Sofia',        country: 'Bulgaria'    },
    { citySlug: 'hamburg',      countrySlug: 'germany',     type: 'city', label: 'Hamburg',      country: 'Germany'     },
    { citySlug: 'athens',       countrySlug: 'greece',      type: 'city', label: 'Athens',       country: 'Greece'      },
    { citySlug: 'budapest',     countrySlug: 'hungary',     type: 'city', label: 'Budapest',     country: 'Hungary'     },
    { citySlug: 'amsterdam',    countrySlug: 'netherlands', type: 'city', label: 'Amsterdam',    country: 'Netherlands' },
    { citySlug: 'madeira',      countrySlug: 'portugal',    type: 'city', label: 'Madeira',      country: 'Portugal',   altLabels: ['Madeira Island'] },
    { citySlug: 'las-palmas',   countrySlug: 'spain',       type: 'city', label: 'Las Palmas',   country: 'Spain'       },
    { citySlug: 'vienna',       countrySlug: 'austria',     type: 'city', label: 'Vienna',       country: 'Austria'     },
    { citySlug: 'brussels',     countrySlug: 'belgium',     type: 'city', label: 'Brussels',     country: 'Belgium'     },
    { citySlug: 'bansko',       countrySlug: 'bulgaria',    type: 'city', label: 'Bansko',       country: 'Bulgaria'    },
    { citySlug: 'zagreb',       countrySlug: 'croatia',     type: 'city', label: 'Zagreb',       country: 'Croatia'     },
    { citySlug: 'dublin',       countrySlug: 'ireland',     type: 'city', label: 'Dublin',       country: 'Ireland'     },
    { citySlug: 'cork',         countrySlug: 'ireland',     type: 'city', label: 'Cork',         country: 'Ireland'     },
    { citySlug: 'malta',        countrySlug: 'malta',       type: 'city', label: 'Malta',        country: 'Malta',      altLabels: ['Valletta'] },
    { citySlug: 'warsaw',       countrySlug: 'poland',      type: 'city', label: 'Warsaw',       country: 'Poland'      },
    { citySlug: 'trnava',       countrySlug: 'slovakia',    type: 'city', label: 'Trnava',       country: 'Slovakia'    },
    { citySlug: 'ljubljana',    countrySlug: 'slovenia',    type: 'city', label: 'Ljubljana',    country: 'Slovenia'    },
    { citySlug: 'maribor',      countrySlug: 'slovenia',    type: 'city', label: 'Maribor',      country: 'Slovenia'    },
    { citySlug: 'albufeira',    countrySlug: 'portugal',    type: 'city', label: 'Albufeira',    country: 'Portugal'    },
    { citySlug: 'portimao',     countrySlug: 'portugal',    type: 'city', label: 'Portimão',     country: 'Portugal'    },
    { citySlug: 'calle-hermosa',countrySlug: 'costa-rica',  type: 'city', label: 'Calle Hermosa',country: 'Costa Rica'  },
  ]

  const COUNTRY_ALIASES: Record<string, string> = {
    NL: 'Netherlands', 'The Netherlands': 'Netherlands',
    Slovenija: 'Slovenia', UK: 'United Kingdom', Bali: 'Indonesia',
    Brussels: 'Belgium',
  }

  const normalizeCountry = (raw: string): string => COUNTRY_ALIASES[raw] || raw

  const extractCity = (location: string): string => {
    if (!location) return ''
    return location.includes(',') ? location.split(',')[0].trim() : location.trim()
  }

  const extractCountry = (location: string): string => {
    if (!location) return ''
    const parts = location.split(',')
    if (parts.length >= 2) return normalizeCountry(parts[parts.length - 1].trim())
    return normalizeCountry(location.trim())
  }

  const stripHtml = (input: string): string =>
    input
      .replace(/<br\s*\/?>/gi, '\n').replace(/<\/p>/gi, '\n\n').replace(/<[^>]+>/g, ' ')
      .replace(/&nbsp;/g, ' ').replace(/&amp;/g, '&').replace(/\s+\n/g, '\n')
      .replace(/\n{3,}/g, '\n\n').replace(/[ \t]{2,}/g, ' ').trim()

  const normalizeUrl = (raw: unknown): string | null => {
    const value = Array.isArray(raw) ? raw[0] : raw
    if (!value || typeof value !== 'string') return null
    const trimmed = value.trim()
    if (!trimmed) return null
    if (/^https?:\/\//i.test(trimmed)) return trimmed.replace(/^http:\/\//i, 'https://')
    if (trimmed.startsWith('www.')) return `https://${trimmed}`
    return null
  }

  const uniqStrings = (values: unknown[]): string[] =>
    [...new Set(values.filter((value): value is string => typeof value === 'string' && value.trim().length > 0))]

  const { records = [] } = await fetchReportRecords('68614a111208586bd05d3c3a')
  const allSpaces: Space[] = records
    .filter((record: any) => {
      if (!record.s43a4b2808 || !record.title) return false
      const category = (record.sb685ab800?.label || '').toLowerCase()
      return category.includes('cowork') || category === 'space' || category === 'hub'
    })
    .map((record: any) => {
      const location = record.sed1a49986 || ''
      const shortDescription = stripHtml(record.scea90e502 || '')
      const fullDescription = stripHtml(record.description_markdown || record.scea90e502 || '')
      return {
        id: record.id,
        name: record.title,
        city: extractCity(location),
        country: extractCountry(location),
        location,
        shortDescription,
        fullDescription,
        websiteUrl: normalizeUrl(record.sb788c266b),
        googleMapsUrl: normalizeUrl(record.s2d652f699),
        images: uniqStrings([record.image, record.images, record.sf4ad525dd, record.s4ad525dd].filter(Boolean).flat()),
      }
    })
    .sort((a, b) => {
      if (b.images.length !== a.images.length) return b.images.length - a.images.length
      return a.name.localeCompare(b.name)
    })

  return targetPages.map((target) => {
    const cityNames = [target.label, ...(target.altLabels || [])].map(l => l.toLowerCase())
    const items = allSpaces.filter((space) =>
      target.type === 'city'
        ? cityNames.includes(space.city.toLowerCase())
        : space.country.toLowerCase() === target.label.toLowerCase()
    )
    return {
      params: { country: target.countrySlug, city: target.citySlug },
      props: { target, items },
    }
  })
}

const { target, items } = Astro.props as { target: PageTarget; items: Space[] }

const content = CITY_CONTENT[target.citySlug]
const introText = content.intro.replace('{count}', String(items.length))
const metaDesc  = content.metaDescription.replace('{count}', String(items.length))

const titleLocation = target.label
const title       = `${items.length} Best Coworking Spaces in ${titleLocation} | Nomad Magazine`
const canonicalUrl = `${Astro.site}where-to-work/${target.countrySlug}/${target.citySlug}/`

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: content.faqs.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
}

const seo: SEOProps = {
  title,
  description: metaDesc,
  canonical: canonicalUrl,
  image: `${Astro.site}images/distribution-list-sowo-office-reference.webp`,
  keywords: `best coworking spaces in ${titleLocation.toLowerCase()}, coworking ${titleLocation.toLowerCase()}, where to work in ${titleLocation.toLowerCase()}, digital nomad ${titleLocation.toLowerCase()}, coworking spaces ${target.country.toLowerCase()}`,
  ogType: 'website',
  ldJSON: {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    description: metaDesc,
    url: canonicalUrl,
    publisher: { '@type': 'Organization', name: 'Nomad Magazine', logo: { '@type': 'ImageObject', url: `${Astro.site}logo.svg` } },
    breadcrumb: {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Where To Work', item: `${Astro.site}where-to-work/` },
        { '@type': 'ListItem', position: 2, name: target.country, item: `${Astro.site}where-to-work/${target.countrySlug}/` },
        { '@type': 'ListItem', position: 3, name: `Best Coworking Spaces in ${titleLocation}`, item: canonicalUrl },
      ],
    },
  },
}
