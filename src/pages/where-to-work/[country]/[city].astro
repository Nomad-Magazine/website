                      )}
                    </div>
                    <div class="p-6 md:p-7">
                      <div class="flex flex-wrap items-start justify-between gap-3">
                        <div>
                          <p class="text-sm text-yellow-500">{space.location}</p>
                          <h3 class="mt-1 text-2xl font-bold text-neutral-900">{space.name}</h3>
                        </div>
                        <span class="rounded-full border border-blue-400/30 bg-blue-500/10 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-blue-400">Coworking</span>
                      </div>
                      {space.shortDescription && (
                        <p class="mt-5 text-base leading-7 text-neutral-700">{space.shortDescription}</p>
                      )}
                      <div class="mt-6 flex flex-wrap gap-3">
                        {space.websiteUrl && (
                          <a href={space.websiteUrl} target="_blank" rel="noopener noreferrer"
                            aria-label={`${space.name} website (opens in new tab)`}
                            class="inline-flex items-center rounded-lg border border-yellow-400 bg-yellow-400/10 px-4 py-2 text-sm font-semibold text-yellow-600 transition-colors hover:bg-yellow-400 hover:text-black">
                            Visit Website
                          </a>
                        )}
                        {space.googleMapsUrl && (
                          <a href={space.googleMapsUrl} target="_blank" rel="noopener noreferrer"
                            aria-label={`Directions to ${space.name} (opens in new tab)`}
                            class="inline-flex items-center rounded-lg border border-neutral-300 bg-white px-4 py-2 text-sm font-semibold text-neutral-900 transition-colors hover:bg-neutral-100">
                            Open Map
                          </a>
                        )}
                      </div>
                    </div>
                  </div>
                </article>
              )
            })}
          </div>
        </div>
      </div>
    </section>

    <ImageModal />

    {/* ── FAQ ────────────────────────────────────────────────────────────────── */}
    <section class="border-t border-neutral-200 bg-white py-16">
      <div class="container mx-auto px-4">
        <div class="mx-auto max-w-3xl">
          <h2 class="mb-8 text-2xl font-bold text-neutral-900">Frequently asked questions</h2>
          <dl class="space-y-6">
            {content.faqs.map(({ q, a }) => (
              <div class="rounded-2xl border border-neutral-200 px-6 py-5">
                <dt class="font-semibold text-neutral-900">{q}</dt>
                <dd class="mt-2 text-sm leading-7 text-neutral-600">{a}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </section>
  </div>
</Layout>

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<script is:inline>
  // ── Carousels ────────────────────────────────────────────────────────────────
  document.querySelectorAll('[data-carousel]').forEach((root) => {
    const track = root.querySelector('[data-track]');
    const dots  = root.querySelectorAll('[data-dot]');
    const total = Number(root.dataset.count);
    if (!track || total < 2) return;

    let current = 0;

    function goTo(index) {
      current = (index + total) % total;
      track.style.transform = `translateX(-${current * 100}%)`;
      dots.forEach((d, i) => {
        d.classList.toggle('w-4',   i === current);
        d.classList.toggle('bg-white', i === current);
        d.classList.toggle('w-1.5', i !== current);
        d.classList.toggle('bg-white/50', i !== current);
      });
    }

    root.querySelector('.carousel-prev')?.addEventListener('click', (e) => {
      e.stopPropagation();
      goTo(current - 1);
    });
    root.querySelector('.carousel-next')?.addEventListener('click', (e) => {
      e.stopPropagation();
      goTo(current + 1);
    });

    // touch/swipe
    let startX = 0;
    root.addEventListener('touchstart', (e) => { startX = e.touches[0].clientX; }, { passive: true });
    root.addEventListener('touchend',   (e) => {
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 40) goTo(current + (dx < 0 ? 1 : -1));
    });
  });

  // ── Gallery lightbox ─────────────────────────────────────────────────────────
  document.querySelectorAll('[data-open-gallery]').forEach((button) => {
    button.addEventListener('click', () => {
      const images = JSON.parse(button.getAttribute('data-images') || '[]');
      const name   = button.getAttribute('data-name') || 'Workspace';
      const index  = Number(button.getAttribute('data-index') || 0);
      if (window.openImageModal && images.length > 0) {
        window.openImageModal(name, images, index);
      }
    });
  });

  // ── Read-more toggles — kept for future use ─────────────────────────────────
</script>
