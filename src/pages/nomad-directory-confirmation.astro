---
export const prerender = true;

import Layout, { type SEOProps } from '~/layouts/Layout.astro'
import MaterialSymbolsCheck from '~icons/material-symbols/check'
import MaterialSymbolsArrowOutward from '~icons/material-symbols/arrow-outward'
import MaterialSymbolsSchedule from '~icons/material-symbols/schedule'
import MaterialSymbolsPrint from '~icons/material-symbols/print'

const seo: SEOProps = {
  title: 'Submission Successful - Nomad Directory',
  description: 'Your listing has been successfully submitted to the Nomad Directory. Upgrade your listing to boost visibility.',
  image: `${Astro.site}images/edition-003-cover_holded_front_face.webp`,
  keywords: 'nomad directory submission, digital nomad listing confirmation',
  ogType: 'website',
}
---

<Layout seo={seo}>
  <!-- Confirmation Hero Section -->
  <div class="bg-hoverw text-white">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
      <div class="text-center">
        <div class="mx-auto mb-8 flex h-20 w-20 items-center justify-center rounded-full bg-green-500">
          <MaterialSymbolsCheck class="h-10 w-10 text-white" />
        </div>
        <h1 class="text-5xl font-bold leading-tight md:text-6xl lg:text-7xl">
          🎉 <span class="text-yellow-400">Submission</span> Successful!
        </h1>
        <p class="mt-6 text-xl text-gray-300 leading-relaxed max-w-3xl mx-auto">
          Your listing has been successfully submitted to the Nomad Directory. We release 3-5 new directories weekly. Follow our <a href="https://www.instagram.com/nomadmagazinecom" target="_blank" class="text-yellow-400 hover:text-yellow-300 underline font-semibold">Instagram</a> for announcements.
        </p>
      </div>
    </div>
  </div>

  <!-- What Happens Next -->
  <div class="bg-white py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-gray-900 mb-6">What Happens Next?</h2>
      </div>
      
      <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
        <div class="text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-yellow-400">
            <MaterialSymbolsSchedule class="h-6 w-6 text-black" />
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-2">Weekly Releases</h3>
          <p class="text-gray-600">We release 3-5 new directories every week to keep our community updated with fresh listings and quality nomad resources.</p>
        </div>
        
        <div class="text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-yellow-400">
            <span class="text-lg font-bold text-black">📸</span>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-2">Instagram Announcements</h3>
          <p class="text-gray-600">Follow our <a href="https://www.instagram.com/nomadmagazinecom" target="_blank" class="text-yellow-600 hover:text-yellow-700 font-semibold">Instagram</a> to see when new listings go live and get featured in our community updates.</p>
        </div>
        
        <div class="text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-yellow-400">
            <span class="text-lg font-bold text-black">✓</span>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-2">Publication Timeline</h3>
          <p class="text-gray-600">Your listing will be included in one of our upcoming weekly releases. If there are delays beyond two weeks, we'll reach out personally.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Print Edition Inclusion with Dec 10 Deadline -->
  <div class="bg-white py-16 border-t border-gray-100">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-4xl font-bold text-gray-900 mb-6">Your Company in Print</h2>
        <p class="text-xl text-gray-600 max-w-4xl mx-auto mb-4">
          If you signed up before December 10th, your company will be automatically included in our upcoming print magazine edition at no extra cost! 
        </p>
        <p class="text-lg text-gray-600 max-w-4xl mx-auto mb-6">
          To help certain brands stand out, we're offering highlighted placements inside the directory: 4 Small highlighted spots, and 5 Large. Send email to lera@nomadgossip.com with "Yes — small" or "Yes — large" Deadline December 15 2025
        </p>
        <p class="text-center mb-8">
          <a href="/nomad-directory-highlight-options" class="text-yellow-600 hover:text-yellow-700 font-semibold underline">
            Learn More →
          </a>
        </p>
      </div>
      
      <!-- Print Directory Preview -->
      <div class="max-w-6xl mx-auto mb-12">
        <a 
          href="/nomad-directory-highlight-options"
          class="block bg-gray-50 rounded-2xl p-8 hover:bg-gray-100 transition-all duration-200 hover:shadow-lg cursor-pointer"
        >
          <div class="text-center">
            <img 
              src="/images/NGM-04_NomadDirectory_Proposal_Page_1.webp" 
              alt="Nomad Directory Print Preview" 
              class="w-full h-auto rounded-xl shadow-lg mb-6"
              loading="lazy"
            />
            <p class="text-lg text-gray-600">Preview of the Nomad Directory in print</p>
          </div>
        </a>
      </div>

      <!-- Highlight Options CTA -->
      <div class="text-center bg-gradient-to-r from-yellow-50 to-orange-50 rounded-2xl p-8 max-w-3xl mx-auto">
        <h3 class="text-2xl font-bold text-gray-900 mb-4">Want Even More Visibility?</h3>
        <p class="text-gray-600 mb-6">
          While your basic listing is included for free, you can upgrade to highlight options for premium positioning and increased visibility.
        </p>
        <a 
          href="/nomad-directory-highlight-options"
          class="inline-flex items-center gap-2 bg-yellow-500 hover:bg-yellow-600 text-white px-8 py-4 rounded-lg font-bold text-lg transition-all duration-200 hover:scale-105"
        >
          <MaterialSymbolsPrint class="h-5 w-5" />
          View Highlight Options
          <MaterialSymbolsArrowOutward class="h-4 w-4" />
        </a>
        <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm text-gray-600">
          <div class="flex items-center justify-center gap-2">
            <span class="font-semibold text-blue-600">Small Format:</span> €75
          </div>
          <div class="flex items-center justify-center gap-2">
            <span class="font-semibold text-yellow-600">Large Format:</span> €100
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Upgrade Transition -->
  <div class="bg-gray-50 py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <h2 class="text-4xl font-bold text-gray-900 mb-6">Want to Boost Your Visibility?</h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto mb-8">
          While your basic listing is being processed, you can upgrade to reach our engaged community of digital nomads across multiple channels.
        </p>
        <div class="inline-flex items-center gap-2 bg-yellow-100 text-yellow-800 px-4 py-2 rounded-full text-sm font-medium">
          <span>⚡</span>
          Upgrades go live immediately after approval
        </div>
      </div>
    </div>
  </div>

  <!-- Upgrade Options -->
  <div class="bg-gray-50 pb-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 gap-8 lg:grid-cols-2">
        
        <!-- Support -->
        <div class="bg-white rounded-lg p-8 shadow-lg h-full flex flex-col">
          <div class="text-center flex-grow">
            <h3 class="text-2xl font-bold text-gray-900 mb-4">Support Us</h3>
            <div class="text-4xl font-bold text-gray-900 mb-6">€10<span class="text-sm text-gray-500">/month</span></div>
            <p class="text-gray-600 mb-8">Get your listing featured on top of the directory page</p>
            
            <div class="space-y-3 mb-8 text-left">
              <div class="flex items-center">
                <MaterialSymbolsCheck class="mr-3 h-5 w-5 flex-shrink-0 text-yellow-400" />
                <span class="text-gray-700">♥ Supporter badge on listing</span>
              </div>
              <div class="flex items-center">
                <MaterialSymbolsCheck class="mr-3 h-5 w-5 flex-shrink-0 text-yellow-400" />
                <span class="text-gray-700">Listing on top of the page</span>
              </div>
              <div class="flex items-center">
                <MaterialSymbolsCheck class="mr-3 h-5 w-5 flex-shrink-0 text-yellow-400" />
                <span class="text-gray-700">Support indie media</span>
              </div>
              <div class="flex items-center">
                <MaterialSymbolsCheck class="mr-3 h-5 w-5 flex-shrink-0 text-yellow-400" />
                <span class="text-gray-700">Good karma ✨</span>
              </div>
            </div>
          </div>
          
          <a 
            href="https://pay.nomad-magazine.com/b/fZubJ17Mh7zBbkG9G18bS0c" 
            target="_blank"
            class="w-full inline-block rounded bg-yellow-400 px-8 py-4 text-center text-lg font-bold text-black transition-transform duration-200 hover:scale-105 hover:shadow-lg mt-auto"
          >
            Become Supporter
          </a>
        </div>


        <!-- Digital + Print -->
        <div class="bg-white rounded-lg p-8 shadow-lg border-2 border-yellow-400 relative h-full flex flex-col">
          <div class="absolute -top-4 left-1/2 transform -translate-x-1/2">
            <span class="bg-yellow-400 text-black px-4 py-2 rounded-full text-sm font-bold">BEST VALUE</span>
          </div>
          
          <div class="text-center flex-grow">
            <h3 class="text-2xl font-bold text-gray-900 mb-4">Digital + Print</h3>
            <div class="text-4xl font-bold text-gray-900 mb-6">€350+</div>
            <p class="text-gray-600 mb-8">Full digital package plus brand placement in our next magazine edition</p>
            
            <div class="space-y-3 mb-8 text-left">
              <div class="flex items-center">
                <MaterialSymbolsCheck class="mr-3 h-5 w-5 flex-shrink-0 text-yellow-400" />
                <span class="text-gray-700">Brand placement in next magazine edition</span>
              </div>
              <div class="flex items-center">
                <MaterialSymbolsCheck class="mr-3 h-5 w-5 flex-shrink-0 text-yellow-400" />
                <span class="text-gray-700">Reach thousands of nomads globally</span>
              </div>
              <div class="flex items-center">
                <MaterialSymbolsCheck class="mr-3 h-5 w-5 flex-shrink-0 text-yellow-400" />
                <span class="text-gray-700">Print + digital distribution</span>
              </div>
            </div>
          </div>
          
          <a 
            href="/brand-placement-next-edition-847291"
            class="w-full inline-block rounded bg-yellow-400 px-8 py-4 text-center text-lg font-bold text-black transition-transform duration-200 hover:scale-105 hover:shadow-lg mt-auto"
          >
            Get Digital + Print
          </a>
        </div>

      </div>

      <!-- Office Hours Invitation -->
      <div class="mt-16 bg-gradient-to-br from-yellow-50 to-orange-50 rounded-2xl p-8 text-center">
        <div class="max-w-2xl mx-auto">
          <div class="flex items-center justify-center gap-3 mb-4">
            <div class="text-3xl">💬</div>
            <h3 class="text-2xl font-bold text-gray-900">Join Our Office Hours</h3>
          </div>
          <p class="text-lg text-gray-700 mb-6">
            Want to share your news and announcements with our audience? Join our weekly Office Hours calls where you can say out loud your announcements to then be featured in IG or just to connect with Nomad Magazine team. 
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a
              href="/office-hours"
              class="inline-flex items-center gap-2 bg-yellow-400 text-black px-6 py-3 rounded-lg font-bold hover:bg-yellow-300 transition-all hover:scale-105"
            >
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 002 2v12a2 2 0 002 2z"/>
              </svg>
              Learn About Office Hours
            </a>
            <a
              href="https://calendly.com/nomadgossip"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 border border-yellow-400 text-yellow-600 px-6 py-3 rounded-lg font-bold hover:bg-yellow-400 hover:text-black transition-all"
            >
              Book Your Spot
            </a>
          </div>
        </div>
      </div>

      <!-- Trust Builder -->
      <div class="mt-16 text-center">
        <p class="text-gray-600 max-w-2xl mx-auto">
          While our community is growing, it's highly engaged and consists of quality digital nomads, remote workers, and location-independent entrepreneurs actively looking for tools and services.
        </p>
      </div>
    </div>
  </div>

  <!-- No Thanks Section -->
  <div class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <div class="bg-gray-50 rounded-lg p-8 max-w-2xl mx-auto">
          <h3 class="text-2xl font-bold text-gray-900 mb-4">No upgrade needed?</h3>
          <p class="text-gray-600 mb-6">That's perfectly fine! Your basic listing will be live soon and you'll receive an email confirmation.</p>
          <a 
            href="/nomad_directory" 
            class="inline-flex items-center gap-2 bg-gray-200 hover:bg-gray-300 text-gray-900 font-bold px-6 py-3 rounded transition-colors duration-200"
          >
            View Directory
            <MaterialSymbolsArrowOutward width="18" height="18" />
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout> 