---
export const prerender = true;

import Layout, { type SEOProps } from '~/layouts/Layout.astro'
import MaterialSymbolsCheck from '~icons/material-symbols/check'
import MaterialSymbolsArrowOutward from '~icons/material-symbols/arrow-outward'
import MaterialSymbolsSchedule from '~icons/material-symbols/schedule'

const seo: SEOProps = {
  title: 'Submission Successful - Nomad Directory',
  description: 'Your listing has been successfully submitted to the Nomad Directory. Upgrade your listing to boost visibility.',
  image: `${Astro.site}images/edition-003-cover_holded_front_face.webp`,
  keywords: 'nomad directory submission, digital nomad listing confirmation',
  ogType: 'website',
}
---

<Layout seo={seo}>
  <!-- Confirmation Hero Section -->
  <div class="bg-hoverw text-white">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
      <div class="text-center">
        <div class="mx-auto mb-8 flex h-20 w-20 items-center justify-center rounded-full bg-green-500">
          <MaterialSymbolsCheck class="h-10 w-10 text-white" />
        </div>
        <h1 class="text-5xl font-bold leading-tight md:text-6xl lg:text-7xl">
          🎉 <span class="text-yellow-400">Submission</span> Successful!
        </h1>
        <p class="mt-6 text-xl text-gray-300 leading-relaxed max-w-3xl mx-auto">
          Your listing has been successfully submitted to the Nomad Directory and will be reviewed within 48 hours.
        </p>
      </div>
    </div>
  </div>

  <!-- What Happens Next -->
  <div class="bg-white py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-gray-900 mb-6">What Happens Next?</h2>
      </div>
      
      <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
        <div class="text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-yellow-400">
            <MaterialSymbolsSchedule class="h-6 w-6 text-black" />
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-2">Review Process</h3>
          <p class="text-gray-600">We'll review your submission within 48 hours to ensure quality and accuracy.</p>
        </div>
        
        <div class="text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-yellow-400">
            <span class="text-lg font-bold text-black">✓</span>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-2">Publication</h3>
          <p class="text-gray-600">Once approved, your listing will go live on the Nomad Directory.</p>
        </div>
        
        <div class="text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-yellow-400">
            <span class="text-lg font-bold text-black">📧</span>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-2">Notification</h3>
          <p class="text-gray-600">You'll receive an email confirmation when your listing is published.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Upgrade Transition -->
  <div class="bg-gray-50 py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <h2 class="text-4xl font-bold text-gray-900 mb-6">Want to Boost Your Visibility?</h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto mb-8">
          While your basic listing is being processed, you can upgrade to reach our engaged community of digital nomads across multiple channels.
        </p>
        <div class="inline-flex items-center gap-2 bg-yellow-100 text-yellow-800 px-4 py-2 rounded-full text-sm font-medium">
          <span>⚡</span>
          Upgrades go live immediately after approval
        </div>
      </div>
    </div>
  </div>

  <!-- Upgrade Options -->
  <div class="bg-gray-50 pb-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 gap-8 lg:grid-cols-3">
        
        <!-- Homepage Feature -->
        <div class="bg-white rounded-lg p-8 shadow-lg h-full flex flex-col">
          <div class="text-center flex-grow">
            <h3 class="text-2xl font-bold text-gray-900 mb-4">Homepage Feature</h3>
            <div class="text-4xl font-bold text-gray-900 mb-6">€50</div>
            <p class="text-gray-600 mb-8">Spotlight on top of the directory homepage for 1 month</p>
            
            <div class="space-y-3 mb-8 text-left">
              <div class="flex items-center">
                <MaterialSymbolsCheck class="mr-3 h-5 w-5 flex-shrink-0 text-yellow-400" />
                <span class="text-gray-700">2.6K+ monthly website visitors</span>
              </div>
              <div class="flex items-center">
                <MaterialSymbolsCheck class="mr-3 h-5 w-5 flex-shrink-0 text-yellow-400" />
                <span class="text-gray-700">Top position visibility</span>
              </div>
              <div class="flex items-center">
                <MaterialSymbolsCheck class="mr-3 h-5 w-5 flex-shrink-0 text-yellow-400" />
                <span class="text-gray-700">One-time payment for full month</span>
              </div>
            </div>
          </div>
          
          <a 
            href="https://pay.nomad-magazine.com/b/cNi6oH3w18DF0G25pL8bS0t" 
            target="_blank"
            class="w-full inline-block rounded bg-yellow-400 px-8 py-4 text-center text-lg font-bold text-black transition-transform duration-200 hover:scale-105 hover:shadow-lg mt-auto"
          >
            Get Featured
          </a>
        </div>

        <!-- Featured Profile -->
        <div class="bg-white rounded-lg p-8 shadow-lg h-full flex flex-col">
          
          <div class="text-center flex-grow">
            <h3 class="text-2xl font-bold text-gray-900 mb-4">Featured Profile</h3>
            <div class="text-4xl font-bold text-gray-900 mb-6">€99</div>
            <p class="text-gray-600 mb-8">Get a dedicated company page and newsletter feature</p>
            
            <div class="space-y-3 mb-8 text-left">
              <div class="flex items-center">
                <MaterialSymbolsCheck class="mr-3 h-5 w-5 flex-shrink-0 text-yellow-400" />
                <span class="text-gray-700">Company feature page (based on your info & photos)</span>
              </div>
              <div class="flex items-center">
                <MaterialSymbolsCheck class="mr-3 h-5 w-5 flex-shrink-0 text-yellow-400" />
                <span class="text-gray-700">Backlinks to your site</span>
              </div>
              <div class="flex items-center">
                <MaterialSymbolsCheck class="mr-3 h-5 w-5 flex-shrink-0 text-yellow-400" />
                <span class="text-gray-700">Newsletter feature (500+ subscribers)</span>
              </div>
                          </div>
          </div>
          
          <a 
            href="https://pay.nomad-magazine.com/b/9B6dR9c2x7zB4Wi4lH8bS0u" 
            target="_blank"
            class="w-full inline-block rounded bg-yellow-400 px-8 py-4 text-center text-lg font-bold text-black transition-transform duration-200 hover:scale-105 hover:shadow-lg mt-auto"
          >
            Get Featured Profile
          </a>
        </div>

        <!-- Content Package -->
        <div class="bg-white rounded-lg p-8 shadow-lg border-2 border-yellow-400 relative h-full flex flex-col">
          <div class="absolute -top-4 left-1/2 transform -translate-x-1/2">
            <span class="bg-yellow-400 text-black px-4 py-2 rounded-full text-sm font-bold">BEST VALUE</span>
          </div>
          
          <div class="text-center flex-grow">
            <h3 class="text-2xl font-bold text-gray-900 mb-4">Content Package</h3>
            <div class="text-4xl font-bold text-gray-900 mb-6">€250</div>
            <p class="text-gray-600 mb-8">Full storytelling with blog feature and promotion</p>
            
            <div class="space-y-3 mb-8 text-left">
              <div class="flex items-center">
                <MaterialSymbolsCheck class="mr-3 h-5 w-5 flex-shrink-0 text-yellow-400" />
                <span class="text-gray-700">Founder interview or company feature page</span>
              </div>
              <div class="flex items-center">
                <MaterialSymbolsCheck class="mr-3 h-5 w-5 flex-shrink-0 text-yellow-400" />
                <span class="text-gray-700">Newsletter inclusion</span>
              </div>
              <div class="flex items-center">
                <MaterialSymbolsCheck class="mr-3 h-5 w-5 flex-shrink-0 text-yellow-400" />
                <span class="text-gray-700">Backlinks to your site</span>
              </div>
              <div class="flex items-center">
                <MaterialSymbolsCheck class="mr-3 h-5 w-5 flex-shrink-0 text-yellow-400" />
                <span class="text-gray-700">Social media promotion</span>
              </div>
            </div>
          </div>
          
          <a 
            href="https://pay.nomad-magazine.com/b/bJe00j4A55rtagC05r8bS0v" 
            target="_blank"
            class="w-full inline-block rounded bg-yellow-400 px-8 py-4 text-center text-lg font-bold text-black transition-transform duration-200 hover:scale-105 hover:shadow-lg mt-auto"
          >
            Get Full Package
          </a>
        </div>

      </div>

      <!-- Supporter Option (Less Prominent) -->
      <div class="mt-12 max-w-md mx-auto">
        <div class="bg-white rounded-lg p-6 shadow-lg border border-gray-200">
          <div class="text-center">
            <h3 class="text-xl font-bold text-gray-900 mb-3">Or just support us</h3>
            <div class="text-2xl font-bold text-gray-900 mb-2">€10<span class="text-sm text-gray-500">/month</span></div>
            <p class="text-gray-600 mb-6 text-sm">Support our indie magazine with just the essentials</p>
            
            <div class="space-y-2 mb-6 text-left">
              <div class="flex items-center">
                <MaterialSymbolsCheck class="mr-2 h-4 w-4 flex-shrink-0 text-yellow-400" />
                <span class="text-gray-700 text-sm">♥ Supporter badge on listing</span>
              </div>
              <div class="flex items-center">
                <MaterialSymbolsCheck class="mr-2 h-4 w-4 flex-shrink-0 text-yellow-400" />
                <span class="text-gray-700 text-sm">Support indie media</span>
              </div>
              <div class="flex items-center">
                <MaterialSymbolsCheck class="mr-2 h-4 w-4 flex-shrink-0 text-yellow-400" />
                <span class="text-gray-700 text-sm">Good karma ✨</span>
              </div>
            </div>
            
            <a 
              href="https://pay.nomad-magazine.com/b/fZubJ17Mh7zBbkG9G18bS0c" 
              target="_blank"
              class="w-full inline-block rounded bg-gray-200 hover:bg-gray-300 px-6 py-3 text-center font-bold text-gray-900 transition-colors duration-200"
            >
              Become Supporter
            </a>
          </div>
        </div>
      </div>

      <!-- Trust Builder -->
      <div class="mt-16 text-center">
        <p class="text-gray-600 max-w-2xl mx-auto">
          While our community is growing, it's highly engaged and consists of quality digital nomads, remote workers, and location-independent entrepreneurs actively looking for tools and services.
        </p>
      </div>
    </div>
  </div>

  <!-- No Thanks Section -->
  <div class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <div class="bg-gray-50 rounded-lg p-8 max-w-2xl mx-auto">
          <h3 class="text-2xl font-bold text-gray-900 mb-4">No upgrade needed?</h3>
          <p class="text-gray-600 mb-6">That's perfectly fine! Your basic listing will be live soon and you'll receive an email confirmation.</p>
          <a 
            href="/nomad_directory" 
            class="inline-flex items-center gap-2 bg-gray-200 hover:bg-gray-300 text-gray-900 font-bold px-6 py-3 rounded transition-colors duration-200"
          >
            View Directory
            <MaterialSymbolsArrowOutward width="18" height="18" />
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout> 