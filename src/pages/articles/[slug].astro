---
import { getCollection } from 'astro:content'
import ArticlePostPage from '~/components/ArticlePostPage.astro'
import { normalizeContentEntries } from '~/utils/content'

const slug = Astro.params.slug
const allPosts = normalizeContentEntries(await getCollection('article'))
const post = allPosts.find((entry) => entry.slug === slug)

if (!post) {
  throw new Error(`Article post not found for slug: ${slug}`)
}
---

<ArticlePostPage post={post} allPosts={allPosts} />
