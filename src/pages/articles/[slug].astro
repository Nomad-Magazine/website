---
import { getCollection, render } from 'astro:content'
import Layout, { type SEOProps } from '~/layouts/Layout.astro'
import SidebarMagazineDirectory from '~/components/SidebarMagazineDirectory.astro'
import { createBlogPostingSchema } from '~/utils/schema'
import type { CollectionEntry } from 'astro:content'
import { normalizeContentEntries, type LegacyCollectionEntry } from '~/utils/content'

export const prerender = true

export async function getStaticPaths() {
  const posts = normalizeContentEntries(await getCollection('article'))
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: post,
  }))
}

const post = Astro.props as LegacyCollectionEntry<CollectionEntry<'article'>>
const { Content } = await render(post)

const allPosts = normalizeContentEntries(await getCollection('article'))
const currentPostTags = post.data.tag ? post.data.tag.split(',').map((t) => t.trim()) : []

// Find posts with at least one common tag
let relatedPosts = allPosts
  .filter((p) => {
    if (p.slug === post.slug || !p.data.tag || !currentPostTags.length) return false
    const otherPostTags = p.data.tag.split(',').map((t) => t.trim())
    return otherPostTags.some((tag) => currentPostTags.includes(tag))
  })
  .sort((a, b) => (b.data.pubDate || new Date(0)).valueOf() - (a.data.pubDate || new Date(0)).valueOf())

// If we need more posts, get the latest ones (that are not already included)
if (relatedPosts.length < 3) {
  const latestPosts = allPosts
    .filter((p) => p.slug !== post.slug && !relatedPosts.find((rp) => rp.slug === p.slug))
    .sort((a, b) => (b.data.pubDate || new Date(0)).valueOf() - (a.data.pubDate || new Date(0)).valueOf())
  const needed = 9 - relatedPosts.length
  relatedPosts.push(...latestPosts.slice(0, needed))
}

// Ensure we only have 3 posts
const finalRelatedPosts = relatedPosts.slice(0, 3)

// SEO configuration for article
const socialImage = post.data.heroImage
  ? (post.data.heroImage.startsWith('http') ? post.data.heroImage : `${Astro.site}${post.data.heroImage.startsWith('/') ? post.data.heroImage.slice(1) : post.data.heroImage}`)
  : `${Astro.site}images/edition-003-cover_holded_front_face.webp`

// Enhanced SEO with word count for better ranking signals
const wordCount = post.body ? post.body.split(/\s+/).length : 0

const seo: SEOProps = {
  title: post.data.title,
  description: post.data.description,
  image: socialImage,
  keywords: post.data.keywords || 'digital nomad, remote work, travel, nomad lifestyle',
  ogType: 'article',
  publishedTime: post.data.pubDate?.toISOString(),
  modifiedTime: post.data.updatedDate?.toISOString(),
  section: 'Digital Nomad Lifestyle',
  tags: currentPostTags,
  author: post.data.author || 'Nomad Magazine',
  ldJSON: createBlogPostingSchema({
    headline: post.data.title,
    description: post.data.description,
    image: socialImage,
    url: `${Astro.site}articles/${post.slug}/`,
    datePublished: post.data.pubDate?.toISOString(),
    dateModified: post.data.updatedDate?.toISOString(),
    author: {
      name: post.data.author || 'Nomad Magazine',
      url: post.data.authorUrl || 'https://nomad-magazine.com/',
    },
    articleSection: 'Digital Nomad Lifestyle',
    keywords: post.data.keywords || 'digital nomad, remote work, travel, nomad lifestyle',
    wordCount,
  }),
}
---

<Layout seo={seo}>
  <main>
    {
      post.data.heroImage ? (
        <section class="relative h-[560px]">
          <img src={post.data.heroImage} alt={post.data.heroImageAlt || post.data.title} class="absolute inset-0 h-full w-full object-cover" />
          <div class="absolute inset-0 bg-black/50" />
          <div class="relative mx-auto flex h-full max-w-4xl flex-col items-center justify-center px-8 text-center text-white">
            <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">{post.data.title}</h1>
            <div class="mt-4 flex flex-col items-center gap-2">
              {post.data.author && (
                <div class="text-lg">
                  {post.data.authorUrl ? (
                    <span>by <a href={post.data.authorUrl} target="_blank" rel="noopener noreferrer" aria-label={`Visit ${post.data.author}'s profile (opens in new tab)`} class="underline hover:text-yellow-400 transition-colors">{post.data.author}</a></span>
                  ) : (
                    <span>by {post.data.author}</span>
                  )}
                </div>
              )}
              {post.data.pubDate && (
                <time datetime={post.data.pubDate.toISOString()} class="text-base text-gray-300">
                  {post.data.pubDate.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                  })}
                </time>
              )}
            </div>
          </div>
        </section>
      ) : (
        <div class="mx-auto max-w-2xl px-8 pt-16 text-center">
          <h1 class="text-4xl font-semibold tracking-tight text-white sm:text-5xl">{post.data.title}</h1>
        </div>
      )
    }

    <div class="relative px-4 py-16">
      <div class="mx-auto flex max-w-7xl gap-12">
        <!-- Left Sidebar - More Menu -->
        <aside class="hidden lg:block lg:w-48" aria-label="Site navigation sidebar">
          <nav class="sticky top-8 space-y-6 text-sm" aria-label="Related content navigation">

            <!-- Content Section -->
            <div>
              <div class="mb-2 text-xs font-bold uppercase tracking-wider text-gray-500">Content</div>
              <div class="space-y-1">
                <a href="/newsletter/" class="block rounded px-2 py-1.5 text-gray-600 transition-colors hover:bg-gray-100 hover:text-gray-900">Newsletter</a>
                <a href="/editions/" class="block rounded px-2 py-1.5 text-gray-600 transition-colors hover:bg-gray-100 hover:text-gray-900">Magazine Editions</a>
                <a href="/digital-nomad-wiki/" class="block rounded px-2 py-1.5 text-gray-600 transition-colors hover:bg-gray-100 hover:text-gray-900">Digital Nomad Wiki</a>
                <a href="/articles/" class="block rounded px-2 py-1.5 text-gray-600 transition-colors hover:bg-gray-100 hover:text-gray-900">Articles</a>
              </div>
            </div>

            <!-- Partners Section -->
            <div>
              <div class="mb-2 text-xs font-bold uppercase tracking-wider text-gray-500">Partners</div>
              <div class="space-y-1">
                <a href="/brand-placement-next-edition-847291/" class="block rounded px-2 py-1.5 text-gray-600 transition-colors hover:bg-gray-100 hover:text-gray-900">Brand Placement</a>
                <a href="/nomad_directory/" class="block rounded px-2 py-1.5 text-gray-600 transition-colors hover:bg-gray-100 hover:text-gray-900">Nomad Directory</a>
                <a href="/writers/" class="block rounded px-2 py-1.5 text-gray-600 transition-colors hover:bg-gray-100 hover:text-gray-900">For Writers</a>
                <a href="/distribution-list/" class="block rounded px-2 py-1.5 text-gray-600 transition-colors hover:bg-gray-100 hover:text-gray-900">Distribution List</a>
              </div>
            </div>

            <!-- Support Section -->
            <div>
              <div class="mb-2 text-xs font-bold uppercase tracking-wider text-gray-500">Support</div>
              <div class="space-y-1">
                <a href="/our-story/" class="block rounded px-2 py-1.5 text-gray-600 transition-colors hover:bg-gray-100 hover:text-gray-900">Our Story</a>
                <a href="/support-the-magazine/" class="block rounded px-2 py-1.5 text-gray-600 transition-colors hover:bg-gray-100 hover:text-gray-900">Support Magazine</a>
                <a href="/add-testimonials/" class="block rounded px-2 py-1.5 text-gray-600 transition-colors hover:bg-gray-100 hover:text-gray-900">Submit Review</a>
              </div>
            </div>
          </nav>
        </aside>

        <!-- Main Content -->
        <div class="mx-auto w-full max-w-3xl flex-1">
          <article class="prose prose-lg mx-auto max-w-none prose-headings:text-gray-900 prose-p:text-gray-900 prose-a:text-blue-600 prose-strong:text-gray-900 prose-li:text-gray-900 prose-em:text-gray-700" itemscope itemtype="https://schema.org/Article">
            <meta itemprop="headline" content={post.data.title} />
            <meta itemprop="description" content={post.data.description} />
            {post.data.heroImage && <meta itemprop="image" content={socialImage} />}
            {post.data.pubDate && <meta itemprop="datePublished" content={post.data.pubDate.toISOString()} />}
            {post.data.updatedDate && <meta itemprop="dateModified" content={post.data.updatedDate.toISOString()} />}
            <meta itemprop="author" content={post.data.author || 'Nomad Magazine'} />
            <div itemprop="publisher" itemscope itemtype="https://schema.org/Organization">
              <meta itemprop="name" content="Nomad Magazine" />
              <link itemprop="url" href="https://nomad-magazine.com/" />
            </div>
            <Content />
          </article>

          {
            finalRelatedPosts.length > 0 && (
              <section class="mt-16 border-t border-gray-200 pt-12" aria-labelledby="related-articles-heading">
                <h2 id="related-articles-heading" class="text-2xl font-semibold text-gray-900">Related Articles</h2>
                <div class="mt-6 grid gap-6 sm:grid-cols-3">
                  {finalRelatedPosts.map((relatedPost) => (
                    <a href={`/articles/${relatedPost.slug}/`} class="group block rounded-lg border border-gray-200 p-4 transition-all hover:border-gray-400 hover:bg-gray-50" aria-label={`Read article: ${relatedPost.data.title}`}>
                      <h3 class="text-base font-semibold leading-tight text-gray-900 group-hover:text-yellow-600">
                        {relatedPost.data.title}
                      </h3>
                      {relatedPost.data.description && (
                        <p class="mt-2 line-clamp-2 text-sm text-gray-600">
                          {relatedPost.data.description}
                        </p>
                      )}
                    </a>
                  ))}
                </div>
              </section>
            )
          }

          <!-- Magazine & Directory CTAs at bottom -->
          <div class="mt-16 grid gap-6 border-t border-gray-200 pt-12 sm:grid-cols-2">
            <SidebarMagazineDirectory />
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>
