---
import Image from '~/components/Image.astro'
import CheckIcon from '~icons/ic/baseline-check'
import Layout, { type SEOProps } from '~/layouts/Layout.astro'
import SubscribeInput from '~/components/SubscribeInput.astro'

const seo: SEOProps = {
  title: 'Nomad Newsletter - Subscribe to Digital Nomad Updates',
  description:
    'Join the Nomad Newsletter for exclusive articles, tips, and stories from the global digital nomad community. Stay updated with the latest trends in remote work and nomadic living.',
  image: `${Astro.site}images/hands_pointing-left.webp`,
  keywords: 'nomad newsletter, digital nomad updates, remote work newsletter, nomad community, travel tips',
  ogType: 'website',
  ldJSON: {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Nomad Newsletter',
    description: 'Subscribe to the Nomad Newsletter for exclusive digital nomad content',
    url: `${Astro.site}newsletter`,
    publisher: {
      '@type': 'Organization',
      name: 'Nomad Magazine',
      logo: {
        '@type': 'ImageObject',
        url: `${Astro.site}logo.svg`,
      },
    },
  },
}

// Recent newsletters data
const recentNewsletters = [
  {
    title: 'Finally, Mobile Reading That Feels Right',
    date: 'October 29, 2025',
    description: 'Experience Nomad Magazine on ZINIO - a premium digital reading platform available on web, iOS, Android, and desktop with offline reading and interactive features.',
    slug: 'newsletter-digital-reading',
    image: '/images/Newsletter-Covers.jpg'
  },
  {
    title: 'InterNations: Connect with Fellow Expats Worldwide',
    date: 'October 14, 2025',
    description: 'Starting fresh abroad? Don\'t do it alone. Join InterNations, the largest community for people who live and work abroad.',
    slug: 'newsletter-internations',
    image: '/images/internations-newsletter.webp'
  },
  {
    title: 'Coworking Design Contest',
    date: 'September 11, 2025',
    description: 'Help us find the most beautifully designed coworking spaces serving remote workers and digital nomads every day.',
    slug: 'newsletter-coworking-design-contest',
    image: '/images/vote-for-coworking.webp'
  },
  {
    title: 'Latest Edition Told Us to Reset — So We Did',
    date: 'August 1, 2025',
    description: 'Team adventures, nomad directory updates, and insights from the digital nomad world.',
    slug: 'newsletter-august-1-2025',
    image: '/images/issue-003-holding-magazine-in-hands.webp'
  },
  {
    title: 'Confession Time: 3rd Edition Confessions',
    date: 'May 22, 2025',
    description: 'Digital-first approach for the next edition, Mind-Body-Tech theme, and honest confessions about nomad life.',
    slug: 'newsletter-3rd-edition-confessions',
    image: '/images/edition-003-cover.webp'
  }
]
---

<Layout seo={seo}>
  <main class="mx-auto max-w-7xl px-4 py-8 sm:px-6 sm:py-12 lg:px-8">
    <div class="grid grid-cols-1 items-start gap-8 lg:grid-cols-2 lg:gap-16">
      <div class="space-y-6 sm:space-y-8">
        <div class="space-y-4 sm:space-y-6">
          <p class="font-justme text-2xl text-gray-800 sm:text-3xl">Nomad Newsletter</p>
          <h1 class="text-3xl leading-tight font-extrabold tracking-tighter text-gray-900 sm:text-4xl lg:text-5xl xl:text-6xl">
            Remote Work, Nomadic Trends, Events, Industry Updates and More
          </h1>
          <div class="space-y-3 text-base text-gray-700 sm:text-lg">
            <p class="flex items-start sm:items-center">
              <CheckIcon class="mt-0.5 mr-2 h-5 w-5 flex-shrink-0 text-black sm:mt-0 sm:h-6 sm:w-6" />
              <span>Exclusive articles on remote work trends</span>
            </p>
            <p class="flex items-start sm:items-center">
              <CheckIcon class="mt-0.5 mr-2 h-5 w-5 flex-shrink-0 text-black sm:mt-0 sm:h-6 sm:w-6" />
              <span>Inspiring stories from nomads around the world</span>
            </p>
            <p class="flex items-start sm:items-center">
              <CheckIcon class="mt-0.5 mr-2 h-5 w-5 flex-shrink-0 text-black sm:mt-0 sm:h-6 sm:w-6" />
              <span>Updates on trends shaping the future of work and living</span>
            </p>
          </div>
        </div>
        <SubscribeInput tag="newsletter" />
      </div>
      <div class="order-first lg:order-last">
        <Image />
      </div>
    </div>

    <!-- Recent Newsletters Section -->
    <section class="mt-20 sm:mt-28">
      <div class="mb-8">
        <h2 class="text-2xl font-bold text-gray-900 sm:text-3xl">Recent Newsletters</h2>
        <p class="mt-2 text-gray-600">Catch up on our latest updates and stories</p>
      </div>
      
      <div class="space-y-4">
        {recentNewsletters.map((newsletter) => (
          <a href={`/${newsletter.slug}`} class="block">
            <article class="group overflow-hidden rounded-lg border border-gray-200 bg-white shadow-sm transition-all duration-200 hover:border-gray-300 hover:shadow-md cursor-pointer">
              <div class="flex gap-4 p-4">
                <div class="flex-shrink-0">
                  <img
                    src={newsletter.image}
                    alt={newsletter.title}
                    class="h-32 w-24 rounded-md object-cover"
                  />
                </div>
                <div class="flex-1 min-w-0">
                  <div>
                    <time class="text-xs font-medium text-gray-500">{newsletter.date}</time>
                    <h3 class="mt-1 text-lg font-semibold text-gray-900 group-hover:text-gray-700 transition-colors line-clamp-2">
                      {newsletter.title}
                    </h3>
                    <p class="mt-2 text-sm text-gray-600 line-clamp-2">
                      {newsletter.description}
                    </p>
                    <div class="mt-3">
                      <span class="inline-flex items-center gap-1 text-xs font-medium text-gray-900 group-hover:text-gray-700">
                        Read newsletter
                        <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                        </svg>
                      </span>
                    </div>
                  </div>
                </div>
              </div>
            </article>
          </a>
        ))}
      </div>
      
      <div class="mt-8 text-center">
        <p class="text-gray-600">More newsletters coming soon! Subscribe above to never miss an update.</p>
      </div>
    </section>
  </main>
</Layout>
