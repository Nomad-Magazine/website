---
export const prerender = true;

import Layout, { type SEOProps } from '~/layouts/Layout.astro';

const seo: SEOProps = {
  title: 'Thank You for Your Order! | Nomad Magazine',
  description: 'Thank you for ordering a print edition of Nomad Magazine. Your order has been confirmed and will ship within the next few days.',
  noIndex: true,
};
---

<Layout seo={seo}>
  <div class="min-h-screen bg-gradient-to-b from-gray-50 to-white flex items-center justify-center px-4 py-12">
    <div class="max-w-3xl w-full">
      <!-- Main Thank You Card -->
      <div class="bg-white rounded-2xl shadow-2xl p-8 sm:p-12 border border-gray-100">
        <div class="text-center">
          <!-- Success Icon -->
          <div class="inline-block bg-gradient-to-br from-yellow-400 to-yellow-500 rounded-full p-6 mb-6 shadow-lg">
            <svg class="w-16 h-16 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
            </svg>
          </div>
          
          <!-- Main Heading -->
          <h1 class="text-4xl sm:text-5xl font-bold text-gray-900 mb-4">
            Thank You! 🎉
          </h1>
          
          <!-- Appreciation Message -->
          <p class="text-xl sm:text-2xl text-gray-800 font-semibold mb-3">
            <a href="/support-the-magazine/" class="hover:text-yellow-600 transition-colors">We truly appreciate your support!</a>
          </p>
          
          <!-- Shipping Info -->
          <div class="bg-yellow-50 border-2 border-yellow-200 rounded-xl p-6 mb-8 mt-6">
            <div class="flex items-start justify-center gap-3 mb-3">
              <span class="text-3xl" aria-hidden="true">📦</span>
              <div class="text-left">
                <p class="text-lg font-bold text-gray-900 mb-2">
                  Your magazine will ship within the next few days
                </p>
                <p class="text-gray-700 text-base">
                  You'll receive a confirmation email with tracking information once your order is on its way.
                </p>
              </div>
            </div>
          </div>

          <!-- Upsell Section -->
          <div class="bg-gradient-to-br from-yellow-50 to-orange-50 border-2 border-yellow-300 rounded-2xl p-6 sm:p-8 mb-8">
            <div class="text-center mb-6">
              <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-2">
                🎁 Complete Your Collection
              </h2>
              <p class="text-lg text-gray-700 mb-1">
                <span class="font-bold text-yellow-600">Special Offer:</span> Add more editions for <span class="font-bold">50% OFF</span>
              </p>
              <p class="text-sm text-gray-600 mb-1">
                Limited time offer for customers only
              </p>
              <p class="text-xs text-gray-500">
                We'll add extra magazines to your initial order. You already paid for shipping!
              </p>
            </div>

            <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 mb-6">
              <!-- Edition 1 -->
              <div class="bg-white rounded-xl overflow-hidden border-2 border-gray-200 hover:border-yellow-400 transition-all">
                <img 
                  src="/images/edition-001-cover.webp" 
                  alt="Nomad Magazine Edition 1 Cover" 
                  class="w-full aspect-[3/4] object-cover"
                  loading="lazy"
                />
                <div class="p-3 sm:p-4">
                <h3 class="font-bold text-gray-900 mb-1 text-sm sm:text-base">Edition 1</h3>
                <p class="text-xs text-gray-600 mb-2 sm:mb-3 line-clamp-2">Mongolia, Insurance, Dating & More</p>
                <div class="mb-2 sm:mb-3">
                  <div class="flex items-baseline gap-1 sm:gap-2">
                    <span class="text-xs sm:text-sm text-gray-400 line-through">€22</span>
                    <span class="text-lg sm:text-xl font-bold text-yellow-600">€11</span>
                  </div>
                </div>
                <div class="flex flex-col gap-1">
                  <label for="qty-edition-1" class="text-xs font-semibold text-gray-700">Qty:</label>
                  <div class="flex items-center border border-gray-300 rounded bg-white">
                    <button 
                      type="button"
                      class="qty-minus px-2 py-1 hover:bg-gray-100 text-gray-600 font-bold text-sm"
                      data-target="qty-edition-1"
                      aria-label="Decrease quantity for Edition 1"
                    >−</button>
                    <input 
                      type="number" 
                      id="qty-edition-1" 
                      min="0" 
                      max="10" 
                      value="0" 
                      class="w-10 px-1 py-1 text-center text-sm border-x border-gray-300"
                      aria-label="Quantity for Edition 1"
                      readonly
                    />
                    <button 
                      type="button"
                      class="qty-plus px-2 py-1 hover:bg-gray-100 text-gray-600 font-bold text-sm"
                      data-target="qty-edition-1"
                      aria-label="Increase quantity for Edition 1"
                    >+</button>
                  </div>
                </div>
                </div>
              </div>

              <!-- Edition 2 -->
              <div class="bg-white rounded-xl overflow-hidden border-2 border-gray-200 hover:border-yellow-400 transition-all">
                <img 
                  src="/images/edition-002-cover.webp" 
                  alt="Nomad Magazine Edition 2 Cover" 
                  class="w-full aspect-[3/4] object-cover"
                  loading="lazy"
                />
                <div class="p-3 sm:p-4">
                <h3 class="font-bold text-gray-900 mb-1 text-sm sm:text-base">Edition 2</h3>
                <p class="text-xs text-gray-600 mb-2 sm:mb-3 line-clamp-2">Japan, Visas, Family & More</p>
                <div class="mb-2 sm:mb-3">
                  <div class="flex items-baseline gap-1 sm:gap-2">
                    <span class="text-xs sm:text-sm text-gray-400 line-through">€22</span>
                    <span class="text-lg sm:text-xl font-bold text-yellow-600">€11</span>
                  </div>
                </div>
                <div class="flex flex-col gap-1">
                  <label for="qty-edition-2" class="text-xs font-semibold text-gray-700">Qty:</label>
                  <div class="flex items-center border border-gray-300 rounded bg-white">
                    <button 
                      type="button"
                      class="qty-minus px-2 py-1 hover:bg-gray-100 text-gray-600 font-bold text-sm"
                      data-target="qty-edition-2"
                      aria-label="Decrease quantity for Edition 2"
                    >−</button>
                    <input 
                      type="number" 
                      id="qty-edition-2" 
                      min="0" 
                      max="10" 
                      value="0" 
                      class="w-10 px-1 py-1 text-center text-sm border-x border-gray-300"
                      aria-label="Quantity for Edition 2"
                      readonly
                    />
                    <button 
                      type="button"
                      class="qty-plus px-2 py-1 hover:bg-gray-100 text-gray-600 font-bold text-sm"
                      data-target="qty-edition-2"
                      aria-label="Increase quantity for Edition 2"
                    >+</button>
                  </div>
                </div>
                </div>
              </div>

              <!-- Edition 3 -->
              <div class="bg-white rounded-xl overflow-hidden border-2 border-gray-200 hover:border-yellow-400 transition-all">
                <img 
                  src="/images/third-edition-cover-hd.webp" 
                  alt="Nomad Magazine Edition 3 Cover" 
                  class="w-full aspect-[3/4] object-cover"
                  loading="lazy"
                />
                <div class="p-3 sm:p-4">
                <h3 class="font-bold text-gray-900 mb-1 text-sm sm:text-base">Edition 3</h3>
                <p class="text-xs text-gray-600 mb-2 sm:mb-3 line-clamp-2">Buenos Aires, Guatemala & More</p>
                <div class="mb-2 sm:mb-3">
                  <div class="flex items-baseline gap-1 sm:gap-2">
                    <span class="text-xs sm:text-sm text-gray-400 line-through">€22</span>
                    <span class="text-lg sm:text-xl font-bold text-yellow-600">€11</span>
                  </div>
                </div>
                <div class="flex flex-col gap-1">
                  <label for="qty-edition-3" class="text-xs font-semibold text-gray-700">Qty:</label>
                  <div class="flex items-center border border-gray-300 rounded bg-white">
                    <button 
                      type="button"
                      class="qty-minus px-2 py-1 hover:bg-gray-100 text-gray-600 font-bold text-sm"
                      data-target="qty-edition-3"
                      aria-label="Decrease quantity for Edition 3"
                    >−</button>
                    <input 
                      type="number" 
                      id="qty-edition-3" 
                      min="0" 
                      max="10" 
                      value="0" 
                      class="w-10 px-1 py-1 text-center text-sm border-x border-gray-300"
                      aria-label="Quantity for Edition 3"
                      readonly
                    />
                    <button 
                      type="button"
                      class="qty-plus px-2 py-1 hover:bg-gray-100 text-gray-600 font-bold text-sm"
                      data-target="qty-edition-3"
                      aria-label="Increase quantity for Edition 3"
                    >+</button>
                  </div>
                </div>
                </div>
              </div>

              <!-- Edition 4 -->
              <div class="bg-white rounded-xl overflow-hidden border-2 border-gray-200 hover:border-yellow-400 transition-all">
                <img 
                  src="/images/edition-004-cover.webp" 
                  alt="Nomad Magazine Edition 4 Cover" 
                  class="w-full aspect-[3/4] object-cover"
                  loading="lazy"
                />
                <div class="p-3 sm:p-4">
                <h3 class="font-bold text-gray-900 mb-1 text-sm sm:text-base">Edition 4</h3>
                <p class="text-xs text-gray-600 mb-2 sm:mb-3 line-clamp-2">Palermo, Bansko, Fukuoka & More</p>
                <div class="mb-2 sm:mb-3">
                  <div class="flex items-baseline gap-1 sm:gap-2">
                    <span class="text-xs sm:text-sm text-gray-400 line-through">€22</span>
                    <span class="text-lg sm:text-xl font-bold text-yellow-600">€11</span>
                  </div>
                </div>
                <div class="flex flex-col gap-1">
                  <label for="qty-edition-4" class="text-xs font-semibold text-gray-700">Qty:</label>
                  <div class="flex items-center border border-gray-300 rounded bg-white">
                    <button 
                      type="button"
                      class="qty-minus px-2 py-1 hover:bg-gray-100 text-gray-600 font-bold text-sm"
                      data-target="qty-edition-4"
                      aria-label="Decrease quantity for Edition 4"
                    >−</button>
                    <input 
                      type="number" 
                      id="qty-edition-4" 
                      min="0" 
                      max="10" 
                      value="0" 
                      class="w-10 px-1 py-1 text-center text-sm border-x border-gray-300"
                      aria-label="Quantity for Edition 4"
                      readonly
                    />
                    <button 
                      type="button"
                      class="qty-plus px-2 py-1 hover:bg-gray-100 text-gray-600 font-bold text-sm"
                      data-target="qty-edition-4"
                      aria-label="Increase quantity for Edition 4"
                    >+</button>
                  </div>
                </div>
                </div>
              </div>
            </div>

            <!-- Total and Checkout -->
            <div class="bg-white rounded-xl p-6 border-2 border-gray-200">
              <div class="flex items-center justify-between mb-4">
                <span class="text-lg font-semibold text-gray-900">Total:</span>
                <span id="upsell-total" class="text-2xl font-bold text-gray-900">€0.00</span>
              </div>
              <button 
                id="upsell-checkout-btn"
                disabled
                class="w-full bg-gradient-to-r from-yellow-400 to-yellow-500 text-black font-bold py-4 px-6 rounded-lg hover:from-yellow-500 hover:to-yellow-600 transition-all disabled:opacity-50 disabled:cursor-not-allowed shadow-lg"
                aria-label="Add selected editions to cart"
              >
                Add to Order (€0.00 shipping included)
              </button>
              <p class="text-xs text-gray-500 text-center mt-3">
                Free shipping on upsell orders
              </p>
            </div>
          </div>

          <!-- What's Next Section -->
          <div class="border-t border-gray-200 pt-8 mb-8">
            <h2 class="text-2xl font-bold text-gray-900 mb-6">
              While you wait...
            </h2>
            
            <div class="grid sm:grid-cols-2 gap-4 text-left">
              <!-- Newsletter -->
              <div class="bg-gradient-to-br from-gray-50 to-white border border-gray-200 rounded-xl p-6 hover:shadow-lg transition-all">
                <div class="text-2xl mb-3" aria-hidden="true">✉️</div>
                <h3 class="font-bold text-gray-900 mb-2 text-lg">Stay Updated</h3>
                <p class="text-gray-600 text-sm mb-4">
                  Subscribe to our newsletter for exclusive articles, nomad tips, and event announcements.
                </p>
                <a 
                  href="/#subscribe" 
                  class="inline-block text-sm font-semibold text-gray-900 hover:text-yellow-600 underline"
                >
                  Subscribe to Newsletter →
                </a>
              </div>

              <!-- YouTube -->
              <div class="bg-gradient-to-br from-gray-50 to-white border border-gray-200 rounded-xl p-6 hover:shadow-lg transition-all">
                <div class="text-2xl mb-3" aria-hidden="true">📺</div>
                <h3 class="font-bold text-gray-900 mb-2 text-lg">Watch Our Stories</h3>
                <p class="text-gray-600 text-sm mb-4">
                  Subscribe to our YouTube channel for nomad interviews, travel stories, and community highlights.
                </p>
                <a 
                  href="https://www.youtube.com/@nomadmagazinecom" 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="inline-block text-sm font-semibold text-gray-900 hover:text-yellow-600 underline"
                  aria-label="Subscribe to Nomad Magazine on YouTube (opens in new tab)"
                >
                  Subscribe on YouTube →
                </a>
              </div>

              <!-- Join Community -->
              <div class="bg-gradient-to-br from-gray-50 to-white border border-gray-200 rounded-xl p-6 hover:shadow-lg transition-all">
                <div class="text-2xl mb-3" aria-hidden="true">🌍</div>
                <h3 class="font-bold text-gray-900 mb-2 text-lg">Join Our Community</h3>
                <p class="text-gray-600 text-sm mb-4">
                  Follow us on Instagram for nomad stories, behind-the-scenes content, and community updates.
                </p>
                <a 
                  href="https://www.instagram.com/nomadmagazinecom" 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="inline-block text-sm font-semibold text-gray-900 hover:text-yellow-600 underline"
                  aria-label="Follow Nomad Magazine on Instagram (opens in new tab)"
                >
                  Follow @nomadmagazinecom →
                </a>
              </div>

              <!-- Explore Digital -->
              <div class="bg-gradient-to-br from-gray-50 to-white border border-gray-200 rounded-xl p-6 hover:shadow-lg transition-all">
                <div class="text-2xl mb-3" aria-hidden="true">📱</div>
                <h3 class="font-bold text-gray-900 mb-2 text-lg">Explore Digital Content</h3>
                <p class="text-gray-600 text-sm mb-4">
                  Browse our past editions and read articles from nomads around the world.
                </p>
                <a 
                  href="/editions/" 
                  class="inline-block text-sm font-semibold text-gray-900 hover:text-yellow-600 underline"
                >
                  View All Editions →
                </a>
              </div>
            </div>
          </div>

          <!-- CTA Buttons -->
          <div class="flex flex-col sm:flex-row gap-4 justify-center pt-6">
            <a
              href="/"
              class="inline-block rounded-lg bg-black px-8 py-4 text-base font-bold text-white transition-all hover:bg-gray-800 hover:scale-105 shadow-lg"
            >
              Back to Home
            </a>
            <a
              href="/editions/"
              class="inline-block rounded-lg border-2 border-gray-300 px-8 py-4 text-base font-bold text-gray-900 transition-all hover:border-gray-400 hover:bg-gray-50"
            >
              Browse Editions
            </a>
          </div>
        </div>
      </div>

      <!-- Support Section -->
      <div class="mt-8 text-center">
        <p class="text-gray-600 text-sm mb-3">
          Questions about your order?
        </p>
        <p class="text-sm">
          <a href="mailto:hey@nomad-magazine.com" class="text-gray-900 font-semibold hover:text-yellow-600 underline">Contact us at hey@nomad-magazine.com</a>
        </p>
      </div>

      <!-- Testimonial or Quote -->
      <div class="mt-12 bg-gradient-to-r from-gray-900 to-gray-800 rounded-2xl p-8 text-center text-white shadow-xl">
        <p class="text-lg sm:text-xl italic mb-4">
          "Nomad Magazine is more than just a publication—it's a celebration of the nomadic lifestyle and the incredible humans who live it."
        </p>
        <p class="text-sm text-gray-300">
          — The Nomad Magazine Team
        </p>
      </div>
    </div>
  </div>
</Layout>

<script>
  // Upsell quantity calculator
  document.addEventListener('DOMContentLoaded', function() {
    const pricePerEdition = 11;
    const quantities = {
      'qty-edition-1': document.getElementById('qty-edition-1') as HTMLInputElement,
      'qty-edition-2': document.getElementById('qty-edition-2') as HTMLInputElement,
      'qty-edition-3': document.getElementById('qty-edition-3') as HTMLInputElement,
      'qty-edition-4': document.getElementById('qty-edition-4') as HTMLInputElement,
    };
    const totalDisplay = document.getElementById('upsell-total');
    const checkoutBtn = document.getElementById('upsell-checkout-btn') as HTMLButtonElement;

    function updateTotal() {
      let total = 0;
      let totalQty = 0;

      Object.values(quantities).forEach(input => {
        const qty = parseInt(input.value) || 0;
        total += qty * pricePerEdition;
        totalQty += qty;
      });

      if (totalDisplay) {
        totalDisplay.textContent = `€${total.toFixed(2)}`;
      }

      if (checkoutBtn) {
        checkoutBtn.disabled = totalQty === 0;
        checkoutBtn.textContent = totalQty === 0 
          ? 'Add to Order (€0.00 shipping included)' 
          : `Add to Order (€${total.toFixed(2)} shipping included)`;
      }
    }

    // Add event listeners to all quantity inputs
    Object.values(quantities).forEach(input => {
      input.addEventListener('input', updateTotal);
      input.addEventListener('change', updateTotal);
    });

    // Add event listeners for + and - buttons
    document.querySelectorAll('.qty-plus').forEach(button => {
      button.addEventListener('click', function(this: HTMLElement) {
        const targetId = this.getAttribute('data-target');
        if (!targetId) return;
        const input = document.getElementById(targetId) as HTMLInputElement;
        if (input) {
          const currentValue = parseInt(input.value) || 0;
          const maxValue = parseInt(input.getAttribute('max') || '10');
          if (currentValue < maxValue) {
            input.value = (currentValue + 1).toString();
            updateTotal();
          }
        }
      });
    });

    document.querySelectorAll('.qty-minus').forEach(button => {
      button.addEventListener('click', function(this: HTMLElement) {
        const targetId = this.getAttribute('data-target');
        if (!targetId) return;
        const input = document.getElementById(targetId) as HTMLInputElement;
        if (input) {
          const currentValue = parseInt(input.value) || 0;
          const minValue = parseInt(input.getAttribute('min') || '0');
          if (currentValue > minValue) {
            input.value = (currentValue - 1).toString();
            updateTotal();
          }
        }
      });
    });

    // Checkout button handler
    if (checkoutBtn) {
      checkoutBtn.addEventListener('click', async function() {
        const items: Array<{edition: number, quantity: number}> = [];
        
        Object.entries(quantities).forEach(([id, input]) => {
          const qty = parseInt(input.value) || 0;
          if (qty > 0) {
            const edition = parseInt(id.replace('qty-edition-', ''));
            items.push({ edition, quantity: qty });
          }
        });

        if (items.length > 0) {
          // Disable button and show loading state
          checkoutBtn.disabled = true;
          const originalText = checkoutBtn.textContent;
          checkoutBtn.textContent = 'Creating checkout...';

          try {
            // Call API to create Stripe checkout session
            const response = await fetch('/api/create-checkout', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
              },
              body: JSON.stringify({ items }),
            });

            const data = await response.json() as { url?: string, error?: string };

            if (response.ok && data.url) {
              // Redirect to Stripe checkout
              window.location.href = data.url;
            } else {
              alert(`Error: ${data.error || 'Failed to create checkout session'}`);
              checkoutBtn.disabled = false;
              checkoutBtn.textContent = originalText || 'Add to Order';
            }
          } catch (error) {
            console.error('Checkout error:', error);
            alert('Failed to create checkout. Please try again.');
            checkoutBtn.disabled = false;
            checkoutBtn.textContent = originalText || 'Add to Order';
          }
        }
      });
    }

    // Initial update
    updateTotal();
  });
</script>
