---
export const prerender = true
import Layout, { type SEOProps } from '~/layouts/Layout.astro'
import DirectoryEntryCard from '~/components/DirectoryEntryCard.astro'
import { getDirectoryEntries, getDirectoryCategories, directoryCategoryUrl } from '~/utils/directory'
import { getCollection } from 'astro:content'
import { normalizeContentEntries } from '~/utils/content'
import '~/styles/directory.css'

const entries = await getDirectoryEntries()
const categories = getDirectoryCategories(entries)
const needs = [
  { name: 'Find your people', category: 'Community', detail: 'Communities & connections', icon: '◎' },
  { name: 'Find your next home', category: 'Coliving', detail: 'Coliving around the world', icon: '⌂' },
  { name: 'Work from anywhere', category: 'Coworking', detail: 'Spaces to get things done', icon: '↗' },
  { name: 'Make life simpler', category: 'App', detail: 'Tools for life on the move', icon: '✳' },
]
const articles = normalizeContentEntries(await getCollection('article'))
  .filter((article) => article.data.published !== false)
  .sort((a, b) => new Date(b.data.pubDate || b.data.updatedDate || '2024-01-01').getTime() - new Date(a.data.pubDate || a.data.updatedDate || '2024-01-01').getTime())
  .slice(0, 3)
const seo: SEOProps = {
  title: 'Digital Nomad Resources & Community | Nomad Magazine',
  description: 'Find your next coliving, coworking space, community or remote work tool. Explore the Nomad Directory, practical guides and stories for life as a digital nomad.',
  canonical: `${Astro.site}`,
  image: `${Astro.site}images/Nomad-directory.webp`,
  keywords: 'digital nomad resources, nomad directory, coliving, coworking, remote work tools, nomad communities',
  ldJSON: {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Nomad Magazine',
    description: 'Resources, communities and stories for digital nomads, home of the Nomad Directory.',
    url: `${Astro.site}`,
    publisher: { '@type': 'Organization', name: 'Nomad Magazine', url: `${Astro.site}` },
  },
}
---

<Layout seo={seo}>
  <div class="directory-theme">
    <section class="home-hero directory-wrap">
      <div>
        <p class="directory-eyebrow">Less searching. More living.</p>
        <h1>Digital nomad life.<br /><span>All in one place.</span></h1>
        <p class="hero-description">The places, people and tools that make life as a digital nomad work. All in one directory.</p>
        <form action="/nomad_directory/" method="GET" role="search" aria-label="Search the Nomad Directory" class="home-search">
          <label for="home-search" class="sr-only">Search tools, spaces and communities</label>
          <input id="home-search" name="q" type="search" placeholder="Try coliving, eSIM or community…" />
          <button type="submit" class="directory-button">Explore <span aria-hidden="true">↗</span></button>
        </form>
        <p class="hero-meta">{entries.length} listings <span aria-hidden="true">/</span> {categories.length} categories <span aria-hidden="true">/</span> One nomad community</p>
        <a class="directory-text-link" href="/nomad_directory/">Browse the Nomad Directory</a>
      </div>
      <div class="hero-discovery">
        <div class="discovery-heading"><span class="directory-eyebrow">Where to next?</span><span aria-hidden="true">↗</span></div>
        {
          needs.map((need, index) => (
            <a href={directoryCategoryUrl(need.category)} class="need-card">
              <span class="need-icon" aria-hidden="true">
                {need.icon}
              </span>
              <span>
                <>
                  <strong>{need.name}</strong>
                  <small>{need.detail}</small>
                </>
              </span>
              <span class="need-number" aria-hidden="true">
                0{index + 1}
              </span>
            </a>
          ))
        }
        <p class="directory-muted">Built by Nomad Magazine. Made for your everyday.</p>
      </div>
    </section>
    <section class="directory-section">
      <div class="directory-wrap">
        <div class="section-heading">
          <div>
            <p class="directory-eyebrow">The Nomad Directory</p><h2>Good finds for life on the move.</h2><p class="directory-muted">
              Discover businesses building for people like you.
            </p>
          </div><a href="/nomad_directory/" class="directory-text-link">Explore all {entries.length} listings ↗</a>
        </div>
        <div class="directory-grid">{entries.slice(0, 3).map((entry) => <DirectoryEntryCard entry={entry} preview />)}</div>
      </div>
    </section>
    <section class="directory-section">
      <div class="directory-wrap owner-strip">
        <div>
          <p class="directory-eyebrow">For the people building it</p><h2>Your project belongs here.</h2><p class="directory-muted">
            Run a space, community or service for nomads? Help the right people find you.
          </p>
        </div><div class="directory-actions">
          <a href="/nomad-directory-submit/" class="directory-button">Add your listing ↗</a><a href="/nomad-directory-edit/" class="directory-text-link">Manage your listing</a>
        </div>
      </div>
    </section>
    <section class="directory-section">
      <div class="directory-wrap">
        <div class="section-heading">
          <div><p class="directory-eyebrow">Beyond the directory</p><h2>Stories from the road.</h2></div><a href="/articles/" class="directory-text-link">All articles ↗</a>
        </div>
        <div class="directory-grid">
          {
            articles.map((article) => (
              <article class="story-card">
                <>
                  <h3>
                    <a href={`/articles/${article.slug}/`}>{article.data.title}</a>
                  </h3>
                  <a class="directory-text-link" href={`/articles/${article.slug}/`} aria-label={`Read ${article.data.title}`}>
                    Read the story ↗
                  </a>
                </>
              </article>
            ))
          }
        </div>
        <aside class="magazine-archive" aria-label="Magazine archive">
          <div>
            <p class="directory-eyebrow">Where it all began</p><h2>The magazine collection.</h2><p class="directory-muted">
              Four editions of places, people and perspectives. Explore the archive while we build the next chapter around the directory.
            </p>
          </div><a href="/editions/" class="directory-button secondary">Explore past editions ↗</a>
        </aside>
      </div>
    </section>
  </div>
</Layout>
<style>
  .home-hero {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    align-items: center;
    gap: 88px;
    padding-top: 76px;
    padding-bottom: 76px;
  }
  h1 {
    font-size: clamp(48px, 5.4vw, 76px);
    line-height: 1.06;
    font-weight: 650;
    letter-spacing: -0.055em;
    margin: 22px 0;
  }
  h1 span {
    color: #facc15;
  }
  .hero-description {
    color: #b9beb5;
    font-size: 20px;
    max-width: 500px;
    line-height: 1.6;
  }
  .home-search {
    display: flex;
    background: #fff;
    padding: 6px;
    border-radius: 10px;
    margin: 28px 0 16px;
    gap: 8px;
  }
  .home-search input {
    flex: 1;
    min-width: 0;
    padding: 10px;
    color: #171817;
    font-size: 16px;
  }
  .home-search input::placeholder {
    color: #61675d;
  }
  .hero-meta {
    color: #b9beb5;
    font-size: 13px;
    margin-bottom: 22px;
  }
  .hero-meta span {
    color: #5c6654;
    padding: 0 8px;
  }
  .hero-discovery {
    border: 1px solid #394132;
    border-radius: 20px;
    background: #20261d;
    padding: 24px;
    transform: rotate(1deg);
  }
  .discovery-heading {
    display: flex;
    justify-content: space-between;
    margin-bottom: 20px;
  }
  .need-card {
    display: flex;
    align-items: center;
    gap: 16px;
    background: #2b3426;
    border: 1px solid #45513c;
    border-radius: 10px;
    padding: 20px 16px;
    margin: 10px 0;
  }
  .need-card:hover {
    border-color: #facc15;
  }
  .need-icon {
    color: #facc15;
    font-size: 28px;
    width: 30px;
    text-align: center;
  }
  .need-card strong {
    font-size: 17px;
    font-weight: 600;
  }
  .need-card small {
    display: block;
    color: #bdc6b7;
    margin-top: 3px;
  }
  .need-number {
    margin-left: auto;
    color: #b1bda8;
    font-size: 12px;
  }
  .hero-discovery > p {
    font-size: 12px;
    text-align: center;
    margin-top: 20px;
  }
  .owner-strip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
  }
  .owner-strip p {
    margin: 12px 0;
  }
  .story-card {
    padding: 24px 0;
    border-top: 1px solid #4c5445;
  }
  .story-card h3 {
    font-size: 21px;
    margin-bottom: 24px;
  }
  .magazine-archive {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    margin-top: 56px;
    padding: 32px;
    background: #20251d;
    border-radius: 14px;
  }
  .magazine-archive p {
    max-width: 640px;
    margin: 12px 0;
  }
  .magazine-archive h2 {
    font-size: 26px;
  }
  @media (max-width: 1000px) {
    .home-hero {
      gap: 32px;
    }
    .owner-strip {
      align-items: start;
      flex-direction: column;
    }
  }
  @media (max-width: 760px) {
    .home-hero {
      grid-template-columns: 1fr;
      padding-top: 40px;
      padding-bottom: 40px;
    }
    .hero-discovery {
      transform: none;
    }
    .magazine-archive {
      flex-direction: column;
      align-items: start;
      padding: 24px;
    }
    .home-search .directory-button {
      padding: 12px;
    }
  }
</style>
