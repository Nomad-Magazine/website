---
export const prerender = true;

import About from '~/components/About.astro'
import Bridge from '~/components/Bridge.astro'
import CheckIcon from '~icons/ic/baseline-check'
import OurTeam from '~/components/OurTeam.astro'
import Welcome from '~/components/Welcome.astro'
import Mission from '~/components/Mission.astro'
import Partners from '~/components/Partners.astro'
import Subscribe from '~/components/Subscribe.astro'
import GetInvolved from '~/components/GetInvolved.astro'
import FooterLinks from '~/components/FooterLinks.astro'
import Testimonials from '~/components/Testimonials.astro'
import ThirdEdition from '~/components/ThirdEdition.astro'
import PastEditions from '~/components/PastEditions.astro'
import Layout, { type SEOProps } from '~/layouts/Layout.astro'
import BrandPlacement from '~/components/BrandPlacement.astro'
import StickyBrandPlacement from '~/components/StickyBrandPlacement.astro'
import MagazinePreview from '~/components/MagazinePreview.astro'
import GrowingCommunity from '~/components/GrowingCommunity.astro'
import MagazineStack from '~/components/MagazineStack.astro'
import { fetchReportRecords } from '~/utils/smartsuite'
import { getCollection } from 'astro:content'

// Fetch real nomad directory data
const { records = [] } = await fetchReportRecords('6857167d82358a0f5e038c3f')

// Fetch latest blog articles
const allPosts = await getCollection('blog')
const latestPosts = allPosts
  .filter(post => post.data.published !== false)
  .sort((a, b) => {
    // Use the most recent date available: pubDate, updatedDate
    const dateA = new Date(a.data.pubDate || a.data.updatedDate || '2024-01-01').getTime()
    const dateB = new Date(b.data.pubDate || b.data.updatedDate || '2024-01-01').getTime()
    return dateB - dateA
  })
  .slice(0, 3)

// Hardcoded Monthly Supporters list (same as nomad_directory.astro)
const monthlySupporters = [
  'DataBench',
  'Max Browser',
  'DataBench (Max Browser)', // in case it's stored with the full name
  'Max',
  'NomadTax Bulgaria Ltd.',
  // Add more supporter company names here as needed
]

// Helper function to check if a record is a supporter
const isSupporter = (record: any) => {
  return record.supporter || 
         record.monthly_supporter || 
         record.is_supporter || 
         record.supporter_status === 'Monthly Supporter' ||
         monthlySupporters.includes(record.title)
}

// Get all valid directory entries and sort supporters first
const allValidEntries = records
  .filter((record: any) => record.sf4ad525dd && record.title && record.scea90e502)
  .sort((a: any, b: any) => {
    const aSupporterStatus = isSupporter(a)
    const bSupporterStatus = isSupporter(b)
    
    // Supporters go first
    if (aSupporterStatus && !bSupporterStatus) return -1
    if (!aSupporterStatus && bSupporterStatus) return 1
    
    return 0 // Keep original order for same type
  })
  .map((record: any) => ({
    title: record.title,
    description: record.scea90e502,
    category: record.sb685ab800?.label || 'Service',
    link: record.link || record.sb788c266b?.[0] || '/nomad_directory',
    image: record.image,
    isSupporter: isSupporter(record)
  }))

// Get first 6 entries for regular display (now sorted with supporters first)
const regularDirectoryEntries = allValidEntries.slice(0, 6)

// Get featured directory entries (supporters only)
const featuredDirectoryEntries = allValidEntries
  .filter((entry: any) => entry.isSupporter)
  .slice(0, 3)

// YouTube channel videos
const youtubeVideos = [
  {
    id: 'pgTpfH7zNVs',
    title: 'Why Digital Nomads Are Choosing Buenos Aires in 2025',
    description: 'Discover what makes Buenos Aires a top destination for digital nomads in 2025.',
    thumbnail: 'https://img.youtube.com/vi/pgTpfH7zNVs/hqdefault.jpg',
    duration: '18:45',
    views: '12.3K',
    publishedAt: '2025-01-20'
  },
  {
    id: 'NgG92Q8Uxgg',
    title: 'Why Digital Nomads Are Choosing Madeira in 2024: Madeira Friends Founders and Community',
    description: 'Meet the founders behind Madeira Friends and discover why digital nomads are flocking to this Portuguese island.',
    thumbnail: 'https://img.youtube.com/vi/NgG92Q8Uxgg/hqdefault.jpg',
    duration: '14:22',
    views: '8.7K',
    publishedAt: '2025-01-18'
  },
  {
    id: '_sBXTskL0gA',
    title: 'Why Digital Nomads Choose Chiang Mai?',
    description: 'Exploring what makes Chiang Mai, Thailand one of the top destinations for digital nomads worldwide.',
    thumbnail: 'https://img.youtube.com/vi/_sBXTskL0gA/hqdefault.jpg',
    duration: '16:33',
    views: '15.9K',
    publishedAt: '2025-01-15'
  },
  {
    id: 'hElNoT15fBE',
    title: 'She Found a Hidden Gem in Guatemala — and Built a Co-Living There',
    description: 'Bianca Bonilla left her comfort zone to build something extraordinary — a co-living villa on the Pacific coast of Guatemala, in a fishing village that didn\'t even have internet just a few years ago.',
    thumbnail: 'https://img.youtube.com/vi/hElNoT15fBE/hqdefault.jpg',
    duration: '13:44',
    views: '32',
    publishedAt: '2025-01-12'
  },
  {
    id: 'lEtXdzH65Dk',
    title: 'How to Fly Business Class for $6: Trevor Wright\'s Travel Hack That Changed Everything',
    description: 'Trevor Wright is the founder of MileMethod.com, a business that helps Americans travel the world in luxury — without breaking the bank. In this interview, he shares how he turned a backpacker\'s obsession with saving money into a 10-year business, helping clients book $20,000 trips for under $1,000 by using U.S. credit card rewards.',
    thumbnail: 'https://img.youtube.com/vi/lEtXdzH65Dk/hqdefault.jpg',
    duration: '15:26',
    views: '160',
    publishedAt: '2024-10-10'
  },
  {
    id: 'wnVgPO4pGU8',
    title: 'Building Business on the Move: Ben Guez\'s Digital Nomad Story',
    description: 'Join us in Madeira at Nomad Island Fest as we speak with Ben Guez — an entrepreneur, angel investor, and content creator with a truly global perspective. Originally from France and now based in the US, Ben shares his journey into the digital nomad lifestyle, his inspiration to build a tech platform for co-living on demand called Airmeet, and his vision for creating meaningful connections at nomad events.',
    thumbnail: 'https://img.youtube.com/vi/wnVgPO4pGU8/hqdefault.jpg',
    duration: '13:45',
    views: '209',
    publishedAt: '2024-08-01'
  }
]

const seo: SEOProps = {
  title: 'Nomad Magazine - The First Global Digital Nomad Magazine',
  description: 'The first global digital nomad magazine. For people who work and live everywhere (or dream of it). Inspiring stories from nomads around the world.',
  image: `${Astro.site}images/magazine-hold-against-chest.webp`,
  keywords: 'digital nomad magazine, remote work, nomad lifestyle, travel, coworking, nomad community, global nomads',
  ldJSON: {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Nomad Magazine',
    url: Astro.site,
    description: 'The first global digital nomad magazine',
    publisher: {
      '@type': 'Organization',
      name: 'Nomad Magazine',
      logo: {
        '@type': 'ImageObject',
        url: `${Astro.site}logo.svg`,
      },
    },
    potentialAction: {
      '@type': 'SubscribeAction',
      target: `${Astro.site}newsletter`,
    },
  },
}
---

<Layout seo={seo}>
  <div class="mx-auto max-w-7xl px-4 py-8 sm:py-12 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 items-center gap-8 sm:gap-16 lg:grid-cols-2">
      <div class="space-y-6 sm:space-y-8">
        <div class="space-y-4 sm:space-y-6">
          <p class="font-justme text-4xl text-gray-800">the first global digital nomad magazine</p>
          <h1 class="md:text-12xl xl:text-22xl text-7xl font-semibold text-gray-900 xl:leading-18">This magazine will show you the Digital Nomad World 🌴</h1>
          <div class="space-y-3 text-lg text-gray-700">
            <p class="flex items-center">
              <CheckIcon class="mr-2 h-6 w-6 flex-shrink-0 text-black" />
              <span>Made for people brave enough to travel and live life differently</span>
            </p>
            <p class="flex items-center">
              <CheckIcon class="mr-2 h-6 w-6 flex-shrink-0 text-black" />
              <span>Discover amazing places to travel, work from, and meet like-minded people</span>
            </p>
            <p class="flex items-center">
              <CheckIcon class="mr-2 h-6 w-6 flex-shrink-0 text-black" />
              <span>Learn how to make money, stay healthy, and live your best nomadic life</span>
            </p>
          </div>
        </div>
        <div class="space-y-4">
          <div class="mb-2 flex flex-col gap-4 sm:flex-row sm:items-end">
            <div class="flex flex-col items-center order-first sm:order-last">
              <span class="mb-1 inline-block rounded-full bg-yellow-400 px-3 py-1 text-xs font-bold text-black uppercase tracking-wide shadow">Latest Edition</span>
              <a
                href="/editions/third-edition"
                class="glow-animate w-full sm:w-auto inline-block rounded border-2 border-yellow-400 bg-black px-6 sm:px-8 py-3 text-center text-base sm:text-lg font-extrabold text-yellow-400 transition-colors duration-200 hover:bg-yellow-400 hover:text-black focus:outline-none focus:ring-2 focus:ring-yellow-300"
              >
                NEW EDITION >>
              </a>
            </div>
            <a
              href="/editions"
              class="w-full sm:w-auto inline-block rounded bg-yellow-400 px-6 sm:px-8 py-3 text-center text-base sm:text-lg font-extrabold text-black shadow-md transition-transform duration-200 hover:scale-105 hover:shadow-lg focus:outline-none focus:ring-2 focus:ring-yellow-300 order-last sm:order-first"
            >
              VIEW ALL EDITIONS
            </a>
          </div>
          <div class="mt-2 text-xs sm:text-sm text-gray-700">
            P.S. It's nice to get away from screens once in a while! <a href="/blog/7-tips-for-balancing-work-and-travel" class="text-gray-800 hover:text-gray-900">Learn how to balance work and travel</a>.
          </div>
        </div>
      </div>
      <div class="flex justify-center lg:justify-end order-first lg:order-last">
        <MagazineStack showLatestBadge={true} className="max-w-full" />
      </div>
    </div>
  </div>
  <div class="relative">
    <img src="/images/paper-cut.webp" alt="" class="w-full" loading="lazy" />
  </div>
  <div class="bg-hoverw text-white">
    <ThirdEdition />
    <PastEditions />
    <MagazinePreview />
    
    <!-- Nomad Directory Section -->
    <section class="border-b border-neutral-800 bg-neutral-900/30 px-4 py-16 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="mb-12 flex items-center justify-between">
          <div>
            <h2 class="text-3xl font-bold text-white">Nomad Directory</h2>
            <p class="mt-2 text-lg text-neutral-400">Latest tools, services, and companies for digital nomads</p>
          </div>
          <a 
            href="/nomad_directory" 
            class="inline-flex items-center gap-2 rounded-lg bg-yellow-400 px-4 py-2 text-sm font-bold text-black transition-all hover:bg-yellow-300"
          >
            View All
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
        </div>
        
        <!-- Regular Directory Entries -->
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
          {regularDirectoryEntries.map((entry: any, index: number) => (
            <div class={`group relative overflow-hidden rounded-2xl transition-all hover:scale-105 ${
              index === 0 
                ? 'bg-gradient-to-br from-yellow-500/20 to-orange-500/20 hover:from-yellow-500/30 hover:to-orange-500/30' 
                : 'bg-neutral-900/50 hover:bg-neutral-900/80'
            }`}>
              <div class="p-6">
                <div class="mb-4 flex items-center gap-3">
                  <div class={`flex h-16 w-16 items-center justify-center rounded-lg ${
                    entry.title?.toLowerCase().includes('naio') || entry.title?.toLowerCase().includes('italia nomad fest') || entry.title?.toLowerCase().includes('inf')
                      ? 'bg-white' 
                      : 'bg-white'
                  }`}>
                    {entry.image && entry.image !== '/logo.svg' ? (
                      <img 
                        src={entry.image} 
                        alt={entry.title} 
                        class="w-full h-full rounded object-contain"
                      />
                    ) : (
                      <span class="font-bold text-black text-xl">
                        {entry.title.charAt(0).toUpperCase()}
                      </span>
                    )}
                  </div>
                  <div>
                    <div class="flex items-center gap-2">
                      <h3 class="text-lg font-bold text-white">{entry.title}</h3>
                      {entry.isSupporter && (
                        <a 
                          href="/support-the-magazine" 
                          class="inline-flex items-center gap-1 bg-gradient-to-r from-red-600 to-red-700 text-white px-2 py-0.5 rounded-full text-xs font-bold hover:from-red-700 hover:to-red-800 transition-all duration-200 shadow-lg"
                          title="Monthly Supporter"
                        >
                          <svg width="10" height="10" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                          </svg>
                          Supporter
                        </a>
                      )}
                    </div>
                    <span class={`inline-block rounded-full px-2 py-1 text-xs ${
                      entry.category === 'Insurance' ? 'bg-blue-500/20 text-blue-300' :
                      entry.category === 'Community' ? 'bg-green-500/20 text-green-300' :
                      entry.category === 'Platform' ? 'bg-purple-500/20 text-purple-300' :
                      entry.category === 'Events' ? 'bg-orange-500/20 text-orange-300' :
                      entry.category === 'App' ? 'bg-indigo-500/20 text-indigo-300' :
                      'bg-gray-500/20 text-gray-300'
                    }`}>
                      {entry.category}
                    </span>
                  </div>
                </div>
                <p class="text-sm text-neutral-300 mb-4 line-clamp-3">
                  {entry.description}
                </p>
                <a 
                  href={entry.link}
                  target={entry.link.startsWith('http') ? '_blank' : '_self'}
                  rel={entry.link.startsWith('http') ? 'noopener noreferrer' : undefined}
                  class="inline-flex items-center text-yellow-400 text-sm font-medium hover:text-yellow-300"
                >
                  Learn more →
                </a>
              </div>
            </div>
          ))}
        </div>
        
        <div class="mt-12 text-center">
          <a
            href="/nomad_directory"
            class="inline-flex items-center gap-2 rounded-lg bg-yellow-400 px-6 py-3 text-sm font-bold text-black transition-all hover:bg-yellow-300 hover:scale-105"
          >
            Browse Full Directory
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
        </div>
      </div>
    </section>
    
    <!-- YouTube Section -->
    <section class="border-b border-neutral-800 bg-neutral-900/30 px-4 py-16 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="mb-12 flex items-center justify-between">
          <div>
            <h2 class="text-3xl font-bold text-white">Latest Videos</h2>
            <p class="mt-2 text-lg text-neutral-400">Watch our latest content on YouTube</p>
          </div>
          <a 
            href="https://www.youtube.com/@Nomad-Magazine" 
            target="_blank"
            class="inline-flex items-center gap-2 rounded-lg bg-red-600 px-4 py-2 text-sm font-bold text-white transition-all hover:bg-red-700"
          >
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
            </svg>
            Subscribe
          </a>
        </div>
        
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
          {youtubeVideos.map((video) => (
            <div class="group relative overflow-hidden rounded-2xl bg-neutral-900/50 transition-all hover:bg-neutral-900/80 hover:scale-105">
              <div class="relative">
                <img
                  src={video.thumbnail}
                  alt={video.title}
                  class="aspect-video w-full object-cover"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
                <div class="absolute bottom-2 right-2 rounded bg-black/80 px-2 py-1 text-xs text-white">
                  {video.duration}
                </div>
                <div class="absolute inset-0 flex items-center justify-center">
                  <div class="rounded-full bg-red-600 p-4 transition-all group-hover:bg-red-700 group-hover:scale-110">
                    <svg class="h-8 w-8 text-white" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M8 5v14l11-7z"/>
                    </svg>
                  </div>
                </div>
              </div>
              <div class="p-6">
                <h3 class="mb-2 text-lg font-bold text-white group-hover:text-yellow-400 transition-colors">
                  <a href={`https://www.youtube.com/watch?v=${video.id}`} target="_blank" class="after:absolute after:inset-0">
                    {video.title}
                  </a>
                </h3>
                <p class="text-sm text-neutral-300 line-clamp-2">
                  {video.description}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
    
    <!-- Office Hours Section -->
    <section class="bg-white px-4 py-16 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="grid grid-cols-1 gap-12 lg:grid-cols-2 lg:gap-16">
          <!-- Content -->
          <div class="space-y-6">
            <div class="flex items-center gap-3">
              <div class="inline-block bg-yellow-400 text-black px-4 py-2 rounded-full font-bold text-sm">
                💬 Office Hours
              </div>
              <div class="inline-block bg-blue-500 text-white px-3 py-1 rounded-full font-bold text-xs">
                BETA
              </div>
            </div>
            
            <h2 class="text-3xl font-bold text-gray-900">
              Connect with <span class="text-yellow-600">Nomad Magazine</span>
            </h2>
            
            <p class="text-lg text-gray-600">
              Join our weekly pre-scheduled calls where you can share updates with our team and connect with our engaged audience. Free and open for everyone.
            </p>
            
            <div class="space-y-4">
              <div class="flex items-start gap-3">
                <div class="text-2xl">📢</div>
                <div>
                  <h3 class="text-gray-900 font-semibold">Share Your Updates</h3>
                  <p class="text-sm text-gray-600">Announce new products, services, launches, or important updates</p>
                </div>
              </div>
              
              <div class="flex items-start gap-3">
                <div class="text-2xl">📸</div>
                <div>
                  <h3 class="text-gray-900 font-semibold">Get Featured on Instagram</h3>
                  <p class="text-sm text-gray-600">Your announcements will be featured on our Instagram</p>
                </div>
              </div>
              
              <div class="flex items-start gap-3">
                <div class="text-2xl">❓</div>
                <div>
                  <h3 class="text-gray-900 font-semibold">Ask Questions</h3>
                  <p class="text-sm text-gray-600">Get advice about nomad life, business, or anything else</p>
                </div>
              </div>
            </div>
            
            <div class="flex flex-col sm:flex-row gap-4 pt-4">
              <a
                href="/office-hours"
                class="inline-flex items-center gap-2 bg-yellow-400 text-black px-6 py-3 rounded-lg text-sm font-bold transition-all hover:bg-yellow-300 hover:scale-105"
              >
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                </svg>
                Learn More & Join
              </a>
              <a
                href="https://calendly.com/nomadgossip"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 border border-yellow-400 text-yellow-600 px-6 py-3 rounded-lg text-sm font-bold transition-all hover:bg-yellow-400 hover:text-black"
              >
                Quick Book
              </a>
            </div>
          </div>
          
          <!-- Next Call Info -->
          <div class="bg-gradient-to-br from-yellow-500/10 to-orange-500/10 rounded-2xl p-8 border border-yellow-500/20">
            <div class="text-center space-y-4">
              <div class="text-4xl">🗓️</div>
              <h3 class="text-xl font-bold text-gray-900">Next Office Hours</h3>
              
              <div class="bg-gray-900 rounded-lg p-4">
                <div class="text-yellow-400 font-bold text-lg">Wednesday, Sep 24</div>
                <div class="text-white font-semibold">7:00 PM - 7:30 PM UK Time</div>
                <div class="text-sm text-gray-300 mt-2">Perfect for US & Europe</div>
                <div class="text-xs text-gray-400 mt-2 space-y-1">
                  <div>🇺🇸 NYC: 2:00 PM - 2:30 PM</div>
                  <div>🇺🇸 LA: 11:00 AM - 11:30 AM</div>
                  <div>🇩🇪 Berlin: 8:00 PM - 8:30 PM</div>
                </div>
              </div>
              
              <div class="text-sm text-gray-600">
                <p class="mb-2">✨ <strong>Everyone wins:</strong></p>
                <p>Join → Share your Updates → We record and post on IG</p>
              </div>
              
              <a
                href="https://us06web.zoom.us/meeting/register/m3inIp39SwmZqkpXYtm7aA"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-block bg-yellow-400 text-black px-6 py-3 rounded-lg font-bold transition-all hover:bg-yellow-300 hover:scale-105"
              >
                Register for This Call
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
    
    <!-- Partners Section - Move up for social proof -->
    <Partners />
    
    <!-- Digital Nomad Insights Section - Reduced to 3 articles for less clutter -->
    <section class="border-b border-neutral-800 bg-neutral-900/30 px-4 py-16 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="mb-12">
          <h2 class="text-3xl font-bold text-white">Latest <span class="text-yellow-400">Nomad</span> Insights</h2>
          <p class="mt-2 text-lg text-neutral-400">Essential reads for the modern digital nomad</p>
        </div>
        
        <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
          {latestPosts.map((post, index) => (
            <article class={`group relative overflow-hidden rounded-2xl transition-all hover:scale-105 ${
              index === 0 
                ? 'col-span-1 md:col-span-2 lg:col-span-1 bg-gradient-to-br from-yellow-500/20 to-orange-500/20 hover:from-yellow-500/30 hover:to-orange-500/30' 
                : 'bg-neutral-900/50 hover:bg-neutral-900/80'
            }`}>
              <div class="relative aspect-video">
                <img
                  src={post.data.heroImage || '/images/default-blog-hero.webp'}
                  alt={post.data.title}
                  class="h-full w-full object-cover"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
                {index === 0 && (
                  <div class="absolute top-4 left-4">
                    <span class="inline-block rounded-full bg-yellow-400 px-3 py-1 text-xs font-bold text-black uppercase">Latest</span>
                  </div>
                )}
              </div>
              <div class="p-6">
                <h3 class={`mb-3 font-bold text-white group-hover:text-yellow-400 transition-colors ${
                  index === 0 ? 'text-xl' : 'text-lg'
                }`}>
                  <a href={`/blog/${post.slug}`} class="after:absolute after:inset-0">
                    {post.data.title}
                  </a>
                </h3>
                <p class="text-sm text-neutral-300 line-clamp-3">
                  {post.data.description}
                </p>
                <div class="mt-4 flex items-center text-xs text-neutral-400">
                  <span>{new Date(post.data.pubDate || post.data.updatedDate || '2024-01-01').toLocaleDateString('en-US', { 
                    year: 'numeric', 
                    month: 'short', 
                    day: 'numeric' 
                  })}</span>
                </div>
              </div>
            </article>
          ))}
        </div>
        
        <div class="mt-12 text-center">
          <a
            href="/blog"
            class="inline-flex items-center gap-2 rounded-lg bg-yellow-400 px-6 py-3 text-sm font-bold text-black transition-all hover:bg-yellow-300 hover:scale-105"
          >
            Read More Articles
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
        </div>
      </div>
    </section>
    
    <!-- Community & Social Proof -->
    <Testimonials />
    <GrowingCommunity />
    
    <!-- About & Mission - Combine related sections -->
    <About />
    <Mission />
    
    <!-- Call to Action Sections -->
    <Bridge />
    <Welcome />
  </div>
  <OurTeam />
  <div class="bg-hoverw text-white">
    <BrandPlacement />
    <Subscribe tag="home" />
  </div>
  <div class="bg-gray-50">
    <GetInvolved />
    <FooterLinks />
  </div>
  
  <!-- Sticky Brand Placement Banner -->
  <StickyBrandPlacement />
  
  <!-- Sticky Magazine CTA -->
  <div id="sticky-cta" class="fixed bottom-4 right-4 z-50 hidden">
    <div class="bg-black border-2 border-yellow-400 rounded-lg p-4 shadow-2xl max-w-sm">
      <div class="flex items-center gap-3">
        <img 
          src="/images/third-edition-cover-hd.webp" 
          alt="Nomad Magazine" 
          class="w-16 h-20 object-cover rounded"
        />
        <div class="flex-1">
          <h3 class="text-white font-bold text-sm">Get the Latest Edition</h3>
          <p class="text-gray-300 text-xs mb-2">100+ pages of nomad wisdom</p>
          <a 
            href="/editions/third-edition"
            class="inline-block bg-yellow-400 text-black text-xs font-bold px-3 py-1.5 rounded hover:bg-yellow-300 transition-colors"
          >
            Order Now
          </a>
        </div>
        <button 
          onclick="document.getElementById('sticky-cta').style.display = 'none'"
          class="text-gray-400 hover:text-white text-xl leading-none"
        >
          ×
        </button>
      </div>
    </div>
  </div>
</Layout>

<style>
@keyframes glow {
  0% { box-shadow: 0 0 0 0 #fde047; }
  50% { box-shadow: 0 0 16px 4px #fde047; }
  100% { box-shadow: 0 0 0 0 #fde047; }
}
.glow-animate {
  animation: glow 1.5s infinite;
}
.line-clamp-2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.line-clamp-3 {
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
</style>

<script>
  // Show sticky CTA after scrolling past hero section
  window.addEventListener('scroll', function() {
    const stickyCTA = document.getElementById('sticky-cta');
    const scrollPosition = window.scrollY;
    const windowHeight = window.innerHeight;
    
    if (scrollPosition > windowHeight * 0.8) {
      stickyCTA?.classList.remove('hidden');
    } else {
      stickyCTA?.classList.add('hidden');
    }
  });
</script>
