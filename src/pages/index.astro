                <ul class="list-disc list-inside space-y-1 ml-4">
                  <li>Free accommodation</li>
                  <li>Monthly stipend provided</li>
                  <li>6+ months commitment</li>
                  <li>Remote Pacific location (Saipan)</li>
                </ul>`,
      actions: '<a href="mailto:hello@casamarianas.com" class="inline-flex items-center gap-2 bg-yellow-400 hover:bg-yellow-300 text-black px-6 py-3 rounded-lg font-bold transition-all" aria-label="Contact Casa Marianas (opens email client)">Get Email →</a>'
