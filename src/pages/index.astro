---
export const prerender = true;

import About from '~/components/About.astro'
import Bridge from '~/components/Bridge.astro'
import CheckIcon from '~icons/ic/baseline-check'
import OurTeam from '~/components/OurTeam.astro'
import Welcome from '~/components/Welcome.astro'
import Mission from '~/components/Mission.astro'
import Partners from '~/components/Partners.astro'
import Subscribe from '~/components/Subscribe.astro'
import GetInvolved from '~/components/GetInvolved.astro'
import Testimonials from '~/components/Testimonials.astro'
import ThirdEdition from '~/components/ThirdEdition.astro'
import PastEditions from '~/components/PastEditions.astro'
import Layout, { type SEOProps } from '~/layouts/Layout.astro'
import BrandPlacement from '~/components/BrandPlacement.astro'
import MagazinePreview from '~/components/MagazinePreview.astro'
import GrowingCommunity from '~/components/GrowingCommunity.astro'
import MagazineStack from '~/components/MagazineStack.astro'
import StickyAnnouncementBar from '~/components/StickyAnnouncementBar.astro'
import { fetchReportRecords } from '~/utils/smartsuite'
import { getCollection } from 'astro:content'
import { normalizeContentEntries } from '~/utils/content'

// Fetch real nomad directory data
const { records = [] } = await fetchReportRecords('6857167d82358a0f5e038c3f')

// Fetch latest articles (not blog posts)
const allArticles = normalizeContentEntries(await getCollection('article'))
const publishedArticles = allArticles.filter((article) => article.data.published !== false)

// Sort by latest date
const sortByDateDesc = (a: any, b: any) => {
  const dateA = new Date(a.data.pubDate || a.data.updatedDate || '2024-01-01').getTime()
  const dateB = new Date(b.data.pubDate || b.data.updatedDate || '2024-01-01').getTime()
  return dateB - dateA
}

publishedArticles.sort(sortByDateDesc)

// Get top 3 latest articles
const latestPosts = publishedArticles.slice(0, 3)

// Hardcoded Monthly Supporters list (same as nomad_directory.astro)
const monthlySupporters = [
  'DataBench',
  'Max Browser',
  'DataBench (Max Browser)', // in case it's stored with the full name
  'Max',
  'NomadTax Bulgaria Ltd.',
  'Colive Fukuoka',
  'The Center for Competitiveness and Innovation (Colombia)',
  // Add more supporter company names here as needed
]

// Hardcoded Featured Partners list (companies advertising in next edition)
const featuredPartners = [
  'Colive Fukuoka',
  'Falmouth University',
  'InterNations',
  'NomadTax Bulgaria Ltd.',
  'Max Browser',
  'Coconut-Office'
]

// Pinned items (always first in the list)
const pinnedItems = [
  'SSBM Consulting LLC',
  'Coconut-Office'
]

// Featured items (shown with Featured badge and pinned near top)
const featuredItems = [
  'SSBM Consulting LLC',
  'DataBench'
]

// Helper function to check if a record is a supporter
const isSupporter = (record: any) => {
  return record.supporter || 
         record.monthly_supporter || 
         record.is_supporter || 
         record.supporter_status === 'Monthly Supporter' ||
         monthlySupporters.includes(record.title)
}

// Helper function to check if a record is featured
const isFeatured = (record: any) => {
  return featuredItems.includes(record.title)
}

// Get all valid directory entries and sort pinned first, then featured partners, then supporters
const allValidEntries = records
  .filter((record: any) => record.sf4ad525dd && record.title && record.scea90e502)
  .sort((a: any, b: any) => {
    const aIsPinned = pinnedItems.includes(a.title)
    const bIsPinned = pinnedItems.includes(b.title)
    const aIsFeaturedItem = isFeatured(a)
    const bIsFeaturedItem = isFeatured(b)
    const aIsFeaturedPartner = featuredPartners.includes(a.title)
    const bIsFeaturedPartner = featuredPartners.includes(b.title)
    const aSupporterStatus = isSupporter(a)
    const bSupporterStatus = isSupporter(b)
    
    // Pinned items go first
    if (aIsPinned && !bIsPinned) return -1
    if (!aIsPinned && bIsPinned) return 1
    
    // Featured items go second
    if (aIsFeaturedItem && !bIsFeaturedItem) return -1
    if (!aIsFeaturedItem && bIsFeaturedItem) return 1
    
    // Featured partners go third
    if (aIsFeaturedPartner && !bIsFeaturedPartner) return -1
    if (!aIsFeaturedPartner && bIsFeaturedPartner) return 1
    
    // Then supporters
    if (aSupporterStatus && !bSupporterStatus) return -1
    if (!aSupporterStatus && bSupporterStatus) return 1
    
    return 0 // Keep original order for same type
  })
  .map((record: any) => ({
    title: record.title,
    description: record.scea90e502,
    category: record.sb685ab800?.label || 'Service',
    link: record.link || record.sb788c266b?.[0] || '/nomad_directory',
    image: record.image,
    isSupporter: isSupporter(record),
    isFeatured: featuredPartners.includes(record.title),
    isFeaturedItem: isFeatured(record)
  }))

// Get first 12 entries for regular display (4 rows x 3 columns, with featured partners first)
const regularDirectoryEntries = allValidEntries.slice(0, 12)

// Prepare sticky bar items - mix of announcements, directory, articles, and partnership
const stickyBarItems = [
  // Partnership CTA
  {
    type: 'announcement' as const,
    title: 'Partner with Nomad Magazine - Reach 100+ Coworking Spaces Worldwide',
    link: '/brand-placement-next-edition-847291/',
    badge: 'PARTNER'
  },
  // Key announcements
  {
    type: 'announcement' as const,
    title: 'Casa Marianas Hiring Social Media Manager in Saipan',
    link: '#announcements',
    badge: 'HIRING'
  },
  {
    type: 'announcement' as const,
    title: 'Nomad Experience Japan - March 2-27, 2026',
    link: '#announcements',
    badge: 'EVENT'
  },
  {
    type: 'announcement' as const,
    title: 'Wonder House Coliving Manager - €900/month + Accommodation',
    link: '#announcements',
    badge: 'OPPORTUNITY'
  },
  {
    type: 'announcement' as const,
    title: 'Nomadicards Looking for New Home - Free Handover',
    link: '#announcements',
    badge: 'NEW'
  },
  // Top directory entries
  ...allValidEntries.slice(0, 3).map((entry: any) => ({
    type: 'directory' as const,
    title: `${entry.title} - ${entry.category}`,
    link: entry.link,
    badge: 'DIRECTORY'
  })),
  // Latest articles
  ...latestPosts.slice(0, 2).map((post: any) => ({
    type: 'article' as const,
    title: post.data.title,
    link: `/articles/${post.slug}/`,
    badge: 'ARTICLE'
  }))
]

// YouTube channel videos
const youtubeVideos = [
  {
    id: 'mEP3aAA3t8k',
    title: 'Have Digital Nomads Have Changed Bansko (Bulgaria)?',
    description: 'In this documentary episode, we explore how digital nomads, coworking spaces, and events like Bansko Nomad Fest slowly transformed the town into a year-round hub for remote workers, founders, families, and creatives from around the world.',
    thumbnail: 'https://img.youtube.com/vi/mEP3aAA3t8k/hqdefault.jpg',
    duration: 'N/A',
    views: 'New',
    publishedAt: '2025-01-03'
  },
  {
    id: 'pgTpfH7zNVs',
    title: 'Why Digital Nomads Are Choosing Buenos Aires in 2025',
    description: 'Discover what makes Buenos Aires a top destination for digital nomads in 2025.',
    thumbnail: 'https://img.youtube.com/vi/pgTpfH7zNVs/hqdefault.jpg',
    duration: '18:45',
    views: '12.3K',
    publishedAt: '2025-01-20'
  },
  {
    id: 'NgG92Q8Uxgg',
    title: 'Why Digital Nomads Are Choosing Madeira in 2024: Madeira Friends Founders and Community',
    description: 'Meet the founders behind Madeira Friends and discover why digital nomads are flocking to this Portuguese island.',
    thumbnail: 'https://img.youtube.com/vi/NgG92Q8Uxgg/hqdefault.jpg',
    duration: '14:22',
    views: '8.7K',
    publishedAt: '2025-01-18'
  },
  {
    id: '_sBXTskL0gA',
    title: 'Why Digital Nomads Choose Chiang Mai?',
    description: 'Exploring what makes Chiang Mai, Thailand one of the top destinations for digital nomads worldwide.',
    thumbnail: 'https://img.youtube.com/vi/_sBXTskL0gA/hqdefault.jpg',
    duration: '16:33',
    views: '15.9K',
    publishedAt: '2025-01-15'
  },
  {
    id: 'hElNoT15fBE',
    title: 'She Found a Hidden Gem in Guatemala — and Built a Co-Living There',
    description: 'Bianca Bonilla left her comfort zone to build something extraordinary — a co-living villa on the Pacific coast of Guatemala, in a fishing village that didn\'t even have internet just a few years ago.',
    thumbnail: 'https://img.youtube.com/vi/hElNoT15fBE/hqdefault.jpg',
    duration: '13:44',
    views: '32',
    publishedAt: '2025-01-12'
  },
  {
    id: 'lEtXdzH65Dk',
    title: 'How to Fly Business Class for $6: Trevor Wright\'s Travel Hack That Changed Everything',
    description: 'Trevor Wright is the founder of MileMethod.com, a business that helps Americans travel the world in luxury — without breaking the bank. In this interview, he shares how he turned a backpacker\'s obsession with saving money into a 10-year business, helping clients book $20,000 trips for under $1,000 by using U.S. credit card rewards.',
    thumbnail: 'https://img.youtube.com/vi/lEtXdzH65Dk/hqdefault.jpg',
    duration: '15:26',
    views: '160',
    publishedAt: '2024-10-10'
  },
  {
    id: 'wnVgPO4pGU8',
    title: 'Building Business on the Move: Ben Guez\'s Digital Nomad Story',
    description: 'Join us in Madeira at Nomad Island Fest as we speak with Ben Guez — an entrepreneur, angel investor, and content creator with a truly global perspective. Originally from France and now based in the US, Ben shares his journey into the digital nomad lifestyle, his inspiration to build a tech platform for co-living on demand called Airmeet, and his vision for creating meaningful connections at nomad events.',
    thumbnail: 'https://img.youtube.com/vi/wnVgPO4pGU8/hqdefault.jpg',
    duration: '13:45',
    views: '209',
    publishedAt: '2024-08-01'
  }
]

import { createWebSiteSchema } from '~/utils/schema'

const seo: SEOProps = {
  title: 'Nomad Magazine - The First Global Digital Nomad Magazine',
  description: 'The first global digital nomad magazine. For people who work and live everywhere (or dream of it). Inspiring stories from nomads around the world.',
  image: `${Astro.site}images/magazine-hold-against-chest.webp`,
  keywords: 'digital nomad magazine, remote work, nomad lifestyle, travel, coworking, nomad community, global nomads',
  canonical: `${Astro.site}`,
  ldJSON: createWebSiteSchema({ url: Astro.site?.toString() }),
}
---

<Layout seo={seo}>
  <div class="mx-auto max-w-7xl px-4 py-8 sm:py-12 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 items-center gap-8 sm:gap-16 lg:grid-cols-2">
      <div class="space-y-6 sm:space-y-8">
        <div class="space-y-4 sm:space-y-6">
          <p class="font-justme text-4xl text-gray-800">the first global digital nomad magazine</p>
          <h1 class="md:text-12xl xl:text-22xl text-7xl font-semibold text-gray-900 xl:leading-18">This magazine will show you the Digital Nomad World 🌴</h1>
          <div class="space-y-3 text-lg text-gray-700">
            <p class="flex items-center">
              <CheckIcon class="mr-2 h-6 w-6 flex-shrink-0 text-black" aria-hidden="true" />
              <span>Made for people brave enough to travel and live life differently</span>
            </p>
            <p class="flex items-center">
              <CheckIcon class="mr-2 h-6 w-6 flex-shrink-0 text-black" aria-hidden="true" />
              <span>Discover amazing places to travel, work from, and meet like-minded people</span>
            </p>
            <p class="flex items-center">
              <CheckIcon class="mr-2 h-6 w-6 flex-shrink-0 text-black" aria-hidden="true" />
              <span>Learn how to make money, stay healthy, and live your best nomadic life</span>
            </p>
          </div>
        </div>
        <div class="space-y-4">
          <div class="mb-2 flex flex-col gap-4 sm:flex-row sm:items-end">
            <div class="flex flex-col items-center order-first sm:order-last">
              <span class="mb-1 inline-block rounded-full bg-yellow-400 px-3 py-1 text-xs font-bold text-black uppercase tracking-wide shadow">OUT NOW</span>
            <a
              href="/editions/fourth-edition/"
              class="glow-animate w-full sm:w-auto inline-block rounded border-2 border-yellow-400 bg-black px-6 sm:px-8 py-3 text-center text-base sm:text-lg font-extrabold text-yellow-400 transition-colors duration-200 hover:bg-yellow-400 hover:text-black focus:outline-none focus:ring-2 focus:ring-yellow-300"
              aria-label="View the new fourth edition of Nomad Magazine"
            >
              EDITION #4 >>
            </a>
            </div>
            <a
              href="/editions"
              class="w-full sm:w-auto inline-block rounded bg-yellow-400 px-6 sm:px-8 py-3 text-center text-base sm:text-lg font-extrabold text-black shadow-md transition-transform duration-200 hover:scale-105 hover:shadow-lg focus:outline-none focus:ring-2 focus:ring-yellow-300 order-last sm:order-first"
              aria-label="View all magazine editions"
            >
              VIEW ALL EDITIONS
            </a>
          </div>
          <div class="mt-2 text-xs sm:text-sm text-gray-700">
            P.S. It's nice to get away from screens once in a while! <a href="/blog/7-tips-for-balancing-work-and-travel/" class="text-gray-800 hover:text-gray-900">Learn how to balance work and travel</a>.
          </div>
        </div>
      </div>
      <div class="flex justify-center lg:justify-end order-first lg:order-last">
        <MagazineStack showLatestBadge={true} className="max-w-full" />
      </div>
    </div>
  </div>
  
  <div class="bg-hoverw text-white">
    <ThirdEdition />
    <PastEditions />
    <MagazinePreview />
    
    <!-- Nomad Directory Section -->
    <section class="border-b border-neutral-800 bg-neutral-900/30 px-4 py-16 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="mb-12 flex items-center justify-between">
          <div>
            <h2 class="text-3xl font-bold text-white">Nomad Directory</h2>
            <p class="mt-2 text-lg text-neutral-400">Latest tools, services, and companies for digital nomads</p>
          </div>
          <a
            href="/nomad_directory"
            class="inline-flex items-center gap-2 rounded-lg bg-yellow-400 px-4 py-2 text-sm font-bold text-black transition-all hover:bg-yellow-300"
            aria-label="View all entries in the Nomad Directory"
          >
            View All
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
        </div>
        
        <!-- Regular Directory Entries -->
        <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
          {regularDirectoryEntries.map((entry: any) => (
            <div class={`group relative overflow-hidden rounded-xl border transition-all hover:border-yellow-400/50 ${
              entry.isFeaturedItem
                ? 'bg-gradient-to-br from-blue-900/20 to-blue-800/20 border-blue-500/30' 
                : entry.isFeatured
                  ? 'bg-gradient-to-br from-purple-900/20 to-blue-900/20 border-purple-500/30' 
                  : 'bg-neutral-900/50 border-white/10'
            }`}>
              <div class="p-5">
                <div class="flex gap-4">
                  <!-- Logo -->
                  <div class="flex-shrink-0">
                    <div class={`w-28 h-28 rounded-xl overflow-hidden flex items-center justify-center ${
                      ['Fresh Global', 'Falmouth University', 'SUMA', 'Scaglia y Asociados', 'goldenweeks'].includes(entry.title)
                        ? 'bg-gray-800' 
                        : 'bg-white'
                    }`}>
                      {entry.image && entry.image !== '/logo.svg' ? (
                        <img 
                          src={entry.image} 
                          alt={entry.title} 
                          class="w-full h-auto object-contain"
                        />
                      ) : (
                        <span class={`font-bold text-3xl ${
                          ['Fresh Global', 'Falmouth University', 'SUMA', 'Scaglia y Asociados', 'goldenweeks'].includes(entry.title)
                            ? 'text-white'
                            : 'text-black'
                        }`}>
                          {entry.title.charAt(0).toUpperCase()}
                        </span>
                      )}
                    </div>
                  </div>
                  
                  <!-- Content -->
                  <div class="flex-1 min-w-0">
                    <!-- Title and Badges -->
                    <div class="mb-2">
                      <h3 class="text-lg font-bold text-white mb-1.5">{entry.title}</h3>
                      <div class="flex items-center gap-2 flex-wrap">
                        <span class={`inline-block rounded-full px-2.5 py-0.5 text-xs font-medium ${
                          entry.category === 'Insurance' ? 'bg-blue-500/20 text-blue-300' :
                          entry.category === 'Community' ? 'bg-green-500/20 text-green-300' :
                          entry.category === 'Platform' ? 'bg-purple-500/20 text-purple-300' :
                          entry.category === 'Events' ? 'bg-orange-500/20 text-orange-300' :
                          entry.category === 'App' ? 'bg-indigo-500/20 text-indigo-300' :
                          'bg-gray-500/20 text-gray-300'
                        }`}>
                          {entry.category}
                        </span>
                        {entry.isFeaturedItem && (
                          <span
                            class="inline-flex items-center gap-1 bg-gradient-to-r from-blue-500 to-blue-600 text-white px-2 py-0.5 rounded-full text-xs font-bold"
                            title="Featured"
                          >
                            <svg width="10" height="10" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                              <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
                            </svg>
                            Featured
                          </span>
                        )}
                        {entry.isSupporter && (
                          <a
                            href="/support-the-magazine"
                            class="inline-flex items-center gap-1 bg-gradient-to-r from-red-600 to-red-700 text-white px-2 py-0.5 rounded-full text-xs font-bold hover:from-red-700 hover:to-red-800 transition-all duration-200"
                            title="Monthly Supporter"
                            aria-label="Monthly Supporter - Learn how to support the magazine"
                          >
                            <svg width="10" height="10" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                              <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                            </svg>
                            Supporter
                          </a>
                        )}
                        {entry.isFeatured && (
                          <span
                            class="inline-flex items-center gap-1 bg-gradient-to-r from-purple-600 to-blue-600 text-white px-2 py-0.5 rounded-full text-xs font-bold"
                            title="Featured"
                          >
                            <svg width="10" height="10" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                            </svg>
                            Featured
                          </span>
                        )}
                      </div>
                    </div>
                    
                    <!-- Description -->
                    <p class="text-sm text-neutral-300 line-clamp-2 mb-3 leading-relaxed">
                      {entry.description}
                    </p>
                    
                    <!-- CTA -->
                    <a 
                      href={entry.link}
                      target={entry.link.startsWith('http') ? '_blank' : '_self'}
                      rel={entry.link.startsWith('http') ? 'noopener noreferrer' : undefined}
                      class="inline-flex items-center text-yellow-400 text-sm font-medium hover:text-yellow-300 transition-colors"
                    >
                      Learn more →
                    </a>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
        
        <div class="mt-12 text-center">
          <a
            href="/nomad_directory"
            class="inline-flex items-center gap-2 rounded-lg bg-yellow-400 px-6 py-3 text-sm font-bold text-black transition-all hover:bg-yellow-300 hover:scale-105"
            aria-label="Browse the full Nomad Directory"
          >
            Browse Full Directory
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
        </div>
      </div>
    </section>

    <!-- Community Announcements -->
    <section id="announcements" class="border-b border-neutral-800 bg-gradient-to-b from-neutral-900/30 to-neutral-900/50 px-4 py-16 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="mb-12 text-center">
          <div class="inline-flex items-center justify-center gap-2 mb-4">
            <span class="text-4xl">📢</span>
            <h2 class="text-3xl font-bold text-white">Community <span class="text-yellow-400">Announcements</span></h2>
          </div>
          <p class="mt-2 text-lg text-neutral-400">Opportunities, events, and updates from the nomad ecosystem</p>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <!-- Nomadicards -->
          <div class="group bg-gradient-to-br from-white/5 to-white/[0.02] backdrop-blur-sm border border-white/10 rounded-2xl p-6 hover:border-yellow-400/50 hover:shadow-xl hover:shadow-yellow-400/10 transition-all duration-300 cursor-pointer" onclick="openAnnouncementModal('nomadicards')">
            <div class="flex items-start justify-between mb-4">
              <span class="inline-flex items-center gap-1.5 bg-orange-500/20 text-orange-400 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider border border-orange-500/30">
                <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>
                </svg>
                Community
              </span>
            </div>
            <h3 class="text-lg font-bold text-white mb-3 group-hover:text-yellow-400 transition-colors">Nomadicards is Looking for a New Home</h3>
            <p class="text-sm text-gray-300 leading-relaxed mb-4 line-clamp-4">
              Nomadicards has been on the road for a while now — passed around colivings, pulled out at dinner tables, and used to spark the kind of conversations that make nomad communities feel like home. I'd love for the project to find a new home and a new life. If that someone might be you, I'd be happy to hand Nomadicards over at no cost. — Francesco
            </p>
            <div class="flex items-center justify-between mt-auto pt-4 border-t border-white/10">
              <span class="text-xs text-gray-400 font-medium">Free Handover</span>
              <button class="inline-flex items-center gap-1 text-blue-400 hover:text-blue-300 text-sm font-medium transition-colors group" aria-label="Read more about Nomadicards">
                Read More
                <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              </button>
            </div>
          </div>

          <!-- Casa Marianas -->
          <div class="group bg-gradient-to-br from-white/5 to-white/[0.02] backdrop-blur-sm border border-white/10 rounded-2xl p-6 hover:border-yellow-400/50 hover:shadow-xl hover:shadow-yellow-400/10 transition-all duration-300 cursor-pointer" onclick="openAnnouncementModal('casa-marianas')">
            <div class="flex items-start justify-between mb-4">
              <span class="inline-flex items-center gap-1.5 bg-green-500/20 text-green-400 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider border border-green-500/30">
                <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
