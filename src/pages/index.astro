---
import About from '~/components/About.astro'
import Bridge from '~/components/Bridge.astro'
import CheckIcon from '~icons/ic/baseline-check'
import OurTeam from '~/components/OurTeam.astro'
import Welcome from '~/components/Welcome.astro'
import Mission from '~/components/Mission.astro'
import Partners from '~/components/Partners.astro'
import Subscribe from '~/components/Subscribe.astro'
import GetInvolved from '~/components/GetInvolved.astro'
import FooterLinks from '~/components/FooterLinks.astro'
import Testimonials from '~/components/Testimonials.astro'
import ThirdEdition from '~/components/ThirdEdition.astro'
import PastEditions from '~/components/PastEditions.astro'
import Layout, { type SEOProps } from '~/layouts/Layout.astro'
import BrandPlacement from '~/components/BrandPlacement.astro'
import StickyBrandPlacement from '~/components/StickyBrandPlacement.astro'
import MagazinePreview from '~/components/MagazinePreview.astro'
import GrowingCommunity from '~/components/GrowingCommunity.astro'

// YouTube channel videos
const youtubeVideos = [
  {
    id: 'pgTpfH7zNVs',
    title: 'Why Digital Nomads Are Choosing Buenos Aires in 2025',
    description: 'Discover what makes Buenos Aires a top destination for digital nomads in 2025.',
    thumbnail: 'https://img.youtube.com/vi/pgTpfH7zNVs/hqdefault.jpg',
    duration: '18:45',
    views: '12.3K',
    publishedAt: '2025-01-20'
  },
  {
    id: 'NgG92Q8Uxgg',
    title: 'Why Digital Nomads Are Choosing Madeira in 2024: Madeira Friends Founders and Community',
    description: 'Meet the founders behind Madeira Friends and discover why digital nomads are flocking to this Portuguese island.',
    thumbnail: 'https://img.youtube.com/vi/NgG92Q8Uxgg/hqdefault.jpg',
    duration: '14:22',
    views: '8.7K',
    publishedAt: '2025-01-18'
  },
  {
    id: '_sBXTskL0gA',
    title: 'Why Digital Nomads Choose Chiang Mai?',
    description: 'Exploring what makes Chiang Mai, Thailand one of the top destinations for digital nomads worldwide.',
    thumbnail: 'https://img.youtube.com/vi/_sBXTskL0gA/hqdefault.jpg',
    duration: '16:33',
    views: '15.9K',
    publishedAt: '2025-01-15'
  },
  {
    id: 'hElNoT15fBE',
    title: 'She Found a Hidden Gem in Guatemala — and Built a Co-Living There',
    description: 'Bianca Bonilla left her comfort zone to build something extraordinary — a co-living villa on the Pacific coast of Guatemala, in a fishing village that didn\'t even have internet just a few years ago.',
    thumbnail: 'https://img.youtube.com/vi/hElNoT15fBE/hqdefault.jpg',
    duration: '13:44',
    views: '32',
    publishedAt: '2025-01-12'
  },
  {
    id: 'lEtXdzH65Dk',
    title: 'How to Fly Business Class for $6: Trevor Wright\'s Travel Hack That Changed Everything',
    description: 'Trevor Wright is the founder of MileMethod.com, a business that helps Americans travel the world in luxury — without breaking the bank. In this interview, he shares how he turned a backpacker\'s obsession with saving money into a 10-year business, helping clients book $20,000 trips for under $1,000 by using U.S. credit card rewards.',
    thumbnail: 'https://img.youtube.com/vi/lEtXdzH65Dk/hqdefault.jpg',
    duration: '15:26',
    views: '160',
    publishedAt: '2024-10-10'
  },
  {
    id: 'wnVgPO4pGU8',
    title: 'Building Business on the Move: Ben Guez\'s Digital Nomad Story',
    description: 'Join us in Madeira at Nomad Island Fest as we speak with Ben Guez — an entrepreneur, angel investor, and content creator with a truly global perspective. Originally from France and now based in the US, Ben shares his journey into the digital nomad lifestyle, his inspiration to build a tech platform for co-living on demand called Airmeet, and his vision for creating meaningful connections at nomad events.',
    thumbnail: 'https://img.youtube.com/vi/wnVgPO4pGU8/hqdefault.jpg',
    duration: '13:45',
    views: '209',
    publishedAt: '2024-08-01'
  }
]

const seo: SEOProps = {
  title: 'Nomad Magazine - The First Global Digital Nomad Magazine',
  description: 'The first global digital nomad magazine. For people who work and live everywhere (or dream of it). Inspiring stories from nomads around the world.',
  image: `${Astro.site}images/magazine-hold-against-chest.webp`,
  keywords: 'digital nomad magazine, remote work, nomad lifestyle, travel, coworking, nomad community, global nomads',
  ldJSON: {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Nomad Magazine',
    url: Astro.site,
    description: 'The first global digital nomad magazine',
    publisher: {
      '@type': 'Organization',
      name: 'Nomad Magazine',
      logo: {
        '@type': 'ImageObject',
        url: `${Astro.site}logo.svg`,
      },
    },
    potentialAction: {
      '@type': 'SubscribeAction',
      target: `${Astro.site}newsletter`,
    },
  },
}
---

<Layout seo={seo}>
  <div class="mx-auto max-w-7xl px-4 py-8 sm:py-12 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 items-center gap-8 sm:gap-16 lg:grid-cols-2">
      <div class="space-y-6 sm:space-y-8">
        <div class="space-y-4 sm:space-y-6">
          <p class="font-justme text-4xl text-gray-800">the first global digital nomad magazine</p>
          <h1 class="md:text-12xl xl:text-22xl text-7xl font-semibold text-gray-900 xl:leading-18">This magazine will show you the Digital Nomad World 🌴</h1>
          <div class="space-y-3 text-lg text-gray-700">
            <p class="flex items-center">
              <CheckIcon class="mr-2 h-6 w-6 flex-shrink-0 text-black" />
              <span>Made for people brave enough to travel and live life differently</span>
            </p>
            <p class="flex items-center">
              <CheckIcon class="mr-2 h-6 w-6 flex-shrink-0 text-black" />
              <span>Discover amazing places to travel, work from, and meet like-minded people</span>
            </p>
            <p class="flex items-center">
              <CheckIcon class="mr-2 h-6 w-6 flex-shrink-0 text-black" />
              <span>Learn how to make money, stay healthy, and live your best nomadic life</span>
            </p>
          </div>
        </div>
        <div class="space-y-4">
          <div class="mb-2 flex flex-col gap-4 sm:flex-row sm:items-end">
            <div class="flex flex-col items-center order-first sm:order-last">
              <span class="mb-1 inline-block rounded-full bg-yellow-400 px-3 py-1 text-xs font-bold text-black uppercase tracking-wide shadow">Latest Edition</span>
              <a
                href="/editions/third-edition"
                class="glow-animate w-full sm:w-auto inline-block rounded border-2 border-yellow-400 bg-black px-6 sm:px-8 py-3 text-center text-base sm:text-lg font-extrabold text-yellow-400 transition-colors duration-200 hover:bg-yellow-400 hover:text-black focus:outline-none focus:ring-2 focus:ring-yellow-300"
              >
                NEW EDITION >>
              </a>
            </div>
            <a
              href="/editions"
              class="w-full sm:w-auto inline-block rounded bg-yellow-400 px-6 sm:px-8 py-3 text-center text-base sm:text-lg font-extrabold text-black shadow-md transition-transform duration-200 hover:scale-105 hover:shadow-lg focus:outline-none focus:ring-2 focus:ring-yellow-300 order-last sm:order-first"
            >
              VIEW ALL EDITIONS
            </a>
          </div>
          <div class="mt-2 text-xs sm:text-sm text-gray-700">
            P.S. It's nice to get away from screens once in a while! <a href="/blog/7-tips-for-balancing-work-and-travel" class="text-gray-800 hover:text-gray-900">Learn how to balance work and travel</a>.
          </div>
        </div>
      </div>
      <div class="flex justify-center lg:justify-end order-first lg:order-last">
        <img 
          src="/images/magazine-hold-against-chest.webp" 
          alt="Person holding Nomad Magazine issues" 
          class="h-auto max-w-full rounded-lg shadow-lg object-cover" 
        />
      </div>
    </div>
  </div>
  <div class="relative">
    <img src="/images/paper-cut.webp" alt="" class="w-full" loading="lazy" />
  </div>
  <div class="bg-hoverw text-white">
    <ThirdEdition />
    <PastEditions />
    <MagazinePreview />
    
    <!-- YouTube Section -->
    <section class="border-b border-neutral-800 bg-neutral-900/30 px-4 py-16 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="mb-12 flex items-center justify-between">
          <div>
            <h2 class="text-3xl font-bold text-white">Latest Videos</h2>
            <p class="mt-2 text-lg text-neutral-400">Watch our latest content on YouTube</p>
          </div>
          <a 
            href="https://www.youtube.com/@Nomad-Magazine" 
            target="_blank"
            class="inline-flex items-center gap-2 rounded-lg bg-red-600 px-4 py-2 text-sm font-bold text-white transition-all hover:bg-red-700"
          >
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
            </svg>
            Subscribe
          </a>
        </div>
        
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
          {youtubeVideos.map((video) => (
            <div class="group relative overflow-hidden rounded-2xl bg-neutral-900/50 transition-all hover:bg-neutral-900/80 hover:scale-105">
              <div class="relative">
                <img
                  src={video.thumbnail}
                  alt={video.title}
                  class="aspect-video w-full object-cover"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
                <div class="absolute bottom-2 right-2 rounded bg-black/80 px-2 py-1 text-xs text-white">
                  {video.duration}
                </div>
                <div class="absolute inset-0 flex items-center justify-center">
                  <div class="rounded-full bg-red-600 p-4 transition-all group-hover:bg-red-700 group-hover:scale-110">
                    <svg class="h-8 w-8 text-white" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M8 5v14l11-7z"/>
                    </svg>
                  </div>
                </div>
              </div>
              <div class="p-6">
                <h3 class="mb-2 text-lg font-bold text-white group-hover:text-yellow-400 transition-colors">
                  <a href={`https://www.youtube.com/watch?v=${video.id}`} target="_blank" class="after:absolute after:inset-0">
                    {video.title}
                  </a>
                </h3>
                <p class="text-sm text-neutral-300 line-clamp-2">
                  {video.description}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
    
    <!-- Digital Nomad Insights Section -->
    <section class="border-b border-neutral-800 bg-neutral-900/30 px-4 py-16 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="mb-12">
          <h2 class="text-3xl font-bold text-white">Digital Nomad <del>Gossip</del> Insights</h2>
          <p class="mt-2 text-lg text-neutral-400">Latest articles, trends, and stories from the nomad community</p>
        </div>
        
        <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
                     <!-- Featured Article: July 2025 Updates -->
           <article class="group col-span-1 md:col-span-2 lg:col-span-1 overflow-hidden rounded-2xl bg-gradient-to-br from-yellow-500/20 to-orange-500/20 transition-all hover:from-yellow-500/30 hover:to-orange-500/30 hover:scale-105">
             <div class="relative aspect-video">
              <img
                src="https://assets.seobotai.com/cdn-cgi/image/quality=75,w=1536,h=1024/nomadgossip.com/688c80160d660161d1d3f11c-1754045203480.jpg"
                alt="Digital Nomad Trends July 2025"
                class="h-full w-full object-cover"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
              <div class="absolute top-4 left-4">
                <span class="inline-block rounded-full bg-yellow-400 px-3 py-1 text-xs font-bold text-black uppercase">Featured</span>
              </div>
            </div>
            <div class="p-6">
              <h3 class="mb-3 text-xl font-bold text-white group-hover:text-yellow-400 transition-colors">
                <a href="/blog/what-happened-in-the-digital-nomad-world-in-july-2025-key-updates-trends" class="after:absolute after:inset-0">
                  What Happened in the Digital Nomad World in July 2025: Key Updates & Trends
                </a>
              </h3>
              <p class="text-sm text-neutral-300 line-clamp-3">
                The digital nomad world is evolving fast. Over 50 million people now live as digital nomads, with new visa programs, emerging destinations, and lifestyle shifts.
              </p>
              <div class="mt-4 flex items-center text-xs text-neutral-400">
                <span>Martin Donadieu</span>
                <span class="mx-2">•</span>
                <span>Aug 1, 2025</span>
              </div>
            </div>
          </article>
          
                     <!-- Molly's Exhibition Article -->
           <article class="group relative overflow-hidden rounded-2xl bg-neutral-900/50 transition-all hover:bg-neutral-900/80 hover:scale-105">
             <div class="relative aspect-video">
               <img
                 src="/images/molly_nomad_exhibition_1029.webp"
                 alt="Molly Maine's NOMAD exhibition"
                 class="h-full w-full object-cover"
                 style="object-position: center 20%;"
                 loading="lazy"
               />
               <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
             </div>
            <div class="p-6">
              <h3 class="mb-3 text-lg font-bold text-white group-hover:text-yellow-400 transition-colors">
                <a href="/blog/molly-maine-nomad-exhibition-what-does-home-mean" class="after:absolute after:inset-0">
                  What Does Home Mean? Molly Maine's 'NOMAD' Exhibition
                </a>
              </h3>
              <p class="text-sm text-neutral-300 line-clamp-3">
                Through vivid illustrations and human storytelling, Molly Maine explores what "home" means for digital nomads in our changing world.
              </p>
              <div class="mt-4 flex items-center text-xs text-neutral-400">
                <span>Nomad Magazine</span>
                <span class="mx-2">•</span>
                <span>Jun 4, 2025</span>
              </div>
            </div>
          </article>
          
                     <!-- Nepal Digital Nomad Visa -->
           <article class="group relative overflow-hidden rounded-2xl bg-neutral-900/50 transition-all hover:bg-neutral-900/80 hover:scale-105">
             <div class="relative aspect-video">
               <img
                 src="https://assets.seobotai.com/nomadgossip.com/683a25740194258b64a9ebf9-1748643421402.jpg"
                 alt="Nepal Digital Nomad Visa"
                 class="h-full w-full object-cover"
                 loading="lazy"
               />
               <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
             </div>
            <div class="p-6">
              <h3 class="mb-3 text-lg font-bold text-white group-hover:text-yellow-400 transition-colors">
                <a href="/blog/why-nepals-new-digital-nomad-visa-could-be-the-game-changer-asia-needed" class="after:absolute after:inset-0">
                  Why Nepal's New Digital Nomad Visa Could Be Asia's Game Changer
                </a>
              </h3>
              <p class="text-sm text-neutral-300 line-clamp-3">
                Nepal launches a groundbreaking digital nomad visa with unique mountain experiences and affordable living costs.
              </p>
              <div class="mt-4 flex items-center text-xs text-neutral-400">
                <span>Martin Donadieu</span>
                <span class="mx-2">•</span>
                <span>Recent</span>
              </div>
            </div>
          </article>
          
                     <!-- Travel and Lifespan -->
           <article class="group relative overflow-hidden rounded-2xl bg-neutral-900/50 transition-all hover:bg-neutral-900/80 hover:scale-105">
             <div class="relative aspect-video">
               <img
                 src="https://assets.seobotai.com/cdn-cgi/image/quality=75,w=1536,h=1024/nomadgossip.com/686da0ab4659af06b63a1bd3-1752016898167.jpg"
                 alt="Travel and Wellbeing"
                 class="h-full w-full object-cover"
                 loading="lazy"
               />
               <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
             </div>
            <div class="p-6">
              <h3 class="mb-3 text-lg font-bold text-white group-hover:text-yellow-400 transition-colors">
                <a href="/blog/can-a-life-of-travel-extend-your-lifespan-exploring-the-science-behind-nomadic-wellbeing" class="after:absolute after:inset-0">
                  Can Travel Extend Your Lifespan? The Science Behind Nomadic Wellbeing
                </a>
              </h3>
              <p class="text-sm text-neutral-300 line-clamp-3">
                Exploring the science behind how travel and nomadic living can impact physical and mental health.
              </p>
              <div class="mt-4 flex items-center text-xs text-neutral-400">
                <span>Martin Donadieu</span>
                <span class="mx-2">•</span>
                <span>Recent</span>
              </div>
            </div>
          </article>
          
                     <!-- Sustainability Article -->
           <article class="group relative overflow-hidden rounded-2xl bg-neutral-900/50 transition-all hover:bg-neutral-900/80 hover:scale-105">
             <div class="relative aspect-video">
               <img
                 src="https://assets.seobotai.com/nomadgossip.com/683b98f00194258b64ab317b-1748741089686.jpg"
                 alt="Digital Nomad Sustainability"
                 class="h-full w-full object-cover"
                 loading="lazy"
               />
               <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
             </div>
            <div class="p-6">
              <h3 class="mb-3 text-lg font-bold text-white group-hover:text-yellow-400 transition-colors">
                <a href="/blog/is-the-digital-nomad-lifestyle-sustainable-challenges-myths-and-reality" class="after:absolute after:inset-0">
                  Is the Digital Nomad Lifestyle Sustainable? Myths vs Reality
                </a>
              </h3>
              <p class="text-sm text-neutral-300 line-clamp-3">
                Examining the environmental and social impact of digital nomadism and exploring sustainable practices.
              </p>
              <div class="mt-4 flex items-center text-xs text-neutral-400">
                <span>Martin Donadieu</span>
                <span class="mx-2">•</span>
                <span>Recent</span>
              </div>
            </div>
          </article>
          
                     <!-- Ikigai Article -->
           <article class="group relative overflow-hidden rounded-2xl bg-neutral-900/50 transition-all hover:bg-neutral-900/80 hover:scale-105">
             <div class="relative aspect-video">
              <img
                src="https://assets.seobotai.com/nomadgossip.com/681de85e5e3fe4823b5c1c42-1746792784646.jpg"
                alt="Nomadic Living and Ikigai"
                class="h-full w-full object-cover"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
            </div>
            <div class="p-6">
              <h3 class="mb-3 text-lg font-bold text-white group-hover:text-yellow-400 transition-colors">
                <a href="/blog/nomadic-living-and-ikigai-finding-your-why" class="after:absolute after:inset-0">
                  Nomadic Living and Ikigai: Finding Your Why
                </a>
              </h3>
              <p class="text-sm text-neutral-300 line-clamp-3">
                Combining the Japanese concept of Ikigai with digital nomadism to create a purposeful, fulfilling lifestyle.
              </p>
              <div class="mt-4 flex items-center text-xs text-neutral-400">
                <span>Martin Donadieu</span>
                <span class="mx-2">•</span>
                <span>May 9, 2025</span>
              </div>
            </div>
          </article>
        </div>
        
        <div class="mt-12 text-center">
          <a
            href="/blog"
            class="inline-flex items-center gap-2 rounded-lg bg-yellow-400 px-6 py-3 text-sm font-bold text-black transition-all hover:bg-yellow-300 hover:scale-105"
          >
            Read More Articles
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
        </div>
      </div>
    </section>
    
    <Partners />
    <Testimonials />
    <About />
    <GrowingCommunity />
    <Mission />
    <Bridge />
    <Welcome />
  </div>
  <OurTeam />
  <div class="bg-hoverw text-white">
    <BrandPlacement />
    <Subscribe tag="home" />
  </div>
  <div class="bg-gray-50">
    <GetInvolved />
    <FooterLinks />
  </div>
  
  <!-- Sticky Brand Placement Banner -->
  <StickyBrandPlacement />
</Layout>

<style>
@keyframes glow {
  0% { box-shadow: 0 0 0 0 #fde047; }
  50% { box-shadow: 0 0 16px 4px #fde047; }
  100% { box-shadow: 0 0 0 0 #fde047; }
}
.glow-animate {
  animation: glow 1.5s infinite;
}
.line-clamp-2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
</style>
