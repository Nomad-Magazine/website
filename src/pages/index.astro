      actions: '<a href="https://maxbrowser.com.au/downloads/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 bg-yellow-400 hover:bg-yellow-300 text-black px-6 py-3 rounded-lg font-bold transition-all" aria-label="Download Max Browser (opens in new tab)">Download →</a>'
    },
    'wonder-house': {
      title: 'Wonder House - Coliving Manager Scholarship',
      badge: '<span class="inline-flex items-center gap-1.5 bg-green-500/20 text-green-400 px-3 py-1.5 rounded-full text-sm font-bold uppercase tracking-wider border border-green-500/30"><svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>Opportunity · Near Barcelona</span>',
      content: `<p>Anya from Wonder House is looking for someone to help run their new coliving space in a stunning natural setting, just 1 hour from Barcelona.</p>
                <p><strong>Position Details:</strong></p>
                <ul class="list-disc list-inside space-y-1 ml-4">
                  <li>30 hours per week commitment</li>
                  <li>6-month duration</li>
                  <li>Accommodation included</li>
                  <li>€900 monthly scholarship (after trial period)</li>
                  <li>Located 1 hour from Barcelona</li>
                  <li>Beautiful natural setting</li>
                </ul>
                <p>A unique opportunity to gain coliving management experience while living in a stunning location near Barcelona.</p>`,
      actions: '<a href="mailto:hello@wonderhousecoliving.com" class="inline-flex items-center gap-2 bg-yellow-400 hover:bg-yellow-300 text-black px-6 py-3 rounded-lg font-bold transition-all" aria-label="Contact Wonder House about coliving manager position (opens email client)">Get Email →</a>'
    }
  };

  // Global functions for modal
  declare global {
    interface Window {
      openAnnouncementModal: (id: string) => void;
      closeAnnouncementModal: () => void;
    }
  }

  window.openAnnouncementModal = function(id: string) {
    const modal = document.getElementById('announcement-modal');
    const data = announcementData[id as keyof typeof announcementData];
    
    if (!modal || !data) return;
    
    const title = document.getElementById('modal-title');
    const badge = document.getElementById('modal-badge');
    const content = document.getElementById('modal-content');
    const actions = document.getElementById('modal-actions');
    
    if (title) title.textContent = data.title;
    if (badge) badge.innerHTML = data.badge;
    if (content) content.innerHTML = data.content;
    if (actions) actions.innerHTML = data.actions;
    
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';
  };

  window.closeAnnouncementModal = function() {
    const modal = document.getElementById('announcement-modal');
    if (!modal) return;
    
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.style.overflow = '';
  };

  // Close modal on background click
  document.getElementById('announcement-modal')?.addEventListener('click', function(e) {
    if (e.target === this) {
      window.closeAnnouncementModal();
    }
  });

  // Close modal on ESC key
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      window.closeAnnouncementModal();
    }
  });
</script>

