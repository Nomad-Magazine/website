---
import Layout, { type SEOProps } from '~/layouts/Layout.astro'

const seo: SEOProps = {
  title: '🖥️ Best Designed Co-Working Spaces Contest: Vote Now! - Nomad Newsletter',
  description: 'Help us find the most beautifully designed coworking spaces serving remote workers and digital nomads. Vote for your favorite space and get featured in Nomad Magazine.',
  image: `${Astro.site}images/vote-for-coworking.webp`,
  keywords: 'coworking design contest, beautiful coworking spaces, digital nomad workspace, remote work design, nomad directory, colive fukuoka',
  ogType: 'article',
  ldJSON: {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: 'Best Designed Co-Working Spaces Contest: Vote Now!',
    description: 'Help us find the most beautifully designed coworking spaces serving remote workers and digital nomads.',
    author: {
      '@type': 'Organization',
      name: 'Nomad Magazine',
    },
    publisher: {
      '@type': 'Organization',
      name: 'Nomad Magazine',
      logo: {
        '@type': 'ImageObject',
        url: `${Astro.site}logo.svg`,
      },
    },
    datePublished: '2025-09-11',
    url: `${Astro.site}newsletter-coworking-design-contest`,
  },
}

// Static directory listings data (matching the email content)
const directoryListings = [
  {
    name: "Max Browser",
    category: "APP",
    isSupporter: true,
    description: "Max is Australia's first privacy-based browser and VPN combo. We offer free membership with 10gb of VPN data per month.",
    url: "https://maxbrowser.com.au/",
    logo: "https://uooo.stripocdnplugin.email/content/7cca085cfa4e41fd85b70a24e0f3df60/lib/pluginId_7cca085cfa4e41fd85b70a24e0f3df60_74602/max_master_logo.png"
  },
  {
    name: "Entity Inc.",
    category: "SERVICE", 
    isSupporter: false,
    description: "From forming a US company to tax filings, compliance, and bookkeeping, Entity Inc. ensures businesses are tax-efficient and fully compliant.",
    url: "https://www.entity.inc/",
    logo: "https://uooo.stripocdnplugin.email/content/7cca085cfa4e41fd85b70a24e0f3df60/lib/pluginId_7cca085cfa4e41fd85b70a24e0f3df60_74602/entityinclogo2.png"
  },
  {
    name: "Nomad Summer Camp LLC",
    category: "EVENTS",
    isSupporter: false,
    description: "Adult summer camps for digital nomads around the world",
    url: "https://nomadsummercamp.com/",
    logo: "https://uooo.stripocdnplugin.email/content/7cca085cfa4e41fd85b70a24e0f3df60/lib/pluginId_7cca085cfa4e41fd85b70a24e0f3df60_74602/text_1.png"
  },
  {
    name: "Edge City",
    category: "OTHER",
    isSupporter: false,
    description: "We host monthlong popup villages where people at the frontiers of technology, science, and culture live and work together. Each village is an environment for running real experiments on new ideas and collaborations.",
    url: "https://www.edgecity.live/",
    logo: "https://uooo.stripocdnplugin.email/content/7cca085cfa4e41fd85b70a24e0f3df60/lib/pluginId_7cca085cfa4e41fd85b70a24e0f3df60_74602/logotype_1.png"
  },
  {
    name: "Diving Nomads",
    category: "COMMUNITY",
    isSupporter: false,
    description: "Diving Nomads is a global community for remote workers who love scuba diving. We partner with dive centers, colivings, and coworking spaces to make it easier for digital nomads to combine work and diving. Members get access to exclusive...",
    url: "https://divingnomads.club/",
    logo: "https://uooo.stripocdnplugin.email/content/7cca085cfa4e41fd85b70a24e0f3df60/lib/pluginId_7cca085cfa4e41fd85b70a24e0f3df60_74602/logo_diving_nomads_transparent.png"
  },
  {
    name: "Wanderwell Club",
    category: "COACHING",
    isSupporter: false,
    description: "Wanderwell Club helps remote workers and digital nomads purposefully slow travel their way to financial freedom.",
    url: "https://www.wanderwell.club/",
    logo: "https://uooo.stripocdnplugin.email/content/7cca085cfa4e41fd85b70a24e0f3df60/lib/pluginId_7cca085cfa4e41fd85b70a24e0f3df60_74602/wanderwellclub.png"
  },
  {
    name: "The Better Neighbors",
    category: "COLIVING",
    isSupporter: false,
    description: "We organize workation retreats. Explore mountain spas in Romania or seaside coliving in Spain—for under €700 a month with your own private room and bathroom. We curate retreats for digital nomads that combine affordable, wellness-focused living...",
    url: "https://www.thebetterneighbors.com/",
    logo: "https://uooo.stripocdnplugin.email/content/7cca085cfa4e41fd85b70a24e0f3df60/lib/pluginId_7cca085cfa4e41fd85b70a24e0f3df60_74602/logo_betterneighbors.png"
  },
  {
    name: "Remote Queer",
    category: "COMMUNITY",
    isSupporter: false,
    description: "Remote work and travel resources for LGBTQ+ digital nomads.",
    url: "https://remotequeer.co/",
    logo: "https://uooo.stripocdnplugin.email/content/7cca085cfa4e41fd85b70a24e0f3df60/lib/pluginId_7cca085cfa4e41fd85b70a24e0f3df60_74602/rqlogoexportwhitebg.png"
  },
  {
    name: "Casa Gori Coliving",
    category: "COLIVING",
    isSupporter: false,
    description: "We're a Coliving for Nomadic Entrepreneurs in Valencia. Opening in 2026!",
    url: "https://www.casagori.co/",
    logo: "https://uooo.stripocdnplugin.email/content/7cca085cfa4e41fd85b70a24e0f3df60/lib/pluginId_7cca085cfa4e41fd85b70a24e0f3df60_74602/logo.png"
  },
  {
    name: "TADAIMA SHIMODA",
    category: "COLIVING",
    isSupporter: false,
    description: '"TADAIMA 2025" Coliving Program to Connect Digital Nomads and Locals This November.',
    url: "https://tadaima-japan.jp/events/tadaima-shimoda-2025/",
    logo: "https://uooo.stripocdnplugin.email/content/7cca085cfa4e41fd85b70a24e0f3df60/lib/pluginId_7cca085cfa4e41fd85b70a24e0f3df60_74602/mingchengweishedingsutekkazhengfangxing_1.png"
  }
]

const getCategoryColor = (category: string) => {
  switch(category) {
    case 'APP': return 'bg-gradient-to-r from-yellow-400 to-amber-500 text-gray-900'
    case 'SERVICE': return 'bg-gradient-to-r from-yellow-400 to-amber-500 text-gray-900'
    case 'EVENTS': return 'bg-gradient-to-r from-yellow-400 to-amber-500 text-gray-900'
    case 'OTHER': return 'bg-gradient-to-r from-yellow-400 to-amber-500 text-gray-900'
    case 'COMMUNITY': return 'bg-gradient-to-r from-yellow-400 to-amber-500 text-gray-900'
    case 'COACHING': return 'bg-gradient-to-r from-yellow-400 to-amber-500 text-gray-900'
    case 'COLIVING': return 'bg-gradient-to-r from-yellow-400 to-amber-500 text-gray-900'
    default: return 'bg-gradient-to-r from-yellow-400 to-amber-500 text-gray-900'
  }
}
---

<Layout seo={seo}>
  <div class="bg-gray-50 min-h-screen">
    <!-- Header Section -->
    <header class="bg-gray-900 text-white">
      <div class="max-w-4xl mx-auto px-4 py-8 text-center">
        <img src="/logo.svg" alt="Nomad Magazine" class="mx-auto mb-4 h-12" />
        <p class="text-yellow-400 text-sm font-semibold uppercase tracking-wide">September 11, 2025</p>
      </div>
    </header>

    <!-- Main Content -->
    <main class="max-w-4xl mx-auto px-4 py-8 bg-white">

      <!-- Main Headline -->
      <div class="text-center mb-12">
        <div class="text-6xl mb-4">🖥️</div>
        <h1 class="text-4xl md:text-5xl font-black text-gray-900 mb-4 leading-tight">
          <strong>Best Designed</strong> Coworking Contest Launch
        </h1>
        <p class="text-lg text-gray-600 font-medium">Nominate & Vote for the Most Beautiful Workspace</p>
      </div>

      <!-- Contest Content -->
      <article class="prose prose-lg max-w-none mb-12">
        <p class="text-base text-gray-700 mb-4 leading-relaxed">
          From day one of Nomad Magazine's existence, we dreamed of celebrating the spaces that fuel our productivity. We've been fortunate to work with <strong class="text-gray-900">beautiful coworking spaces hosting our magazine</strong> — and we've been blown away by the creativity owners and designers put into crafting environments with remote workers' comfort in mind.
        </p>

        <p class="text-base text-gray-700 mb-4 leading-relaxed">
          Sure, there are many criteria that make a great workspace — community, internet, location. Sometimes all you need is a table and a chair. But <strong class="text-gray-900">no one puts design and beauty on a pedestal anymore</strong>. We want to change that.
        </p>

        <div class="bg-gray-50 border-l-4 border-orange-500 p-5 rounded-r-lg my-5">
          <p class="text-lg font-semibold text-gray-900">
            💡 Help us find the most beautifully designed coworking spaces serving remote workers and digital nomads every day
          </p>
        </div>

        <p class="text-base text-gray-700 mb-4 leading-relaxed">
          <strong class="text-gray-900">How it works:</strong> The winner will be selected through public votes, with final curation by the Nomad Magazine team and our partners as jury. We'll feature the most beautiful spaces in the next edition, sharing their stories and featuring the artistry behind exceptional design.
        </p>

        <p class="text-base text-gray-700 mb-4 leading-relaxed">
          Think: ✨ stunning interiors, 🌅 dreamy views, 🪑 ergonomic brilliance, and spaces that make you want to stay late 🌙
        </p>

        <p class="text-base text-gray-700 mb-4 leading-relaxed">
          <strong>Phase I</strong> - 🗓️ <strong class="text-gray-900">Nominate your favorite by September 30, 2025.</strong>
        </p>

        <p class="text-base text-gray-700 mb-4 leading-relaxed">
          <strong class="text-gray-900">Phase II -</strong> Help us crown the winner by <strong class="text-gray-900">voting</strong> 🗳️ before <strong class="text-gray-900">October 20</strong>.
        </p>

        <p class="text-base text-gray-700 mb-4 leading-relaxed">
          ❤️ Make your vote by reacting with a <strong class="text-gray-900">love heart</strong> to the co-working space you deem the best of the best.
        </p>

        <p class="text-base text-gray-700 mb-3 leading-relaxed">
          🏅 <strong class="text-gray-900">The co-working space with the most votes will be featured</strong> in an upcoming issue of <strong class="text-gray-900">Nomad Magazine</strong> 📰
        </p>

        <p class="text-base text-gray-700 mt-4 leading-relaxed italic">
          💭 Have ideas on how we can make this contest even better? We'd love to hear from you!
        </p>
      </article>

      <!-- Vote Button -->
      <div class="text-center mb-8">
        <a 
          href="https://nomad-magazine.com/coworking-spaces/" 
          class="inline-block bg-yellow-400 hover:bg-yellow-500 text-black font-bold py-4 px-8 rounded-xl shadow-lg transition-all duration-200 text-lg"
        >
          🗳️ PLACE YOUR VOTE
        </a>
      </div>

      <!-- Voting Example -->
      <div class="text-center mb-8">
        <p class="text-sm text-gray-600 font-semibold mb-2">How to vote - Example:</p>
        <img 
          src="/images/vote-for-coworking.webp" 
          alt="How to vote for coworking spaces - Example showing Betahaus Kreuzberg"
          class="mx-auto rounded-xl shadow-md max-w-md w-full"
        />
      </div>

      <!-- Divider -->
      <hr class="border-gray-900 my-8" />

      <!-- Magazine Pickup Section -->
      <section class="mb-12">
        <div class="text-center mb-6">
          <h2 class="text-3xl font-black text-gray-900 mb-2">
            📖 Get Your Magazine
          </h2>
          <p class="text-base text-gray-600 font-medium">Partner Pickup Available!</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center mb-6">
          <!-- Text Content -->
          <div class="prose prose-base max-w-none">
            <p class="text-base text-gray-700 mb-4 leading-relaxed">
              You still can get your <strong class="text-gray-900">Nomad Magazine Third Edition</strong> through door-to-door <strong>delivery</strong> or <strong>self-pickup</strong> at one of our amazing partner locations in Berlin, Amsterdam, Lisbon, Porto, Madeira and others. Skip the shipping and grab your copy directly!
            </p>

            <p class="text-base text-gray-700 mb-4 leading-relaxed">
              🏢 <strong class="text-gray-900">Partner pickup locations</strong> are the selected co-working spaces you'll visit.
            </p>

            <p class="text-base text-gray-700 leading-relaxed">
              Perfect for nomads who prefer the personal touch and want to support local businesses! 🌍
            </p>
          </div>

          <!-- Image -->
          <div class="flex justify-center md:justify-end">
            <img 
              src="/images/issue-003-on-yellow-background-with-flower.webp" 
              alt="Nomad Magazine Third Edition on yellow background"
              class="max-w-xs w-full rounded-lg shadow-md"
            />
          </div>
        </div>

        <div class="text-center">
          <a 
            href="https://nomad-magazine.com/editions/third-edition" 
            class="inline-block bg-gray-900 hover:bg-gray-800 text-white font-bold py-4 px-8 rounded-xl shadow-lg transition-all duration-200"
          >
            📖 ORDER PRINT MAGAZINE
          </a>
        </div>
      </section>

      <!-- Divider -->
      <hr class="border-gray-900 my-8" />

      <!-- Directory Section -->
      <section class="mb-12">
        <div class="text-center mb-6">
          <h2 class="text-3xl font-black text-gray-900 mb-2">
            🚀 Latest Directory Listings
          </h2>
          <p class="text-base text-gray-600 font-medium">New tools & services for nomads</p>
        </div>

        <p class="text-base text-gray-700 mb-6 leading-relaxed">
          Discover the newest additions to our nomad directory - tools, services, and communities that are shaping the future of remote work:
        </p>

        <!-- Directory Grid -->
        <div class="space-y-4 mb-6">
          {directoryListings.map((listing) => (
            <div class="border border-gray-200 rounded-2xl p-5 hover:border-orange-500 hover:shadow-lg transition-all duration-200 bg-white">
              <div class="flex gap-4">
                <div class="flex-shrink-0">
                  <div class={`w-16 h-16 rounded-xl flex items-center justify-center overflow-hidden p-1 ${
                    listing.name?.toLowerCase().includes('imaginethat') || 
                    listing.name?.toLowerCase().includes('imagine that') || 
                    listing.name?.toLowerCase().includes('entity inc') || 
                    listing.name?.toLowerCase().includes('edge city')
                      ? 'bg-white border border-gray-200' 
                      : 'bg-gray-50 border border-gray-200'
                  }`}>
                    {listing.logo ? (
                      <img 
                        src={listing.logo} 
                        alt={listing.name}
                        class="max-w-full max-h-full object-contain"
                      />
                    ) : (
                      <span class={`font-bold text-xl ${
                        listing.name?.toLowerCase().includes('imaginethat') || 
                        listing.name?.toLowerCase().includes('imagine that') || 
                        listing.name?.toLowerCase().includes('entity inc') || 
                        listing.name?.toLowerCase().includes('edge city')
                          ? 'text-black' 
                          : 'text-gray-600'
                      }`}>
                        {(listing.name || 'C').charAt(0).toUpperCase()}
                      </span>
                    )}
                  </div>
                </div>
                <div class="flex-1">
                  <div class="flex items-center gap-2 mb-1">
                    <h4 class="text-lg font-bold text-gray-900">{listing.name}</h4>
                    <span class={`px-2 py-1 rounded-full text-xs font-semibold uppercase tracking-wide ${getCategoryColor(listing.category)}`}>
                      {listing.category}
                    </span>
                    {listing.isSupporter && (
                      <span class="bg-gradient-to-r from-red-600 to-red-700 text-white px-2 py-1 rounded-full text-xs font-semibold uppercase tracking-wide">
                        SUPPORTER
                      </span>
                    )}
                  </div>
                  <p class="text-sm text-gray-600 leading-relaxed mb-2">{listing.description}</p>
                  <a 
                    href={listing.url} 
                    target="_blank"
                    class="text-sm text-orange-600 font-semibold hover:text-orange-700"
                  >
                    Learn more →
                  </a>
                </div>
              </div>
            </div>
          ))}
        </div>

        <div class="text-center">
          <a 
            href="https://nomad-magazine.com/nomad_directory" 
            class="inline-block bg-gray-900 hover:bg-gray-800 text-white font-normal py-3 px-6 rounded-xl transition-all duration-200"
          >
            🚀 VIEW ALL LISTINGS
          </a>
        </div>
      </section>

      <!-- Divider -->
      <hr class="border-gray-900 my-8" />

      <!-- YouTube Section -->
      <section class="mb-12">
        <div class="text-center mb-6">
          <h2 class="text-3xl font-black text-gray-900 mb-2">
            📺 YouTube: Why Chiang Mai?
          </h2>
          <p class="text-base text-gray-600 font-medium">New Episode Available Now</p>
        </div>

        <div class="prose prose-base max-w-none mb-6">
          <p class="text-base text-gray-700 mb-4 leading-relaxed">
            This episode explores what makes Chiang Mai, Thailand one of the top destinations for digital nomads worldwide. From affordable living costs to vibrant co-working spaces, discover why this city continues to attract remote workers from around the globe.
          </p>

          <p class="text-base text-gray-700 mb-4 leading-relaxed">
            📍 <strong class="text-gray-900">Filmed in January 2025</strong> at Punspace, Chiang Mai during Nomad Summit 2025
          </p>

          <div class="bg-gray-50 border-l-4 border-orange-500 p-4 rounded-r-lg my-4">
            <p class="text-sm text-gray-900 font-semibold">
              🗓️ <strong>Next Nomad Summit:</strong> January 17-18, 2026 in Chiang Mai
            </p>
          </div>
        </div>

        <div class="mb-6">
          <a href="https://www.youtube.com/watch?v=_sBXTskL0gA" target="_blank">
            <img 
              src="https://img.youtube.com/vi/_sBXTskL0gA/hqdefault.jpg" 
              alt="Why Digital Nomads Choose Chiang Mai"
              class="w-full rounded-xl"
            />
          </a>
        </div>

        <div class="text-center">
          <a 
            href="https://www.youtube.com/watch?v=_sBXTskL0gA" 
            target="_blank"
            class="inline-block bg-red-600 hover:bg-red-700 text-white font-normal py-3 px-6 rounded-xl transition-all duration-200"
          >
            ▶️ WATCH EPISODE
          </a>
        </div>
      </section>

      <!-- Divider -->
      <hr class="border-gray-900 my-8" />

      <!-- Colive Fukuoka Section -->
      <section class="mb-12">
        <div class="text-center mb-6">
          <h2 class="text-3xl font-black text-gray-900 mb-2 flex items-center justify-center gap-2">
            🇯🇵 Colive Fukuoka 2025
            <span class="bg-gradient-to-r from-red-600 to-red-700 text-white px-2 py-1 rounded-full text-xs font-semibold uppercase tracking-wide">
              SUPPORTER
            </span>
          </h2>
          <p class="text-base text-gray-600 font-medium">Asia's Premier Digital Nomad Festival</p>
        </div>

        <div class="prose prose-base max-w-none mb-6">
          <p class="text-base text-gray-700 mb-4 leading-relaxed">
            <strong class="text-gray-900">October 1-10, 2025</strong> | Fukuoka City, Japan 🗓️
          </p>

          <p class="text-base text-gray-700 mb-4 leading-relaxed">
            Join Asia's premier digital nomad festival featuring the theme <strong class="text-gray-900">"Envision Tomorrow Together"</strong>. From startup conferences to traditional Japanese cultural experiences, this 10-day festival transforms Fukuoka into the epicenter of Asia's digital nomad movement.
          </p>

          <div class="bg-gray-50 border-l-4 border-orange-500 p-4 rounded-r-lg my-4">
            <p class="text-sm text-gray-900 font-semibold">
              🎟️ <strong>Exclusive Offer:</strong> Use code <strong>GOSSIP</strong> for 20% off your ticket!
            </p>
          </div>

          <p class="text-base text-gray-700 mb-3 leading-relaxed">
            🌟 <strong class="text-gray-900">What's included:</strong>
          </p>

          <ul class="list-disc pl-6 space-y-3 text-sm text-gray-700">
            <li><strong>Colive Summit</strong> (Oct 1-3): Inspiring speakers exploring IKIGAI and Japanese philosophies</li>
            <li><strong>Cultural Excursions</strong> (Oct 6-10): Traditional Judo, Tea Ceremony, Sauna experiences</li>
            <li><strong>Synapse Festival</strong> (Oct 4-5): Music, art, and yoga on beautiful Nokonoshima Island</li>
            <li><strong>RAMEN TECH</strong> (Oct 6-12): Access to Asia's fastest-growing startup ecosystem (4K+ participants)</li>
          </ul>

          <p class="text-sm text-gray-600 mt-4 italic">
            2024 attracted 436 participants from 45 countries with 88% satisfaction rate
          </p>
        </div>

        <div class="text-center">
          <a 
            href="https://colivefukuoka.com" 
            target="_blank"
            class="inline-block bg-yellow-400 hover:bg-yellow-500 text-black font-bold py-4 px-8 rounded-xl shadow-lg transition-all duration-200"
          >
            🇯🇵 REGISTER NOW
          </a>
        </div>
      </section>
    </main>

    <!-- Footer -->
    <footer class="bg-gray-900 text-white">
      <div class="max-w-4xl mx-auto px-4 py-5 text-center">
        <p class="text-xs text-white">
          © 2025 Nomad Magazine. All rights reserved.<br>
          <a href="https://nomad-magazine.com" class="text-yellow-400 hover:underline">nomad-magazine.com</a> | 
          <a href="#" class="text-yellow-400 hover:underline">Unsubscribe</a>
        </p>
      </div>
    </footer>

    <!-- Back to Newsletter -->
    <div class="text-center py-6 bg-gray-50">
      <a 
        href="/newsletter" 
        class="inline-flex items-center text-gray-600 hover:text-gray-900 transition-colors duration-200"
      >
        <svg class="mr-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
        Back to Newsletter
      </a>
    </div>
  </div>
</Layout>
