---
import Layout, { type SEOProps } from '~/layouts/Layout.astro'

const seo: SEOProps = {
  title: 'Newsletter Guidelines - Partner with Nomad Magazine',
  description:
    'Guidelines for partners who want to contribute to the Nomad Magazine Newsletter. Create engaging content for our nomad community.',
  image: `${Astro.site}images/hands_pointing-left.webp`,
  keywords: 'newsletter guidelines, nomad magazine partnership, digital nomad newsletter, content guidelines',
  ogType: 'website',
  ldJSON: {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Newsletter Partnership Guide',
    description: 'Guidelines for partners who want to contribute to the Nomad Magazine Newsletter. Learn how to create engaging content for our global community of digital nomads.',
    publisher: {
      '@type': 'Organization',
      name: 'Nomad Magazine',
      logo: {
        '@type': 'ImageObject',
        url: `${Astro.site}logo.svg`,
      },
    },
    url: `${Astro.site}newsletter-guidelines/`,
  },
}
---

<Layout seo={seo}>
  <main class="min-h-screen bg-gray-50">
    <!-- Hero Section -->
    <div class="bg-gradient-to-b from-gray-900 to-gray-800 text-white">
      <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
        <div class="text-center">
          <div class="mb-6">
            <span class="inline-flex items-center rounded-full bg-yellow-400/20 px-4 py-2 text-sm font-medium text-yellow-400">
              📧 Partner Guidelines
            </span>
          </div>
          <h1 class="text-4xl font-bold tracking-tight sm:text-5xl lg:text-6xl">
            Newsletter Partnership Guide
          </h1>
          <p class="mt-6 text-xl text-gray-300 max-w-3xl mx-auto">
            Share your insights with our engaged community of 650+ digital nomads, remote workers, 
            creators, and travel-obsessed entrepreneurs worldwide.
          </p>
          <div class="mt-8 flex flex-col sm:flex-row gap-4 justify-center items-center">
            <div class="flex items-center space-x-2 text-yellow-400">
              <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
              </svg>
              <span class="font-semibold text-lg">650+ Subscribers</span>
            </div>
            <div class="flex items-center space-x-2 text-yellow-400">
              <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
              </svg>
              <span class="font-semibold text-lg">~50% Open Rate</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Partnership Options -->
    <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8 mt-8">
      <div class="text-center mb-8">
        <h2 class="text-2xl font-bold text-gray-900 mb-4">Choose Your Partnership Option</h2>
        <p class="text-gray-600">Select the format that works best for your content and goals</p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
        <!-- Newsletter Takeover -->
        <div class="bg-white rounded-xl shadow-lg border border-gray-200 p-8 relative">
          <div class="absolute -top-3 left-6">
            <span class="bg-blue-500 text-white px-4 py-1 rounded-full text-sm font-medium">Most Popular</span>
          </div>
          <div class="text-center mb-6">
            <div class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="h-8 w-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-2">Newsletter Takeover</h3>
            <p class="text-gray-600">Full feature section in our newsletter</p>
          </div>
          <div class="space-y-4">
            <div class="flex items-center space-x-3">
              <svg class="h-5 w-5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              <span class="text-gray-700">Up to 500 words</span>
            </div>
            <div class="flex items-center space-x-3">
              <svg class="h-5 w-5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              <span class="text-gray-700">1-2 links included</span>
            </div>
            <div class="flex items-center space-x-3">
              <svg class="h-5 w-5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              <span class="text-gray-700">Optional image</span>
            </div>
            <div class="flex items-center space-x-3">
              <svg class="h-5 w-5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              <span class="text-gray-700">Full content structure</span>
            </div>
            <div class="flex items-center space-x-3">
              <svg class="h-5 w-5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              <span class="text-gray-700">Maximum visibility</span>
            </div>
          </div>
        </div>

        <!-- Short Note -->
        <div class="bg-white rounded-xl shadow-lg border border-gray-200 p-8">
          <div class="text-center mb-6">
            <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="h-8 w-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z"/>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-2">Short Note</h3>
            <p class="text-gray-600">Quick mention or announcement</p>
          </div>
          <div class="space-y-4">
            <div class="flex items-center space-x-3">
              <svg class="h-5 w-5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              <span class="text-gray-700">One paragraph</span>
            </div>
            <div class="flex items-center space-x-3">
              <svg class="h-5 w-5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              <span class="text-gray-700">1 link maximum</span>
            </div>
            <div class="flex items-center space-x-3">
              <svg class="h-5 w-5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              <span class="text-gray-700">Quick & concise</span>
            </div>
            <div class="flex items-center space-x-3">
              <svg class="h-5 w-5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              <span class="text-gray-700">Perfect for updates</span>
            </div>
            <div class="flex items-center space-x-3">
              <svg class="h-5 w-5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              <span class="text-gray-700">Faster turnaround</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Quick Overview -->
    <div class="bg-yellow-50 border-l-4 border-yellow-400 mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8 mt-8">
      <div class="flex">
        <div class="flex-shrink-0">
          <svg class="h-6 w-6 text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </div>
        <div class="ml-3">
          <h3 class="text-lg font-medium text-yellow-800 mb-2">📌 Ready to Get Started?</h3>
          <p class="text-yellow-700 mb-3">
            Choose your preferred option above, then send your content via Google Doc to your NM contact person. We handle all formatting and editing to ensure it fits perfectly into our newsletter.
          </p>
          <div class="flex flex-wrap gap-2">
            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-yellow-200 text-yellow-800">
              Google Doc submission
            </span>
            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-yellow-200 text-yellow-800">
              We handle formatting
            </span>
            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-yellow-200 text-yellow-800">
              Human & friendly tone
            </span>
          </div>
        </div>
      </div>
    </div>

    <!-- Main Content -->
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <!-- Main Guidelines -->
        <div class="lg:col-span-2 space-y-12">
          
          <!-- Newsletter Takeover Requirements -->
          <section class="bg-white rounded-xl shadow-sm border border-gray-200 p-8">
            <div class="flex items-center mb-6">
              <div class="h-12 w-12 bg-blue-100 rounded-lg flex items-center justify-center mr-4">
                <svg class="h-6 w-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/>
                </svg>
              </div>
              <h2 class="text-2xl font-bold text-gray-900">Newsletter Takeover Requirements</h2>
            </div>
            
            <div class="space-y-6">
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="space-y-4">
                  <h3 class="font-semibold text-gray-900 flex items-center">
                    <span class="h-2 w-2 bg-blue-400 rounded-full mr-3"></span>
                    Length & Format
                  </h3>
                  <ul class="space-y-2 text-gray-600 ml-5">
                    <li>• Maximum 500 words</li>
                    <li>• Short paragraphs work best</li>
                    <li>• Bullet points encouraged</li>
                    <li>• Bold highlights for emphasis</li>
                  </ul>
                </div>
                
                <div class="space-y-4">
                  <h3 class="font-semibold text-gray-900 flex items-center">
                    <span class="h-2 w-2 bg-blue-400 rounded-full mr-3"></span>
                    Links & Media
                  </h3>
                  <ul class="space-y-2 text-gray-600 ml-5">
                    <li>• 1-2 links maximum</li>
                    <li>• Optional image</li>
                    <li>• Share image URL or attach file</li>
                    <li>• Emojis are welcome ✅</li>
                  </ul>
                </div>
              </div>
              
              <div class="bg-blue-50 rounded-lg p-6">
                <h3 class="font-semibold text-blue-900 mb-3 flex items-center">
                  <span class="h-2 w-2 bg-blue-400 rounded-full mr-3"></span>
                  Takeover Example
                </h3>
                <div class="bg-white rounded-lg p-4 border border-blue-200">
                  <div class="text-sm text-gray-600 mb-2">From our newsletter:</div>
                  <div class="space-y-3 text-sm">
                    <p class="font-semibold text-gray-900">Meet our guest 👂</p>
                    <p>Hi, I'm <strong>Ryo</strong> 👋 And this week, I'm in charge of the NGM newsletter 😈</p>
                    <p>I've been a digital nomad based in Japan for the past eight years.</p>
                    <p>Before that, I worked at Japan's largest advertising agency—often doing 200+ hours of <strong>overtime</strong>, joining every company dinner, and writing thank-you notes to senior colleagues before they arrived the next morning.</p>
                    <p>From the outside, I was stuck in "typical Japanese work culture."</p>
                    <p>But surprisingly, I found it <strong>deeply fulfilling</strong>—not because I was forced to, but because I had two things:</p>
                    <p>1️⃣ Freedom in how I worked (we had a "super flex" system)<br/>
                    2️⃣ A strong community of brilliant colleagues</p>
                    <p>Even when things got intense, I could rest when I needed to. I had <strong>control</strong>. And I enjoyed spending time with the <strong>people</strong> I worked with. That's what kept my <strong>motivation</strong> alive.</p>
                    <p>Now as a digital nomad, I realize these same two factors—<strong>freedom</strong> and <strong>community</strong>—are what sustain us in any workstyle.</p>
                    <p>[...continues with personal story and call to action...]</p>
                    <p class="font-semibold text-blue-600">
                      <strong>Ryo Osera</strong><br/>
                      Co-Host, <a href="#" class="underline">Colive Fukuoka</a> @colivefukuoka
                    </p>
                    <p class="text-xs text-gray-500 italic">*Use code GOSSIP for a 20% discount 👉 colivefukuoka.com</p>
                  </div>
                </div>
                <p class="text-xs text-blue-700 mt-3">
                  <strong>Note:</strong> This example shows personal storytelling, emotional connection, and clear value proposition with a soft CTA.
                </p>
                <div class="mt-3 pt-3 border-t border-blue-200">
                  <p class="text-xs text-blue-800 font-medium mb-1">📖 More Examples</p>
                  <p class="text-xs text-blue-700">
                    See another takeover style: 
                    <a href="https://us21.campaign-archive.com/?u=07f1911b0ed16f49aac50b510&id=6f75d20dff"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="underline hover:text-blue-900"
                       aria-label="View Matt's Pangea App takeover example (opens in new tab)">
                      Matt's Pangea App takeover
                    </a> - showcases adventure storytelling and product integration.
                  </p>
                </div>
              </div>
            </div>
          </section>

          <!-- Short Note Requirements -->
          <section class="bg-white rounded-xl shadow-sm border border-gray-200 p-8">
            <div class="flex items-center mb-6">
              <div class="h-12 w-12 bg-green-100 rounded-lg flex items-center justify-center mr-4">
                <svg class="h-6 w-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z"/>
                </svg>
              </div>
              <h2 class="text-2xl font-bold text-gray-900">Short Note Requirements</h2>
            </div>
            
            <div class="space-y-6">
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="space-y-4">
                  <h3 class="font-semibold text-gray-900 flex items-center">
                    <span class="h-2 w-2 bg-green-400 rounded-full mr-3"></span>
                    Format
                  </h3>
                  <ul class="space-y-2 text-gray-600 ml-5">
                    <li>• One paragraph only</li>
                    <li>• Concise and focused</li>
                    <li>• Clear message</li>
                    <li>• Direct communication</li>
                  </ul>
                </div>
                
                <div class="space-y-4">
                  <h3 class="font-semibold text-gray-900 flex items-center">
                    <span class="h-2 w-2 bg-green-400 rounded-full mr-3"></span>
                    Content
                  </h3>
                  <ul class="space-y-2 text-gray-600 ml-5">
                    <li>• 1 link maximum</li>
                    <li>• Perfect for announcements</li>
                    <li>• Industry insights</li>
                    <li>• Quick updates</li>
                  </ul>
                </div>
              </div>
              
              <div class="bg-green-50 rounded-lg p-6">
                <h3 class="font-semibold text-green-900 mb-3 flex items-center">
                  <span class="h-2 w-2 bg-green-400 rounded-full mr-3"></span>
                  Short Note Example
                </h3>
                <div class="bg-white rounded-lg p-4 border border-green-200">
                  <div class="text-sm text-gray-600 mb-2">Example format:</div>
                  <div class="space-y-3 text-sm">
                    <p class="font-semibold text-gray-900">Note from Palermo</p>
                    <p class="text-gray-700">
                      In a world of hypermobility and hyperconnection, many digital nomads and entrepreneurs are rediscovering the need for something more grounded: community. Coliving is not just a practical solution, but a cultural response to loneliness and rootlessness—a way to turn temporary stays into meaningful shared experiences. Projects like BeetCommunity in Palermo reflect this shift, blending hospitality with local integration and social impact. Instead of offering simply a place to sleep, they invite travelers to become temporary citizens, contributing to a collective sense of belonging in a world that often feels fragmented.
                    </p>
                  </div>
                </div>
                <p class="text-xs text-green-700 mt-3">
                  <strong>Note:</strong> This example shows thoughtful insight, cultural perspective, and subtle brand mention without being pushy.
                </p>
              </div>
            </div>
          </section>

          <!-- Content Structure -->
          <section class="bg-white rounded-xl shadow-sm border border-gray-200 p-8">
            <div class="flex items-center mb-6">
              <div class="h-12 w-12 bg-purple-100 rounded-lg flex items-center justify-center mr-4">
                <svg class="h-6 w-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
                </svg>
              </div>
              <h2 class="text-2xl font-bold text-gray-900">Suggested Structure</h2>
            </div>
            
            <div class="space-y-8">
              <!-- Structure Steps -->
              <div class="relative">
                <div class="absolute left-6 top-12 bottom-0 w-0.5 bg-gradient-to-b from-purple-200 to-transparent"></div>
                
                <div class="space-y-8">
                  <!-- Subject Line -->
                  <div class="flex items-start space-x-4">
                    <div class="flex-shrink-0 w-12 h-12 bg-purple-100 rounded-full flex items-center justify-center">
                      <span class="text-purple-600 font-bold text-sm">1</span>
                    </div>
                    <div class="flex-1 min-w-0">
                      <h3 class="text-lg font-semibold text-gray-900 mb-2">🧠 Subject Line (Optional)</h3>
                      <p class="text-gray-600 mb-3">Short, clear, maybe even a little cheeky. Emojis welcome!</p>
                      <div class="bg-gray-50 rounded-lg p-4">
                        <p class="text-sm text-gray-700 font-medium">Example:</p>
                        <p class="text-sm text-gray-600 italic">"🌍 A Remote Work Hack You'll Actually Use"</p>
                      </div>
                    </div>
                  </div>
                  
                  <!-- Intro -->
                  <div class="flex items-start space-x-4">
                    <div class="flex-shrink-0 w-12 h-12 bg-purple-100 rounded-full flex items-center justify-center">
                      <span class="text-purple-600 font-bold text-sm">2</span>
                    </div>
                    <div class="flex-1 min-w-0">
                      <h3 class="text-lg font-semibold text-gray-900 mb-2">👋 Intro Paragraph</h3>
                      <p class="text-gray-600 mb-3">Tell readers who you are and why they should care. Keep it under 100 words.</p>
                      <ul class="space-y-1 text-sm text-gray-600 ml-4">
                        <li>• A bold benefit or insight</li>
                        <li>• Your unique angle or offer</li>
                        <li>• 1 link (if relevant)</li>
                      </ul>
                    </div>
                  </div>
                  
                  <!-- Main Message -->
                  <div class="flex items-start space-x-4">
                    <div class="flex-shrink-0 w-12 h-12 bg-purple-100 rounded-full flex items-center justify-center">
                      <span class="text-purple-600 font-bold text-sm">3</span>
                    </div>
                    <div class="flex-1 min-w-0">
                      <h3 class="text-lg font-semibold text-gray-900 mb-2">🔍 Main Message (200-300 words)</h3>
                      <p class="text-gray-600 mb-3">Your space to share value, insights, or behind-the-scenes content.</p>
                      <div class="bg-green-50 rounded-lg p-4">
                        <h4 class="font-medium text-green-800 mb-2">Focus on:</h4>
                        <ul class="space-y-1 text-sm text-green-700">
                          <li>• Unique perspectives or helpful tips</li>
                          <li>• How your service/product helps nomads</li>
                          <li>• Use bullet points for clarity</li>
                          <li>• Avoid long blocks of text</li>
                        </ul>
                      </div>
                    </div>
                  </div>
                  
                  <!-- Inspiration Closing -->
                  <div class="flex items-start space-x-4">
                    <div class="flex-shrink-0 w-12 h-12 bg-purple-100 rounded-full flex items-center justify-center">
                      <span class="text-purple-600 font-bold text-sm">4</span>
                    </div>
                    <div class="flex-1 min-w-0">
                      <h3 class="text-lg font-semibold text-gray-900 mb-2">✨ Inspiration Closing & Special Offers</h3>
                      <p class="text-gray-600 mb-3">End with inspiration or exclusive value for our nomad community.</p>
                      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
                        <div>
                          <h4 class="font-medium text-gray-700 mb-2">Inspiration Examples:</h4>
                          <ul class="space-y-1 text-gray-600">
                            <li>• Share your vision for nomad life</li>
                            <li>• Encourage community building</li>
                            <li>• Motivate readers to take action</li>
                            <li>• Connect to bigger purpose</li>
                          </ul>
                        </div>
                        <div>
                          <h4 class="font-medium text-gray-700 mb-2">Special Offers:</h4>
                          <ul class="space-y-1 text-gray-600">
                            <li>• Exclusive discounts for readers</li>
                            <li>• Free resources or guides</li>
                            <li>• Early access to events</li>
                            <li>• Community membership perks</li>
                          </ul>
                        </div>
                      </div>
