---
import '../../styles/global.css'
import '../../styles/console.css'
import { createSupabaseServerClient } from '~/utils/supabase-server'
interface Props {
  title?: string
  currentPage?: string
}
const { title = 'Your directory', currentPage = '' } = Astro.props
const supabase = createSupabaseServerClient(Astro.request, Astro.cookies)
const { data: isAdmin } = await supabase.rpc('directory_is_admin')
const nav = [
  { href: '/console/', label: 'My listings', id: 'dashboard' },
  { href: '/console/directory-submission/?new=1', label: 'Add a listing', id: 'directory' },
  { href: '/console/updates/', label: 'Updates', id: 'updates' },
  { href: '/console/affiliates/', label: 'Affiliate programmes', id: 'affiliates' },
  { href: '/console/badges/', label: 'Your badges', id: 'badges' },
]
---

<!doctype html>
<html lang="en">
  <head
    ><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>{title} — Nomad Magazine</title><meta
      name="robots"
      content="noindex, nofollow"
    /><link rel="icon" href="/favicon.png" /></head
  >
  <body class="owner-console">
    <a href="#main-content" class="sr-only focus:not-sr-only">Skip to main content</a>
    <div class="console-shell">
      <aside class="console-sidebar" aria-label="Owner workspace">
        <a href="/console/" class="console-brand"><img src="/logo.svg" alt="Nomad Magazine" width="150" height="32" /><span>Directory owner workspace</span></a>
        <nav aria-label="Console navigation">
          {
            nav.map((item) => (
              <a href={item.href} aria-current={currentPage === item.id ? 'page' : undefined}>
                {item.label}
              </a>
            ))
          }{
            isAdmin && (
              <><a href="/console/admin/directory/" aria-current={currentPage === 'review' ? 'page' : undefined}>
                Review queue
              </a><a href="/console/admin/awards/" aria-current={currentPage === 'award-review' ? 'page' : undefined}>Award review</a></>
            )
          }
        </nav>
        <form class="signout" method="POST" action="/console/logout/" aria-label="Sign out"><button class="button secondary" type="submit">Sign out</button></form>
      </aside>
      <main class="console-main" id="main-content">
        <header class="console-topbar"><h1>{title}</h1><a class="link" href="/nomad_directory/">View directory ↗</a></header><div class="console-content"><slot /></div>
      </main>
    </div>
  </body>
</html>
