---
import '../../styles/global.css'

export interface ConsoleLayoutProps {
  title?: string
  currentPage?: string
}

const { title = 'Console', currentPage = '' }: ConsoleLayoutProps = Astro.props

const ADMIN_EMAIL = 'hey@nomadgossip.com'

const navItems = [
  { href: '/console/', label: 'Dashboard', icon: 'M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6', id: 'dashboard' },
  { href: '/console/directory-submission/', label: 'Edit listing', icon: 'M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10', id: 'directory' },
]

const adminNavItems = [
  { href: '/console/admin/', label: 'Review Submissions', icon: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z', id: 'admin' },
]

// Get current user email to conditionally show admin nav
import { createSupabaseServerClient } from '~/utils/supabase-server'
const supabase = createSupabaseServerClient(Astro.request, Astro.cookies)
const { data: { user } } = await supabase.auth.getUser()
const isAdmin = user?.email === ADMIN_EMAIL
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — Nomad Magazine Console</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.ico" />
  </head>
  <body class="bg-gray-950 text-gray-100 min-h-screen font-inter antialiased">
    <div class="flex min-h-screen">
      <!-- Sidebar -->
      <aside class="w-64 bg-gray-900 border-r border-gray-800 flex flex-col fixed inset-y-0 left-0 z-10">
        <!-- Logo -->
        <div class="p-6 border-b border-gray-800">
          <a href="/console/" class="flex items-center gap-3 group">
            <div class="w-8 h-8 bg-yellow-400 rounded-lg flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-black" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                <path d="M9 4.804A7.968 7.968 0 005.5 4c-1.255 0-2.443.29-3.5.804v10A7.969 7.969 0 015.5 14c1.669 0 3.218.51 4.5 1.385A7.962 7.962 0 0114.5 14c1.255 0 2.443.29 3.5.804v-10A7.968 7.968 0 0014.5 4c-1.255 0-2.443.29-3.5.804V12a1 1 0 11-2 0V4.804z"/>
              </svg>
            </div>
            <div>
              <div class="text-sm font-bold text-white leading-tight">Nomad Magazine</div>
              <div class="text-xs text-gray-400">Member Console</div>
            </div>
          </a>
        </div>

        <!-- Navigation -->
        <nav class="flex-1 p-4" aria-label="Console navigation">
          <ul class="space-y-1">
            {navItems.map((item) => {
              const isActive = currentPage === item.id
              return (
                <li>
                  <a
                    href={item.href}
                    class={`flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors ${
                      isActive
                        ? 'bg-yellow-400/10 text-yellow-400 border border-yellow-400/20'
                        : 'text-gray-400 hover:text-white hover:bg-gray-800'
                    }`}
                    aria-current={isActive ? 'page' : undefined}
                  >
                    <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={item.icon} />
                    </svg>
                    {item.label}
                  </a>
                </li>
              )
            })}
          </ul>

          {isAdmin && (
            <>
              <div class="mt-6 mb-2 px-3">
                <span class="text-xs font-semibold text-gray-600 uppercase tracking-widest">Admin</span>
              </div>
              <ul class="space-y-1">
                {adminNavItems.map((item) => {
                  const isActive = currentPage === item.id
                  return (
                    <li>
                      <a
                        href={item.href}
                        class={`flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors ${
                          isActive
                            ? 'bg-yellow-400/10 text-yellow-400 border border-yellow-400/20'
                            : 'text-gray-400 hover:text-white hover:bg-gray-800'
                        }`}
                        aria-current={isActive ? 'page' : undefined}
                      >
                        <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={item.icon} />
                        </svg>
                        {item.label}
                      </a>
                    </li>
                  )
                })}
              </ul>
            </>
          )}
        </nav>

        <!-- Footer -->
        <div class="p-4 border-t border-gray-800">
          <form method="POST" action="/console/logout/">
            <button
              type="submit"
              class="w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium text-gray-400 hover:text-white hover:bg-gray-800 transition-colors"
            >
              <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
              </svg>
              Sign out
            </button>
          </form>
        </div>
      </aside>

      <!-- Main content -->
      <main id="main-content" class="ml-64 flex-1 flex flex-col">
        <!-- Top bar -->
        <header class="bg-gray-900 border-b border-gray-800 px-8 py-4 flex items-center justify-between">
          <h1 class="text-lg font-semibold text-white">{title}</h1>
          <a href="/" target="_blank" rel="noopener noreferrer" class="text-sm text-gray-400 hover:text-yellow-400 transition-colors flex items-center gap-1.5" aria-label="View Nomad Magazine website (opens in new tab)">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
            Visit site
          </a>
        </header>

        <!-- Page content -->
        <div class="flex-1 p-8">
          <slot />
        </div>
      </main>
    </div>
  </body>
</html>
