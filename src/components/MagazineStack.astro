---
interface Props {
  showLatestBadge?: boolean
  className?: string
}

const { showLatestBadge = true, className = '' } = Astro.props
---

<div class={`relative magazine-stack-container ${className}`}>
  <!-- Magazine Stack Effect -->
  <div class="relative transform transition-all duration-700">
    <!-- Third magazine (back) - First Edition -->
    <div class="magazine-back absolute transition-all duration-500 ease-out cursor-pointer block overflow-hidden group">
      <img
        src="/images/first-edition-cover-hd.webp"
        alt="Nomad Magazine First Edition"
        class="h-auto w-64 rounded-lg shadow-2xl shadow-yellow-400/20 md:w-80 pointer-events-none"
        loading="lazy"
        width="1296"
        height="1590"
      />
      <!-- Original link overlay -->
      <a href="/editions/first-edition/" aria-label="View Nomad Magazine First Edition" class="absolute inset-0 z-10"></a>
    </div>

    <!-- Second magazine (middle) - Second Edition -->
    <a href="/editions/second-edition/" aria-label="View Nomad Magazine Second Edition" class="magazine-middle absolute transition-all duration-500 ease-out cursor-pointer block overflow-hidden">
      <img
        src="/images/edition-002-cover.webp"
        alt="Nomad Magazine Second Edition"
        class="h-auto w-64 rounded-lg shadow-2xl shadow-purple-400/20 md:w-80 pointer-events-none"
        loading="lazy"
        width="2000"
        height="2450"
      />
    </a>

    <!-- First magazine (front) - Third Edition -->
    <a href="/editions/third-edition/" aria-label="View Nomad Magazine Third Edition" class="magazine-front relative cursor-pointer block transition-all duration-500 ease-out overflow-hidden">
      <img
        src="/images/third-edition-cover-hd.webp"
        alt="Nomad Magazine Third Edition"
        class="h-auto w-64 rounded-lg shadow-2xl shadow-white/30 md:w-80 pointer-events-none"
        loading="lazy"
        width="1200"
        height="1404"
      />
      <!-- Floating badge -->
      {showLatestBadge && (
        <div class="absolute -right-4 -top-4 rounded-full bg-yellow-400 px-3 py-1 text-xs font-bold text-black pointer-events-none">
          Latest!
        </div>
      )}
    </a>
  </div>

  <!-- Interactive hint -->
  <div class="absolute -bottom-8 left-1/2 transform -translate-x-1/2 opacity-70 hover-hint pointer-events-none">
    <div class="flex items-center gap-2 text-xs text-gray-400 animate-pulse">
      <!-- Mouse cursor icon -->
      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
        <path d="M13.64 21.97c-.16 0-.3-.07-.4-.19l-4.14-4.86c-.27-.32-.23-.8.09-1.07.32-.27.8-.23 1.07.09l3.5 4.11 2.3-9.33-7.24 6.12c-.32.27-.8.23-1.07-.09-.27-.32-.23-.8.09-1.07L15.58 9c.23-.19.57-.22.82-.07.25.15.36.44.28.72L13.11 21.4c-.06.25-.25.44-.5.56-.05.01-.11.01-.17.01z"/>
      </svg>
      <span>Move mouse to explore</span>
    </div>
  </div>

  <!-- Decorative elements -->
  <div class="absolute -left-8 top-1/2 h-4 w-4 rounded-full bg-yellow-400/60 blur-sm pointer-events-none"></div>
  <div class="absolute -right-4 top-1/4 h-6 w-6 rounded-full bg-purple-400/40 blur-sm pointer-events-none"></div>
  <div class="absolute bottom-8 left-4 h-3 w-3 rounded-full bg-white/30 blur-sm pointer-events-none"></div>
</div>

<style>
  /* Magazine stack default positions - spread out and centered */
  .magazine-back {
    transform: translateX(-80px) translateY(0px) rotate(-8deg);
    z-index: 1;
    width: 256px; /* w-64 equivalent */
    height: auto;
  }
  
  .magazine-middle {
    transform: translateX(40px) translateY(10px) rotate(-2deg);
    z-index: 2;
    width: 256px; /* w-64 equivalent */
    height: auto;
  }
  
  .magazine-front {
    transform: translateX(160px) translateY(20px) rotate(2deg);
    z-index: 3;
    width: 256px; /* w-64 equivalent */
    height: auto;
  }
  
  @media (min-width: 768px) {
    .magazine-back,
    .magazine-middle,
    .magazine-front {
      width: 320px; /* md:w-80 equivalent */
    }
  }
  
  /* Magazine stack hover effect - spread out to the right with smooth transition */
  .magazine-stack-container:hover .magazine-back {
    transform: translateX(-20px) translateY(0px) rotate(-8deg);
  }
  
  .magazine-stack-container:hover .magazine-middle {
    transform: translateX(100px) translateY(10px) rotate(-2deg);
  }
  
  .magazine-stack-container:hover .magazine-front {
    transform: translateX(220px) translateY(20px) rotate(2deg);
  }
  
  /* Mobile: stack vertically on hover */
  @media (max-width: 768px) {
    .magazine-back {
      transform: translateX(0px) translateY(0px) rotate(-4deg);
    }
    
    .magazine-middle {
      transform: translateX(20px) translateY(5px) rotate(-2deg);
    }
    
    .magazine-front {
      transform: translateX(40px) translateY(10px) rotate(0deg);
    }
    
    .magazine-stack-container:hover .magazine-back {
      transform: translateX(0px) translateY(0px) rotate(-4deg);
    }
    
    .magazine-stack-container:hover .magazine-middle {
      transform: translateX(0px) translateY(100px) rotate(0deg);
    }
    
    .magazine-stack-container:hover .magazine-front {
      transform: translateX(0px) translateY(200px) rotate(0deg);
    }
  }
  
  /* Individual magazine hover effects - bring to front with playful scaling */
  .magazine-back:hover {
    transform: translateX(0px) translateY(0px) rotate(-8deg) scale(1.05) !important;
    z-index: 15 !important;
  }
  
  .magazine-middle:hover {
    transform: translateX(40px) translateY(10px) rotate(-4deg) scale(1.05) !important;
    z-index: 15 !important;
  }
  
  .magazine-front:hover {
    transform: translateX(80px) translateY(20px) rotate(0deg) scale(1.05) !important;
    z-index: 15 !important;
  }
  
  /* Mobile individual hover effects */
  @media (max-width: 768px) {
    .magazine-back:hover {
      transform: translateX(0px) translateY(0px) rotate(-4deg) scale(1.05) !important;
      z-index: 15 !important;
    }
    
    .magazine-middle:hover {
      transform: translateX(20px) translateY(5px) rotate(-2deg) scale(1.05) !important;
      z-index: 15 !important;
    }
    
    .magazine-front:hover {
      transform: translateX(40px) translateY(10px) rotate(0deg) scale(1.05) !important;
      z-index: 15 !important;
    }
  }
  
  /* Smooth transitions for all states */
  .magazine-back,
  .magazine-middle,
  .magazine-front {
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), z-index 0s;
  }
  
  /* When container is hovered, individual hovers are less prominent */
  .magazine-stack-container:hover .magazine-back:hover {
    transform: translateX(-20px) translateY(0px) rotate(-8deg) scale(1.02) !important;
  }
  
  .magazine-stack-container:hover .magazine-middle:hover {
    transform: translateX(100px) translateY(10px) rotate(-2deg) scale(1.02) !important;
  }
  
  .magazine-stack-container:hover .magazine-front:hover {
    transform: translateX(220px) translateY(20px) rotate(2deg) scale(1.02) !important;
  }
  
  /* Hide hint on hover */
  .magazine-stack-container:hover .hover-hint {
    opacity: 0;
    transition: opacity 0.3s ease-out;
  }
  
  /* Mobile hint positioning */
  @media (max-width: 768px) {
    .hover-hint {
      bottom: -6rem;
    }
  }
</style>
