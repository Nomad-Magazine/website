---
import { votePageUrl } from '~/utils/directory-votes'
import { DIRECTORY_TURNSTILE_SITE_KEY } from '~/const/directoryVoting'
interface Props { id: string; title: string; count: number }
const { id, title, count } = Astro.props
const returnTo = `${Astro.url.pathname}${Astro.url.search}#listing-${id}`
---

<div class="directory-vote-stack relative shrink-0">
  <a href={votePageUrl(id, returnTo)} data-upvote={id} data-vote-title={title}
    aria-label={`Upvote ${title}, ${count} ${count === 1 ? 'vote' : 'votes'}`}
    class="directory-upvote flex min-h-14 min-w-12 flex-col items-center justify-center gap-0.5 rounded-xl border border-white/20 px-2 py-2 text-sm font-bold text-gray-200 transition-colors hover:border-yellow-400 hover:text-yellow-400 focus-visible:ring-2 focus-visible:ring-yellow-400">
    <svg aria-hidden="true" viewBox="0 0 20 20" width="18" height="18" fill="currentColor"><path d="m10 4 7 10H3z" /></svg>
    <span data-vote-count>{count}</span>
  </a>
  <div class="directory-turnstile-popover pointer-events-none invisible fixed z-50 w-[min(300px,calc(100vw-1.5rem))] rounded-xl border border-white/15 bg-gray-950 p-3 text-left opacity-0 shadow-2xl" data-turnstile-panel={id} role="dialog" aria-label="Confirm you are human" aria-modal="true">
    <div class="mb-2 flex items-start justify-between gap-2">
      <p class="text-xs text-gray-300">Complete the check below to save your vote.</p>
      <button type="button" class="directory-turnstile-close shrink-0 rounded px-1 text-sm text-gray-400 hover:text-white focus-visible:ring-2 focus-visible:ring-yellow-400" data-turnstile-close={id} aria-label="Close human verification">×</button>
    </div>
    <div data-turnstile-widget data-turnstile-sitekey={DIRECTORY_TURNSTILE_SITE_KEY} class="min-h-[65px]"></div>
  </div>
</div>

<style>
  .directory-upvote[aria-pressed='true'] { background: #facc15; color: #000; border-color: #facc15; }
  .directory-upvote[aria-busy='true'] { opacity: .6; cursor: wait; }
  .directory-turnstile-popover.is-open { pointer-events: auto; visibility: visible; opacity: 1; }
</style>

<script>
  import { votePageUrl, type VoteResult } from '~/utils/directory-votes'

  const ownVotes = new Set<string>()
  let voteVerified = false
  let ready = false
  const pending = new Set<string>()
  const turnstileWaits = new Map<string, { reject: (error: Error) => void }>()
  const focusTraps = new Map<string, (event: KeyboardEvent) => void>()
  const status = document.createElement('p')
  status.className = 'sr-only'
  status.setAttribute('role', 'status')
  status.setAttribute('aria-live', 'polite')
  document.body.appendChild(status)

  const CANCELLED = 'Human verification cancelled.'

  function turnstileApi() {
    return (window as Window & { turnstile?: {
      render: (el: HTMLElement, opts: Record<string, unknown>) => string
      remove: (id: string) => void
      reset: (id?: string) => void
    } }).turnstile
  }

  function loadTurnstile() {
    return new Promise<void>((resolve, reject) => {
      if (turnstileApi()) { resolve(); return }
      const script = document.createElement('script')
      script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit'
      script.async = true
      script.onload = () => resolve()
      script.onerror = () => reject(new Error('Human verification is unavailable. Please try again.'))
      document.head.appendChild(script)
    })
  }

  function cleanupTurnstileWidget(listingId: string) {
    const panel = document.querySelector(`[data-turnstile-panel="${listingId}"]`) as HTMLElement | null
    const host = panel?.querySelector('[data-turnstile-widget]') as HTMLElement | null
    const turnstile = turnstileApi()
    if (turnstile && host?.dataset.turnstileWidget) turnstile.remove(host.dataset.turnstileWidget)
    if (host) delete host.dataset.turnstileWidget
  }

  function releaseFocusTrap(listingId: string) {
    const panel = document.querySelector(`[data-turnstile-panel="${listingId}"]`) as HTMLElement | null
    const trap = focusTraps.get(listingId)
    if (panel && trap) panel.removeEventListener('keydown', trap)
    focusTraps.delete(listingId)
  }

  function dismissTurnstilePanel(listingId: string) {
    const pendingWait = turnstileWaits.get(listingId)
    if (pendingWait) {
      pendingWait.reject(new Error(CANCELLED))
      turnstileWaits.delete(listingId)
    }
    cleanupTurnstileWidget(listingId)
    releaseFocusTrap(listingId)
    document.querySelector(`[data-turnstile-panel="${listingId}"]`)?.classList.remove('is-open')
  }

  function finishTurnstilePanel(listingId: string) {
    turnstileWaits.delete(listingId)
    cleanupTurnstileWidget(listingId)
    releaseFocusTrap(listingId)
    document.querySelector(`[data-turnstile-panel="${listingId}"]`)?.classList.remove('is-open')
  }

  function focusables(panel: HTMLElement) {
    return [...panel.querySelectorAll<HTMLElement>(
      'button:not([disabled]), [href], input:not([disabled]), select:not([disabled]), textarea:not([disabled]), iframe, [tabindex]:not([tabindex="-1"])',
    )].filter(el => el.offsetParent !== null || el.tagName === 'IFRAME')
  }

  function bindFocusTrap(listingId: string, panel: HTMLElement) {
    releaseFocusTrap(listingId)
    const nodes = focusables(panel)
    const first = nodes[0]
    const last = nodes[nodes.length - 1]
    first?.focus()
    const trap = (event: KeyboardEvent) => {
      if (event.key === 'Escape') {
        event.preventDefault()
        event.stopPropagation()
        dismissTurnstilePanel(listingId)
        return
      }
      if (event.key !== 'Tab' || !nodes.length) return
      const active = document.activeElement as HTMLElement | null
      if (event.shiftKey) {
        if (active === first || !panel.contains(active)) {
          event.preventDefault()
          last?.focus()
        }
      } else if (active === last || !panel.contains(active)) {
        event.preventDefault()
        first?.focus()
      }
    }
    panel.addEventListener('keydown', trap)
    focusTraps.set(listingId, trap)
  }

  function openTurnstilePanel(anchor: HTMLElement, listingId: string) {
    const panel = document.querySelector(`[data-turnstile-panel="${listingId}"]`) as HTMLElement | null
    if (!panel) return
    const margin = 8
    const anchorRect = anchor.getBoundingClientRect()
    const width = Math.min(300, window.innerWidth - margin * 2)
    let left
    if (window.innerWidth <= 420) left = (window.innerWidth - width) / 2
    else {
      left = anchorRect.right - width
      left = Math.max(margin, Math.min(left, window.innerWidth - width - margin))
    }
    let top = anchorRect.bottom + margin
    const maxTop = window.innerHeight - 220
    if (top > maxTop) top = Math.max(margin, anchorRect.top - 220)
    panel.style.width = `${width}px`
    panel.style.left = `${left}px`
    panel.style.top = `${top}px`
    panel.classList.add('is-open')
    bindFocusTrap(listingId, panel)
  }

  document.addEventListener('click', event => {
    const close = (event.target as Element).closest('[data-turnstile-close]')
    if (close) {
      event.preventDefault()
      event.stopPropagation()
      dismissTurnstilePanel(close.getAttribute('data-turnstile-close')!)
    }
  })

  async function obtainTurnstileToken(anchor: HTMLAnchorElement, listingId: string): Promise<string> {
    const panel = document.querySelector(`[data-turnstile-panel="${listingId}"]`) as HTMLElement | null
    const host = panel?.querySelector('[data-turnstile-widget]') as HTMLElement | null
    const siteKey = host?.dataset.turnstileSitekey
    if (!panel || !host || !siteKey) throw new Error('Human verification is unavailable. Please try again.')
    openTurnstilePanel(anchor, listingId)
    let settled = false
    try {
      await loadTurnstile()
      const turnstile = turnstileApi()
      if (!turnstile) throw new Error('Human verification is unavailable. Please try again.')
      if (host.dataset.turnstileWidget) turnstile.remove(host.dataset.turnstileWidget)
      return await new Promise<string>((resolve, reject) => {
        turnstileWaits.set(listingId, { reject })
        const widget = turnstile.render(host, {
          sitekey: siteKey,
          theme: 'light',
          size: 'normal',
          callback: (value: string) => {
            if (settled) return
            if (!value) {
              settled = true
              reject(new Error('Human verification failed. Please try again.'))
              return
            }
            settled = true
            turnstileWaits.delete(listingId)
            resolve(value)
          },
          'error-callback': () => {
            if (settled) return
            settled = true
            turnstileWaits.delete(listingId)
            reject(new Error('Human verification failed. Please try again.'))
          },
          'timeout-callback': () => {
            if (settled) return
            settled = true
            turnstileWaits.delete(listingId)
            reject(new Error('Human verification timed out. Please try again.'))
          },
        })
        host.dataset.turnstileWidget = widget
      })
    } finally {
      if (!settled) turnstileWaits.delete(listingId)
      finishTurnstilePanel(listingId)
    }
  }

  function enhance() {
    document.querySelectorAll<HTMLAnchorElement>('[data-upvote]').forEach(link => {
      if (!ready) return
      const voted = ownVotes.has(link.dataset.upvote!)
      const count = link.querySelector('[data-vote-count]')?.textContent || '0'
      link.setAttribute('role', 'button')
      link.setAttribute('aria-pressed', String(voted))
      link.setAttribute('aria-label', `${voted ? 'Remove upvote for' : 'Upvote'} ${link.dataset.voteTitle}, ${count} ${count === '1' ? 'vote' : 'votes'}`)
    })
  }
  async function loadVotes() {
    try {
      const response = await fetch('/api/directory-votes/', { cache: 'no-store' })
      if (!response.ok) return
      const data = await response.json() as { vote_verified: boolean; votes: string[] }
      voteVerified = Boolean(data.vote_verified)
      ownVotes.clear()
      data.votes.forEach((id: string) => ownVotes.add(id))
      ready = true
      enhance()
    } catch { ready = true; enhance() }
  }
  document.addEventListener('directory:render', enhance)
  window.addEventListener('pageshow', event => { if (event.persisted) void loadVotes() })
  void loadVotes()

  async function castVote(link: HTMLAnchorElement) {
    const id = link.dataset.upvote!
    if (pending.has(id)) return
    pending.add(id)
    link.setAttribute('aria-busy', 'true')
    link.closest('[data-vote-listing]')?.querySelector('[data-vote-error]')?.remove()
    const nextVoted = !ownVotes.has(id)
    try {
      const body: Record<string, unknown> = { listing_id: id, voted: nextVoted }
      if (!voteVerified) body.turnstile_token = await obtainTurnstileToken(link, id)
      const response = await fetch('/api/directory-votes/', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
        signal: AbortSignal.timeout(20000),
      })
      const data = await response.json() as VoteResult & { error?: string }
      if (!response.ok) throw new Error(data.error || 'Your vote could not be saved. Please try again.')
      const vote = data as VoteResult
      voteVerified = true
      if (vote.voted) ownVotes.add(id)
      else ownVotes.delete(id)
      link.querySelector('[data-vote-count]')!.textContent = String(vote.vote_count)
      document.dispatchEvent(new CustomEvent('directory:vote', { detail: vote }))
      enhance()
      status.textContent = `${vote.voted ? 'Upvoted' : 'Removed upvote for'} ${link.dataset.voteTitle}. ${vote.vote_count} ${vote.vote_count === 1 ? 'vote' : 'votes'}.`
    } catch (error) {
      finishTurnstilePanel(id)
      if (error instanceof Error && error.message === CANCELLED) return
      const message = document.createElement('p')
      message.dataset.voteError = ''
      message.className = 'mt-2 text-sm text-yellow-300'
      message.setAttribute('role', 'alert')
      message.textContent = error instanceof Error ? error.message : 'Your vote could not be saved. Please try again.'
      link.closest<HTMLElement>('[data-vote-listing]')?.appendChild(message)
    } finally {
      pending.delete(id)
      link.removeAttribute('aria-busy')
    }
  }

  document.addEventListener('click', event => {
    const link = (event.target as Element).closest<HTMLAnchorElement>('[data-upvote]')
    if (!link || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return
    if ((event.target as Element).closest('[data-turnstile-panel],[data-turnstile-close]')) return
    event.preventDefault()
    event.stopPropagation()
    const id = link.dataset.upvote!
    link.href = votePageUrl(id, `${location.pathname}${location.search}#listing-${id}`)
    void castVote(link)
  })
  document.addEventListener('keydown', event => {
    const link = (event.target as Element).closest<HTMLAnchorElement>('[data-upvote][role="button"]')
    if (link && event.key === ' ') { event.preventDefault(); void castVote(link) }
  })
</script>