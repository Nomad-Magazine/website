---
import { votePageUrl } from '~/utils/directory-votes'
import { DIRECTORY_TURNSTILE_SITE_KEY } from '~/const/directoryVoting'
interface Props { id: string; title: string; count: number }
const { id, title, count } = Astro.props
const returnTo = `${Astro.url.pathname}${Astro.url.search}#listing-${id}`
---

<div class="directory-vote-stack relative shrink-0">
  <a href={votePageUrl(id, returnTo)} data-upvote={id} data-vote-title={title}
    aria-label={`Upvote ${title}, ${count} ${count === 1 ? 'vote' : 'votes'}`}
    class="directory-upvote flex min-h-14 min-w-12 flex-col items-center justify-center gap-0.5 rounded-xl border border-white/20 px-2 py-2 text-sm font-bold text-gray-200 transition-colors hover:border-yellow-400 hover:text-yellow-400 focus-visible:ring-2 focus-visible:ring-yellow-400">
    <svg aria-hidden="true" viewBox="0 0 20 20" width="18" height="18" fill="currentColor"><path d="m10 4 7 10H3z" /></svg>
    <span data-vote-count>{count}</span>
  </a>
  <div class="directory-turnstile-popover pointer-events-none invisible fixed z-50 w-[min(320px,calc(100vw-1.5rem))] rounded-xl border border-white/15 bg-gray-950 p-3 text-left opacity-0 shadow-2xl" data-turnstile-panel={id} role="dialog" aria-label="Confirm you are human" aria-modal="true">
    <div class="mb-2 flex items-start justify-between gap-2">
      <p class="text-xs text-gray-300" data-vote-panel-title>Complete the check below to save your vote.</p>
      <button type="button" class="directory-turnstile-close shrink-0 rounded px-1 text-sm text-gray-400 hover:text-white focus-visible:ring-2 focus-visible:ring-yellow-400" data-turnstile-close={id} aria-label="Close panel">×</button>
    </div>
    <div data-vote-turnstile-step>
      <div data-turnstile-mount data-turnstile-sitekey={DIRECTORY_TURNSTILE_SITE_KEY} class="min-h-[65px]"></div>
    </div>
    <div hidden data-vote-email-step class="space-y-2">
      <p class="text-xs text-gray-300">You've used your 5 free votes. Confirm your email to keep voting — your votes stay.</p>
      <div hidden data-vote-email-turnstile-wrap class="min-h-[65px]">
        <div data-turnstile-mount-email data-turnstile-sitekey={DIRECTORY_TURNSTILE_SITE_KEY} class="min-h-[65px]"></div>
      </div>
      <form data-vote-email-form class="space-y-2" aria-label="Confirm email to continue voting">
        <input name="email" type="email" inputmode="email" autocomplete="email" required
          class="w-full rounded-lg border border-white/20 bg-gray-900 px-3 py-2 text-sm text-white focus-visible:ring-2 focus-visible:ring-yellow-400"
          aria-label="Email address" placeholder="you@example.com" />
        <p class="text-xs text-gray-400">We only use this to verify your votes. No newsletters.</p>
        <button type="submit" class="w-full rounded-lg bg-yellow-400 px-3 py-2 text-sm font-semibold text-black hover:bg-yellow-300 focus-visible:ring-2 focus-visible:ring-yellow-400">
          Send confirmation link
        </button>
      </form>
      <p data-vote-email-error class="hidden text-xs text-yellow-300" role="alert"></p>
    </div>
    <div hidden data-vote-email-sent-step class="min-w-0 w-full">
      <p class="w-full max-w-none text-xs leading-relaxed text-gray-300 whitespace-normal">We sent you a link to confirm your votes.</p>
    </div>
  </div>
</div>

<style>
  .directory-upvote[aria-pressed='true'] { background: #facc15; color: #000; border-color: #facc15; }
  .directory-upvote[aria-busy='true'] { opacity: .6; cursor: wait; }
  .directory-turnstile-popover.is-open { pointer-events: auto; visibility: visible; opacity: 1; }
</style>

<script>
  import { votePageUrl, type VoteResult } from '~/utils/directory-votes'
  import { mapVoteEmailClientError } from '~/utils/directory-vote-email-link'

  const ownVotes = new Set<string>()
  let voteVerified = false
  let ready = false
  const pending = new Set<string>()
  const turnstileWaits = new Map<string, { reject: (error: Error) => void }>()
  const turnstileWidgetIds = new Map<string, string>()
  const focusTraps = new Map<string, (event: KeyboardEvent) => void>()
  const panelTriggers = new Map<string, HTMLElement>()
  const status = document.createElement('p')
  status.className = 'sr-only'
  status.setAttribute('role', 'status')
  status.setAttribute('aria-live', 'polite')
  document.body.appendChild(status)

  const CANCELLED = 'Human verification cancelled.'

  function turnstileApi() {
    return (window as Window & { turnstile?: {
      render: (el: HTMLElement, opts: Record<string, unknown>) => string
      remove: (id: string) => void
    } }).turnstile
  }

  function loadTurnstile() {
    return new Promise<void>((resolve, reject) => {
      if (turnstileApi()) { resolve(); return }
      const script = document.createElement('script')
      script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit'
      script.async = true
      script.onload = () => resolve()
      script.onerror = () => reject(new Error('Human verification is unavailable. Please try again.'))
      document.head.appendChild(script)
    })
  }

  function panelParts(listingId: string) {
    const panel = document.querySelector(`[data-turnstile-panel="${listingId}"]`) as HTMLElement | null
    return {
      panel,
      mount: panel?.querySelector('[data-turnstile-mount]') as HTMLElement | null,
      turnstileStep: panel?.querySelector('[data-vote-turnstile-step]') as HTMLElement | null,
      emailStep: panel?.querySelector('[data-vote-email-step]') as HTMLElement | null,
      emailSent: panel?.querySelector('[data-vote-email-sent-step]') as HTMLElement | null,
      emailTurnstileWrap: panel?.querySelector('[data-vote-email-turnstile-wrap]') as HTMLElement | null,
      mountEmail: panel?.querySelector('[data-turnstile-mount-email]') as HTMLElement | null,
      title: panel?.querySelector('[data-vote-panel-title]') as HTMLElement | null,
      emailError: panel?.querySelector('[data-vote-email-error]') as HTMLElement | null,
    }
  }

  function upvoteButton(listingId: string) {
    return panelTriggers.get(listingId)
      ?? document.querySelector<HTMLAnchorElement>(`[data-upvote="${listingId}"]`)
  }

  function returnFocusToUpvote(listingId: string) {
    upvoteButton(listingId)?.focus()
  }

  function cleanupTurnstileWidget(widgetKey: string, mount: HTMLElement | null | undefined) {
    const widgetId = turnstileWidgetIds.get(widgetKey)
    const turnstile = turnstileApi()
    if (turnstile && widgetId) turnstile.remove(widgetId)
    turnstileWidgetIds.delete(widgetKey)
    mount?.replaceChildren()
  }

  function setPanelMode(listingId: string, mode: 'turnstile' | 'email' | 'email-sent') {
    const { panel, turnstileStep, emailStep, emailSent, title } = panelParts(listingId)
    if (!panel) return
  if (mode === 'turnstile') {
      turnstileStep?.removeAttribute('hidden')
      emailStep?.setAttribute('hidden', '')
      emailSent?.setAttribute('hidden', '')
      panel.setAttribute('aria-label', 'Confirm you are human')
      if (title) title.textContent = 'Complete the check below to save your vote.'
    } else if (mode === 'email') {
      turnstileStep?.setAttribute('hidden', '')
      emailStep?.removeAttribute('hidden')
      emailSent?.setAttribute('hidden', '')
      panel.setAttribute('aria-label', 'Confirm your email to keep voting')
      if (title) title.textContent = 'Confirm your email to keep voting.'
    } else {
      turnstileStep?.setAttribute('hidden', '')
      emailStep?.setAttribute('hidden', '')
      emailSent?.removeAttribute('hidden')
      panel.setAttribute('aria-label', 'Confirmation email sent')
      if (title) title.textContent = 'Check your inbox'
    }
  }

  function focusables(panel: HTMLElement) {
    return [...panel.querySelectorAll<HTMLElement>(
      'button:not([disabled]):not([hidden]), input:not([disabled]):not([hidden]), select:not([disabled]), textarea:not([disabled]), iframe, [tabindex]:not([tabindex="-1"])',
    )].filter(el => !el.closest('[hidden]'))
  }

  function releaseFocusTrap(listingId: string) {
    const { panel } = panelParts(listingId)
    const trap = focusTraps.get(listingId)
    if (panel && trap) panel.removeEventListener('keydown', trap)
    focusTraps.delete(listingId)
  }

  function closeVotePanel(listingId: string, options: { reject?: boolean; returnFocus?: boolean } = {}) {
    const pendingWait = turnstileWaits.get(listingId)
    if (options.reject && pendingWait) {
      pendingWait.reject(new Error(CANCELLED))
      turnstileWaits.delete(listingId)
    } else {
      turnstileWaits.delete(listingId)
    }
    const parts = panelParts(listingId)
    cleanupTurnstileWidget(listingId, parts.mount)
    cleanupTurnstileWidget(`${listingId}:email`, parts.mountEmail)
    parts.emailTurnstileWrap?.setAttribute('hidden', '')
    releaseFocusTrap(listingId)
    parts.panel?.classList.remove('is-open')
    if (options.returnFocus !== false) returnFocusToUpvote(listingId)
    panelTriggers.delete(listingId)
  }

  function bindFocusTrap(listingId: string, panel: HTMLElement) {
    releaseFocusTrap(listingId)
    const trap = (event: KeyboardEvent) => {
      if (event.key === 'Escape') {
        event.preventDefault()
        event.stopPropagation()
        closeVotePanel(listingId, { reject: true, returnFocus: true })
        return
      }
      if (event.key !== 'Tab') return
      const nodes = focusables(panel)
      if (!nodes.length) return
      const active = document.activeElement as HTMLElement | null
      const first = nodes[0]
      const last = nodes[nodes.length - 1]
      if (event.shiftKey) {
        if (active === first || (active && !panel.contains(active))) {
          event.preventDefault()
          last.focus()
        }
      } else if (active === last) {
        event.preventDefault()
        first.focus()
      }
    }
    panel.addEventListener('keydown', trap)
    focusTraps.set(listingId, trap)
    focusables(panel)[0]?.focus()
  }

  function openVotePanel(anchor: HTMLElement, listingId: string) {
    const { panel } = panelParts(listingId)
    if (!panel) return
    panelTriggers.set(listingId, anchor)
    const margin = 8
    const anchorRect = anchor.getBoundingClientRect()
    const width = Math.min(300, window.innerWidth - margin * 2)
    let left = window.innerWidth <= 420 ? (window.innerWidth - width) / 2 : Math.max(margin, anchorRect.right - width)
    left = Math.max(margin, Math.min(left, window.innerWidth - width - margin))
    let top = anchorRect.bottom + margin
    const maxTop = window.innerHeight - 260
    if (top > maxTop) top = Math.max(margin, anchorRect.top - 260)
    panel.style.width = `${width}px`
    panel.style.left = `${left}px`
    panel.style.top = `${top}px`
    panel.classList.add('is-open')
    bindFocusTrap(listingId, panel)
  }

  document.addEventListener('click', event => {
    const close = (event.target as Element).closest('[data-turnstile-close]')
    if (close) {
      event.preventDefault()
      event.stopPropagation()
      closeVotePanel(close.getAttribute('data-turnstile-close')!, { reject: true, returnFocus: true })
    }
  })

  async function obtainTurnstileToken(
    anchor: HTMLAnchorElement,
    listingId: string,
    options: { emailInline?: boolean } = {},
  ): Promise<string> {
    const parts = panelParts(listingId)
    const emailInline = options.emailInline ?? false
    const mount = emailInline ? parts.mountEmail : parts.mount
    const widgetKey = emailInline ? `${listingId}:email` : listingId
    const siteKey = mount?.dataset.turnstileSitekey
    if (!parts.panel || !mount || !siteKey) throw new Error('Human verification is unavailable. Please try again.')
    panelTriggers.set(listingId, anchor)
    if (emailInline) {
      parts.emailTurnstileWrap?.removeAttribute('hidden')
      if (!parts.panel.classList.contains('is-open')) openVotePanel(anchor, listingId)
      else bindFocusTrap(listingId, parts.panel)
    } else {
      setPanelMode(listingId, 'turnstile')
      openVotePanel(anchor, listingId)
    }
    let settled = false
    try {
      await loadTurnstile()
      const turnstile = turnstileApi()
      if (!turnstile) throw new Error('Human verification is unavailable. Please try again.')
      cleanupTurnstileWidget(widgetKey, mount)
      return await new Promise<string>((resolve, reject) => {
        turnstileWaits.set(listingId, { reject })
        const widget = turnstile.render(mount, {
          sitekey: siteKey,
          theme: 'light',
          size: emailInline ? 'compact' : 'normal',
          callback: (value: string) => {
            if (settled) return
            settled = true
            turnstileWaits.delete(listingId)
            if (!value) reject(new Error('Human verification failed. Please try again.'))
            else resolve(value)
          },
          'error-callback': () => {
            if (settled) return
            settled = true
            turnstileWaits.delete(listingId)
            reject(new Error('Human verification failed. Please try again.'))
          },
          'timeout-callback': () => {
            if (settled) return
            settled = true
            turnstileWaits.delete(listingId)
            reject(new Error('Human verification timed out. Please try again.'))
          },
        })
        turnstileWidgetIds.set(widgetKey, widget)
      })
    } finally {
      if (!settled) turnstileWaits.delete(listingId)
      parts.emailTurnstileWrap?.setAttribute('hidden', '')
      cleanupTurnstileWidget(widgetKey, mount)
      if (emailInline) returnFocusToUpvote(listingId)
      else closeVotePanel(listingId, { reject: false, returnFocus: true })
    }
  }

  function openEmailRequiredPanel(anchor: HTMLAnchorElement, listingId: string) {
    setPanelMode(listingId, 'email')
    panelParts(listingId).emailError?.classList.add('hidden')
    openVotePanel(anchor, listingId)
  }

  async function submitVoteEmail(anchor: HTMLAnchorElement, listingId: string, email: string) {
    const { emailError } = panelParts(listingId)
    const body: Record<string, unknown> = {
      email,
      return_to: `${location.pathname}${location.search}#listing-${listingId}`,
    }
    if (!voteVerified) body.turnstile_token = await obtainTurnstileToken(anchor, listingId, { emailInline: true })
    const response = await fetch('/api/directory-vote-email/', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body),
      signal: AbortSignal.timeout(20000),
    })
    const data = await response.json() as { error?: string; ok?: boolean }
    if (!response.ok) {
      const message = mapVoteEmailClientError(data.error ?? 'unavailable')
      if (emailError) {
        emailError.textContent = message
        emailError.classList.remove('hidden')
      }
      throw new Error(message)
    }
    setPanelMode(listingId, 'email-sent')
    releaseFocusTrap(listingId)
    bindFocusTrap(listingId, panelParts(listingId).panel!)
  }

  function enhance() {
    document.querySelectorAll<HTMLAnchorElement>('[data-upvote]').forEach(link => {
      if (!ready) return
      const voted = ownVotes.has(link.dataset.upvote!)
      const count = link.querySelector('[data-vote-count]')?.textContent || '0'
      link.setAttribute('role', 'button')
      link.setAttribute('aria-pressed', String(voted))
      link.setAttribute('aria-label', `${voted ? 'Remove upvote for' : 'Upvote'} ${link.dataset.voteTitle}, ${count} ${count === '1' ? 'vote' : 'votes'}`)
    })
  }
  async function loadVotes() {
    try {
      const response = await fetch('/api/directory-votes/', { cache: 'no-store' })
      if (!response.ok) return
      const data = await response.json() as { vote_verified: boolean; votes: string[] }
      voteVerified = Boolean(data.vote_verified)
      ownVotes.clear()
      data.votes.forEach((id: string) => ownVotes.add(id))
      ready = true
      enhance()
    } catch { ready = true; enhance() }
  }
  document.addEventListener('directory:render', enhance)
  window.addEventListener('pageshow', event => { if (event.persisted) void loadVotes() })
  void loadVotes()

  document.addEventListener('submit', event => {
    const form = (event.target as Element).closest('[data-vote-email-form]')
    if (!form) return
    event.preventDefault()
    const panel = form.closest('[data-turnstile-panel]') as HTMLElement | null
    const listingId = panel?.getAttribute('data-turnstile-panel')
    const anchor = listingId ? panelTriggers.get(listingId) ?? document.querySelector<HTMLAnchorElement>(`[data-upvote="${listingId}"]`) : null
    if (!listingId || !(anchor instanceof HTMLAnchorElement)) return
    const emailInput = form.querySelector('input[name="email"]') as HTMLInputElement
    const email = emailInput?.value.trim() ?? ''
    if (pending.has(listingId)) return
    pending.add(listingId)
    void submitVoteEmail(anchor, listingId, email).catch(() => {}).finally(() => pending.delete(listingId))
  })

  async function castVote(link: HTMLAnchorElement) {
    const id = link.dataset.upvote!
    if (pending.has(id)) return
    pending.add(id)
    link.setAttribute('aria-busy', 'true')
    link.closest('[data-vote-listing]')?.querySelector('[data-vote-error]')?.remove()
    const nextVoted = !ownVotes.has(id)
    try {
      const body: Record<string, unknown> = { listing_id: id, voted: nextVoted }
      if (!voteVerified) body.turnstile_token = await obtainTurnstileToken(link, id)
      const response = await fetch('/api/directory-votes/', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
        signal: AbortSignal.timeout(20000),
      })
      const data = await response.json() as VoteResult & { error?: string }
      if (response.status === 403 && data.error === 'email_required') {
        openEmailRequiredPanel(link, id)
        return
      }
      if (!response.ok) throw new Error(data.error || 'Your vote could not be saved. Please try again.')
      const vote = data as VoteResult
      voteVerified = true
      if (vote.voted) ownVotes.add(id)
      else ownVotes.delete(id)
      link.querySelector('[data-vote-count]')!.textContent = String(vote.vote_count)
      document.dispatchEvent(new CustomEvent('directory:vote', { detail: vote }))
      enhance()
      status.textContent = `${vote.voted ? 'Upvoted' : 'Removed upvote for'} ${link.dataset.voteTitle}. ${vote.vote_count} ${vote.vote_count === 1 ? 'vote' : 'votes'}.`
      link.focus()
    } catch (error) {
      closeVotePanel(id, { reject: false, returnFocus: true })
      if (error instanceof Error && error.message === CANCELLED) return
      const message = document.createElement('p')
      message.dataset.voteError = ''
      message.className = 'mt-2 text-sm text-yellow-300'
      message.setAttribute('role', 'alert')
      message.textContent = error instanceof Error ? error.message : 'Your vote could not be saved. Please try again.'
      link.closest<HTMLElement>('[data-vote-listing]')?.appendChild(message)
    } finally {
      pending.delete(id)
      link.removeAttribute('aria-busy')
    }
  }

  document.addEventListener('click', event => {
    const link = (event.target as Element).closest<HTMLAnchorElement>('[data-upvote]')
    if (!link || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return
    if ((event.target as Element).closest('[data-turnstile-panel],[data-turnstile-close]')) return
    event.preventDefault()
    event.stopPropagation()
    const id = link.dataset.upvote!
    link.href = votePageUrl(id, `${location.pathname}${location.search}#listing-${id}`)
    void castVote(link)
  })
  document.addEventListener('keydown', event => {
    const link = (event.target as Element).closest<HTMLAnchorElement>('[data-upvote][role="button"]')
    if (link && event.key === ' ') { event.preventDefault(); void castVote(link) }
  })
</script>