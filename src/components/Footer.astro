---
import SubstackFollow from '~/components/SubstackFollow.astro'

// Using simple SVG strings instead of icon imports to avoid build issues
const xIcon = '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="currentColor" d="M18.205 2.25h3.308l-7.227 8.26l8.502 11.24H16.13l-5.214-6.817L4.95 21.75H1.64l7.73-8.835L1.215 2.25H8.04l4.713 6.231zm-1.161 17.52h1.833L7.045 4.126H5.078z"/></svg>'
const youtubeIcon = '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="currentColor" d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>'
const linkedInIcon = '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="currentColor" d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.32 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.79M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/></svg>'
const instagramIcon = '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="currentColor" d="M7.8 2h8.4C19.4 2 22 4.6 22 7.8v8.4a5.8 5.8 0 0 1-5.8 5.8H7.8C4.6 22 2 19.4 2 16.2V7.8A5.8 5.8 0 0 1 7.8 2m-.2 2A3.6 3.6 0 0 0 4 7.6v8.8C4 18.39 5.61 20 7.6 20h8.8a3.6 3.6 0 0 0 3.6-3.6V7.6C20 5.61 18.39 4 16.4 4H7.6m9.65 1.5a1.25 1.25 0 0 1 1.25 1.25A1.25 1.25 0 0 1 17.25 8A1.25 1.25 0 0 1 16 6.75a1.25 1.25 0 0 1 1.25-1.25M12 7a5 5 0 0 1 5 5a5 5 0 0 1-5 5a5 5 0 0 1-5-5a5 5 0 0 1 5-5m0 2a3 3 0 0 0-3 3a3 3 0 0 0 3 3a3 3 0 0 0 3-3a3 3 0 0 0-3-3z"/></svg>'
const substackIcon = '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="currentColor" d="M22.539 8.242H1.46V5.406h21.08v2.836zM1.46 10.812V24L12 18.11L22.54 24V10.812H1.46zM22.54 0H1.46v2.836h21.08V0z"/></svg>'

const socialLinks = [
  { name: 'Instagram', href: 'https://www.instagram.com/nomadmagazinecom/', icon: instagramIcon },
  { name: 'Youtube', href: 'https://www.youtube.com/@Nomad-Magazine', icon: youtubeIcon },
  { name: 'Substack', href: 'https://substack.com/@nomadmagazinecom', icon: substackIcon },
  { name: 'LinkedIn', href: 'https://www.linkedin.com/company/ngm-nomad-gossip-magazine/', icon: linkedInIcon },
  { name: 'X', href: 'https://twitter.com/nomadgossipmag', icon: xIcon },
]

const footerSections = [
  {
    title: 'Magazine & Content',
    links: [
      { text: 'Latest Edition', url: '/editions/third-edition/' },
      { text: '5th Edition Waitlist', url: '/5th-edition-waitlist/' },
      { text: 'All Editions', url: '/editions/' },
      { text: 'Blog', url: '/blog/' },
      { text: 'Articles', url: '/articles/' },
    ]
  },
  {
    title: 'Community & Resources',
    links: [
      { text: 'Newsletter', url: '/newsletter/' },
      { text: 'Newsletter Guidelines', url: '/newsletter-guidelines/' },
      { text: 'Digital Nomad Wiki', url: '/digital-nomad-wiki/' },
    ]
  },
  {
    title: 'Business & Partners',
    links: [
      { text: 'Nomad Directory', url: '/nomad_directory/' },
      { text: 'Coworking Directory', url: '/where-to-work/' },
      { text: 'Coliving Directory', url: '/coliving_directory/' },
      { text: 'Partners', url: '/partners/' },
      { text: 'Brand Placement', url: '/brand-placement-next-edition-847291/' },
      { text: 'Distribution Partners', url: '/distribution-list/' },
      { text: 'Writers Program', url: '/writers/' },
    ]
  },
  {
    title: 'About & Legal',
    links: [
      { text: 'About Us', url: '/our-story/' },
      { text: 'Our Team', url: '/#team' },
      { text: 'Support the Magazine', url: '/support-the-magazine/' },
      { text: 'Contact', url: 'mailto:hey@nomadgossip.com' },
    ]
  }
]
---

<div animate-fade-in-up class="relative z-100 opacity-0">
  <img src="/images/paper-cut.webp" alt="" aria-hidden="true" class="w-full bg-gray-50" loading="lazy" decoding="async" width="2880" height="196" />
  <footer class="border-t-2 border-gray-900 bg-white px-4 py-12 font-sans shadow-lg">
    <div class="mx-auto max-w-7xl">
      <!-- Expanded Footer Links Section -->
      <div class="mb-12 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {footerSections.map((section) => (
          <div class="space-y-4">
            <p class="text-lg font-bold text-gray-900 font-inter">
              {section.title}
            </p>
            <ul class="space-y-3">
              {section.links.map((link) => (
                <li>
                  <a 
                    href={link.url} 
                    class="text-gray-600 hover:text-yellow-600 transition-colors duration-200 font-medium"
                    target={link.url.startsWith('http') ? '_blank' : undefined}
                    rel={link.url.startsWith('http') ? 'noopener noreferrer' : undefined}
                    aria-label={link.url.startsWith('http') ? `${link.text} (opens in new tab)` : undefined}
                  >
                    {link.text}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      
      <!-- Newsletter Signup Section -->
      <div class="mb-12 pt-8 border-t border-gray-200">
        <div class="text-center max-w-2xl mx-auto">
          <p class="text-2xl font-bold text-gray-900 mb-4">
            Join Our Global Nomad Community
          </p>
          <p class="text-gray-600 mb-6">
            Get exclusive insights, destination guides, and nomad stories delivered to your inbox monthly.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
            <a 
              href="/newsletter/" 
              class="inline-flex items-center px-6 py-3 bg-yellow-400 text-black font-bold rounded-lg hover:bg-yellow-300 transition-colors duration-200"
            >
              Subscribe to Newsletter
              <svg class="ml-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </a>
            <SubstackFollow />
            <a 
              href="/newsletter-guidelines/" 
              class="text-sm text-gray-600 hover:text-yellow-600 underline"
            >
              Partner Guidelines →
            </a>
          </div>
        </div>
      </div>
      
      <!-- Bottom Section with Logo, Social Links, and Legal -->
      <div class="pt-8 border-t border-gray-200">
        <div class="hidden md:block">
          <div class="flex items-center justify-between mb-6">
            <img decoding="async" loading="lazy" src="/logo.svg" alt="Nomad Magazine" class="h-6" />
            <div class="flex gap-3">
              {
                socialLinks.map((link) => (
                  <a
                    href={link.href}
                    set:html={link.icon}
                    aria-label={`Follow us on ${link.name} (opens in new tab)`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="rounded-lg bg-gray-900 px-3 py-3 text-white shadow-md transition-colors duration-200 hover:bg-yellow-500 hover:text-black"
                  />
                ))
              }
            </div>
          </div>
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-6 text-gray-900">
              <span class="text-lg font-bold">© 2026 MediaPath OÜ</span>
              <a href="/privacy-policy/" class="font-semibold text-gray-900 transition-colors hover:text-yellow-600 hover:underline">Privacy Policy</a>
              <a href="/terms-and-conditions/" class="font-semibold text-gray-900 transition-colors hover:text-yellow-600 hover:underline">Terms & Conditions</a>
            </div>
            <div class="font-semibold text-gray-900">
              <a target="_blank" rel="noopener noreferrer" href="https://curves.digital" class="text-gray-900 transition-colors hover:text-yellow-600 hover:underline">design by CURVES (~.~)</a>, <a target="_blank" rel="noopener noreferrer" href="https://rishi.app" class="text-gray-900 transition-colors hover:text-yellow-600 hover:underline">dev by Rishi</a>
            </div>
          </div>
        </div>
      </div>
    </div>
    <!-- Mobile Footer -->
    <div class="mx-auto max-w-6xl md:hidden">
      <!-- Mobile Footer Links -->
      <div class="mb-8 grid grid-cols-1 gap-6 sm:grid-cols-2">
        {footerSections.map((section) => (
          <div class="space-y-3">
            <p class="text-lg font-bold text-gray-900">
              {section.title}
            </p>
            <ul class="space-y-2">
              {section.links.map((link) => (
                <li>
                  <a 
                    href={link.url} 
                    class="text-gray-600 hover:text-yellow-600 transition-colors duration-200"
                    target={link.url.startsWith('http') ? '_blank' : undefined}
                    rel={link.url.startsWith('http') ? 'noopener noreferrer' : undefined}
                    aria-label={link.url.startsWith('http') ? `${link.text} (opens in new tab)` : undefined}
                  >
                    {link.text}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      
      <!-- Mobile Newsletter Section -->
      <div class="mb-8 text-center border-t border-gray-200 pt-8">
        <p class="text-xl font-bold text-gray-900 mb-3">
          Join Our Community
        </p>
        <div class="flex flex-col gap-3">
          <a 
            href="/newsletter/" 
            class="inline-flex items-center justify-center px-6 py-3 bg-yellow-400 text-black font-bold rounded-lg hover:bg-yellow-300 transition-colors duration-200"
          >
            Subscribe to Newsletter
          </a>
          <SubstackFollow />
          <a 
            href="/newsletter-guidelines/" 
            class="text-sm text-gray-600 hover:text-yellow-600 underline"
          >
            Partner Guidelines →
          </a>
        </div>
      </div>
      
      <!-- Mobile Bottom Section -->
      <div class="flex flex-col items-start gap-6 border-t border-gray-200 pt-8">
        <img decoding="async" loading="lazy" src="/logo.svg" alt="Nomad Magazine" class="h-6" />
        <div class="flex gap-4">
          {
            socialLinks.map((link) => (
              <a
                href={link.href}
                set:html={link.icon}
                aria-label={`Follow us on ${link.name} (opens in new tab)`}
                target="_blank"
                rel="noopener noreferrer"
                class="rounded-lg bg-gray-900 px-4 py-4 text-white shadow-md transition-colors duration-200 hover:bg-yellow-500 hover:text-black"
              />
            ))
          }
        </div>
        <div class="flex flex-col items-start gap-4">
          <a href="/privacy-policy/" class="text-lg font-semibold text-gray-900 transition-colors hover:text-yellow-600 hover:underline">Privacy Policy</a>
          <a href="/terms-and-conditions/" class="text-lg font-semibold text-gray-900 transition-colors hover:text-yellow-600 hover:underline">Terms & Conditions</a>
        </div>
        <span class="text-lg font-bold text-gray-900">design & dev by CURVES (~.~)</span>
        <span class="text-lg font-bold">© 2026 MediaPath OÜ</span>
      </div>
    </div>
  </footer>
</div>
