---
const { formClass, tag } = Astro.props

const currentUrl = Astro.url
if (currentUrl) currentUrl.searchParams.set('form', 'true')
const eventType = `$subscribe_${tag}`
---

<section class="space-y-4">
  <form
    method="POST"
    class:list={['subscribe-form flex flex-col items-stretch gap-3 sm:flex-row sm:flex-wrap sm:items-center sm:gap-2', formClass]}
    data-redirect={currentUrl.toString()}
    aria-label="Subscribe to newsletter"
  >
    <input type="hidden" name="event_type" value={eventType} />
    <input
      required
      type="email"
      name="email"
      placeholder="Enter your email"
      aria-label="Email address"
      class="flex-1 rounded-lg border border-gray-300 px-4 py-3 text-lg focus:border-transparent focus:ring-2 focus:ring-yellow-400 focus:outline-none"
    />
    <button
      type="submit"
      class="submit-button w-full rounded-lg bg-yellow-400 px-8 py-3 text-lg font-semibold whitespace-nowrap text-black transition-all duration-200 hover:bg-yellow-500 sm:w-auto"
    >
      Subscribe
    </button>
    <div class="cf-turnstile" data-sitekey="0x4AAAAAACXWfgpGaqB_A50e" data-theme="light"></div>
  </form>
  <p class="font-semibold text-gray-600">Join now and be part of something bigger-your nomad family is waiting!</p>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const forms = document.querySelectorAll('.subscribe-form')

    forms.forEach((form) => {
      form.addEventListener('submit', async function (e) {
        e.preventDefault()

        const submitButton = form.querySelector('.submit-button') as HTMLButtonElement
        const redirectUrl = (form as HTMLFormElement).dataset.redirect

        if (!submitButton) return

        const turnstileWidget = form.querySelector('.cf-turnstile') as HTMLElement | null
        const turnstile = (window as Window & {
          turnstile?: {
            getResponse: (container?: Element | null) => string
            reset: (container?: Element | null) => void
          }
        }).turnstile

        const formData = new FormData(form as HTMLFormElement)
        const turnstileResponse =
          formData.get('cf-turnstile-response')?.toString().trim() ||
          turnstile?.getResponse(turnstileWidget) ||
          ''

        if (!turnstileResponse) {
          alert('Please complete the captcha verification.')
          return
        }

        formData.set('cf-turnstile-response', turnstileResponse)

        // Disable submit button
        submitButton.disabled = true
        const originalText = submitButton.textContent
        submitButton.textContent = 'Submitting...'

        try {
          const response = await fetch('/api/bento-event', {
            method: 'POST',
            body: formData,
          })

          const data = (await response.json()) as { success?: boolean; error?: string }

          if (response.ok && data.success) {
            // Redirect on success
            if (redirectUrl) {
              window.location.href = redirectUrl
            }
          } else {
            if (turnstile && turnstileWidget) {
              turnstile.reset(turnstileWidget)
            }
            alert(data.error || 'Failed to subscribe. Please try again.')
            submitButton.disabled = false
            submitButton.textContent = originalText || 'Subscribe'
          }
        } catch (error) {
          if (turnstile && turnstileWidget) {
            turnstile.reset(turnstileWidget)
          }
          alert('An error occurred. Please try again.')
          submitButton.disabled = false
          submitButton.textContent = originalText || 'Subscribe'
        }
      })
    })
  })
</script>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
