---
const { formClass, tag } = Astro.props

const currentUrl = Astro.url
if (currentUrl) currentUrl.searchParams.set('form', 'true')
const eventType = `$subscribe_${tag}`
---

<section class="space-y-4">
  <form
    method="POST"
    class:list={['subscribe-form flex flex-col items-stretch gap-3 sm:flex-row sm:items-center sm:gap-2', formClass]}
    data-redirect={currentUrl.toString()}
    aria-label="Subscribe to newsletter"
  >
    <input type="hidden" name="event_type" value={eventType} />
    <input
      required
      type="email"
      name="email"
      placeholder="Enter your email"
      aria-label="Email address"
      class="flex-1 rounded-lg border border-gray-300 px-4 py-3 text-lg focus:border-transparent focus:ring-2 focus:ring-yellow-400 focus:outline-none"
    />
    <button
      type="submit"
      class="submit-button w-full rounded-lg bg-yellow-400 px-8 py-3 text-lg font-semibold whitespace-nowrap text-black transition-all duration-200 hover:bg-yellow-500 sm:w-auto"
    >
      Subscribe
    </button>
  </form>
  <p class="font-semibold text-gray-600">Join now and be part of something bigger—your nomad family is waiting!</p>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const forms = document.querySelectorAll('.subscribe-form')

    forms.forEach((form) => {
      form.addEventListener('submit', async function (e) {
        e.preventDefault()

        const submitButton = form.querySelector('.submit-button') as HTMLButtonElement
        const redirectUrl = (form as HTMLFormElement).dataset.redirect

        if (!submitButton) return

        // Disable submit button
        submitButton.disabled = true
        const originalText = submitButton.textContent
        submitButton.textContent = 'Submitting...'

        const formData = new FormData(form as HTMLFormElement)

        try {
          const response = await fetch('/api/bento-event', {
            method: 'POST',
            body: formData,
          })

          const data = (await response.json()) as { success?: boolean; error?: string }

          if (response.ok && data.success) {
            // Redirect on success
            if (redirectUrl) {
              window.location.href = redirectUrl
            }
          } else {
            alert(data.error || 'Failed to subscribe. Please try again.')
            submitButton.disabled = false
            submitButton.textContent = originalText || 'Subscribe'
          }
        } catch (error) {
          alert('An error occurred. Please try again.')
          submitButton.disabled = false
          submitButton.textContent = originalText || 'Subscribe'
        }
      })
    })
  })
</script>
