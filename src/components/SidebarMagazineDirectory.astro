---
// Sidebar component with Magazine and Directory promotions
---

<!-- Magazine Box -->
<div class="bg-white border border-neutral-200 rounded-lg overflow-hidden shadow-sm">
  <div class="relative">
    <img 
      src="/images/edition-002-multiple-cover-background-purple.webp" 
      alt="Nomad Magazine Editions"
      class="w-full h-48 object-cover"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent"></div>
  </div>
  <div class="p-6 space-y-4">
    <div class="text-xs uppercase tracking-wider font-bold text-neutral-600">
      Nomad Magazine
    </div>
    <div class="text-lg font-bold text-neutral-900">
      Get Your Print Edition
    </div>
    <p class="text-sm leading-relaxed text-neutral-600">
      Dive deeper into nomad stories, exclusive interviews, and stunning photography. Available worldwide.
    </p>
    <a 
      href="/editions" 
      class="inline-flex items-center gap-2 bg-neutral-900 text-white px-4 py-2 rounded-lg hover:bg-neutral-800 transition-colors text-sm font-semibold"
    >
      Order Magazine
      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
      </svg>
    </a>
  </div>
</div>

<!-- Nomad Directory Box -->
<div class="bg-white border border-neutral-200 p-6 space-y-4 rounded-lg shadow-sm">
  <div class="text-xs uppercase tracking-wider font-bold text-yellow-500">
    Featured
  </div>
  <div class="space-y-4">
    <div class="flex items-center gap-3">
      <div class="flex-shrink-0 w-8 h-8 bg-yellow-400 rounded flex items-center justify-center">
        <svg class="w-4 h-4 text-black" fill="currentColor" viewBox="0 0 20 20">
          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
        </svg>
      </div>
      <div class="text-sm font-bold text-neutral-900">
        Nomad Directory
      </div>
    </div>
    <p class="text-sm leading-relaxed text-neutral-600">
      The best new tools, services, and companies for digital nomads to help you discover what's new in the nomad ecosystem.
    </p>
    <a 
      href="/nomad_directory" 
      class="inline-flex items-center gap-2 text-neutral-900 hover:text-neutral-700 transition-colors text-sm font-semibold"
    >
      Explore Directory
      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
      </svg>
    </a>
  </div>
</div>

