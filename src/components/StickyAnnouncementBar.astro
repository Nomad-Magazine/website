---
interface BarItem {
  type: 'announcement' | 'directory' | 'article'
  title: string
  link: string
  badge?: string
}

interface Props {
  items: BarItem[]
}

const { items } = Astro.props
---

<div id="announcement-ticker" class="ticker-wrapper">
  <!-- Close button -->
    <button 
      id="close-ticker" 
      class="close-btn"
      aria-label="Close announcement ticker"
      title="Close"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>
  
  <div class="ticker-container">
    <div class="ticker-track" id="ticker-track">
      {items.map((item) => (
        <a 
          href={item.link}
          class="ticker-item"
          target={item.link.startsWith('http') ? '_blank' : '_self'}
          rel={item.link.startsWith('http') ? 'noopener noreferrer' : undefined}
          aria-label={`${item.type}: ${item.title}`}
        >
          {item.badge && (
            <span class="ticker-badge">{item.badge}</span>
          )}
          <span class="ticker-title">{item.title}</span>
          <svg class="ticker-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
      ))}
      {/* Duplicate for seamless loop */}
      {items.map((item) => (
        <a 
          href={item.link}
          class="ticker-item"
          target={item.link.startsWith('http') ? '_blank' : '_self'}
          rel={item.link.startsWith('http') ? 'noopener noreferrer' : undefined}
          aria-label={`${item.type}: ${item.title}`}
        >
          {item.badge && (
            <span class="ticker-badge">{item.badge}</span>
          )}
          <span class="ticker-title">{item.title}</span>
          <svg class="ticker-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
      ))}
    </div>
  </div>
</div>

<style>
.ticker-wrapper {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 30;
  overflow: hidden;
  width: 100%;
  background: linear-gradient(135deg, #171717 0%, #262626 100%);
  border-top: 1px solid #404040;
  box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.3);
}

.close-btn {
  position: absolute;
  top: 50%;
  left: 1rem;
  transform: translateY(-50%);
  z-index: 10;
  padding: 0.625rem;
  color: #fbbf24;
  transition: all 0.3s ease;
  border-radius: 0.5rem;
  background: rgba(0, 0, 0, 0.6);
  border: 2px solid #fbbf24;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2px 8px rgba(251, 191, 36, 0.3);
  opacity: 0;
  pointer-events: none;
}

.ticker-wrapper:hover .close-btn {
  opacity: 1;
  pointer-events: auto;
}

.close-btn:hover {
  color: #000;
  background: #fbbf24;
  border-color: #fbbf24;
  transform: translateY(-50%) scale(1.1);
  box-shadow: 0 4px 12px rgba(251, 191, 36, 0.5);
}

.close-btn:active {
  transform: translateY(-50%) scale(0.95);
}

.ticker-container {
  display: flex;
  overflow: hidden;
  white-space: nowrap;
  position: relative;
  padding-left: 4rem; /* Space for close button */
}

.ticker-track {
  display: flex;
  gap: 2rem;
  animation: scroll-left 80s linear infinite;
  will-change: transform;
}

.ticker-track:hover {
  animation-play-state: paused;
}

@keyframes scroll-left {
  0% {
    transform: translateX(0);
  }
  100% {
    transform: translateX(-50%);
  }
}

.ticker-item {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 1rem 3rem;
  flex-shrink: 0;
  text-decoration: none;
  transition: all 0.2s ease;
  border-right: 1px solid rgba(255, 255, 255, 0.1);
}

.ticker-item:hover {
  background: rgba(251, 191, 36, 0.1);
}

.ticker-badge {
  display: inline-block;
  padding: 0.25rem 0.5rem;
  border-radius: 9999px;
  font-size: 0.625rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  background: #000;
  color: #fbbf24;
  border: 1px solid #fbbf24;
  flex-shrink: 0;
}

.ticker-title {
  font-weight: 500;
  font-size: 0.875rem;
  color: #fff;
  white-space: nowrap;
  transition: color 0.2s;
}

.ticker-item:hover .ticker-title {
  color: #fbbf24;
}

.ticker-arrow {
  width: 0.875rem;
  height: 0.875rem;
  color: #737373;
  flex-shrink: 0;
  transition: all 0.2s;
}

.ticker-item:hover .ticker-arrow {
  color: #fbbf24;
  transform: translateX(0.25rem);
}

/* Mobile optimizations */
@media (max-width: 768px) {
  .ticker-item {
    padding: 0.75rem 1.5rem;
  }
  
  .ticker-title {
    font-size: 0.75rem;
  }
  
  .ticker-badge {
    font-size: 0.5625rem;
    padding: 0.125rem 0.375rem;
  }
}

/* Mobile optimizations */
@media (max-width: 768px) {
  .ticker-track {
    gap: 1rem;
  }
}

/* Reduce motion for accessibility */
@media (prefers-reduced-motion: reduce) {
  .ticker-track {
    animation: scroll-left 160s linear infinite;
  }
}
</style>

<script>
  function initTicker() {
    const ticker = document.getElementById('announcement-ticker');
    const track = document.getElementById('ticker-track');
    const closeBtn = document.getElementById('close-ticker');
    
    if (!ticker || !track) return;
    
    // Adjust animation speed based on content width for smooth scrolling
    function adjustTickerSpeed() {
      if (!track) return;
      const trackWidth = track.scrollWidth / 2; // Divide by 2 because we duplicate items
      
      // Calculate optimal duration (pixels per second = 50)
      const duration = trackWidth / 50;
      
      track.style.animationDuration = `${duration}s`;
    }
    
    // Close button handler
    closeBtn?.addEventListener('click', () => {
      ticker.style.transition = 'transform 0.3s ease-out, opacity 0.3s ease-out';
      ticker.style.opacity = '0';
      ticker.style.transform = 'translateY(100%)';
      
      setTimeout(() => {
        ticker.style.display = 'none';
      }, 300);
      
      // Remember user closed it (session storage)
      sessionStorage.setItem('tickerClosed', 'true');
    });
    
    // Check if user previously closed it
    if (sessionStorage.getItem('tickerClosed') === 'true') {
      ticker.style.display = 'none';
      return;
    }
    
    // Initialize speed
    adjustTickerSpeed();
    window.addEventListener('resize', adjustTickerSpeed);
  }
  
  // Run on load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTicker);
  } else {
    initTicker();
  }
</script>
