---
// Component for sticky brand placement banner at bottom of page
---

<div id="sticky-brand-placement" class="fixed bottom-4 left-0 right-0 z-50 transform translate-y-full transition-transform duration-500 ease-in-out flex justify-center">
  <div class="bg-gradient-to-r from-yellow-400 to-orange-500 shadow-lg border-4 border-yellow-300 rounded-lg max-w-3xl mx-4">
    <div class="px-6 py-4">
      <div class="flex items-center justify-between gap-4">
        <div class="flex items-center gap-4">
          <div class="hidden sm:block">
            <svg class="h-8 w-8 text-black" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
            </svg>
          </div>
          <div>
            <h3 class="text-lg font-bold text-black">Partner with Nomad Magazine</h3>
            <p class="text-sm text-black/80">Reach digital nomads across 100+ coworking spaces worldwide</p>
          </div>
        </div>
        <div class="flex items-center gap-3">
          <a 
            href="/brand-placement-next-edition-847291" 
            class="inline-block rounded-lg bg-black px-5 py-2.5 text-sm font-bold text-yellow-400 transition-all hover:bg-gray-800 hover:scale-105 whitespace-nowrap"
          >
            Learn More
          </a>
          <button 
            id="close-brand-placement" 
            class="text-black/60 hover:text-black transition-colors"
            aria-label="Close banner"
          >
            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const banner = document.getElementById('sticky-brand-placement');
    const closeBtn = document.getElementById('close-brand-placement');
    let isVisible = false;
    let scrollTimeout: ReturnType<typeof setTimeout> | undefined;

    // Check if banner was previously closed
    const isClosed = localStorage.getItem('brandPlacementClosed') === 'true';
    
    if (!isClosed) {
      // Show banner after a delay when page loads
      setTimeout(() => {
        showBanner();
      }, 3000);

      // Show/hide on scroll
      window.addEventListener('scroll', function() {
        clearTimeout(scrollTimeout);
        
        if (!isClosed) {
          scrollTimeout = setTimeout(() => {
            const scrollY = window.scrollY;
            const windowHeight = window.innerHeight;
            const documentHeight = document.documentElement.scrollHeight;
            
            // Show when user scrolls past 50% of the page
            if (scrollY > windowHeight * 0.5) {
              showBanner();
            } else {
              hideBanner();
            }
          }, 100);
        }
      });
    }

    // Close banner functionality
    closeBtn?.addEventListener('click', function() {
      hideBanner();
      localStorage.setItem('brandPlacementClosed', 'true');
    });

    function showBanner() {
      if (!isVisible && banner) {
        banner.classList.remove('translate-y-full');
        banner.classList.add('translate-y-0');
        isVisible = true;
      }
    }

    function hideBanner() {
      if (isVisible && banner) {
        banner.classList.remove('translate-y-0');
        banner.classList.add('translate-y-full');
        isVisible = false;
      }
    }
  });
</script>

<style>
  @media (max-width: 640px) {
    #sticky-brand-placement .container {
      padding-left: 1rem;
      padding-right: 1rem;
    }
  }
</style> 