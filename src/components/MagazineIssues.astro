---
const issues = [
  {
    title: 'Available in print & digital',
    imageUrl: '/images/edition-004-cover.webp',
    alt: 'Edition Four',
    link: '/editions/fourth-edition/',
    downloadUrl: '/fourth-edition-giveaway/',
    isComingSoon: false,
  },
  {
    title: 'Available in print & digital',
    imageUrl: '/images/third-edition-cover-hd.webp',
    alt: 'Mind, Body, Tech for Nomad Life',
    link: '/editions/third-edition/',
    downloadUrl: '/third-edition-giveaway/',
  },
  {
    title: 'Available in print & digital',
    imageUrl: '/images/edition-002-cover.webp',
    alt: 'Inside Remote Communities',
    link: '/editions/second-edition/',
    downloadUrl: '/second-edition-giveaway/',
  },
  {
    title: 'Available in print & digital',
    imageUrl: '/images/first-edition-cover-hd.webp',
    alt: 'Digital Nomadism',
    link: '/editions/first-edition/',
    downloadUrl: '/first-edition-giveaway/',
  },
]
---

<section class="magazine-issues px-4 py-20 md:px-8">
  <div class="container mx-auto">
    <div class="grid grid-cols-1 gap-12 md:grid-cols-2 lg:grid-cols-4">
      {
        issues.map((issue) => (
          <div class="issue-card text-center">
            <a href={issue.link} class={issue.isComingSoon ? "coming-soon-wrapper" : ""}>
              {issue.isComingSoon ? (
                <div class="relative mb-6">
                  <img src={issue.imageUrl} alt={issue.alt} class="blur-effect aspect-3/4 h-auto w-full max-w-full object-cover shadow-lg shadow-white" />
                  <div class="coming-soon-overlay">
                    <span class="coming-soon-text">Coming Soon</span>
                    <span class="edition-text">Edition #4</span>
                  </div>
                </div>
              ) : (
                <img src={issue.imageUrl} alt={issue.alt} class="mb-6 aspect-3/4 h-auto w-full max-w-full object-cover shadow-lg shadow-white" />
              )}
              <h3 class="text-lg font-semibold text-yellow-400">{issue.title}</h3>
            </a>
            <div class="mt-2 flex flex-wrap items-center justify-center gap-x-4 gap-y-1">
              <a href={issue.link} class="inline-block text-white underline">
                Learn More
              </a>
              {issue.downloadUrl && (
                <a href={issue.downloadUrl} class="inline-block text-white underline">
                  Download PDF
                </a>
              )}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .coming-soon-wrapper {
    position: relative;
    display: block;
  }

  .blur-effect {
    filter: blur(8px);
    opacity: 0.6;
  }

  .coming-soon-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }

  .coming-soon-text {
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    font-weight: 900;
    color: white;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-shadow: 0 4px 12px rgba(0, 0, 0, 0.8),
                 0 2px 4px rgba(0, 0, 0, 0.6);
    filter: drop-shadow(0 0 20px rgba(255, 255, 255, 0.3));
  }

  .edition-text {
    font-size: clamp(1rem, 2.5vw, 1.5rem);
    font-weight: 600;
    color: #fbbf24;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.8);
  }
</style>
