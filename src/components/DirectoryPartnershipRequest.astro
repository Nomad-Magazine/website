---
import { DIRECTORY_TURNSTILE_SITE_KEY } from '~/const/directoryVoting'

interface Props {
  listingId: string
  listingTitle: string
}

const { listingId, listingTitle } = Astro.props
---

<div class="mt-8 border-t border-white/10 pt-8">
  <h2 class="text-lg font-bold text-white">Partner with {listingTitle}</h2>
  <p class="mt-2 text-sm text-gray-300">Send a partnership request. The listing owner will reply in their Nomad console.</p>
  <button
    type="button"
    class="mt-4 rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm font-semibold text-white transition-colors hover:border-yellow-400 hover:text-yellow-400 focus-visible:ring-2 focus-visible:ring-yellow-400"
    data-partnership-open
    aria-haspopup="dialog"
    aria-expanded="false"
    aria-controls={`partnership-dialog-${listingId}`}
  >
    Request partnership
  </button>

  <dialog
    id={`partnership-dialog-${listingId}`}
    class="partnership-dialog w-[min(480px,calc(100vw-2rem))] max-w-full rounded-2xl border border-white/15 bg-gray-950 p-0 text-white shadow-2xl backdrop:bg-black/70"
    aria-labelledby={`partnership-title-${listingId}`}
  >
    <form method="dialog" class="p-5" data-partnership-form data-listing-id={listingId}>
      <div class="mb-4 flex items-start justify-between gap-3">
        <h3 id={`partnership-title-${listingId}`} class="text-lg font-bold">Request partnership</h3>
        <button type="submit" class="rounded px-1 text-xl text-gray-400 hover:text-white focus-visible:ring-2 focus-visible:ring-yellow-400" aria-label="Close partnership form">×</button>
      </div>
      <div class="space-y-3">
        <div>
          <label class="mb-1 block text-sm text-gray-300" for={`partnership-name-${listingId}`}>Your name</label>
          <input
            id={`partnership-name-${listingId}`}
            name="name"
            required
            minlength="2"
            maxlength="120"
            autocomplete="name"
            class="w-full rounded-lg border border-white/20 bg-gray-900 px-3 py-2 text-sm text-white focus-visible:ring-2 focus-visible:ring-yellow-400"
          />
        </div>
        <div>
          <label class="mb-1 block text-sm text-gray-300" for={`partnership-email-${listingId}`}>Email</label>
          <input
            id={`partnership-email-${listingId}`}
            name="email"
            type="email"
            inputmode="email"
            required
            maxlength="254"
            autocomplete="email"
            class="w-full rounded-lg border border-white/20 bg-gray-900 px-3 py-2 text-sm text-white focus-visible:ring-2 focus-visible:ring-yellow-400"
          />
        </div>
        <div>
          <label class="mb-1 block text-sm text-gray-300" for={`partnership-company-${listingId}`}>Company / website</label>
          <input
            id={`partnership-company-${listingId}`}
            name="company"
            maxlength="200"
            autocomplete="organization"
            class="w-full rounded-lg border border-white/20 bg-gray-900 px-3 py-2 text-sm text-white focus-visible:ring-2 focus-visible:ring-yellow-400"
          />
        </div>
        <div>
          <label class="mb-1 block text-sm text-gray-300" for={`partnership-message-${listingId}`}>Message</label>
          <textarea
            id={`partnership-message-${listingId}`}
            name="message"
            required
            minlength="10"
            maxlength="2000"
            rows="4"
            class="w-full rounded-lg border border-white/20 bg-gray-900 px-3 py-2 text-sm text-white focus-visible:ring-2 focus-visible:ring-yellow-400"
          />
        </div>
        <div class="cf-turnstile" data-sitekey={DIRECTORY_TURNSTILE_SITE_KEY} data-theme="dark" />
        <p data-partnership-error class="hidden text-sm text-yellow-300" role="alert"></p>
        <p data-partnership-success class="hidden text-sm text-green-300" role="status">Request sent. The owner will follow up in their console.</p>
        <button
          type="button"
          data-partnership-submit
          class="w-full rounded-lg bg-yellow-400 px-4 py-2 text-sm font-bold text-black hover:bg-yellow-300 focus-visible:ring-2 focus-visible:ring-yellow-400"
        >
          Send request
        </button>
      </div>
    </form>
  </dialog>
</div>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<script>
  document.querySelectorAll('[data-partnership-open]').forEach((openBtn) => {
    const wrapper = openBtn.closest('div')
    const dialog = wrapper?.querySelector('dialog')
  const form = dialog?.querySelector('[data-partnership-form]')
    if (!(dialog instanceof HTMLDialogElement) || !form) return
    const submitBtn = form.querySelector('[data-partnership-submit]')
    const errorEl = form.querySelector('[data-partnership-error]')
    const successEl = form.querySelector('[data-partnership-success]')
    openBtn.addEventListener('click', () => {
      dialog.showModal()
      openBtn.setAttribute('aria-expanded', 'true')
    })
    dialog.addEventListener('close', () => openBtn.setAttribute('aria-expanded', 'false'))
    submitBtn?.addEventListener('click', async () => {
      if (!(submitBtn instanceof HTMLButtonElement) || !(errorEl instanceof HTMLElement) || !(successEl instanceof HTMLElement)) return
      errorEl.classList.add('hidden')
      successEl.classList.add('hidden')
      const listingId = form.getAttribute('data-listing-id') || ''
      const name = (form.querySelector('[name="name"]') as HTMLInputElement)?.value?.trim() || ''
      const email = (form.querySelector('[name="email"]') as HTMLInputElement)?.value?.trim() || ''
      const company = (form.querySelector('[name="company"]') as HTMLInputElement)?.value?.trim() || ''
      const message = (form.querySelector('[name="message"]') as HTMLTextAreaElement)?.value?.trim() || ''
      const turnstile = form.querySelector('.cf-turnstile')
      const turnstileToken = (window as Window & { turnstile?: { getResponse(el?: Element): string } }).turnstile?.getResponse(turnstile ?? undefined) || ''
      submitBtn.disabled = true
      try {
        const res = await fetch('/api/directory-partnership-request/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ listing_id: listingId, name, email, company, message, turnstile_token: turnstileToken }),
        })
        const data = (await res.json().catch(() => ({}))) as { error?: string }
        if (!res.ok) {
          errorEl.textContent = data.error || 'Could not send your request.'
          errorEl.classList.remove('hidden')
          return
        }
        successEl.classList.remove('hidden')
        form.querySelectorAll('input,textarea').forEach((el) => {
          if (el instanceof HTMLInputElement || el instanceof HTMLTextAreaElement) el.value = ''
        })
      } catch {
        errorEl.textContent = 'Could not send your request.'
        errorEl.classList.remove('hidden')
      } finally {
        submitBtn.disabled = false
      }
    })
  })
</script>

<style>
  .partnership-dialog::backdrop {
    background: rgba(0, 0, 0, 0.7);
  }
</style>