---
import SubmitIcon from '~icons/mdi/pencil'
import BiQuote from '~icons/gridicons/quote'

const testimonials = [
  {
    text: 'I love the magazine! The print quality is excellent, the paper feels great, and the graphics are truly stunning. Congratulations on creating such a fantastic publication! It was truly needed in our industry, and I wish you many more successes ahead.',
    author: 'Teresa Zielonka',
    title: 'CO-FOUNDER, TRIPOFFICE.COM',
  },
  {
    text: "Nomad Magazine is like having that well-traveled, fascinating friend who always knows the best places to go, how to settle in, and how to avoid common expat headaches—whether it's picking the right health insurance or figuring out the dating scene in a new country. The magazine saves me hours of searching online, wrapping up useful tips in a design so beautiful, I actually want to hold it in my hands. In a world where everything is digital, Nomad reminds me that the most thrilling journeys — and the most captivating stories—are still best enjoyed offline. Don't just read about the nomad life—live it, and take this gem along for the ride!",
    author: 'Francesco Silicani',
    title: 'BUSINESS DEVELOPER @ SILICANI INNOVATIVE PARTNERS',
    avatar: '/images/edition-002-francesco-silicani.webp',
  },
  {
    text: "I love the Founder's passion and vision behind this magazine - her desire to share the real and inspiring stories of nomads. Not just all the fluff and IG gloss - but what really makes this community and it's members special. The true behind the scenes that tells a story - one of adventure, discovery, and success through many trial & errors. Her vision and approach to storytelling is inspiring, and I look forward to many more nomad magazine issues and newsletters to come.",
    author: 'Anna Shcherbyna',
    title: 'CEO @ REMOTIVATE',
    avatar: '/images/anna-shcherbyna-remotivate.webp',
  },
  {
    text: "NomadGossip is the digital nomad's inside scoop—raw, real, and refreshingly unfiltered. It's not just another travel blog; it's a space where remote workers find stories that resonate, from productivity hacks to the untold realities of nomadic life. This magazine feels like a conversation with someone who gets it. A must-read for anyone living (or dreaming of) the nomadic life!",
    author: 'NY',
    title: 'DELIVERY MANAGER',
    avatar: '/images/ny-delivery-manager.webp',
  },
  {
    text: "I've loved this project since the very beginning—its values, the idea of discussing important topics, the openness to different opinions, and of course, the brand and design we created together!",
    author: 'Anna Egorova',
    title: 'CO-OWNER AT CURVES.DIGITAL',
    avatar: '/images/anna-egorova-curves-digital.webp',
  },
  {
    text: 'I love the deep insights has the magazine brings from the people, communities, cities and our lifestyle in general. More people should read this articles if you want to get inspired to keep being a digital nomad!',
    author: 'Sergio Sala',
    title: 'YOUTUBER',
    avatar: '/images/sergio-sala-youtuber.webp',
  },
  {
    text: 'I love NGM as it embodies everything about me—a nomad looking for connection, understanding, information and advice. From travel destinations and inspirational stories, to relationship and business advice, NGM covers everything for us digital nomads, making us feel seen and understood.',
    author: 'Jessica Holmes',
    title: 'WRITER & EDITOR',
    avatar: '/images/jessica-holmes_waterfall.webp',
  },
  {
    text: 'The issue looks beautiful, loved flipping through it 🧡 Congrats on the amazing work, and thanks again for having us as part of it! Big hug,',
    author: 'Ramon Morcillo',
    title: 'CO-FOUNDER @ MAPMELON',
    avatar: '/images/edition-003-ramon-morcillo.webp',
  },
]

interface Props {
  sectionClass?: string
}

const { sectionClass }: Props = Astro.props
---

<section id="Testimonials" class:list={['py-16', sectionClass]}>
  <div class="container mx-auto px-4">
    <div class="mb-12 flex items-center justify-between">
      <div>
        <h2 class="text-3xl font-bold text-white">What People Say</h2>
        <p class="mt-2 text-lg text-neutral-400">Trusted by digital nomads worldwide</p>
      </div>
      <a href="/add-testimonials" class="inline-flex items-center gap-2 rounded-lg bg-yellow-400 px-4 py-2 text-sm font-bold text-black transition-all hover:bg-yellow-300">
        <SubmitIcon class="h-4 w-4" />
        <span>Submit Review</span>
      </a>
    </div>
    
    <!-- Grid layout showing all testimonials -->
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        testimonials.map((testimonial, index) => (
          <div class={`rounded-2xl p-6 transition-all hover:scale-105 ${
            index === 0 
              ? 'bg-gradient-to-br from-yellow-500/10 to-orange-500/10 border border-yellow-500/20' 
              : 'bg-neutral-900/50 border border-neutral-800'
          }`}>
            <div class="mb-4">
              <BiQuote class="h-8 w-8 text-yellow-400 opacity-60" />
            </div>
            <p class="text-sm text-neutral-300 leading-relaxed line-clamp-4 mb-6">{testimonial.text}</p>
            <div class="flex items-center">
              {testimonial.avatar && (
                <img 
                  src={testimonial.avatar} 
                  alt={testimonial.author} 
                  class="mr-3 h-10 w-10 rounded-full object-cover border-2 border-neutral-700" 
                />
              )}
              <div>
                <p class="font-semibold text-white text-sm">{testimonial.author}</p>
                <p class="text-xs text-neutral-400 uppercase tracking-wide">{testimonial.title}</p>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
.line-clamp-4 {
  display: -webkit-box;
  -webkit-line-clamp: 4;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
</style>
