---
export interface Props {
  id?: string;
}

const { id = 'description-modal' } = Astro.props;
---

<!-- Description Modal for Full Markdown View -->
<div id={id} class="fixed inset-0 bg-black bg-opacity-90 z-50 hidden">
  <div class="flex items-center justify-center min-h-screen p-4">
    <div class="relative max-w-4xl w-full max-h-[90vh] overflow-hidden">
      <!-- Close Button -->
      <button 
        id="close-description-modal" 
        class="absolute top-4 right-4 z-10 text-white hover:text-yellow-400 transition-colors duration-200 bg-black/50 rounded-full p-2"
        aria-label="Close description modal"
      >
        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
      
      <!-- Modal Content -->
      <div class="bg-neutral-700 rounded-lg p-6 max-h-full overflow-y-auto">
        <!-- Title -->
        <h2 id="description-modal-title" class="text-2xl font-bold text-white mb-4"></h2>
        
        <!-- Description Content -->
        <div id="description-modal-content" class="prose prose-invert max-w-none">
          <!-- Markdown content will be rendered here -->
        </div>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  // Description Modal functionality
  let currentDescriptionModal = { spaceName: '', description: '' };

  function openDescriptionModal(spaceName, description, descriptionMarkdown) {
    currentDescriptionModal = { spaceName, description, descriptionMarkdown };
    const modal = document.getElementById('description-modal');
    const modalTitle = document.getElementById('description-modal-title');
    const modalContent = document.getElementById('description-modal-content');
    
    if (modal && modalTitle && modalContent) {
      modalTitle.textContent = spaceName;
      
      let htmlContent = '';
      
      // Add regular description if available
      if (description && description.trim()) {
        htmlContent += `
          <div class="mb-6">
            <div class="text-gray-100 leading-relaxed text-base">${description}</div>
          </div>
        `;
      }
      
                // Add markdown description if available and different from regular description
                if (descriptionMarkdown && descriptionMarkdown.trim() && descriptionMarkdown !== description) {
                  const markdownHtml = convertMarkdownToHtml(descriptionMarkdown);
                  htmlContent += `
                    <div class="mb-6">
                      <div>${markdownHtml}</div>
                    </div>
                  `;
                }
                
                // Add nominations section (MVP with example data)
                htmlContent += `
                  <div class="mt-8 pt-6 border-t border-neutral-600">
                    <h3 class="text-lg font-bold text-white mb-4">Community Testimonials</h3>
                    <div class="bg-neutral-800 rounded-lg p-6 border-l-4 border-yellow-400 max-h-80 overflow-y-auto scrollbar-thin scrollbar-thumb-neutral-600 scrollbar-track-neutral-800">
                      <div class="space-y-4 text-gray-100 leading-relaxed">
                        <div class="flex items-start">
                          <div class="flex-shrink-0 w-2 h-2 bg-yellow-400 rounded-full mt-2 mr-3"></div>
                          <div>
                            <span class="font-semibold text-white">Vibrant Community:</span> Regular brunches and networking events create a strong sense of community and professional connection.
                          </div>
                        </div>
                        <div class="flex items-start">
                          <div class="flex-shrink-0 w-2 h-2 bg-yellow-400 rounded-full mt-2 mr-3"></div>
                          <div>
                            <span class="font-semibold text-white">Pet-Friendly:</span> It's one of the few places that welcome pets, making it a much more inclusive and enjoyable environment for animal lovers.
                          </div>
                        </div>
                        <div class="flex items-start">
                          <div class="flex-shrink-0 w-2 h-2 bg-yellow-400 rounded-full mt-2 mr-3"></div>
                          <div>
                            <span class="font-semibold text-white">Excellent Amenities and Flexibility:</span> With 24/7 access, modern facilities, and a variety of workspace solutions (from single desks to warehouses), it adapts to every need.
                          </div>
                        </div>
                        <div class="flex items-start">
                          <div class="flex-shrink-0 w-2 h-2 bg-yellow-400 rounded-full mt-2 mr-3"></div>
                          <div>
                            <span class="font-semibold text-white">Great Location:</span> It's well-located near the river, offering the perfect opportunity for a refreshing stroll along the water during a break.
                          </div>
                        </div>
                        <div class="flex items-start">
                          <div class="flex-shrink-0 w-2 h-2 bg-yellow-400 rounded-full mt-2 mr-3"></div>
                          <div>
                            <span class="font-semibold text-white">Great Accessibility:</span> Easy to get to via public transport and bike paths, with the bonus of free parking nearby.
                          </div>
                        </div>
                      </div>
                      <div class="mt-4 pt-4 border-t border-neutral-700">
                        <p class="text-sm text-neutral-400 italic">Shared by nomads who nominated this space</p>
                      </div>
                    </div>
                  </div>
                `;
      
      modalContent.innerHTML = htmlContent || '<p class="text-neutral-400">No description available.</p>';
      
      modal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }
  }

  function closeDescriptionModal() {
    const modal = document.getElementById('description-modal');
    if (modal) {
      modal.classList.add('hidden');
      document.body.style.overflow = '';
    }
  }

  // Simple markdown to HTML converter
  function convertMarkdownToHtml(markdown) {
    if (!markdown) return '';
    
    console.log('Original markdown:', markdown);
    
    // First, convert escaped newlines to actual newlines
    markdown = markdown.replace(/\\n/g, '\n');
    
    console.log('After unescaping newlines:', markdown);
    
    let html = markdown
      // Headers first
      .replace(/^### (.*$)/gim, '<h3 class="text-lg font-bold text-white mt-6 mb-3">$1</h3>')
      .replace(/^## (.*$)/gim, '<h2 class="text-xl font-bold text-white mt-6 mb-4">$1</h2>')
      .replace(/^# (.*$)/gim, '<h1 class="text-2xl font-bold text-white mt-6 mb-4">$1</h1>')
      
      // Bold and Italic
      .replace(/\*\*(.*?)\*\*/g, '<strong class="font-bold text-white">$1</strong>')
      .replace(/\*(.*?)\*/g, '<em class="italic text-neutral-100">$1</em>')
      
      // Links
      .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank" rel="noopener noreferrer" class="text-yellow-400 hover:text-yellow-300 underline">$1</a>');
    
    // Now handle paragraph breaks more intelligently
    if (html.includes('\n\n')) {
      // Has double line breaks - use those for paragraphs
      html = html.split(/\n\s*\n/).map(para => {
        if (!para.trim()) return '';
        if (para.trim().startsWith('<h')) return para.trim();
        return `<p class="text-gray-100 mb-4 leading-relaxed text-base">${para.trim().replace(/\n/g, '<br>')}</p>`;
      }).filter(p => p).join('');
    } else if (html.includes('\n')) {
      // Has single line breaks - treat each as a new paragraph or use sentence detection
      const sentences = html.split(/(?<=[.!?])\s*\n/);
      if (sentences.length > 1) {
        html = sentences.map(sentence => {
          if (!sentence.trim()) return '';
          if (sentence.trim().startsWith('<h')) return sentence.trim();
          return `<p class="text-gray-100 mb-4 leading-relaxed text-base">${sentence.trim()}</p>`;
        }).filter(p => p).join('');
      } else {
        // Try splitting long text by sentence endings followed by capital letters
        html = html.replace(/([.!?])\s+([A-Z])/g, '$1</p><p class="text-gray-100 mb-4 leading-relaxed text-base">$2');
        if (!html.startsWith('<h') && !html.startsWith('<p')) {
          html = `<p class="text-gray-100 mb-4 leading-relaxed text-base">${html}</p>`;
        }
      }
    } else {
      // No line breaks - wrap in single paragraph
      if (!html.startsWith('<h') && !html.startsWith('<p')) {
        html = `<p class="text-gray-100 mb-4 leading-relaxed text-base">${html}</p>`;
      }
    }
    
    console.log('Final HTML:', html);
    return html;
  }

  // Setup event listeners
  function setupDescriptionModalListeners() {
    const closeBtn = document.getElementById('close-description-modal');
    if (closeBtn) {
      closeBtn.addEventListener('click', closeDescriptionModal);
    }

    // Keyboard navigation
    document.addEventListener('keydown', (e) => {
      const descriptionModal = document.getElementById('description-modal');
      
      if (descriptionModal && !descriptionModal.classList.contains('hidden')) {
        if (e.key === 'Escape') closeDescriptionModal();
      }
    });

    // Click outside modal to close
    const modal = document.getElementById('description-modal');
    if (modal) {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) {
          closeDescriptionModal();
        }
      });
    }
  }

  // Make functions globally available
  window.openDescriptionModal = openDescriptionModal;
  window.closeDescriptionModal = closeDescriptionModal;

  // Initialize when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupDescriptionModalListeners);
  } else {
    setupDescriptionModalListeners();
  }
</script>

<style>
  /* Smooth transitions for modal */
  #description-modal {
    backdrop-filter: blur(4px);
    transition: opacity 0.3s ease-in-out;
  }

  /* Hover effects for close button */
  #close-description-modal:hover {
    background-color: rgba(0, 0, 0, 0.8);
    transform: scale(1.1);
  }

  /* Custom prose styles for dark theme */
  .prose.prose-invert {
    color: #f9fafb;
    line-height: 1.7;
  }

  .prose.prose-invert h1,
  .prose.prose-invert h2,
  .prose.prose-invert h3,
  .prose.prose-invert h4 {
    color: #ffffff;
  }

  .prose.prose-invert a {
    color: #fbbf24;
    text-decoration: underline;
  }

  .prose.prose-invert a:hover {
    color: #fcd34d;
  }

  .prose.prose-invert strong {
    color: #ffffff;
  }

  .prose.prose-invert em {
    color: #f9fafb;
  }

  .prose.prose-invert p {
    color: #f9fafb;
    margin-bottom: 1rem;
    font-size: 1rem;
  }

  /* Scrollbar styling */
  #description-modal .overflow-y-auto::-webkit-scrollbar {
    width: 8px;
  }

  #description-modal .overflow-y-auto::-webkit-scrollbar-track {
    background: rgba(55, 65, 81, 0.5);
    border-radius: 4px;
  }

  #description-modal .overflow-y-auto::-webkit-scrollbar-thumb {
    background: rgba(156, 163, 175, 0.5);
    border-radius: 4px;
  }

  #description-modal .overflow-y-auto::-webkit-scrollbar-thumb:hover {
    background: rgba(156, 163, 175, 0.8);
  }
</style>
