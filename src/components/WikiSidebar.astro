---
interface Props {
  currentChapter: number; // 0 = index, 1-12 = chapter
}
const { currentChapter } = Astro.props;

const chapters = [
  { num: 1, slug: 'chapter-1', title: 'What Is Digital Nomadism?', desc: 'The Lifestyle' },
  { num: 2, slug: 'chapter-2', title: 'A Brief History', desc: 'Origins' },
  { num: 3, slug: 'chapter-3', title: 'Who Are the Nomads?', desc: 'The People' },
  { num: 4, slug: 'chapter-4', title: 'The Infrastructure', desc: 'The Tools' },
  { num: 5, slug: 'chapter-5', title: 'Where Do They Go?', desc: 'Destinations' },
  { num: 6, slug: 'chapter-6', title: 'Legal Life & Visas', desc: 'Visas & Law' },
  { num: 7, slug: 'chapter-7', title: 'Money Matters', desc: 'Finances' },
  { num: 8, slug: 'chapter-8', title: 'Life on the Move', desc: 'Daily Life' },
  { num: 9, slug: 'chapter-9', title: 'The Ecosystem', desc: 'Services' },
  { num: 10, slug: 'chapter-10', title: 'Criticism & Controversies', desc: 'Controversies' },
  { num: 11, slug: 'chapter-11', title: 'The Future of Nomadism', desc: "What's Next" },
  { num: 12, slug: 'chapter-12', title: 'Entering the Market', desc: 'For Brands' },
];
---

<!-- Desktop Sidebar -->
<div class="hidden lg:block w-72 bg-white border-r border-gray-200 min-h-screen shrink-0">
  <div class="sticky top-0 p-5 max-h-screen overflow-y-auto">
    <a href="/digital-nomad-wiki/" class="flex items-center gap-2 mb-6 group">
      <div class="bg-yellow-400 text-black px-2 py-0.5 rounded text-xs font-bold">WIKI</div>
      <span class="text-sm font-semibold text-gray-700 group-hover:text-gray-900">Digital Nomad Encyclopedia</span>
    </a>

    <nav aria-label="Wiki chapters">
      <a
        href="/digital-nomad-wiki/"
        class={`flex items-center px-3 py-2 rounded-lg text-sm font-medium mb-1 transition-colors ${
          currentChapter === 0
            ? 'bg-gray-900 text-white'
            : 'text-gray-600 hover:bg-gray-100 hover:text-gray-900'
        }`}
      >
        Introduction
      </a>
      <div class="mt-3 space-y-1">
        {chapters.map((ch) => (
          <a
            href={`/digital-nomad-wiki/${ch.slug}/`}
            class={`flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm transition-colors ${
              currentChapter === ch.num
                ? 'bg-gray-900 text-white'
                : 'text-gray-700 hover:bg-gray-100 hover:text-gray-900'
            }`}
          >
            <span class={`shrink-0 w-6 h-6 rounded-full flex items-center justify-center text-xs font-bold ${
              currentChapter === ch.num ? 'bg-white text-gray-900' : 'bg-gray-100 text-gray-600'
            }`}>
              {ch.num}
            </span>
            <span class="flex-1 leading-tight">
              <span class="block font-medium">{ch.desc}</span>
            </span>
          </a>
        ))}

        <a
          href="/digital-nomad-wiki/conclusion/"
          class={`flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm transition-colors ${
            currentChapter === 13
              ? 'bg-gray-900 text-white'
              : 'text-gray-700 hover:bg-gray-100 hover:text-gray-900'
          }`}
        >
          <span class={`shrink-0 w-6 h-6 rounded-full flex items-center justify-center text-xs font-bold ${
            currentChapter === 13 ? 'bg-white text-gray-900' : 'bg-gray-100 text-gray-600'
          }`}>∞</span>
          <span class="flex-1 leading-tight">
            <span class="block font-medium">Conclusion</span>
          </span>
        </a>
      </div>
    </nav>

    <div class="mt-6 pt-5 border-t border-gray-100">
      <a href="/newsletter/" class="block w-full text-center px-3 py-2 bg-yellow-400 hover:bg-yellow-500 text-black text-xs font-semibold rounded-full transition-colors">
        Subscribe to Newsletter →
      </a>
    </div>
  </div>
</div>

<!-- Mobile Top Bar -->
<div class="lg:hidden sticky top-0 z-40 bg-white border-b border-gray-200 px-4 py-3 flex items-center justify-between">
  <a href="/digital-nomad-wiki/" class="flex items-center gap-2">
    <div class="bg-yellow-400 text-black px-2 py-0.5 rounded text-xs font-bold">WIKI</div>
    <span class="text-sm font-semibold text-gray-700">
      {currentChapter === 0 ? 'Introduction' : `Ch. ${currentChapter} · ${chapters[currentChapter - 1]?.desc}`}
    </span>
  </a>
  <button
    id="wiki-mobile-menu-button"
    type="button"
    aria-label="Toggle chapter navigation"
    class="p-2 rounded-lg border border-gray-200 text-gray-600"
  >
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
    </svg>
  </button>
</div>

<!-- Mobile Drawer -->
<div id="wiki-mobile-drawer" class="lg:hidden fixed inset-0 z-50 hidden">
  <div id="wiki-mobile-backdrop" class="fixed inset-0 bg-black bg-opacity-40"></div>
  <div id="wiki-mobile-panel" class="fixed top-0 left-0 w-72 h-full bg-white shadow-xl transform -translate-x-full transition-transform duration-300 overflow-y-auto">
    <div class="p-5 border-b border-gray-200 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <div class="bg-yellow-400 text-black px-2 py-0.5 rounded text-xs font-bold">WIKI</div>
        <span class="text-sm font-semibold text-gray-700">Chapters</span>
      </div>
      <button id="wiki-mobile-close" type="button" aria-label="Close navigation" class="text-gray-400 hover:text-gray-600">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
    <nav class="p-4" aria-label="Wiki chapters mobile">
      <a
        href="/digital-nomad-wiki/"
        class={`flex items-center px-3 py-2 rounded-lg text-sm font-medium mb-1 transition-colors ${
          currentChapter === 0 ? 'bg-gray-900 text-white' : 'text-gray-600 hover:bg-gray-100'
        }`}
      >
        Introduction
      </a>
      <div class="mt-3 space-y-1">
        {chapters.map((ch) => (
          <a
            href={`/digital-nomad-wiki/${ch.slug}/`}
            class={`flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm transition-colors ${
              currentChapter === ch.num ? 'bg-gray-900 text-white' : 'text-gray-700 hover:bg-gray-100'
            }`}
          >
            <span class={`shrink-0 w-6 h-6 rounded-full flex items-center justify-center text-xs font-bold ${
              currentChapter === ch.num ? 'bg-white text-gray-900' : 'bg-gray-100 text-gray-600'
            }`}>
              {ch.num}
            </span>
            <span class="flex-1 leading-tight">
              <span class="block font-medium">{ch.desc}</span>
              <span class="block text-xs opacity-70">{ch.title}</span>
            </span>
          </a>
        ))}
        <a
          href="/digital-nomad-wiki/conclusion/"
          class={`flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm transition-colors ${
            currentChapter === 13 ? 'bg-gray-900 text-white' : 'text-gray-700 hover:bg-gray-100'
          }`}
        >
          <span class={`shrink-0 w-6 h-6 rounded-full flex items-center justify-center text-xs font-bold ${
            currentChapter === 13 ? 'bg-white text-gray-900' : 'bg-gray-100 text-gray-600'
          }`}>∞</span>
          <span class="flex-1 leading-tight">
            <span class="block font-medium">Conclusion</span>
          </span>
        </a>
      </div>
    </nav>
  </div>
</div>

<script>
  const btn = document.getElementById('wiki-mobile-menu-button');
  const drawer = document.getElementById('wiki-mobile-drawer');
  const panel = document.getElementById('wiki-mobile-panel');
  const close = document.getElementById('wiki-mobile-close');
  const backdrop = document.getElementById('wiki-mobile-backdrop');

  function openDrawer() {
    drawer?.classList.remove('hidden');
    setTimeout(() => panel?.classList.remove('-translate-x-full'), 10);
  }
  function closeDrawer() {
    panel?.classList.add('-translate-x-full');
    setTimeout(() => drawer?.classList.add('hidden'), 300);
  }

  btn?.addEventListener('click', openDrawer);
  close?.addEventListener('click', closeDrawer);
  backdrop?.addEventListener('click', closeDrawer);
</script>
