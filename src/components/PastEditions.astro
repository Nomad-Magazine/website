---
import EditionCard from './EditionCard.astro'

const editions = [
  {
    title: 'Third Edition',
    imageUrl: '/images/third-edition-cover-hd.webp',
    buttons: [
      {
        text: 'Learn More',
        url: '/editions/third-edition/',
        primary: false,
      },
      {
        text: 'Download PDF',
        url: '/third-edition-giveaway/',
        primary: false,
      },
    ],
  },
  {
    title: 'Second Edition',
    imageUrl: '/images/edition-002-cover.webp',
    storeUrl: 'https://brot.sk/products/nomad-gossip-magazine-2?_pos=3&_psq=nomad&_ss=e&_v=1.0',
    storeText: 'Print also available to order at Brot.sk store!',
    buttons: [
      {
        text: 'Learn More',
        url: '/editions/second-edition/',
        primary: false,
      },
      {
        text: 'Download PDF',
        url: '/second-edition-giveaway/',
        primary: false,
      },
    ],
  },
  {
    title: 'First Edition',
    imageUrl: '/images/first-edition-cover-hd.webp',
    storeUrl: 'https://brot.sk/products/nomad-gossip-magazine-1?_pos=3&_psq=nomad&_ss=e&_v=1.0',
    storeText: 'Print also available to order at Brot.sk store!',
    buttons: [
      {
        text: 'Learn More',
        url: '/editions/first-edition/',
        primary: false,
      },
      {
        text: 'Download PDF',
        url: '/first-edition-giveaway/',
        primary: false,
      },
    ],
  },
]
---

<section class="py-20">
  <div class="container mx-auto px-4">
    <div class="grid grid-cols-1 items-start gap-16 md:grid-cols-2 lg:grid-cols-3">
      {editions.map((edition) => <EditionCard {...edition} />)}
    </div>
  </div>
</section>
