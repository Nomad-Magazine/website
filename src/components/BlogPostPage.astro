---
import { render } from 'astro:content'
import Layout, { type SEOProps } from '~/layouts/Layout.astro'
import SidebarMagazineDirectory from '~/components/SidebarMagazineDirectory.astro'
import { createBlogPostingSchema } from '~/utils/schema'

const { post, allPosts } = Astro.props

const { Content } = await render(post)
const currentPostTags = post.data.tag ? post.data.tag.split(',').map((t: string) => t.trim()) : []
const currentPostCategory = post.data.category

const categoryFilteredPosts = currentPostCategory
  ? allPosts.filter((p: typeof post) => p.data.category === currentPostCategory)
  : allPosts

let relatedPosts = categoryFilteredPosts
  .filter((p: typeof post) => {
    if (p.slug === post.slug || !p.data.tag || !currentPostTags.length) return false
    const otherPostTags = p.data.tag.split(',').map((t: string) => t.trim())
    return otherPostTags.some((tag: string) => currentPostTags.includes(tag))
  })
  .sort((a: typeof post, b: typeof post) => (b.data.pubDate || new Date(0)).valueOf() - (a.data.pubDate || new Date(0)).valueOf())

if (relatedPosts.length < 3) {
  const latestPosts = categoryFilteredPosts
    .filter((p: typeof post) => p.slug !== post.slug && !relatedPosts.find((rp: typeof post) => rp.slug === p.slug))
    .sort((a: typeof post, b: typeof post) => (b.data.pubDate || new Date(0)).valueOf() - (a.data.pubDate || new Date(0)).valueOf())
  const needed = 9 - relatedPosts.length
  relatedPosts.push(...latestPosts.slice(0, needed))
}

const finalRelatedPosts = relatedPosts.slice(0, 3)

const socialImage = post.data.heroImage
  ? (post.data.heroImage.startsWith('http') ? post.data.heroImage : `${Astro.site}${post.data.heroImage.startsWith('/') ? post.data.heroImage.slice(1) : post.data.heroImage}`)
  : `${Astro.site}images/edition-003-cover_holded_front_face.webp`

const seo: SEOProps = {
  title: post.data.title,
  description: post.data.description,
  image: socialImage,
  keywords: post.data.keywords || 'digital nomad, remote work, travel, nomad lifestyle',
  ogType: 'article',
  publishedTime: post.data.pubDate?.toISOString(),
  modifiedTime: post.data.updatedDate?.toISOString(),
  section: 'Digital Nomad Lifestyle',
  tags: currentPostTags,
  author: post.data.author || 'Martin Donadieu',
  ldJSON: createBlogPostingSchema({
    headline: post.data.title,
    description: post.data.description,
    image: socialImage,
    url: `${Astro.site}blog/${post.slug}/`,
    datePublished: post.data.pubDate?.toISOString(),
    dateModified: post.data.updatedDate?.toISOString(),
    author: {
      name: post.data.author || 'Martin Donadieu',
      url: post.data.authorUrl || 'https://github.com/riderx',
    },
    articleSection: 'Digital Nomad Lifestyle',
    keywords: post.data.keywords || 'digital nomad, remote work, travel, nomad lifestyle',
  }),
}
---

<Layout seo={seo}>
  <main>
    {
      post.data.heroImage ? (
        <section class="relative h-[560px]">
          <img src={post.data.heroImage} alt={post.data.heroImageAlt || post.data.title} class="absolute inset-0 h-full w-full object-cover" />
          <div class="absolute inset-0 bg-black/50" />
          <div class="relative mx-auto flex h-full max-w-4xl flex-col items-center justify-center px-8 text-center text-white">
            <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">{post.data.title}</h1>
            {post.data.pubDate && (
              <time datetime={post.data.pubDate.toISOString()} class="mt-4 text-lg">
                {post.data.pubDate.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })}
              </time>
            )}
          </div>
        </section>
      ) : (
        <div class="mx-auto max-w-2xl px-8 pt-16 text-center">
          <h1 class="text-4xl font-semibold tracking-tight text-white sm:text-5xl">{post.data.title}</h1>
        </div>
      )
    }

    <div class="relative px-4 py-16">
      <div class="mx-auto flex max-w-7xl gap-12">
        <aside class="hidden lg:block lg:w-48">
          <div class="sticky top-8 space-y-6 text-sm">
            <div>
              <div class="mb-2 text-xs font-bold uppercase tracking-wider text-gray-500">Content</div>
              <div class="space-y-1">
                <a href="/newsletter/" class="block rounded px-2 py-1.5 text-gray-600 transition-colors hover:bg-gray-100 hover:text-gray-900">Newsletter</a>
                <a href="/editions/" class="block rounded px-2 py-1.5 text-gray-600 transition-colors hover:bg-gray-100 hover:text-gray-900">Magazine Editions</a>
                <a href="/digital-nomad-wiki/" class="block rounded px-2 py-1.5 text-gray-600 transition-colors hover:bg-gray-100 hover:text-gray-900">Digital Nomad Wiki</a>
                <a href="/articles/" class="block rounded px-2 py-1.5 text-gray-600 transition-colors hover:bg-gray-100 hover:text-gray-900">Articles</a>
              </div>
            </div>

            <div>
              <div class="mb-2 text-xs font-bold uppercase tracking-wider text-gray-500">Partners</div>
              <div class="space-y-1">
                <a href="/brand-placement-next-edition-847291/" class="block rounded px-2 py-1.5 text-gray-600 transition-colors hover:bg-gray-100 hover:text-gray-900">Brand Placement</a>
                <a href="/nomad_directory/" class="block rounded px-2 py-1.5 text-gray-600 transition-colors hover:bg-gray-100 hover:text-gray-900">Nomad Directory</a>
                <a href="/writers/" class="block rounded px-2 py-1.5 text-gray-600 transition-colors hover:bg-gray-100 hover:text-gray-900">For Writers</a>
                <a href="/distribution-list/" class="block rounded px-2 py-1.5 text-gray-600 transition-colors hover:bg-gray-100 hover:text-gray-900">Distribution List</a>
              </div>
            </div>

            <div>
              <div class="mb-2 text-xs font-bold uppercase tracking-wider text-gray-500">Support</div>
              <div class="space-y-1">
                <a href="/our-story/" class="block rounded px-2 py-1.5 text-gray-600 transition-colors hover:bg-gray-100 hover:text-gray-900">Our Story</a>
                <a href="/support-the-magazine/" class="block rounded px-2 py-1.5 text-gray-600 transition-colors hover:bg-gray-100 hover:text-gray-900">Support Magazine</a>
                <a href="/add-testimonials/" class="block rounded px-2 py-1.5 text-gray-600 transition-colors hover:bg-gray-100 hover:text-gray-900">Submit Review</a>
              </div>
            </div>
          </div>
        </aside>

        <div class="mx-auto w-full max-w-3xl flex-1">
          <article class="prose prose-lg mx-auto max-w-none prose-headings:text-gray-900 prose-p:text-gray-900 prose-a:text-blue-600 prose-strong:text-gray-900 prose-li:text-gray-900 prose-em:text-gray-700">
            <Content />
          </article>

          {
            finalRelatedPosts.length > 0 && (
              <section class="mt-16 border-t border-gray-200 pt-12">
                <h2 class="text-2xl font-semibold text-gray-900">Related Articles</h2>
                <div class="mt-6 grid gap-6 sm:grid-cols-3">
                  {finalRelatedPosts.map((relatedPost: typeof post) => (
                    <a href={`/blog/${relatedPost.slug}/`} class="group block rounded-lg border border-gray-200 p-4 transition-all hover:border-gray-400 hover:bg-gray-50">
                      <h3 class="text-base font-semibold leading-tight text-gray-900 group-hover:text-yellow-600">
                        {relatedPost.data.title}
                      </h3>
                      {relatedPost.data.description && (
                        <p class="mt-2 line-clamp-2 text-sm text-gray-600">
                          {relatedPost.data.description}
                        </p>
                      )}
                    </a>
                  ))}
                </div>
              </section>
            )
          }

          <div class="mt-16 grid gap-6 border-t border-gray-200 pt-12 sm:grid-cols-2">
            <SidebarMagazineDirectory />
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>
