---
import type { DistributionPlace } from '~/utils/distributionPlaces'

interface Props {
  places: DistributionPlace[]
  countries: string[]
  instanceId?: string
}

const { places, countries, instanceId = 'distro' } = Astro.props

const listId = `${instanceId}-list`
const sortId = `${instanceId}-sort`
const loadMoreId = `${instanceId}-load-more`
const loadWrapId = `${instanceId}-load-wrap`
---

{places.length > 0 && (
  <section class="distro-section" id="find-a-copy-near-you">
    <div class="distro-header">
      <p class="distro-eyebrow">In the Wild</p>
      <h2 class="distro-heading">Find a Spot to Read a Copy Near You</h2>
      <p class="distro-subheading">These coworkings, colivings, and nomad hubs carry Nomad Magazine for their guests and members.</p>
    </div>

    <div class="distro-layout">
      <aside class="distro-sidebar" aria-label="Filter by country">
        <p class="distro-sidebar-label">Country</p>
        <ul class="distro-country-list">
          <li>
            <button class="distro-country-btn is-active" data-country="All" data-distro={instanceId}>All</button>
          </li>
          {countries.map((c) => (
            <li>
              <button class="distro-country-btn" data-country={c} data-distro={instanceId}>{c}</button>
            </li>
          ))}
        </ul>
      </aside>

      <div class="distro-main">
        <div class="distro-toolbar">
          <div class="distro-sort-wrap">
            <label for={sortId} class="distro-sort-label">Sort</label>
            <select id={sortId} class="distro-sort-select" aria-label="Sort locations" data-distro={instanceId}>
              <option value="default">Default</option>
              <option value="az">A → Z</option>
              <option value="za">Z → A</option>
            </select>
          </div>
        </div>

        <ul class="distro-list" id={listId} data-distro={instanceId}>
          {places.map((place) => (
            <li class="distro-item" data-country={place.country} data-name={place.name}>
              <div class="distro-info">
                <span class="distro-name">{place.name}</span>
                {place.location && <span class="distro-location">{place.location}</span>}
              </div>
              <div class="distro-links">
                {place.website && (
                  <a href={place.website} target="_blank" rel="noopener noreferrer" aria-label={`Visit ${place.name} website (opens in new tab)`} class="distro-link">Website ↗</a>
                )}
                {place.maps && (
                  <a href={place.maps} target="_blank" rel="noopener noreferrer" aria-label={`Open ${place.name} on Google Maps (opens in new tab)`} class="distro-link">Maps ↗</a>
                )}
              </div>
            </li>
          ))}
        </ul>

        <div class="distro-load-wrap" id={loadWrapId} data-distro={instanceId}>
          <button class="distro-load-more" id={loadMoreId} data-distro={instanceId}>Load more</button>
        </div>
      </div>
    </div>

    <p class="distro-more">
      <a href="/distribution-list/" class="distro-more-link">See full distribution list →</a>
    </p>
  </section>
)}

<style>
  .distro-section {
    max-width: 1000px;
    margin: 0 auto 5rem auto;
    padding: 0 2rem;
    scroll-margin-top: 5.5rem;
  }

  .distro-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .distro-eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #4ecdc4;
    margin: 0 0 0.5rem 0;
  }

  .distro-heading {
    font-size: clamp(1.8rem, 3vw, 2.5rem);
    font-weight: 900;
    color: #ffffff;
    letter-spacing: -0.02em;
    margin: 0 0 0.75rem 0;
  }

  .distro-subheading {
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.5);
    margin: 0;
    line-height: 1.5;
  }

  .distro-layout {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 2rem;
    align-items: start;
  }

  .distro-sidebar {
    position: sticky;
    top: 2rem;
  }

  .distro-sidebar-label {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.35);
    margin: 0 0 0.75rem 0;
  }

  .distro-country-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .distro-country-btn {
    width: 100%;
    text-align: left;
    background: none;
    border: none;
    padding: 0.45rem 0.75rem;
    border-radius: 6px;
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.5);
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
  }

  .distro-country-btn:hover {
    background: rgba(255, 255, 255, 0.05);
    color: #ffffff;
  }

  .distro-country-btn.is-active {
    background: rgba(78, 205, 196, 0.12);
    color: #4ecdc4;
    font-weight: 700;
  }

  .distro-main {
    min-width: 0;
  }

  .distro-toolbar {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    margin-bottom: 1rem;
  }

  .distro-sort-wrap {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .distro-sort-label {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.35);
  }

  .distro-sort-select {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 6px;
    color: #ffffff;
    font-size: 0.8rem;
    padding: 0.35rem 0.6rem;
    cursor: pointer;
    appearance: none;
  }

  .distro-sort-select option {
    background: #1a1a1a;
  }

  .distro-list {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem 0;
    display: flex;
    flex-direction: column;
    gap: 0;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    overflow: hidden;
  }

  .distro-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem 1.25rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    transition: background 0.15s ease;
  }

  .distro-item:last-child {
    border-bottom: none;
  }

  .distro-item:hover {
    background: rgba(255, 255, 255, 0.03);
  }

  .distro-item[hidden] {
    display: none;
  }

  .distro-info {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    flex: 1;
    min-width: 0;
    text-align: left;
  }

  .distro-name {
    font-size: 0.9rem;
    font-weight: 700;
    color: #ffffff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .distro-location {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.35);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .distro-links {
    display: flex;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  .distro-link {
    font-size: 0.78rem;
    font-weight: 600;
    color: #4ecdc4;
    text-decoration: none;
    transition: opacity 0.15s ease;
  }

  .distro-link:hover {
    opacity: 0.7;
  }

  .distro-load-wrap {
    text-align: center;
  }

  .distro-load-more {
    background: none;
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: rgba(255, 255, 255, 0.6);
    padding: 0.65rem 2rem;
    border-radius: 8px;
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
  }

  .distro-load-more:hover {
    border-color: rgba(255, 255, 255, 0.4);
    color: #ffffff;
  }

  .distro-load-wrap[hidden] {
    display: none;
  }

  .distro-more {
    margin: 2rem 0 0 0;
    font-size: 0.9rem;
    text-align: center;
  }

  .distro-more-link {
    color: rgba(255, 255, 255, 0.35);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .distro-more-link:hover {
    color: #ffffff;
  }

  @media (max-width: 768px) {
    .distro-section {
      padding: 0 1rem;
    }

    .distro-layout {
      grid-template-columns: 1fr;
    }

    .distro-sidebar {
      position: static;
      display: flex;
      gap: 0.5rem;
      flex-wrap: wrap;
      align-items: center;
    }

    .distro-sidebar-label {
      margin: 0;
    }

    .distro-country-list {
      flex-direction: row;
      flex-wrap: wrap;
    }

    .distro-country-btn {
      padding: 0.3rem 0.75rem;
      border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .distro-item {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.4rem;
    }
  }
</style>

<script is:inline define:vars={{ instanceId }}>
(function () {
  const PAGE_SIZE = 15;
  const list = document.getElementById(instanceId + '-list');
  if (!list) return;

  const allItems = Array.from(list.querySelectorAll('.distro-item'));
  const loadMoreBtn = document.getElementById(instanceId + '-load-more');
  const loadWrap = document.getElementById(instanceId + '-load-wrap');
  const sortSelect = document.getElementById(instanceId + '-sort');
  const countryBtns = document.querySelectorAll('.distro-country-btn[data-distro="' + instanceId + '"]');

  let activeCountry = 'All';
  let sortOrder = 'default';
  let shownCount = PAGE_SIZE;

  const originalOrder = allItems.map((el, i) => ({ el, i }));

  function getFiltered() {
    let items = originalOrder.slice();
    if (activeCountry !== 'All') {
      items = items.filter(({ el }) => el.dataset.country === activeCountry);
    }
    if (sortOrder === 'az') {
      items.sort((a, b) => a.el.dataset.name.localeCompare(b.el.dataset.name));
    } else if (sortOrder === 'za') {
      items.sort((a, b) => b.el.dataset.name.localeCompare(a.el.dataset.name));
    }
    return items;
  }

  function render() {
    const filtered = getFiltered();
    allItems.forEach(el => el.setAttribute('hidden', ''));
    filtered.slice(0, shownCount).forEach(({ el }) => el.removeAttribute('hidden'));
    if (loadMoreBtn && loadWrap) {
      if (shownCount >= filtered.length) {
        loadWrap.setAttribute('hidden', '');
      } else {
        loadWrap.removeAttribute('hidden');
      }
    }
  }

  render();

  countryBtns.forEach(btn => {
    btn.addEventListener('click', function () {
      activeCountry = this.dataset.country;
      shownCount = PAGE_SIZE;
      countryBtns.forEach(b => b.classList.remove('is-active'));
      this.classList.add('is-active');
      render();
    });
  });

  if (sortSelect) {
    sortSelect.addEventListener('change', function () {
      sortOrder = this.value;
      shownCount = PAGE_SIZE;
      render();
    });
  }

  if (loadMoreBtn) {
    loadMoreBtn.addEventListener('click', function () {
      shownCount += PAGE_SIZE;
      render();
    });
  }
})();
</script>
