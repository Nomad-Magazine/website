---
const footerSections = [
  {
    title: 'Magazine & Content',
    links: [
      { text: 'Latest Edition', url: '/editions/third-edition' },
      { text: 'All Editions', url: '/editions' },
      { text: 'Blog', url: '/blog' },
      { text: 'Free Articles', url: '/free-weekly-articles' },
    ]
  },
  {
    title: 'Community & Resources',
    links: [
      { text: 'Newsletter', url: '/newsletter' },
      { text: 'Newsletter Guidelines', url: '/newsletter-guidelines' },
      { text: 'Nomad Directory', url: '/nomad_directory' },
      { text: 'Coworking Contest', url: '/coworking-contest/' },
      { text: 'Testimonials', url: '/add-testimonials/' },
    ]
  },
  {
    title: 'Business & Partners',
    links: [
      { text: 'Distribution List', url: '/distribution-list' },
      { text: 'Support the Magazine', url: '/support-the-magazine' },
      { text: 'Partner with Us', url: '/partners' },
      { text: 'Writers Program', url: '/writers' },
      { text: 'Nomad Events', url: '/nomad-events' },
    ]
  },
  {
    title: 'About & Legal',
    links: [
      { text: 'About Us', url: '/our-story' },
      { text: 'Our Team', url: '/#team' },
      { text: 'Privacy Policy', url: '/privacy-policy' },
      { text: 'Terms & Conditions', url: '/terms-and-conditions' },
      { text: 'Contact', url: 'mailto:hey@nomadgossip.com' },
    ]
  }
]

// Keep the original links for backwards compatibility if needed
const originalLinks = [
  { text: 'Issues', url: '/editions/', imageUrl: '/underline.svg' },
  { text: 'Testimonials', url: '/add-testimonials/', imageUrl: '/images/link_hover.svg' },
  { text: 'About', url: '/our-story/', imageUrl: '/underline.svg' },
  { text: 'Nomad Directory', url: '/nomad_directory/', imageUrl: '/images/link_hover_long.svg' },
  { text: 'Coworking Contest', url: '/coworking-contest/', imageUrl: '/images/link_hover_long.svg' },
  { text: 'Newsletter', url: '/newsletter/', imageUrl: '/images/link_hover.svg' },
  { text: 'Distribution', url: '/distribution-list/', imageUrl: '/underline.svg' },
  { text: 'Support Us', url: '/support-the-magazine/', imageUrl: '/images/link_hover.svg' },
  { text: 'Blog', url: '/blog/', imageUrl: '/images/link_hover_tiny.svg' },
  { text: 'Free Articles', url: '/free-weekly-articles/', imageUrl: '/images/link_hover.svg' },
]
---

<div animate-fade-in-up class="mx-auto max-w-7xl px-4 py-16 opacity-0">
  <!-- Stripe-style Footer with Categories -->
  <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4">
    {footerSections.map((section) => (
      <div class="space-y-4">
        <h3 class="text-lg font-bold text-gray-900 font-inter">
          {section.title}
        </h3>
        <ul class="space-y-3">
          {section.links.map((link) => (
            <li>
              <a 
                href={link.url} 
                class="text-gray-600 hover:text-yellow-600 transition-colors duration-200 font-medium"
              >
                {link.text}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
  
  <!-- Newsletter Signup Section -->
  <div class="mt-12 pt-8 border-t border-gray-200">
    <div class="text-center max-w-2xl mx-auto">
      <h3 class="text-2xl font-bold text-gray-900 mb-4">
        Join Our Global Nomad Community
      </h3>
      <p class="text-gray-600 mb-6">
        Get exclusive insights, destination guides, and nomad stories delivered to your inbox weekly.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
        <a 
          href="/newsletter/" 
          class="inline-flex items-center px-6 py-3 bg-yellow-400 text-black font-bold rounded-lg hover:bg-yellow-300 transition-colors duration-200"
        >
          Subscribe to Newsletter
          <svg class="ml-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
        <a 
          href="/newsletter-guidelines/" 
          class="text-sm text-gray-600 hover:text-yellow-600 underline"
        >
          Partner Guidelines →
        </a>
      </div>
    </div>
  </div>
  
  <!-- Original Links Section (kept for visual appeal) -->
  <div class="mt-16 pt-8 border-t border-gray-200">
    <div class="flex flex-wrap justify-center gap-x-8 gap-y-4">
      {
        originalLinks.slice(0, 6).map((link) => (
          <a href={link.url} class="group relative inline-block">
            <span class="font-justme text-3xl text-gray-700 hover:text-yellow-600 transition-colors duration-200">{link.text}</span>
            <img src={link.imageUrl} alt="" aria-hidden="true" class="absolute bottom-[-15px] left-0 hidden w-full group-hover:block" loading="lazy" />
          </a>
        ))
      }
    </div>
  </div>
</div>
