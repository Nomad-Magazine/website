---
const editions = [
  {
    num: 1,
    href: '/first-edition-giveaway/',
    img: '/images/first-edition-cover-hd.webp',
    alt: 'Nomad Magazine Edition One cover',
    label: 'Edition 001',
  },
  {
    num: 2,
    href: '/second-edition-giveaway/',
    img: '/images/edition-002-cover.webp',
    alt: 'Nomad Magazine Edition Two cover',
    label: 'Edition 002',
  },
  {
    num: 3,
    href: '/third-edition-giveaway/',
    img: '/images/third-edition-cover-hd.webp',
    alt: 'Nomad Magazine Edition Three cover',
    label: 'Edition 003',
  },
  {
    num: 4,
    href: '/fourth-edition-giveaway/',
    img: '/images/edition-004-cover.webp',
    alt: 'Nomad Magazine Edition Four cover',
    label: 'Edition 004',
  },
]
---

<section
  class="relative overflow-hidden border-y-4 border-yellow-400 bg-linear-to-br from-yellow-400 via-amber-300 to-orange-400 px-4 py-12 sm:px-6 sm:py-16 lg:px-8"
  aria-label="All Nomad Magazine editions free as PDF"
>
  <div class="pointer-events-none absolute -top-16 -right-16 h-64 w-64 rounded-full bg-white/20 blur-3xl" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -bottom-20 -left-20 h-72 w-72 rounded-full bg-orange-500/20 blur-3xl" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-7xl">
    <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-2 lg:gap-16">
      <div class="text-center lg:text-left">
        <span class="mb-4 inline-block rounded-full bg-black px-4 py-1.5 text-xs font-extrabold tracking-[0.2em] text-yellow-400 uppercase shadow-lg">
          Our gift to the nomad community
        </span>
        <h2 class="text-4xl font-extrabold tracking-tight text-black sm:text-5xl lg:text-6xl">
          All 4 Editions.<br />
          <span class="underline decoration-black/30 decoration-4 underline-offset-4">100% Free PDF.</span>
        </h2>
        <p class="mt-5 max-w-xl text-lg font-medium text-black/80 lg:mx-0 mx-auto">
          Every issue we've published — over 400 pages of nomad stories, guides, and community wisdom — yours to download. One email unlocks each edition. No paywall. No catch.
        </p>
        <div class="mt-6 space-y-2 text-sm font-semibold text-black/70 lg:text-left text-center">
          <p>
            Prefer print? Edition Four from
            <a href="https://magculture.com/products/nomad-magazine-4" target="_blank" rel="noopener noreferrer" class="underline hover:text-black" aria-label="Buy Nomad Magazine Edition 4 from MagCulture UK (opens in new tab)">MagCulture</a> (UK),
            <a href="https://brot.sk/products/nomad-magazine-4" target="_blank" rel="noopener noreferrer" class="underline hover:text-black" aria-label="Buy Nomad Magazine Edition 4 from Brot Slovakia (opens in new tab)">Brot</a> (Slovakia) &
            <a href="https://www.op34.studio/products/nomad-magazine-issue-4" target="_blank" rel="noopener noreferrer" class="underline hover:text-black" aria-label="Buy Nomad Magazine Edition 4 from OP34 Studio Bulgaria (opens in new tab)">OP34 Studio</a> (Bulgaria).
          </p>
          <p>
            Or find a copy at coworkings and colivings in our
            <a href="/distribution-list/" class="underline hover:text-black" aria-label="Find Nomad Magazine at partner coworkings and colivings">partner network</a>.
          </p>
        </div>
      </div>

      <div class="flex flex-col items-center">
        <div class="flex items-end justify-center gap-2 sm:gap-3">
          {
            editions.map((edition, i) => (
              <a
                href={edition.href}
                class="group relative transition-transform hover:-translate-y-2 focus-visible:ring-2 focus-visible:ring-black focus-visible:outline-none"
                aria-label={`Download free PDF for ${edition.label}`}
                style={`z-index: ${editions.length - i}`}
              >
                <img
                  src={edition.img}
                  alt={edition.alt}
                  width="120"
                  height="160"
                  class={`rounded-lg border-2 border-black/10 object-cover shadow-2xl transition-shadow group-hover:shadow-black/30 ${
                    i === 3 ? 'w-24 sm:w-28' : i === 2 ? 'w-20 sm:w-24' : 'w-16 sm:w-20'
                  }`}
                  loading="lazy"
                />
                <span class="absolute -bottom-2 left-1/2 -translate-x-1/2 whitespace-nowrap rounded-full bg-black px-2 py-0.5 text-[10px] font-bold text-yellow-400 opacity-0 transition-opacity group-hover:opacity-100 sm:text-xs">
                  Free PDF
                </span>
              </a>
            ))
          }
        </div>
        <div class="mt-8 grid w-full max-w-md grid-cols-2 gap-2 sm:grid-cols-4">
          {
            editions.map((edition) => (
              <a
                href={edition.href}
                class="rounded-lg bg-black px-2 py-2.5 text-center text-xs font-bold text-yellow-400 transition-colors hover:bg-black/80 sm:text-sm"
              >
                {edition.label}
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
