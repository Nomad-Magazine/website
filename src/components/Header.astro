---
const links = [
  { text: 'Directory', url: '/nomad_directory/' },
  { text: 'Articles', url: '/articles/' },
  { text: 'Newsletter', url: '/newsletter/' },
  { text: 'Magazine archive', url: '/editions/' },
]
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" aria-label="Nomad Magazine home" class="brand"><img src="/logo.svg" alt="Nomad Magazine" width="190" height="30" /></a>
    <nav class="desktop-nav" aria-label="Main navigation">
      {
        links.map((link) => (
          <a href={link.url} aria-current={Astro.url.pathname === link.url ? 'page' : undefined}>
            {link.text}
          </a>
        ))
      }
    </nav>
    <div class="header-actions">
      <a href="/nomad-directory-edit/" class="account-link">Sign in</a><a href="/nomad-directory-submit/" class="submit-link">Add a listing <span aria-hidden="true">↗</span></a>
    </div>
    <details class="mobile-nav">
      <summary aria-label="Open navigation menu">Menu <span aria-hidden="true">☰</span></summary><nav aria-label="Mobile navigation">
        {
          links.map((link) => (
            <a href={link.url} aria-current={Astro.url.pathname === link.url ? 'page' : undefined}>
              {link.text}
            </a>
          ))
        }<a href="/nomad-directory-edit/">Sign in / create account</a><a href="/nomad-directory-submit/">Add your listing</a><a href="/search/">Search the website</a>
      </nav>
    </details>
  </div>
</header>
<style>
  .site-header {
    background: #fff;
    color: #171817;
    position: relative;
    z-index: 120;
    border-bottom: 1px solid #e5e7df;
  }
  .header-inner {
    max-width: 1248px;
    margin: auto;
    padding: 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
  }
  .brand {
    flex-shrink: 0;
  }
  .brand img {
    width: 190px;
    height: 30px;
  }
  .desktop-nav,
  .header-actions {
    display: flex;
    align-items: center;
    gap: 28px;
    font-size: 14px;
    font-weight: 600;
  }
  .desktop-nav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: #b68c00;
    text-decoration-thickness: 3px;
    text-underline-offset: 8px;
  }
  a:hover {
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .submit-link {
    border-radius: 7px;
    background: #facc15;
    padding: 12px 16px;
  }
  .mobile-nav {
    display: none;
  }
  :is(a, summary):focus-visible {
    outline: 3px solid #876500;
    outline-offset: 5px;
  }
  @media (max-width: 1050px) {
    .desktop-nav {
      gap: 16px;
    }
    .header-inner {
      gap: 20px;
    }
    .header-actions {
      gap: 16px;
    }
  }
  @media (max-width: 900px) {
    .desktop-nav,
    .header-actions {
      display: none;
    }
    .header-inner {
      padding: 20px;
    }
    .brand img {
      width: 168px;
      height: 27px;
    }
    .mobile-nav {
      display: block;
    }
    summary {
      cursor: pointer;
      padding: 8px 0 8px 12px;
      font-size: 14px;
      font-weight: 600;
    }
    summary span {
      margin-left: 8px;
    }
    .mobile-nav nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      display: grid;
      background: white;
      padding: 12px 20px 24px;
      border-bottom: 1px solid #cdd2c6;
      box-shadow: 0 16px 25px #0002;
    }
    .mobile-nav nav a {
      padding: 12px 0;
    }
  }
</style>
<script>
  const menu = document.querySelector<HTMLDetailsElement>('.mobile-nav')
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menu?.open) {
      menu.open = false
      menu.querySelector('summary')?.focus()
    }
  })
  document.addEventListener('click', (event) => {
    if (menu?.open && !menu.contains(event.target as Node)) menu.open = false
  })
</script>
