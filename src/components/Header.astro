---
import IsIconDownOutline from '~icons/lsicon/down-outline'
import CloseIcon from '~icons/material-symbols-light/close'
import MenuIcon from '~icons/material-symbols-light/menu-rounded'
import SearchIcon from '~icons/material-symbols-light/search'

const navLinks = [
  {
    text: 'Newsletter',
    url: '/newsletter/',
    imageUrl: '/images/link_hover.svg',
  },
  {
    text: 'Articles',
    url: '/articles/',
    imageUrl: '/underline.svg',
  },
]
---

<header class="relative z-120 bg-white">
  <div class="mx-auto max-w-7xl px-4">
    <div class="flex items-center justify-between py-8">
      <!-- Logo and Navigation -->
      <div class="flex items-center space-x-10">
        <a href="/" aria-label="Nomad Magazine Home" class="text-4xl font-black tracking-tighter text-gray-900">
          <img decoding="async" loading="lazy" src="/logo.svg" alt="Nomad Magazine" class="h-6" />
        </a>
        <nav class="hidden space-x-10 lg:flex">
          <div class="relative">
            <button aria-controls="magazine-dropdown" id="magazine-button" class="group flex cursor-pointer items-center text-lg font-bold text-gray-900 transition-colors hover:text-yellow-600" aria-label="Magazine menu" aria-haspopup="true" aria-expanded="false">
              <span>Magazine</span>
              <IsIconDownOutline class="ml-1 h-5 w-5 font-bold" aria-hidden="true" />
            </button>
            <div id="magazine-dropdown" class="absolute z-10 mt-2 hidden w-64 rounded-md border border-gray-200 bg-white py-1 shadow-xl">
              <a href="/5th-edition-waitlist/" class="flex items-center px-4 py-3 text-sm font-semibold text-gray-700 hover:bg-yellow-50 hover:text-yellow-600">
                <span class="mr-3 inline-flex items-center rounded-full bg-black px-2.5 py-1 text-xs font-bold text-yellow-400 shadow-sm">2027</span>
                Edition #5 Waitlist
              </a>
              <a href="/editions/fourth-edition/" class="block px-4 py-3 text-sm font-semibold text-gray-700 hover:bg-yellow-50 hover:text-yellow-600">Edition #4 - Palermo, Fukuoka, Bansko, Madeira</a>
              <a href="/editions/third-edition/" class="block px-4 py-3 text-sm font-semibold text-gray-700 hover:bg-yellow-50 hover:text-yellow-600">Edition #3 - Mind. Body. Tech.</a>
          <a href="/editions/second-edition/" class="block px-4 py-3 text-sm font-semibold text-gray-700 hover:bg-yellow-50 hover:text-yellow-600">Edition #2 - Digital Nomad Communities</a>
          <a href="/editions/first-edition/" class="block px-4 py-3 text-sm font-semibold text-gray-700 hover:bg-yellow-50 hover:text-yellow-600">Edition #1 - Digital Nomadism</a>
              <div class="border-t border-gray-200 my-1"></div>
              <a href="/editions/" class="block px-4 py-3 text-sm font-semibold text-gray-700 hover:bg-yellow-50 hover:text-yellow-600">View All Editions</a>
            </div>
          </div>
          {
            navLinks.map((link) => (
              <a href={link.url} class="group relative inline-block text-lg font-bold text-gray-900 transition-colors hover:text-yellow-600">
                <span>{link.text}</span>
                <img src={link.imageUrl} alt="" aria-hidden="true" class="absolute left-0 hidden w-full group-hover:block" loading="lazy" />
              </a>
            ))
          }
          <div class="relative">
            <button aria-controls="more-dropdown" id="more-button" class="flex cursor-pointer items-center text-lg font-bold text-gray-900 transition-colors hover:text-yellow-600" aria-label="More menu" aria-haspopup="true" aria-expanded="false">
              More
              <IsIconDownOutline class="ml-1 h-5 w-5 font-bold" aria-hidden="true" />
            </button>
            <div id="more-dropdown" class="absolute z-10 mt-2 hidden w-56 rounded-md border border-gray-200 bg-white py-2 shadow-xl">
              <!-- Content & Community -->
              <div class="px-3 py-1">
                <div class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-2">Content</div>
                <a href="/editions/" class="block px-3 py-2 text-sm font-medium text-gray-700 hover:bg-yellow-50 hover:text-yellow-600 rounded-md">Magazine Editions</a>
                <a href="/digital-nomad-wiki/" class="block px-3 py-2 text-sm font-medium text-gray-700 hover:bg-yellow-50 hover:text-yellow-600 rounded-md">Digital Nomad Wiki</a>
                <a href="/articles/" class="block px-3 py-2 text-sm font-medium text-gray-700 hover:bg-yellow-50 hover:text-yellow-600 rounded-md">Articles</a>
              </div>

              <div class="border-t border-gray-100 my-1"></div>

              <!-- Partners & Opportunities -->
              <div class="px-3 py-1">
                <div class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-2">Partners</div>
                <a href="/partners/" class="block px-3 py-2 text-sm font-medium text-gray-700 hover:bg-yellow-50 hover:text-yellow-600 rounded-md">For Partners</a>
                <a href="/writers/" class="block px-3 py-2 text-sm font-medium text-gray-700 hover:bg-yellow-50 hover:text-yellow-600 rounded-md">For Writers</a>
                <a href="/nomad_directory/" class="block px-3 py-2 text-sm font-medium text-gray-700 hover:bg-yellow-50 hover:text-yellow-600 rounded-md">Nomad Directory</a>
                <a href="/distribution-list/" class="block px-3 py-2 text-sm font-medium text-gray-700 hover:bg-yellow-50 hover:text-yellow-600 rounded-md">Distribution List</a>
              </div>

              <div class="border-t border-gray-100 my-1"></div>

              <!-- Support -->
              <div class="px-3 py-1">
                <div class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-2">Support</div>
                <a href="/our-story/" class="block px-3 py-2 text-sm font-medium text-gray-700 hover:bg-yellow-50 hover:text-yellow-600 rounded-md">Our Story</a>
                <a href="/support-the-magazine/" class="block px-3 py-2 text-sm font-medium text-gray-700 hover:bg-yellow-50 hover:text-yellow-600 rounded-md">Support Magazine</a>
                <a href="/add-testimonials/" class="block px-3 py-2 text-sm font-medium text-gray-700 hover:bg-yellow-50 hover:text-yellow-600 rounded-md">Submit Review</a>
              </div>
            </div>
          </div>
        </nav>
        <a
          href="/search/"
          class="hidden text-gray-900 transition-colors hover:text-yellow-600 lg:inline-flex lg:items-center"
          aria-label="Search Nomad Magazine"
        >
          <SearchIcon class="h-7 w-7" aria-hidden="true" />
        </a>
      </div>
      <!-- Buttons -->
      <div class="hidden items-center space-x-4 lg:flex">
        <a
          target="_self"
          href="/nomad_directory/"
          class="rounded-lg border-2 border-yellow-400 bg-yellow-400 px-6 py-3 font-black text-black shadow-lg transition-colors hover:border-yellow-500 hover:bg-yellow-500"
        >
          Nomad Directory 👋
        </a>
      </div>
      <!-- Mobile menu button -->
      <div class="lg:hidden">
        <button id="mobile-menu-button" type="button" class="text-gray-900 hover:text-yellow-600" aria-label="Open mobile menu" aria-haspopup="dialog" aria-expanded="false" aria-controls="mobile-menu-overlay">
          <MenuIcon class="h-8 w-8" aria-hidden="true" />
        </button>
      </div>
    </div>
  </div>
  <!-- Mobile Menu Overlay -->
  <div role="dialog" aria-modal="true" aria-label="Navigation menu" id="mobile-menu-overlay" class="fixed inset-0 z-50 hidden bg-black text-white overflow-y-auto">
    <div class="flex items-center justify-between p-6 border-b border-gray-800">
      <a href="/" aria-label="Nomad Magazine Home" class="text-4xl font-black tracking-tighter">
        <img decoding="async" loading="lazy" src="/images/nomad-magazine-white-logo.webp" alt="Nomad Magazine" class="h-8" width="430" height="110" />
      </a>
      <button id="close-menu-button" class="hover:text-yellow-400 transition-colors" aria-label="Close mobile menu">
        <CloseIcon class="h-8 w-8" aria-hidden="true" />
      </button>
    </div>
    <nav class="flex flex-col space-y-6 p-6 text-lg font-semibold min-h-0">
      <div class="space-y-3">
        <div class="text-yellow-400 text-xl font-bold">Magazine</div>
        <div class="ml-4 space-y-3 text-base">
          <a href="/5th-edition-waitlist/" class="flex items-center transition-colors hover:text-yellow-400">
            <span class="mr-3 inline-flex items-center rounded-full bg-yellow-400 px-2 py-0.5 text-xs font-bold text-black shadow-sm">2027</span>
            Edition #5 Waitlist
          </a>
          <a href="/editions/fourth-edition/" class="block transition-colors hover:text-yellow-400">Edition #4 - Palermo, Fukuoka, Bansko, Madeira</a>
          <a href="/editions/third-edition/" class="block transition-colors hover:text-yellow-400">Edition #3 - Mind. Body. Tech.</a>
          <a href="/editions/second-edition/" class="block transition-colors hover:text-yellow-400">Edition #2 - Digital Nomad Communities</a>
          <a href="/editions/first-edition/" class="block transition-colors hover:text-yellow-400">Edition #1 - Digital Nomadism</a>
          <div class="border-t border-gray-700 my-2 pt-2">
            <a href="/editions/" class="block transition-colors hover:text-yellow-400">View All Editions</a>
          </div>
        </div>
      </div>
      <a href="/search/" class="flex items-center gap-2 transition-colors hover:text-yellow-400">
        <SearchIcon class="h-6 w-6 shrink-0" aria-hidden="true" />
        Search
      </a>
      <a href="/newsletter/" class="transition-colors hover:text-yellow-400">Newsletter</a>
      <a href="/articles/" class="transition-colors hover:text-yellow-400">Articles</a>
              <div class="space-y-4">
        <div class="text-yellow-400 text-xl font-bold">More</div>

        <!-- Content Section -->
        <div>
          <div class="text-gray-400 text-sm font-bold uppercase tracking-wider mb-2">Content</div>
          <div class="ml-3 space-y-2 text-base">
            <a href="/editions/" class="block transition-colors hover:text-yellow-400">Magazine Editions</a>
            <a href="/digital-nomad-wiki/" class="block transition-colors hover:text-yellow-400">Digital Nomad Wiki</a>
            <a href="/articles/" class="block transition-colors hover:text-yellow-400">Articles</a>
          </div>
        </div>

        <!-- Partners Section -->
        <div>
          <div class="text-gray-400 text-sm font-bold uppercase tracking-wider mb-2">Partners</div>
          <div class="ml-3 space-y-2 text-base">
            <a href="/partners/" class="block transition-colors hover:text-yellow-400">For Partners</a>
            <a href="/writers/" class="block transition-colors hover:text-yellow-400">For Writers</a>
            <a href="/nomad_directory/" class="block transition-colors hover:text-yellow-400">Nomad Directory</a>
            <a href="/distribution-list/" class="block transition-colors hover:text-yellow-400">Distribution List</a>
          </div>
        </div>

        <!-- Support Section -->
        <div>
          <div class="text-gray-400 text-sm font-bold uppercase tracking-wider mb-2">Support</div>
          <div class="ml-3 space-y-2 text-base">
            <a href="/our-story/" class="block transition-colors hover:text-yellow-400">Our Story</a>
            <a href="/support-the-magazine/" class="block transition-colors hover:text-yellow-400">Support Magazine</a>
            <a href="/add-testimonials/" class="block transition-colors hover:text-yellow-400">Submit Review</a>
          </div>
        </div>
      </div>
    </nav>
    <div class="p-6 mt-auto border-t border-gray-800">
      <a href="/editions/second-edition/" class="block w-full rounded-lg bg-yellow-400 py-4 text-center font-black text-black shadow-lg transition-colors hover:bg-yellow-500"
        >Order Now</a
      >
    </div>
  </div>
</header>

<script>
  for (const name of ['magazine', 'more']) {
    const button = document.getElementById(`${name}-button`)
    const dropdown = document.getElementById(`${name}-dropdown`)
    if (!button || !dropdown) continue
    const group = button.parentElement!
    let closeTimer: ReturnType<typeof setTimeout> | undefined
    const setOpen = (open: boolean) => {
      clearTimeout(closeTimer)
      dropdown.classList.toggle('hidden', !open)
      button.setAttribute('aria-expanded', String(open))
    }
    button.addEventListener('click', () => setOpen(button.getAttribute('aria-expanded') !== 'true'))
    if (name === 'magazine') {
      group.addEventListener('mouseenter', () => setOpen(true))
      group.addEventListener('mouseleave', () => {
        if (!group.contains(document.activeElement)) closeTimer = setTimeout(() => setOpen(false), 150)
      })
    }
    group.addEventListener('focusout', event => {
      if (!group.contains(event.relatedTarget as Node)) setOpen(false)
    })
    group.addEventListener('keydown', event => {
      if (event.key === 'Escape') { setOpen(false); button.focus() }
    })
    document.addEventListener('click', event => {
      if (!group.contains(event.target as Node)) setOpen(false)
    })
  }

  const mobileButton = document.getElementById('mobile-menu-button')!
  const overlay = document.getElementById('mobile-menu-overlay')!
  const closeButton = document.getElementById('close-menu-button')!
  let previousOverflow = ''
  function closeMenu() {
    overlay.classList.add('hidden')
    mobileButton.setAttribute('aria-expanded', 'false')
    document.body.style.overflow = previousOverflow
    mobileButton.focus()
  }
  mobileButton.addEventListener('click', () => {
    previousOverflow = document.body.style.overflow
    overlay.classList.remove('hidden')
    mobileButton.setAttribute('aria-expanded', 'true')
    document.body.style.overflow = 'hidden'
    closeButton.focus()
  })
  closeButton.addEventListener('click', closeMenu)
  overlay.addEventListener('keydown', event => {
    if (event.key === 'Escape') { event.preventDefault(); closeMenu() }
    if (event.key !== 'Tab') return
    const controls = Array.from(overlay.querySelectorAll<HTMLElement>('a[href], button'))
    const first = controls[0]
    const last = controls[controls.length - 1]
    if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus() }
    else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus() }
  })
</script>
