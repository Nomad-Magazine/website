---
import { directoryLogoBoxClass, directoryLogoImageClassFor, directoryLogoInitialClass, directoryLogoUrlFor } from '~/const/nomadDirectoryWhiteLogos'

interface Props {
  title: string
  description?: string
  category?: string
  location?: string
  website?: string
  specialOffer?: string
  image?: string
}

const {
  title = '',
  description = '',
  category = '',
  location = '',
  website = '',
  specialOffer = '',
  image = '',
} = Astro.props

const locText = (() => {
  const loc = location || ''
  const parts = loc.split(',')
  return parts.length >= 2 ? loc : loc
})()
---

<div class="bg-white/5 border border-white/10 rounded-2xl p-5">
  <div class="flex items-start gap-4">
    <div class="shrink-0">
      <div class={directoryLogoBoxClass}>
        {image ? (
          <img src={directoryLogoUrlFor(title, image)} alt={title} class={directoryLogoImageClassFor(title)} loading="lazy" />
        ) : (
          <span class={directoryLogoInitialClass}>{(title || 'C').charAt(0).toUpperCase()}</span>
        )}
      </div>
    </div>
    <div class="flex-1 min-w-0">
      <div class="flex flex-wrap items-start justify-between gap-2 mb-1.5">
        <h3 class="text-base font-bold text-white leading-tight">{title || 'Your company'}</h3>
        <div class="flex items-center gap-1.5 shrink-0">
          {category && (
            <span class="bg-yellow-400/20 text-yellow-400 px-2.5 py-0.5 rounded-full text-xs font-medium border border-yellow-400/30">{category}</span>
          )}
          {locText && (
            <span class="bg-blue-600/20 text-blue-400 px-2.5 py-0.5 rounded-full text-xs font-medium border border-blue-600/30">{locText.split(',').slice(-1)[0].trim()}</span>
          )}
        </div>
      </div>
      <p class="text-gray-300 text-sm leading-relaxed line-clamp-2">{description || 'Description not available'}</p>
      {specialOffer && (
        <div class="mt-3 p-3 bg-yellow-400/10 border-l-4 border-yellow-400 rounded-r-lg">
          <p class="text-yellow-400 font-bold text-xs uppercase mb-1">Special Offer:</p>
          <p class="text-gray-200 text-sm whitespace-pre-line">{specialOffer}</p>
        </div>
      )}
      {website && (
        <div class="mt-3">
          <span class="text-blue-300 underline text-sm">{website.replace(/^https?:\/\//, '')}</span>
        </div>
      )}
    </div>
  </div>
</div>
