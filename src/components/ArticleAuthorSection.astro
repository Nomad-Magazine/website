---
interface Props {
  authorName?: string
  authorBio?: string
  authorImageUrl?: string
}

const { authorName, authorBio, authorImageUrl } = Astro.props

if (!authorBio) return null
---

<section class="not-prose mt-12 border-t border-gray-200 pt-10" aria-labelledby="about-author-heading">
  <h2 id="about-author-heading" class="mb-5 text-2xl font-semibold text-gray-900">About the author</h2>
  <div class="flex flex-wrap items-start gap-5">
    {
      authorImageUrl && (
        <img
          src={authorImageUrl}
          alt={authorName ? `Portrait of ${authorName}` : 'Author portrait'}
          width="128"
          height="128"
          loading="lazy"
          decoding="async"
          class="h-32 w-32 shrink-0 rounded-full border border-gray-200 object-cover"
        />
      )
    }
    <div
      class="min-w-0 flex-1 text-lg leading-relaxed text-gray-900 [&_a]:text-blue-600 [&_a]:underline"
      set:html={authorBio}
    />
  </div>
</section>
