---
export const prerender = true;

import { fetchReportRecords } from '~/utils/smartsuite'
import Layout, { type SEOProps } from '~/layouts/Layout.astro'
import ListYourProjectFooter from '~/components/ListYourProjectFooter.astro'
import ImageModal from '~/components/ImageModal.astro'
import MaterialSymbolsElectricBolt from '~icons/material-symbols/electric-bolt'

const { records = [] } = await fetchReportRecords('68614a111208586bd05d3c3a')

// Filter and transform all distribution locations (including coming soon)
const distributionLocations = records
  .filter((record: any) => 
    record.s43a4b2808 && 
    record.title
  )
  .map((record: any) => ({
    id: record.s9744d6c51 ? `coming_${record.id}` : `dist_${record.id}`,
    name: record.title,
    description: record.scea90e502 || (record.s9744d6c51 ? 'Coming soon to this location.' : 'A great location for digital nomads.'),
    location: record.sed1a49986 || 'Location not specified',
    city: record.sed1a49986?.split(',')[0]?.trim() || 'Unknown',
    country: record.sed1a49986?.split(',').slice(-1)[0]?.trim() || 'Unknown',
    website_url: record.sb788c266b?.[0] || null,
    images: record.image ? [record.image] : [],
    category: record.sb685ab800?.label || 'Other',
    discount_code: record.s9c0ff01ed || null,
    created_at: record.first_created?.on || new Date().toISOString(),
    isComingSoon: !!record.s9744d6c51
  }))

// Extract unique categories for filtering
const categories = [...new Set(distributionLocations.map((location: any) => location.category))].sort()

const seo: SEOProps = {
  title: 'Where to Find Nomad Magazine - Global Distribution Locations',
  description:
    'Find Nomad Magazine at coworking spaces and nomad hubs worldwide. Discover where to pick up your copy of the digital nomad magazine for inspiration and insights.',
  image: `${Astro.site}images/edition-003-cover_holded_front_face.webp`,
  keywords: 'nomad magazine, magazine distribution, coworking spaces, nomad hubs, digital nomad magazine, magazine locations',
  ogType: 'website',
  ldJSON: {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Nomad Magazine Distribution',
    description: 'Global distribution locations for Nomad Magazine',
    url: `${Astro.site}distribution-list`,
    publisher: {
      '@type': 'Organization',
      name: 'Nomad Magazine',
      logo: {
        '@type': 'ImageObject',
        url: `${Astro.site}logo.svg`,
      },
    },
  },
}
---

<Layout seo={seo}>
  <div class="bg-hoverw text-white min-h-screen">
    <!-- Hero Section -->
    <section class="px-4 py-16 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="text-center">
          <h1 class="text-4xl font-bold sm:text-6xl lg:text-7xl mb-6">
            Where To Find <span class="text-yellow-400">Nomad Magazine</span>
      </h1>
          <p class="text-xl text-neutral-300 mb-8 max-w-3xl mx-auto">
            Nomad Magazine is circulating globally! Find a copy at coworking spaces and nomad hubs for inspiration and insights into remote work. Our trusted distribution partners are located in key nomad destinations.
          </p>
          <div class="flex justify-center gap-4">
            <button 
              id="filter-btn"
              class="inline-flex items-center gap-2 rounded-lg border-2 border-yellow-400 px-6 py-3 text-lg font-bold text-yellow-400 transition-all hover:bg-yellow-400 hover:text-black"
            >
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"/>
              </svg>
              Filter Locations
            </button>
      <a
        target="_blank"
        href="https://form.smartsuite.com/s4tmc086/0nmLI1htHD"
              class="inline-flex items-center gap-2 rounded-lg bg-yellow-400 px-6 py-3 text-lg font-bold text-black transition-all hover:bg-yellow-300"
      >
        <MaterialSymbolsElectricBolt width="20" height="20" />
              List a Location
      </a>
    </div>
        </div>
      </div>
    </section>

    <!-- Filters Section (Initially Hidden) -->
    <section id="filters-section" class="px-4 py-8 sm:px-6 lg:px-8 border-b border-neutral-800 hidden">
      <div class="mx-auto max-w-7xl">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
          <select id="category-filter" class="rounded-lg bg-neutral-800 border border-neutral-700 text-white px-4 py-2">
            <option value="">All Categories</option>
            {categories.map((category) => (
              <option value={String(category)}>{category}</option>
            ))}
          </select>
          <select id="country-filter" class="rounded-lg bg-neutral-800 border border-neutral-700 text-white px-4 py-2">
            <option value="">All Countries</option>
          </select>
          <select id="city-filter" class="rounded-lg bg-neutral-800 border border-neutral-700 text-white px-4 py-2">
            <option value="">All Cities</option>
          </select>
          <select id="sort-filter" class="rounded-lg bg-neutral-800 border border-neutral-700 text-white px-4 py-2">
            <option value="newest">Newest</option>
            <option value="name">Alphabetical</option>
          </select>
        </div>
      </div>
    </section>

    <!-- Stats Section -->
    <section class="px-4 py-8 sm:px-6 lg:px-8 border-b border-neutral-800">
      <div class="mx-auto max-w-7xl">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
          <div>
            <div class="text-3xl font-bold text-yellow-400" id="total-locations">0</div>
            <div class="text-sm text-neutral-400">Distribution Locations</div>
          </div>
          <div>
            <div class="text-3xl font-bold text-yellow-400" id="total-countries">0</div>
            <div class="text-sm text-neutral-400">Countries</div>
          </div>
          <div>
            <div class="text-3xl font-bold text-yellow-400" id="total-cities">0</div>
            <div class="text-sm text-neutral-400">Cities</div>
          </div>
          <div>
            <div class="text-3xl font-bold text-yellow-400" id="total-categories">0</div>
            <div class="text-sm text-neutral-400">Categories</div>
          </div>
        </div>
      </div>
    </section>

    <!-- Distribution Locations Grid -->
    <section class="px-4 py-16 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <div id="loading-spinner" class="text-center py-12">
          <div class="inline-block animate-spin rounded-full h-8 w-8 border-b-2 border-yellow-400"></div>
          <p class="mt-2 text-neutral-400">Loading distribution locations...</p>
    </div>

        <div id="locations-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 hidden">
          <!-- Locations will be dynamically inserted here -->
    </div>

        <div id="no-locations" class="text-center py-12 hidden">
          <p class="text-xl text-neutral-400">No distribution locations found matching your criteria.</p>
            </div>
    </div>
    </section>



    <!-- Footer Section -->
    <section class="px-4 py-16 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
    <ListYourProjectFooter
      buttonText="Get in touch"
      href="https://form.smartsuite.com/s4tmc086/0nmLI1htHD"
             title="Host <span class='text-yellow-400'>Nomad Magazine</span> <br />at Your Space – For Free!"
      description={'Give your community a fresh dose of nomad insights! Offer your guests inspiring stories, industry trends, and valuable resources—all at no cost to you.<br /><br />Perfect for: Stores, Coworking Spaces, Cafes, Colivings, Hostels etc.'}
    />
      </div>
  </section>

  <!-- Image Modal Component -->
  <ImageModal />
  </div>
</Layout>

<script is:inline define:vars={{ distributionLocations }}>
  let allLocations = [];

  // Initialize data from server
  allLocations = distributionLocations;

  function updateStats() {
    const totalLocations = allLocations.length;
    const countries = new Set(allLocations.map(location => location.country)).size;
    const cities = new Set(allLocations.map(location => location.city)).size;
    const categories = new Set(allLocations.map(location => location.category)).size;

    document.getElementById('total-locations').textContent = totalLocations;
    document.getElementById('total-countries').textContent = countries;
    document.getElementById('total-cities').textContent = cities;
    document.getElementById('total-categories').textContent = categories;
  }

  function populateFilters() {
    const countries = [...new Set(allLocations.map(location => location.country))].sort();
    const cities = [...new Set(allLocations.map(location => location.city))].sort();

    const countrySelect = document.getElementById('country-filter');
    const citySelect = document.getElementById('city-filter');

    countries.forEach(country => {
      const option = document.createElement('option');
      option.value = country;
      option.textContent = country;
      countrySelect.appendChild(option);
    });

    cities.forEach(city => {
      const option = document.createElement('option');
      option.value = city;
      option.textContent = city;
      citySelect.appendChild(option);
    });
  }

  function renderLocationCard(location) {
    return `
      <div class="group relative overflow-hidden rounded-2xl bg-neutral-900/50 transition-all duration-300 hover:bg-neutral-900/80 hover:scale-105 hover:shadow-2xl flex flex-col h-full">
        ${location.category ? `<div class="absolute top-4 right-4 z-10"><span class="inline-block rounded-full bg-blue-600 px-3 py-1 text-xs font-bold text-white uppercase">${location.category}</span></div>` : ''}
        
        <!-- Image -->
        <div class="relative aspect-4/3 overflow-hidden">
          <div class="w-full h-full">
            ${location.images && location.images.length > 0 ? 
              `<img src="${location.images[0]}" alt="${location.name}" 
                   class="w-full h-full object-cover cursor-pointer transition-transform duration-300 group-hover:scale-110"
                   style="object-fit: cover; object-position: center center;"
                   data-images='${JSON.stringify(location.images)}'
                   data-location-name="${location.name}"
                   loading="lazy">` : 
              '<div class="w-full h-full bg-neutral-800 flex items-center justify-center"><span class="text-neutral-400">No images</span></div>'
            }
          </div>
          <div class="absolute inset-0 bg-linear-to-t from-black/60 to-transparent pointer-events-none"></div>
        </div>

        <!-- Content -->
        <div class="p-6 flex flex-col flex-1">
          <div class="mb-3">
            <h3 class="text-xl font-bold text-white group-hover:text-yellow-400 transition-colors mb-1">
              ${location.name}
            </h3>
            <p class="text-sm text-neutral-400 flex items-center">
              <svg class="h-4 w-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
              ${location.city}, ${location.country}
            </p>
          </div>

          <p class="text-sm text-neutral-300 mb-4 line-clamp-3">
            ${location.description}
          </p>

          ${location.discount_code ? `
            <div class="mb-4 p-3 bg-yellow-400/10 border border-yellow-400/30 rounded-lg">
              <div class="text-xs text-yellow-400 font-medium mb-1">Special Offer</div>
              <div class="text-sm text-white">Discount Code: <span class="font-bold text-yellow-400">${location.discount_code}</span></div>
            </div>
          ` : ''}

          <div class="flex-1"></div>

          <div class="flex gap-2 mt-4">
            ${location.website_url ? `
              <a href="${location.website_url}" target="_blank" rel="noopener noreferrer" 
                 class="flex-1 inline-flex items-center justify-center gap-1 text-yellow-400 text-sm font-medium hover:text-yellow-300 border border-yellow-400 rounded-lg py-2 px-3 hover:bg-yellow-400 hover:text-black transition-all">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                </svg>
                Visit Website
              </a>
            ` : ''}
          </div>
        </div>
      </div>
    `;
  }

  function renderLocations(filteredLocations = allLocations) {
    const grid = document.getElementById('locations-grid');
    const loading = document.getElementById('loading-spinner');
    const noLocations = document.getElementById('no-locations');

    loading.classList.add('hidden');

    if (filteredLocations.length === 0) {
      grid.classList.add('hidden');
      noLocations.classList.remove('hidden');
      return;
    }

    noLocations.classList.add('hidden');
    grid.classList.remove('hidden');

    grid.innerHTML = filteredLocations.map(location => renderLocationCard(location)).join('');
    setupImageClicks();
  }



  // Image modal functions are now handled by the ImageModal component

  function setupImageClicks() {
    // Setup image modal clicks
    document.querySelectorAll('img[data-images]').forEach(img => {
      img.addEventListener('click', (e) => {
        e.stopPropagation();
        const images = JSON.parse(img.dataset.images);
        const locationName = img.dataset.locationName;
        if (window.openImageModal) {
          window.openImageModal(locationName, images, 0);
        }
      });
    });
  }

  function setupEventListeners() {
    // Filter toggle
    document.getElementById('filter-btn').addEventListener('click', () => {
      const filtersSection = document.getElementById('filters-section');
      filtersSection.classList.toggle('hidden');
    });

    // Filter changes
    ['category-filter', 'country-filter', 'city-filter', 'sort-filter'].forEach(id => {
      document.getElementById(id).addEventListener('change', applyFilters);
    });

    // Keyboard navigation is handled by the ImageModal component
  }

  function applyFilters() {
    const category = document.getElementById('category-filter').value;
    const country = document.getElementById('country-filter').value;
    const city = document.getElementById('city-filter').value;
    const sort = document.getElementById('sort-filter').value;

    let filtered = [...allLocations];

    // Apply filters
    if (category) filtered = filtered.filter(location => location.category === category);
    if (country) filtered = filtered.filter(location => location.country === country);
    if (city) filtered = filtered.filter(location => location.city === city);

    // Apply sorting
    if (sort === 'newest') {
      filtered.sort((a, b) => new Date(b.created_at) - new Date(a.created_at));
    } else if (sort === 'name') {
      filtered.sort((a, b) => a.name.localeCompare(b.name));
    }

    renderLocations(filtered);
  }

  // Initialize when DOM is ready
  function initializeApp() {
    updateStats();
    renderLocations();
    populateFilters();
    setupEventListeners();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeApp);
  } else {
    initializeApp();
  }
</script>

<style>
.line-clamp-3 {
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* Enhanced hover effects for distribution location cards */
.group:hover img {
  transform: scale(1.1);
}

/* Smooth transitions for all interactive elements */
.group {
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.group:hover {
  transform: scale(1.05) translateY(-4px);
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
}

/* Image transitions */
img[data-images] {
  transition: transform 0.3s ease-in-out;
}
</style>
