{
  "name": "directory-publish-email",
  "main": "index.js",
  "compatibility_date": "2025-06-17",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "route": {
    "pattern": "directory-publish.nomad-magazine.com",
    "custom_domain": true
  },
  "vars": {
    "DELAY_MINUTES": "0"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SCHEDULER",
        "class_name": "PublishScheduler"
      }
    ]
  },
  "kv_namespaces": [
    {
      "binding": "PUBLISH_KV",
      "id": "placeholder-replace-in-deploy"
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PublishScheduler"]
    }
  ]
}
